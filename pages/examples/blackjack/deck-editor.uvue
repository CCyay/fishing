<template>
  <view class="page">
    <view class="head">
      <view class="head-item">
        <text class="head-label">兑换券</text>
        <text id="bj-deck-tickets" class="head-value">{{ ticketCount }}</text>
      </view>
      <view class="head-item">
        <text class="head-label">已贴</text>
        <text id="bj-deck-stuck" class="head-value">{{ stuckCount }}</text>
      </view>
    </view>

    <!-- 贴纸栏：只列自己手里还有的。固定两行高，多了往下滚 -->
    <text class="section">手里的贴纸（点击选择）</text>
    <scroll-view class="sticker-scroll">
      <view class="sticker-row">
        <text v-if="ownedStickers.length == 0" class="sticker-none">手里没有贴纸了，去商店买</text>
        <view
          v-for="sticker in ownedStickers"
          :key="sticker.key"
          :id="'bj-sticker-' + sticker.key"
          class="sticker"
          :class="{ 'sticker-active': sticker.key == activeId }"
          @click="selectSticker(sticker.key)">
          <text class="sticker-name" :style="'color: ' + rarityAt(sticker.rarity).color">{{
            sticker.name
          }}</text>
          <text class="sticker-count">×{{ ownedCount(sticker.key) }}</text>
        </view>
      </view>
    </scroll-view>

    <view class="desc-box">
      <text id="bj-sticker-desc" class="desc-text">{{ activeDesc }}</text>
    </view>

    <!-- 花色切换：一个数字上贴的几张贴纸，是按 ♠♥♦♣ 的顺序分给那 4 张牌的。
         切到某个花色就单看那一张牌，「全部」是把这个数字上的都列出来 -->
    <view id="bj-suits" class="suits">
      <view
        id="bj-suit-all"
        class="suit suit-all"
        :class="{ 'suit-on': activeSuit < 0 }"
        @click="selectSuit(-1)">
        <text class="suit-text" :class="{ 'suit-text-on': activeSuit < 0 }">全部</text>
      </view>
      <view
        v-for="(suit, index) in SUITS"
        :key="suit"
        :id="'bj-suit-' + index"
        class="suit"
        :class="{ 'suit-on': index == activeSuit }"
        @click="selectSuit(index)">
        <text
          class="suit-text"
          :class="{ 'suit-red': isRedSuit(suit), 'suit-text-on': index == activeSuit }"
          >{{ suit }}</text
        >
      </view>
      <text class="suit-tip">{{ suitTip }}</text>
    </view>

    <!-- 数字网格：选着贴纸点格子就贴上，撕一律点标签右边的 × -->
    <text class="section">选好贴纸点数字贴上；撕下来点标签右边的 ×</text>
    <scroll-view class="grid">
      <view class="grid-row">
        <view
          v-for="(rank, index) in RANKS"
          :key="rank"
          :id="'bj-rank-' + index"
          class="cell"
          @click="toggleSticker(index)">
          <view class="cell-inner" :class="{ 'cell-on': hasActive(index) }">
            <text class="cell-rank" :class="{ 'cell-rank-on': hasActive(index) }"
              >{{ activeSuit < 0 ? '' : SUITS[activeSuit] }}{{ rank }}</text
            >
            <!-- J 焊死的【通吃】不是贴上去的，撕不掉，所以不给它标签 -->
            <text v-if="isFixedRank(rank)" class="cell-marks">通吃·固定</text>
            <view v-else class="tag-grid">
              <!-- 一个格位就是一张具体的牌，空着也占着位子：
                   看「全部」时四个格位固定按 ♠♥♦♣ 排成两行两列，
                   哪张贴了哪张空着一眼看得出，格子高度也就不会忽高忽低 -->
              <view
                v-for="tag in rankTags[index]"
                :key="'tg-' + index + '-' + tag.suit"
                class="tag-cell"
                :class="{ 'tag-cell-half': activeSuit < 0 }">
                <view class="tag" :style="tagStyle(tag)">
                  <text class="tag-name" :class="{ 'tag-name-empty': tag.color == '' }">{{
                    tag.label
                  }}</text>
                  <view
                    v-if="tag.color != ''"
                    :id="'bj-peel-' + index + '-' + tag.suit"
                    class="tag-x"
                    @click.stop="peelTag(index, tag.suit)">
                    <text class="tag-x-text">×</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="actions">
      <view id="bj-deck-clear" class="act-btn act-btn-warn" @click="clearAll">
        <text class="act-text act-text-warn">清空</text>
      </view>
      <view id="bj-deck-shop" class="act-btn" @click="goShop">
        <text class="act-text">去商店</text>
      </view>
      <view id="bj-deck-back" class="act-btn act-btn-primary" @click="goBack">
        <text class="act-text act-text-dark">返回</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    Sticker,
    STICKERS,
    stickerAt,
    rarityAt,
    isFixedRank,
    keyAtIndex,
    indexOfKey
  } from '@/pages/examples/blackjack/stickers.uts'
  import {
    RANKS,
    SUITS,
    isRedSuit,
    stickerAtSuit,
    stuckCountAt,
    countStuck
  } from '@/pages/examples/blackjack/cards.uts'
  import {
    SaveData,
    emptySave,
    loadCurrentSave,
    saveCurrent,
    cloneSave,
    canStick,
    applySticker,
    peelSticker,
    stickerTotal,
    isShopUnlocked,
    sumOf
  } from '@/pages/examples/blackjack/save.uts'

  // 格子里的一个格位 = 牌组里的一张具体的牌。suit 是这个数字的哪张牌，
  // 撕的时候按它定位 —— 同种贴纸贴了好几张也各撕各的。
  // color 是空串就表示这张牌还空着，格位留着占地方，label 写花色符号
  type DeckTag = {
    suit : number
    label : string
    color : string
  }

  const save = ref<SaveData>(emptySave())
  // 手里有什么就默认选什么。幸运不再白送，新存档可能一张贴纸都没有，
  // 这时空着 —— 没有可选项，硬选一个只会让人以为自己有
  const activeId = ref<string>('')
  // 正在看第几个花色（0 = ♠，按 SUITS 的顺序），-1 表示「全部」。
  // 一个数字上贴的几张贴纸就是按这个顺序分给那 4 张牌的，
  // 所以切花色等于切「看这个数字的第几张牌」；全部则是把整摞列出来
  const activeSuit = ref<number>(-1)

  // 只列自己有的贴纸。已经贴出去的也留在列表里 —— 不然就没法选中它撕下来了
  const ownedStickers = computed<Sticker[]>(() : Sticker[] => {
    const list : Sticker[] = []
    for (let i = 0; i < STICKERS.length; i++) {
      if (stickerTotal(save.value, STICKERS[i].key) > 0) {
        list.push(STICKERS[i])
      }
    }
    return list
  })

  // 手里还剩几张（不含已经贴出去的）
  function ownedCount(key : string) : number {
    const at = indexOfKey(key)
    return at < 0 ? 0 : save.value.stickersOwned[at]
  }

  const stuckCount = computed<number>(() : number => {
    return countStuck(save.value.stuck)
  })

  const ticketCount = computed<number>(() : number => {
    return sumOf(save.value.tickets)
  })

  const activeDesc = computed<string>(() : string => {
    if (activeId.value == '') {
      return '手里一张贴纸都没有，去兑换所用随机券抽几张'
    }
    const sticker = stickerAt(activeId.value)
    // 效果一律摊开给看，解没解锁都照说 ——
    // 藏着效果只会让人对着名字瞎猜，贴上去才发现不是想要的
    return '【' + sticker.name + '】' + sticker.desc
  })

  function refresh() {
    save.value = loadCurrentSave()
    // 选中项可能已经不在手上了（贴光了、或者是刚进页面还没选），
    // 自动落到手里的第一张
    const owned = ownedStickers.value
    if (owned.length == 0) {
      activeId.value = ''
      return
    }
    for (let i = 0; i < owned.length; i++) {
      if (owned[i].key == activeId.value) {
        return
      }
    }
    activeId.value = owned[0].key
  }

  // 再点一次就取消选中 —— 选着贴纸时点数字是贴，不选贴纸时点数字是撕，
  // 两种操作得分得开
  function selectSticker(key : string) {
    activeId.value = activeId.value == key ? '' : key
  }

  function selectSuit(index : number) {
    activeSuit.value = index
  }

  // 这个数字这个花色的那一张牌，贴的是哪张贴纸。空串表示这张牌上什么都没有
  function suitStickerOf(rankIndex : number, suitIndex : number) : string {
    if (suitIndex < 0 || isFixedRank(RANKS[rankIndex])) {
      return ''
    }
    const id = stickerAtSuit(save.value.stuck, rankIndex, suitIndex)
    return id < 0 ? '' : keyAtIndex(id)
  }

  // 这个数字上第一张空着的牌是哪个花色，-1 表示四张都贴满了。
  // 「全部」模式下贴纸就落到这儿 —— 跟旧版依次往下发的顺序一致
  function firstFreeSuit(rankIndex : number) : number {
    for (let s = 0; s < SUITS.length; s++) {
      if (stickerAtSuit(save.value.stuck, rankIndex, s) < 0) {
        return s
      }
    }
    return -1
  }

  // 当前选中的贴纸，在这个格子上算不算「已贴」。
  // 看单个花色时比的是那一张牌，看全部时只问这个数字上有没有
  function hasActive(rankIndex : number) : boolean {
    if (activeId.value == '') {
      return false
    }
    if (activeSuit.value < 0) {
      return stuckCountAt(save.value.stuck, rankIndex, indexOfKey(activeId.value)) > 0
    }
    return suitStickerOf(rankIndex, activeSuit.value) == activeId.value
  }

  // 十三个数字各自的标签，一次算好。模板里 rankTags[index] 直接取，
  // 省得每个格子渲染一次就重算一遍
  const rankTags = computed<DeckTag[][]>(() : DeckTag[][] => {
    const all : DeckTag[][] = []
    for (let r = 0; r < RANKS.length; r++) {
      all.push(tagsOfRank(r))
    }
    return all
  })

  // 这个数字的四张牌，按 ♠♥♦♣ 的顺序各占一个格位。空着的也返回 ——
  // 格位数固定下来，标签才能排成整齐的两行两列，格子高度也才不会随贴纸数变。
  // 看单个花色时只返回那一张牌，格位就一个。
  // 同种贴纸不再合并成 ×N：每个格位背后得是一张能单独撕掉的牌
  function tagsOfRank(rankIndex : number) : DeckTag[] {
    const list : DeckTag[] = []
    // J 焊着【通吃】，贴纸矩阵管不着它
    if (isFixedRank(RANKS[rankIndex])) {
      return list
    }
    for (let s = 0; s < SUITS.length; s++) {
      if (activeSuit.value >= 0 && s != activeSuit.value) {
        continue
      }
      const id = stickerAtSuit(save.value.stuck, rankIndex, s)
      if (id < 0) {
        // 空格位：写个花色符号占着，顺便标出这一格是哪张牌
        list.push({ suit: s, label: SUITS[s], color: '' } as DeckTag)
        continue
      }
      const sticker = stickerAt(keyAtIndex(id))
      list.push({
        suit: s,
        // 格位的位置已经表示花色了（左上♠、右上♥、左下♦、右下♣），
        // 名字前面不用再缀一遍 —— 四分之一屏宽的格子塞不下
        label: sticker.name,
        // 颜色跟着稀有度走，跟上面贴纸栏里的名字是同一套色
        color: rarityAt(sticker.rarity).color
      } as DeckTag)
    }
    return list
  }

  // 贴了东西就用稀有度色，空格位压暗一档。
  // 空格位也得给个底色，不然 :style 绑空串在 uts 里不好收场
  function tagStyle(tag : DeckTag) : string {
    return 'background-color: ' + (tag.color == '' ? '#0a5334' : tag.color)
  }

  // 点标签右边的 × 就撕这一张。跟点格子分开：点格子只管贴，
  // 免得手一抖把刚贴好的撕了
  function peelTag(rankIndex : number, suitIndex : number) {
    const data = save.value
    const id = peelSticker(data, rankIndex, suitIndex)
    if (id < 0) {
      return
    }
    commit(
      data,
      '撕下 ' + SUITS[suitIndex] + RANKS[rankIndex] + ' 的【' + stickerAt(keyAtIndex(id)).name + '】'
    )
  }

  const suitTip = '贴纸按 ♠♥♦♣ 的顺序分给这个数字的 4 张牌'

  // 点格子只管贴：看单花色就贴那一张，全部模式落到第一张空着的牌上。
  // 撕归标签上的 × 管 —— 两件事各有各的入口，就不会点一下不知道会发生什么
  function toggleSticker(rankIndex : number) {
    const data = save.value
    if (isFixedRank(RANKS[rankIndex])) {
      uni.showToast({
        icon: 'none',
        title: 'J 自带【通吃】，贴不上别的'
      })
      return
    }

    const key = activeId.value
    if (key == '') {
      uni.showToast({
        icon: 'none',
        title: '先在上面选一张贴纸。撕请点标签右边的 ×'
      })
      return
    }

    const name = stickerAt(key).name
    const suit = activeSuit.value >= 0 ? activeSuit.value : firstFreeSuit(rankIndex)
    if (suit < 0) {
      uni.showToast({
        icon: 'none',
        title: '这个数字的 4 张牌都贴满了'
      })
      return
    }

    const reason = canStick(data, rankIndex, suit, key)
    if (reason != '') {
      uni.showToast({
        icon: 'none',
        title: reason
      })
      return
    }
    applySticker(data, rankIndex, suit, key)
    commit(data, SUITS[suit] + RANKS[rankIndex] + ' 贴上【' + name + '】')
  }

  // 把整副牌组上的贴纸全撕下来退回手里。
  // 换流派的时候一张张撕太费事 —— 贴纸没有损耗，撕完照样能重贴
  function clearAll() {
    const data = save.value
    let count = 0
    for (let r = 0; r < RANKS.length; r++) {
      for (let s = 0; s < SUITS.length; s++) {
        if (peelSticker(data, r, s) >= 0) {
          count = count + 1
        }
      }
    }
    if (count == 0) {
      uni.showToast({
        icon: 'none',
        title: '牌组上本来就没有贴纸'
      })
      return
    }
    commit(data, '撕下全部 ' + count + ' 张贴纸，都退回手里了')
  }

  // 数据改完整体替换一次，保证视图刷新
  function commit(data : SaveData, tip : string) {
    saveCurrent(data)
    save.value = cloneSave(data)
    uni.showToast({
      icon: 'none',
      title: tip
    })
  }

  function goShop() {
    uni.navigateTo({
      url: '/pages/examples/blackjack/shop'
    })
  }

  function goBack() {
    uni.navigateBack()
  }

  onShow(() => {
    refresh()
  })

  refresh()
</script>

<style>
  .page {
    flex: 1;
    padding: 10px 12px;
    background-color: #0b5d3b;
  }

  .head {
    flex-direction: row;
    justify-content: space-between;
    background-color: #084730;
    border-radius: 8px;
    padding: 6px 12px;
  }

  .head-item {
    flex: 1;
    align-items: center;
  }

  .head-label {
    color: #9fd9bd;
    font-size: 11px;
  }

  .head-value {
    color: #ffffff;
    font-size: 17px;
    font-weight: bold;
  }

  .section {
    color: #9fd9bd;
    font-size: 11px;
    margin-top: 8px;
  }

  /* 贴纸栏固定占两行的高度（每行 44 + 间距 5），拥有的多了就在里面滚 */
  .sticker-scroll {
    height: 98px;
    margin-top: 4px;
  }

  .sticker-row {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .sticker-none {
    color: #9fd9bd;
    font-size: 11px;
  }

  .sticker {
    width: 54px;
    height: 44px;
    margin-right: 5px;
    margin-bottom: 5px;
    border-radius: 6px;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #0e6b45;
    align-items: center;
    justify-content: center;
  }

  .sticker-active {
    border-color: #e8b23a;
  }

  /* 贴纸名是两个字，54px 宽配 14px 字号刚好完整显示 */
  .sticker-name {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
  }

  .sticker-count {
    color: #e8b23a;
    font-size: 10px;
  }

  .desc-box {
    height: 34px;
    margin-top: 6px;
    background-color: #084730;
    border-radius: 6px;
    padding: 4px 8px;
    justify-content: center;
  }

  .desc-text {
    color: #cfeade;
    font-size: 11px;
    line-height: 14px;
  }

  /* 花色切换条 */
  .suits {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
  }

  .suit {
    width: 30px;
    height: 26px;
    margin-right: 5px;
    border-radius: 6px;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #0e6b45;
    align-items: center;
    justify-content: center;
  }

  /* 「全部」是两个字，比花色符号宽 */
  .suit-all {
    width: 42px;
  }

  .suit-on {
    border-color: #e8b23a;
    background-color: #12764e;
  }

  .suit-text {
    color: #cfeade;
    font-size: 13px;
    font-weight: bold;
  }

  .suit-red {
    color: #ff9e80;
  }

  /* 选中时一律描金，压过红黑 —— 这会儿要紧的是「选的是哪个」 */
  .suit-text-on {
    color: #e8b23a;
  }

  .suit-tip {
    flex: 1;
    color: #9fd9bd;
    font-size: 9px;
  }

  /* 数字网格。贴满的格子要摞四枚标签，高度撑起来就超屏了，所以整片能滚 */
  .grid {
    flex: 1;
    margin-top: 4px;
  }

  .grid-row {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .cell {
    width: 25%;
    padding: 3px;
  }

  /* 高度写死：数字一行 + 标签两行。贴几张贴纸格子都一样高，
     网格才不会因为某一格贴满了就整行跟着长 */
  .cell-inner {
    height: 66px;
    background-color: #0e6b45;
    border-radius: 6px;
    border-width: 1px;
    border-style: solid;
    border-color: #0e6b45;
    padding: 3px;
    /* 标签要撑满格子宽，所以不能再 center 了，数字自己居中 */
    align-items: stretch;
    justify-content: flex-start;
  }

  .cell-on {
    border-color: #e8b23a;
    background-color: #12764e;
  }

  .cell-rank {
    color: #ffffff;
    font-size: 17px;
    font-weight: bold;
    text-align: center;
  }

  .cell-rank-on {
    color: #e8b23a;
  }

  /* 只剩 J 在用：它的效果是焊死的，没有格位也没有 × */
  .cell-marks {
    color: #9fd9bd;
    font-size: 9px;
    text-align: center;
  }

  /* 四个格位排成两行两列 */
  .tag-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
  }

  /* 格位外面这一层只管占地方和留缝。缝走外层的 padding，
     不走标签自己的 margin —— 50% 宽再加 margin 就超出一行，会被挤到下一行去 */
  .tag-cell {
    width: 100%;
    padding: 1px;
  }

  /* 看「全部」时一行摆两个，看单花色时就那一张牌，占满整行 */
  .tag-cell-half {
    width: 50%;
  }

  /* 底色就是稀有度色（在模板里按贴纸绑上去），字压深色 ——
     四种稀有度色都偏亮，深字比白字清楚 */
  .tag {
    flex-direction: row;
    align-items: center;
    height: 15px;
    border-radius: 3px;
    padding-left: 2px;
  }

  .tag-name {
    flex: 1;
    color: #12321f;
    font-size: 9px;
    font-weight: bold;
  }

  .tag-name-empty {
    color: #4f8a6c;
    text-align: center;
  }

  /* × 要能点中，所以撑成一块方形，不是光一个字符 */
  .tag-x {
    width: 13px;
    height: 15px;
    align-items: center;
    justify-content: center;
  }

  .tag-x-text {
    color: #12321f;
    font-size: 11px;
    font-weight: bold;
  }

  /* 底部 */
  .actions {
    flex-direction: row;
    margin-top: 6px;
  }

  .act-btn {
    flex: 1;
    height: 42px;
    border-radius: 21px;
    margin-right: 8px;
    align-items: center;
