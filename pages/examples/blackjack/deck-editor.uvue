<template>
  <view class="page">
    <view class="head">
      <view class="head-item">
        <text class="head-label">兑换券</text>
        <text id="bj-deck-tickets" class="head-value">{{ ticketCount }}</text>
      </view>
      <view class="head-item">
        <text class="head-label">已贴</text>
        <text id="bj-deck-stuck" class="head-value">{{ stuckCount }}</text>
      </view>
    </view>

    <!-- 贴纸栏：只列自己手里还有的。固定两行高，多了往下滚 -->
    <text class="section">手里的贴纸（点击选择）</text>
    <scroll-view class="sticker-scroll">
      <view class="sticker-row">
        <text v-if="ownedStickers.length == 0" class="sticker-none">手里没有贴纸了，去商店买</text>
        <view
          v-for="sticker in ownedStickers"
          :key="sticker.key"
          :id="'bj-sticker-' + sticker.key"
          class="sticker"
          :class="{ 'sticker-active': sticker.key == activeId }"
          @click="selectSticker(sticker.key)">
          <text class="sticker-name" :style="'color: ' + rarityAt(sticker.rarity).color">{{
            sticker.name
          }}</text>
          <text class="sticker-count">×{{ ownedCount(sticker.key) }}</text>
        </view>
      </view>
    </scroll-view>

    <view class="desc-box">
      <text id="bj-sticker-desc" class="desc-text">{{ activeDesc }}</text>
    </view>

    <!-- 数字网格：点击贴上 / 撕下 -->
    <text class="section">点数字贴一张，同种能摞满 4 张；贴不下了再点一次，整摞撕下来</text>
    <view class="grid">
      <view
        v-for="(rank, index) in RANKS"
        :key="rank"
        :id="'bj-rank-' + index"
        class="cell"
        @click="toggleSticker(index)">
        <view class="cell-inner" :class="{ 'cell-on': hasActive(index) }">
          <text class="cell-rank" :class="{ 'cell-rank-on': hasActive(index) }">{{ rank }}</text>
          <text class="cell-marks">{{ marksOf(index) }}</text>
        </view>
      </view>
    </view>

    <view class="actions">
      <view id="bj-deck-shop" class="act-btn" @click="goShop">
        <text class="act-text">去商店</text>
      </view>
      <view id="bj-deck-back" class="act-btn act-btn-primary" @click="goBack">
        <text class="act-text act-text-dark">返回</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    Sticker,
    STICKERS,
    stickerAt,
    rarityAt,
    isFixedRank,
    keyAtIndex,
    indexOfKey
  } from '@/pages/examples/blackjack/stickers.uts'
  import {
    RANKS,
    stickerKindsOfRank,
    stuckCountAt,
    countStuck
  } from '@/pages/examples/blackjack/cards.uts'
  import {
    SaveData,
    emptySave,
    loadCurrentSave,
    saveCurrent,
    canStick,
    applySticker,
    peelSticker,
    stickerTotal,
    isStuckAt,
    isShopUnlocked,
    sumOf
  } from '@/pages/examples/blackjack/save.uts'

  const save = ref<SaveData>(emptySave())
  // 手里有什么就默认选什么。幸运不再白送，新存档可能一张贴纸都没有，
  // 这时空着 —— 没有可选项，硬选一个只会让人以为自己有
  const activeId = ref<string>('')

  // 只列自己有的贴纸。已经贴出去的也留在列表里 —— 不然就没法选中它撕下来了
  const ownedStickers = computed<Sticker[]>(() : Sticker[] => {
    const list : Sticker[] = []
    for (let i = 0; i < STICKERS.length; i++) {
      if (stickerTotal(save.value, STICKERS[i].key) > 0) {
        list.push(STICKERS[i])
      }
    }
    return list
  })

  // 手里还剩几张（不含已经贴出去的）
  function ownedCount(key : string) : number {
    const at = indexOfKey(key)
    return at < 0 ? 0 : save.value.stickersOwned[at]
  }

  const stuckCount = computed<number>(() : number => {
    return countStuck(save.value.stuck)
  })

  const ticketCount = computed<number>(() : number => {
    return sumOf(save.value.tickets)
  })

  const activeDesc = computed<string>(() : string => {
    if (activeId.value == '') {
      return '手里一张贴纸都没有，去兑换所用随机券抽几张'
    }
    const sticker = stickerAt(activeId.value)
    // 效果一律摊开给看，解没解锁都照说 ——
    // 藏着效果只会让人对着名字瞎猜，贴上去才发现不是想要的
    return '【' + sticker.name + '】' + sticker.desc
  })

  function refresh() {
    save.value = loadCurrentSave()
    // 选中项可能已经不在手上了（贴光了、或者是刚进页面还没选），
    // 自动落到手里的第一张
    const owned = ownedStickers.value
    if (owned.length == 0) {
      activeId.value = ''
      return
    }
    for (let i = 0; i < owned.length; i++) {
      if (owned[i].key == activeId.value) {
        return
      }
    }
    activeId.value = owned[0].key
  }

  function selectSticker(key : string) {
    activeId.value = key
  }

  // 当前选中的贴纸是否已经贴在这个数字上
  function hasActive(rankIndex : number) : boolean {
    return isStuckAt(save.value, rankIndex, activeId.value)
  }

  // 这个数字身上所有贴纸的名字，用于格子里的小字。
  // 名字是两个字，用顿号隔开才看得清哪是哪
  function marksOf(rankIndex : number) : string {
    // J 焊着【通吃】，贴纸矩阵管不着它
    if (isFixedRank(RANKS[rankIndex])) {
      return '通吃·固定'
    }
    const kinds = stickerKindsOfRank(save.value.stuck, rankIndex)
    if (kinds.length == 0) {
      return '—'
    }
    // 同种贴了好几张就缀个 ×N，不然「幸运、幸运、幸运」读起来很怪
    let text = ''
    for (let i = 0; i < kinds.length; i++) {
      if (i > 0) {
        text = text + '、'
      }
      text = text + stickerAt(keyAtIndex(kinds[i])).name
      const count = stuckCountAt(save.value.stuck, rankIndex, kinds[i])
      if (count > 1) {
        text = text + '×' + count
      }
    }
    return text
  }

  // 点一次加贴一张，同种可以摞到 4 张。
  // 贴不下了再点一次，就把这个数字上这种贴纸整摞撕下来退回手里，重新来过 ——
  // 摞着的时候「点一下撕一张」会在满和差一张之间来回跳，反而调不准
  function toggleSticker(rankIndex : number) {
    const data = save.value
    const key = activeId.value
    if (key == '') {
      uni.showToast({
        icon: 'none',
        title: '手里没有贴纸，先去兑换所'
      })
      return
    }
    const name = stickerAt(key).name

    const reason = canStick(data, rankIndex, key)
    if (reason == '') {
      applySticker(data, rankIndex, key)
      const count = stuckCountAt(data.stuck, rankIndex, indexOfKey(key))
      const tail = count > 1 ? '，共 ' + count + ' 张' : ''
      commit(data, RANKS[rankIndex] + ' 贴上【' + name + '】' + tail)
      return
    }

    if (isStuckAt(data, rankIndex, key)) {
      let count = 0
      while (isStuckAt(data, rankIndex, key)) {
        peelSticker(data, rankIndex, key)
        count = count + 1
      }
      commit(data, '撕下 ' + count + ' 张【' + name + '】')
      return
    }

    uni.showToast({
      icon: 'none',
      title: reason
    })
  }

  // 数据改完整体替换一次，保证视图刷新
  function commit(data : SaveData, tip : string) {
    saveCurrent(data)
    const next : SaveData = {
      exists: data.exists,
      label: data.label,
      tickets: data.tickets,
      randomTickets: data.randomTickets,
      refundTickets: data.refundTickets,
      win: data.win,
      lose: data.lose,
      push: data.push,
      cleared: data.cleared,
      stickersOwned: data.stickersOwned,
      shopUnlocked: data.shopUnlocked,
      achieved: data.achieved,
      stuck: data.stuck
    }
    save.value = next
    uni.showToast({
      icon: 'none',
      title: tip
    })
  }

  function goShop() {
    uni.navigateTo({
      url: '/pages/examples/blackjack/shop'
    })
  }

  function goBack() {
    uni.navigateBack()
  }

  onShow(() => {
    refresh()
  })

  refresh()
</script>

<style>
  .page {
    flex: 1;
    padding: 10px 12px;
    background-color: #0b5d3b;
  }

  .head {
    flex-direction: row;
    justify-content: space-between;
    background-color: #084730;
    border-radius: 8px;
    padding: 6px 12px;
  }

  .head-item {
    flex: 1;
    align-items: center;
  }

  .head-label {
    color: #9fd9bd;
    font-size: 11px;
  }

  .head-value {
    color: #ffffff;
    font-size: 17px;
    font-weight: bold;
  }

  .section {
    color: #9fd9bd;
    font-size: 11px;
    margin-top: 8px;
  }

  /* 贴纸栏固定占两行的高度（每行 44 + 间距 5），拥有的多了就在里面滚 */
  .sticker-scroll {
    height: 98px;
    margin-top: 4px;
  }

  .sticker-row {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .sticker-none {
    color: #9fd9bd;
    font-size: 11px;
  }

  .sticker {
    width: 54px;
    height: 44px;
    margin-right: 5px;
    margin-bottom: 5px;
    border-radius: 6px;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #0e6b45;
    align-items: center;
    justify-content: center;
  }

  .sticker-active {
    border-color: #e8b23a;
  }

  /* 贴纸名是两个字，54px 宽配 14px 字号刚好完整显示 */
  .sticker-name {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
  }

  .sticker-count {
    color: #e8b23a;
    font-size: 10px;
  }

  .desc-box {
    height: 34px;
    margin-top: 6px;
    background-color: #084730;
    border-radius: 6px;
    padding: 4px 8px;
    justify-content: center;
  }

  .desc-text {
    color: #cfeade;
    font-size: 11px;
    line-height: 14px;
  }

  /* 数字网格 */
  .grid {
    flex: 1;
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .cell {
    width: 25%;
    padding: 3px;
  }

  .cell-inner {
    flex: 1;
    background-color: #0e6b45;
    border-radius: 6px;
    border-width: 1px;
    border-style: solid;
    border-color: #0e6b45;
    align-items: center;
    justify-content: center;
  }

  .cell-on {
    border-color: #e8b23a;
    background-color: #12764e;
  }

  .cell-rank {
    color: #ffffff;
    font-size: 17px;
    font-weight: bold;
  }

  .cell-rank-on {
    color: #e8b23a;
  }

  /* 一个数字最多盖 4 种章，名字连起来放不下一行，缩小字号让它换行 */
  .cell-marks {
    color: #9fd9bd;
    font-size: 9px;
    text-align: center;
  }

  /* 底部 */
  .actions {
    flex-direction: row;
    margin-top: 6px;
  }

  .act-btn {
    flex: 1;
    height: 42px;
    border-radius: 21px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .act-btn-primary {
    background-color: #e8b23a;
  }

  .act-text {
    color: #e8b23a;
    font-size: 14px;
    font-weight: bold;
  }

  .act-text-dark {
    color: #3b2a00;
  }
</style>
