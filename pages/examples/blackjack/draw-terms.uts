// 摸打钓鱼 · 规则文本（名词解释 + 规则条目）
//
// 两张表都是**给人看的字**，没有逻辑。放一起是因为它们的读者是同一拨：
// 规则面板（`draw-levels.uvue`）和实战配装手册（`draw-duel.uvue`）
//
// ---------- 为什么单独一个文件（2026-10-14） ----------
//
// 这张表原先是 `draw-levels.uvue` 里的局部 const。而 uvue 的 `<script setup>`
// **不导出任何东西**，所以别的页面一个字都拿不到。
//
// 实战模式的配装手册是**独立页面**（`draw-duel.uvue`），而实体对战时玩家
// 手边没有规则弹窗 —— 技能说明里全是【燃烧】【结冰】【通配】这类词，
// 查不到定义规则就执行不下去。所以手册必须自带词条，于是这张表得搬出来。
//
// **搬出来的附带好处**：规则面板和实战手册从此读**同一份**词表。
// 要是复制一份，两份必然分叉 —— 这个项目已经吃过那个教训
//（设计文档里记着 18 处引用因为复制而失效）。
//
// 整段搬的时候**注释一起搬**：燃烧、燃尽、结冰、顺子匹配、通配那几条
// 各带着几十行设计记录，它们解释的是「为什么这条规则只有这一句」——
// 丢了就只剩结论，下次有人就会把砍掉的东西再加回去

// ---- 规则条目 ----
//
// 写死的文字。规则改了这儿要跟着改 —— 数字（手牌 4 张、生命、技能库上限……）
// 跟代码里的常量对应：HAND_SIZE（ap-fishing）、DIFF_LIVES / LIBRARY_CAPS /
// DIFF_REWARD_RATE（draw-levels），利息档位见 interestOf
export type RuleSec = {
  title : string
  lines : string[]
}

export const RULES : RuleSec[] = [
  { title: '对局', lines: [
    // 「切牌定庄」是 2026-10-15 加的。原先写死「庄家先手」——
    // 而那让玩家恒后手，整个闯关难度表都建在那个假设上。
    //
    // 这两句的**顺序跟实现一致**（剔牌在前、切牌在后，见 ap-fishing 的
    // trimDeck 和它下面那段）—— 切出来那张要算进庄家记牌的底数，
    // 所以它必须在剔完之后才翻。
    //
    // 剔牌那一句 2026-10-15 改过：原先是「超过 52 张就剔到 52，而且要偶数」。
    // 52 那道上限删了（牌组现在可以任意厚），留下的只有奇偶那一道，
    // 而且锁的是**发完牌之后的牌库** —— 理由见 trimDeck 那段
    '洗好牌先看一眼：发完手牌之后牌库要是单数张，就从牌顶剔掉 1 张凑双数。',
    '然后翻一张定先后手：红 = 庄家先手，黑 = 你先手。那张牌给先手的人（双方都看得见它）。',
    '双方补足 4 张手牌，轮流每回合打 1 张，回合末补足 4 张。',
    // 终局那两句 2026-10-15 整个换了（原先是「牌库和双方手牌都空了」+
    // 「剩堆归没打最后一手的那一方」）。理由、四档实测数和那块墓碑
    // 都在 ap-fishing 的 TAIL_PLAYS / leftoverFor 两段注释里
    '牌库空了之后，双方各再打 1 手就收摊 —— 而且一局里双方打的牌数要一样多，不够的那一方补一手。',
    '收摊时积分高的赢。手里剩的牌和堆上剩的牌都不算分。'
  ] } as RuleSec,
  { title: '出一张牌的顺序', lines: [
    '① 进场：牌落到堆上（沉底的落堆底），先受场上效果影响（压邻、封色、分水……）。',
    '② 发动这张牌的技能：同一张牌有几个效果时，先执行带「优先」的。',
    '③ 匹配：这张牌还在堆上的话，跟堆里同点数的牌对上，就收走从那张到堆顶的整段。收走几张记几分。'
  ] } as RuleSec,
  // ---- 点数那一节 ----
  //
  // 这几条是**全局规则**，不属于任何一件技能 —— 所以技能说明里不写，
  // 只在这儿写一次。代码里的落点：
  //   减到 0 为止        → ap-fishing 的 dropVals
  //   0 不匹配           → ap-fishing 的 anyEquals
  //   无点数跳过增减     → dropVals 对空列表原样返回
  //   无点数受「变成 X」 → ap-fishing 的 landVals（分水那一支）
  //   无点数比大小算最大 → ap-fishing 的 valuesOf（齐顶那一支）
  { title: '点数', lines: [
    '点数减不到负数，最小是 0；往上不设限（贴点数卡能叠到多少算多少）。',
    '0 点不匹配 0 点 —— 两张都见了底的牌不该还能互相钓。（0 跟 1 照旧算「差 1」，磁钩钓得上。）',
    '一张牌可以同时算几个点数（贴过点数卡的）。任一个点数对得上就算匹配；几个点数全归 0 才算「点数为 0」。',
    '无点数不受「增减点数」影响（见底、退潮、干塘一概跳过它），但受「变成 X」影响（置 0、置无点数都算）。',
    '无点数在比较大小时算最大 —— 所以堆上躺着一张无点数的牌，齐顶就抄不到数，白打一张。',
    '同一张牌上几个「变成 X」一起生效时，后面的盖前面的：分水（置 0）> 封色（置无点数）> 压邻（置无点数）。'
  ] } as RuleSec,
  { title: 'J', lines: [
    'J 只有通吃：堆上有牌时打 J，整堆收走；空堆上打 J 只收走它自己。',
    'J 不触发任何技能；让牌「没有点数」的场上效果也挡不住它通吃。'
  ] } as RuleSec,
  { title: '角色和技能', lines: [
    '每一轮开局选一张角色卡：它带一件常驻特殊技，还有几个印着点数或花色的槽。',
    '技能装进槽才生效：打出的牌落在槽上印的点数或花色上，就触发那个槽里的技能。',
    '技能是通用的，装进哪个槽都行；管哪些牌由槽决定（花色槽 12 张，点数一个 4 张）。'
  ] } as RuleSec,
  { title: '闯关', lines: [
    '一轮 12 关。过关拿金币（过关奖励 + 胜分 + 利息，胜分最多 +10），然后进商店。',
    '没花完的钱每关生利息：攒到 30 给 3，之后每 40 给 5，最多 25。',
    '输一关扣 1 点生命，退回上一个商店（金币、技能、货架都是那时的样子）；第 1 关输了就重打。生命用完，这一轮作废，从第 1 关重来。',
    // 平局 2026-10-15 从「重打这一关」改成「算过关」。
    // 金币自然就少 —— 胜分就是分差，平局时是 0，不用加特殊规则
    '平局算过关，但拿不到胜分那一笔（胜分 = 分差）。'
  ] } as RuleSec,
  { title: '商店和技能库', lines: [
    '买来的技能先放进技能库，再装进槽。装上、卸下、换槽都不花钱。',
    '技能库满了就买不了技能，得先卖掉一件；卖出拿回买价的一半。',
    '道具买了立刻用；货架可以花钱换一批，价钱翻倍涨。'
  ] } as RuleSec,
  { title: '难度（一轮开始前选）', lines: [
    // 生命 2026-10-15 退回 3/2/1（见 draw-levels 的 DIFF_LIVES）——
    // 困难因此重新是「一命通关」
    '简单：庄家前 4 关随机出牌、之后不记牌；过关金币 ×2；生命 3；技能库 8 件。',
    '普通：庄家第 1 关随机出牌、第 3 关起记牌；过关金币 ×1.2；生命 2；技能库 6 件。',
    '困难：庄家每一关都记牌；过关金币 ×0.75（第 1 关保底 80）；生命 1（一命通关）；技能库 5 件。'
  ] } as RuleSec,
  { title: '终局对决', lines: [
    '一局定胜负，不记账：不发金币、不推关号、不动存档。',
    '可以自定义角色和技能，也可以随机。难度只管庄家怎么出牌、配装多满。'
  ] } as RuleSec
]

// 实战手册只印**跟实体对战有关**的那几节。
//
// 「闯关」「商店和技能库」「难度」「终局对决」讲的是手机那套单人流程
//（金币、生命、技能库上限），拿真牌打的时候一条都用不上 ——
// 印出来只会让人去找那些不存在的东西
export const DUEL_RULE_TITLES : string[] = [
  '对局', '出一张牌的顺序', '点数', 'J', '角色和技能'
]

// ---- 名词解释 ----
//
// 技能说明里会反复用这几个词（「置 0」「无点数」「在场」「优先」……）。
// 一件技能的说明只有一两行，塞不进定义 —— 所以定义集中放这儿，
// 说明里直接用词。
//
// **这一份跟技能说明是一套**：往技能表里写新说明的时候，
// 要么用这儿已有的词，要么在这儿加一条 —— 自己造一个新说法
// 会让同一件事在游戏里有两个名字
export type Term = {
  word : string
  desc : string
}

export const TERMS : Term[] = [
  { word: '点数', desc: '牌面印的那个数（A 算 1，Q 算 12，K 算 13）。J 没有点数这条轴，它只通吃。' } as Term,
  { word: '匹配', desc: '你打的牌和堆里某张「算同一个点数」。对上了就收走从那张到堆顶的一整段。' } as Term,
  { word: '堆', desc: '打出去还没被收走的那些牌，横着摆。最早打的在最左（堆底），最新打的在最右（堆顶）。' } as Term,
  // 「获取下一张」**必须**写进词表，因为同一件事原先有三种说法
  //（同号「选 1 张同点数」、同花「翻牌库顶拿第一张」、野火「取 1 张同点数」）——
  // 三种说法会让玩家以为是三种机制。
  //
  // 「X 可以是技能」是这个词的**卖点**：那样池子跟着槽走
  //（花色槽 13 张、单点数槽 4 张），而原先写「同点数」时池子跟槽无关。
  //
  // 「拿到后洗牌库」是这个词的**限制**，而且是必要的：
  //   不洗的话「从顶往下第一张」是确定的，于是观潮 / 择饵 / 活水
  //   一看牌库顶就能把整条连锁排好（野火一局要取好几张）——
  //   那不是给信息类技能开兑现口子，那是把随机性整段删掉。
  //   洗了之后它退回「一张随机的符合牌」。
  //
  // 连带一条玩家要算的：**它会毁掉你自己攒的情报**。
  // 刚看完牌库顶再打一张野火，那几张就白看了 ——
  // 于是「信息类 + 检索类」是个要排顺序的组合，不是无脑叠加
  { word: '获取下一张 X', desc: '从牌库顶往下找第一张符合 X 的牌，拿进手里，然后把牌库洗一遍。X 可以是点数（获取下一张 3），也可以是技能（获取下一张【野火】—— 指打出去会触发那件技能的牌）。找过的牌不翻开给对手看。牌库里没有符合的，就是「没取到」。注意洗牌会冲掉观潮、择饵、活水刚看到的牌序。' } as Term,
  // 「**手里**那半句」是 2026-10-14 加的，因为死水改成了「把手牌变成
  // 0 点牌」—— 而牌面跟着变 `'0'` 之后点数槽就查不到它了。
  //
  // 那一条玩家**算不出来**：他看见牌面变成 0，不会想到技能也跟着没了。
  // 而「花色槽照旧」更要明说 —— 那是他唯一还能用那张牌做的事，
  // 也是这个效果留给他的决策（为了花色槽那件技能打出去、放弃匹配）
  { word: '置 0', desc: '把牌的点数变成 0。它还在点数这条轴上 —— 见底、撒网都收得走它，只是没法匹配。**手里**的牌被置 0 时牌面也跟着变 0，所以它不再触发点数槽上的技能；花色没变，花色槽照旧触发。' } as Term,
  // ---- 这两条 2026-10-15 改过，而且**改了两遍** ----
  //
  // 原先举的例子是「见底、退潮、干塘」，可**三件里有两件已经没了**：
  //
  //   【退潮】 2026-10-14 删（压底族六件之一）
  //   【干塘】 它是组合技「退潮 × 见底」—— **退潮一删它就跟着死了**
  //            （实现条件是 `hasTrigger(SK_EBB) && hasTrigger(SK_LOWTIDE)`，
  //             而 SK_EBB 现在是 −1，永不匹配）
  //
  // 第一遍改只去掉了退潮、把例子换成干塘 —— **那是把一个死的换成另一个死的**。
  // 干塘查不出来是因为它**没有 key、不在任何表里**（组合技是两件技能撞在
  // 同一张牌上合成的，不是表里的一行），所以 refs.js 第 6 项扫不到它。
  // 那个盲区后来补成了第 8 项（扫 `.uvue` 里的 `hasTrigger(A) && hasTrigger(B)`）。
  //
  // **所以「减点数」这一组现在只剩【见底】一件。**
  { word: '无点数', desc: '这张牌彻底不在点数这条轴上。谁也没法按点数钓它、它也钓不了别人；见底跳过它。只有 J、顺色、收色带得走。' } as Term,
  { word: '增减点数', desc: '把点数往上或往下挪（见底 −1）。无点数的牌不受影响。' } as Term,
  { word: '变成 X', desc: '把点数直接改成某个值 —— 置 0、置无点数、齐顶都算。无点数的牌照样受影响。' } as Term,
  { word: '在场', desc: '那张牌还在堆上。「在场时……」的效果，牌被收走就跟着没了（场上效果栏里看得见还挂着哪些）。' } as Term,
  { word: '叠放', desc: '把牌垫在堆上某张牌下面、或者盖在它上面。叠放的牌不参与匹配 —— 每一叠只有最上面那张算「当前牌」。那一叠被收走时，底下压着的跟着走，所以那几分归收走的人。' } as Term,
  { word: '保护', desc: '垫在堆上某张牌下面的牌给它保护。那张被收走时，垫着的牌代替它被收走，保护少一层。可以叠多层，一层扛一次。连 J 通吃也挡。' } as Term,
  // ---------- 【燃烧】定稿（2026-10-13）：**只有一条** ----------
  //
  // 它走过「四条」那一版（标签不收牌 / 不改状态 / 自动蔓延 / 蔓延不收牌），
  // 收成一条是因为**那三条都是在说「它不做什么」**：
  //
  // > 一个标签默认什么也不做。只有读它的技能才赋予它意义。
  // > 所以只需要写清它**做**什么 —— 蔓延。
  //
  // 连带两条自然消失，不用再写：
  //   「贴到已有标签的牌上会怎样」—— 空操作（它已经有那个标签了），
  //     所以不会互相引爆，也不需要「只点没烧着的」那半句；
  //   「不改点数 / 不改花色」—— 没写就是不改。
  //
  // 相消那句归【结冰】（它那条已经写了），不在这儿重复 ——
  // 照 desc 那条「不解释词表里的词」的同一个道理：一件事只在一处说。
  //
  // ---- 收牌**整个归【野火】** ----
  //
  // 早先的通则是「贴到已带燃烧的牌上 → 收走它」，而它
  // **从头到尾只有 wildfireFor 在用**（沸水删了；手牌 / 牌库那条线上的件
  // 都是只贴火、不收牌）。所以它不是通则，是野火的效果。
  //
  // > 代价要认：**没带野火的人，这个关键词对他完全是零** ——
  // > 他只看见火在爬，而那只是在给对手标记。
  // > 野火因此是这一族的**单点故障**。要补就得加第二个收割器
  // > （照深钩那条形状：「钓中时连带收走带火的」），但那是另一件事
  //
  // ---- 第 2 条是这一族的**对位解**，所以碰不得 ----
  //
  // 带火的牌保留点数，于是对手能**在火烧过来之前把它钓走**。
  // 中间试过「带燃烧的牌无点数/置 0」（锁住），野火因此从 +0.50
  // 跳到 **+3.28** —— 有效，但它撤掉了那场抢时间，所以废弃。
  //
  // ---- 第 3、4 条合起来治那个七倍缺口 ----
  //
  // 诊断量出来：野火**贴火 2.11 张/次，收成只有 0.30** ——
  // 火的留存 ≈ 牌在堆上的留存（3.3 回合），而堆只有 3 张厚、换手极快，
  // 所以烧上去的火等不到下一次收就被人钓走了。
  //
  // 蔓延不保住**那几张**，而是**让火自己长回来**：堆薄、一手覆盖 +2 格，
  // 火一两手就铺满整堆。配上野火的连锁（获取下一张【野火】压短间隔），
  // 留存率从 32% 涨到 **74%**，野火 +0.51 → **+2.56**。
  //
  // 第 4 条（不收牌）砍掉了三样原本要加的东西：**归属数组**
  //（蔓延不收牌 → 收牌永远是出牌方造成的）、**「刚点着的火这一轮不传」**
  //（不会引爆）、以及一条「这一下收的牌归谁」的规矩。
  //
  // ---- 做成技能试过，不行 ----
  //
  // 蔓延原先是【燎原】、锁原先是【焦壳】。两件都挂在自己那张牌上，
  // 而**在场效果的强度上限由「它那张牌活多久」决定**，堆的换手是 3.3 回合 ——
  // 燎原 X = −1.24、焦壳协同只有 +0.08。
  // **想要一个稳定生效的全局规则，就得放进关键词。**
  // 那两件的槽位因此空出来，待重新设计
  // 相消那句**两边都要写**：玩家可能只点开其中一条，
  // 而「冰火不共存」是个双向规则，单边记录等于一半的玩家不知道
  { word: '燃烧', desc: '贴在牌上的标签。场上每打出一张牌（双方的都算），堆上带【燃烧】的牌就给左右各一格的牌也贴上【燃烧】。遇到【结冰】，两个一起消失。' } as Term,
  // 【燃尽】单独立一条，因为它有三处玩家**算不出来**的东西：
  //
  //   **判定在匹配之前，而且一手只判一次** —— 所以匹配收掉几张之后
  //     剩下的正好全带火也不触发，要等下一手。连带一个真陷阱：
  //     **匹配之后留下一个全带火的堆 = 把下一次燃尽送给对手**
  //     （他出牌那张不带火落下 → 蔓延点着它 → 全堆带火 → 他燃尽）。
  //   **带【保护】的牌点不着** —— 于是堆上只要有一张，「全堆带火」
  //     永远不成立。那是这条规则最强的对位解，**一张牌锁死整条线**。
  //   **归「这一手的出牌方」** —— 不记谁点的火。所以你点的火可能被对手收，
  //     而那正是「什么时候点」成为决策的原因。
  { word: '燃尽', desc: '堆上的牌全带【燃烧】时，整堆归这一手的出牌方 —— 不管火是谁点的。它在匹配**之前**判，而且一手只判一次：所以你匹配收走几张之后剩下的牌正好全带【燃烧】，这一手也不会触发，要等下一手（那一手是对方的）。带【保护】的牌点不着火，所以堆上只要有一张，就永远烧不尽。' } as Term,
  // 【结冰】这一条有三件事玩家**算不出来**，所以一条都不能省：
  //
  //   它拦的是**收牌**不是匹配（带结冰的牌照旧能当钓点）——
  //     这跟护饵 / 硬壳那一类完全不同，不说清玩家会以为它钓不动；
  //   **不计分** —— 拦下来的那一张不算任何人的分，而这个玩法里
  //     「积分 = 收走的张数」，所以「没走所以没分」要明说；
  //   **和燃烧相消** —— 两个标签的交互，纯规则，没法从别处推出来。
  //
  // 不可叠加那条顺带也写了（不然玩家会试着叠）
  // 五句，而这已经是一条词条的上限了 —— 再加规则就得拆。
  // 「堆上 / 手里」那组对照是它的骨架：**同一个标签，两个位置意思相反**。
  //
  // 「连 J 通吃也挡」照【保护】那条先例特意写出来 —— 那是个会被误解的点
  //（J 通吃是基础规则里最硬的一条，玩家默认它无视一切）。
  // 而结冰是**全表第一件能削 J 的玩家侧手段**（在它之前只有庄家规矩【逆钩】
  // 削得到 J），所以这一句不能省。
  //
  // 技能说明里**不写这一句**（照 desc 那条「不解释词表里的词」）
  { word: '结冰', desc: '挂在牌上的标签，不能叠加。**堆上**带它的牌被收走时不走也不计分，只去掉标签 —— 连 J 通吃也挡，而它照旧能当匹配的那一张。**手里**带它的牌打出去时，这一手收牌不受【结冰】影响。遇到【燃烧】，两个一起消失。' } as Term,
  // 顺子那条**必须**写进词表，而且必须写「10 和 Q 之间断开」——
  // 那一条玩家**算不出来**：J 打出就通吃走了、从不留在堆上，所以堆上
  // 永远没有 11 点。不告诉他，他就只会觉得 Q K 那头的伏流坏了
  { word: '顺子', desc: '点数连着的几张牌（比如 5 6 7），至少 3 张。堆上的牌不用挨在一起，点数连上就算。A 两头都能接（A-2-3 和 Q-K-A 都算，但同一条顺子里只能用一次）。注意 J 从不留在堆上（它打出就通吃），所以堆上没有 11 点 —— 10 和 Q 之间是断开的。见底压成 0 点的牌算在 0 这一格（0 和 A 连得上）。' } as Term,
  // ---------- 【顺子匹配】：特殊匹配，判在普通匹配**之前** ----------
  //
  // 结算顺序（跟【燃烧】那一步同一个位置逻辑）：
  //
  //   落堆 → 场上效果 → **特殊匹配（这儿）** → 燃烧 → 普通匹配
  //
  // ---- 通则：**顺子必须含你刚打的那张** ----
  //
  // 试过「不要求参与」（把涉水那条特例升成通则），**撤回了** ——
  // 它造成**双收**：顺子收走别处那几张，而你打的那张还在堆上，
  // 于是普通匹配照常走、这一手收两次。
  //
  // 而「必须含它」把那件事挡死了，**而且是免费的**：
  // 顺子一定收走它（它是链的一员），牌不在堆上了，
  // 后面 resolveMatch 自然没得判。跟燃尽那道闸同一个原理 ——
  // **顺序给的,不是条款给的。**
  //
  // ---- 【涉水】那条「这张可以不参与」也**撤掉了**，同一个理由 ----
  //
  // 它原先是全表唯一一个双收的口子，而那违反「收一片的代价是这张不钓」。
  //
  // **代价是明的,旧数就摆在那儿**：`WADE_SELF` 那两档量过 ——
  //   必须参与 **+1.03** / 可以不参与 **+2.08**（旧口径）。
  // 所以涉水身上那 **+1 分就是双收**。撤掉它等于把那一分还回去，
  // 涉水会掉到档外很远，而且跟伏流只差「步长 2 vs 通配」一条 ——
  // 而通配那条量出来值钱得多（+2.56 vs 那一档）。
  //
  // > 那不是撤错了：**一个靠违反不变量撑起来的 +1 分不该留着**。
  // > 但它意味着涉水需要重新设计，而不只是重新定价。
  //
  // ---- 另两件玩家算不出来的 ----
  //
  //   **凑不成会退回普通匹配** —— 所以带这类技能的牌不是「只能靠顺子」。
  //     那是伏流定下来的实现（`FLOW_VOID=0`，注释写着「保留点数，
  //     凑不成顺子就退回普通点数匹配」），技能说明里读不出来。
  //   **只收组成顺子的那几张** —— 普通匹配收的是「那一张到堆顶」一整段，
  //     顺子匹配**不收中间夹着的牌**。两条收法差得很远，不说会算错。
  { word: '顺子匹配', desc: '**特殊匹配**，判在普通匹配之前。打出后看场上有没有【顺子】—— **不要求你刚打的这张参与**，堆上本来就有就算。凑成就收走**组成顺子的那几张**，跟普通匹配不一样，中间夹着的牌不跟着走。那几张里要是包含你打的这张，它跟着走、这一手就没有普通匹配了；不包含的话它还在堆上，普通匹配照常走。凑不成也只是退回普通匹配，不算白打。一条顺子里至少要有 2 张是真点数的牌。' } as Term,
  // ---------- 【通配】：顺子那一族的材料 ----------
  //
  // 四件事必须写进词条，缺一条玩家就读不懂：
  //
  //   **它不改点数** —— 所以贴了通配的牌**照旧钓得走**。那是这一族的
  //     对位解，跟【燃烧】同一条（标签不碰点数 → 它钓得走 → 有解）。
  //     不说的话玩家会以为通配是个保护。
  //   **它留着** —— 标签跟着那张牌，所以堆上的通配会**攒**。那是它跟
  //     【伏流】自带那一次通配的根本区别，也是这一族第一次有
  //     「跨回合积累的场面」（燃烧靠这个冲到 +3.85，顺子族一直没有）。
  //   **它能当 11** —— 于是它**填上了顺子那条里写的那个洞**
  //     （J 不留堆上 → 没有 11 点 → 10 和 Q 断开）。那是这一族
  //     结构性的天花板，而通配是唯一拆得掉它的东西。
  // 「一条顺子里至少 2 张真点数」那道闸**写在【顺子匹配】那条**，
  // 不写在这儿 —— 它是那条线的规则，不是这个标签的性质
  //（照「一件事只在一处说」）。那个「2」是要量的数：
  // 伏流那儿已经有同一道闸（`md-sim/rules.js` 的 `opt.pileMin`，
  // 原注释写着「防纯手牌凑」）
  { word: '通配', desc: '贴在牌上的标签。那张牌**凑【顺子】时可以当任意点数**（包括 11 —— 所以它能接上 10 和 Q 之间那个断口）。它**不改变那张牌的点数**，所以照旧有人按点数钓得走它；钓走了标签也跟着没。' } as Term,
  // 〔例子换过：原先写「沉底、合流是这一类」，**两件都删了**
  //   （合流 10-14、沉底 10-15）。现在带「优先」的只剩【结凌】一件 ——
  //   查法是 `draw-skills.uts` 里的 `first: true`〕
  { word: '优先', desc: '这个效果在匹配判定之前结算。同一张牌上有几个效果时，带「优先」的先走（结凌是这一类）。' } as Term,
  { word: '覆盖面 / 盖 N 张', desc: '这套配装一共管多少张牌。花色槽一个管 12 张，点数槽一个点数管 4 张。它是双方唯一能横着比的强度数字。' } as Term,
  { word: '槽', desc: '角色卡上印死的格子，上面写着点数或花色。技能装进槽才生效，管哪些牌由槽决定。' } as Term,
  { word: '常驻特殊技', desc: '角色自带的那一件，整轮都在、不占槽、不用打特定牌触发。' } as Term,
  // ---- 「组合技」2026-10-15 改名成「双触发」，而且定义变了 ----
  //
  // 原定义是「两件技能**合成第三种效果**」，举的例子是「退潮 × 见底 = 干塘」。
  // **那个机制现在一个实例都没有了**：干塘是唯一一件，而退潮一删它就跟着死
  //（实现条件 `hasTrigger(SK_EBB) && hasTrigger(SK_LOWTIDE)`，SK_EBB 已是 −1）。
  //
  // 但**「一张牌同时触发两件技能」这件事是真实存在的**，而且玩家必须知道 ——
  // 角色卡的槽会交叠（镜湖占卜师 ♥ + '3 4' → ♥3 / ♥4 落在两个槽里），
  // 那张卡的 desc 就是靠这个卖的。
  //
  // 所以词条留着、改成描述真实机制。**两件技能各自结算，不合成新效果** ——
  // 那半句定义删掉是为了不让玩家去找一个不存在的东西。
  //
  // 〔「组合技」这个说法在设计文档里还是一整章 —— 那是**设计空间**的名字
  //   （「两件撞在一张牌上能不能合成第三种」），不是玩家要查的机制。
  //   哪天真做出第二件组合技，再把这个词加回来。〕
  { word: '双触发', desc: '一张牌同时落在两个槽的覆盖面里时，两件技能都会触发，各自结算。角色卡的槽会交叠 —— 比如镜湖占卜师的 ♥3，既在 ♥ 槽里又在「3 4」槽里。' } as Term
]

// ==========================================================
// ---------- 挑词条：实战手册要印哪几条（2026-10-14） ----------
// ==========================================================
//
// 实体对战时玩家手边没有规则弹窗，所以手册得自带词条。
// 问题是**不能无脑子串扫全部 22 条**，那会把规则面板整个抄一遍：
//
//   「堆」命中约 **40/48** 条技能说明（堆上/堆底/堆顶/整堆）；
//   「点数」约 30 条，而且它还是「无点数」「增减点数」的子串；
//   「匹配」「槽」几乎每条角色说明都含。
//
// 所以分三类：**基础词恒印**（它们每套配装都要用，而且扫也没区分度）、
// **可扫描词按命中印**、**旗标词**看 `first`。
//
// 实测效果：每套配装的专属词条 3~7 条 + 恒印的 9 条基础词。
// 全扫一遍的话每套都返回十五六条

// 恒印。这几个词要么在每条说明里都出现（扫了没意义），
// 要么压根不出现在正文里（「覆盖面」只在界面上），而两种都是读手册必须的
export const BASE_TERMS : string[] = [
  '点数', '匹配', '堆', '槽', '覆盖面 / 盖 N 张', '常驻特殊技',
  // 〔'组合技' → '双触发'（2026-10-15 改名，理由见那个词条的注释）。
  //   **这儿不跟着改就会静默少印一条** —— 这张表按词的字面匹配词条〕
  '增减点数', '变成 X', '双触发'
]

// 按命中印。**顺序必须长词优先** —— 命中「无点数」之后要把它从文本里抹掉，
// 否则「点数」会在同一处再命中一次（而它已经是基础词了，白点亮一条）
export const SCAN_TERMS : string[] = [
  '顺子匹配', '获取下一张', '无点数', '燃尽', '燃烧', '结冰',
  '通配', '顺子', '叠放', '保护', '在场', '置 0'
]

// 词表里有三条 word 带后缀或占位符（'获取下一张 X'、'变成 X'、
// '覆盖面 / 盖 N 张'），而技能说明里写的是不带后缀那部分（【获取下一张】）。
//
// 用一张小映射对上，**而不是给 Term 加一个 match 字段** ——
// 加必填字段要改全部 22 条字面量，其中 19 条填的都是空串。
// 按空格切也不行：'置 0' 会被切成 '置'
export function termMatchKey(word : string) : string {
  if (word == '获取下一张 X') {
    return '获取下一张'
  }
  if (word == '变成 X') {
    return '变成'
  }
  if (word == '覆盖面 / 盖 N 张') {
    return '覆盖面'
  }
  return word
}

// 'A【燃烧】B【结冰】' → ['燃烧', '结冰']
//
// 用 split 而不是游标循环 —— 这个项目里**没有 indexOf(needle, from)**
// 这种两参用法，也不要正则（String.replace 全项目零出现）
export function bracketWords(text : string) : string[] {
  const out : string[] = []
  const parts = text.split('【')
  for (let i = 1; i < parts.length; i++) {
    const end = parts[i].indexOf('】')
    if (end > 0) {
      out.push(parts[i].substring(0, end))
    }
  }
  return out
}

// 一个词对应 TERMS 的第几条，查不到 -1。
//
// **查不到是正常的**：'获取下一张 X' 的说明里含【野火】，那是技能名不是术语，
// 调用方静默丢掉就行
export function termIndexOf(word : string) : number {
  for (let i = 0; i < TERMS.length; i++) {
    if (termMatchKey(TERMS[i].word) == word) {
      return i
    }
  }
  return -1
}

// 给几段文字（角色的常驻特殊技说明 + 已配技能的说明），算出手册要印哪几条词条。
// `anyFirst` = 这套里有没有带「优先」的技能（那个词从不出现在正文里，
// 它是 `DrawSkill.first` 渲染出来的）。
//
// 按 TERMS **原序**返回 —— 那个顺序是规则面板里排好的，有依赖关系
//（先「点数」再「匹配」再「堆」）
export function termsFor(texts : string[], anyFirst : boolean) : Term[] {
  const on : boolean[] = []
  for (let i = 0; i < TERMS.length; i++) {
    on.push(false)
  }
  for (let i = 0; i < BASE_TERMS.length; i++) {
    const at = termIndexOf(termMatchKey(BASE_TERMS[i]))
    if (at >= 0) {
      on[at] = true
    }
  }
  for (let t = 0; t < texts.length; t++) {
    // 一、带【】的
    const words = bracketWords(texts[t])
    for (let w = 0; w < words.length; w++) {
      const at = termIndexOf(words[w])
      if (at >= 0) {
        on[at] = true
      }
    }
    // 二、裸着写的。**37/48 条技能说明根本不带括号**，所以这一遍是主力。
    // 长词优先 + 命中就抹掉那一段（掩码），不然短词会在同一处重复命中
    let rest = texts[t]
    for (let s = 0; s < SCAN_TERMS.length; s++) {
      const key = SCAN_TERMS[s]
      if (rest.indexOf(key) >= 0) {
        const at = termIndexOf(key)
        if (at >= 0) {
          on[at] = true
        }
        rest = rest.split(key).join('')
      }
    }
  }
  if (anyFirst) {
    const at = termIndexOf('优先')
    if (at >= 0) {
      on[at] = true
    }
  }
  // 三、**闭包**：词条之间互相引用（燃烧→【结冰】、燃尽→【燃烧】【保护】、
  // 顺子匹配→【顺子】、通配→【顺子】），把前置的那几条也拉进来。
  // 跑到不再变为止，最多三轮（链最长就是 燃尽→燃烧→结冰）
  for (let round = 0; round < 3; round++) {
    let added = false
    for (let i = 0; i < TERMS.length; i++) {
      if (!on[i]) {
        continue
      }
      const words = bracketWords(TERMS[i].desc)
      for (let w = 0; w < words.length; w++) {
        const at = termIndexOf(words[w])
        if (at >= 0 && !on[at]) {
          on[at] = true
          added = true
        }
      }
    }
    if (!added) {
      break
    }
  }
  const out : Term[] = []
  for (let i = 0; i < TERMS.length; i++) {
    if (on[i]) {
      out.push(TERMS[i])
    }
  }
  return out
}
