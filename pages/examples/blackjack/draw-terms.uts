// 摸打钓鱼 · 规则文本（名词解释 + 规则条目）
//
// 两张表都是**给人看的字**，没有逻辑。放一起是因为它们的读者是同一拨：
// 规则面板（`draw-levels.uvue`）和实战配装手册（`draw-duel.uvue`）
//
// ---------- 为什么单独一个文件（2026-10-14） ----------
//
// 这张表原先是 `draw-levels.uvue` 里的局部 const。而 uvue 的 `<script setup>`
// **不导出任何东西**，所以别的页面一个字都拿不到。
//
// 实战对决的配装手册是**独立页面**（`draw-duel.uvue`），而实体对战时玩家
// 手边没有规则弹窗 —— 技能说明里全是【燃烧】【结冰】【通配】这类词，
// 查不到定义规则就执行不下去。所以手册必须自带词条，于是这张表得搬出来。
//
// **搬出来的附带好处**：规则面板和实战手册从此读**同一份**词表。
// 要是复制一份，两份必然分叉 —— 这个项目已经吃过那个教训
//（设计文档里记着 18 处引用因为复制而失效）。
//
// 整段搬的时候**注释一起搬**：燃烧、燃尽、结冰、21 匹配、顺子匹配、通配
// 那几条各带着几十行设计记录，它们解释的是「为什么这条规则只有这一句」——
// 丢了就只剩结论，下次有人就会把砍掉的东西再加回去

// ---- 规则条目 ----
//
// 写死的文字。规则改了这儿要跟着改 —— 数字（手牌 4 张、生命、技能库上限……）
// 跟代码里的常量对应：HAND_SIZE（ap-fishing）、DIFF_LIVES / LIBRARY_CAPS /
// DIFF_REWARD_RATE（draw-levels），利息档位见 interestOf
export type RuleSec = {
  title : string
  lines : string[]
}

export const RULES : RuleSec[] = [
  { title: '对局', lines: [
    // 「切牌定庄」是 2026-10-15 加的。原先写死「庄家先手」——
    // 而那让玩家恒后手，整个闯关难度表都建在那个假设上。
    //
    // 这两句的**顺序跟实现一致**（剔牌在前、切牌在后，见 ap-fishing 的
    // trimDeck 和它下面那段）—— 切出来那张要算进庄家记牌的底数，
    // 所以它必须在剔完之后才翻。
    //
    // 剔牌那一句 2026-10-15 改过：原先是「超过 52 张就剔到 52，而且要偶数」。
    // 52 那道上限删了（牌组现在可以任意厚），留下的只有奇偶那一道，
    // 而且锁的是**发完牌之后的牌库** —— 理由见 trimDeck 那段
    '洗好牌先看一眼：发完手牌之后牌库要是单数张，就从牌顶剔掉 1 张凑双数。',
    '然后翻一张定先后手：红 = 庄家先手，黑 = 你先手。那张牌给先手的人（双方都看得见它）。',
    '双方补足 4 张手牌，轮流每回合打 1 张，回合末补足 4 张。',
    // 终局那两句 2026-10-15 整个换了（原先是「牌库和双方手牌都空了」+
    // 「剩堆归没打最后一手的那一方」）。理由、四档实测数和那块墓碑
    // 都在 ap-fishing 的 TAIL_PLAYS / leftoverFor 两段注释里
    // 〔2026-10-27 从「各再打 1 手」改成「各再打 3 手」：加了【抢牌】之后
    //  先手反过来占了 0.88 分，而拉长终局是把它推回来的那条路（模拟器
    //  四档实测在 TAIL_PLAYS 那段）。这一句是**玩家唯一看得到的那份**，
    //  跟 TAIL_PLAYS 对不上就是 bug —— 真相在实现那一层〕
    '牌库空了之后，双方各再打 3 手就收摊 —— 而且一局里双方打的牌数要一样多，不够的那一方补一手。',
    '收摊时积分高的赢。手里剩的牌和堆上剩的牌都不算分。'
  ] } as RuleSec,
  // ---- 手牌区旁边那两个区〔2026-10-26 加〕 ----
  //
  // 归 `RULES` 不归 `TERMS`，判据跟「点数」那一节一样：
  // **它们是全局规则，不属于任何一件技能** —— 任何效果往区里放牌，
  // 之后发生的事都一样。写进技能说明就会分叉（每件各写一遍）。
  //
  // ⚠ 【堆牌】那个**标签**是词条（在 TERMS 里，挨着【推牌】）——
  //   区是规则、标签是技能效果，两样分开。这儿只说区怎么用
  { title: '手牌区旁边那两个区', lines: [
    '这两个区跟手牌区并排，没有牌的时候不显示。',
    // 必须写「1 张」—— 区里可能不止一张，而「全打出去」和「挑一张」
    // 是两种完全不同的规则。用户给的原文就是「选择上牌区的 1 张牌打出」
    '**上牌区**（牌是正面的，双方都看得见）：轮到你的回合，上牌区有牌的话，这一轮**必须**从上牌区挑 1 张打出，不能打手牌。打完照旧在回合末补足 4 张手牌。',
    // 「不算你打的牌」这半句要写：玩家会按「我这回合打了两次」去算
    // 终局那两手，而落堆不是出牌
    '**堆牌区**（牌是盖着的，双方都看不见）：轮到你的回合**开始时**，区里的牌先按【推牌】的规矩落到堆上，然后才是你的出牌阶段。它们**不算你打出的牌**。'
  ] } as RuleSec,
  { title: '出一张牌的顺序', lines: [
    // 〔举例那三件（压邻 / 封色 / 分水）2026-10-14 全删了，10-16 换成现存的两件。
    //   这一行举例子是为了让「场上效果」这个词落地 —— 所以**必须举活着的**〕
    '① 进场：牌落到堆上（落堆底的落到堆底），先受场上效果影响（净滩、寒流……）。',
    '② 发动这张牌的技能：同一张牌有几个效果时，先执行带「优先」的。',
    // 〔2026-10-23 改成阶梯计分，**2026-10-27 翻回「收几张记几分」**（用户定）。
    //   ~~收 3 张以内记 1 分，4~5 张记 4 分，6 张以上记 12 分~~
    //   翻回来的理由在 `draw-skills.uts` 的 SCORE_BANDS 那段：阶梯是为了
    //   「让养堆值钱」，而【抢牌】（下面 ④）把决策直接装回每一手上了；
    //   并存还有实际代价 —— 抢牌的门槛比**张数**，档值比**分**，两套在
    //   4 张那一格打架（4 张和 5 张同是 4 分，可 5 张抢得过 4 张）〕
    '③ 匹配：这张牌还在堆上的话，跟堆里同点数的牌对上，就收走从那张到堆顶的整段 —— **收走几张就记几分**。',
    // ---- 【抢牌】〔2026-10-27 加〕----
    //
    // 归 `RULES` 不归 `TERMS`，判据跟上面「点数」那一节一样：
    // **它是全局规则，不属于任何一件技能**。
    //
    // 三句话对应实现的三处（`ap-fishing.uvue` 的 askSteal / stealGainOf /
    // drainStealTails，以及模拟器 `tools/md-sim/rules.js` 的 stealTry）：
    //   「比你多」= **严格多于**（一样多不许抢）—— 而这一条同时是
    //     反复互抢的终止条件：每抢一次堆上就多一张，收成只能越来越大；
    //   「J 也能被抢」要写出来 —— 用户原话「J 也可以被抢，所有能收整堆的
    //     都能互相抢」，而玩家的直觉是「通吃不可阻挡」；
    //   「不多占一个回合」是这件规则**不用给代价**的理由（用户 2026-10-27 定）：
    //     抢牌方用掉了自己下一手的出牌权，出牌序一个字没变
    '④ 抢牌：匹配成功之后**先不收牌** —— 对方可以打出 1 张牌来抢，只要他这一手收的张数**比你多**（一样多不算），这一段就归他收，你这一手白打。',
    'J 通吃也能被抢 —— 能收整堆的牌之间照样互相抢。而且**可以反复互抢**：他抢了你还能再抢回来，直到谁都抢不动为止。',
    '抢牌成功之后双方补足手牌，接着轮到**没抢到的那一方**出牌 —— 所以抢牌不多占一个回合，抢的人是拿自己下一手的出牌权去换的。'
  ] } as RuleSec,
  // ---- 点数那一节 ----
  //
  // 这几条是**全局规则**，不属于任何一件技能 —— 所以技能说明里不写，
  // 只在这儿写一次。代码里的落点：
  //   减到 0 为止        → ap-fishing 的 dropVals
  //   0 不匹配           → ap-fishing 的 anyEquals
  //   无点数跳过增减     → dropVals 对空列表原样返回
  //   无点数受「变成 X」 → ap-fishing 的 valuesOf（净滩那一支在前、见底那一支在后）
  //   无点数比大小算最大 → ap-fishing 的 valuesOf（齐顶那一支）
  //
  // 〔原先这儿写的是 `landVals（分水那一支）`—— 分水 10-14 删了，
  //   而 landVals 这一轮也清空成一层只转发的壳子，落点全在 valuesOf〕
  { title: '点数', lines: [
    '点数减不到负数，最小是 0；往上不设限（贴点数卡能叠到多少算多少）。',
    '0 点不匹配 0 点 —— 两张都见了底的牌不该还能互相钓。（0 跟 1 照旧算「差 1」，磁钩钓得上。）',
    '一张牌可以同时算几个点数（贴过点数卡的）。任一个点数对得上就算匹配；几个点数全归 0 才算「点数为 0」。',
    // 这儿**不列哪几件技能** —— 名单只在词表的【增减点数】那一条里，
    // 列第二遍就会分叉（这一行和那两条词条都在 10-14/10-15 过期过）
    '无点数不受「增减点数」影响，但受「变成 X」影响（置 0、置无点数都算）。',
    // 〔这儿原先有一行「0 点的牌不受【大数】影响」—— 那是 2026-10-20
    //   为那个标签加的**新例外**，而【大数】当天判废、从游戏去除了，
    //   所以这一行跟着撤。
    //
    //   ⚠ 它留下一条判据，**下一件改点数的效果要重新面对**：
    //   上一行护的是「**无点数**」，而 **0 点牌不是无点数**（它在点数轴上，
    //   撒网 / 【顺子】/【21 匹配】都带得走它）。所以任何「增减点数」的
    //   新效果都得自己决定要不要豁免 0 点 —— 而豁免护的不是那件技能，
    //   是**别的三条线的材料**：21 匹配的免费垫片、削水的收割目标。
    //   这条判据写在【大数】那块墓碑里（上面「点数」那一节往下）〕
    '无点数在比较大小时算最大 —— 所以堆上躺着一张无点数的牌，齐顶就抄不到数，白打一张。',
    // 这一条的次序**就是 valuesOf 里 return 的次序**（先 return 的赢）。
    // 改那个函数里任何一支的位置，这一行要跟着改
    //〔**见底 2026-10-19 删了**，所以这条链里去掉了「> 见底（置 0）」那一段。
    //  `valuesOf` 里它那一支跟着没了，而**链上剩下的次序一个都没动**〕
    '同一张牌上几个「变成 X」一起生效时，前面的盖后面的：封竿、死水（置 0）> 收色、净滩（置无点数）> 齐顶（算最大）。'
  ] } as RuleSec,
  { title: 'J', lines: [
    'J 只有通吃：堆上有牌时打 J，整堆收走；空堆上打 J 只收走它自己。',
    'J 不触发任何技能；让牌「没有点数」的场上效果也挡不住它通吃。'
  ] } as RuleSec,
  { title: '角色和技能', lines: [
    '每一轮开局选一张角色卡：它带一件常驻特殊技，还有几个印着点数或花色的槽。',
    '技能装进槽才生效：打出的牌落在槽上印的点数或花色上，就触发那个槽里的技能。',
    '技能是通用的，装进哪个槽都行；管哪些牌由槽决定（花色槽 12 张，点数一个 4 张）。'
  ] } as RuleSec,
  { title: '闯关', lines: [
    '一轮 12 关。过关拿金币（过关奖励 + 胜分 + 利息，胜分最多 +10），然后进商店。',
    '没花完的钱每关生利息：攒到 30 给 3，之后每 40 给 5，最多 25。',
    '输一关扣 1 点生命，退回上一个商店（金币、技能、货架都是那时的样子）；第 1 关输了就重打。生命用完，这一轮作废，从第 1 关重来。',
    // 平局 2026-10-15 从「重打这一关」改成「算过关」。
    // 金币自然就少 —— 胜分就是分差，平局时是 0，不用加特殊规则
    '平局算过关，但拿不到胜分那一笔（胜分 = 分差）。'
  ] } as RuleSec,
  { title: '商店和技能库', lines: [
    '买来的技能先放进技能库，再装进槽。装上、卸下、换槽都不花钱。',
    '技能库满了就买不了技能，得先卖掉一件；卖出拿回买价的一半。',
    '道具买了立刻用；货架可以花钱换一批，价钱翻倍涨。'
  ] } as RuleSec,
  { title: '难度（一轮开始前选）', lines: [
    // 生命 2026-10-15 退回 3/2/1（见 draw-levels 的 DIFF_LIVES）——
    // 困难因此重新是「一命通关」
    '简单：庄家前 4 关随机出牌、之后不记牌；过关金币 ×2；生命 3；技能库 8 件。',
    '普通：庄家第 1 关随机出牌、第 3 关起记牌；过关金币 ×1.2；生命 2；技能库 6 件。',
    '困难：庄家每一关都记牌；过关金币 ×0.75（第 1 关保底 80）；生命 1（一命通关）；技能库 5 件。'
  ] } as RuleSec,
  { title: '终局对决', lines: [
    '一局定胜负，不记账：不发金币、不推关号、不动存档。',
    '可以自定义角色和技能，也可以随机。难度只管庄家怎么出牌、配装多满。'
  ] } as RuleSec
]

// 实战手册只印**跟实体对战有关**的那几节。
//
// 「闯关」「商店和技能库」「难度」「终局对决」讲的是手机那套单人流程
//（金币、生命、技能库上限），拿真牌打的时候一条都用不上 ——
// 印出来只会让人去找那些不存在的东西
// 〔'手牌区旁边那两个区' 2026-10-26 加 —— **拿真牌打一样要用**
//   （桌上多摆两摞：一摞正面朝上、一摞扣着），所以它进白名单。
//   ⚠ 这张表是**按标题字面**筛的，改了上面那节的 title 不跟着改这儿
//   就是**静默少印一节** —— 照【双触发】改名那次的教训〕
export const DUEL_RULE_TITLES : string[] = [
  '对局', '手牌区旁边那两个区', '出一张牌的顺序', '点数', 'J', '角色和技能'
]

// ---- 名词解释 ----
//
// 技能说明里会反复用这几个词（「置 0」「无点数」「在场」「优先」……）。
// 一件技能的说明只有一两行，塞不进定义 —— 所以定义集中放这儿，
// 说明里直接用词。
//
// **这一份跟技能说明是一套**：往技能表里写新说明的时候，
// 要么用这儿已有的词，要么在这儿加一条 —— 自己造一个新说法
// 会让同一件事在游戏里有两个名字
export type Term = {
  word : string
  desc : string
}

export const TERMS : Term[] = [
  { word: '点数', desc: '牌面印的那个数（A 算 1，Q 算 12，K 算 13）。J 没有点数这条轴，它只通吃。' } as Term,
  { word: '匹配', desc: '你打的牌和堆里某张「算同一个点数」。对上了就收走从那张到堆顶的一整段。' } as Term,
  // ---------- 【计分】：一条**匹配线的通则**，所以写在这儿〔2026-10-23 立〕 ----------
  //
  // 立它的理由照【顺子匹配】【21 匹配】那两次的先例：
  // **一条匹配线的通则不该写在某一件技能的说明里**。
  // 计分管的是**每一次收牌**（普通匹配、两条特殊匹配、燃尽、各种扫堆），
  // 挂在任何一件技能的 desc 上都会漏掉另外几条。
  //
  // ⚠ **2026-10-27 翻回「张 = 分」**（用户定，R5）。
  //   ~~一次收牌按收走的张数落档拿分：收 3 张以内记 1 分，4~5 张记 4 分，
  //   6 张以上记 12 分。每一次收牌各自落档 —— 收两次 3 张是 2 分，
  //   一次收 6 张是 12 分~~。理由在 `draw-skills.uts` 的 SCORE_BANDS 那段。
  //
  // ⚠ **这一条留着，别因为「张=分」就把它删了。** 它现在只有一句话，
  //   可它仍然是通则的落点，而且**旁边就得有** ——【结冰】说「不走也不计分」、
  //   【保护】说「只收走最下面那 1 张」、庄家规矩那两条「走几张记几张」，
  //   三条词条都要靠它才讲得通「分到底怎么来的」。
  //   〔R4 时期这一条更要紧：少 1 张可能从 12 分掉到 4 分。R5 之下
  //     少 1 张就是少 1 分 —— **后果变小了，但读者要的那个落点没变**〕
  //
  // ⚠ **n ≤ 1 那条例外照旧不写**。实现里收 0/1 张逐字返回张数，
  //   而 R5 之下它跟别的张数一个样 —— 更不用写了。
  //
  // ⚠ **口径别在这儿改。** 唯一的实现是 `draw-skills.uts` 的 `SCORE_BANDS`
  //   （现在是空数组 = 不分档），这一行是它的文案副本 ——
  //   改了那边**一定要回来改这一行**，还有『出一张牌的顺序』③ 那一句
  //   （同一件事，第三份副本）
  { word: '计分', desc: '**收走几张记几分** —— 一次收牌收走的每一张都算 1 分。被【结冰】挡住没走的那几张不算分；庄家规矩让堆底那张离场的那两条照样走几张记几分。' } as Term,
  { word: '堆', desc: '打出去还没被收走的那些牌，横着摆。最早打的在最左（堆底），最新打的在最右（堆顶）。' } as Term,
  // 「获取下一张」**必须**写进词表，因为同一件事原先有三种说法
  //（同号「选 1 张同点数」、同花「翻牌库顶拿第一张」、野火「取 1 张同点数」）——
  // 三种说法会让玩家以为是三种机制。
  //
  // ⚠ **三件现在只剩【野火】一件**（同花 2026-10-14 删、**同号 2026-10-26 删**），
  //   所以「统一三种说法」这个立词理由已经兑现完了。
  //   词条**留着**：野火的 desc 直接用这个词（`ap-fishing.test.js` 还断言
  //   词表里有它），而且下面那三段（卖点 / 洗牌库 / 毁情报）讲的是规则，
  //   跟有几个用户无关。
  //   ⚠ 但「从牌库检索」这条技能线现在**整条空了** —— 要再做，
  //   判据在 `draw-skills.uts` 同号那块墓碑里（池子大小决定挑法；
  //   别顺手把「随你挑」套成这个词，那是削弱不是换说法）。
  //
  // 「X 可以是技能」是这个词的**卖点**：那样池子跟着槽走
  //（花色槽 13 张、单点数槽 4 张），而原先写「同点数」时池子跟槽无关。
  //
  // 「拿到后洗牌库」是这个词的**限制**，而且是必要的：
  //   不洗的话「从顶往下第一张」是确定的，于是观潮 / 择饵
  //  （2026-10-16 前还有活水）一看牌库顶就能把整条连锁排好
  //   （野火一局要取好几张）——
  //   那不是给信息类技能开兑现口子，那是把随机性整段删掉。
  //   洗了之后它退回「一张随机的符合牌」。
  //
  // 连带一条玩家要算的：**它会毁掉你自己攒的情报**。
  // 刚看完牌库顶再打一张野火，那几张就白看了 ——
  // 于是「信息类 + 检索类」是个要排顺序的组合，不是无脑叠加
  { word: '获取下一张 X', desc: '从牌库顶往下找第一张符合 X 的牌，拿进手里，然后把牌库洗一遍。X 可以是点数（获取下一张 3），也可以是技能（获取下一张【野火】—— 指打出去会触发那件技能的牌）。找过的牌不翻开给对手看。牌库里没有符合的，就是「没取到」。注意洗牌会冲掉观潮、择饵刚看到的牌序。' } as Term,
  // ---------- 〔判废〕【判定】：加了又撤的一条词条〔2026-10-22 同日〕----------
  //
  // 2026-10-22 为【传火】那一刀加的（「翻开牌库顶 1 张定颜色，用完放回库底」），
  // **当天撤掉** —— 用户判废那个机制：「增加了不确定性，失去了决策」。
  //
  // 撤词条而不是留着的理由：**它一个载体都没有了**。留着等于实战手册
  // 多印一条玩家永远遇不到的规则，而手册是按词条表印的。
  //
  // 留下两条用得上的东西：
  //
  // 一、**判据**：把条件从「自身属性」挪开的时候，要挪到**局面**上，
  //    不是挪到随机上。局面（堆的形状）跟槽无关**而且玩家读得到** →
  //    决策还在；随机跟槽无关但谁也读不到 → 决策没了。那是拿一个病换
  //    另一个病：原来「花色槽里没决策」，换完「两种槽都没决策」。
  //    〔传火定稿换成了「堆上张数少的那个颜色」〕
  //
  // 二、**新关键词要先 grep 一遍全表的 desc**。那天它牵连了两处
  //    **毫不相干**的措辞（【优先】「在匹配判定之前」、【涉水】
  //    「判定时相邻差 1 或 2」）—— 两处都拿「判定」当普通动词，
  //    而 SCAN_TERMS 按字面扫，留着就会点亮一条不相干的词条。
  //    **那两处的改法保留了**（语义一个字没动，而且比原来干净）
  // 「**手里**那半句」是 2026-10-14 加的，因为死水改成了「把手牌变成
  // 0 点牌」—— 而牌面跟着变 `'0'` 之后点数槽就查不到它了。
  //
  // 那一条玩家**算不出来**：他看见牌面变成 0，不会想到技能也跟着没了。
  // 而「花色槽照旧」更要明说 —— 那是他唯一还能用那张牌做的事，
  // 也是这个效果留给他的决策（为了花色槽那件技能打出去、放弃匹配）
  // ---------- 「谁收得走 0 点牌」那半句 2026-10-19 重写 ----------
  //
  // 原文是「**见底**、撒网都收得走它」，而**见底当天删了**（它是唯一一件
  // 专门收 0 点牌的）。剩下三个出口都是**被动**的，一个都不是为 0 点牌做的：
  //
  //   【撒网】     0 算偶数 → 连续偶数段的材料（`castFor` 读 pileValsAt）
  //   【顺子】     0 和 A 连得上 → 0-A-2 合法（`deepestByVal` 收 v >= 0）
  //   【21 匹配】  0 点不占预算、也不断链 → 免费垫片，跟着那一段走
  //
  // 所以「造 0 点牌」现在退成**纯障碍手段**（0 点当不了普通匹配的钓点，
  // 见 `anyEquals` 里「0 对 0 不算相等」）。造它的只剩三条路：
  //【死水】（对方手里）、【推牌】词条（堆上，重复点数变 0 点）、庄家【封竿】
  { word: '置 0', desc: '把牌的点数变成 0。它还在点数这条轴上 —— 撒网、【顺子】、【21 匹配】都带得走它，只是它自己没法匹配。**手里**的牌被置 0 时牌面也跟着变 0，所以它不再触发点数槽上的技能；花色没变，花色槽照旧触发。' } as Term,
  // ---- 这两条 2026-10-15 改过，而且**改了两遍** ----
  //
  // 原先举的例子是「见底、退潮、干塘」，可**三件里有两件已经没了**：
  //
  //   【退潮】 2026-10-14 删（压底族六件之一）
  //   【干塘】 它是组合技「退潮 × 见底」—— **退潮一删它就跟着死了**
  //            （实现条件是 `hasTrigger(SK_EBB) && hasTrigger(SK_LOWTIDE)`，
  //             而 SK_EBB 现在是 −1，永不匹配）
  //
  // 第一遍改只去掉了退潮、把例子换成干塘 —— **那是把一个死的换成另一个死的**。
  // 干塘查不出来是因为它**没有 key、不在任何表里**（组合技是两件技能撞在
  // 同一张牌上合成的，不是表里的一行），所以 refs.js 第 6 项扫不到它。
  // 那个盲区后来补成了第 8 项（扫 `.uvue` 里的 `hasTrigger(A) && hasTrigger(B)`）。
  //
  // **这儿不再列具体技能，改成指【增减点数】那一条** —— 原先它和
  // 【增减点数】各列一份名单，而两份都在 10-14 / 10-15 分别过期过
  //（都写着退潮、干塘）。照「一件事只在一处说」：名单只留在【增减点数】里，
  // 这条引那个词。再删一件减点数的技能，就只有一处要改
  //
  //〔**而那一件 2026-10-19 真的删了**：原文这儿写着「所以『减点数』这一组
  //  现在只剩【见底】一件」，而见底当天也走了 —— **技能里一件减点数的都不剩**。
  //  上面那条「一件事只在一处说」的安排因此**兑现了**：这一轮只改了
  //  【增减点数】那一处（载体换成商店的推点数），这条词条一个字没动〕
  // 〔2026-10-21 加一句说明，**不改词条本身**〕这个词有**两种**完全不同的用法，
  // 而设计新件时得先分清是哪一种，不然会顺手配上不该配的那一半：
  //
  //   一、**延命** —— 配着「落堆底」成套用（【寒流】【满篓】【窄口】——
  //       ⚠ 前两件已删（寒流 2026-10-20、满篓 2026-10-26），**现在只剩窄口**）。
  //       互动 ≈ +1.2，**拆开用亏**（单上落堆底是负的）。
  //   二、**别自杀** —— 驻场效果的载体躺在堆上，带点数的话你自己打一张
  //       同点数的就把它匹配走了（【冻结】2026-10-21 改成这个）。
  //       **这一种不配落堆底。** 实测自毁率 42.3% → 34.3%，
  //       而残留的 33% 走花色匹配 —— 无点数挡不住，所以是减轻不是根治。
  //
  // 判据连查法在《摸打钓鱼-技能与关卡设计.md》第三节「③·甲」
  //
  // ⚠ **待修：最后那句「只有 J、顺色、收色带得走」已经不全了**〔2026-10-21 标记，没改〕
  //
  // 它漏掉了**整整一类**：**收一整段的效果**。那类不按点数挑牌，
  // 它按位置收「从某一格到堆顶」，段里夹着的无点数牌**照样跟着走**。
  //   【撒网】 收连续一段（`CAST_MODE='seg'`）
  //   【洪水】 2026-10-21 复活，每撞上点数就收「那张到堆顶」一整段
  // 另外本文件 690 行自己又列了一份更长的名单（「只有 J / 顺色 / 收色 /
  // 齐顶 / 磁钩挖得走」）—— **同一件事在两处各写了一份名单，而两份不一样**，
  // 正是上面 210 行那条「一件事只在一处说」要治的毛病。
  //
  // **没有当场改**：这是玩家看得见的文案，而改法有两种
  //（列全名单 / 改成「只有不按点数的效果带得走」），取舍要问过。
  { word: '无点数', desc: '这张牌彻底不在点数这条轴上。谁也没法按点数钓它、它也钓不了别人；【增减点数】一概跳过它。只有 J、收色带得走。' } as Term,
  // 「往上」那个例子**必须补**：原先举的是退潮（−牌面点数）和见底（−1），
  // 两个都是往下，而退潮 2026-10-14 还删了 —— 于是这条写着「往上或往下」
  // 却只有往下的例子。抬水是全表唯一往上的那件（`ap-fishing` 的 doPilePick
  // 里它撞上无点数时明确跳过，注释直接引着这一条）
  // ---------- 「往下」那个例子 2026-10-19 换了载体 ----------
  //
  // 原文举的是「抬水 +牌面点数、**见底 −1**」，而见底当天删了 ——
  // **于是技能里一件减点数的都不剩了**（退潮 / 干塘 10-14 走的，见底是最后一件）。
  //
  // 「往下」这半句**没撤**，因为它还有载体：商店的【推一格/两格/三格】
  // 是「点数 ±N」（`FIX_ITEMS`，往上不封顶、往下最低到 A）。
  // 所以这个词条讲的规则仍然成立，只是**载体从技能换成了商店道具**。
  //
  // ⚠ 连带还有一处**没人用了的全局规则**：`dropVals` 的「减到 0 为止」
  // 原先只服务见底。那条文案要不要跟着撤是下一轮的事（见见底那段墓碑）
  { word: '增减点数', desc: '把点数往上或往下挪（抬水 +牌面点数，商店的推点数 ±N）。无点数的牌不受影响。' } as Term,
  { word: '变成 X', desc: '把点数直接改成某个值 —— 置 0、置无点数、齐顶都算。无点数的牌照样受影响。' } as Term,
  { word: '在场', desc: '那张牌还在堆上。「在场时……」的效果，牌被收走就跟着没了（场上效果栏里看得见还挂着哪些）。' } as Term,
  // ---------- 【驻场】2026-10-19 加：把反复写的那三句缩成一个词 ----------
  //
  // 现存**三件**技能的 desc 都在重复同样三句，而这个词就是它们的公因式：
  //
  //   窄口  '在场时，对方每回合只补到 3 张手牌；它无点数，而且打到堆底'
  //   满篓  '在场时，你每回合补到 5 张手牌；它无点数，而且打到堆底'
  //   寒流  '自带【结冰】；无点数；落堆底；在场时，你打出的牌都自带【结冰】'
  //
  // ⚠ **三件现在只剩【窄口】一件了**：寒流随结冰族重做删了（2026-10-20），
  //   **满篓（槽技能那件）2026-10-26 删了**（常驻技满篓还活着，但常驻技
  //   不挂在牌上、不走 `expireHeld`，**不是这个词讲的那回事**）。
  //
  //   所以「把反复写的三句缩成一个词」这个理由**现在只剩一个用户** ——
  //   而公因式只有一项就不是公因式了。要不要撤这个词条**是设计判断，
  //   不是收拾卫生**（它还在规则面板里给玩家讲规则），留着待定。
  //
  // **这三件的 desc 暂时不改**（用户定），所以这个词现在零引用 ——
  // 它只在规则面板里出现（那边 `v-for` 列全部 TERMS），实战手册那边
  // 按命中印，没技能引用就不印，那是对的。
  //
  // ---- 「无点数 + 落堆底」是**延命**，不是装饰 ----
  //
  // 驻场件吃「它那张牌活多久」那个天花板（堆的换手 3.3 回合），
  // 上限 ~+2 —— 四个点：燎原 −1.24 / 焦壳 +0.08 / 寒色 +1.91 / 霜降 +2.05。
  // 寒流靠这两句把天花板捅破了（**+1.12 的交互**）。
  //
  // 「直到它离场」**没写** —— 照 draw-skills 文件头那条：
  // 「在场时」这个词本身就含那个意思，写出来是重复。
  { word: '驻场', desc: '它【无点数】、落到堆底，效果在它【在场】时一直生效；离场后已经造成的改变不还原。' } as Term,
  // ---------- 【对称】2026-10-19 加，**零载体，而且这条路被量废过四次** ----------
  //
  // 这个词描述的性质本身是清楚的（效果不分敌我）。但凡是想**设计**一件
  // 带它的技能的人，先读这三条实测 —— 四件同形状的技能全删了：
  //
  //   沸水  X = **0.00**（「在场时落堆的牌都带 1 层【燃烧】」，跟蔓延重复）
  //   燎原  X = **−1.24**
  //   焦壳  X = **+0.08**
  //   霜降  X = **+1.72**（定稿；早先 +2.05）
  //
  // **一、对称的障碍不值钱。** 判据原文：「『对称地给场面加障碍』一律
  //   不值钱，值钱的是只有你用得上的那种优势」—— 钥匙 vs 障碍，七个点坐实。
  //   同族那件**私有**钥匙（藏凌，一次性给整手牌）是 **+3.04**。
  //
  // **二、它跟【驻场】配在一起是最坏的组合。** 寒流靠「无点数 + 落堆底」
  //   捅破天花板是 +1.12 的交互，而**同样两句加在霜降（对称）上是
  //   +2.05 → −0.81（即 −2.86，后手 −2.83、D +2.03）** ——
  //   原因写在那条判据里：**延长一个对称效果的寿命 = 延长你自己付的税。**
  //   所以【驻场】那条路**只对私有效果有效**。
  //
  // 结论（霜降墓碑原文）：**「驻场 + 对称 + 只铺不收」这个形状
  // 在这个玩法里做不出合格的技能。** 要用这个词，得先避开「只铺不收」那一头。
  { word: '对称', desc: '它的效果不分出牌方，双方一样受。' } as Term,
  // 〔2026-10-23：末句从「所以**那几分**归收走的人」改成「算进这一次的收成」。
  //   R4 之后「张数」和「分」不是一回事了，而这个区别在这儿正好要紧 ——
  //   底下压着的那几张是**加张数**的，所以它们可能把整段顶进上一档（见【计分】）。
  //   ⚠ **R5（2026-10-27，张=分）之下两个口径又同值了，而这句措辞照旧用「张数」**
  //     —— 它说的是机制（垫着的牌跟着走），不是说的分。两次都对，
  //     所以不用改回去；下一次再动计分口径时它也不用跟着动〕
  { word: '叠放', desc: '把牌垫在堆上某张牌下面、或者盖在它上面。叠放的牌不参与匹配 —— 每一叠只有最上面那张算「当前牌」。那一叠被收走时，底下压着的跟着走，一起算进这一次收走的张数。' } as Term,
  // ---------- 「点不着火」那一句 2026-10-16 补上 ----------
  //
  // 它一直是实现的行为（`lightAt` 里 `wardAt(i)` 就 return false），
  // **可词条里一个字都没写** —— 于是玩家读不到凝水能当防火墙，
  // 而那是凝水对抗燃烧族（全表最强的一族）的全部价值。
  //
  // 两种消耗要分清，不然玩家会以为挡一次火就没了：
  //
  //   挡「被收走」→ **消耗一层**（`takeAt` 里 `pullStacked` 拉走垫牌）
  //   挡「点火」  → **不消耗**，挡无限次
  //
  // 而【燃尽】要求全堆带火 —— 所以**一张带保护的牌只要还在堆上，
  // 对手就永远燃不尽**。这一句不写，玩家看不见那条对位解。
  // ---------- 「挡冰」和「带上保护就去标签」2026-10-19 补上 ----------
  //
  // 挡【燃烧】那一句原先就有（`lightAt` 里 `wardAt(i)` 直接 return false），
  // 这次补的是另外两样，而**三样的消耗规则是同一条**（都不消耗保护）：
  //
  //   贴不上 —— 【燃烧】点不着、【结冰】也结不上（`addFrostAt` 那道新闸）；
  //   **已有的标签当场去掉** —— 这一条是新的，而它让保护从
  //     「拦住后来的标签」变成「**也能解掉已经贴上的**」。
  //
  // 三种消耗要分清，不然玩家会以为挡一次就没了：
  //
  //   挡「被收走」→ **消耗一层**（`takeAt` 里 `pullStacked` 拉走垫牌）
  //   挡 / 解「冰火」→ **不消耗**，挡无限次
  //
  // ---------- 〔删了〕「放弃出牌加一层」那个续层动作〔2026-10-19 加，10-21 删〕 ----------
  //
  // 原话是：「你也可以**放弃出牌**，给一张已经带保护的牌再垫 1 张手牌、加一层。」
  // **2026-10-21 用户定删。** 实现那头（`startPad` / `padTurn` 那一套）一起删了。
  //
  // 当时为它写的那条注意事项**随之作废**：它只对已经带保护的牌成立，
  // 不写明的话玩家会去点一张光牌 —— 而那是【凝水】的活儿。
  //
  // 删了之后保护**只有一条来路：【凝水】**（词条里不必再区分「光牌 / 已有一层」）。
  // 模拟器那头的 `PAD_ON` 一直是默认关的，所以**没有任何实测数跟着废**。
  { word: '保护', desc: '垫在堆上某张牌下面的牌给它保护。那张被收走时**只收走它最下面那 1 张**，保护少一层（可以叠多层，一层扛一次）；连 J 通吃也挡。带保护的牌**不受【燃烧】【结冰】影响**（这一条不消耗保护），而已经带着那两个标签的牌一旦带上保护，标签当场去掉 —— 所以它在堆上一直是整堆燃尽的缺口。' } as Term,
  // 【收纳】**2026-10-19 加，目前还没有技能用它** —— 词先定下来。
  //
  // 它跟【净水】的分工是方向相反的两种叠放（净水盖在上面代替那张、
  // 收纳把别的牌收到自己底下），而**实现还没做**：先写一个没人调用的
  // 取数函数，它会占着一个名字躺在那儿，而 `refs.js` 查不到源码里的孤函数
  //（2026-10-19 那个 H5 500 正是这么来的 —— 野火连锁撤稿后漏清的 `fuelPool`
  //   撞上了【薪潮】新加的同名函数）。所以等载体技能定了再一起写。
  { word: '收纳', desc: '把场上另 1 张牌【叠放】到它最下面。' } as Term,
  // ---------- 【燃烧】定稿（2026-10-13）：**只有一条** ----------
  //
  // 它走过「四条」那一版（标签不收牌 / 不改状态 / 自动蔓延 / 蔓延不收牌），
  // 收成一条是因为**那三条都是在说「它不做什么」**：
  //
  // > 一个标签默认什么也不做。只有读它的技能才赋予它意义。
  // > 所以只需要写清它**做**什么 —— 蔓延。
  //
  // 连带两条自然消失，不用再写：
  //   「贴到已有标签的牌上会怎样」—— 空操作（它已经有那个标签了），
  //     所以不会互相引爆，也不需要「只点没烧着的」那半句；
  //   「不改点数 / 不改花色」—— 没写就是不改。
  //
  // 相消那句归【结冰】（它那条已经写了），不在这儿重复 ——
  // 照 desc 那条「不解释词表里的词」的同一个道理：一件事只在一处说。
  //
  // ---- 收牌**整个归【野火】** ----
  //
  // 早先的通则是「贴到已带燃烧的牌上 → 收走它」，而它
  // **从头到尾只有 wildfireFor 在用**（沸水删了；手牌 / 牌库那条线上的件
  // 都是只贴火、不收牌）。所以它不是通则，是野火的效果。
  //
  // > 代价要认：**没带野火的人，这个关键词对他完全是零** ——
  // > 他只看见火在爬，而那只是在给对手标记。
  // > 野火因此是这一族的**单点故障**。要补就得加第二个收割器
  // > （照深钩那条形状：「钓中时连带收走带火的」），但那是另一件事
  //
  // ---- 第 2 条是这一族的**对位解**，所以碰不得 ----
  //
  // 带火的牌保留点数，于是对手能**在火烧过来之前把它钓走**。
  // 中间试过「带燃烧的牌无点数/置 0」（锁住），野火因此从 +0.50
  // 跳到 **+3.28** —— 有效，但它撤掉了那场抢时间，所以废弃。
  //
  // ---- 第 3、4 条合起来治那个七倍缺口 ----
  //
  // 诊断量出来：野火**贴火 2.11 张/次，收成只有 0.30** ——
  // 火的留存 ≈ 牌在堆上的留存（3.3 回合），而堆只有 3 张厚、换手极快，
  // 所以烧上去的火等不到下一次收就被人钓走了。
  //
  // 蔓延不保住**那几张**，而是**让火自己长回来**：堆薄、一手覆盖 +2 格，
  // 火一两手就铺满整堆。配上野火的连锁（获取下一张【野火】压短间隔），
  // 留存率从 32% 涨到 **74%**，野火 +0.51 → **+2.56**。
  //
  // 第 4 条（不收牌）砍掉了三样原本要加的东西：**归属数组**
  //（蔓延不收牌 → 收牌永远是出牌方造成的）、**「刚点着的火这一轮不传」**
  //（不会引爆）、以及一条「这一下收的牌归谁」的规矩。
  //
  // ---- 做成技能试过，不行 ----
  //
  // 蔓延原先是【燎原】、锁原先是【焦壳】。两件都挂在自己那张牌上，
  // 而**在场效果的强度上限由「它那张牌活多久」决定**，堆的换手是 3.3 回合 ——
  // 燎原 X = −1.24、焦壳协同只有 +0.08。
  // **想要一个稳定生效的全局规则，就得放进关键词。**
  // 那两件的槽位因此空出来，待重新设计
  // 相消那句**两边都要写**：玩家可能只点开其中一条，
  // 而「冰火不共存」是个双向规则，单边记录等于一半的玩家不知道
  { word: '燃烧', desc: '贴在牌上的标签。场上每打出一张牌（双方的都算），堆上带【燃烧】的牌就给左右各一格的牌也贴上【燃烧】。遇到【结冰】，两个一起消失。' } as Term,
  // 【燃尽】单独立一条，因为它有三处玩家**算不出来**的东西：
  //
  //   **判定在匹配之前，而且一手只判一次** —— 所以匹配收掉几张之后
  //     剩下的正好全带火也不触发，要等下一手。连带一个真陷阱：
  //     **匹配之后留下一个全带火的堆 = 把下一次燃尽送给对手**
  //     （他出牌那张不带火落下 → 蔓延点着它 → 全堆带火 → 他燃尽）。
  //   **带【保护】的牌点不着** —— 于是堆上只要有一张，「全堆带火」
  //     永远不成立。那是这条规则最强的对位解，**一张牌锁死整条线**。
  //   **归「这一手的出牌方」** —— 不记谁点的火。所以你点的火可能被对手收，
  //     而那正是「什么时候点」成为决策的原因。
  { word: '燃尽', desc: '堆上的牌全带【燃烧】时，整堆归这一手的出牌方 —— 不管火是谁点的。它在匹配**之前**判，而且一手只判一次：所以你匹配收走几张之后剩下的牌正好全带【燃烧】，这一手也不会触发，要等下一手（那一手是对方的）。带【保护】的牌点不着火，所以堆上只要有一张，就永远烧不尽。' } as Term,
  // 【结冰】这一条有三件事玩家**算不出来**，所以一条都不能省：
  //
  //   它拦的是**收牌**不是匹配（带结冰的牌照旧能当钓点）——
  //     这跟护饵 / 硬壳那一类完全不同，不说清玩家会以为它钓不动；
  //   **不计分** —— 拦下来的那一张不算任何人的分，所以「没走所以没分」要明说。
  //     〔2026-10-23：这儿原先的理由是「而这个玩法里『积分 = 收走的张数』」。
  //      R4 改成阶梯计分之后那句措辞不成立了，**而这一条更要写** ——
  //      少 1 张现在可能整段降一档（6 张 12 分 → 5 张 4 分），
  //      玩家更算不出来。desc 本身一个字没动。
  //      ⚠ **R5（2026-10-27）翻回张=分，那句原始措辞又成立了** ——
  //      少 1 张就是少 1 分。**这一条照旧不能省**：理由换回了原来那个
  //      （没走所以没分，而玩家的直觉是「挡住了但分还是我的」），
  //      desc 两次都一个字没动〕
  //   **和燃烧相消** —— 两个标签的交互，纯规则，没法从别处推出来。
  //
  // 不可叠加那条顺带也写了（不然玩家会试着叠）
  // 五句，而这已经是一条词条的上限了 —— 再加规则就得拆。
  // 「堆上 / 手里」那组对照是它的骨架：**同一个标签，两个位置意思相反**。
  //
  // 「连 J 通吃也挡」照【保护】那条先例特意写出来 —— 那是个会被误解的点
  //（J 通吃是基础规则里最硬的一条，玩家默认它无视一切）。
  // 而结冰是**全表第一件能削 J 的玩家侧手段**（在它之前只有庄家规矩【逆钩】
  // 削得到 J），所以这一句不能省。
  //
  // 技能说明里**不写这一句**（照 desc 那条「不解释词表里的词」）
  { word: '结冰', desc: '挂在牌上的标签，不能叠加。**堆上**带它的牌被收走时不走也不计分，只去掉标签 —— 连 J 通吃也挡，而它照旧能当匹配的那一张。**手里**带它的牌打出去时，这一手收牌不受【结冰】影响；**它落到堆上时，全场所有牌（含它自己）贴上【结冰】**。遇到【燃烧】，两个一起消失。' } as Term,
  // ---------- 【21 匹配】：第二条特殊匹配线〔2026-10-19 术语化〕 ----------
  //
  // 它**不是新机制** —— 规则一个字没改，只是从【吃水】那条 desc 里
  // 搬成了词条（用户定）。搬的理由跟【顺子匹配】那次一样：
  // 一条匹配线的通则不该写在某一件技能的说明里。
  //
  // ---- 次序：**所有特殊匹配一律判在普通匹配之前**〔2026-10-19 用户定〕 ----
  //
  // 这是一条**通则**，不是这一条词条的规则 —— 【顺子匹配】那条也这么写。
  //
  // ⚠ 它推翻了吃水原来的实现（**并列、取收得更多的那条**，`catchStart`
  // 里取 min 下标），而那条旧设计的理由是「加一条线不该让人收得更少」。
  //
  // **换掉它是为了决策，不是为了措辞统一**（用户定）：
  // 自动取收得多的那条 = 这张牌**什么时候打都是最优**，玩家不用想；
  // 优先之后打早了就**浪费掉更大的普通匹配**，于是「挑时机打出」
  // 成了真决策 —— 那正是【涉水】开的那个维度（决策是「什么时候打」）。
  //
  // **所以这次不只是术语化，还改了行为**，而且 X 掉下来是**有意的代价**
  //（照 13.11【涨落】：开维度的不卖强度，卖的是一套新打法）。
  // 墓碑和「别把次序改回去」那条叮嘱在 `catchStart` 里。
  //
  // ---- 锚点：从「堆顶」改成「**打出的那张牌**」〔2026-10-19 用户定〕 ----
  //
  // 规则现在是「**包含你打出那张的一段连续牌**」。判撞在落堆之前，
  // 所以实现上是「从**它将要落的那一头**起数」（`draftReach` 的 `sink`）：
  //
  //   落堆顶 → 从堆顶往下数 —— **跟旧规则一字不差**；
  //   落堆底 → 从堆底往上数 —— **这一头是新的**。
  //
  // 旧实现有一道 `!sink` 闸（沉底时这条线**压根不触发**），而那道闸
  // 正是「锚钉死在堆顶」造成的 —— 锚跟着牌走之后它自己就没了。
  //
  // **连带后果，而且是这次改动的全部价值**：【逆流】（可选落堆底）
  // 从「落点选择」变成「**挑这一段从哪头吃**」；而【寒流】【窄口】
  // 【满篓】那几件「无点数 + 落堆底」第一次能跟这条线配 ——
  // ⚠ 无点数的牌**不占预算**（`own=0` → 满 21），所以它们一落底
  // 就是满预算往上吃。**那个组合还没量**，插槽前先跑
  // `pair zerodraft narrow`（**槽技能里就剩这一件**了，见下）。
  //
  // ⚠ **这几条命令 2026-10-26 修过两次，而第二次是同一天打的补丁**：
  //   第一次改掉的是原文那两个双死的载体 ——
  //     【吃水】`draft`   2026-10-25 删（这条线改由【零递】承担）；
  //     【寒流】`coldhue` 2026-10-20 删（结冰族重做）。
  //   **第二次是因为 `creel` 当天也删了**（槽技能满篓）—— 所以
  //   `pair zerodraft creel` 又变成了半死的命令，已经撤掉。
  //   ⚠⚠ 它**跑起来不报错**：`skillIndexOf` → −1，而 `skAt` 只记一笔
  //   警告**不抛**，于是量的是一个空载体，**数照样打出来**。
  //   这就是「**失败是静默的**」，而这一段注释自己被它咬了两回。
  //
  //   另：`narrow` 同时是槽技能和常驻技，`pair` 走槽那一份；
  //   而**江口闸官自带【窄口】常驻技**，所以拿它当角色量这一格要去掉
  //   `--special`，不然搭档那一侧两头都有。
  //   〔`creel` 原先也是这样一件「同名两份」—— 现在槽那份没了，
  //     只剩常驻那份，所以它再也量不了这一格：常驻技不落堆〕
  //
  // ⚠ 还有一条**只能这么量**的：无点数落在**堆上**（不是打出的那张）时
  //   这条线会**断链**（`draftReach` 的 `stop='void'`）。而双方同角色的
  //   `vs` 口径下谁都不造无点数 —— 实测 `stopVoid` **恒 0.0%**。
  //   所以「无点数 × 21 匹配」这整个交互**只有 `pair` 量得到**，
  //   而那正是 `DRAFT_VOID_THRU`（穿过无点数）那个旋钮的主场。
  //
  // 「落堆底就从堆底往上数」那半句**必须写进 desc**：玩家算不出来，
  // 而且他会按旧规则以为沉底的牌发动不了这条线。
  //
  // ---- 跟【顺子匹配】剩下的那处区别，也必须写进 desc ----
  //
  //   **它收的是那一整段**（连中间夹着的一起），跟普通匹配同一个收法，
  //     而顺子匹配不收中间夹着的牌。
  //
  // ---- 剩下四条是玩家算不出来的，一条都不能省 ----
  //
  //   **自己的点数吃预算**（预算 = 21 − 它的点数）—— 那是这条线
  //     **唯一的决策**（打小牌收得多）。不写它，这条线看着像个自动红包；
  //   **多个点数按最小那个算**（`draftReach` 里 `own` 取 min）——
  //     那正是【软点】【归深】跟这条线咬合的全部内容
  //     （一张 K 配软点，预算从 8 跳到 20、成功率 17% → 88%）。
  //     ⚠ **两件 2026-10-26 都删了，这一句现在没有载体** ——
  //     规则本身没废（【磁钩】、合流追加过的牌照样是多点数），
  //     但「配一件追加小点数的技能把预算顶满」这条玩法**空出来了**。
  //     而那个 17% → 88% **从来没量过**（手算的），所以它也不是个
  //     可引用的数 —— 要再做这条组合得重新量，别拿它当依据；
  //   **至少 2 张才算凑成**（`DRAFT_MIN`）—— 不然它是「稳赚 2 分、零风险」；
  //   **0 点不占预算也不断链、无点数断链** —— 那是它的免费垫片和
  //     天然反制（顺色往堆顶丢一张就封掉它），两条都从实现直推。
  //
  // 「到它就停」比「跳过它」要紧：超预算是**停**不是跳过
  //（点数非负，后面只会更大），而断链那几种也是停。
  // 所以这一段永远是**连着的**，不写清玩家会去数「绕过去能拿更深的」。
  //
  // ⚠ `DRAFT_CAP` / `DRAFT_MIN` 两个常量仍在 `draw-skills.uts`
  //（吃水那条注释里），而**数字只写在这条 desc 里一处** ——
  // 照 desc 规则第五条（数写具体），改常量时要回来改这句
  { word: '21 匹配', desc: '**特殊匹配**，判在普通匹配之前。收走**包含你打出那张的一段连续牌**：从你这张落下的那一头起，把牌的点数一张一张累加，加到超过 21 就停；**你打的这张也占预算**（预算 = 21 − 它的点数，它有几个点数就按最小那个算）。够得着 2 张以上才算凑成。你这张落堆顶就从堆顶往下数，**落堆底就从堆底往上数**。0 点的牌不占预算、也不断链；**无点数**的牌和当不了匹配那一张的牌到它就停。' } as Term,
  // 顺子那条**必须**写进词表，而且必须写「10 和 Q 之间断开」——
  // 那一条玩家**算不出来**：J 打出就通吃走了、从不留在堆上，所以堆上
  // 永远没有 11 点。不告诉他，他就只会觉得 Q K 那头的伏流坏了
  { word: '顺子', desc: '点数连着的几张牌（比如 5 6 7），至少 3 张。堆上的牌不用挨在一起，点数连上就算。A 两头都能接（A-2-3 和 Q-K-A 都算，但同一条顺子里只能用一次）。注意 J 从不留在堆上（它打出就通吃），所以堆上没有 11 点 —— 10 和 Q 之间是断开的。被改成 0 点的牌算在 0 这一格（0 和 A 连得上）。' } as Term,
  // ---------- 【顺子匹配】：特殊匹配，判在普通匹配**之前** ----------
  //
  // 结算顺序（跟【燃烧】那一步同一个位置逻辑）：
  //
  //   落堆 → 场上效果 → **特殊匹配（这儿）** → 燃烧 → 普通匹配
  //
  // ---- 通则：**顺子必须含你刚打的那张** ----
  //
  // 试过「不要求参与」（把涉水那条特例升成通则），**撤回了** ——
  // 它造成**双收**：顺子收走别处那几张，而你打的那张还在堆上，
  // 于是普通匹配照常走、这一手收两次。
  //
  // 而「必须含它」把那件事挡死了，**而且是免费的**：
  // 顺子一定收走它（它是链的一员），牌不在堆上了，
  // 后面 resolveMatch 自然没得判。跟燃尽那道闸同一个原理 ——
  // **顺序给的,不是条款给的。**
  //
  // ---- 【涉水】那条「这张可以不参与」也**撤掉了**，同一个理由 ----
  //
  // 它原先是全表唯一一个双收的口子，而那违反「收一片的代价是这张不钓」。
  //
  // **代价是明的,旧数就摆在那儿**：`WADE_SELF` 那两档量过 ——
  //   必须参与 **+1.03** / 可以不参与 **+2.08**（旧口径）。
  // 所以涉水身上那 **+1 分就是双收**。撤掉它等于把那一分还回去，
  // 涉水会掉到档外很远，而且跟伏流只差「步长 2 vs 通配」一条 ——
  // 而通配那条量出来值钱得多（+2.56 vs 那一档）。
  //
  // > 那不是撤错了：**一个靠违反不变量撑起来的 +1 分不该留着**。
  // > 但它意味着涉水需要重新设计，而不只是重新定价。
  //
  // ---- 另两件玩家算不出来的 ----
  //
  //   **凑不成会退回普通匹配** —— 所以带这类技能的牌不是「只能靠顺子」。
  //     那是伏流定下来的实现（`FLOW_VOID=0`，注释写着「保留点数，
  //     凑不成顺子就退回普通点数匹配」），技能说明里读不出来。
  //   **只收组成顺子的那几张** —— 普通匹配收的是「那一张到堆顶」一整段，
  //     顺子匹配**不收中间夹着的牌**。两条收法差得很远，不说会算错。
  // ⚠ **这一条 2026-10-16 改正了，原文跟实现相反。**
  //
  // 原文写的是「**不要求你刚打的这张参与**，堆上本来就有就算」，还顺着
  // 描述了双收的后果（「不包含的话它还在堆上，普通匹配照常走」）——
  // 而那个版本**早就撤回了**（见上面那段「通则」）：实现钉死在
  // `self:'own'`，顺子必须含打出那张。那个情况在游戏里不可能发生。
  //
  // 这是「拿 desc 当真相」那类坑的源头之一 —— 我照着它设计过一轮技能。
  // 判据在 CLAUDE.md：**desc 跟实现不一致时那本身就是 bug，先修它。**
  //
  // ---- ⚠ 同一条词条里**又找到一处**，而且是反方向的〔2026-10-16〕----
  //
  // 原文末尾还有一句「**一条顺子里至少要有 2 张是真点数的牌**」，
  // 而那道闸在实现里**压根不存在** —— `bestChainAt` 只查 `count < STRAIGHT_MIN`，
  // 而 count 把通配填的格子也算进去。
  //
  // 它是怎么写进去的：下面【通配】那段注释说「那道闸已经有了
  //（`md-sim/rules.js` 的 `opt.pileMin`，原注释写着『防纯手牌凑』）」——
  // **那是两道不同的闸**：
  //
  //   `pileMin`      = 顺子里**堆上**的牌至少几张（防纯**手牌**凑，配 FLOW_HAND）
  //   「2 张真点数」 = 通配不能占满（防纯**通配**凑）
  //
  // 而同一段注释自己写着「那个『2』**是要量的数**」—— 也就是它当时是个
  // **待实现**的想法，被误当成已实现、写进了玩家看的文案。
  //
  // > **判据：上一处是「desc 说反了」，这一处是「desc 说了一条还没做的规则」。**
  // > 后者更难发现 —— 它读起来完全合理，而且旁边还有一句注释「证明」它实现了。
  // > 查法只有一个：**去读那个函数**，别读声称它实现了的注释。
  //
  // 删掉了（2026-10-16，用户定：这条限制不要）。所以自带通配之后
  // 伏流可以有两张通配（它自己 + 贴的那张），3 张顺子里只剩 1 张真点数 ——
  // **那是允许的**，而实测 X=3.85 正是在这个口径下跑的。
  //
  // ---- ⚠ 「自带【通配】」那半句 2026-10-19 **从这条词条里搬走了**（用户定）----
  //
  // 它回到了三件技能各自的 desc（伏流「它和另选 1 张牌带上【通配】」、
  // 涉水 / 漫流「它带上【通配】」），而且**升级成了真标签** ——
  // 【通配】在词表里是「挂在牌上、留着」的，所以凑不成的时候那张
  // 带着标签留在堆上，下一手谁凑顺子都用得上。
  //
  // 所以这条词条现在只讲**顺序和收法**，一个「谁带通配」的字都不提：
  // 带不带通配是各件技能自己的事（关键词不再规定它），
  // 而「必须是顺子里的一员」是通则、留着（不含它就双收，见上面那段）。
  //
  // > 这是同一条规则 **三天内第二次换位置**：2026-10-16 从涉水的 desc
  // > 搬进关键词，2026-10-19 又搬回三件各自的 desc。
  // > 两次都是用户定的，而**第二次顺带改了机制**（一次性 → 持久标签）。
  //
  // 〔同一次把「顺子里的一员」写成了「**【顺子】**里的一员」—— 这条词条
  //  原先一个带【】的词都不剩了，而手册的闭包只扫【】（见 termsFor 第三步）。
  //  此前【顺子】是靠「顺子匹配 → 【通配】 → 【顺子】」那条链拉进来的，
  //  而通配刚从这条词条里搬走 —— 不补这个括号，哪天有一件
  //  **不带通配**的顺子技能，手册就会静默少印【顺子】那一条。
  //  `termsFor` 的注释里本来就写着「顺子匹配→【顺子】」这条边，
  //  **这一补让那句注释变成真的**〕
  { word: '顺子匹配', desc: '**特殊匹配**，判在普通匹配之前。**你刚打的这张必须是【顺子】里的一员**。凑成就收走**组成顺子的那几张**，跟普通匹配不一样，中间夹着的牌不跟着走；你打的这张也跟着走，所以这一手没有普通匹配了。凑不成也只是退回普通匹配，不算白打。' } as Term,
  // ---------- 【花色匹配】：第三条特殊匹配线〔2026-10-25 用户定〕 ----------
  //
  // 跟【顺子匹配】同一类：**间隔匹配**，只收对上的那几张、夹在中间的不收 ——
  // 所以它天然不受「拦连续匹配」那一类效果影响（模拟器里的【中毒】原型就是靠这一点绕过去的）。
  // 〔「自带无点数」2026-10-25 从词条里去掉了（用户定）：「打出后全堆（**包括它自己**）变无点数」
  //   已经把它变成无点数了，再写一层是重复。**没有「退回普通匹配」** —— 它一打出整堆连它自己都没点数，
  //   普通匹配不可能成立（当天试过「退回普通匹配、结束时才冻」那一版，用户否了）。
  //   实现上照旧把带花色匹配的牌当无点数（valuesOf），跟词条效果等价，AI 也不会把它当能按点数钓的牌〕
  //
  // 载体：**收色**（2026-10-25 改用它，desc 就写【花色匹配】）。
  //   不进 SCAN_TERMS：载体的 desc 写的是带括号的，bracketWords 那一遍就能命中。
  //   〔原先这儿写着「有意不进扫描表 —— 顺色 desc 裸写着『改按花色匹配』、收法却是另一种」。
  //    顺色同一天改成了「点数变成堆上第一张同花色牌」，那条撞名没了〕
  { word: '花色匹配', desc: '**特殊匹配**，判在普通匹配之前。匹配堆上跟它**同花色**的牌 —— **至少 2 张**才算匹配成功 —— 把那几张连它自己一起收走。**夹在中间的牌不收**（间隔匹配）。**打出后堆上的牌（包括它自己）都变成【无点数】**，匹配成没成都一样。' } as Term,
  // ---------- 【通配】：顺子那一族的材料 ----------
  //
  // 四件事必须写进词条，缺一条玩家就读不懂：
  //
  //   **它不改点数** —— 所以贴了通配的牌**照旧钓得走**。那是这一族的
  //     对位解，跟【燃烧】同一条（标签不碰点数 → 它钓得走 → 有解）。
  //     不说的话玩家会以为通配是个保护。
  //   **它留着** —— 标签跟着那张牌，所以堆上的通配会**攒**。
  //     那是这一族第一次有「跨回合积累的场面」
  //     （燃烧靠这个冲到 +3.85，顺子族一直没有）。
  //
  //     〔2026-10-19：这一条现在**管到打出那张自己**了 ——
  //      三件顺子技能给它贴的就是这个标签（不再是「自带那一次」），
  //      所以凑不成的时候它留在堆上，下一手接着用。
  //      原先这儿写的「那是它跟自带那一次通配的根本区别」没有了：
  //      **游戏里只有一种通配，就是这个标签**〕
  //   **它能当 11** —— 于是它**填上了顺子那条里写的那个洞**
  //     （J 不留堆上 → 没有 11 点 → 10 和 Q 断开）。那是这一族
  //     结构性的天花板，而通配是唯一拆得掉它的东西。
  //
  // 〔这儿原先有一段说「『一条顺子里至少 2 张真点数』那道闸写在
  //  【顺子匹配】那条，而伏流那儿已经有同一道闸（`opt.pileMin`）」——
  //   **那段整个是错的，而且它把一条没实现的规则说成实现了**。
  //   `pileMin` 防的是纯手牌凑，不是纯通配凑。详见【顺子匹配】那条的注释。
  //   那条限制 2026-10-16 删了（用户定：不需要）〕
  { word: '通配', desc: '贴在牌上的标签。那张牌**凑【顺子】时可以当任意点数**（包括 11 —— 所以它能接上 10 和 Q 之间那个断口）。它**不改变那张牌的点数**，所以照旧有人按点数钓得走它；钓走了标签也跟着没。' } as Term,
  // ---------- 【推牌】：第 4 个标签，而且是**第一个可叠加**的 ----------
  //
  // 两句话玩家**算不出来**，一条都不能省：
  //
  //   **「可以叠加」** —— 前三个标签都不叠：【结冰】那条明写着「不能叠加」，
  //     【燃烧】贴到已着的牌上是空操作，【通配】叠了也还是通配。
  //     所以玩家的默认预期是「贴了就是贴了」，不说清他会按结冰去推。
  //     手牌上那个层数角标也要配合这一句才读得懂。
  //   **「每层 2 张」** —— 那是他唯一需要算的数（层数 × 2 = 这张会推几张）。
  //     而 2 这个数是**结构性**的，不是平衡旋钮（见 draw-skills 的 `SURGE_PUSH`：
  //     每层偶数 → 任何叠加都是偶数 → 不翻牌库奇偶）。
  //
  // 「牌库不够 2 张就不再翻」也要写 —— 它是**按层停**的，所以 3 层的牌
  // 在牌库剩 2 张时仍然推 1 层。不写玩家会以为是全有全无。
  //
  // **不写**的两样：
  //   「推完轮到谁出牌」那层道理 —— 那是设计判据（它决定这个动作的符号），
  //     不是规则，玩家自己会发现「对手踩了我的标签，然后我捡」；
  //   撞上匹配那一句的具体处理 —— 见下面那条待补。
  //
  // ⚠ **待补第三句**：撞上匹配怎么处理还在量（三档：那张置 0 / 洗回再翻 /
  //   不判匹配）。定下来之后这条 desc 要加一句，**而三档各对应一句不同的话**：
  //     置 0   → 「翻出来的牌跟堆上点数重复的，变成 0 点」
  //     洗回   → 「翻出来的牌跟堆上点数重复就洗回牌库、再翻一张」
  //     不判   → **不用加**
  //   量法和判读线见设计文档『机制：推牌』那一章的「阶段 0」
  // 〔2026-10-16 从「只是个标签」推广成「**动作 + 两种来路**」——
  //   【逆涌】（开河工的常驻技）直接发动它，不经过标签。
  //   不推广的话逆涌的说明引不到这个词，玩家得学两遍同一件事〕
  { word: '推牌 N 层', desc: '从牌库往堆上翻 **N×2 张**牌；翻出来的牌跟堆上点数重复的，变成 0 点。牌库不够 2 张就不再翻。有两种来路：**贴在牌上的标签**（可以叠加，带它的牌打出、这一手结算完之后按层数推牌），以及**常驻技直接发动**。' } as Term,
  // ---------- 【堆牌】2026-10-26 加（用户当天给的机制）----------
  //
  // 紧挨着【推牌】摆，因为它**就是延迟版的推牌**，而读的人一定会对着看。
  // 两条的分野只有一句：推牌**当场**翻到堆上（厚起来的堆先交给下一个
  // 出牌的人 —— 通常是对手），堆牌**隔一个回合**才落，而那个回合是
  // **自己的** —— 所以厚起来的堆先到自己手上。实测符号正好相反
  //（推牌 1 层 −2.36，堆牌 1 层 +2.21，R4 · X 口径）。
  //
  // ---- desc 里每一句的理由 ----
  //
  //   **「可以叠加」** —— 跟【推牌】同一条，而这是它跟【沉降】的分野，
  //     玩家算不出来必须写；
  //   **「这一手结算完之后」** —— 兑现点跟推牌一字不差（`endPlay`），
  //     排在匹配后面是故意的；
  //   **「盖在自己的堆牌区」+「双方都看不见」** —— 这是**信息规则**，
  //     不是美术细节：对手看不见你下回合要往堆上落什么，
  //     也就算不出那几张会不会撞点数置 0；
  //   **「轮到自己的回合开始时」** —— 落堆排在出牌阶段**之前**，
  //     所以你是看着落完的堆出牌的，那正是这件机制的决策内容；
  //   **「按【推牌】的规矩」** —— 落堆那一步跟推牌**共用同一段代码**
  //    （`surgePushOne`），所以置 0 那条不用在这儿重说第二遍，
  //     写成引用而不是复述（复述两份必然分叉）；
  //   **「牌库不够 2 张就不再取」** —— 跟推牌同一道奇偶闸。
  //     数字 2 的唯一出处是 `draw-skills.uts` 的 `HEAP_TAKE`，
  //     改那个常量要回来改这句（desc 规则第五条：数字只许有一处）
  { word: '堆牌 N 层', desc: '贴在牌上的标签，可以叠加。带它的牌打出、这一手结算完之后，按层数从牌库取 **N×2 张**盖在自己的**堆牌区**（双方都看不见）。轮到自己的回合**开始时**，区里的牌按【推牌】的规矩落到堆上，然后才是你的出牌阶段。牌库不够 2 张就不再取。' } as Term,
  // ---------- 【沉降】2026-10-19 加（载体：【退潮】）----------
  //
  // 它是**替【21 匹配】造料**的标签，而那条线的料就是 0 点牌：
  // 普通匹配钓不到 0 点（`anyEquals` 里「0 对 0 不算相等」），
  // 而 21 匹配「0 点不占预算、也不断链」—— **免费垫片**。
  // 所以压出来的那几张**只有带 21 匹配的一方吃得到**。
  //
  // ---- desc 里每一句的理由 ----
  //
  //   **「那张牌打出时」** —— 宿主不是效果牌本身，所以用「那张牌」
  //     而不是「它」（照【通配】那条词条的指代）。而它**在手里什么都不做**，
  //     离开手牌那一刻才兑现 —— 跟【推牌】同理；
  //   **「不能叠加」** —— 玩家算不出来，必须写。
  //     【推牌】写的是「可以叠加」，两条正好对照（而那是有意的分野：
  //     推牌的叠加换的是局长，这一件叠加会让「压几点」变成开奖）；
  //   **幅度 −3 写在这儿** —— 常量在 `draw-skills.uts` 的 `SINK_TAG_STEP`，
  //     而**数字只许有一处**（desc 规则第五条），所以改常量要回来改这句。
  //
  // ---- 没写的两样，都是故意的 ----
  //
  //   **「减到 0 为止」不写** —— 那是规则弹窗里的全局规则
  //    （「点数减不到负数，最小是 0」），照「不解释词表里的词」；
  //   **「压到 0 的牌怎么办」不写** —— 什么都不发生（没人收走它们），
  //     而 desc 不写不发生的事。它们留在堆上当障碍，那是玩家看得见的后果
  { word: '沉降', desc: '贴在牌上的标签，不能叠加。那张牌打出时，堆上所有牌的点数 −3。' } as Term,
  // ---------- 〔删了〕【大数】「点数 +10，不叠加，0 点不受影响」 ----------
  //
  // 2026-10-20 加，**同一天判废并从游戏去除**（用户定）。
  // 11 个载体扫完，只有 2 个进档，而那 2 个都靠「抽牌」凑分 ——
  // 机制本身 2.23，在目标档（2.7）外。全部数据在实测台账那一节。
  //
  // ---- 三条死因 ----
  //
  // **一、它只有代价和「免除代价」两种效果，没有正收益。**
  //   钥匙那一半（手牌贴 + 豁免）买的是「不被自己坑」，值 1.43；
  //   而障碍那一半（场上贴）**从来没赚过** —— 单独 −0.33、
  //   配上钥匙也只是 −0.06。对照藏凌的钥匙（穿过对手的冰**去收牌**）3.04。
  //
  // **二、它比【结冰】狠一个量级，而那是死锁。**
  //   结冰的词条写着「**而它照旧能当匹配的那一张**」—— 匹配成立、
  //   冰吸掉那一下就消失，**下次能收**（有解）。
  //   而大数让点数出界 → **压根匹配不到** → 收不走 → 标签不消失
  //   → 又匹配不到。**那张牌永久赖在堆上**（只有 J / 顺色 / 收色 /
  //   齐顶 / 磁钩挖得走），而那违反那条闸的精神：
  //  「它的闸从『不许插』换成『**对手破得掉**』—— 后者好得多」。
  //
  // **三、能用的形态只有一个，而它要两个条件同时成立** ——
  //   必须同时有钥匙（手牌贴）和料（场上有大数牌），缺一个就是空的或负的。
  //
  // ---- 它留下两样，都比这个标签本身值钱 ----
  //
  // **一、「钥匙比障碍值钱」最完整的一组实证**：同一个标签、同一个幅度，
  //   **只换「贴给谁」就从 −0.95 跨到 +9.02**。全表没有第二个这么干净的对照组。
  // **二、`pileValsAt` / `rawVals` 那个分层第一次被用上了** ——
  //   「在场期间改堆上点数」的效果必须在 pileValsAt 生效、不能写回 pileVals，
  //   而「不叠加」正是靠那个分层自动成立的（标签是状态，不是累加的数）。
  //   下一件这类效果照这条走，别再从 rawVals 那段注释重新推一遍。
  //
  // ⚠ 连带撤的两处：「点数」那一节里「0 点不受【大数】影响」那一行
  //（那是为它加的**新例外**，而 0 点牌的保护现在不需要它了），
  // 以及 SCAN_TERMS 里的 '大数'。模拟器那边的原型**留着**当证据
  // 〔例子换过：原先写「沉底、合流是这一类」，**两件都删了**
  //   （合流 10-14、沉底 10-15）。2026-10-20 结凌删了、全场贴冰并进了【结冰】规则，
  //   **现在没有带「优先」的技能**，例子先拿掉。词条留着：标签机制还在 ——
  //   查法是 `draw-skills.uts` 里的 `first: true`〕
  // ⚠ desc 原先写「在匹配**判定**之前结算」，2026-10-22 去掉「判定」两个字
  //（语义一个字没变，照【燃尽】那条词条的写法「它在匹配**之前**判」）。
  // 理由：那天【判定】成了关键词，而 SCAN_TERMS 按字面扫 ——
  // 留着的话玩家点开「优先」会顺带点亮一条毫不相干的【判定】词条
  { word: '优先', desc: '这个效果在匹配之前结算。同一张牌上有几个效果时，带「优先」的先走。' } as Term,
  { word: '覆盖面 / 盖 N 张', desc: '这套配装一共管多少张牌。花色槽一个管 12 张，点数槽一个点数管 4 张。它是双方唯一能横着比的强度数字。' } as Term,
  { word: '槽', desc: '角色卡上印死的格子，上面写着点数或花色。技能装进槽才生效，管哪些牌由槽决定。' } as Term,
  { word: '常驻特殊技', desc: '角色自带的那一件，整轮都在、不占槽、不用打特定牌触发。' } as Term,
  // ---- 「组合技」2026-10-15 改名成「双触发」，而且定义变了 ----
  //
  // 原定义是「两件技能**合成第三种效果**」，举的例子是「退潮 × 见底 = 干塘」。
  // **那个机制现在一个实例都没有了**：干塘是唯一一件，而退潮一删它就跟着死
  //（实现条件 `hasTrigger(SK_EBB) && hasTrigger(SK_LOWTIDE)`，SK_EBB 已是 −1）。
  //
  // 但**「一张牌同时触发两件技能」这件事是真实存在的**，而且玩家必须知道 ——
  // 角色卡的槽会交叠（镜湖占卜师 ♥ + '3 4' → ♥3 / ♥4 落在两个槽里），
  // 那张卡的 desc 就是靠这个卖的。
  //
  // 所以词条留着、改成描述真实机制。**两件技能各自结算，不合成新效果** ——
  // 那半句定义删掉是为了不让玩家去找一个不存在的东西。
  //
  // 〔「组合技」这个说法在设计文档里还是一整章 —— 那是**设计空间**的名字
  //   （「两件撞在一张牌上能不能合成第三种」），不是玩家要查的机制。
  //   哪天真做出第二件组合技，再把这个词加回来。〕
  { word: '双触发', desc: '一张牌同时落在两个槽的覆盖面里时，两件技能都会触发，各自结算。角色卡的槽会交叠 —— 比如镜湖占卜师的 ♥3，既在 ♥ 槽里又在「3 4」槽里。' } as Term
]

// ==========================================================
// ---------- 挑词条：实战手册要印哪几条（2026-10-14） ----------
// ==========================================================
//
// 实体对战时玩家手边没有规则弹窗，所以手册得自带词条。
// 问题是**不能无脑子串扫全部 22 条**，那会把规则面板整个抄一遍：
//
//   「堆」命中约 **40/48** 条技能说明（堆上/堆底/堆顶/整堆）；
//   「点数」约 30 条，而且它还是「无点数」「增减点数」的子串；
//   「匹配」「槽」几乎每条角色说明都含。
//
// 所以分三类：**基础词恒印**（它们每套配装都要用，而且扫也没区分度）、
// **可扫描词按命中印**、**旗标词**看 `first`。
//
// 实测效果：每套配装的专属词条 3~7 条 + 恒印的 9 条基础词。
// 全扫一遍的话每套都返回十五六条

// 恒印。这几个词要么在每条说明里都出现（扫了没意义），
// 要么压根不出现在正文里（「覆盖面」只在界面上），而两种都是读手册必须的
export const BASE_TERMS : string[] = [
  '点数', '匹配', '堆', '槽', '覆盖面 / 盖 N 张', '常驻特殊技',
  // 〔'组合技' → '双触发'（2026-10-15 改名，理由见那个词条的注释）。
  //   **这儿不跟着改就会静默少印一条** —— 这张表按词的字面匹配词条〕
  '增减点数', '变成 X', '双触发'
]

// 按命中印。**顺序必须长词优先** —— 命中「无点数」之后要把它从文本里抹掉，
// 否则「点数」会在同一处再命中一次（而它已经是基础词了，白点亮一条）
export const SCAN_TERMS : string[] = [
  // 〔'21 匹配' 2026-10-19 加 —— 吃水的 desc 里写的是带括号的【21 匹配】，
  //   所以靠 `bracketWords` 那一遍也能命中；加进这张表是为了**裸着写**
  //   那一天不出事（照 '推牌' / '双触发' 那两条的教训：漏了就静默少印一条）。
  //   放在最前面：它跟别的扫描词互不包含，而 '匹配' 是恒印的基础词、
  //   压根不在这张表里，所以不存在「短词抢先命中」的问题〕
  '21 匹配',
  '顺子匹配', '获取下一张', '无点数', '燃尽', '燃烧', '结冰',
  // 〔'判定' 2026-10-22 加、**同日撤** —— 载体（【传火】）那天就改掉了，
  //   零载体的扫描词等于让手册印一条玩家永远遇不到的规则。
  //   撤它的时候**连 `Term` 一起撤**（两处要同步，只撤一处就是半拉子）：
  //   漏撤词条 → 手册多印一条；漏撤扫描词 → 扫到的词条不存在。
  //   墓碑和判据在上面那条词条的位置〕
  // 〔'推牌' 2026-10-16 加 —— 漏了它的后果跟上面 '双触发' 那条一样：
  //   引潮的说明里写着【推牌】，而手册**静默少印一条**，
  //   于是玩家拿着实体牌打的时候查不到「每层推几张」〕
  // 〔'堆牌' 2026-10-26 加 —— **现在零载体**（机制进了游戏，可还没有
  //   任何技能贴这个标签），所以它暂时一次也不会命中。**现在就加对**
  //   是照 '双触发' / '推牌' / '沉降' 那三条的教训：漏加 = 静默少印一条，
  //   而那种 bug 要等到「有技能用它」的那天才暴露，到时候没人会想到查这张表。
  //
  //   ⚠ **位置这一条要算一下**：它跟 '推牌' 互不包含（差一个字），
  //   可它包含基础词 '堆' —— 而 '堆' 在 `BASE_TERMS` 里、压根不进这张表，
  //   所以「长词优先」那条规则对它无影响。摆在 '推牌' 旁边是为了好读〕
  '推牌', '堆牌', '通配', '顺子', '叠放', '保护', '在场', '置 0',
  // 〔'收纳' / '驻场' / '对称' 2026-10-19 加 —— **现在三个词都零引用**
  //  （【收纳】的载体技能还没定，【驻场】那三件的 desc 暂不改），
  //   所以这三条暂时一次也不会命中。**现在就加对**是照上面那两条的教训
  //  （'双触发' 和 '推牌' 都是漏加之后才发现的）：漏加 = 静默少印一条，
  //   而那种 bug 要等到「有技能用它」的那天才暴露，到时候没人会想到查这张表。
  //
  //   三个词跟现有扫描词**互不包含**（'驻场' ≠ '在场'，差一个字），
  //   所以「长词优先」那条规则对它们无影响，位置不敏感〕
  '收纳', '驻场', '对称',
  // 〔'沉降' 2026-10-19 加 —— **这一条有真载体**（【退潮】的 desc 里
  //   写着【沉降】），所以漏加会让实战手册**静默少印一条**，
  //   而玩家拿实体牌打的时候就查不到「压几点」。
  //   那正是 '双触发' 和 '推牌' 栽过的那个坑，两次都是漏加之后才发现的。
  //   跟现有扫描词互不包含（'沉降' ≠ '沉底'，而且沉底那件技能早删了），
  //   所以「长词优先」那条规则对它无影响、位置不敏感〕
  '沉降'
  // 〔这儿原先有 '大数'（2026-10-20 加），而那个标签**当天判废、
  //   从游戏去除了**，所以扫描词跟着撤 —— 词条没了还留扫描词的话，
  //   `termsFor` 会去找一条不存在的 TERMS 项。
  //
  //   ⚠ 撤的顺序是硬的：**先撤扫描词、再删词条**（反过来的话中间那一刻
  //   手册会查一个空词条）。这一轮两样是同一次改的，所以没露出来〕
]

// 词表里有三条 word 带后缀或占位符（'获取下一张 X'、'变成 X'、
// '覆盖面 / 盖 N 张'），而技能说明里写的是不带后缀那部分（【获取下一张】）。
//
// 用一张小映射对上，**而不是给 Term 加一个 match 字段** ——
// 加必填字段要改全部 24 条字面量，其中 21 条填的都是空串。
//〔那个数两次没跟着涨：'推牌 N 层'（10-16）和 '21 匹配'（10-19）。
//  它只是这段论证的分母，不影响行为 —— 但过期的数字读起来像现行的〕
// 按空格切也不行：'置 0' 会被切成 '置'
export function termMatchKey(word : string) : string {
  if (word == '获取下一张 X') {
    return '获取下一张'
  }
  if (word == '变成 X') {
    return '变成'
  }
  if (word == '覆盖面 / 盖 N 张') {
    return '覆盖面'
  }
  // 〔'推牌 N 层' 2026-10-16 加 —— 词条名带了「N 层」那个占位符，
  //   而技能说明里写的是【推牌】。**不加这一条就是静默少印一条**：
  //   `termIndexOf` 比的是 `termMatchKey(TERMS[i].word)`，
  //   而 `SCAN_TERMS` 里存的是 '推牌' —— 对不上就查不到这个词条〕
  if (word == '推牌 N 层') {
    return '推牌'
  }
  // 〔'堆牌 N 层' 2026-10-26 加 —— 同一条理由，同一个占位符形状。
  //   漏了的话 `SCAN_TERMS` 里那个 '堆牌' 对不上任何词条〕
  if (word == '堆牌 N 层') {
    return '堆牌'
  }
  return word
}

// 'A【燃烧】B【结冰】' → ['燃烧', '结冰']
//
// 用 split 而不是游标循环 —— 这个项目里**没有 indexOf(needle, from)**
// 这种两参用法，也不要正则（String.replace 全项目零出现）
export function bracketWords(text : string) : string[] {
  const out : string[] = []
  const parts = text.split('【')
  for (let i = 1; i < parts.length; i++) {
    const end = parts[i].indexOf('】')
    if (end > 0) {
      out.push(parts[i].substring(0, end))
    }
  }
  return out
}

// 一个词对应 TERMS 的第几条，查不到 -1。
//
// **查不到是正常的**：'获取下一张 X' 的说明里含【野火】，那是技能名不是术语，
// 调用方静默丢掉就行
export function termIndexOf(word : string) : number {
  for (let i = 0; i < TERMS.length; i++) {
    if (termMatchKey(TERMS[i].word) == word) {
      return i
    }
  }
  return -1
}

// 给几段文字（角色的常驻特殊技说明 + 已配技能的说明），算出手册要印哪几条词条。
// `anyFirst` = 这套里有没有带「优先」的技能（那个词从不出现在正文里，
// 它是 `DrawSkill.first` 渲染出来的）。
//
// 按 TERMS **原序**返回 —— 那个顺序是规则面板里排好的，有依赖关系
//（先「点数」再「匹配」再「堆」）
export function termsFor(texts : string[], anyFirst : boolean) : Term[] {
  const on : boolean[] = []
  for (let i = 0; i < TERMS.length; i++) {
    on.push(false)
  }
  for (let i = 0; i < BASE_TERMS.length; i++) {
    const at = termIndexOf(termMatchKey(BASE_TERMS[i]))
    if (at >= 0) {
      on[at] = true
    }
  }
  for (let t = 0; t < texts.length; t++) {
    // 一、带【】的
    const words = bracketWords(texts[t])
    for (let w = 0; w < words.length; w++) {
      const at = termIndexOf(words[w])
      if (at >= 0) {
        on[at] = true
      }
    }
    // 二、裸着写的。**37/48 条技能说明根本不带括号**，所以这一遍是主力。
    // 长词优先 + 命中就抹掉那一段（掩码），不然短词会在同一处重复命中
    let rest = texts[t]
    for (let s = 0; s < SCAN_TERMS.length; s++) {
      const key = SCAN_TERMS[s]
      if (rest.indexOf(key) >= 0) {
        const at = termIndexOf(key)
        if (at >= 0) {
          on[at] = true
        }
        rest = rest.split(key).join('')
      }
    }
  }
  if (anyFirst) {
    const at = termIndexOf('优先')
    if (at >= 0) {
      on[at] = true
    }
  }
  // 三、**闭包**：词条之间互相引用（燃烧→【结冰】、燃尽→【燃烧】【保护】、
  // 顺子匹配→【顺子】、通配→【顺子】），把前置的那几条也拉进来。
  // 跑到不再变为止，最多三轮（链最长就是 燃尽→燃烧→结冰）
  for (let round = 0; round < 3; round++) {
    let added = false
    for (let i = 0; i < TERMS.length; i++) {
      if (!on[i]) {
        continue
      }
      const words = bracketWords(TERMS[i].desc)
      for (let w = 0; w < words.length; w++) {
        const at = termIndexOf(words[w])
        if (at >= 0 && !on[at]) {
          on[at] = true
          added = true
        }
      }
    }
    if (!added) {
      break
    }
  }
  const out : Term[] = []
  for (let i = 0; i < TERMS.length; i++) {
    if (on[i]) {
      out.push(TERMS[i])
    }
  }
  return out
}
