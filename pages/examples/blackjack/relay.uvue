<template>
  <view class="page">
    <!-- 顶部：轮次和比分 -->
    <!-- 庄家在左、你在右，轮次夹在当中。
         收走的牌就是朝这两头飞的，位置得先定死 -->
    <view class="topbar">
      <view class="topbar-item">
        <text class="topbar-label">庄家</text>
        <text
          id="rl-dealer-points"
          class="topbar-value topbar-value-dealer"
          :class="{ 'topbar-value-pop': popBy == 1 && popIn }"
          >{{ dealerPoints.length }}</text
        >
        <text v-if="popBy == 1" class="gain" :class="{ 'gain-up': popIn }">+{{ popGain }}</text>
      </view>
      <view class="topbar-item">
        <text class="topbar-label">轮次</text>
        <text id="rl-round" class="topbar-value">{{ round }}/{{ totalRounds }}</text>
      </view>
      <view class="topbar-item">
        <text class="topbar-label">你</text>
        <text
          id="rl-player-points"
          class="topbar-value topbar-value-mine"
          :class="{ 'topbar-value-pop': popBy == 0 && popIn }"
          >{{ playerPoints.length }}</text
        >
        <text v-if="popBy == 0" class="gain" :class="{ 'gain-up': popIn }">+{{ popGain }}</text>
      </view>
    </view>

    <!-- 庄家手牌：一律背面，只把它下一张要打的那张亮出来。
         张数看得见、牌面看不见 —— 数量是留给你算的，内容不是。
         摆在牌堆上头：庄家在上、牌堆居中、你的排竿区在下，跟牌桌一个方向 -->
    <view class="dealer-area">
      <view class="dealer-head">
        <!-- 把「对半分」写在标题上。这条机制从来没在界面上出现过，
             可它是整个推断的地基：你有的牌它就没有 -->
        <text class="dealer-title">庄家 · 同一副牌的另一半</text>
        <text class="dealer-tip">{{ dealerTip }}</text>
      </view>
      <!-- 它挂着的规矩。摆出来是有意的 —— 难度该看得见，
           藏着的话「我怎么突然钩不上了」就成了坑人 -->
      <view v-if="ruleTags.length > 0" class="rule-row">
        <text
          v-for="(one, ri) in ruleTags"
          :key="'rr-' + ri"
          :id="'rl-rule-' + ri"
          class="rule-tag"
          @click="showRule(ri)"
          >{{ one }}</text
        >
      </view>
      <view class="dealer-row">
        <text v-if="dealerLeft == 0" class="dim-tip">它这一轮打完了</text>
        <view
          v-for="(card, di) in dealerHand"
          :key="'dh-' + di"
          :id="'rl-dealer-' + di"
          class="card card-dealer"
          :class="{
            'card-next': di == 0 && foeOpen(di, card),
            'card-aim': isFoeAimed(di)
          }"
          @click="pickFoe(di)">
          <!-- 明竿看得见的那几张、加上窥筒照亮的那几张，翻开；其余背面。
               描金边只给最靠前那一张 —— 那是马上要打的。
               整排都点得中：窥筒和停口挑的就是它这几张，
               背面也点得中（按「它第几张打」来挑，不是按牌面挑） -->
          <text
            v-if="foeOpen(di, card)"
            class="card-rank card-rank-small"
            :class="{ 'card-red': isRed(card) }">
            {{ rankText(card) }}
          </text>
          <text v-if="foeOpen(di, card)" class="card-suit" :class="{ 'card-red': isRed(card) }">
            {{ card.suit }}
          </text>
          <!-- 被停口废过的挂个小标。背面牌看不见点数，
               不标一下你就记不住刚才废的是哪几张 -->
          <text v-if="foeMark(di) != ''" class="card-sticker">{{ foeMark(di) }}</text>
          <text
            v-else-if="foeOpen(di, card) && card.stickerKey != S_NONE"
            class="card-sticker">{{ stickerName(card) }}</text>
          <view v-if="!foeOpen(di, card)" class="card-back-art dealer-art">
            <view class="card-back-gem dealer-gem"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 公共牌堆 -->
    <view class="pile-area">
      <view class="pile-head">
        <text class="pile-title">牌堆 {{ pile.length }} 张</text>
        <text class="pile-tip">{{ stepText }}</text>
      </view>
      <scroll-view class="board">
        <view class="board-row">
          <text v-if="pile.length == 0" class="dim-tip">空堆</text>
          <view
            v-for="(card, index) in pile"
            :key="'pl-' + index"
            :id="'rl-pile-' + index"
            class="card card-in-pile"
            :style="pileStyleOf(index)"
            :class="{
              'card-stickered': card.stickerKey != S_NONE,
              'card-from-dealer': pileFromDealer[index],
              'card-from-player': !pileFromDealer[index],
              'card-caught': index < catchMarks.length && catchMarks[index]
            }"
            @click="showPileCard(card, index)">
            <text class="card-rank" :class="{ 'card-red': isRed(card) }">{{ rankText(card) }}</text>
            <text class="card-suit" :class="{ 'card-red': isRed(card) }">{{ card.suit }}</text>
            <text v-if="card.stickerKey != S_NONE" class="card-sticker">{{
              stickerName(card)
            }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 说明框。平时播战况，点了道具就改播那件道具的效果，
         右边跟着冒出一颗按钮 —— 不再另弹窗 -->
    <view class="message-box">
      <text id="rl-message" class="message-text">{{ message }}</text>
      <text v-if="useText != ''" id="rl-use" class="msg-btn" @click="tapUse">{{ useText }}</text>
    </view>

    <!-- 道具栏：道具栏上装着的那几件都摆在这儿。
         永续的只是列着（它一直在生效，没什么可点的），
         限制的点一下进选择态，再点队列里的牌下手 -->
    <view class="gift-row">
      <text class="gift-label">道具</text>
      <view
        v-for="(one, gi) in bar"
        :key="'g-' + gi"
        :id="'rl-item-' + gi"
        class="gift"
        :class="{ 'gift-on': gi == barAt, 'gift-dim': one.left <= 0 && one.limited }"
        @click="tapItem(gi)">
        <text class="gift-name" :style="'color: ' + tierColor(one.tier)">{{ one.name }}</text>
        <!-- 限制类把「还剩几次」挂在名字后头，永续的不挂 -->
        <text v-if="one.limited" class="gift-left">{{ one.left }}</text>
      </view>
      <text v-if="bar.length == 0" class="gift-none">这一关没带道具</text>
    </view>

    <!-- 排竿区：本轮要打的五张，排好顺序再开始 -->
    <view class="queue-area">
      <view class="queue-head">
        <text class="queue-title">{{ queueTitle }}</text>
        <text class="queue-tip">{{ queueTip }}</text>
      </view>

      <view class="queue-row">
        <view
          v-for="(card, index) in playerQueue"
          :key="'q-' + index"
          :id="'rl-queue-' + index"
          class="slot"
          @touchstart="dragStart(index, $event)"
          @touchmove="dragMove"
          @touchend="dragEnd"
          @touchcancel="dragCancel">
          <!-- 排在打牌张数之外的是备选：这一轮不打，留到下一轮。
               序号那儿标「留」，免得以为自己排了六张就会打六张 -->
          <text class="slot-order" :class="{ 'slot-order-spare': index >= playCap }">{{
            index >= playCap ? '留' : index + 1
          }}</text>
          <view
            class="card card-queue"
            :style="slotStyleOf(index)"
            :class="{
              'card-stickered': !queueHidden[index] && card.stickerKey != S_NONE,
              'card-back': queueHidden[index],
              'card-sink': phase == 'plan' && sinkPicked[index],
              'card-aim': phase == 'plan' && isAimed(index),
              'card-dragging': index == dragAt && dragging,
              'card-settling': settling,
              'card-spare': index >= playCap,
              'card-done': phase == 'play' && index < playerStep,
              'card-now': phase == 'play' && index == playerStep
            }">
            <!-- 压牌补上来的是背面：看不到是什么，但照样能排进队列 -->
            <view v-if="queueHidden[index]" class="card-back-art">
              <view class="card-back-gem"></view>
            </view>
            <text v-if="!queueHidden[index]" class="card-rank" :class="{ 'card-red': isRed(card) }">
              {{ rankText(card) }}
            </text>
            <text v-if="!queueHidden[index]" class="card-suit" :class="{ 'card-red': isRed(card) }">
              {{ card.suit }}
            </text>
            <text v-if="!queueHidden[index] && card.stickerKey != S_NONE" class="card-sticker">{{
              stickerName(card)
            }}</text>
          </view>
        </view>

        <!-- 牌库就摞在这一排的右头。队列那五张是从这儿翻出来的，
             压底的也是压回这儿去 —— 两个动画都往这个方向飞 -->
        <view id="rl-deck" class="deck">
          <view class="deck-stack">
            <view class="deck-card deck-card-back2"></view>
            <view class="deck-card deck-card-back1"></view>
            <view class="deck-card deck-card-top">
              <view class="card-back-art deck-art">
                <view class="card-back-gem"></view>
              </view>
            </view>
          </view>
          <text class="deck-count">{{ deckLeft }}</text>
        </view>
      </view>
    </view>

    <view class="actions">
      <!-- 选中的几张一起压 —— 一张张压的话，前一张补上来的盲牌
           会把后面的位置挤乱，选完一次性处理才对得上 -->
      <view
        v-if="phase == 'plan'"
        id="rl-sink"
        class="act-btn act-btn-warn"
        @click="sinkPickedCards">
        <text class="act-text act-text-warn">{{ sinkText }}</text>
      </view>
      <view v-if="phase == 'plan'" id="rl-start" class="act-btn act-btn-primary" @click="startPlay">
        <text class="act-text act-text-dark">开始出牌</text>
      </view>
      <!-- 演的时候这一格换成倍速开关：没什么好等的就别等 -->
      <view
        v-if="phase == 'play'"
        id="rl-speed"
        class="act-btn"
        :class="{ 'act-btn-on': speedFast }"
        @click="toggleSpeed">
        <text class="act-text">{{ speedFast ? '二倍速' : '原速' }}</text>
      </view>
      <!-- 认输：分差拉开之后剩下几轮是走过场，不该按着人看完 -->
      <view v-if="phase != 'over'" id="rl-quit" class="act-btn act-btn-warn" @click="askConcede">
        <text class="act-text act-text-warn">认输</text>
      </view>
      <!-- 打到一半退出去不算输，这一关下次从头打 -->
      <view v-if="phase != 'over'" id="rl-back" class="act-btn" @click="goBack">
        <text class="act-text">退出</text>
      </view>
    </view>

    <!-- 收牌的飞行层。挂在页面根上，不在牌堆那个 scroll-view 里面 ——
         滚动容器会裁剪，牌刚飞到边上就被切掉了 -->
    <view v-if="flyCards.length > 0" class="fly-layer">
      <view
        v-for="(one, fi) in flyCards"
        :key="'fly-' + fi"
        class="fly-card"
        :style="flyStyleOf(fi)">
        <text class="card-rank" :class="{ 'card-red': isRed(one.card) }">{{
          rankText(one.card)
        }}</text>
        <text class="card-suit" :class="{ 'card-red': isRed(one.card) }">{{ one.card.suit }}</text>
      </view>
    </view>

    <!-- 结算。按钮放在面板里 —— 这一层盖满整屏，
         底下那排按钮这会儿是点不着的 -->
    <view v-if="phase == 'over'" class="over-layer">
      <view class="over-panel">
        <text id="rl-result" class="over-title">{{ resultText }}</text>
        <text class="over-line"
          >你 {{ playerPoints.length }} 张 · 庄家 {{ dealerPoints.length }} 张</text
        >
        <text v-if="gotText != ''" id="rl-got" class="over-got">{{ gotText }}</text>
        <text class="over-hint">{{ overHint }}</text>
        <view class="over-acts">
          <view id="rl-next" class="act-btn act-btn-primary" @click="leaveGame">
            <text class="act-text act-text-dark">{{ leaveText }}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  // 排竿：另一种出牌方式。
  //
  // 不再每回合盯着牌堆挑一张打，而是提前把牌库顶的五张排成一串，
  // 排完撒手 —— 双方交替按各自排好的顺序自动打完这一轮十张。
  //
  // 于是决策从「当下哪张收得多」挪到了「这五张按什么顺序走」。排的时候
  // 你不知道对手会把堆变成什么样，所以每一次排序都是下注。
  //
  // 核心在于：队列里相邻的两张之间，必然夹着对手的一张牌（双方交替出）。
  // 把两张点数对得上的牌排在相邻位，后一张就会钩中前一张，
  // 把夹在当中的那张对手的牌一并收走。整个模式的算计都是围着这件事转的 ——
  // 手上凑不出这样的一对，就压牌换，赌补上来的盲牌能配上。
  //
  // 堆就是出牌顺序，不重排 —— 「夹了谁」全靠这个顺序。
  // 想换成「按点数排成梯子、钩深的收得多」那套打法的，
  // 去商店买【拢堆】：那是一件改地基的道具，不是默认规则。
  //
  // 贴纸这一版只认「点数类」和「空位类」：它们在 cards.uts 里就算完了，
  // 落堆算几点、算不算钓点跟主玩法完全一致。要你当场挑牌的那些不发动 ——
  // 一轮十张连着自动演完，中间根本没有让人插手的地方
  import {
    Card,
    RANKS,
    RANK_VALUES,
    buildDeck,
    cloneCard,
    emptyStickers,
    isRedSuit,
    faceOf,
    playOptions,
    valuesOf,
    pileIndexExcept,
    pileSuitOf,
    shareValue,
    NO_VALUE
  } from '@/pages/examples/blackjack/cards.uts'
  // 庄家那半副牌还在用贴纸（它要的只是改点数），所以这几样还得留着
  import {
    S_NONE,
    S_HAUL,
    S_LUCKY,
    stickerAt,
    isFixedRank,
    isBlankSticker
  } from '@/pages/examples/blackjack/stickers.uts'
  import {
    SaveData,
    emptySave,
    loadCurrentSave,
    saveCurrent,
    cloneSave,
    currentRelayLevel,
    runCarry,
    rollRulesFor,
    dealRunDeck,
    itemTierOf,
    usesLeft,
    spendUse,
    resetUses,
    resetRun
  } from '@/pages/examples/blackjack/save.uts'
  import {
    RelayLevel,
    RELAY_COUNT,
    DEAL_PLAIN,
    DEAL_TUNED,
    baseCoins,
    gapCoins,
    relayLevelAt
  } from '@/pages/examples/blackjack/relay-levels.uts'
  import {
    KIND_LIMITED,
    itemAt,
    valueAt,
    countAt,
    descOf as itemDescAt,
    tierName,
    tierColor,
    coinBonusOf,
    dealerRuleAt,
    ruleKeyOf,
    ruleArgOf
  } from '@/pages/examples/blackjack/relay-items.uts'

  // 飞在半空的一张替身：牌本身，加上它从哪儿起飞
  type FlyOne = {
    card : Card
    x : number
    y : number
  }

  // 一轮五张。打几轮按关卡给 —— 轮数越多越吃记牌：
  // 压下去的牌可能又翻上来，牌库还剩什么得自己心里有数
  const QUEUE_SIZE : number = 5
  // 一副牌洗开对半分，一人这么多张。打完这些就算一局 ——
  // 五轮整，外加最后一张单挑。
  // 局长因此是固定的，不再由关卡的 rounds 说了算
  const HALF_DECK : number = 26
  // 「大数」的门槛：点数大于这个数就算大牌（J、Q、K）。
  // 挡口（大数穿透）和归标（大数多一个 11）都认它。
  //
  // 巨口说的大数是同一个意思，只是那件的门槛随进阶往下走（10/9/8/7），
  // 所以它读自己的 steps，不读这个常量 —— 两边不耦合。
  //
  // 摆在最上头是因为 valuesOf2 用得到，而它在文件里靠前 ——
  // uts 编译到 Kotlin 之后，顶层常量的先后顺序比 JS 那边计较
  const BIG_VALUE : number = 10
  // 自动演的节奏。
  //
  // 钩中那一下要分三拍走完，一拍都不能省：先把要收的那一段亮起来
  // （CATCH_HOLD），再真的收走、比分跳一下（POP_HOLD），然后才轮下一张。
  // 原先亮起和收走挤在同一帧里，等于没亮 —— 牌唰一下就没了，
  // 只剩比分默默变了个数
  // 没钩上的那一步只是「牌落堆」，没有信息量 —— 快速过。
  // 钩上了才是要看的，那条长链照常走
  const STEP_DELAY : number = 260
  const CATCH_HOLD : number = 480
  // 收走的牌缩着飞向比分要这么久，跟内联的 transition-duration 对齐
  const FLY_TIME : number = 560
  const POP_HOLD : number = 520

  // 二倍速：所有等待折半。一局十关、每关几十张牌连着演，
  // 看第二遍的人不该被按着看完
  const speedFast = ref<boolean>(false)
  const KEY_SPEED : string = 'bj-relay-fast'

  function paceOf(ms : number) : number {
    if (!speedFast.value) {
      return ms
    }
    const half = Math.floor(ms / 2)
    return half < 40 ? 40 : half
  }

  function toggleSpeed() {
    speedFast.value = !speedFast.value
    uni.setStorageSync(KEY_SPEED, speedFast.value ? '1' : '0')
  }

  const save = ref<SaveData>(emptySave())
  const level = ref<RelayLevel>(relayLevelAt(1))
  const round = ref<number>(1)
  // plan：正在排这一轮的五张；play：排定了，自动演；over：打满了
  const phase = ref<string>('plan')
  const message = ref<string>('')

  const playerDeck = ref<Card[]>([] as Card[])
  const dealerDeck = ref<Card[]>([] as Card[])
  // 你的牌库翻到第几张了。右边那一摞要靠它算还剩多少，
  // 所以是 ref 不是普通变量 —— 普通变量变了视图不会跟着动
  const playerCursor = ref<number>(0)
  let dealerCursor = 0

  const playerQueue = ref<Card[]>([] as Card[])
  const dealerQueue = ref<Card[]>([] as Card[])
  // 队列里哪几张是压牌补上来的盲牌。位置换了这个标记也得跟着换
  const queueHidden = ref<boolean[]>([] as boolean[])

  const pile = ref<Card[]>([] as Card[])
  const pileFromDealer = ref<boolean[]>([] as boolean[])
  const playerPoints = ref<Card[]>([] as Card[])
  const dealerPoints = ref<Card[]>([] as Card[])
  // 正在被收走的那一段，亮一下再拿走
  const catchMarks = ref<boolean[]>([] as boolean[])
  // 亮着的这一段等会儿归谁、从第几张起、一共几张。
  // 判撞的时候就算好了，等亮够了再真的收走
  let pendingBy = false
  // 要收走哪几张。按标记表存而不是「从第几张起」——
  // 收色挑的是散落在堆里的同花色，位置不连续
  let pendingMarks : boolean[] = [] as boolean[]
  let pendingCount = 0
  // 比分跳动：popBy 是这回收牌的是谁（0 你、1 庄家，-1 表示没在跳），
  // popIn 一翻，数字放大、上面的「+N」往上飘走
  const popBy = ref<number>(-1)
  const popGain = ref<number>(0)
  const popIn = ref<boolean>(false)
  let popTimer = -1
  // 赢了之后得到的那几张贴纸，结算面板上摊开说
  const gotText = ref<string>('')
  // 亮完之后翻开它，被钩中的那一段就缩着朝比分飞过去
  const flyOn = ref<boolean>(false)
  // 飞在半空的那几张替身，连同各自的起点
  const flyCards = ref<FlyOne[]>([] as FlyOne[])
  // 替身摆好了没有。摆好了才放开让它们飞
  const flyGo = ref<boolean>(false)
  // 比分那一行的纵向中心，飞行的终点高度
  const FLY_TARGET_Y : number = 30
  // 屏幕多宽。算牌飞去哪儿要用
  let screenW : number = 375

  // 点中了准备压掉的那几张。标记跟着牌走，拖动换位它也跟着换
  const sinkPicked = ref<boolean[]>([] as boolean[])

  // ---------- 道具栏 ----------
  //
  // 这一关带上场的那几件，开局从道具栏读一次就定了。
  // 永续的只是列着（它一直在生效），限制的点一下进选择态，
  // 再点队列里的牌下手。
  //
  // left 是「这一关还能用几次」，读的是存档里的 runUsed ——
  // 中途退出重进不该把次数刷回满的
  type BarItem = {
    key : string
    name : string
    tier : number
    limited : boolean
    left : number
    // 这一下还要再点几张牌。选择态下每点一张减一，减到 0 就结算
    need : number
  }
  const bar = ref<BarItem[]>([] as BarItem[])
  // 选中了道具栏第几件，-1 表示没选。
  // 选着道具的时候点牌是「对这张下手」，没选的时候点牌才是「选中待压」
  const barAt = ref<number>(-1)
  // 这一下还差几张没点。多张的道具（升过级的坠子能点两三张）靠它数
  // 选中的这件道具最多能点几张牌。0 表示它不挑目标
  const needMax = ref<number>(0)
  // 已经点中的那几张，凑够 need 才一起结算 ——
  // 一张一张立刻生效的话，点错了没法反悔
  const picked = ref<number[]>([] as number[])
  // 点中的**庄家**手牌是第几张（下标对着 dealerHand，也就是从
  // dealerStep 往后数）。窥筒和停口挑的是它那排，不是你自己那排，
  // 所以另开一份 —— 混用一份的话「这个 2 指的是谁的第 2 张」说不清
  const foePicked = ref<number[]>([] as number[])
  // 窥筒照亮的那几张：整轮明示，不是看一眼就没。
  // 名单按轮清（在 clearTweaks 里），下一轮它换一手牌，照亮的自然作废。
  //
  // 叫 lit 不叫 seen 是为了避开 sortDealer 里那个同名局部量 ——
  // 那儿的 seen 指的是「浑水没遮住、庄家自己看得见的那几张」，
  // 两个东西撞名字，读代码的人迟早要栽一跤
  let lit : Card[] = [] as Card[]
  // 停口把庄家那几张废掉了：变 0 点的进 zeroCards，
  // 失去点数的进 noValue（跟收色那几件共用一份名单）
  let zeroCards : Card[] = [] as Card[]
  // 长竿多摆出来、这一轮没轮到打的那几张。留到下一轮排在队列最前面 ——
  // 不留着的话「多摆一张」就成了「每轮白扔一张」
  let keepCards : Card[] = [] as Card[]
  let keepHidden : boolean[] = [] as boolean[]
  // 这一关被道具改过的牌。一轮打完要把改动抹掉 ——
  // 「这一轮 +2」就该只管这一轮，牌压回牌库底下次翻上来不该还带着。
  // 声明摆在用它的函数前头：uts 编译到 Kotlin 之后，
  // 顶层变量的先后顺序比 JS 那边计较
  let tweaked : Card[] = [] as Card[]
  // 收色：这几张这一轮按花色钩，不按点数钩。
  // 拿一张名单记着，而不是在 Card 上借个字段 ——
  // Card 那几个字段各有各的主人，借了迟早跟别人打架
  let suitHook : Card[] = [] as Card[]
  // 吞口：这几张这一轮按大小吞，从紧挨着的那张往回一路吞比它小的
  let bigHook : Card[] = [] as Card[]
  // 这一轮被你**主动**废掉点数的那几张。收色、缠线、染水共用这一张名单。
  //
  // 抽出来是因为这三件的共同点就是「拿整个点数换一件别的事」——
  // 换一次按花色的散收、换掉邻座那张、换一池子同花色。
  // 各记各的名单的话，valuesOf2 和 playOne 那两处判断就得列三个函数，
  // 以后再添一件又得回来改两个地方
  let noValue : Card[] = [] as Card[]
  // 缠线：这几张打出时，把紧挨着它左边那张也废成没点数
  let tangle : Card[] = [] as Card[]
  // 染水：这几张打出时，把堆上所有牌染成它的花色
  let dye : Card[] = [] as Card[]
  // 挡口：这几张站在堆里当岗哨 —— 庄家钩它左边那张、而那张点数
  // 又没它大的时候，这一钩只收到它右边为止。
  //
  // **这张名单跟着堆走，不跟着轮清**（清的地方在开局那儿，挨着 pile）。
  // 别的效果都是「这一轮打出去的时候怎么算」，用完就过期；
  // 挡口不是 —— 它是一张躺在堆里的牌的常驻属性，
  // 护的又是埋在堆底、要跨好几轮才收的桩。按轮清等于站一轮岗就撤
  let guards : Card[] = [] as Card[]
  // 落潮：这几张打出时，把左边那几张压成 0 点（没点数的也算）。
  // 注意它**不进 noValue** —— 落潮压的是别人，自己那张点数照旧，
  // 压完还得靠它一口吞回来
  let ebb : Card[] = [] as Card[]
  // 埋饵：这几张打出时沉到堆底，而且那一下不钩
  let buried : Card[] = [] as Card[]
  // 这一轮打出去的那些。重排只动它们 ——
  // 上几轮留在堆里没被收走的沉在底下不参与，那是跨轮的记忆，
  // 排掉就等于每轮开局都把堆抹平了
  let roundCards : Card[] = [] as Card[]
  // 这一轮你已经打出去几张。封位那条规矩掐的是每轮你的第一张
  let playedMine : number = 0
  // 拢堆这一轮开着没有。开着的话没钩上就重排本轮的牌
  const tidyRound = ref<boolean>(false)
  // 探口这一轮探到的那几条。存着是因为线索是你排这一轮的依据 ——
  // 弹一次就没了的话，忘了就再也看不到，等于白用
  const hintLines = ref<string[]>([] as string[])

  // ---------- 庄家挂着的规矩 ----------
  //
  // 四条带随机参数，每次开这一关重摇 —— 同一关重打不是同一道题。
  // 摇出来的值要摊给玩家看（庄家那排道具上写着），
  // 藏着不写就成了「我怎么突然钩不上了」，那是坑人不是难度
  const reachSpan = ref<number>(0)
  const wildRank = ref<number>(0)
  const crownA = ref<number>(0)
  const crownB = ref<number>(0)
  const lockSuit = ref<string>('')
  // 这一关挂着的那几条，从存档读 —— 不在这儿摇。
  //
  // 摇的时机是上一关打赢、关号推进的那一下（见 finishGame），
  // 因为商店得提前把它们摊出来。在牌桌上摇的话，
  // 商店写的和这儿跑的就是两回事了
  const rules = ref<string[]>([] as string[])

  function hasRule(key : string) : boolean {
    for (let i = 0; i < rules.value.length; i++) {
      if (ruleKeyOf(rules.value[i]) == key) {
        return true
      }
    }
    return false
  }

  function ruleArg(key : string) : string {
    for (let i = 0; i < rules.value.length; i++) {
      if (ruleKeyOf(rules.value[i]) == key) {
        return ruleArgOf(rules.value[i])
      }
    }
    return ''
  }

  // 把存档里那几条摊开成本地状态。带参数的顺手解出来
  function loadRules(data : SaveData) {
    const list : string[] = []
    for (let i = 0; i < data.runRules.length; i++) {
      list.push(data.runRules[i])
    }
    rules.value = list
    reachSpan.value = 0
    wildRank.value = 0
    crownA.value = 0
    crownB.value = 0
    lockSuit.value = ''
    // 长手：摇出来的是 1 还是 2。没摇出参数（旧档）就按 ±1 兜底 ——
    // 规矩在、参数没了的话，当作最轻的那一版，宁可放水也不能凭空变凶
    if (hasRule('reach')) {
      const r = parseInt(ruleArg('reach'))
      reachSpan.value = isNaN(r) || r < 1 ? 1 : r
    }
    const w = ruleArg('wild')
    if (w != '') {
      const n = parseInt(w)
      wildRank.value = isNaN(n) ? 0 : n
    }
    const c = ruleArg('crown')
    if (c != '') {
      const pair = c.split(',')
      if (pair.length == 2) {
        const a = parseInt(pair[0])
        const b = parseInt(pair[1])
        crownA.value = isNaN(a) ? 0 : a
        crownB.value = isNaN(b) ? 0 : b
      }
    }
    lockSuit.value = ruleArg('lock')
  }

  // 规矩标签上写的字。带参数的那四条要把摇出来的值写进去 ——
  // 只写「百搭」而不写是哪个点数，等于没告诉你
  const ruleTags = computed<string[]>(() : string[] => {
    const out : string[] = []
    for (let i = 0; i < rules.value.length; i++) {
      out.push(ruleLabel(rules.value[i]))
    }
    return out
  })

  function ruleLabel(entry : string) : string {
    const key = ruleKeyOf(entry)
    const one = dealerRuleAt(key)
    if (key == 'reach' && reachSpan.value > 0) {
      return one.name + ' ±' + reachSpan.value
    }
    if (key == 'wild' && wildRank.value > 0) {
      return one.name + ' ' + faceOf(wildRank.value)
    }
    if (key == 'crown' && crownA.value > 0) {
      return one.name + ' ' + faceOf(crownA.value) + faceOf(crownB.value)
    }
    if (key == 'lock' && lockSuit.value != '') {
      return one.name + ' ' + lockSuit.value
    }
    return one.name
  }

  function showRule(index : number) {
    if (index < 0 || index >= rules.value.length) {
      return
    }
    const key = ruleKeyOf(rules.value[index])
    const one = dealerRuleAt(key)
    let body = one.desc
    if (key == 'reach' && reachSpan.value > 0) {
      body = '庄家的牌还可以按 ±' + reachSpan.value + ' 的点数算'
    } else if (key == 'wild' && wildRank.value > 0) {
      body = '庄家的 ' + faceOf(wildRank.value) + ' 可以当任意点数用'
    } else if (key == 'crown' && crownA.value > 0) {
      body = '你的 ' + faceOf(crownA.value) + '、' + faceOf(crownB.value)
        + ' 一律失去点数 —— 钩不上人，也没人钩得上，吞口也吞不动'
    } else if (key == 'lock' && lockSuit.value != '') {
      body = '你的 ' + lockSuit.value + ' 一律失去点数 —— 钩不上人，也没人钩得上'
    }
    message.value = '〔庄家规矩·' + one.name + '〕' + body
  }

  // 这张牌被庄家的规矩废成 0 点了吗。只管你的牌 ——
  // 压冠和锁花都是单方面压你的
  function ruledDead(card : Card) : boolean {
    if (crownA.value > 0 && (card.value == crownA.value || card.value == crownB.value)) {
      return true
    }
    return lockSuit.value != '' && card.suit == lockSuit.value
  }
  // 断口：这一轮哪一类牌被废掉。-1 表示没断。
  // 断数废成 **0 点**（什么都比它大），断色废成**没有点数**
  // （什么都不比它大）—— 两回事，见 sizeOf 和 isNumMuted
  const MUTE_NONE : number = -1
  const MUTE_ODD : number = 0
  const MUTE_EVEN : number = 1
  const MUTE_RED : number = 2
  const MUTE_BLACK : number = 3
  let muteKind : number = MUTE_NONE
  // 正拖着的是第几位，-1 表示没在拖
  const dragAt = ref<number>(-1)
  // 被拖那张跟着手指偏了多远
  const dragDX = ref<number>(0)
  // 抖过阈值了没有。没过就还算「点了一下」，牌一动不动 ——
  // 一按下就描金边、就跟着晃，手感是毛的
  const dragging = ref<boolean>(false)
  // 这会儿松手的话它落在第几位。别的牌照这个让位
  const dragTo = ref<number>(-1)
  // 松手那一帧：换数据和清偏移同时发生，这一帧不能有过渡
  const settling = ref<boolean>(false)
  // 刚落下的是第几位、离格位中心还差多少零头。
  // 零头留着等过渡开回来自己滑掉，省得最后半格是硬切的
  const settleAt = ref<number>(-1)
  const settleDX = ref<number>(0)
  let settleTimer : number = -1
  // 按下时手指在哪儿。越过抖动阈值那一刻会重新取一次 ——
  // 不重取的话，牌一上来就得先跳过去那几个像素。
  // 这个得写死成 number：不标类型的话 uts 会照着 0 推成 Int，
  // 再拿 screenX 或者除法结果赋进来就类型对不上，编译直接挂
  let dragFromX : number = 0
  // 一个格位多宽。拖过半格就算越位，让位也是让这么远
  let slotWidth : number = 70
  // 手指总会抖，抖过这么多才算在拖
  const DRAG_SLOP : number = 8
  // 拖到两头还能再拽出去这么多格 —— 顶住了，但看得出还在用力。
  // 必须小于半格，不然会多算出一格来
  const DRAG_OVER : number = 0.2
  // 牌抬起来这么高：拖着的、刚落下的、选中待压的，抬一样高
  const CARD_LIFT : number = -8

  // 压牌动画：先飞向右边的牌库，飞完换数据，新牌再从牌库滑回格位。
  // 时长跟 .card-queue 上的 transition-duration 对齐
  const SINK_OUT : number = 200
  // 正在飞向牌库的那几张 / 正从牌库飞回来的那几张
  const sinking = ref<boolean[]>([] as boolean[])
  const dealing = ref<boolean[]>([] as boolean[])
  // 留下来的牌要往左挪去补空位。这里记的是它「原来在右边多远」，
  // 入场时先按这个偏移摆回旧位置，下一拍放开就滑过来了
  const enterDX = ref<number[]>([] as number[])
  let sinkTimer = -1
  // 右边那一摞牌库占多宽。格宽要把它让出来
  const DECK_WIDTH : number = 54

  // 这一轮演到第几步：0..9，偶数是庄家出，奇数是你出。
  // 第 0 步就是它手牌区一直亮着的那张
  const step = ref<number>(0)
  let stepTimer = -1

  // 你已经出掉几张 —— 队列上用它把出过的压暗
  const playerStep = computed<number>(() : number => {
    return Math.floor((step.value + 1) / 2)
  })

  // 庄家下一张要打的是它队列里第几张。
  // 它在偶数步出牌，所以 step 一推过它那一步，指针就挪到下一张
  const dealerStep = computed<number>(() : number => {
    return Math.ceil(step.value / 2)
  })

  // 它手里还没打的那几张，一张不藏地摆出来（背面朝上）。
  // 已经打出去的在堆上看得见，这儿不重复摆。
  //
  // 挑出来单独成一个数组，是为了让模板里 di == 0 就是「下一张」——
  // 在 v-for 上直接挂 v-if 过滤，Vue 3 里 v-if 的优先级比 v-for 高，
  // 拿不到循环变量
  const dealerHand = computed<Card[]>(() : Card[] => {
    const out : Card[] = []
    for (let i = dealerStep.value; i < dealerQueue.value.length; i++) {
      out.push(dealerQueue.value[i])
    }
    return out
  })

  const dealerLeft = computed<number>(() : number => {
    const left = dealerQueue.value.length - dealerStep.value
    return left > 0 ? left : 0
  })

  // 明竿让你看见它接下来几张。没带这件就一张也看不见
  const dealerOpen = computed<number>(() : number => {
    return sightOpen()
  })

  const dealerTip = computed<string>(() : string => {
    if (dealerLeft.value == 0) {
      return '这一轮它打完了'
    }
    if (dealerOpen.value <= 0) {
      return '全是背面 · 带上明竿才看得见'
    }
    const n = dealerOpen.value < dealerLeft.value ? dealerOpen.value : dealerLeft.value
    // 排竿阶段后面那几张的位置是不作数的 —— 它要等你排完才排自己的顺序。
    // 不说清楚的话，窥筒照亮一张摆在第三位，玩家会当成「它第三手打这张」
    const tail = phase.value == 'plan' && dealerLeft.value > n
      ? ' · 后面那几张的位置还没定，它等你排完才排'
      : ''
    return '亮着的前 ' + n + ' 张是它接下来要打的 · 还剩 '
      + dealerLeft.value + ' 张' + tail
  })

  const stepText = computed<string>(() : string => {
    if (phase.value == 'over') {
      return '本局结束'
    }
    if (phase.value == 'plan') {
      return '排好顺序再开始'
    }
    // 这一轮实打实有几张要打。一方先出完的话就不足十张，
    // 而且 step 会在它那几步上空跳 —— 拿 step 直接当张数会虚高，
    // 算出「第 10/5 张」这种数来。各自按队列长度截一下才准
    const mine = playerStep.value < playerQueue.value.length
      ? playerStep.value : playerQueue.value.length
    const theirs = dealerStep.value < dealerQueue.value.length
      ? dealerStep.value : dealerQueue.value.length
    const total = playerQueue.value.length + dealerQueue.value.length
    return '打完 ' + (mine + theirs) + '/' + total + ' 张'
  })

  // 一共打几轮：各 26 张，一轮摆几张看有没有带长竿，
  // 末了剩的那一张也单算一轮。局长由牌定，不由关卡定
  const totalRounds = computed<number>(() : number => {
    return Math.ceil(HALF_DECK / queueSize())
  })

  // 这一轮你实际要打几张。模板拿它把「备选」那几格标出来
  const playCap = computed<number>(() : number => {
    return capOf(false)
  })

  // 这一轮一共要走几步。按双方**实际要打几张**里多的那个算 ——
  // 不是按队列多长。长竿多摆的那几张轮不到打，算进去就白等两步
  function roundSteps() : number {
    const mine = capOf(false)
    const theirs = capOf(true)
    return (mine > theirs ? mine : theirs) * 2
  }

  const queueTitle = computed<string>(() : string => {
    return '第 ' + round.value + ' 轮 · 你的出竿顺序'
  })

  const queueTip = computed<string>(() : string => {
    if (phase.value != 'plan') {
      return '排定了，照这个顺序打完'
    }
    if (needMax.value > 0) {
      return '点牌选目标 ' + picked.value.length + '/' + needMax.value + ' · 选好按使用'
    }
    return '拖动排序 · 点牌选中再压底'
  })

  const sinkCount = computed<number>(() : number => {
    let n = 0
    for (let i = 0; i < sinkPicked.value.length; i++) {
      if (sinkPicked.value[i]) {
        n = n + 1
      }
    }
    return n
  })

  const sinkText = computed<string>(() : string => {
    const n = sinkCount.value
    return n > 0 ? '压底 ' + n + ' 张' : '压底'
  })

  // 牌库还剩几张没翻。右边那一摞就是它 ——
  // 队列里的五张是从那儿翻出来的，压底的也是压回那儿去
  const deckLeft = computed<number>(() : number => {
    const left = playerDeck.value.length - playerCursor.value
    return left > 0 ? left : 0
  })

  const resultText = computed<string>(() : string => {
    const mine = playerPoints.value.length
    const theirs = dealerPoints.value.length
    if (mine > theirs) {
      return '你赢了'
    }
    if (mine < theirs) {
      return '庄家赢了'
    }
    return '平局'
  })

  const won = computed<boolean>(() : boolean => {
    return playerPoints.value.length > dealerPoints.value.length
  })

  // 平局不算赢 —— 收得一样多，说明没压过对面
  const overHint = computed<string>(() : string => {
    if (!won.value) {
      return '这一轮结束了。从第一关重来'
    }
    if (save.value.runLevel > RELAY_COUNT) {
      return '十关全通了。这一轮到头，回去还能再挑一轮'
    }
    return '进商店花钱、整贴纸位，然后接着打下一关'
  })

  const leaveText = computed<string>(() : string => {
    if (!won.value) {
      return '回头再来'
    }
    return save.value.runLevel > RELAY_COUNT ? '看结算' : '去商店'
  })

  // 认输：这一关不打了，直接算输 —— 跟打满轮数输掉是一个下场。
  //
  // 有这个口子是因为分差一旦拉开，剩下几轮就是走过场，
  // 可你还得一张一张看完。省时间，也省那份难受
  function askConcede() {
    uni.showModal({
      title: '认输？',
      content: '这一轮就到此为止，金币、贴纸、道具全清，从第一关重来。',
      confirmText: '认输',
      cancelText: '再打打',
      success: (res) => {
        if (res.confirm) {
          concede()
        }
      }
    })
  }

  function concede() {
    stopTimer()
    const data = save.value
    resetRun(data)
    data.runLevel = 0
    saveCurrent(data)
    save.value = cloneSave(data)
    uni.redirectTo({
      url: '/pages/examples/blackjack/relay-levels'
    })
  }

  // 赢了进商店，输了回入口。
  // 用 redirectTo 而不是 navigateTo：这一关打完了，不该留在返回栈里 ——
  // 从商店按返回键退回一个已经结算完的牌桌，那是个没法继续的死页面
  function leaveGame() {
    stopTimer()
    if (won.value && save.value.runLevel <= RELAY_COUNT) {
      uni.redirectTo({
        url: '/pages/examples/blackjack/relay-shop?got=' + encodeURIComponent(gotText.value)
      })
      return
    }
    uni.redirectTo({
      url: '/pages/examples/blackjack/relay-levels'
    })
  }

  // 把存档里那 52 段「花色:点数」还原成牌。
  //
  // 顺序原样保留 —— 那就是洗好的顺序，前 26 张你的、后 26 张它的。
  // 读不出来（老档、或者哪儿漏存了）就当场洗一副兜底，
  // 总比空着手进牌桌强
  function decodeDeck(list : string[]) : Card[] {
    if (list.length < HALF_DECK * 2) {
      return buildDeck(emptyStickers())
    }
    const out : Card[] = []
    for (let i = 0; i < list.length; i++) {
      const seg = list[i].split(':')
      if (seg.length != 2) {
        continue
      }
      out.push(makeCard(seg[0], seg[1]))
    }
    return out.length < HALF_DECK * 2 ? buildDeck(emptyStickers()) : out
  }

  // 照花色点数造一张干净的牌。排竿两边都是素牌，所以不带贴纸
  function makeCard(suit : string, rank : string) : Card {
    let value = 1
    for (let i = 0; i < RANKS.length; i++) {
      if (RANKS[i] == rank) {
        value = RANK_VALUES[i]
        break
      }
    }
    return {
      suit: suit,
      rank: rank,
      value: value,
      // J 焊着【通吃】，这一条在两边都认 —— 跟 buildDeck 一个规矩
      stickerKey: isFixedRank(rank) ? S_HAUL : S_NONE,
      tapped: false,
      forced: -1,
      faceDown: false,
      negated: false,
      extra: 0,
      altValue: -1,
      pileValue: -1,
      pileValues: [] as number[]
    } as Card
  }

  // ---------- 开局 ----------

  function setup() {
    stopTimer()
    const data = loadCurrentSave()
    save.value = data
    level.value = relayLevelAt(currentRelayLevel())
    // 一副 52 张洗开，对半分，双方各 26 张。
    //
    // 分的是同一副牌 —— 你手里有什么，就等于它手里没有什么。
    // 这是这个模式能「算」而不是「赌」的地基：每个点数统共四张，
    // 打出去的累起来，剩下的在谁手上推得出来。
    // 从前双方各用一副独立的 52 张，它有几张 K 你永远不知道，
    // 排序就只剩「拆自己的对子夹住它」这一条，夹得住夹不住全看运气。
    //
    // 你的牌是素的 —— 排竿不吃主玩法那套牌组构筑，你的贴纸全靠贴纸位
    // 带进来、靠每轮白送的攒。庄家那半副发完再贴
    // 牌不在这儿洗 —— 上一关打赢、关号推进那一下就洗好存档了，
    // 因为商店要先把你这 26 张摊出来。在这儿洗的话，
    // 商店给你看的和你真正拿到的是两副
    const full = decodeDeck(data.runDeck)
    const mine : Card[] = []
    const theirs : Card[] = []
    for (let i = 0; i < full.length; i++) {
      if (i < HALF_DECK) {
        mine.push(full[i])
      } else {
        theirs.push(full[i])
      }
    }
    playerDeck.value = mine
    // 庄家的牌现在也是干净素牌 —— 它的难度全在那排规矩上，不在牌面上
    dealerDeck.value = theirs
    playerCursor.value = 0
    dealerCursor = 0
    measureSlots()
    // 限制类的次数按「一关」回满，所以开这一关的时候先清零
    resetUses(data)
    saveCurrent(data)
    save.value = cloneSave(data)
    // 这一关庄家挂着的规矩，上一关进商店前就摇好存下了
    loadRules(data)
    // 道具栏上装着的，开局就摆出来
    buildBar()
    clearTweaks()
    // 上一关长竿留下的备选不带到这一关来 —— 那是上一副牌里的
    keepCards = [] as Card[]
    keepHidden = [] as boolean[]
    gotText.value = ''
    round.value = 1
    pile.value = [] as Card[]
    // 挡口跟着堆清，不跟着轮清 —— 它护的桩要跨好几轮才收
    guards = [] as Card[]
    pileFromDealer.value = [] as boolean[]
    playerPoints.value = [] as Card[]
    dealerPoints.value = [] as Card[]
    catchMarks.value = [] as boolean[]
    sinkPicked.value = [] as boolean[]
    message.value = '第 ' + level.value.index + ' 关「' + level.value.name + '」。'
      + '一副牌洗开对半分：你 26 张，剩下 26 张全在庄家手里 —— '
      + '**你有的它就没有**，打出去的牌累起来，它还剩什么推得出来。'
      + '把牌库顶这五张排成一串，相邻两张之间会夹进它一张，'
      + '点数对得上的排在一起，就把夹着的那张一并收走。'
    startRound()
  }

  // 开一轮：双方各从牌库顶取五张，然后你排序。
  //
  // 庄家仍然先手，顺序是 庄、你、庄、你…… 你相邻的两张之间夹着它一张，
  // 配对收走中间那段这条核心机制原样不动。
  //
  // 但它那第一张不再提前拍到堆上了 —— 手牌区把它明着亮出来就够了。
  // 从前先打进堆，是因为它那五张你一张也看不见，不给个参照的话
  // 排序就成了掷骰子；现在改成明示，信息一样多，还多一层推演：
  // 从前你看到的是结算完的局面，现在它落堆的结算发生在你排完之后，
  // 它会不会顺手钩走堆上的残留，得你自己先算明白
  function startRound() {
    step.value = 0
    resetDrag()
    clearPick()
    // 上一轮道具改过的牌，改动到这儿为止 ——
    // 「这一轮 +2」就该只管那一轮
    clearTweaks()
    // 上一轮打出去还留在堆上的，从这一轮起算「上几轮剩的」，
    // 不再参与重排 —— 它们沉在底下就是跨轮的那层记忆
    roundCards = [] as Card[]
    playedMine = 0
    // 拢堆只管发动的那一轮，换轮就关掉
    tidyRound.value = false
    // 探口的线索说的是上一轮那副手牌，换轮就过期了，不能留着骗人
    hintLines.value = [] as string[]
    // 长竿多摆的那几张上一轮轮不到打，留着接着用 ——
    // 它们排在队列最前面，因为你上一轮就是把它们往后挪才没打的，
    // 这一轮该轮到了
    const keep = keepCards
    const keepFlags = keepHidden
    keepCards = [] as Card[]
    keepHidden = [] as boolean[]
    const cards : Card[] = []
    const hidden : boolean[] = []
    for (let i = 0; i < keep.length; i++) {
      cards.push(keep[i])
      hidden.push(i < keepFlags.length ? keepFlags[i] : false)
    }
    let want = queueSize() - cards.length
    if (want < 0) {
      want = 0
    }
    const fresh = drawFor(false, want)
    for (let i = 0; i < fresh.length; i++) {
      cards.push(fresh[i])
      hidden.push(false)
    }
    playerQueue.value = cards
    queueHidden.value = hidden
    sinkPicked.value = allFalse(cards.length)
    // 庄家始终摆五张 —— 长竿是你花钱买的，没道理连它一起长。
    //
    // **这儿不排序**，照牌库顺序摆着，等你按「开始出牌」它才排
    //（见 settleDealer）。理由是窥筒：那件让你点位置照亮它的牌，
    // 要是开局就排好了，「第三张是什么」就等于「它第三手打什么」——
    // 窥筒会连出牌顺序一起泄露，而顺序是明竿独家卖的东西
    dealerQueue.value = drawFor(true, QUEUE_SIZE)
    toPlan()
  }

  // 轮到你排
  function toPlan() {
    stepTimer = -1
    phase.value = 'plan'
    message.value = '庄家先打的是亮出来那张。照着它排你这五张 ——'
      + '你相邻的两张之间会夹进它一张。'
  }

  function drawFor(byDealer : boolean, want : number) : Card[] {
    const deck = byDealer ? dealerDeck.value : playerDeck.value
    const list : Card[] = []
    for (let i = 0; i < want; i++) {
      const at = byDealer ? dealerCursor : playerCursor.value
      if (at >= deck.length) {
        break
      }
      list.push(deck[at])
      if (byDealer) {
        dealerCursor = at + 1
      } else {
        playerCursor.value = at + 1
      }
    }
    return list
  }

  // 一个格位多宽。拖动越没越位靠它算 ——
  // 五个格位平分整行，量一次就够，横竖这一页不转屏
  function measureSlots() {
    const info = uni.getSystemInfoSync()
    screenW = info.windowWidth
    const usable = screenW - 20 - DECK_WIDTH
    slotWidth = usable / QUEUE_SIZE
    if (slotWidth < 20) {
      slotWidth = 20
    }
  }

  // 被钩中的那一段怎么飞。
  //
  // 牌堆是自动换行排的，每张牌的落点按下标推得出来：
  // 横着 52px 一格（牌 46 + 缝 6），竖着 70px 一行。
  // 下面这些起点坐标是照版式估的，不是量出来的 —— 飞个动画而已，
  // 差几像素看不出来，为此去 createSelectorQuery 量一遍不值当
  const CARD_STEP_X : number = 52
  const CARD_STEP_Y : number = 70
  // 牌堆左上角离屏幕左边、上边各有多远
  const BOARD_LEFT : number = 20
  const BOARD_TOP : number = 84

  // 亮着的那几张在飞的时候就地隐形 —— 真正在飞的是上面那层浮层里的替身。
  //
  // 不让原牌自己飞，是因为牌堆在 scroll-view 里：滚动容器一定会裁剪，
  // 牌刚飞到边上就被切掉了。浮层挂在页面根上，飞到哪儿都不会被剪
  function pileStyleOf(index : number) : string {
    if (index >= catchMarks.value.length || !catchMarks.value[index]) {
      return ''
    }
    return flyOn.value ? 'opacity: 0;' : ''
  }

  function rowCapacity() : number {
    const n = Math.floor((screenW - BOARD_LEFT * 2) / CARD_STEP_X)
    return n < 1 ? 1 : n
  }

  // 替身的起点：照牌堆的版式推这张牌现在摆在屏幕哪儿
  function boardX(index : number) : number {
    return BOARD_LEFT + (index % rowCapacity()) * CARD_STEP_X
  }

  function boardY(index : number) : number {
    return BOARD_TOP + Math.floor(index / rowCapacity()) * CARD_STEP_Y
  }

  // 替身怎么摆、往哪飞。
  // 先按起点落位，下一拍翻开 flyGo，它就朝比分缩过去
  function flyStyleOf(index : number) : string {
    const one = flyCards.value[index]
    let text = 'left: ' + one.x + 'px; top: ' + one.y + 'px;'
    if (!flyGo.value) {
      return text
    }
    // 庄家的分在左上角，你的在右上角
    const tx = pendingBy ? screenW / 6 : screenW * 5 / 6
    text = text + ' transform: translate(' + (tx - one.x - 23) + 'px, '
      + (FLY_TARGET_Y - one.y - 32) + 'px) scale(0.16); opacity: 0.2;'
    return text
  }

  // ---------- 排序 ----------

  // 拖着牌换位置。
  //
  // 拖的时候只挪画面，不动数据：让位的牌用 transform 滑开一格，
  // 松手才真的重排。反过来做（越一格就改一次数组）看着更直接，
  // 可 v-for 的 key 是下标，数据一换 Vue 就地把牌面内容换掉 ——
  // 牌是瞬移的，「让开」这个过程根本没发生。key 换成稳定的也救不回来：
  // flex 行里节点换位仍然是一帧到位，uvue 没有 FLIP 那套。
  // 现在动的全是 transform，.card-queue 那条 200ms 过渡自己就把让位滑出来了。
  //
  // 松手那一下要把画面和数据对上：重排之后每张牌该在的位置，
  // 正好就是它这会儿被 transform 挪到的位置 —— 所以换数据和清偏移
  // 必须同一帧发生，而且这一帧得把过渡关掉（card-settling），
  // 不然整排牌会带着换好的新牌面，再滑回去一格
  function dragStart(index : number, e : TouchEvent) {
    if (phase.value != 'plan' || e.touches.length == 0) {
      return
    }
    // 压牌的动画还在走。sinking / dealing / enterDX 都是按下标对位的，
    // 这会儿重排会让标记和牌错开，飞走的就成了别的牌
    if (sinking.value.length > 0 || dealing.value.length > 0) {
      return
    }
    // 定桩：最后一张钉死，拖不动。削的是排序自由度本身，不碰牌数
    if (hasRule('pin') && index == playerQueue.value.length - 1) {
      toast('【定桩】最后一张钉死了，拖不动')
      return
    }
    // 上一把落子的收尾还没走完又按下来了，先收干净
    resetDrag()
    fitSlotWidth()
    dragAt.value = index
    dragTo.value = index
    dragFromX = e.touches[0].screenX
    dragDX.value = 0
    dragging.value = false
  }

  function dragMove(e : TouchEvent) {
    if (dragAt.value < 0 || e.touches.length == 0) {
      return
    }
    let dx : number = e.touches[0].screenX - dragFromX
    if (!dragging.value) {
      if (Math.abs(dx) <= DRAG_SLOP) {
        return
      }
      dragging.value = true
      // 过线这一刻把基准挪到手指底下，牌就不用先跳过去那几像素
      dragFromX = e.touches[0].screenX
      dx = 0
    }
    // 两头各留一点余量：拖到顶还能再拽出去一点，顶住了但不是焊死。
    // last 不标类型 —— length 编译过去是 Int，标成 number 反而对不上，
    // clampSlot 那边也是这么写的
    const last = playerQueue.value.length - 1
    const low : number = (0 - dragAt.value) * slotWidth - slotWidth * DRAG_OVER
    const high : number = (last - dragAt.value) * slotWidth + slotWidth * DRAG_OVER
    if (dx < low) {
      dx = low
    }
    if (dx > high) {
      dx = high
    }
    dragDX.value = dx
    // 划过半格就算越了一格。数据这会儿一点没动，
    // 越位只是改了「松手会落在哪」，让位全靠 transform 演
    let to = clampSlot(dragAt.value + Math.round(dx / slotWidth))
    // 定桩钉死的是最后那一格：别的牌也不许挪进去占它的位置，
    // 不然把它挤走就等于绕开了这条规矩
    if (hasRule('pin') && to >= playerQueue.value.length - 1) {
      to = playerQueue.value.length - 2
      if (to < 0) {
        to = 0
      }
    }
    dragTo.value = to
  }

  function dragEnd() {
    const index = dragAt.value
    const to = dragTo.value
    const moved = dragging.value
    // 手指松开时牌偏在哪儿。得赶在下面清零之前存下来 ——
    // 零头要拿它算
    const dx = dragDX.value
    dragAt.value = -1
    dragTo.value = -1
    dragDX.value = 0
    dragging.value = false
    if (index < 0) {
      return
    }
    if (moved) {
      if (to >= 0 && to != index) {
        // 落点和手指之间还剩不到半格的零头，先记下来。
        // 数据这一换、偏移一清，每张牌该在的位置正好就是它现在
        // 被 transform 挪到的位置，所以画面是接得上的 ——
        // 前提是这一帧不能有过渡
        settleAt.value = to
        settleDX.value = dx - (to - index) * slotWidth
        settling.value = true
        moveItem(index, to)
        settleTimer = setTimeout(settleGo, 32)
      }
      return
    }
    // 按下去没怎么动，那是点了一下。
    // 正攥着一件要挑目标的道具就是「瞄这张」，没攥着才是「选中待压」
    if (needMax.value > 0) {
      pickForItem(index)
    } else {
      togglePick(index)
    }
  }

  // 手势被系统打断（来电、外层接管滚动）。
  // 这不算落子：位置不改，也不该当成点了一下
  function dragCancel() {
    dragAt.value = -1
    dragTo.value = -1
    dragDX.value = 0
    dragging.value = false
  }

  // 落子收尾第一拍：过渡开回来，偏移先留着不动。
  // 时长和位置同一帧改，有的端认不认账说不准，那就分两拍各改各的
  function settleGo() {
    settleTimer = -1
    settling.value = false
    settleTimer = setTimeout(settleLand, 16)
  }

  // 第二拍：零头清掉。这会儿过渡是活的，最后这半格是滑进去的
  function settleLand() {
    settleTimer = -1
    settleAt.value = -1
    settleDX.value = 0
  }

  // 拖动和落子收尾的状态一起清干净。
  // 开打、换轮、页面收场都得清 —— 留着的话下一轮第一帧
  // 会有张牌莫名其妙偏在一边，或者过渡还关着
  function resetDrag() {
    if (settleTimer != -1) {
      clearTimeout(settleTimer)
      settleTimer = -1
    }
    settling.value = false
    settleAt.value = -1
    settleDX.value = 0
    dragAt.value = -1
    dragTo.value = -1
    dragDX.value = 0
    dragging.value = false
  }

  // 格宽按这一排实际几张算。牌库见底那几轮队列可能不足五张，
  // 五个格位是 flex 平分的，少一张每格就宽一截 ——
  // 还按五张算的话，让位会让少一截，松手就对不上
  function fitSlotWidth() {
    const n = playerQueue.value.length
    if (n <= 0) {
      return
    }
    const usable = screenW - 20 - DECK_WIDTH
    slotWidth = usable / n
    if (slotWidth < 20) {
      slotWidth = 20
    }
  }

  function togglePick(index : number) {
    if (index >= sinkPicked.value.length) {
      return
    }
    const next : boolean[] = []
    for (let i = 0; i < sinkPicked.value.length; i++) {
      next.push(i == index ? !sinkPicked.value[i] : sinkPicked.value[i])
    }
    sinkPicked.value = next
  }

  function clampSlot(index : number) : number {
    const last = playerQueue.value.length - 1
    if (index < 0) {
      return 0
    }
    return index > last ? last : index
  }

  // 把 from 位上的牌抽出来插到 to 位，中间的顺移。
  // to 是它在新队列里的下标 —— 插入是插在 restCards[to] 前面，
  // 所以剔除再插入之后，牌正好落在 to，不用为剔除让出来的那一格找补。
  //
  // 盲牌标记、选中待压的标记都跟着牌一起走：它们记的是
  // 「这张牌怎么样」，不是「这一格怎么样」
  function moveItem(from : number, to : number) {
    const cards = playerQueue.value
    const hidden = queueHidden.value
    const picked = sinkPicked.value
    // 标记跟队列一样长才跟着搬。别的流程刚把它清空过就别动，
    // 免得越搬越短
    const takePicked : boolean = picked.length == cards.length
    const card = cards[from]
    const flag = hidden[from]
    const pick : boolean = takePicked ? picked[from] : false
    const restCards : Card[] = []
    const restHidden : boolean[] = []
    const restPicked : boolean[] = []
    for (let i = 0; i < cards.length; i++) {
      if (i != from) {
        restCards.push(cards[i])
        restHidden.push(hidden[i])
        if (takePicked) {
          restPicked.push(picked[i])
        }
      }
    }
    const outCards : Card[] = []
    const outHidden : boolean[] = []
    const outPicked : boolean[] = []
    for (let i = 0; i < restCards.length; i++) {
      if (i == to) {
        outCards.push(card)
        outHidden.push(flag)
        if (takePicked) {
          outPicked.push(pick)
        }
      }
      outCards.push(restCards[i])
      outHidden.push(restHidden[i])
      if (takePicked) {
        outPicked.push(restPicked[i])
      }
    }
    if (to >= restCards.length) {
      outCards.push(card)
      outHidden.push(flag)
      if (takePicked) {
        outPicked.push(pick)
      }
    }
    playerQueue.value = outCards
    queueHidden.value = outHidden
    if (takePicked) {
      sinkPicked.value = outPicked
    }
  }

  // 格位上这张牌该摆在哪儿。
  //
  // 拖动跟手、给别人让位、落子归位、飞向牌库、从牌库飞回来，
  // 五件事都是在动同一个 transform，所以统一从这儿出 ——
  // 分散到几个 :style 上只会互相盖掉。
  // 飞走和飞回的目标位置是同一个（牌库那边），差别只在过渡的方向
  function slotStyleOf(index : number) : string {
    if (index < sinking.value.length && sinking.value[index]) {
      return awayStyle(index)
    }
    if (index < dealing.value.length && dealing.value[index]) {
      return awayStyle(index)
    }
    // 还摆在旧位置上，等着滑过来补空位
    if (index < enterDX.value.length && enterDX.value[index] != 0) {
      return 'transform: translateX(' + enterDX.value[index] + 'px);'
    }
    // 正拖着的那张：跟着手指走，同时抬起来一点
    if (index == dragAt.value && dragging.value) {
      return 'transform: translate(' + dragDX.value + 'px, ' + CARD_LIFT + 'px);'
    }
    // 刚落下的那张：先停在手指松开的地方，下一拍才滑进格位
    if (index == settleAt.value) {
      return 'transform: translate(' + settleDX.value + 'px, ' + CARD_LIFT + 'px);'
    }
    // 被拖的那张要插进来，从它原来的位子到落点之间这一段整体让开一格。
    // 让的是 transform 不是数据 —— 数据一动，v-for 就地换牌面，
    // 让位就成了瞬间跳变
    let dx : number = 0
    if (dragAt.value >= 0 && dragging.value) {
      const from : number = dragAt.value
      const to : number = dragTo.value
      if (from < to && index > from && index <= to) {
        dx = 0 - slotWidth
      } else if (from > to && index >= to && index < from) {
        dx = slotWidth
      }
    }
    // 选中待压的抬起来一点。用 transform 而不是加一行字或者垫个 margin ——
    // 那两样都会改布局，一选中整行就跟着长高。
    // 让位和抬起可能同时发生，合成一条，别指望两个 transform 能叠加
    let dy : number = 0
    if (index < sinkPicked.value.length && sinkPicked.value[index]) {
      dy = CARD_LIFT
    }
    if (dx == 0 && dy == 0) {
      return ''
    }
    return 'transform: translate(' + dx + 'px, ' + dy + 'px);'
  }

  // 牌库在这一排的右边，所以越靠左的格位要飞越远
  function awayStyle(index : number) : string {
    const dx = (QUEUE_SIZE - index) * slotWidth
    return 'transform: translate(' + dx + 'px, -8px) scale(0.55); opacity: 0;'
  }

  function noop() {}

  // 压底：选中的几张一起压到牌库最后面，从牌库顶补上等量的新牌。
  //
  // 补上来的是盲牌 —— 看不到点数，但位置照样能排。不限次数，
  // 因为约束本来就在牌里：压掉一张已知的换一张未知的，五张全压掉
  // 就是把这一轮交给运气。
  //
  // 几张一起压而不是一张张压，是因为一张张来的话前一张补上来的牌
  // 会把后面的选中位置挤乱
  function sinkPickedCards() {
    // 上一次压牌的动画还没走完就再点，会把正在飞的那几张的标记冲掉
    if (phase.value != 'plan' || sinking.value.length > 0 || dealing.value.length > 0) {
      return
    }
    // 压牌的动画要按下标标记哪几张飞走，这会儿手上还攥着一张的话
    // 标记和牌会错开 —— 先把拖动收干净
    resetDrag()
    const want = sinkCount.value
    if (want == 0) {
      toast('先点几张要压的牌')
      return
    }
    if (playerCursor.value + want > playerDeck.value.length) {
      toast('牌库剩下的不够补，压不了这么多')
      return
    }
    // 先让这几张飞向牌库，飞完再换数据
    const marks : boolean[] = []
    for (let i = 0; i < sinkPicked.value.length; i++) {
      marks.push(sinkPicked.value[i])
    }
    sinking.value = marks
    sinkTimer = setTimeout(sinkSwap, SINK_OUT)
  }

  // 飞出去了，这会儿换牌。
  //
  // 压掉的位置不是原地补上，而是剩下的牌整体往左挪去补空，
  // 新牌一律接在队尾 —— 它们是刚从右边那摞牌库翻出来的，
  // 落在最右边才讲得通。
  //
  // 换完先把每张牌摆回它「原来的位置」（左移的按旧格位、新牌按牌库位置），
  // 下一拍再一起放开 —— 于是旧牌滑过来补位、新牌从牌库飞进队尾
  function sinkSwap() {
    sinkTimer = -1
    const deck = playerDeck.value
    const cards : Card[] = []
    const hidden : boolean[] = []
    const fresh : boolean[] = []
    const enter : number[] = []
    const out : Card[] = []
    // 先把留下来的按原顺序挤到左边，记下各自原来在第几格
    for (let i = 0; i < playerQueue.value.length; i++) {
      if (i < sinking.value.length && sinking.value[i]) {
        out.push(playerQueue.value[i])
        continue
      }
      cards.push(playerQueue.value[i])
      hidden.push(queueHidden.value[i])
      fresh.push(false)
      // 往左挪了几格，入场时就先往右偏几格
      enter.push((i - (cards.length - 1)) * slotWidth)
    }
    // 空出来的位子在队尾，从牌库顶补齐
    let cursor = playerCursor.value
    for (let i = 0; i < out.length; i++) {
      if (cursor >= deck.length) {
        break
      }
      cards.push(deck[cursor])
      hidden.push(true)
      fresh.push(true)
      enter.push(0)
      cursor = cursor + 1
    }
    playerCursor.value = cursor
    // 压到最后面。牌库就 26 张，而且这一局要全打完 ——
    // 压下去的还会翻上来，只是排到后头去了。
    // 所以压牌不是把牌扔掉，是把这张的麻烦推到后面
    const nextDeck : Card[] = []
    for (let i = 0; i < deck.length; i++) {
      nextDeck.push(deck[i])
    }
    for (let i = 0; i < out.length; i++) {
      nextDeck.push(cloneCard(out[i]))
    }
    playerDeck.value = nextDeck
    playerQueue.value = cards
    queueHidden.value = hidden
    sinkPicked.value = allFalse(cards.length)
    sinking.value = [] as boolean[]
    // 这会儿全都还摆在「原来的位置」上，下一拍一起放开
    dealing.value = fresh
    enterDX.value = enter
    sinkTimer = setTimeout(sinkLand, 32)
    message.value = '压掉 ' + out.length + ' 张，补上来的盲牌接在最后 —— '
      + '看不到是什么，但位置你说了算。'
  }

  function sinkLand() {
    sinkTimer = -1
    dealing.value = [] as boolean[]
    enterDX.value = [] as number[]
  }

  function allFalse(size : number) : boolean[] {
    const list : boolean[] = []
    for (let i = 0; i < size; i++) {
      list.push(false)
    }
    return list
  }

  // 庄家的排序。
  //
  // 跟你用同一套算计：把点数对得上的两张排到相邻位，后一张钩中前一张，
  // 顺带把堆上比它小的一并扫走。配不上对的按点数大小垫在后面 ——
  // 大数落堆晚一点，被钩中的机会少些
  // 你按下「开始出牌」那一刻，庄家才排它这一轮的出牌顺序。
  //
  // 为什么拖到这时候：窥筒让你点位置照亮它的牌。要是开局就排好，
  // 「第三张是什么」就等于「它第三手打什么」—— 窥筒会连顺序一起泄露，
  // 而顺序是明竿独家卖的东西。拖到排完再排，你就只知道它**有什么**，
  // 不知道**什么时候打**，两件情报道具各卖各的。
  //
  // **明竿看过的那几张冻住不动**。不冻的话明竿就成了假话：
  // 它承诺的是「接下来 N 张要打的牌，带顺序」，排完一动就全错了。
  // 代价是庄家那几张失去了参与算计的机会 —— 盯得越紧它越不好换手，
  // 这笔买卖正好是明竿该有的分量
  function settleDealer() {
    const keep = dealerOpen.value
    const head : Card[] = []
    const rest : Card[] = []
    for (let i = 0; i < dealerQueue.value.length; i++) {
      if (i < keep) {
        head.push(dealerQueue.value[i])
      } else {
        rest.push(dealerQueue.value[i])
      }
    }
    const sorted = sortDealer(rest)
    const out : Card[] = []
    for (let i = 0; i < head.length; i++) {
      out.push(head[i])
    }
    for (let i = 0; i < sorted.length; i++) {
      out.push(sorted[i])
    }
    dealerQueue.value = out
  }

  function sortDealer(cards : Card[]) : Card[] {
    // 头两关的庄家不排队，照牌库顺序打 —— 让人先把这套算计摸明白
    if (level.value.dealerSmart == DEAL_PLAIN) {
      return cards
    }
    // 浑水：它有几张自己也看不见。看得见的那些照常算计，
    // 盲的那几张排完了再瞎插进去
    const blind = pickBlind(cards.length, blindCount())
    const seen : Card[] = []
    const unseen : Card[] = []
    for (let i = 0; i < cards.length; i++) {
      if (blind[i]) {
        unseen.push(cards[i])
      } else {
        seen.push(cards[i])
      }
    }
    const sorted = sortSeen(seen)
    return unseen.length == 0 ? sorted : insertBlind(sorted, unseen)
  }

  // 浑水遮几张。没带这件就是 0
  function blindCount() : number {
    const tier = lastingTier('murky')
    return tier < 0 ? 0 : valueAt(itemAt('murky'), tier)
  }

  // 随机挑 want 张当作它看不见的。
  // 挑随机的而不是固定后几张 —— 固定的话你数着位置就知道哪几张是瞎插的
  function pickBlind(size : number, want : number) : boolean[] {
    const marks = allFalse(size)
    let left = want
    if (left > size - 1) {
      // 总得给它留一张看得见的，不然「排序」这件事没有了
      left = size - 1
    }
    let guard = 0
    while (left > 0 && guard < 100) {
      guard = guard + 1
      const at = Math.floor(Math.random() * size)
      if (marks[at]) {
        continue
      }
      marks[at] = true
      left = left - 1
    }
    return marks
  }

  // 盲的那几张瞎插：位置随机，它自己也不知道插进去的是什么。
  //
  // 每插一张都重建一个数组 —— uts 编译到 Kotlin 之后数组的 length
  // 不可写，splice 那套也别指望跨端一致，老老实实拷
  function insertBlind(sorted : Card[], unseen : Card[]) : Card[] {
    let out : Card[] = sorted
    for (let i = 0; i < unseen.length; i++) {
      const at = Math.floor(Math.random() * (out.length + 1))
      const next : Card[] = []
      for (let k = 0; k < out.length; k++) {
        if (k == at) {
          next.push(unseen[i])
        }
        next.push(out[k])
      }
      if (at >= out.length) {
        next.push(unseen[i])
      }
      out = next
    }
    return out
  }

  // 它看得见的那几张怎么排。原来那套算计原样搬进来
  function sortSeen(cards : Card[]) : Card[] {
    // 用一排标记挑，不动原数组的长度 ——
    // uts 编译到 Kotlin 之后数组没有可写的 length，改不得
    const used : boolean[] = []
    for (let i = 0; i < cards.length; i++) {
      used.push(false)
    }
    const out : Card[] = []
    for (let n = 0; n < cards.length; n++) {
      let pick = -1
      // 先找跟刚排进去那张配得上的：它俩挨着排，后一张就钩得中前一张
      if (out.length > 0) {
        const last = valuesOf2(out[out.length - 1])
        for (let i = 0; i < cards.length; i++) {
          if (!used[i] && shareValue(last, valuesOf2(cards[i]))) {
            pick = i
            break
          }
        }
      }
      // 配不上对，得垫一张。
      // 配对档随便拿一张；调过的那一档挑点数最小的先打 ——
      // 大数留到后面才落堆，在堆上待的工夫短，挨钩的机会就少
      if (pick < 0) {
        const tuned = level.value.dealerSmart == DEAL_TUNED
        for (let i = 0; i < cards.length; i++) {
          if (used[i]) {
            continue
          }
          if (pick < 0) {
            pick = i
            continue
          }
          if (tuned && lowValue(cards[i]) < lowValue(cards[pick])) {
            pick = i
          }
        }
      }
      if (pick < 0) {
        break
      }
      used[pick] = true
      out.push(cards[pick])
    }
    return out
  }

  // 这张牌能算出来的最小的那个数。没有点数的（空位类）排最后，
  // 它反正钩不上也没人钩得上，垫在哪儿都一样
  function lowValue(card : Card) : number {
    const values = valuesOf2(card)
    if (values.length == 0) {
      return 99
    }
    let low = values[0]
    for (let i = 1; i < values.length; i++) {
      if (values[i] < low) {
        low = values[i]
      }
    }
    return low
  }

  // 还没落堆的牌算哪几个数。valuesOf 读的是落堆之后的结果，
  // 排序时牌还在队列里，得按 playOptions 预判
  // 点数减到 0 就停，不许变成负数。**全局规则，不是某件道具的特例。**
  //
  // 摆成一道闸而不是让每件减法道具自己夹：提子六件、落水、以后再加的
  // 什么，全从算候选点数的出口过这一道，漏不掉也不用各写一遍。
  //
  // 立这条的理由见 relay-items 文件头那段。一句话：负数跟 0 在规则里
  // 是一个待遇（shareValue 跳过 ≤0），留着它只会让牌面冒出「-3」，
  // 还会让「0 点牌」这个状态不好数 —— 而落水正要数它
  function noNegative(vals : number[]) : number[] {
    let low = false
    for (let i = 0; i < vals.length; i++) {
      if (vals[i] < 0) {
        low = true
      }
    }
    if (!low) {
      return vals
    }
    const out : number[] = []
    for (let i = 0; i < vals.length; i++) {
      out.push(vals[i] < 0 ? 0 : vals[i])
    }
    return out
  }

  // 这张牌正好是 0 点吗。
  //
  // **没点数的不算**：它压根没有这个属性，比大小时还算最大（见 sizeOf）。
  // 落水数 X、判自己触不触发，都认这一条
  function isZeroPoint(card : Card) : boolean {
    const vals = valuesOf(card)
    return vals.length > 0 && topOf(card) == 0
  }

  function valuesOf2(card : Card) : number[] {
    if (isBlankSticker(card.stickerKey)) {
      return [] as number[]
    }
    // 主动废掉点数的那几张（收色、缠线、染水）还没落堆就已经没点数了 ——
    // 牌面上得当场看出来。不认这一条的话，plan 阶段它还写着原来的点数，
    // 你排到一半忘了哪张标过，这道题就白算了。
    // rankText 拿到空数组会渲染成空字符串，于是牌上只剩一个花色，
    // 「没有点数，只剩花色」这件事本身就是最好的标记
    if (isNoValue(card)) {
      return [] as number[]
    }
    // 归标多出来的那个 11 也要算进来 —— 牌面上直接写成 13/11，
    // plan 阶段就看得见。不然你得自己记着「我带了归标所以 K 也能收桩」。
    // 最后过一道 noNegative：提子压下去的牌，牌面上写 0 不写负数
    return noNegative(tollValues(card, playOptions(card)))
  }

  // 牌面上不摊开多出来的候选点数（幸运的 ±1、庄家长手的 ±2）——
  // 46 像素宽的牌面摆不下三五个数，摆下了也没法看。
  // 这些效果在判定里生效（playOne），牌面只写本来的点数

  // ---------- 道具栏 ----------

  // 开局把道具栏上那几件读成一排。
  //
  // 永续的在这儿只是列着 —— 它的效果在发牌和判定的时候就生效了
  // （见 lastingTier / sightOpen / alongBonus），没有「用」这个动作。
  // 限制的才有次数，点它才有反应
  function buildBar() {
    const keys = runCarry(save.value)
    const list : BarItem[] = []
    for (let i = 0; i < keys.length; i++) {
      const key = keys[i]
      const tier = itemTierOf(save.value, key)
      if (tier < 0) {
        continue
      }
      const item = itemAt(key)
      const limited = item.kind == KIND_LIMITED
      list.push({
        key: key,
        name: item.name,
        tier: tier,
        limited: limited,
        // 寒流：每件限制类少用一次，但至少还剩一次 ——
        // 扣到 0 就等于这一关白带了，那不是难度是没收
        left: limited ? chilled(usesLeft(save.value, key)) : 0,
        need: countAt(item, tier)
      } as BarItem)
    }
    bar.value = list
    barAt.value = -1
    needMax.value = 0
    picked.value = [] as number[]
  }

  // 寒流：限制类每件少用一次，最少还剩一次
  function chilled(n : number) : number {
    if (!hasRule('chill') || n <= 1) {
      return n
    }
    return n - 1
  }

  // 手上这件永续道具在第几级，没带上场就是 -1。
  // 永续的效果全靠它查 —— 只认「带没带上场」，不认库里有没有
  function lastingTier(key : string) : number {
    for (let i = 0; i < bar.value.length; i++) {
      if (bar.value[i].key == key) {
        return bar.value[i].tier
      }
    }
    return -1
  }

  // 并色：方块当红心、梅花当黑桃，四门并成两门。
  //
  // 只管**你自己**那两条按花色收的线（收色、集花）。
  // 庄家的同源（跟堆顶同花色就白送点数）和锁花（锁死你一个花色）
  // 一律不并 —— 那是它的规矩，没道理让你花钱买的道具反过来
  // 去喂它一次白送的钩，或者把锁掉一门变成锁掉两门
  function foldSuit(suit : string) : string {
    if (lastingTier('fold') < 0) {
      return suit
    }
    if (suit == '♦') {
      return '♥'
    }
    if (suit == '♣') {
      return '♠'
    }
    return suit
  }

  // 这两张按花色算不算一路。空串是背面牌，没有花色，谁也配不上 ——
  // 这一条得留着，不然两张背面牌会因为「都是空串」而互相认亲
  function suitAlike(a : string, b : string) : boolean {
    if (a == '' || b == '') {
      return false
    }
    return foldSuit(a) == foldSuit(b)
  }

  // 巨口：你打出的牌点数大于这个数的，改按比大小收。
  // 0 表示没带这件
  function mawLine() : number {
    const tier = lastingTier('maw')
    return tier < 0 ? 0 : valueAt(itemAt('maw'), tier)
  }

  // 这一张走不走大小那条线。
  //
  // 只管你这边 —— 它是你花钱买的，没道理连庄家一起照顾。
  // 看的是 topOf（落堆时算出来的最大那个候选），不是牌面原来的点数：
  // 坠子推上去的、定标钉成 11 的都该算数。
  // 没点数的牌 topOf 是 0，自然够不着门槛
  function isMaw(byDealer : boolean, card : Card) : boolean {
    if (byDealer) {
      return false
    }
    const line = mawLine()
    return line > 0 && topOf(card) > line
  }

  // 归标：你的大数牌（大于 BIG_VALUE，也就是 J、Q、K）同时可视为 11。
  //
  // **加一个候选，不是换掉本来那个** —— 一张 K 同时是 13 和 11。
  //
  // 代价不用另写，它自己长出来：这份候选表会原样存进 pileValues，
  // 所以你那张 K 落堆之后，庄家拿一张 J 来撞也撞得上（shareValue 认交集）。
  // 你伸手够桩的同时，也把自己六张大牌摆上了它四张 J 的餐桌。
  //
  // 跟巨口**不能同走**：那件让大数牌改走比大小线、不再按等点数钩，
  // 于是这多出来的 11 你自己用不上，而标记照样留在牌上给庄家钩。
  // 两件都挂着是纯亏 —— 这条张力是有意留的，说明里写清楚就行
  function tollValues(card : Card, vals : number[]) : number[] {
    if (lastingTier('toll') < 0 || card.value <= BIG_VALUE) {
      return vals
    }
    for (let i = 0; i < vals.length; i++) {
      if (vals[i] == 11) {
        return vals
      }
    }
    const out : number[] = []
    for (let i = 0; i < vals.length; i++) {
      out.push(vals[i])
    }
    out.push(11)
    return out
  }

  // 明竿：每轮看得见庄家接下来几张（带顺序）。
  // 没带这件就一张也看不见 —— 它那排全是背面
  function sightOpen() : number {
    const tier = lastingTier('sight')
    return tier < 0 ? 0 : valueAt(itemAt('sight'), tier)
  }

  // 拢堆这一轮开着没有。按轮发动，不是挂着一直生效 ——
  // 「哪一轮翻地基」本身就是决策
  function tidyOn() : boolean {
    return tidyRound.value
  }

  // 顺钩：钩中时多往堆底收几张
  function alongBonus() : number {
    const tier = lastingTier('along')
    return tier < 0 ? 0 : valueAt(itemAt('along'), tier)
  }

  // 长竿：队列上多摆几张备选。打的还是五张，多出来的留到下一轮
  function rodExtra() : number {
    const tier = lastingTier('rod')
    return tier < 0 ? 0 : valueAt(itemAt('rod'), tier)
  }

  // 这一关队列摆几张（含长竿多摆的备选）
  function queueSize() : number {
    return QUEUE_SIZE + rodExtra()
  }

  // 这一轮这一方实际打几张。
  //
  // 你那边封顶五张 —— 长竿多摆的是备选，不是多打。
  // 牌库见底补不满五张时就按实际的来
  function capOf(byDealer : boolean) : number {
    if (byDealer) {
      return dealerQueue.value.length
    }
    const len = playerQueue.value.length
    return len < QUEUE_SIZE ? len : QUEUE_SIZE
  }

  // 把一组候选点数按 ±1..±span 摊开。K 再往上转回 A，A 再往下转到 K ——
  // 跟 cards.uts 里 wrapRank 一个规矩
  function spanValues(values : number[], span : number) : number[] {
    if (span <= 0) {
      return values
    }
    const out : number[] = []
    for (let i = 0; i < values.length; i++) {
      out.push(values[i])
    }
    for (let i = 0; i < values.length; i++) {
      const base = values[i]
      if (base <= 0) {
        continue
      }
      for (let d = 1; d <= span; d++) {
        out.push(((base - 1 + d) % 13) + 1)
        out.push(((base - 1 - d + 13 * 2) % 13) + 1)
      }
    }
    return out
  }

  // 点道具栏上的一件 —— **只选中并摊开说明，不当场用掉**。
  //
  // 选道具、选牌、按「使用」是三步分开的：点够张数就自动生效的话，
  // 点错一张没法反悔，只能把这一次用掉重来。
  // 分开之后选中的牌可以再点一下取消，全部选定了才按按钮
  function tapItem(index : number) {
    if (index < 0 || index >= bar.value.length) {
      return
    }
    // 再点一下同一件 = 收回这次选择
    if (barAt.value == index) {
      clearPick()
      message.value = '取消了。'
      return
    }
    const one = bar.value[index]
    barAt.value = index
    picked.value = [] as number[]
    foePicked.value = [] as number[]
    needMax.value = one.limited ? one.need : 0
    // 选道具和选待压是两码事，别让上一次的选中留着碍事
    if (one.limited) {
      sinkPicked.value = allFalse(playerQueue.value.length)
    }
    const body = itemDescAt(itemAt(one.key), one.tier)
    if (!one.limited) {
      message.value = '【' + one.name + '·' + tierName(one.tier) + '】'
        + body + ' —— 永续，带着就一直生效。'
      return
    }
    // 探口探过的那几条随时翻得出来 —— 那是你排这一轮的依据，
    // 不该用一次就找不回来
    if (one.key == 'hint' && hintLines.value.length > 0) {
      message.value = '【探口·这一轮探到的】' + joinHints(hintLines.value)
        + '（还能用 ' + one.left + ' 次）'
      return
    }
    let tip = '【' + one.name + '·' + tierName(one.tier) + '】'
      + body + ' —— 这一关还能用 ' + one.left + ' 次。'
    if (phase.value != 'plan') {
      tip = tip + '（排竿的时候才用得上）'
    } else if (one.left <= 0) {
      tip = tip + '（这一关用完了）'
    } else if (needMax.value > 0 && aimsFoe()) {
      tip = tip + '点**庄家那排**选目标，最多 ' + needMax.value
        + ' 张（背面也点得中，按它第几张打来挑），选好按「使用」。'
    } else if (needMax.value > 0) {
      tip = tip + '点牌选目标，最多 ' + needMax.value + ' 张，选好按「使用」。'
    } else {
      tip = tip + '按「使用」发动。'
    }
    message.value = tip
  }

  // 说明框右边那颗按钮上写什么。空串就不显示这颗
  const useText = computed<string>(() : string => {
    if (barAt.value < 0 || barAt.value >= bar.value.length) {
      return ''
    }
    const one = bar.value[barAt.value]
    if (!one.limited || phase.value != 'plan' || one.left <= 0) {
      return ''
    }
    return '使用'
  })

  // 按下「使用」才真的发动。
  // 要挑目标的那些，这会儿才把选中的那几张交出去
  function tapUse() {
    const index = barAt.value
    if (index < 0 || index >= bar.value.length) {
      return
    }
    const one = bar.value[index]
    if (phase.value != 'plan' || one.left <= 0) {
      clearPick()
      return
    }
    // 挑庄家那排的走另一份名单
    if (aimsFoe()) {
      if (foePicked.value.length == 0) {
        toast('先点庄家那排选目标，最多 ' + needMax.value + ' 张')
        return
      }
      fireItem(one, foePicked.value)
      return
    }
    if (needMax.value > 0 && picked.value.length == 0) {
      toast('先点牌选目标，最多 ' + needMax.value + ' 张')
      return
    }
    fireItem(one, picked.value)
  }

  // 选择态下点中了队列第 index 张：没选过就选上，选过了就取消。
  // 到上限之后再点新的会被挡住 —— 挡住比默默顶掉一张清楚
  function pickForItem(index : number) {
    if (barAt.value < 0 || needMax.value <= 0) {
      return
    }
    const next : number[] = []
    let had = false
    for (let i = 0; i < picked.value.length; i++) {
      if (picked.value[i] == index) {
        had = true
        continue
      }
      next.push(picked.value[i])
    }
    if (!had) {
      if (picked.value.length >= needMax.value) {
        toast('最多点 ' + needMax.value + ' 张，先取消一张')
        return
      }
      next.push(index)
    }
    picked.value = next
    const one = bar.value[barAt.value]
    message.value = '【' + one.name + '】已选 ' + next.length + '/' + needMax.value
      + ' 张' + (next.length > 0 ? '，按「使用」发动。' : '。点牌选目标。')
  }

  // 这一格是不是被道具瞄上了
  function isAimed(index : number) : boolean {
    if (needMax.value <= 0 || aimsFoe()) {
      return false
    }
    for (let i = 0; i < picked.value.length; i++) {
      if (picked.value[i] == index) {
        return true
      }
    }
    return false
  }

  // 这件道具挑的是庄家那排，不是你自己那排
  function aimsFoe() : boolean {
    if (barAt.value < 0 || barAt.value >= bar.value.length) {
      return false
    }
    const key = bar.value[barAt.value].key
    return key == 'peek' || key == 'still'
  }

  // 点中庄家手里第 index 张。跟 pickForItem 同一套开关逻辑，
  // 只是记在另一份名单上
  function pickFoe(index : number) {
    if (!aimsFoe() || needMax.value <= 0 || phase.value != 'plan') {
      return
    }
    if (index >= dealerHand.value.length) {
      return
    }
    const next : number[] = []
    let had = false
    for (let i = 0; i < foePicked.value.length; i++) {
      if (foePicked.value[i] == index) {
        had = true
        continue
      }
      next.push(foePicked.value[i])
    }
    if (!had) {
      if (foePicked.value.length >= needMax.value) {
        toast('最多点 ' + needMax.value + ' 张，先取消一张')
        return
      }
      next.push(index)
    }
    foePicked.value = next
    const one = bar.value[barAt.value]
    message.value = '【' + one.name + '】已选庄家第 '
      + foeOrder(next) + ' 张（共 ' + next.length + '/' + needMax.value + '）'
      + (next.length > 0 ? '，按「使用」发动。' : '。')
  }

  // 把选中的下标写成「1、3」这种人话。庄家那排是按出牌顺序摆的，
  // 所以下标加一就是「它第几张打」
  function foeOrder(list : number[]) : string {
    let text = ''
    for (let i = 0; i < list.length; i++) {
      text = text + (i > 0 ? '、' : '') + (list[i] + 1)
    }
    return text
  }

  function isFoeAimed(index : number) : boolean {
    if (needMax.value <= 0 || !aimsFoe()) {
      return false
    }
    for (let i = 0; i < foePicked.value.length; i++) {
      if (foePicked.value[i] == index) {
        return true
      }
    }
    return false
  }

  // 窥筒照亮的那几张：整轮都翻着
  function isSeen(card : Card) : boolean {
    return inList(lit, card)
  }

  // 庄家第 index 张这会儿看不看得见：明竿开的前几张，
  // 或者窥筒单独照亮的那几张
  function foeOpen(index : number, card : Card) : boolean {
    return index < dealerOpen.value || isSeen(card)
  }

  function isZeroed(card : Card) : boolean {
    return inList(zeroCards, card)
  }

  // 庄家那张牌上挂的小标。被停口废过的要看得出来 ——
  // 背面牌看不见点数，不标一下你就记不住刚才废的是哪几张
  function foeMark(index : number) : string {
    if (index >= dealerHand.value.length) {
      return ''
    }
    const card = dealerHand.value[index]
    if (isZeroed(card)) {
      return '0 点'
    }
    return isNoValue(card) ? '无点数' : ''
  }

  // 真的发动。扣次数、改牌、刷新道具栏
  function fireItem(one : BarItem, targets : number[]) {
    const data = save.value
    const item = itemAt(one.key)
    const n = valueAt(item, one.tier)
    let done = false
    let text = ''
    if (one.key == 'clear') {
      let blind = 0
      for (let i = 0; i < queueHidden.value.length; i++) {
        if (queueHidden.value[i]) {
          blind = blind + 1
        }
      }
      if (blind == 0) {
        toast('手上没有盖着的牌')
        clearPick()
        return
      }
      queueHidden.value = allFalse(playerQueue.value.length)
      done = true
      text = '【清水】照亮了 ' + blind + ' 张盖着的牌。'
    } else if (one.key == 'peek') {
      // 你点哪几张就照亮哪几张，而且**整轮都翻着** ——
      // 不再是弹一次窗看完就没。
      //
      // 挑的时候它们还盖着，所以你挑的是**位置**（它第几张打），
      // 不是牌面。于是这件道具的决策从「看不看」变成了「看哪几手」：
      // 明竿已经把最前面那张给你了，你要不要花一次窥筒去看第三、第四张？
      const got = foeCards(targets)
      if (got.length == 0) {
        toast('它手里没牌了')
        clearPick()
        return
      }
      for (let i = 0; i < got.length; i++) {
        lit.push(got[i])
      }
      done = true
      text = '【窥筒】照亮了 ' + got.length + ' 张，这一轮一直翻着。'
        + '出牌顺序要等你按「开始出牌」它才排 —— 所以你知道它手里有什么，'
        + '不知道什么时候打。'
    } else if (one.key == 'still') {
      const got = foeCards(targets)
      if (got.length == 0) {
        toast('它手里没牌了')
        clearPick()
        return
      }
      // 废成 0 点还是废成没点数，当场问 —— 这两样在这套规则里是反的，
      // 得让你按局面挑。问完才扣次数，弹窗按了取消不该白费一次
      askStill(one, got, targets)
      return
    } else if (one.key == 'steal') {
      const got = fireSteal(n)
      if (got == '') {
        clearPick()
        return
      }
      done = true
      text = '【摸底】从庄家牌组底抽走 ' + got + '，插在你牌组顶上。'
    } else if (one.key == 'lucky') {
      // 直接烧成一张幸运贴纸 —— 那张贴纸的效果就是「点数还可以按顺位 ±1 算」，
      // playOptions 现成就认，不用另写一套。
      // 排竿里你的牌一律是素牌，所以借这个字段不会盖掉别的东西
      for (let i = 0; i < targets.length; i++) {
        const card = playerQueue.value[targets[i]]
        card.stickerKey = S_LUCKY
        tweaked.push(card)
      }
      done = true
      text = '【幸运】这一轮它 ±1 都算数 —— 三个点数都留着。'
    } else if (one.key == 'hint') {
      const lines = buildHints(one.tier, n)
      if (lines.length == 0) {
        toast('它这一轮没牌了')
        clearPick()
        return
      }
      // 存住，之后点这件道具随时翻得出来。不弹窗 ——
      // 线索是你排这一轮的依据，看一眼就消失的情报没法拿来排牌
      const keep : string[] = []
      for (let i = 0; i < lines.length; i++) {
        keep.push(lines[i])
      }
      hintLines.value = keep
      done = true
      text = '【探口】' + joinHints(keep)
    } else if (one.key == 'tidy') {
      if (tidyRound.value) {
        toast('这一轮已经开着了')
        clearPick()
        return
      }
      tidyRound.value = true
      done = true
      text = '【拢堆】这一轮没钩上的牌会按点数重排 —— 堆成梯子，钩得越深收得越多。'
    } else if (one.key == 'bury') {
      for (let i = 0; i < targets.length; i++) {
        buried.push(playerQueue.value[targets[i]])
      }
      done = true
      text = '【埋饵】它打出时沉到堆底 —— 那一下不钩，换个最深的钩点留着后面收。'
    } else if (one.key == 'swallow') {
      for (let i = 0; i < targets.length; i++) {
        bigHook.push(playerQueue.value[targets[i]])
      }
      done = true
      text = '【吞口】这一轮它往回一路吞比它小的 —— 撞上不比它小的才停。'
    } else if (one.key == 'bysuit') {
      // 只记进名单，不动 forced —— 它的代价是**没有点数**，不是 0 点。
      // 「没点数」这件事由 valuesOf2 和 playOne 一起认（都查 noValue），
      // 借 forced = 0 的话它就成了 0 点，会被吞口一口吞了
      for (let i = 0; i < targets.length; i++) {
        const card = playerQueue.value[targets[i]]
        suitHook.push(card)
        noValue.push(card)
      }
      done = true
      text = '【收色】它这一轮没有点数了，只剩花色 —— '
        + '打出时把堆上所有同花色的一并收走。'
    } else if (one.key == 'tangle') {
      for (let i = 0; i < targets.length; i++) {
        const card = playerQueue.value[targets[i]]
        tangle.push(card)
        noValue.push(card)
      }
      done = true
      text = '【缠线】它这一轮没有点数了 —— 打出时把它左边那张也一起缠废，'
        + '连着两张谁也钩不动。记得让庄家那张落在它左边。'
    } else if (one.key == 'guard') {
      // 点数照旧不动 —— 挡不挡得住全看它自己多大，废了它就没法挡了
      let low = ''
      for (let i = 0; i < targets.length; i++) {
        const card = playerQueue.value[targets[i]]
        guards.push(card)
        low = low + (low == '' ? '' : '、') + faceOf(topOf(card))
      }
      done = true
      text = '【挡口】它站岗了 —— 庄家钩它左边那张时，'
        + '只要那张点数没到 ' + low + '，这一钩就收到它右边为止。'
        + '但撞的是大数（大于 ' + BIG_VALUE + '）就拦不住，一律穿过去。'
    } else if (one.key == 'ebb') {
      // 不进 noValue —— 它压的是别人，自己那张点数照旧
      for (let i = 0; i < targets.length; i++) {
        ebb.push(playerQueue.value[targets[i]])
      }
      done = true
      text = '【落潮】打出时把它左边 ' + n + ' 张全压成 0 点（没点数的也算）——'
        + '那几张从最大翻成最小，接着就靠它自己一口吞回来。'
    } else if (one.key == 'dye') {
      for (let i = 0; i < targets.length; i++) {
        const card = playerQueue.value[targets[i]]
        dye.push(card)
        noValue.push(card)
      }
      done = true
      text = '【染水】它这一轮没有点数了 —— 打出时整堆都染成它的花色。'
        + '染完再用收色，一把端走整堆；但庄家的同源也认染完的花色。'
    } else if (one.key == 'mutenum' || one.key == 'mutecolor') {
      // 挑哪一边得当场问。问完才扣次数 —— 弹窗按了取消不该白费一次
      askMute(one)
      return
    } else if (one.key == 'gather') {
      done = fireGather(targets)
      if (!done) {
        clearPick()
        return
      }
      text = '【集花】顺着花色对上了堆里最前面那张。'
    } else if (one.key == 'mark') {
      for (let i = 0; i < targets.length; i++) {
        const card = playerQueue.value[targets[i]]
        // forced 是「基础点数被改写成几点」，直接钉死 —— 不走 extra。
        // extra 是加在最终点数上的，那是坠子的路子；
        // 定标要的是「本来几点不算数」，所以必须改基础值。
        // 两件一起用就是 11 + 坠子那几点，各管各的层，不打架
        card.forced = n
        tweaked.push(card)
        // 借埋饵那套沉底：打出时进堆底、这一下不钩。
        // 定标现在不是一手收成，是往堆最深处钉一个你知道点数的钩点
        buried.push(card)
      }
      done = true
      text = '【定标】它变成 ' + n + ' 点（牌面 ' + faceOf(n) + '），打出时沉到堆底当钩点。'
        + '沉下去照样判撞 —— 堆上有对得上的就照收。'
        + '桩谁都能钩，庄家手里也有四张 ' + faceOf(n) + '，埋完记得护。'
    } else if (one.key == 'bare') {
      for (let i = 0; i < targets.length; i++) {
        const card = playerQueue.value[targets[i]]
        // 变成 0 点，不是「没有点数」—— 0 当不了钩点，
        // 但吞口那条「大于」的线照样吃得动它
        card.forced = 0
        tweaked.push(card)
      }
      done = true
      text = '【空钩】这一轮它点数变成 0 —— 钩不上人，按点数也没人钩得上它。'
        + '（吞口那条线除外，0 点是最好吞的）'
    } else if (one.key.indexOf('sink') == 0) {
      // 坠子家族六件共用这一支。indexOf == 0 而不是 substring ——
      // 后者在 Kotlin 那边的重载跟 JS 对不齐，前者两边都一个意思
      for (let i = 0; i < targets.length; i++) {
        const card = playerQueue.value[targets[i]]
        card.extra = card.extra + n
        tweaked.push(card)
      }
      done = true
      text = '【' + one.name + '】这一轮 +' + n + '。'
    } else if (one.key.indexOf('lift') == 0) {
      for (let i = 0; i < targets.length; i++) {
        const card = playerQueue.value[targets[i]]
        card.extra = card.extra - n
        tweaked.push(card)
      }
      done = true
      text = '【' + one.name + '】这一轮 −' + n + '。'
    }
    if (!done) {
      clearPick()
      return
    }
    if (!spendUse(data, one.key)) {
      clearPick()
      return
    }
    saveCurrent(data)
    save.value = cloneSave(data)
    // 牌面上的数字跟着变：改的是数组里的对象，引用没变，
    // 不换个新数组推一下视图不会更新
    pushQueue()
    buildBar()
    message.value = text
  }

  function clearPick() {
    barAt.value = -1
    needMax.value = 0
    picked.value = [] as number[]
    foePicked.value = [] as number[]
  }

  // 把「庄家手里第几张」这组下标换成真正的牌。
  // dealerHand 是从 dealerStep 往后数的，所以下标要加上这个偏移
  function foeCards(targets : number[]) : Card[] {
    const out : Card[] = []
    for (let i = 0; i < targets.length; i++) {
      const at = dealerStep.value + targets[i]
      if (at >= 0 && at < dealerQueue.value.length) {
        out.push(dealerQueue.value[at])
      }
    }
    return out
  }

  // 停口：废成 0 点还是废成没点数，当场问。
  //
  // 这两样在这套规则里是**反的**，所以不能替玩家定：
  //   0 点 —— 什么都比它大，是你吞口、巨口的口粮；
  //   没点数 —— 什么都不比它大，是一道谁也动不了的墙。
  // 走大数那一路的要粮，想封路的要墙，同一件道具两种用法
  function askStill(one : BarItem, cards : Card[], targets : number[]) {
    uni.showModal({
      title: one.name,
      content: '把庄家第 ' + foeOrder(targets) + ' 张废成哪一种？\n\n'
        + '【变 0 点】什么都比它大 —— 它钩不上人，而且是你吞口、巨口的口粮。\n'
        + '【失去点数】什么都不比它大 —— 它钩不上人，也没人钩得动它，堆上立一道墙。',
      confirmText: '变 0 点',
      cancelText: '失去点数',
      success: (res) => {
        fireStill(one, cards, targets, res.confirm)
      }
    })
  }

  function fireStill(one : BarItem, cards : Card[], targets : number[], zero : boolean) {
    const data = save.value
    if (!spendUse(data, one.key)) {
      clearPick()
      return
    }
    for (let i = 0; i < cards.length; i++) {
      if (zero) {
        zeroCards.push(cards[i])
      } else {
        noValue.push(cards[i])
      }
    }
    saveCurrent(data)
    save.value = cloneSave(data)
    pushQueue()
    buildBar()
    clearPick()
    message.value = '【停口】庄家第 ' + foeOrder(targets) + ' 张'
      + (zero
        ? '变成 0 点 —— 它钩不上人，落堆之后是你吞口的口粮。'
        : '失去点数 —— 它钩不上人，也没人钩得动，落堆就是一道墙。')
  }

  // 断数 / 断色：先问断哪一边，选完才真的发动。
  //
  // 扣次数放在选完之后 —— 弹窗里按了取消不该白费一次。
  // 一轮只认一个断口：后断的顶掉先断的，不叠加
  function askMute(one : BarItem) {
    const isColor = one.key == 'mutecolor'
    const first = isColor ? MUTE_RED : MUTE_ODD
    const second = isColor ? MUTE_BLACK : MUTE_EVEN
    // 两件的措辞不能共用 —— 它们不是同一个效果：
    // 断数变成 0 点（什么都比它大，吞口一口吞一片），
    // 断色失去点数（什么都不比它大，吞口撞上就停）
    const body = isColor
      ? '这一轮双方打出的哪一类**失去点数**？\n\n'
        + '（不是 0 点，是压根没有点数 —— 比大小时当最大，吞口吞不动。'
        + '花色还在，收色、集花照样够得着）'
      : '这一轮双方打出的哪一类**变成 0 点**？\n\n'
        + '（什么都比它大 —— 吞口能一口吞一整片。'
        + '花色还在，收色、集花照样够得着）'
    uni.showModal({
      title: one.name,
      content: body,
      confirmText: muteName(first),
      cancelText: muteName(second),
      success: (res) => {
        fireMute(one, res.confirm ? first : second)
      }
    })
  }

  function fireMute(one : BarItem, kind : number) {
    const data = save.value
    if (!spendUse(data, one.key)) {
      clearPick()
      return
    }
    muteKind = kind
    saveCurrent(data)
    save.value = cloneSave(data)
    pushQueue()
    buildBar()
    clearPick()
    message.value = kind == MUTE_RED || kind == MUTE_BLACK
      ? '【' + one.name + '】这一轮' + muteName(kind)
        + '牌一律失去点数 —— 不是 0 点，是没有点数，比大小时最大，吞口吞不动。花色还在。'
      : '【' + one.name + '】这一轮' + muteName(kind)
        + '牌一律变成 0 点 —— 什么都比它大，吞口一口能吞一片。花色还在。'
  }

  // 探口：攒一把关于庄家这一轮手牌的实话，随机挑几条给出去。
  //
  // 给的是**结构**不是清单 —— 知道「它有对子」，你就得防它把那对
  // 拆开夹你；具体哪一对还得自己盯着堆上推。
  // 全是真话，没有误导项：这游戏的信息已经够少了，
  // 再掺假话就不是「算」而是「猜」了
  // 线索按档分池：**升级换来的不只是条数，更是质量**。
  //
  // 四条「有几张红牌」堆在一起还是四条废话 —— 粗线索再多也推不出东西。
  // 所以低档给的是笼统的计数，高档给的是能直接改排法的实话：
  //
  //   普通 —— 大于 7 几张、奇数几张、红牌几张。只够估个成色。
  //   稀有 —— 有没有对子、最大的一张是几点。开始有结构了：
  //           知道它有对子，你就得防它把那对拆开夹你。
  //   史诗 —— 最小的一张、**跟你队列配得上对的有几张**。
  //           最后这条最狠：它直接告诉你，你排的那几手会不会被截。
  //   传说 —— 它手里某个具体点数有几张。接近点名了。
  //
  // 一律真话，没有误导项 —— 这游戏信息本来就少，掺假就不是算是猜了
  function buildHints(tier : number, want : number) : string[] {
    const hand : Card[] = []
    for (let i = dealerStep.value; i < dealerQueue.value.length; i++) {
      hand.push(dealerQueue.value[i])
    }
    if (hand.length == 0) {
      return [] as string[]
    }
    const pool : string[] = []
    let big = 0
    let odd = 0
    let red = 0
    for (let i = 0; i < hand.length; i++) {
      const v = firstValue(hand[i])
      if (v > 7) {
        big = big + 1
      }
      if (v % 2 == 1) {
        odd = odd + 1
      }
      if (isRed(hand[i])) {
        red = red + 1
      }
    }
    pool.push('手里有 ' + big + ' 张大于 7 的')
    pool.push('手里有 ' + odd + ' 张奇数牌')
    pool.push('手里有 ' + red + ' 张红牌')
    if (tier >= 1) {
      pool.push(hasPair(hand) ? '手里有对子' : '手里没有对子')
      pool.push('最大的一张是 ' + faceOf(topValue(hand)) + ' 点')
    }
    if (tier >= 2) {
      pool.push('最小的一张是 ' + faceOf(lowestValue(hand)) + ' 点')
      pool.push('有 ' + matchCount(hand) + ' 张跟你现在排的这几手配得上对')
    }
    if (tier >= 3) {
      const pick = hand[Math.floor(Math.random() * hand.length)]
      const v = firstValue(pick)
      pool.push('手里的 ' + faceOf(v) + ' 有 ' + countOfValue(hand, v) + ' 张')
    }
    // 随机抽 want 条，抽过的不再抽。
    // 高档池子大，所以抽到好线索的机会本身也高了一截
    const out : string[] = []
    const used : boolean[] = []
    for (let i = 0; i < pool.length; i++) {
      used.push(false)
    }
    let left = want
    if (left > pool.length) {
      left = pool.length
    }
    let guard = 0
    while (out.length < left && guard < 200) {
      guard = guard + 1
      const at = Math.floor(Math.random() * pool.length)
      if (used[at]) {
        continue
      }
      used[at] = true
      out.push(pool[at])
    }
    return out
  }

  function firstValue(card : Card) : number {
    const vals = valuesOf2(card)
    return vals.length > 0 ? vals[0] : 0
  }

  function lowestValue(hand : Card[]) : number {
    let low = 99
    for (let i = 0; i < hand.length; i++) {
      const v = firstValue(hand[i])
      if (v > 0 && v < low) {
        low = v
      }
    }
    return low == 99 ? 0 : low
  }

  function countOfValue(hand : Card[], worth : number) : number {
    let n = 0
    for (let i = 0; i < hand.length; i++) {
      if (firstValue(hand[i]) == worth) {
        n = n + 1
      }
    }
    return n
  }

  // 它手里有几张能跟你队列里的牌配上对。
  //
  // 这条是史诗档最值钱的一句：它直接回答「我排的这几手会不会被截」——
  // 你靠一对 8 去钩，它手里正好也有 8，那一对多半保不住
  function matchCount(hand : Card[]) : number {
    let n = 0
    for (let i = 0; i < hand.length; i++) {
      const theirs = valuesOf2(hand[i])
      for (let k = 0; k < playerQueue.value.length; k++) {
        if (shareValue(theirs, valuesOf2(playerQueue.value[k]))) {
          n = n + 1
          break
        }
      }
    }
    return n
  }

  // 原先这儿有个 sortByValue：把庄家的牌按点数重排再摊给玩家看，
  // 免得连出牌顺序一起泄露。窥筒改成「点哪张照亮哪张、就地翻开」之后
  // 没人调它了 —— 新的窥筒本来就是按位置挑的，顺序是它卖的东西之一。

  // 几条线索拼成一句。说明框就一行，用顿号接比换行省地方
  function joinHints(lines : string[]) : string {
    let text = ''
    for (let i = 0; i < lines.length; i++) {
      text = text + (i > 0 ? '；' : '') + lines[i]
    }
    return text + '。'
  }

  function hasPair(hand : Card[]) : boolean {
    for (let i = 0; i < hand.length; i++) {
      for (let k = i + 1; k < hand.length; k++) {
        if (shareValue(valuesOf2(hand[i]), valuesOf2(hand[k]))) {
          return true
        }
      }
    }
    return false
  }

  function topValue(hand : Card[]) : number {
    let top = 0
    for (let i = 0; i < hand.length; i++) {
      const vals = valuesOf2(hand[i])
      for (let k = 0; k < vals.length; k++) {
        if (vals[k] > top) {
          top = vals[k]
        }
      }
    }
    return top
  }

  // 集花：把选中的牌的点数，改成「堆里最前面那张同花色的牌」的点数。
  //
  // 堆底就是最前面，钩中那儿等于把整堆一路端走 ——
  // 所以这件不是「加几点」，是指定一次深钩。
  //
  // 用 forced 而不是 extra：它是直接顶掉原来的点数，不是在原来的数上加。
  // 背面牌没有花色（pileSuitOf 返回空串），所以够不着它们 ——
  // 落沙那类埋在堆底的死牌挡不住集花，但也不会被它误认
  function fireGather(targets : number[]) : boolean {
    if (pile.value.length == 0) {
      toast('堆是空的，集花没处对')
      return false
    }
    let hit = 0
    for (let i = 0; i < targets.length; i++) {
      const card = playerQueue.value[targets[i]]
      const worth = frontSuitValue(card.suit)
      if (worth < 0) {
        continue
      }
      card.forced = worth
      tweaked.push(card)
      hit = hit + 1
    }
    if (hit == 0) {
      toast('堆里没有同花色的牌')
      return false
    }
    return true
  }

  // 堆里最前面那张这个花色的牌算几点。没有就返回 -1
  function frontSuitValue(suit : string) : number {
    for (let i = 0; i < pile.value.length; i++) {
      // 并色之后方块也对得上红心 —— 堆上能对的牌翻倍，
      // 集花从「看堆里有没有」变成「基本对得上」
      if (!suitAlike(pileSuitOf(pile.value[i]), suit)) {
        continue
      }
      const vals = valuesOf(pile.value[i])
      for (let k = 0; k < vals.length; k++) {
        if (vals[k] > 0) {
          return vals[k]
        }
      }
    }
    return -1
  }

  // 摸底：从庄家牌组底抽 want 张，插进自己牌组顶（playerCursor 那个位置，
  // 下一次抽牌就是它们）。返回抽到的牌面，抽不着返回空串。
  //
  // 「底」是数组末尾。只能抽它还没打出去的那一段（下标 >= dealerCursor）——
  // 已经打过的那些在堆上或者收获里，不在牌组里了
  // 拷一张干净的：贴纸撕掉，点数派生的那几个字段也一并归位 ——
  // 庄家那张可能被它自己的贴纸改过点数，不清的话偷过来还带着
  function stripSticker(origin : Card) : Card {
    const one = cloneCard(origin)
    one.stickerKey = S_NONE
    one.forced = -1
    one.extra = 0
    one.altValue = -1
    one.negated = false
    one.faceDown = false
    one.pileValue = -1
    one.pileValues = [] as number[]
    return one
  }

  function fireSteal(want : number) : string {
    const deck = dealerDeck.value
    const left = deck.length - dealerCursor
    if (left <= 0) {
      toast('庄家牌组空了，没得摸')
      return ''
    }
    let take = want
    if (take > left) {
      take = left
    }
    const got : Card[] = []
    const rest : Card[] = []
    for (let i = 0; i < deck.length - take; i++) {
      rest.push(deck[i])
    }
    for (let i = deck.length - take; i < deck.length; i++) {
      got.push(deck[i])
    }
    dealerDeck.value = rest
    // 插在自己牌组顶：cursor 指的就是「下一张要摸的」，插在那儿最快见效。
    //
    // 贴纸要撕掉：庄家那半副是按关卡配置贴过的，连贴纸一起偷过来
    // 等于白捡一份战力，而你这边的牌一律是素牌 —— 破了那条规矩，
    // 后面「你的牌是干净的」这个前提就不成立了
    const mine = playerDeck.value
    const next : Card[] = []
    for (let i = 0; i < mine.length; i++) {
      if (i == playerCursor.value) {
        for (let k = 0; k < got.length; k++) {
          next.push(stripSticker(got[k]))
        }
      }
      next.push(mine[i])
    }
    // cursor 已经走到末尾的话上面那个循环插不进去，补在后面
    if (playerCursor.value >= mine.length) {
      for (let k = 0; k < got.length; k++) {
        next.push(stripSticker(got[k]))
      }
    }
    playerDeck.value = next
    let names = ''
    for (let i = 0; i < got.length; i++) {
      if (i > 0) {
        names = names + '、'
      }
      names = names + got[i].suit + rankText(got[i])
    }
    return names
  }


  // 把队列换个新数组推一下视图。
  // 道具改的是数组里的牌对象，引用没变，不换数组牌面不会更新
  function pushQueue() {
    const cards : Card[] = []
    for (let i = 0; i < playerQueue.value.length; i++) {
      cards.push(playerQueue.value[i])
    }
    playerQueue.value = cards
  }

  // 道具改过的那几张，改动到这一轮为止。
  // stickerKey 也要抹 —— 幸运是烧成贴纸实现的，
  // 排竿里你的牌一律是素牌，所以抹回 S_NONE 不会误伤
  function clearTweaks() {
    for (let i = 0; i < tweaked.length; i++) {
      tweaked[i].extra = 0
      tweaked[i].forced = -1
      tweaked[i].stickerKey = S_NONE
    }
    tweaked = [] as Card[]
    suitHook = [] as Card[]
    bigHook = [] as Card[]
    noValue = [] as Card[]
    // 窥筒照亮的、停口废掉的都只管这一轮 ——
    // 下一轮庄家换一手牌，这两份名单里的牌早打出去了
    lit = [] as Card[]
    zeroCards = [] as Card[]
    tangle = [] as Card[]
    dye = [] as Card[]
    ebb = [] as Card[]
    buried = [] as Card[]
    muteKind = MUTE_NONE
  }

  // 拢堆：没钩上的时候把堆按点数从大到小重排 —— 大的沉底，小的浮顶。
  //
  // **这是道具效果，不是基础规则。** 基础规则里堆就是出牌顺序，
  // 「你相邻两张之间夹着它一张、配对就把中间那张一并收走」全靠这个顺序。
  // 无条件重排会把那条机制整个废掉，所以它得是你花钱买来的一条新规矩。
  //
  // 带上之后堆变成一道梯子：钩中下面那张大牌，它上面所有更小的一并归你。
  // 于是玩法从「算夹了谁」变成「算深浅」—— 这是另一种打法，
  // 愿意换的人自己换。
  //
  // 普通档只排本轮打出的，跨轮的记忆留着：上几轮没被收走的沉在底下不动。
  // 升一级才连整堆一起排。
  //
  // 埋饵埋下去的永远不参与，钉在最底下 —— 那件买的就是这个位置，
  // 让它跟着排序浮上去等于没埋
  function sortPile() {
    const pinned : Card[] = []
    const pinFlags : boolean[] = []
    const older : Card[] = []
    const olderFlags : boolean[] = []
    const loose : Card[] = []
    const looseFlags : boolean[] = []
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      const from = i < pileFromDealer.value.length ? pileFromDealer.value[i] : false
      if (isBuried(one)) {
        pinned.push(one)
        pinFlags.push(from)
      } else if (!isThisRound(one)) {
        older.push(one)
        olderFlags.push(from)
      } else {
        loose.push(one)
        looseFlags.push(from)
      }
    }
    // 插入排序，点数大的排前面。一轮最多十来张，够用了。
    // 两个数组得一起搬 —— pileFromDealer 是按下标对位的，散了就认不出谁打的
    for (let i = 1; i < loose.length; i++) {
      const card = loose[i]
      const flag = looseFlags[i]
      // 用 sizeOf：断色废掉的那几张没有点数，比大小时最大，
      // 所以它们沉到堆最底下 —— 谁也钩不动，正好当一层垫底
      const key = sizeOf(card)
      let k = i - 1
      while (k >= 0 && sizeOf(loose[k]) < key) {
        loose[k + 1] = loose[k]
        looseFlags[k + 1] = looseFlags[k]
        k = k - 1
      }
      loose[k + 1] = card
      looseFlags[k + 1] = flag
    }
    // 堆自下而上：埋下去的、上几轮剩的、这一轮排好的
    const cards : Card[] = []
    const flags : boolean[] = []
    for (let i = 0; i < pinned.length; i++) {
      cards.push(pinned[i])
      flags.push(pinFlags[i])
    }
    for (let i = 0; i < older.length; i++) {
      cards.push(older[i])
      flags.push(olderFlags[i])
    }
    for (let i = 0; i < loose.length; i++) {
      cards.push(loose[i])
      flags.push(looseFlags[i])
    }
    pile.value = cards
    pileFromDealer.value = flags
  }

  function isThisRound(card : Card) : boolean {
    for (let i = 0; i < roundCards.length; i++) {
      if (roundCards[i] == card) {
        return true
      }
    }
    return false
  }

  function isBuried(card : Card) : boolean {
    for (let i = 0; i < buried.length; i++) {
      if (buried[i] == card) {
        return true
      }
    }
    return false
  }

  // 往堆底插一张。堆是个数组，0 是底 —— 所以是往头上插，不是往尾上推
  function unshiftCard(list : Card[], card : Card) : Card[] {
    const next : Card[] = []
    next.push(card)
    for (let i = 0; i < list.length; i++) {
      next.push(list[i])
    }
    return next
  }

  function unshiftFlag(list : boolean[], flag : boolean) : boolean[] {
    const next : boolean[] = []
    next.push(flag)
    for (let i = 0; i < list.length; i++) {
      next.push(list[i])
    }
    return next
  }

  function isBigHook(card : Card) : boolean {
    for (let i = 0; i < bigHook.length; i++) {
      if (bigHook[i] == card) {
        return true
      }
    }
    return false
  }

  // 比大小的时候这张算多大。
  //
  // **没有点数的牌一律算最大** —— 不管点数是怎么没的：收色、断色、
  // 空位贴纸、压冠、锁花、封位掐掉的那一张，全一个待遇。
  //
  // 「没有点数」和「点数是 0」是两回事，这是这套规则的分界线：
  //   0 点 —— 有点数，只是这个数最小。什么都比它大，吞口一口吞一片。
  //           空钩（forced = 0）和**断数**是这一类。
  //   没点数 —— 压根没有这个属性。没有属性就没法比，那就什么都不比它大。
  //           收色是这一类：它拿整个点数换一次按花色的散收，
  //           换出去之后那张牌在点数这条轴上就不存在了，连吞口也够不着。
  //
  // 判据直接是「valuesOf 返回空」，不另记名单：牌一旦是没点数地落进堆，
  // pileValues 从那一刻起就是空的、再也不会重算，所以这个判据天然
  // 跟着牌走而不是跟着轮走 —— 同一张牌不会这一轮吞不动、下一轮又吞得动。
  //
  // 跟 topOf 分开是因为方向不同：topOf 是「我这张能拿出多大的数去比」，
  // 没有点数就是拿不出数，该返回 0（吞口那边正好靠这个判出「它钩不了人」）；
  // sizeOf 是「别人拿多大的数来跟我比」，没有点数就是谁也够不着。
  // 一个函数兼两头的话，一张没点数的牌会变成「既钩得动所有人、
  // 又谁都钩不动」的怪物
  const SIZE_TOP : number = 99

  function sizeOf(card : Card) : number {
    return valuesOf(card).length == 0 ? SIZE_TOP : topOf(card)
  }

  // 这张算得出来的最大那个数。比大小一律用最大值 ——
  // 两边都用同一个口径，不然「谁比谁大」这件事自己就说不圆
  function topOf(card : Card) : number {
    const vals = valuesOf(card)
    let top = 0
    for (let i = 0; i < vals.length; i++) {
      if (vals[i] > top) {
        top = vals[i]
      }
    }
    return top
  }

  // 吞口钩到堆里第几位：从紧挨着自己的那张往回数，
  // 一路吞比自己小的，撞上不比自己小的就停。
  //
  // 一张都没吞到就不算钩中 —— 只收回自己那张不是「收牌」。
  //
  // 跟断口那两件的联动现在分成两头：
  //   断数哑掉的是 0 点，什么都比它大 —— 一整片正好一口吞了；
  //   断色废掉的是没有点数，什么都不比它大 —— 撞上就停，一张也吞不动。
  // 所以断数是给吞口开路的，断色是拿来挡吞口的
  function pileIndexOfSwallow(card : Card) : number {
    // 自己这一张用 topOf 不用 sizeOf：这儿问的是「我能拿多大的数去比」。
    // 没有点数就是拿不出数，下面 mine <= 0 直接判它钩不了人 ——
    // 换成 sizeOf 的话，一张被断色废掉的牌反倒会把整堆吞光
    const mine = topOf(card)
    const last = pile.value.length - 1
    if (mine <= 0 || last <= 0) {
      return -1
    }
    let at = last
    let i = last - 1
    while (i >= 0 && sizeOf(pile.value[i]) < mine) {
      at = i
      i = i - 1
    }
    return at >= last ? -1 : at
  }

  // 这张这一轮按花色钩吗
  function isSuitHook(card : Card) : boolean {
    return inList(suitHook, card)
  }

  // 这张这一轮被你主动废掉点数了吗（收色、缠线、染水）
  function isNoValue(card : Card) : boolean {
    return inList(noValue, card)
  }

  function isTangle(card : Card) : boolean {
    return inList(tangle, card)
  }

  function isDye(card : Card) : boolean {
    return inList(dye, card)
  }

  function isEbb(card : Card) : boolean {
    return inList(ebb, card)
  }

  function isGuard(card : Card) : boolean {
    return inList(guards, card)
  }

  // 这一张挡口拦不拦得住被钩的那张。**两条都得成立**：
  //
  //   一、被钩那张的点数**没有挡口大** —— 岗哨得压得住它守的东西。
  //       拿一张 3 去挡，只护得住 3 以下。
  //   二、被钩那张**不是大数**（不大于 10）——
  //       撞的是 J、Q、K 的话，挡口再大也拦不住，一律穿过去。
  //
  // 第二条是这件道具的天花板，也是它的定位：**大钩点拦不住**。
  // 堆底埋着的那根 11 的桩、堆里那张 K，本来就是全场最肥的目标，
  // 谁都盯着；这件道具管得了零碎，管不了那个。
  // 想护大数得另想办法，或者干脆接受「埋大桩就是高风险高回报」。
  //
  // 两条一叠，挡口守的其实是**小牌堆出来的那一段**：
  // 挡口自己越大守得越宽，但上限钉死在 10。
  //
  // 用 topOf 不用 sizeOf：这儿比的是**点数**，
  // 而没点数的牌压根没有点数，当然算不上「比它大」，第一条自然成立
  function guardBlocks(target : Card, one : Card) : boolean {
    const v = topOf(target)
    return v <= topOf(one) && v <= BIG_VALUE
  }

  // 挡口拦下来之后，这一钩改从哪儿起收。拦不住就返回 -1 ——
  // 收到挡口右边为止，挡口和它护的那张都留下
  function guardedStart(at : number) : number {
    let now = at
    let step = 0
    // 叠了好几道岗哨就一道道往上让。给个上限纯粹是防呆
    while (step < 8) {
      step = step + 1
      const next = now + 1
      if (next >= pile.value.length) {
        break
      }
      const one = pile.value[next]
      if (!isGuard(one) || !guardBlocks(pile.value[now], one)) {
        break
      }
      now = next + 1
      if (now >= pile.value.length) {
        break
      }
    }
    return now == at ? -1 : now
  }

  // 落潮压平左边几张。同名只有一件，所以这一关的档位是定死的，
  // 落堆那会儿现查就行，不用跟着牌记一份
  function ebbSpan() : number {
    const tier = itemTierOf(save.value, 'ebb')
    return tier < 0 ? 0 : valueAt(itemAt('ebb'), tier)
  }

  function inList(list : Card[], card : Card) : boolean {
    for (let i = 0; i < list.length; i++) {
      if (list[i] == card) {
        return true
      }
    }
    return false
  }

  // 这张这一轮被断口哑掉了吗。
  // 看的是牌面本来的点数和花色 —— 断的是「这一类牌」，
  // 不是「算出来正好是这个数的牌」，不然道具改过点数就能绕开
  function isMuted(card : Card) : boolean {
    if (muteKind == MUTE_NONE) {
      return false
    }
    if (muteKind == MUTE_RED) {
      return isRed(card)
    }
    if (muteKind == MUTE_BLACK) {
      return !isRed(card)
    }
    const odd = card.value % 2 == 1
    return muteKind == MUTE_ODD ? odd : !odd
  }

  // 这张是被**断数**哑掉的吗。断数给 0 点，断色给「没点数」，
  // 落堆那边靠它分流
  function isNumMuted(card : Card) : boolean {
    if (muteKind != MUTE_ODD && muteKind != MUTE_EVEN) {
      return false
    }
    return isMuted(card)
  }

  function muteName(kind : number) : string {
    if (kind == MUTE_ODD) {
      return '奇数'
    }
    if (kind == MUTE_EVEN) {
      return '偶数'
    }
    if (kind == MUTE_RED) {
      return '红色'
    }
    return '黑色'
  }

  // ---------- 自动出牌 ----------

  function startPlay() {
    if (phase.value != 'plan') {
      return
    }
    // 压牌动画还没走完就开打，牌会飞一半停在半空
    if (sinking.value.length > 0 || dealing.value.length > 0) {
      return
    }
    phase.value = 'play'
    // 到这一刻庄家才排它的出牌顺序 —— 你排完了，它才排
    settleDealer()
    // step 由 startRound 置 0，这儿不用再动 ——
    // 第 0 步就是庄家那第一张，手牌区一直亮着的就是它
    resetDrag()
    clearPick()
    sinkPicked.value = allFalse(playerQueue.value.length)
    message.value = '排定了。'
    stepTimer = setTimeout(playStep, paceOf(STEP_DELAY))
  }

  function playStep() {
    stepTimer = -1
    if (phase.value != 'play') {
      return
    }
    if (step.value >= roundSteps()) {
      endRound()
      return
    }
    // 庄家先手：偶数步是它，奇数步是你。step 0 就是它那第一张 ——
    // 从前这一张在排序之前就打掉了，现在留到这儿跟别的张一起演
    let byDealer : boolean = step.value % 2 == 0
    let at : number = Math.floor(step.value / 2)
    let queue : Card[] = byDealer ? dealerQueue.value : playerQueue.value
    // 这一方这一轮该打的都打完了就跳过它这一步，让另一方接着打。
    //
    // 判的是 capOf 不是队列长度 —— 长竿在你队列尾巴上多摆的那几张
    // 这一轮轮不到打，是留到下一轮的备选。
    //
    // 不能在这儿收摊：一方先出完之后，剩下那方得把自己的牌连着打完，
    // 而那几张中间没有对手插进来 —— 堆上全是自己的牌加残留，能连着钩。
    // 空步要一次跳干净，一步一个 setTimeout 的话，对手空了五步
    // 就得干等一秒多
    while (at >= capOf(byDealer)) {
      step.value = step.value + 1
      if (step.value >= roundSteps()) {
        endRound()
        return
      }
      byDealer = step.value % 2 == 0
      at = Math.floor(step.value / 2)
      queue = byDealer ? dealerQueue.value : playerQueue.value
    }
    // 盲牌打出去就翻开 —— 队列上那张也得跟着亮，
    // 不然演完一轮你都不知道自己刚才压出来的是什么
    if (!byDealer) {
      revealAt(at)
    }
    const took = playOne(byDealer, queue[at])
    step.value = step.value + 1
    // 钩中了就走那条长链：亮一拍 → 缩着飞向比分 → 比分跳 → 再继续
    if (took) {
      stepTimer = setTimeout(startFly, paceOf(CATCH_HOLD))
      return
    }
    stepTimer = setTimeout(nextOrEnd, paceOf(STEP_DELAY))
  }

  // 亮够了：给这一段每张牌做个替身摆在原位，原牌就地隐形。
  // 替身先不动，下一拍才放开 —— 一上来就是终点态的话没有过渡可言
  function startFly() {
    stepTimer = -1
    const list : FlyOne[] = []
    for (let i = 0; i < pile.value.length; i++) {
      if (i < catchMarks.value.length && catchMarks.value[i]) {
        list.push({ card: pile.value[i], x: boardX(i), y: boardY(i) } as FlyOne)
      }
    }
    flyCards.value = list
    flyGo.value = false
    flyOn.value = true
    popTimer = setTimeout(releaseFly, 32)
    stepTimer = setTimeout(landFly, paceOf(FLY_TIME))
  }

  function releaseFly() {
    popTimer = -1
    flyGo.value = true
  }

  // 飞到了：替身撤掉，牌真的进收获堆，比分跳一下
  function landFly() {
    stepTimer = -1
    flyOn.value = false
    flyGo.value = false
    flyCards.value = [] as FlyOne[]
    harvest(pendingBy, pendingMarks)
    popBy.value = pendingBy ? 1 : 0
    popGain.value = pendingCount
    popIn.value = false
    pendingMarks = [] as boolean[]
    pendingCount = 0
    // 先摆成没跳的样子，下一拍再翻开关，transition 才有得过渡
    popTimer = setTimeout(popStep, 32)
    stepTimer = setTimeout(nextOrEnd, paceOf(POP_HOLD))
  }

  function popStep() {
    popTimer = setTimeout(popEnd, paceOf(POP_HOLD - 120))
    popIn.value = true
  }

  function popEnd() {
    popTimer = -1
    popIn.value = false
    popBy.value = -1
    popGain.value = 0
  }

  function nextOrEnd() {
    stepTimer = -1
    if (step.value >= roundSteps()) {
      endRound()
      return
    }
    playStep()
  }

  function revealAt(index : number) {
    if (index >= queueHidden.value.length || !queueHidden.value[index]) {
      return
    }
    const next : boolean[] = []
    for (let i = 0; i < queueHidden.value.length; i++) {
      next.push(i == index ? false : queueHidden.value[i])
    }
    queueHidden.value = next
  }

  // 打一张下去，返回这一下有没有收到牌
  function playOne(byDealer : boolean, card : Card) : boolean {
    card.faceDown = false
    // 这是你这一轮的第几张。封位掐的是每轮你的第一张，
    // 而那个判断在下面算候选点数的时候就要用 ——
    // 所以得在这儿取，不能等到落堆那一段再声明
    const myPlayed = byDealer ? -1 : playedMine
    // 空位类落堆没有点数：钩不上别人，也没人钩得上它。
    // 断口哑掉的那一类同样走这条 —— 点数没了，但**花色还在**，
    // 所以收色、集花照样够得着，只按点数钩的人够不着。
    // 压冠、锁花废掉的你那几张也一样：点数没了，花色留着，
    // 所以集花那条路还能把它们救回来
    if (isNoValue(card)) {
      // 收色、缠线、染水：**没有点数**，只剩花色。排在断数前面 ——
      // 这是你主动挑的一张，庄家的规矩压不过它；
      // 真让断数把它改成 0 点，它反倒会被吞口一口吞了
      card.pileValues = [] as number[]
      card.pileValue = NO_VALUE
    } else if (isZeroed(card) || isNumMuted(card)) {
      // 停口选了「变 0 点」的那几张，跟断数走同一支。
      //
      // 0 点不是没点数 —— 0 是个实打实的点数，
      // 只是最小：什么都比它大，所以吞口一口能吞一整片。
      // 断色那件才是没点数（走下面那一支，比大小时当最大）。
      // 两件断口的分野全在这儿
      card.pileValues = [0] as number[]
      card.pileValue = 0
    } else if (isBlankSticker(card.stickerKey) || isMuted(card)
      || (!byDealer && ruledDead(card))) {
      card.pileValues = [] as number[]
      card.pileValue = NO_VALUE
    } else {
      let vals = playOptions(card)
      if (byDealer) {
        // 长手：它的牌还可以按 ±N 算。N 是这一关摇出来的 1 或 2
        if (reachSpan.value > 0) {
          vals = spanValues(vals, reachSpan.value)
        }
        // 百搭：摇中那个点数当任意点数用 —— 一到十三全给它
        if (wildRank.value > 0 && card.value == wildRank.value) {
          const all : number[] = []
          for (let v = 1; v <= 13; v++) {
            all.push(v)
          }
          vals = all
        }
      } else {
        // 归标：大数牌多带一个 11。摆在钝钩**之前** ——
        // 钝钩说的是「只留最小的那个候选」，那就该对着完整的候选表来算。
        // 于是一张 K 在钝钩底下剩的是 11 而不是 13：
        // 本来的点数被掐了，桩还够得着。这一条对 11 流几乎不疼，
        // 对拿归标配别的打法的人才是真损失
        vals = tollValues(card, vals)
        // 钝钩：只留最小的那个候选 —— 幸运、归标多给的那几条路全掐掉
        if (hasRule('blunt') && vals.length > 1) {
          let low = vals[0]
          for (let i = 1; i < vals.length; i++) {
            if (vals[i] < low) {
              low = vals[i]
            }
          }
          vals = [low] as number[]
        }
      }
      // 同源：庄家的牌跟堆顶同花色时，点数直接算成跟堆顶一样。
      // 它等于白送一次钩中，所以只给庄家
      if (byDealer && hasRule('akin') && pile.value.length > 0) {
        const top = pile.value[pile.value.length - 1]
        if (top != card && pileSuitOf(top) == card.suit) {
          const tv = valuesOf(top)
          if (tv.length > 0) {
            vals = tv
          }
        }
      }
      // 封位：你每轮打出的第一张不算钩点
      if (!byDealer && hasRule('mute1') && myPlayed == 0) {
        vals = [] as number[]
      }
      // 出口上夹一道：提子减下去的牌到 0 为止，不留负数
      card.pileValues = noNegative(vals)
      card.pileValue = vals.length > 0 ? 0 : NO_VALUE
    }
    const who = byDealer ? '庄家' : '你'
    // 记一笔「这张是这一轮打的」，重排时只动这些。
    // 你这边还要数是第几张 —— 封位那条规矩掐的是每轮你的第一张
    roundCards.push(card)
    if (!byDealer) {
      playedMine = playedMine + 1
    }
    // 埋饵、定标：落进**堆底**而不是堆顶。
    //
    // **沉底不等于不钩。** 这一条是基础规则：堆上有对子就一定要钩，
    // 没有「这一下我不钩」这种选择。所以沉下去之后照样判一次撞 ——
    // 撞上了照收，只是收法不一样（见下面 sank 那一支）。
    //
    // 换来的是堆最深处的一个钩点：后面拿张同点数的来收，
    // 从那儿一路端到手上，整堆全归你
    const sank = isBuried(card)
    if (sank) {
      pile.value = unshiftCard(pile.value, card)
      pileFromDealer.value = unshiftFlag(pileFromDealer.value, byDealer)
    } else {
      pile.value = pushCard(pile.value, card)
      pileFromDealer.value = pushFlag(pileFromDealer.value, byDealer)
    }

    message.value = who + '打出 ' + card.suit + rankText(card) + '。'

    // 落堆那一下的两件事，都排在判钩之前 —— 它俩改的是堆本身，
    // 得先让堆定型，再拿定型后的堆去判这一下钩没钩上。
    // 这两张自己都没点数，所以本来也钩不着谁，顺序上不吃亏
    if (isTangle(card)) {
      // 缠线：把紧挨着它左边那张也废成没点数。
      //
      // 堆是从左往右摞的（下标 0 在最左、也最深），所以「左边那张」
      // 就是刚刚打出的上一张 —— 多半是庄家那张。
      // 废掉它等于拆掉庄家留在堆上的一个钩点，同时跟自己凑成
      // 连着两张没点数的墙：吞口吞不动，按点数也没人钩得上
      const at = pile.value.length - 2
      if (at >= 0) {
        const left = pile.value[at]
        left.pileValues = [] as number[]
        left.pileValue = NO_VALUE
        message.value = who + '打出 ' + card.suit + rankText(card)
          + '，【缠线】把左边那张 ' + left.suit + ' 也缠废了。'
      }
    }
    if (isEbb(card)) {
      // 落潮：左边那几张全压成 0 点。
      //
      // **没点数的也压**，这是这件的正事 —— 没点数比大小时算最大，
      // 是堵死吞口/巨口的那道墙；压成 0 之后它从最大翻成最小，
      // 墙当场变成口粮。所以这儿不能只压「本来有点数」的那些。
      //
      // 写 [0] 而不是空数组：0 是个实打实的点数（什么都比它大），
      // 空数组才是没点数（什么都不比它大）—— 这一层分野见 sizeOf
      const span = ebbSpan()
      const stop = pile.value.length - 1 - span
      const flat : Card[] = []
      let hit = 0
      for (let i = 0; i < pile.value.length; i++) {
        const one = pile.value[i]
        if (i < pile.value.length - 1 && i >= stop && i >= 0) {
          one.pileValues = [0] as number[]
          one.pileValue = 0
          hit = hit + 1
        }
        flat.push(one)
      }
      // 换一次数组引用，跟染水那边一个路子
      pile.value = flat
      if (hit > 0) {
        message.value = who + '打出 ' + card.suit + rankText(card)
          + '，【落潮】把左边 ' + hit + ' 张全压平了。'
      }
    }
    if (lastingTier('flood') >= 0 && isZeroPoint(card)) {
      // 落水：**任何人**打出 0 点牌时，它左侧所有牌点数 −X。
      //
      // 不加 byDealer 的判断是有意的。别的永续件（并色、巨口、挡口）
      // 都只照顾你这边，那是因为它们给的是**好处**。
      // 这件给的不是好处，是**改牌桌的物理** —— 水位落下去，
      // 谁的牌都一起沉。没道理只淹一半。
      //
      // 而且「一起淹」在这儿天然对你有利：砸平之后等点数那条线废了，
      // 可庄家**只有**那一条线，你还有吞口、巨口、收色。
      // 所以这条规矩越公平，它越吃亏。
      //
      // 顺带它把这一路最大的毛病治了：弹药不再全由你出。
      // 断数让双方这一轮的那一整类牌落地即 0，于是**庄家自己每打一张
      // 都在替你砸一脚** —— 你花一次断数，它帮你引爆半个回合。
      //
      // X = 这时候堆上 0 点牌的张数，含刚打出的这张 —— 不含的话
      // 第一张 0 就减 0 点，等于白打，雪崩根本起不来。
      //
      // 只减左边、不减自己：牌是砸下去那块石头，波纹往下铺开，石头不动。
      // 顺带这一条堵死了一条路 —— 沉到堆底的牌（埋饵）左边什么都没有，
      // 淹不了任何东西，「埋一张 0 在最底下反复引爆」行不通。
      //
      // 没点数的牌免疫：pileValues 是空数组，没有数可减，也不计进 X。
      // 断色、压冠、锁花立的墙在洪水里屹立不倒 —— 天然的克星。
      //
      // 减到 0 就停，那是全局规则（noNegative），这儿只是照着办
      let at = -1
      for (let i = 0; i < pile.value.length; i++) {
        if (pile.value[i] == card) {
          at = i
        }
      }
      let span = 0
      for (let i = 0; i < pile.value.length; i++) {
        if (isZeroPoint(pile.value[i])) {
          span = span + 1
        }
      }
      if (at > 0 && span > 0) {
        const sunk : Card[] = []
        let hit = 0
        for (let i = 0; i < pile.value.length; i++) {
          const one = pile.value[i]
          if (i < at && valuesOf(one).length > 0) {
            const next : number[] = []
            for (let k = 0; k < one.pileValues.length; k++) {
              next.push(one.pileValues[k] - span)
            }
            one.pileValues = noNegative(next)
            one.pileValue = 0
            hit = hit + 1
          }
          sunk.push(one)
        }
        pile.value = sunk
        message.value = who + '打出 ' + card.suit + rankText(card)
          + '，【落水】左边 ' + hit + ' 张全 −' + span + '（场上 '
          + span + ' 张 0）。'
      }
    }
    if (isDye(card)) {
      // 染水：把堆上所有牌染成它的花色。
      //
      // 染的是 suit 本身，不是记个名单 —— 花色是牌的属性，
      // 收色、集花、并色、断色全看它，改一处就都认。
      // 也因此**不随轮次还原**：堆是跨轮的，染过的水不会自己清。
      //
      // 双刃在于它对庄家的同源也一样管用（跟堆顶同花色就白送点数）——
      // 把一池子水染成一个颜色，等于给带同源的庄家铺了路
      const dyed : Card[] = []
      for (let i = 0; i < pile.value.length; i++) {
        const one = pile.value[i]
        one.suit = card.suit
        dyed.push(one)
      }
      // 改完再换一次数组引用 —— 项目里一律这么刷新，不靠对象内部的响应
      pile.value = dyed
      message.value = who + '打出 ' + card.suit + rankText(card)
        + '，【染水】整堆都成了 ' + card.suit + '。'
    }

    // 通吃不看数字，从堆底一路端到自己这儿。
    // J 焊着它，两边牌组里各有四张 —— 漏了这一支，J 打出去就只是张 11
    const haul = card.stickerKey == S_HAUL
    // 判撞要排掉自己 —— 牌这会儿已经在堆里了，不排就跟自己钩上了。
    //
    // 收色走的是另一套收法：不钩某一张再扫一段，而是把堆上**所有**
    // 同花色的挑出来一起拿走 —— 位置散在哪儿都算。
    // 它自己**没有点数**，所以点数那条线上它既钩不着人也没人钩得着
    //（连吞口也吞不动它），断口把点数全哑掉之后它照样收得动
    let marks : boolean[] = [] as boolean[]
    let count = 0
    let head = ''
    if (isSuitHook(card)) {
      for (let i = 0; i < pile.value.length; i++) {
        // 走 suitAlike 而不是直接比字符串 —— 带着并色的话
        // 方块和红心算一路、梅花和黑桃算一路
        const on = pile.value[i] == card || suitAlike(pileSuitOf(pile.value[i]), card.suit)
        marks.push(on)
        if (on) {
          count = count + 1
        }
      }
      // 只剩自己一张就是没收着 —— 堆上没有同花色的，它就留在堆里
      if (count <= 1) {
        catchMarks.value = [] as boolean[]
        if (tidyOn()) {
          sortPile()
        }
        message.value = who + '打出 ' + card.suit + rankText(card)
          + '，堆上没有同花色的，它留下了。'
        return false
      }
      head = '，【收色】把堆上 ' + card.suit + ' 全收走，共 '
    } else if (sank) {
      // 沉到堆底那张。它在下标 0，**底下没有牌了**，所以比大小那条线
      // （吞口、巨口）对它无从谈起 —— 只走等点数。
      //
      // 撞上了收的是「自己那张 + 从撞中那张到堆顶」，中间那一段
      // 比撞中那张还深，照基础规则本来就不该收 ——
      // 所以这是一次**不连续**的收牌，跟收色一样交给 marks 表去表达。
      //
      // 顺钩、逆钩这儿一律不掺：它们调的是「钩得多深」，
      // 而这一下的深度是你埋桩时就定死的，不是临场推出来的
      const at = pileIndexExcept(pile.value, valuesOf(card), card)
      if (at < 0) {
        catchMarks.value = [] as boolean[]
        if (tidyOn()) {
          sortPile()
        }
        message.value = who + '把 ' + card.suit + rankText(card)
          + ' 埋到了堆底 —— 堆上没有对得上的，它在那儿等着。'
        return false
      }
      for (let i = 0; i < pile.value.length; i++) {
        const on = i == 0 || i >= at
        marks.push(on)
        if (on) {
          count = count + 1
        }
      }
      head = '，埋到堆底、顺手撞中第 ' + (at + 1) + ' 张，收走 '
    } else {
      // 这一下按大小收还是按等点数收。
      // 吞口是你当场指的那一张，巨口是挂着的规矩 —— 够大的牌自动走大小这条线
      const bySize = isBigHook(card) || isMaw(byDealer, card)
      let at = -1
      if (haul) {
        at = 0
      } else if (bySize) {
        at = pileIndexOfSwallow(card)
      } else {
        at = pileIndexExcept(pile.value, valuesOf(card), card)
      }
      // 浑底：堆最底下那张对你不算钩点。
      // 钩中它就往上让一位 —— 「一钩端走整堆」这种事没有了
      if (!byDealer && at == 0 && hasRule('murk')) {
        if (bySize) {
          // 按大小吞的，往上让一位就完事 —— 少吞最底下那一张。
          //
          // **不能拿等点数的规则重算**：吞口那张多半跟谁都不等，
          // 一重算 again 就是 -1，整次吞口作废。
          // 而浑底的说明只说「最底下那张不算钩点」，不是「这一下白打」。
          // 巨口进来之后按大小收成了常事，这条路径天天走，错不得
          at = pile.value.length > 1 ? 1 : -1
        } else {
          const rest : Card[] = []
          for (let i = 1; i < pile.value.length; i++) {
            rest.push(pile.value[i])
          }
          const again = pileIndexExcept(rest, valuesOf(card), card)
          at = again < 0 ? -1 : again + 1
        }
      }
      // 挡口：庄家钩中它左边那张、而那张点数又没它大的时候，
      // 这一钩只收到它右边为止 —— 挡口和它护的那张都留下。
      //
      // 钩收走的是「从被钩那张到堆顶」，所以把起点往右推两格
      //（越过被护的那张和挡口自己），少收的正好是这两张。
      //
      // **只挡庄家**：两边都挡的话你自己也收不到自己护的那张，
      // 那它就自相矛盾了。跟并色、巨口一个规矩 —— 你买的道具只照顾你
      if (byDealer && at >= 0) {
        const moved = guardedStart(at)
        if (moved >= 0) {
          at = moved
        }
        // 推到头上就是没收着：它上面只剩它自己那张了
        if (at >= pile.value.length - 1) {
          at = -1
        }
      }
      if (at < 0) {
        catchMarks.value = [] as boolean[]
        // 带了拢堆才重排。没带的话堆就是出牌顺序 ——
        // 「你相邻两张之间夹着它一张」那条核心机制靠的就是这个顺序，
        // 无条件重排等于把它废了
        if (tidyOn()) {
          sortPile()
        }
        return false
      }
      // 钩点越靠底收得越多，所以「多收几张」就是把 at 往下推。
      //
      // 你这边：顺钩往下推，庄家的逆钩往回顶一张。
      // 它那边：深钩往下推一张
      if (!haul) {
        if (byDealer) {
          if (hasRule('deep')) {
            at = at - 1
          }
        } else {
          at = at - alongBonus()
          if (hasRule('counter')) {
            at = at + 1
          }
        }
        if (at < 0) {
          at = 0
        }
        // 逆钩顶过头了就是没收着 —— 只剩自己那张不算收牌
        if (at >= pile.value.length - 1) {
          catchMarks.value = [] as boolean[]
          if (tidyOn()) {
            sortPile()
          }
          message.value = who + '打出 ' + card.suit + rankText(card)
            + '，【逆钩】压着，这一下没收着。'
          return false
        }
      }
      // 从撞中那张一路收到自己这张，中间的全带走
      for (let i = 0; i < pile.value.length; i++) {
        const on = i >= at
        marks.push(on)
        if (on) {
          count = count + 1
        }
      }
      // 走的是哪条线得写出来 —— 一张 K 没跟谁配上对却收了一串，
      // 不说一声玩家根本不知道是巨口在生效
      head = haul
        ? '，【通吃】端走整堆 '
        : (bySize
          ? '，' + (isBigHook(card) ? '【吞口】' : '【巨口】')
            + '一路吞到第 ' + (at + 1) + ' 张，收走 '
          : '，钩中第 ' + (at + 1) + ' 张，收走 ')
    }
    catchMarks.value = marks
    message.value = who + '打出 ' + card.suit + rankText(card) + head + count + ' 张。'
    // 这里只把账记下来，牌先亮着不动。
    // 真收走要等它们飞到比分那儿 —— 亮起和收走挤在一帧里等于没亮
    pendingBy = byDealer
    pendingMarks = marks
    pendingCount = count
    return true
  }

  // 把标记中的那些收进这一方的收获里。
  //
  // 收的是一张标记表而不是「从第几张往上」—— 普通钩中确实是连着的一段，
  // 但收色挑的是散落在堆里的同花色，位置根本不连续。
  // 按表收，两种都装得下
  function harvest(byDealer : boolean, marks : boolean[]) {
    const taken : Card[] = []
    const left : Card[] = []
    const leftFrom : boolean[] = []
    for (let i = 0; i < pile.value.length; i++) {
      if (i < marks.length && marks[i]) {
        taken.push(pile.value[i])
      } else {
        left.push(pile.value[i])
        leftFrom.push(pileFromDealer.value[i])
      }
    }
    if (byDealer) {
      dealerPoints.value = pushCards(dealerPoints.value, taken)
    } else {
      playerPoints.value = pushCards(playerPoints.value, taken)
    }
    pile.value = left
    pileFromDealer.value = leftFrom
    catchMarks.value = [] as boolean[]
  }

  function endRound() {
    stepTimer = -1
    catchMarks.value = [] as boolean[]
    flyOn.value = false
    flyGo.value = false
    flyCards.value = [] as FlyOne[]
    // 长竿多摆出来、这一轮没轮到打的那几张，收起来留给下一轮。
    // 没带长竿的话队列正好五张，循环直接不进
    keepCards = [] as Card[]
    keepHidden = [] as boolean[]
    for (let i = capOf(false); i < playerQueue.value.length; i++) {
      keepCards.push(playerQueue.value[i])
      keepHidden.push(i < queueHidden.value.length ? queueHidden.value[i] : false)
    }
    // 牌打光了才算完，不再看关卡给的轮数。
    // 双方各 26 张、一轮各五张 —— 五轮整，末了剩一张单挑。
    //
    // 要「两边都空」才收摊。一方先出完的话，剩下那方得把自己的牌
    // 连着打完 —— 判成「任一方空」就把它剩下的牌全吞了。
    // 留在手上还没打的那几张（长竿的备选）也算数，不然最后一两张会被吞掉。
    // 空转的顾虑不用管：playStep 里那个 while 会把空步一次跳干净，
    // 两边都空时直接走到这儿收摊，回不到 startRound
    if (deckLeft.value <= 0 && keepCards.length == 0
      && dealerCursor >= dealerDeck.value.length) {
      finishGame()
      return
    }
    round.value = round.value + 1
    startRound()
    message.value = '第 ' + round.value + ' 轮。牌库顶又翻上来一批，重新排。'
  }

  // 打满了，这一关见分晓。
  //
  // 赢了：分差换金币，没贴掉的贴纸留在位子上，关号 +1，进商店。
  // 没赢（输了或者打平）：这一轮到此为止 —— 金币、贴纸、道具、印章全清，
  // 从第一关重来。收得不比庄家多就是没压过它，平局也一样
  function finishGame() {
    phase.value = 'over'
    const mine = playerPoints.value.length
    const theirs = dealerPoints.value.length
    const data = save.value
    if (mine > theirs) {
      const gap = mine - theirs
      const raw = baseCoins(level.value.index) + gapCoins(gap)
      // 秤钩的加成随等级走，带没带上场由道具栏说了算
      const scaleTier = lastingTier('scale')
      const coins = coinBonusOf(scaleTier, raw)
      data.runCoins = data.runCoins + coins
      // 道具栏上装的那几件原样留着 —— 道具不是消耗品，
      // 限制类的次数下一关自己回满，这儿什么都不用动
      if (level.value.index > data.relayBest) {
        data.relayBest = level.value.index
      }
      data.runLevel = level.value.index + 1
      // 下一关的规矩现在就摇好存下 —— 商店要先摊给你看，
      // 「买道具之前知道要面对什么」是这套经济能算得动的前提
      data.runRules = rollRulesFor(data.runLevel)
      // 货架清空：进了商店它自己会摆新的一批。
      // 不清的话下一关的商店摆的还是上一关剩下的货
      data.runShelf = [] as string[]
      // 下一关那副牌也现在就洗 —— 商店要把你那 26 张摊出来，
      // 你才谈得上照着牌买道具
      data.runDeck = dealRunDeck()
      // 立个牌子：这一轮眼下停在商店。
      // 在商店里退出去，下次「继续」才会回到商店而不是直接推进牌桌
      data.runShop = true
      saveCurrent(data)
      save.value = cloneSave(data)
      gotText.value = '赢了 ' + gap + ' 张，到手 ' + coins + ' 金币'
        + (scaleTier >= 0 ? '（秤钩加成）' : '')
      message.value = '打完了。' + gotText.value + '。'
      return
    }
    // 输了。家当清空，但 relayBest 那个数留着。
    // runLevel 归 0 表示手头没有进行中的挑战，下次从第一关起
    gotText.value = ''
    resetRun(data)
    data.runLevel = 0
    saveCurrent(data)
    save.value = cloneSave(data)
    message.value = '打完了。' + (mine == theirs ? '打平也算没赢 —— ' : '')
      + '这一轮到此为止，金币和贴纸全清。'
  }

  // ---------- 小工具 ----------

  function pushCard(list : Card[], card : Card) : Card[] {
    const next : Card[] = []
    for (let i = 0; i < list.length; i++) {
      next.push(list[i])
    }
    next.push(card)
    return next
  }

  function pushCards(list : Card[], add : Card[]) : Card[] {
    const next : Card[] = []
    for (let i = 0; i < list.length; i++) {
      next.push(list[i])
    }
    for (let i = 0; i < add.length; i++) {
      next.push(add[i])
    }
    return next
  }

  function pushFlag(list : boolean[], flag : boolean) : boolean[] {
    const next : boolean[] = []
    for (let i = 0; i < list.length; i++) {
      next.push(list[i])
    }
    next.push(flag)
    return next
  }

  function isRed(card : Card) : boolean {
    return isRedSuit(card.suit)
  }

  // 牌面写的是这张现在算哪几个数。贴纸改过的就写改完的，
  // 能算成好几个数的全列出来 —— 跟主玩法一个规矩。
  // 11/12/13 写成 J/Q/K，走的是跟主玩法同一个 faceOf
  function rankText(card : Card) : string {
    const values = card.pileValue == -1 ? valuesOf2(card) : valuesOf(card)
    if (values.length == 0) {
      return ''
    }
    let text = ''
    for (let i = 0; i < values.length; i++) {
      if (i > 0) {
        text = text + '/'
      }
      text = text + faceOf(values[i])
    }
    return text
  }

  function stickerName(card : Card) : string {
    return stickerAt(card.stickerKey).name
  }

  function showPileCard(card : Card, index : number) {
    const from = index < pileFromDealer.value.length && pileFromDealer.value[index]
      ? '庄家打的' : '你打的'
    const values = valuesOf(card)
    const worth = values.length == 0 ? '没有点数' : '算 ' + rankText(card) + ' 点'
    let body = from + '，' + worth + '。'
    if (card.stickerKey != S_NONE) {
      const sticker = stickerAt(card.stickerKey)
      body = body + '\n\n【' + sticker.name + '】' + sticker.desc
    }
    uni.showModal({
      title: card.suit + card.rank,
      content: body,
      showCancel: false,
      confirmText: '知道了'
    })
  }

  function toast(tip : string) {
    uni.showToast({
      icon: 'none',
      title: tip
    })
  }

  function stopTimer() {
    if (stepTimer != -1) {
      clearTimeout(stepTimer)
      stepTimer = -1
    }
    if (sinkTimer != -1) {
      clearTimeout(sinkTimer)
      sinkTimer = -1
    }
    if (popTimer != -1) {
      clearTimeout(popTimer)
      popTimer = -1
    }
    // 落子收尾那两拍也得停掉，不然页面收场之后回调还会来改状态
    resetDrag()
    sinking.value = [] as boolean[]
    dealing.value = [] as boolean[]
    enterDX.value = [] as number[]
    flyOn.value = false
    flyGo.value = false
    flyCards.value = [] as FlyOne[]
    popBy.value = -1
    popIn.value = false
    pendingMarks = [] as boolean[]
    pendingCount = 0
  }

  // 退出：能退就退，退不了就直接跳回入口。
  //
  // 栈里只剩这一页的时候 navigateBack 是空操作，按了没反应 ——
  // 这在两种情况下都会发生：H5 开发时热重载把栈冲掉了，
  // 以及从商店 redirectTo 过来、而商店自己又是被 redirect 替换掉的。
  // 兜一道，按钮就永远是有反应的
  function goBack() {
    if (getCurrentPages().length > 1) {
      uni.navigateBack()
      return
    }
    uni.redirectTo({
      url: '/pages/examples/blackjack/relay-levels'
    })
  }

  onUnmounted(() => {
    stopTimer()
  })

  // 倍速是跟着人走的偏好，不是这一局的状态
  function loadSpeed() {
    const raw = uni.getStorageSync(KEY_SPEED)
    if (raw != null && typeof raw == 'string' && (raw as string) == '1') {
      speedFast.value = true
    }
  }

  loadSpeed()
  setup()
</script>

<style>
  .page {
    flex: 1;
    padding: 8px 10px;
    background-color: #0b5d3b;
  }

  .topbar {
    flex-direction: row;
    justify-content: space-between;
    background-color: #084730;
    border-radius: 8px;
    padding: 6px 10px;
  }

  /* 飘上来的「+N」是绝对定位的，得有个参照 */
  .topbar-item {
    flex: 1;
    align-items: center;
    position: relative;
    overflow: visible;
  }

  .topbar-label {
    color: #9fd9bd;
    font-size: 11px;
  }

  .topbar-value {
    color: #ffffff;
    font-size: 19px;
    font-weight: bold;
    transition-property: transform, color;
    transition-duration: 200ms;
  }

  /* 比分跟牌堆里的归属色对上：庄家收的牌描红橙边，它的分也是红橙；
     你的是绿。扫一眼就知道堆里那片将来算谁的 */
  .topbar-value-dealer {
    color: #ff9e80;
  }

  .topbar-value-mine {
    color: #7ce0a3;
  }

  /* 刚收到牌，数字胀一下再缩回去 */
  .topbar-value-pop {
    color: #ffd54f;
    transform: scale(1.4);
  }

  /* 收走的那几张飞到这儿，化成这个「+N」往上飘散 */
  .gain {
    position: absolute;
    top: 14px;
    color: #ffd54f;
    font-size: 15px;
    font-weight: bold;
    transition-property: transform, opacity;
    transition-duration: 460ms;
  }

  .gain-up {
    transform: translateY(-18px);
    opacity: 0;
  }

  /* 公共牌堆 */
  .pile-area {
    flex: 1;
    flex-direction: column;
    min-height: 96px;
    margin-top: 6px;
    background-color: #0e6b45;
    border-radius: 8px;
    padding: 6px 10px;
  }

  .pile-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .pile-title {
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
  }

  .pile-tip {
    color: #9fd9bd;
    font-size: 11px;
  }

  .board {
    flex: 1;
    min-height: 68px;
    margin-top: 4px;
  }

  .board-row {
    flex-direction: row;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .card-in-pile {
    margin-bottom: 6px;
  }

  .dim-tip {
    color: #8fc7ab;
    font-size: 11px;
  }

  /* 牌面 */
  .card {
    width: 46px;
    height: 64px;
    background-color: #ffffff;
    border-radius: 5px;
    margin-right: 6px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-style: solid;
    border-color: #ffffff;
  }

  .card-stickered {
    border-color: #e8b23a;
  }

  .card-from-dealer {
    border-color: #ff9e80;
  }

  .card-from-player {
    border-color: #7ce0a3;
  }

  .card-caught {
    background-color: #fff3c4;
    border-color: #ffd54f;
    transform: translateY(-8px);
    transition-property: transform, background-color;
    transition-duration: 180ms;
  }

  .card-back {
    background-color: #123f6b;
    border-color: #0b2a48;
  }

  .card-back-art {
    width: 34px;
    height: 52px;
    border-width: 1px;
    border-style: solid;
    border-color: #3d7fc1;
    border-radius: 3px;
    align-items: center;
    justify-content: center;
    background-color: #17497a;
  }

  .card-back-gem {
    width: 16px;
    height: 16px;
    background-color: #3d7fc1;
    transform: rotate(45deg);
  }

  /* 庄家手牌区。摆在牌堆上头，牌比你那排小一号 ——
     它是情报，不是你要伸手去动的东西，尺寸上就该分出主次 */
  .dealer-area {
    margin-top: 4px;
  }

  .dealer-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 20px;
  }

  .dealer-title {
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
  }

  .dealer-tip {
    color: #9fd9bd;
    font-size: 10px;
  }

  /* 庄家挂着的规矩，横着摆一排。点一下在说明框里展开 */
  .rule-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 2px;
  }

  .rule-tag {
    color: #ff9e80;
    background-color: #0e3a28;
    font-size: 10px;
    border-radius: 8px;
    padding: 2px 7px;
    margin-right: 4px;
    margin-bottom: 2px;
  }

  .dealer-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
  }

  /* 小一号的牌面。.card 那条 46x64 在前，这条在后才盖得住 */
  .card-dealer {
    width: 34px;
    height: 48px;
    margin-right: 4px;
  }

  /* 牌背是照 46x64 的牌量的，牌一缩它就顶出去了，得跟着缩 */
  .dealer-art {
    width: 24px;
    height: 36px;
  }

  .dealer-gem {
    width: 11px;
    height: 11px;
  }

  /* 它下一张要打的那张：描金边，跟排竿区「正拖着」那张同一个色 ——
     两处的意思都是「这张现在要紧」 */
  .card-next {
    border-color: #e8b23a;
    background-color: #fffbe8;
  }

  .card-rank {
    color: #1a1a1a;
    font-size: 18px;
    font-weight: bold;
  }

  /* 庄家那排牌小一号，点数也得跟着小，不然 18px 的字在 34px 宽的牌上顶满。
     必须排在 .card-rank 后面 —— 同权重后来居上 */
  .card-rank-small {
    font-size: 15px;
  }

  .card-suit {
    color: #1a1a1a;
    font-size: 12px;
  }

  .card-red {
    color: #d33b3b;
  }

  .card-sticker {
    color: #8a6b00;
    font-size: 9px;
  }

  /* 说明框。文字在左、按钮在右，所以是 row；
     文字那块 flex:1 撑开，把按钮顶到最右边 */
  .message-box {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    margin-top: 6px;
    background-color: #084730;
    border-radius: 6px;
    padding: 5px 8px;
  }

  .message-text {
    flex: 1;
    color: #cfeade;
    font-size: 11px;
    line-height: 15px;
  }

  /* 选中道具时右边冒出来的那颗。不再另弹窗，就在这儿按 */
  .msg-btn {
    color: #3b2a00;
    background-color: #e8b23a;
    font-size: 12px;
    font-weight: bold;
    border-radius: 8px;
    padding: 6px 12px;
    margin-left: 8px;
  }

  /* 每轮白送的贴纸。高度写死，有没有贴纸这一行都占同样的位子 ——
     不然发到一张牌面就整体往上顶一下 */
  .gift-row {
    flex-direction: row;
    align-items: center;
    height: 30px;
    margin-top: 6px;
  }

  .gift-label {
    color: #9fd9bd;
    font-size: 11px;
    margin-right: 6px;
  }

  /* 道具栏上的一件。名字和剩余次数横着摆，所以是 row */
  .gift {
    flex-direction: row;
    height: 24px;
    padding: 0 8px;
    margin-right: 5px;
    border-radius: 12px;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #0e6b45;
    align-items: center;
    justify-content: center;
  }

  .gift-on {
    border-color: #e8b23a;
    background-color: #12764e;
  }

  /* 限制类这一关用完了：还列着，但看得出来点不动 */
  .gift-dim {
    opacity: 0.45;
  }

  /* 还能用几次，挂在名字后头 */
  .gift-left {
    color: #9fd9bd;
    font-size: 10px;
    margin-left: 4px;
  }

  .gift-name {
    font-size: 12px;
    font-weight: bold;
  }

  .gift-none {
    color: #8fc7ab;
    font-size: 11px;
  }

  .gift-desc {
    flex: 1;
    color: #e8b23a;
    font-size: 10px;
    text-align: right;
  }

  /* 道具库入口。描金跟旁边的贴纸分开 —— 那些是牌上用的，这个是箱子里的 */
  /* 窥筒的面板 */
  .kit-layer {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(3, 20, 13, 0.8);
    align-items: center;
    justify-content: center;
    padding: 22px;
  }

  .kit-panel {
    width: 100%;
    background-color: #0e6b45;
    border-radius: 12px;
    padding: 14px;
    border-width: 2px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .kit-title {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
  }

  .kit-sub {
    color: #9fd9bd;
    font-size: 11px;
    margin-top: 2px;
  }

  .kit-body {
    max-height: 220px;
    margin-top: 8px;
  }

  .kit-row {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .kit-chip {
    height: 32px;
    padding: 0 10px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 8px;
    background-color: #12764e;
    align-items: center;
    justify-content: center;
  }

  .kit-name {
    font-size: 13px;
    font-weight: bold;
  }

  .kit-none {
    color: #8fc7ab;
    font-size: 12px;
  }

  .kit-close {
    color: #e8b23a;
    font-size: 13px;
    font-weight: bold;
    text-align: center;
    margin-top: 10px;
  }

  /* 道具库里一件件排着 */
  .bag-list {
    margin-top: 2px;
  }

  .bag-item {
    background-color: #12764e;
    border-radius: 8px;
    padding: 7px 10px;
    margin-bottom: 6px;
  }

  .bag-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .bag-name {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
  }

  .bag-count {
    color: #ffd54f;
    font-size: 12px;
    font-weight: bold;
  }

  .bag-desc {
    color: #cfeade;
    font-size: 10px;
    line-height: 14px;
    margin-top: 2px;
  }

  /* 排竿区 */
  .queue-area {
    margin-top: 6px;
    overflow: visible;
  }

  .queue-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 22px;
  }

  .queue-title {
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
  }

  .queue-tip {
    color: #9fd9bd;
    font-size: 10px;
  }

  /* 拖动时牌会探出自己那一格 —— 一格才六十来像素，牌就占了四十六，
     再挪半格就出界了。这一路容器都得放行，
     少放一层，牌到那一层的边上就被切掉一条 */
  .queue-row {
    flex-direction: row;
    margin-top: 4px;
    overflow: visible;
  }

  /* 五个格位平分一行，牌在中间，序号在上面 */
  .slot {
    flex: 1;
    align-items: center;
    overflow: visible;
  }

  .slot-order {
    color: #9fd9bd;
    font-size: 10px;
  }

  /* 排竿区的牌。压牌飞出、补牌飞回、拖动跟手，三件事共用这条过渡；
     拖动那下会把它关掉，不然牌会拖在手指后面晃 */
  .card-queue {
    margin-right: 0;
    transition-property: transform, opacity;
    transition-duration: 200ms;
  }

  /* 正拖着的那张要实时跟手，不能有过渡 */
  .card-dragging {
    transition-duration: 0ms;
    border-color: #e8b23a;
  }

  /* 松手那一帧：数据刚换过、各张牌的偏移同时清掉。
     这两件事必须同一帧，而且不能带过渡 ——
     不然整排牌会带着换好的新牌面，再滑回去一格 */
  .card-settling {
    transition-duration: 0ms;
  }

  /* 被道具瞄上的：描金边、底色也提一点。
     跟「选中待压」那个橙红描边分开 —— 一个是要扔掉，一个是要下手，
     混成一个颜色就分不清自己刚才点的是哪一路 */
  .card-aim {
    border-color: #e8b23a;
    background-color: #fffbe8;
  }

  /* 备选：这一轮打不到，留给下一轮。压暗一点，跟要打的那几张分开 */
  .card-spare {
    opacity: 0.55;
    border-color: #0e6b45;
  }

  .slot-order-spare {
    color: #e8b23a;
  }

  /* 点中了准备压掉的：描红，跟「选中」区别开 —— 这是要扔掉的意思 */
  .card-sink {
    border-color: #ff9e80;
    opacity: 0.7;
  }

  /* 右头的牌库：三层错开叠出一摞的厚度 */
  .deck {
    width: 54px;
    align-items: center;
    justify-content: flex-end;
  }

  .deck-stack {
    width: 46px;
    height: 64px;
  }

  .deck-card {
    position: absolute;
    width: 42px;
    height: 60px;
    border-radius: 5px;
    background-color: #123f6b;
    border-width: 2px;
    border-style: solid;
    border-color: #0b2a48;
  }

  .deck-card-back2 {
    left: 0;
    top: 0;
  }

  .deck-card-back1 {
    left: 2px;
    top: 2px;
  }

  .deck-card-top {
    left: 4px;
    top: 4px;
    align-items: center;
    justify-content: center;
  }

  .deck-art {
    width: 30px;
    height: 48px;
  }

  .deck-count {
    color: #9fd9bd;
    font-size: 10px;
    margin-top: 3px;
  }

  /* 已经打出去的压暗，正要打的描亮 —— 自动演的时候得看得出演到哪了 */
  .card-done {
    opacity: 0.35;
  }

  .card-now {
    border-color: #7ce0a3;
  }

  .actions {
    flex-direction: row;
    margin-top: 8px;
  }

  .act-btn {
    flex: 1;
    height: 42px;
    border-radius: 21px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .act-btn-primary {
    background-color: #e8b23a;
  }

  /* 倍速开着的时候亮一下 */
  .act-btn-on {
    background-color: #12764e;
  }

  /* 压底是「把牌扔回牌库」，跟开始出牌分开描色 */
  .act-btn-warn {
    border-color: #ff9e80;
  }

  .act-text-warn {
    color: #ff9e80;
    font-size: 15px;
    font-weight: bold;
  }

  .act-text {
    color: #e8b23a;
    font-size: 15px;
    font-weight: bold;
  }

  .act-text-dark {
    color: #3b2a00;
  }

  /* 收牌的飞行层：浮在整页之上，替身在里面按屏幕坐标摆位 */
  .fly-layer {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
  }

  .fly-card {
    position: absolute;
    width: 46px;
    height: 64px;
    background-color: #fff3c4;
    border-radius: 5px;
    border-width: 2px;
    border-style: solid;
    border-color: #ffd54f;
    align-items: center;
    justify-content: center;
    transition-property: transform, opacity;
    transition-duration: 560ms;
  }

  /* 结算 */
  .over-layer {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(3, 20, 13, 0.78);
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .over-panel {
    width: 100%;
    background-color: #0e6b45;
    border-radius: 12px;
    padding: 18px;
    align-items: center;
    border-width: 2px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .over-title {
    color: #e8b23a;
    font-size: 24px;
    font-weight: bold;
  }

  .over-line {
    color: #ffffff;
    font-size: 14px;
    margin-top: 8px;
  }

  .over-got {
    color: #ffd54f;
    font-size: 12px;
    margin-top: 8px;
    text-align: center;
  }

  .over-hint {
    color: #9fd9bd;
    font-size: 11px;
    margin-top: 10px;
    text-align: center;
  }

  .over-acts {
    flex-direction: row;
    margin-top: 14px;
    width: 100%;
  }
</style>
