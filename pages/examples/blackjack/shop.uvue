<template>
  <view class="page">
    <!-- 手里各稀有度的兑换券。上排自选、下排随机 -->
    <view id="bj-shop-tickets" class="head">
      <view v-for="rarity in rarities" :key="rarity.id" class="head-item">
        <text class="head-label" :style="'color: ' + rarity.color">{{ rarity.name }}券</text>
        <text :id="'bj-ticket-' + rarity.id" class="head-value">{{ save.tickets[rarity.id] }}</text>
        <text :id="'bj-random-ticket-' + rarity.id" class="head-random"
          >随机 {{ save.randomTickets[rarity.id] }}</text
        >
        <text :id="'bj-refund-ticket-' + rarity.id" class="head-refund"
          >退换 {{ save.refundTickets[rarity.id] }}</text
        >
      </view>
    </view>

    <!-- 贴纸按稀有度分组，用同稀有度的券兑换 -->
    <scroll-view class="list">
      <view v-for="rarity in rarities" :key="'g-' + rarity.id">
        <view class="group-head">
          <text class="group-name" :style="'color: ' + rarity.color">{{ rarity.name }}</text>
          <text class="group-sub"
            >每种最多 {{ rarity.own }} 张 · 手里 {{ save.tickets[rarity.id] }} 券</text
          >
          <view
            :id="'bj-draw-' + rarity.id"
            class="buy-btn draw-btn"
            :class="{ 'buy-btn-off': !drawable(rarity.id) }"
            @click="drawOne(rarity.id)">
            <text class="buy-text draw-text">{{ drawText(rarity.id) }}</text>
          </view>
        </view>
        <view v-for="sticker in shelfOf(rarity.id)" :key="sticker.key" class="row">
          <view class="row-main">
            <view class="row-head">
              <text class="row-name" :style="'color: ' + rarityAt(sticker.rarity).color">{{
              sticker.name
            }}</text>
              <text class="row-own">{{ ownText(sticker) }}</text>
            </view>
            <text class="row-desc">{{ rowDesc(sticker) }}</text>
          </view>
          <!-- 手里有这张、又有同档退换券时，才给退换的口子 -->
          <view
            v-if="refundable(sticker)"
            :id="'bj-refund-sticker-' + sticker.key"
            class="buy-btn refund-btn"
            @click="refundOne(sticker.key)">
            <text class="buy-text refund-text">退换</text>
          </view>
          <view
            :id="'bj-buy-sticker-' + sticker.key"
            class="buy-btn"
            :class="{ 'buy-btn-off': !redeemable(sticker) }"
            @click="redeemOne(sticker.key)">
            <text class="buy-text">{{ buyText(sticker) }}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view id="bj-shop-back" class="back-btn" @click="goBack">
      <text class="back-text">返回</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    Sticker,
    Rarity,
    STICKERS,
    RARITIES,
    stickerAt,
    rarityAt,
    indexOfKey,
    isHiddenSticker,
    ACHIEVEMENTS
  } from '@/pages/examples/blackjack/stickers.uts'
  import { allLevels } from '@/pages/examples/blackjack/levels.uts'
  import {
    SaveData,
    emptySave,
    loadCurrentSave,
    saveCurrent,
    redeemSticker,
    refundSticker,
    drawSticker,
    drawPool,
    isShopUnlocked,
    stickerTotal,
    stickerLimit,
    ticketsOf,
    randomTicketsOf,
    refundTicketsOf
  } from '@/pages/examples/blackjack/save.uts'

  const save = ref<SaveData>(emptySave())
  const rarities = ref<Rarity[]>(RARITIES)

  // 这个稀有度下上架的贴纸。隐藏贴纸在抽到之前连名字都不露 ——
  // 抽到就解锁了，之后它会出现在这里，可以拿自选券正常兑换
  function shelfOf(rarity : number) : Sticker[] {
    const list : Sticker[] = []
    for (let i = 0; i < STICKERS.length; i++) {
      const sticker = STICKERS[i]
      if (sticker.rarity != rarity) {
        continue
      }
      if (isHiddenSticker(sticker.key) && !isShopUnlocked(save.value, sticker.key)) {
        continue
      }
      list.push(sticker)
    }
    return list
  }

  // 这一档还有没有随机券、抽池里还有没有东西
  function drawable(rarity : number) : boolean {
    if (randomTicketsOf(save.value, rarity) <= 0) {
      return false
    }
    return drawPool(save.value, rarity).length > 0
  }

  function drawText(rarity : number) : string {
    const left = randomTicketsOf(save.value, rarity)
    if (left <= 0) {
      return '无随机券'
    }
    return '随机 ' + left
  }

  // 手里有这张没贴出去的、又有同档退换券，才退得了
  function refundable(sticker : Sticker) : boolean {
    return ownedLoose(sticker.key) > 0 && refundTicketsOf(save.value, sticker.rarity) > 0
  }

  // 手里还剩几张没贴出去的
  function ownedLoose(key : string) : number {
    const at = indexOfKey(key)
    return at < 0 ? 0 : save.value.stickersOwned[at]
  }

  // 退换：把手里这张退掉，换回一张同档随机券，再抽就是了
  function refundOne(key : string) {
    const data = save.value
    const sticker = stickerAt(key)
    if (!refundSticker(data, key)) {
      uni.showToast({
        icon: 'none',
        title: ownedLoose(key) > 0 ? '没有' + rarityAt(sticker.rarity).name + '退换券' : '手里没有这张'
      })
      return
    }
    commit(data, '退掉【' + sticker.name + '】，换回一张'
      + rarityAt(sticker.rarity).name + '随机券')
  }

  // 烧一张随机券，抽池里随机一张。抽到藏着的就顺手解锁它
  function drawOne(rarity : number) {
    const data = save.value
    if (randomTicketsOf(data, rarity) <= 0) {
      uni.showToast({
        icon: 'none',
        title: '没有' + rarityAt(rarity).name + '随机券了'
      })
      return
    }

    // 先记下这一抽有哪些藏着的可能开出来 —— 抽完它们就已经解锁了，问不出来了
    const secret : string[] = []
    const pool = drawPool(data, rarity)
    for (let i = 0; i < pool.length; i++) {
      if (isHiddenSticker(pool[i]) && !isShopUnlocked(data, pool[i])) {
        secret.push(pool[i])
      }
    }

    const key = drawSticker(data, rarity)
    if (key == '') {
      uni.showToast({
        icon: 'none',
        title: '这一档的贴纸都攒满了'
      })
      return
    }

    let tip = '抽到贴纸【' + stickerAt(key).name + '】'
    for (let i = 0; i < secret.length; i++) {
      if (secret[i] == key) {
        tip = '开出隐藏贴纸【' + stickerAt(key).name + '】，货架上解锁了'
        break
      }
    }
    commit(data, tip)
  }

  function refresh() {
    save.value = loadCurrentSave()
  }

  function unlocked(key : string) : boolean {
    return isShopUnlocked(save.value, key)
  }

  // 已经有几张 / 最多能有几张
  function ownText(sticker : Sticker) : string {
    if (!unlocked(sticker.key)) {
      return ''
    }
    return stickerTotal(save.value, sticker.key) + '/' + stickerLimit(sticker.key)
  }

  // 解锁了、没到上限、对应稀有度的券也还有，才换得了
  function redeemable(sticker : Sticker) : boolean {
    if (!unlocked(sticker.key)) {
      return false
    }
    if (stickerTotal(save.value, sticker.key) >= stickerLimit(sticker.key)) {
      return false
    }
    return ticketsOf(save.value, sticker.rarity) > 0
  }

  function buyText(sticker : Sticker) : string {
    if (!unlocked(sticker.key)) {
      return '未解锁'
    }
    if (stickerTotal(save.value, sticker.key) >= stickerLimit(sticker.key)) {
      return '已满'
    }
    if (ticketsOf(save.value, sticker.rarity) <= 0) {
      return '缺券'
    }
    return '兑换'
  }

  // 效果一律摊开：没解锁的照样给看。
  // 得在花券之前知道它是干什么的 —— 买回来才发现不是想要的，比看不到更难受
  function rowDesc(sticker : Sticker) : string {
    if (!unlocked(sticker.key)) {
      return sticker.desc + '（未解锁 · ' + howToUnlock(sticker.key) + '）'
    }
    return sticker.desc
  }

  // 这张贴纸要怎么才能解锁：有的靠通关，有的靠成就
  function howToUnlock(key : string) : string {
    for (let i = 0; i < ACHIEVEMENTS.length; i++) {
      if (ACHIEVEMENTS[i].sticker == key) {
        return '成就「' + ACHIEVEMENTS[i].name + '」：' + ACHIEVEMENTS[i].desc
      }
    }
    const levels = allLevels()
    for (let i = 0; i < levels.length; i++) {
      const kinds = levels[i].unlockStickers
      for (let k = 0; k < kinds.length; k++) {
        if (kinds[k] == key) {
          return '通关第 ' + levels[i].index + ' 关'
        }
      }
    }
    return '暂时拿不到'
  }

  // 数据改完整体替换一次，保证视图刷新
  function commit(data : SaveData, tip : string) {
    saveCurrent(data)
    const next : SaveData = {
      exists: data.exists,
      label: data.label,
      tickets: data.tickets,
      randomTickets: data.randomTickets,
      refundTickets: data.refundTickets,
      win: data.win,
      lose: data.lose,
      push: data.push,
      cleared: data.cleared,
      stickersOwned: data.stickersOwned,
      shopUnlocked: data.shopUnlocked,
      achieved: data.achieved,
      stuck: data.stuck
    }
    save.value = next
    uni.showToast({
      icon: 'none',
      title: tip
    })
  }

  function redeemOne(key : string) {
    const data = save.value
    if (!isShopUnlocked(data, key)) {
      uni.showToast({
        icon: 'none',
        title: '通关或达成成就后才会上架'
      })
      return
    }
    if (stickerTotal(data, key) >= stickerLimit(key)) {
      uni.showToast({
        icon: 'none',
        title: '这种贴纸已经到上限了'
      })
      return
    }
    const sticker = stickerAt(key)
    if (!redeemSticker(data, key)) {
      uni.showToast({
        icon: 'none',
        title: '没有' + rarityAt(sticker.rarity).name + '券了'
      })
      return
    }
    commit(data, '换到贴纸【' + sticker.name + '】')
  }

  function goBack() {
    uni.navigateBack()
  }

  onShow(() => {
    refresh()
  })

  refresh()
</script>

<style>
  .page {
    flex: 1;
    padding: 10px 12px;
    background-color: #0b5d3b;
  }

  .head {
    flex-direction: row;
    justify-content: space-between;
    background-color: #084730;
    border-radius: 8px;
    padding: 6px 12px;
  }

  .head-item {
    flex: 1;
    align-items: center;
  }

  .head-label {
    color: #9fd9bd;
    font-size: 11px;
  }

  .head-value {
    color: #ffffff;
    font-size: 17px;
    font-weight: bold;
  }

  /* 随机券排在自选券下面，小一号 —— 它是副币种。
     玫红是它的专属色：四个稀有度（淡绿/蓝/紫/橙）和金色主按钮都没占这个色相，
     随机券横跨所有稀有度，不能借用其中任何一档的颜色 */
  .head-random {
    color: #ff7aa8;
    font-size: 10px;
  }

  /* 退换券又是一个币种，青色跟金色的自选券、玫红的随机券都分得开 */
  .head-refund {
    color: #4dd0c7;
    font-size: 10px;
  }

  .refund-btn {
    background-color: #1d7a72;
  }

  .refund-text {
    color: #ffffff;
  }

  .section {
    color: #9fd9bd;
    font-size: 11px;
    margin-top: 10px;
  }

  /* 贴纸列表 */
  .list {
    flex: 1;
    margin-top: 4px;
  }

  .row {
    flex-direction: row;
    align-items: center;
    background-color: #0e6b45;
    border-radius: 8px;
    padding: 6px 10px;
    margin-top: 6px;
  }

  .row-main {
    flex: 1;
  }

  .row-head {
    flex-direction: row;
    align-items: center;
  }

  .row-name {
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
    margin-right: 8px;
  }

  /* 稀有度分组头，颜色由 RARITIES 里的配置决定 */
  .group-head {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    margin-bottom: 2px;
  }

  .group-name {
    font-size: 13px;
    font-weight: bold;
    margin-right: 8px;
  }

  .group-sub {
    flex: 1;
    color: #9fd9bd;
    font-size: 10px;
  }

  /* 分组头右端的随机兑换。玫红跟随机券对上，跟金色的自选兑换分开 */
  .draw-btn {
    height: 26px;
    background-color: #d6336c;
  }

  .draw-text {
    color: #ffffff;
  }

  .row-own {
    color: #e8b23a;
    font-size: 11px;
  }

  .row-desc {
    color: #cfeade;
    font-size: 10px;
  }

  .buy-btn {
    height: 30px;
    border-radius: 15px;
    padding: 0 12px;
    margin-left: 8px;
    align-items: center;
    justify-content: center;
    background-color: #e8b23a;
  }

  .buy-btn-off {
    background-color: #6b6b6b;
  }

  .buy-text {
    color: #3b2a00;
    font-size: 12px;
    font-weight: bold;
  }

  .back-btn {
    height: 42px;
    border-radius: 21px;
    margin-top: 8px;
    align-items: center;
    justify-content: center;
    background-color: #084730;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .back-text {
    color: #e8b23a;
    font-size: 15px;
    font-weight: bold;
  }
</style>
