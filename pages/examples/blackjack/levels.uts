export function allLevels() : Level[] {
  return LEVELS
}

// 某个钓场的四关，按档次排好
export function levelsOfField(field : number) : Level[] {
  const list : Level[] = []
  for (let i = 0; i < LEVELS.length; i++) {
    if (LEVELS[i].spot == field) {
      list.push(LEVELS[i])
    }
  }
  return list
}

export function fieldCount() : number {
  return FIELD_NAMES.length
}

export function levelAt(index : number) : Level {
  for (let i = 0; i < LEVELS.length; i++) {
    if (LEVELS[i].index == index) {
      return LEVELS[i]
    }
  }
  return LEVELS[0]
}

// 史诗关和传说关另外要求「总共通关几关」，跨钓场算。
//
// 这是刻意拦的：一条路的券只有 11 张（3+1、2+1、2+1、1+0），配不齐那条路本身，
// 所以想打动自己这条路的后两关，就得先去别的钓场攒券和贴纸。
// 没有这道坎的话，一头扎进浅滩一路打到传说是可行的 ——
// 那样既玩不到别的路子，牌组也弱得过不去
export function tierGate(tier : number) : number {
  if (tier == 2) {
    return 6
  }
  if (tier == 3) {
    return 12
  }
  return 0
}

// 能不能打这一关。
//
// 每个钓场的普通关一开始就开着，往后每关要求同一个钓场的上一关先通；
// 史诗、传说还要看总通关数够不够。
// 通过的关卡可以回去重打（刷成就、试牌组），只是不再给券
export function isPlayable(index : number, cleared : number[]) : boolean {
  const level = levelAt(index)
  if (level.tier == 0) {
    return true
  }
  // 同一个钓场的关卡 index 是连着排的，上一关就是 index - 1
  if (!isCleared(index - 1, cleared)) {
    return false
  }
  return cleared.length >= tierGate(level.tier)
}

// 差几关才够门槛，0 表示门槛已经过了。列表页拿它写「还差 N 关」
export function gateLeft(index : number, cleared : number[]) : number {
  const need = tierGate(levelAt(index).tier) - cleared.length
  return need > 0 ? need : 0
}

export function isCleared(index : number, cleared : number[]) : boolean {
  for (let i = 0; i < cleared.length; i++) {
    if (cleared[i] == index) {
      return true
    }
  }
  return false
}

// 庄家牌组的贴纸矩阵：只用本关指定的贴纸种类，尽量摊到不同数字上。
// 矩阵一个格子就是一张牌，所以一轮填一个花色，填满四轮为止
export function dealerStuck(level : Level) : number[] {
  const stuck = emptyStickers()
  const kinds = level.dealerStickerKinds
  if (kinds.length == 0) {
    return stuck
  }
  let left = level.dealerStickers
  for (let round = 0; round < SUITS.length && left > 0; round++) {
    for (let r = 0; r < RANKS.length; r++) {
      if (left <= 0) {
        break
      }
      // J 焊着【通吃】，庄家的也一样，贴纸分不到它头上
      if (isFixedRank(RANKS[r])) {
        continue
      }
      const id = indexOfKey(kinds[(r + round) % kinds.length])
      if (id < 0) {
        continue
      }
      const at = stickerIndex(r, round)
      if (stuck[at] == 0) {
        stuck[at] = id + 1
        left = left - 1
      }
    }
  }
  return stuck
}

// 难度跟档次走，四个钓场同档的一样难
export function difficultyText(level : Level) : string {
  if (level.tier == 0) {
    return '入门'
  }
  if (level.tier == 1) {
    return '进阶'
  }
  if (level.tier == 2) {
    return '困难'
  }
  return '地狱'
}
