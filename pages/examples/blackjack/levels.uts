export function allLevels() : Level[] {
  return LEVELS
}

export function levelAt(index : number) : Level {
  for (let i = 0; i < LEVELS.length; i++) {
    if (LEVELS[i].index == index) {
      return LEVELS[i]
    }
  }
  return LEVELS[0]
}

// 通过的关卡可以回去重打（刷成就、试牌组），只是不再给券
export function isPlayable(index : number, cleared : number) : boolean {
  return index <= cleared + 1
}

export function isCleared(index : number, cleared : number) : boolean {
  return index <= cleared
}

// 庄家牌组的贴纸矩阵：只用本关指定的贴纸种类，尽量摊到不同数字上
export function dealerStuck(level : Level) : number[] {
  const stuck = emptyStickers()
  const kinds = level.dealerStickerKinds
  if (kinds.length == 0) {
    return stuck
  }
  let left = level.dealerStickers
  let round = 0
  while (left > 0 && round < MAX_STICKERS_PER_RANK) {
    for (let r = 0; r < RANKS.length; r++) {
      if (left <= 0) {
        break
      }
      // J 焊着【通吃】，庄家的也一样，贴纸分不到它头上
      if (isFixedRank(RANKS[r])) {
        continue
      }
      const slot = indexOfKey(kinds[(r + round) % kinds.length])
      if (slot < 0) {
        continue
      }
      const at = stickerIndex(r, slot)
      // 庄家跟你一样，同一个数字上可以摞好几张同种贴纸，
      // 卡的只是这个数字统共 4 张牌
      if (stickersOfRank(stuck, r).length < MAX_STICKERS_PER_RANK) {
        stuck[at] = stuck[at] + 1
        left = left - 1
      }
    }
    round = round + 1
  }
  return stuck
}

export function difficultyText(level : Level) : string {
  if (level.index <= 2) {
    return '入门'
  }
  if (level.index <= 4) {
    return '普通'
  }
  if (level.index <= 6) {
    return '困难'
  }
  if (level.index <= 8) {
    return '残酷'
  }
  return '地狱'
}
