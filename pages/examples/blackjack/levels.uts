// 二十一关，四个难度档：入门 4、进阶 5、困难 6、传说 6。
//
// 只有传说那一档是按流派分的 —— 六个钓场对六条路，一关一条，
// 打的是那条路成型之后的完全体。
//
// 前三档不按流派排，因为那会儿根本组不起流派：入门打完手上也就十来张贴纸，
// 摊在 52 张牌上连一成密度都不到，硬按流派分关只会让人对着一堆凑不齐的
// 半成品发愁。所以前三档一关只教一件事 —— 这一关的庄家围着哪个机制打，
// 你就顺着那个机制想办法。够自洽、够顺、有强度，这就够了。
//
// 难度沿三条线递增：庄家牌组上的贴纸变多、庄家出牌越来越会算、局越拖越长。
// 长局更难是因为抢堆拼的是记数字：短局抢中一两个大堆就能定胜负，
// 局一长，哪个数字还剩几张没出就得自己心里有数，全靠运气撑不到最后。
//
// 每关的券只发一次。通过之后还能回去重打，但不再给券 ——
// 全程能拿到的券是固定的，所以每张券花在哪张贴纸上都是不可逆的取舍。
// 重打的用处是刷成就和试牌组。输了不扣任何东西，可以改完牌组再来。

import {
  indexOfKey,
  isFixedRank
} from '@/pages/examples/blackjack/stickers.uts'
import {
  RANKS,
  SUITS,
  emptyStickers,
  stickerIndex
} from '@/pages/examples/blackjack/cards.uts'

export type Level = {
  index : number
  name : string
  // 关卡列表一格就那么点宽，写全名放不下，格子里只写这个短名
  short : string
  // 属于哪个钓场（0 起）。只有传说关有钓场 —— 那一档才是按流派分的。
  // 前三档一律 -1：它们不归任何一条路，教的是单个机制
  //
  // 别改回 field —— 那是 Kotlin 的保留标识符，专指属性的 backing field。
  // 编译出来的响应式包装类会给每个字段配一对自定义访问器，
  // 属性名要是叫 field，访问器里就分不清说的是属性还是 backing field，当场编译不过
  spot : number
  // 难度档，跟贴纸稀有度对齐：0 入门、1 进阶、2 困难、3 传说
  tier : number
  // 通关奖励：哪种稀有度的自选兑换券、给几张。失败什么都不给
  rewardRarity : number
  rewardCount : number
  // 随机兑换券，跟自选券一起发。随机券抽到什么算什么，
  // 但抽池里有隐藏贴纸 —— 那些通关和成就都给不了，只有这条路
  randomRarity : number
  randomCount : number
  // 庄家牌组上贴的贴纸总数
  dealerStickers : number
  // 庄家牌组上用的贴纸种类，纯粹决定这关难打成什么样。
  // 前三档取这一关要教的那个机制，传说档取整条路
  dealerStickerKinds : string[]
  // 通关后解锁到货架上的贴纸。跟庄家用不用无关 ——
  // 有些贴纸庄家从来不用，照样能靠通关拿到
  unlockStickers : string[]
  // 庄家出牌策略：1 随机、2 稳健、3 精算
  ai : number
  // 庄家最先打出的几张牌盖着不给你看，结算才翻开
  dealerHidden : number
  // 重复通关给几张退换券。首次通关给的是正经券，重打给的是回炉的机会
  refundCount : number
  // 每人各打几个回合，打满就结算。双方回合数分开走，所以这是「一人几手」
  turns : number
}

export const LEVEL_COUNT : number = 21
// 四个难度档
export const TIER_COUNT : number = 4
// 四个档次的难度名，跟贴纸稀有度一一对应
export const TIER_NAMES : string[] = ['入门', '进阶', '困难', '传说']
// 钓场名，按 spot 下标。只有传说那一档用得上
export const FIELD_NAMES : string[] = [
  '浅滩钓场', '深潭钓场', '枯塘钓场', '暗流钓场', '彩滩钓场', '浑塘钓场'
]
// 每个钓场是哪条路
export const FIELD_TAGS : string[] = ['点数', '大数', '0 数', '控制', '花色', '混沌']

// 贴纸一共 80 种，四条路拿到：
//   · 免解锁 3 张（轻坠、小坠、窥探）—— 开局货架上就有；
//   · 隐藏 1 张（幸运）—— 只有随机券抽得到；
//   · 成就 8 张（福星、倒影、埋钩、暗桩、对换、假饵、撒网、摸底）—— 得先在牌桌上做到；
//   · 通关 68 张 —— 就是下面各关的 unlockStickers，二十一关分完，一张不重也一张不漏。
// 四条路互不重叠：成就那几张不放进通关解锁，否则成就就白设了。
//
// 每关解锁的都是本档次稀有度的贴纸，所以拿到券的同时货架上正好上新。
// 全程能拿到：普通 20 自选 + 8 随机、稀有 15 + 5、史诗 12 + 6、传说 6 + 0。
//
// 普通券给得比别的档宽出一截，是因为普通贴纸是地基：单张影响最小，
// 靠的是贴满同一种把抽到的概率堆上来 —— 一张轻坠是运气，四张轻坠才是流派。
// 贴纸之间的联动要几张同时在堆上才成得了，密度太低的话精心搭的组合
// 一局都碰不上一次，构筑就白做了。入门四关一共给 28 张券，
// 打完这一档手上的牌组才算真正开始有脾气
