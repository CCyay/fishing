// 四个钓场，各四关，从普通爬到传说。
//
// 一个钓场教一条路：打通它就拿齐了那条路上的全部贴纸，所以「先去哪个钓场」
// 等于「这一周目玩什么」。四个普通关一开始就都开着，随便先打哪个；
// 往后每关要求同一个钓场的上一关先通。钓场之间互不挡路 ——
// 你可以把浅滩打穿了却一次都没进过暗流。
//
// 难度沿三条线递增：庄家牌组上的贴纸变多、庄家出牌越来越会算、局越拖越长。
// 长局更难是因为抢堆拼的是记数字：短局抢中一两个大堆就能定胜负，
// 局一长，哪个数字还剩几张没出就得自己心里有数，全靠运气撑不到最后。
//
// 每关的券只发一次。通过之后还能回去重打，但不再给券 ——
// 全程能拿到的券是固定的，所以每张券花在哪张贴纸上都是不可逆的取舍。
// 重打的用处是刷成就和试牌组。输了不扣任何东西，可以改完牌组再来。

import {
  indexOfKey,
  isFixedRank
} from '@/pages/examples/blackjack/stickers.uts'
import {
  RANKS,
  SUITS,
  emptyStickers,
  stickerIndex
} from '@/pages/examples/blackjack/cards.uts'

export type Level = {
  index : number
  name : string
  // 属于哪个钓场（0 起）。一个钓场教一条路，四关从普通爬到传说。
  //
  // 别改回 field —— 那是 Kotlin 的保留标识符，专指属性的 backing field。
  // 编译出来的响应式包装类会给每个字段配一对自定义访问器，
  // 属性名要是叫 field，访问器里就分不清说的是属性还是 backing field，当场编译不过
  spot : number
  // 这一关在钓场里的档次，跟贴纸稀有度对齐：0 普通、1 稀有、2 史诗、3 传说
  tier : number
  // 通关奖励：哪种稀有度的自选兑换券、给几张。失败什么都不给
  rewardRarity : number
  rewardCount : number
  // 随机兑换券，跟自选券一起发。随机券抽到什么算什么，
  // 但抽池里有隐藏贴纸 —— 那些通关和成就都给不了，只有这条路
  randomRarity : number
  randomCount : number
  // 庄家牌组上贴的贴纸总数
  dealerStickers : number
  // 庄家牌组上用的贴纸种类，纯粹决定这关难打成什么样。
  // 一般就取本钓场那条路上的牌 —— 打谁的场子就先挨谁的招
  dealerStickerKinds : string[]
  // 通关后解锁到货架上的贴纸。跟庄家用不用无关 ——
  // 有些贴纸庄家从来不用，照样能靠通关拿到
  unlockStickers : string[]
  // 庄家出牌策略：1 随机、2 稳健、3 精算
  ai : number
  // 庄家最先打出的几张牌盖着不给你看，结算才翻开
  dealerHidden : number
  // 重复通关给几张退换券。首次通关给的是正经券，重打给的是回炉的机会
  refundCount : number
  // 每人各打几个回合，打满就结算。双方回合数分开走，所以这是「一人几手」
  turns : number
}

export const LEVEL_COUNT : number = 24
// 一个钓场几关。四关对四个稀有度
export const FIELD_TIERS : number = 4
// 钓场名，按 field 下标。关卡名是「钓场 · 关名」，这里只留钓场那半截
export const FIELD_NAMES : string[] = [
  '浅滩钓场', '深潭钓场', '枯塘钓场', '暗流钓场', '彩滩钓场', '浑塘钓场'
]
// 每个钓场教的是哪条路，列表页拿去当副标题
export const FIELD_TAGS : string[] = ['点数', '大数', '0 数', '控制', '花色', '混沌']

// 贴纸一共 80 种，四条路拿到：
//   · 免解锁 3 张（轻坠、小坠、窥探）—— 开局货架上就有；
//   · 隐藏 1 张（幸运）—— 只有随机券抽得到；
//   · 成就 8 张（福星、倒影、埋钩、暗桩、对换、假饵、撒网、摸底）—— 得先在牌桌上做到；
//   · 通关 68 张 —— 就是下面各关的 unlockStickers，六个钓场分完，一张不重。
// 四条路互不重叠：成就那几张不放进通关解锁，否则成就就白设了。
//
// 每关解锁的都是本档次的贴纸，所以拿到券的同时货架上正好上新。
// 全程能拿到：普通 18 自选 + 6 随机、稀有 12 + 6、史诗 12 + 6、传说 6 + 0，共 60 张券。
// 但单独一条路只有 11 张（3+1、2+1、2+1、1+0），配不齐一整条路 ——
// 想把一条路走深，就得拿别的钓场的券去换退换券回炉。这是刻意的：
// 六个钓场全打通能解锁所有贴纸，但券永远不够把它们全买下来。
//
// 普通券给得比别的档宽，是因为普通贴纸是地基：单张影响最小，
// 靠的是贴满同一种（上限 4 张）把抽到的概率堆上来 —— 一张轻坠是运气，
// 四张轻坠才是流派。贴纸之间的联动要几张同时在堆上才成得了，
// 密度太低的话精心搭的组合一局都碰不上一次，构筑就白做了。
