<template>
  <view class="page">
    <view class="head">
      <text class="title">商店</text>
      <view class="head-right">
        <!-- 金币后面挂着「下关利息 +N」。
             这条**必须摆在这儿**：利息要成为一个决策，你得在掏钱的那一刻
             看得见不掏的回报。摆在结算页就太晚了 —— 那时候钱已经花完了。
             它还顺带把档位说清楚：买掉 30 块掉一档的话，这个数当场就变 -->
        <text id="md-skill-gold" class="gold">金币 {{ save.gold }}{{ interestText }}</text>
        <!-- 名额。满了之后货架上的技能就买不动了 ——
             所以这个数得一直摆在眼前 -->
        <text id="md-skill-own" class="own" :class="{ 'own-full': ownedCount >= MAX_OWNED_SKILLS }"
          >技能 {{ ownedCount }}/{{ MAX_OWNED_SKILLS }}</text
        >
      </view>
    </view>
    <!-- 这一页两栏货 + 一份家当清单：
         上栏是道具（改手头已有的东西），下栏是技能和卡牌（往这一轮里添东西）。
         「把技能摆到哪个格子」那套手动分配取消了 —— 位置在拿到和升级的
         那一刻就摇定了（见 draw-skills 的 rollPlace / rollExpand） -->

    <scroll-view class="body" direction="vertical">
      <!-- ---------- 下一关的庄家 ---------- -->
      <!--
        **花色公开，点数藏着**（见 draw-skills 的 coverageHint）。

        预告它要解决的是「买的时候不知道下一关什么题」—— 从前这一页
        什么都不报，于是购买只能凭通用强度，而【弃饵】那类针对性道具
        压根没有发挥的前提（那段注释自己记着「不成立」）。

        可**全公开就把牌桌上的推理删掉了**：点数是钓牌判定那条轴，
        知道了是哪几个点数，你就能用弃饵和推点数把它们从牌组里抽干，
        一关一关做成作业。所以点数只报个数。

        这一块摆在最上面 —— 它是这一页所有决策的前提
      -->
      <view class="foe-box">
        <text class="foe-title">{{ foeTitle }}</text>
        <text v-if="foePreview.length == 0" class="foe-none">{{ foeNone }}</text>
        <view
          v-for="(one, fi) in foePreview"
          :key="'fp-' + fi"
          :id="'md-foe-' + fi"
          class="foe-row">
          <text class="foe-cover">{{ one.cover }}</text>
          <text class="foe-name">{{ one.name }}</text>
          <text class="foe-level">{{ one.level }}</text>
        </view>
      </view>

      <!-- ---------- 一次性道具 ---------- -->
      <!--
        买了**立刻用**：点一下弹出选的界面，选完生效，道具就没了。
        所以这儿没有「库存」那一层 —— 不用存买了几个、用了没有。

        改牌组那几件动的是**双方共用的那副牌**（摸打不像排竿那样对半分），
        所以你改过的牌对方也摸得到。它的收益来自「往自己技能的点数上靠」：
        那几个点数的牌变多，你的技能触发率跟着上去，而对方的技能
        摇在别的点数上，这笔改造对它没用
      -->
      <text class="section">道具</text>
      <!-- 新手引导第二步：就地提示，不盖遮罩（要让人点得到下面那件货） -->
      <view v-if="guideStep == GUIDE_BUY" id="md-guide-tip" class="guide-tip">
        <text class="guide-tip-text">点下面金框的「技能二选一」买下它，从两个技能里挑一个带进下一关</text>
      </view>
      <!-- 道具**一件一行**（横着摆格子的版本删了）。
           换成竖排是因为表里进了砺钩、洗点、三个包、四件唯一扩容 ——
           「加权」「平价」这种名字光看猜不出来，而它们一件 80 到 180 块，
           是整轮最重的几笔。买之前看不见效果那就不是取舍而是赌名字，
           而 76px 宽的格子塞不进一句说明。
           稀有度描在左边那条竖杠和档位那行小字上 -->
      <view class="goods-list">
        <text v-if="fixList.length == 0" class="section-note">这一批的道具没了。</text>
        <view
          v-for="(one, fi) in fixList"
          :key="'fx-' + fi"
          :id="'md-fix-' + one.tag"
          class="goods"
          :class="{
            'goods-rare': one.rare == RARE_RARE,
            'goods-epic': one.rare == RARE_EPIC,
            'goods-off': save.gold < one.price,
            'goods-guide': guideStep == GUIDE_BUY && one.at == guidePackAt
          }"
          @click="tapGoods(one.at)">
          <view class="goods-main">
            <view class="goods-head">
              <text class="goods-name">{{ one.name }}</text>
              <text class="fix-tier">{{ one.tier }}</text>
            </view>
            <text class="goods-desc">{{ one.desc }}</text>
          </view>
          <text class="goods-price">{{ one.price }}</text>
        </view>
      </view>

      <!-- 技能、卡牌、点数卡**混在同一栏** —— 三样是同一件事的三种形态：
           都是「花钱添一样东西进这一轮」。上面那一栏管的是「改手头已有的」。
           这一排刷得动（道具是机会，这儿是行情） -->
      <view class="shelf-head">
        <text class="section">技能 · 卡牌 · 点数</text>
        <text id="md-reroll" class="reroll" @click="doReroll">换一批 {{ rerollPrice }}</text>
      </view>
      <text v-if="skillFull" class="section-note"
        >技能名额满了（{{ MAX_OWNED_SKILLS }} 个），想换先卖掉一个。</text
      >
      <view class="fix-row">
        <view
          v-for="(one, ci) in cardList"
          :key="'cg-' + ci"
          :id="'md-card-' + ci"
          class="fix"
          :class="{
            'fix-card': !one.isSkill && !one.isPip,
            'fix-skill': one.isSkill,
            'fix-pip': one.isPip,
            'fix-off': one.sold || save.gold < one.price
          }"
          @click="tapGoods(one.at)">
          <text class="fix-name" :class="{ 'fix-red': one.red }">{{ one.name }}</text>
          <text class="fix-price">{{ one.sold ? '已买' : (one.isSkill ? one.tier + ' ' : '') + one.price }}</text>
        </view>
      </view>

      <!-- 本轮拥有的技能。没拥有的不列 —— 不能买，列出来只是看着眼馋 -->
      <text class="section">我的技能</text>
      <text v-if="ownedCount == 0" class="empty">还没有技能</text>
      <view
        v-for="k in ownedKeys"
        :key="'sk-' + k"
        :id="'md-skill-' + k"
        class="skill">
        <view class="skill-head">
          <text class="skill-name">{{ DRAW_SKILLS[k].name }}</text>
          <!-- 「优先」是个关键字（效果在钓牌判定之前结算）。
               描在名字旁边而不是塞进说明里 —— 它是一类标记，
               将来还会有别的关键字，得有个固定的位置 -->
          <text v-if="DRAW_SKILLS[k].first" class="skill-key">{{ KEYWORD_FIRST }}</text>
          <text class="skill-level">{{ levelText(k, save.levels[k]) }} · {{ kindText(k) }}</text>
        </view>
        <text class="skill-desc">{{ DRAW_SKILLS[k].desc }}</text>
        <!-- 这儿原先挂着一颗「升级 90」的按钮。升级改成买商店的【砺钩】了 ——
             有钱就能升变成了「等得到那件货」，所以这张卡上只报状态 -->
        <view class="skill-foot">
          <text class="skill-cover">{{ coverText(k) }}</text>
          <text class="skill-max">{{ upgradeHint(k) }}</text>
          <view :id="'md-sell-' + k" class="sell-btn" @click.stop="sell(k)">
            <text class="sell-text">卖出 +{{ sellPriceOf(k, save.levels[k]) }}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 退出：回关卡页，下次开启挑战还是先进这个商店（存档里记着 inShop）。
         开始下一关：离开商店，去打下一关。
         摆在所有弹窗**前面**：后渲染的层级高，摆在后面遮罩就盖不住它 -->
    <view class="back-row">
      <view id="md-exit" class="back-btn back-btn-plain" @click="goExit">
        <text class="back-text back-text-plain">退出</text>
      </view>
      <view id="md-next" class="back-btn" @click="goNext">
        <text class="back-text">开始下一关</text>
      </view>
    </view>

    <!-- 新手引导：欢迎（第一步）和收尾（第三步）。第二步是道具栏上方那张提示卡 -->
    <view v-if="guideStep == GUIDE_WELCOME || guideStep == GUIDE_END" class="mask">
      <view class="buy-box" @click.stop="noop">
        <text id="md-guide-title" class="buy-name">{{ guideStep == GUIDE_WELCOME ? '欢迎来到商店' : '拿到第一个技能了！' }}</text>
        <text class="buy-desc">{{ guideText }}</text>
        <view class="buy-actions">
          <view id="md-guide-ok" class="buy-btn" @click="guideNext">
            <text class="buy-btn-text">{{ guideStep == GUIDE_WELCOME ? '去买技能' : '知道了' }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 货品详情：**点货架上任何一件都先开这个**，确定了才真买。
         理由见脚本里 detailAt 上面那段（名字已经说不清这些货了，
         而一次误点能毁掉半轮预算）。
         买不了的时候「确定购买」压暗，并且把原因写在钮上面 ——
         点了才告诉人就太晚了 -->
    <view v-if="detailOpen" class="mask" @click="closeDetail">
      <view class="buy-box" @click.stop="noop">
        <view class="buy-head">
          <text id="md-buy-name" class="buy-name">{{ detail.name }}</text>
          <text v-if="detail.first" class="skill-key">{{ KEYWORD_FIRST }}</text>
          <text id="md-buy-price" class="buy-price">{{ detail.price }}</text>
        </view>
        <text class="buy-tag">{{ detail.tag }}</text>
        <text id="md-buy-desc" class="buy-desc">{{ detail.desc }}</text>
        <text v-if="detail.block != ''" class="buy-block">{{ detail.block }}</text>
        <view class="buy-actions">
          <view
            id="md-buy-ok"
            class="buy-btn"
            :class="{ 'buy-btn-off': detail.block != '' }"
            @click.stop="confirmBuy">
            <text class="buy-btn-text">确定购买</text>
          </view>
          <view id="md-buy-no" class="buy-btn buy-btn-plain" @click.stop="closeDetail">
            <text class="buy-btn-text buy-btn-text-plain">再看看</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 选牌：整副牌按点数摊成 13 行，点一张就是挑它。
         一次性道具买了立刻用，所以这块是「买完当场弹出来」的 -->
    <view v-if="pickMode != ''" class="mask" @click="cancelPick">
      <view class="pick-box" @click.stop="noop">
        <view class="pick-head">
          <text class="pick-title">{{ pickTitle }}</text>
          <text class="pick-sub">{{ pickMode == 'sharpen' ? '升一级' : deckSize + ' 张' }}</text>
        </view>
        <text class="pick-tip">{{ pickTip }}</text>

        <!-- 砺钩和洗点挑的是技能，不是牌 -->
        <scroll-view v-if="picksSkill" class="pick-body" direction="vertical">
          <view
            v-for="(k, si) in skillPickList"
            :key="'sh-' + si"
            :id="'md-pick-skill-' + k"
            class="my-skill my-skill-on"
            @click="onPickSkill(k)">
            <view class="my-skill-head">
              <text class="my-skill-cover">{{ coverageText(save.loadout, k) }}</text>
              <text class="my-skill-name">{{ DRAW_SKILLS[k].name }}</text>
              <text class="my-skill-level">{{ levelText(k, save.levels[k]) }}</text>
            </view>
            <text class="my-skill-desc">{{ skillPickNote(k) }}</text>
          </view>
        </scroll-view>

        <scroll-view v-else class="pick-body" direction="vertical">
          <view v-for="(row, ri) in deckRows" :key="'dr-' + ri" class="pick-line">
            <text class="pick-rank">{{ row.rank }}</text>
            <view class="pick-cards">
              <view
                v-for="(one, ci) in row.items"
                :key="'pc-' + ri + '-' + ci"
                :id="'md-pick-' + one.at"
                class="pick-card"
                :class="{
                  'pick-card-on': one.at == pickFirst,
                  'pick-card-pip': one.pipped
                }"
                @click="onPickCard(one.at)">
                <text
                  class="pick-card-text"
                  :class="{ 'fix-red': one.red, 'pick-text-pip': one.pipped }"
                  >{{ one.text }}</text
                >
              </view>
            </view>
          </view>
        </scroll-view>
        <text class="pick-close" @click.stop="cancelPick">取消</text>
      </view>
    </view>

    <!-- 开包：摊开 N 个候选，挑 1 个。
         **没有取消** —— 钱在摊开那一刻就扣了（见 openPack 上面那段），
         所以这儿只剩「挑哪个」。点遮罩也关不掉 -->
    <view v-if="packOpen" class="mask">
      <view class="pick-box" @click.stop="noop">
        <view class="pick-head">
          <text class="pick-title">{{ packTitle }}</text>
          <text class="pick-sub">挑 1 个</text>
        </view>

        <!-- 技能包：点一下只是**选中**（描金边），再点底下的钮才拿走 ——
             钱已经扣了、只能挑一次，一下误触就拿错了 -->
        <scroll-view v-if="packSkills.length > 0" class="pick-body" direction="vertical">
          <view
            v-for="(k, si) in packSkills"
            :key="'pk-' + si"
            :id="'md-pack-skill-' + k"
            class="my-skill"
            :class="{ 'my-skill-on': packPick == k, 'my-skill-off': packBlocked(si) }"
            @click="pickPackSkill(si)">
            <view class="my-skill-head">
              <text class="my-skill-name">{{ DRAW_SKILLS[k].name }}</text>
              <text v-if="DRAW_SKILLS[k].first" class="skill-key">{{ KEYWORD_FIRST }}</text>
              <view class="my-skill-gap"></view>
              <text class="my-skill-cover">{{ si < packSlots.length ? slotName(packSlots[si]) + (packBlocked(si) ? '（满了）' : '') : kindText(k) }}</text>
            </view>
            <text class="my-skill-desc">{{ DRAW_SKILLS[k].desc }}</text>
            <text class="my-skill-level">{{ DRAW_SKILLS[k].maxLevel > 0 ? '可升到 ' + DRAW_SKILLS[k].maxLevel + ' 级' : '不能升级' }}</text>
          </view>
        </scroll-view>

        <scroll-view v-else class="pick-body" direction="vertical">
          <view class="pack-cards">
            <view
              v-for="(one, ci) in packCardViews"
              :key="'pcd-' + ci"
              :id="'md-pack-card-' + ci"
              class="pack-card"
              @click="takePackCard(one.text)">
              <text class="pack-card-text" :class="{ 'fix-red': one.red }">{{ one.text }}</text>
            </view>
          </view>
        </scroll-view>
        <!-- 有候选因为槽满选不了：就地卖掉一个已有技能腾位置，卖完那个候选自己亮起来 -->
        <view v-if="packAnyBlocked" class="pack-sell">
          <text class="pack-sell-title">腾位置：卖掉一个已有技能</text>
          <view
            v-for="k in ownedKeys"
            :key="'ps-' + k"
            class="pack-sell-row">
            <text class="pack-sell-name">{{ DRAW_SKILLS[k].name }}</text>
            <text class="pack-sell-cover">{{ coverText(k) }}</text>
            <view :id="'md-pack-sell-' + k" class="sell-btn" @click.stop="sell(k)">
              <text class="sell-text">卖出 +{{ sellPriceOf(k, save.levels[k]) }}</text>
            </view>
          </view>
        </view>
        <view class="buy-actions">
          <view
            v-if="packSkills.length > 0"
            id="md-pack-ok"
            class="buy-btn"
            :class="{ 'buy-btn-off': packPick < 0 }"
            @click="confirmPackSkill">
            <text class="buy-btn-text">{{ packPick < 0 ? '先点一个技能' : '就要它' }}</text>
          </view>
          <!-- 放弃：一个都不拿。钱在摊开那一刻就扣了，不退（见 packOpen 上面那段）。
               新手引导里不给放弃 —— 那一步就是要你拿到第一个技能 -->
          <view
            v-if="guideStep != GUIDE_BUY"
            id="md-pack-skip"
            class="buy-btn buy-btn-plain"
            @click="abandonPack">
            <text class="buy-btn-text buy-btn-text-plain">放弃</text>
          </view>
        </view>
      </view>
    </view>

  </view>
</template>

<script setup lang="uts">
  import { SUITS, RANKS } from '@/pages/examples/blackjack/cards.uts'
  import {
    DRAW_SKILLS,
    KEYWORD_FIRST,
    rankCapOf,
    KIND_RANK,
    SLOT_NONE,
    SLOT_SUIT,
    SLOT_RANK,
    slotName,
    canPlaceIn,
    rollSlotFor,
    slotOf,
    rollExpand,
    washSkill,
    canUpgrade,
    coverageText,
    coverageHint,
    sellPriceOf,
    removeSkill,
    levelText,
    suitSizeOf,
    rankSizeOf
  } from '@/pages/examples/blackjack/draw-skills.uts'
  import {
    DrawSave,
    emptyDrawSave,
    loadDrawSave,
    saveDraw,
    MAX_OWNED_SKILLS,
    DRAW_RUN_LENGTH,
    ownedSkillCount,
    deckOf,
    setDeck,
    suitOfText,
    rankOfText,
    shelfGoods,
    rollShelf,
    markSold,
    rerollTimes,
    countOfRank,
    takeSkill,
    cardText,
    cardLabel,
    pipsOfText,
    addPip,
    faceOfValue,
    GOODS_PIP,
    fixSlotsOf,
    cardSlotsOf,
    rerollPriceOf,
    growShelf,
    growCard,
    growRank,
    makeFlat,
    benchedCount,
    fillBench,
    GOODS_FIX,
    GOODS_SKILL,
    drawSaveSlot,
    difficultyOf,
    fillShelfSlots,
    shopGuided,
    setShopGuided
  } from '@/pages/examples/blackjack/draw-save.uts'
  import {
    drawLevelById,
    levelForDiff,
    DECK_MIN,
    FLAT_REROLL,
    PIP_PRICE,
    interestOf,
    fixItemOf,
    packSize,
    isPack,
    rareName,
    RARE_COMMON,
    RARE_RARE,
    RARE_EPIC
  } from '@/pages/examples/blackjack/draw-levels.uts'

  const save = ref<DrawSave>(emptyDrawSave())

  function refresh() {
    save.value = loadDrawSave()
  }

  function noop() {}

  // ---------- 牌组改造 ----------

  // 货架上的一件货。at 是它在 shelfGoods 里的下标 ——
  // 买下来要按这个下标标「卖掉」，所以得一路带着
  type ShelfView = {
    at : number
    tag : string
    name : string
    price : number
    red : boolean
    isSkill : boolean
    // 点数卡（买了要挑一张牌贴上去，所以它跟买牌不是一条路）
    isPip : boolean
    // 稀有度（RARE_*）和它的名字。只有道具有，技能和卡牌一律 RARE_COMMON
    rare : number
    tier : string
    // 一句话说明。只有道具有（技能和卡牌的名字就是说明）
    desc : string
    sold : boolean
  }

  // 道具那几件。**卖掉的直接不列** —— 买完就没了，
  // 摆个「已买」的空格子只是占地方
  const fixList = computed<ShelfView[]>(() : ShelfView[] => {
    const list = shelfGoods(save.value)
    const out : ShelfView[] = []
    for (let i = 0; i < list.length; i++) {
      if (list[i].kind != GOODS_FIX || list[i].sold) {
        continue
      }
      const item = fixItemOf(list[i].tag)
      out.push({
        at: i,
        tag: list[i].tag,
        name: item.name,
        price: item.price,
        red: false,
        isSkill: false,
        isPip: false,
        rare: item.rare,
        // 唯一道具额外标一笔「唯一」—— 它比稀有度更要紧：
        // 稀有是「不常见」，唯一是「这一轮就这一次」
        tier: item.once ? rareName(item.rare) + ' · 唯一' : rareName(item.rare),
        desc: item.desc,
        sold: false
      } as ShelfView)
    }
    return out
  })

  // 道具那一栏的副标题。格数会变（买过加栏就 4 格），所以写成 computed
  // 技能和卡牌那一栏。卖掉的**留着显示「已买」** —— 跟道具相反，
  // 因为这一排刷得动，留着那一格能看出「这批我买过什么」
  const cardList = computed<ShelfView[]>(() : ShelfView[] => {
    const list = shelfGoods(save.value)
    const out : ShelfView[] = []
    for (let i = 0; i < list.length; i++) {
      const one = list[i]
      if (one.kind == GOODS_FIX) {
        continue
      }
      // 点数卡：tag 是它给的点数值，名字写成「+7」
      if (one.kind == GOODS_PIP) {
        const v = parseInt(one.tag)
        if (isNaN(v)) {
          continue
        }
        out.push({
          at: i,
          tag: one.tag,
          name: '+' + faceOfValue(v),
          price: PIP_PRICE,
          red: false,
          isSkill: false,
          isPip: true,
          rare: RARE_COMMON,
          tier: '',
          desc: '',
          sold: one.sold
        } as ShelfView)
        continue
      }
      if (one.kind == GOODS_SKILL) {
        const k = parseInt(one.tag)
        if (isNaN(k) || k >= DRAW_SKILLS.length) {
          continue
        }
        out.push({
          at: i,
          tag: one.tag,
          name: DRAW_SKILLS[k].name,
          price: DRAW_SKILLS[k].unlock,
          red: false,
          isSkill: true,
          isPip: false,
          // 这一栏不分稀有度 —— 稀有度管的是**道具**那一栏。
          // 这一栏的随机性走的是另一条路：刷新（花钱、价钱翻倍涨）
          rare: RARE_COMMON,
          // 技能借 tier 这一格标它定好的槽（「花色」/「点数」），价钱前面显示
          tier: one.slot == SLOT_SUIT ? '花色' : (one.slot == SLOT_RANK ? '点数' : ''),
          desc: '',
          sold: one.sold
        } as ShelfView)
        continue
      }
      const suit = suitOfText(one.tag)
      out.push({
        at: i,
        tag: one.tag,
        name: one.tag,
        // 价钱只看是不是 J（它通吃）
        price: rankOfText(one.tag) == 'J' ? 80 : 40,
        // ♥♦ 是红的（SUITS 的顺序是 ♠♥♦♣）
        red: suit == SUITS[1] || suit == SUITS[2],
        isSkill: false,
        isPip: false,
        rare: RARE_COMMON,
        tier: '',
        desc: '',
        sold: one.sold
      } as ShelfView)
    }
    return out
  })

  const skillFull = computed<boolean>(() : boolean => {
    return ownedCount.value >= MAX_OWNED_SKILLS
  })

  // ---------- 下一关的庄家 ----------
  //
  // 商店是打赢一关之后进的，所以 save.runLevel 已经是**下一关**的号了
  //（settleWin 推过去的）—— 直接拿它查关卡表就是你下一个对手
  type FoeSkill = {
    cover : string
    name : string
    level : string
  }

  const foePreview = computed<FoeSkill[]>(() : FoeSkill[] => {
    const out : FoeSkill[] = []
    const id = save.value.runLevel
    if (id < 1 || id > DRAW_RUN_LENGTH) {
      return out
    }
    const lv = drawLevelById(id)
    for (let k = 0; k < DRAW_SKILLS.length && k < lv.levels.length; k++) {
      if (lv.levels[k] < 0) {
        continue
      }
      out.push({
        // 花色给全，点数只报个数（见 coverageHint 那段）
        cover: coverageHint(lv.loadout, k),
        name: DRAW_SKILLS[k].name,
        level: levelText(k, lv.levels[k])
      } as FoeSkill)
    }
    return out
  })

  const foeTitle = computed<string>(() : string => {
    const id = save.value.runLevel
    if (id < 1 || id > DRAW_RUN_LENGTH) {
      return '下一关'
    }
    const lv = levelForDiff(drawLevelById(id), difficultyOf(drawSaveSlot()))
    return '下一关 · 第 ' + id + ' 关「' + lv.name + '」'
      + (lv.random ? ' · 随机出牌' : (lv.smart ? ' · 会记牌' : ' · 随手出牌'))
  })

  // 一个技能都没带的那几关（浅滩 1–4）也得说句话 ——
  // 空着会让人以为是没加载出来
  const foeNone = computed<string>(() : string => {
    const id = save.value.runLevel
    if (id < 1 || id > DRAW_RUN_LENGTH) {
      return '这一轮打完了。'
    }
    return '它不带技能。'
  })

  // 技能 / 卡牌那一栏的副标题。格数和刷新价都会被唯一道具改掉，
  // 所以两件事都在这儿报一声 —— 买过的那件得看得见它在生效
  // 「下关利息 +N」。没息就什么都不显示 ——
  // 前两三关你根本攒不到 50 块，挂个「+0」只是噪音
  const interestText = computed<string>(() : string => {
    const got = interestOf(save.value.gold)
    return got > 0 ? ' · 下关利息 +' + got : ''
  })

  // 点数槽那行小字。买过加权就把那一格点出来 ——
  // 不然「6/7」那个 7 是哪来的没人看得明白

  const deckSize = computed<number>(() : number => {
    return deckOf(save.value).length
  })

  // 走 rerollPriceOf 而不是 cardRerollCost —— 买过【平价】就是固定价
  const rerollPrice = computed<number>(() : number => {
    return rerollPriceOf(save.value)
  })

  // 换一批。**只换下栏，道具那几件原样留着** ——
  // 道具是「这一关的机会」，买完就没；技能和卡牌是「这一关的行情」，刷得动。
  //
  // 价钱翻倍涨（见 cardRerollCost）：第一次 20 块比一张牌还便宜，
  // 第三次就是 J 的价钱了。买过【平价】那条曲线就拍平成 30
  function doReroll() {
    if (guideLock()) {
      return
    }
    const cost = rerollPrice.value
    if (save.value.gold < cost) {
      uni.showToast({ title: '金币不够，换一批要 ' + cost, icon: 'none' })
      return
    }
    const data = loadDrawSave()
    data.gold = data.gold - cost
    rollShelf(data, true)
    commit(data)
  }

  // 买技能/卡牌那一栏的一件。两种货走同一个入口 ——
  // 它们在界面上混着摆，所以点击也该是同一道口子
  // ---------- 买之前先看详情 ----------
  //
  // 两栏货**点一下都是先看详情，不是直接买**。
  //
  // 为什么要加这一层：这一页的货已经不是「看名字就知道买什么」了 ——
  // 道具有十四种（加权、平价那种名字猜不出来）、技能二十多个
  // （desc 是一整句规则，还带「优先」这类关键字）、点数卡要看清它给哪个点数。
  // 而价钱从 30 到 180，一次误点能毁掉半轮的预算。
  //
  // 从前的手感是「点一下，钱就没了」或者「点一下，直接跳进选牌界面」——
  // 那在四件货、名字即说明的时候成立，现在不成立了。
  //
  // 这一层只做一件事：**把那件货摊开给你看，再问一次**。
  // 确定之后原来那套流程一个字都没改（doBuyFix / doBuyShelf），
  // 所以「挑牌挑到一半取消了不扣钱」那些规矩照旧
  const detailAt = ref<number>(-1)

  // 详情框里摆什么。
  //
  // **它永远是个对象，不是 null** —— 开没开看 ok 那一位。
  // 这么写是为了模板：`detail!.name` 那种非空断言在 uvue 模板里不保险，
  // 而 `v-if="detailOpen"` + `detail.name` 一定编得过
  type Detail = {
    ok : boolean
    name : string
    // 名字底下那行小标签：档位 / 通用还是点数槽 / 「唯一」
    tag : string
    desc : string
    price : number
    // 带「优先」关键字吗（只有技能有）
    first : boolean
    // 买不了的理由。空串表示买得了
    block : string
  }

  function noDetail() : Detail {
    return {
      ok: false, name: '', tag: '', desc: '', price: 0, first: false, block: ''
    } as Detail
  }

  const detail = computed<Detail>(() : Detail => {
    const at = detailAt.value
    if (at < 0) {
      return noDetail()
    }
    const list = shelfGoods(save.value)
    if (at >= list.length || list[at].sold) {
      return noDetail()
    }
    const one = list[at]
    if (one.kind == GOODS_FIX) {
      return fixDetail(one.tag)
    }
    if (one.kind == GOODS_SKILL) {
      return skillDetail(parseInt(one.tag), one.slot)
    }
    if (one.kind == GOODS_PIP) {
      return pipDetail(parseInt(one.tag))
    }
    return cardDetail(one.tag)
  })

  const detailOpen = computed<boolean>(() : boolean => {
    return detail.value.ok
  })

  function fixDetail(key : string) : Detail {
    const item = fixItemOf(key)
    // 查表没查着就是表里加了货没接线（见 doBuyFix 开头那道闸）
    if (item.key != key) {
      return noDetail()
    }
    // 买不了的理由在这儿就算清楚 —— 别等点了确定才告诉人
    let block = ''
    if (save.value.gold < item.price) {
      block = '金币不够'
    } else if (item.key == 'sharpen' && !hasUpgradable()) {
      block = '没有升得动的技能（满级了，或者槽满了）'
    } else if (item.key == 'wash' && ownedCount.value == 0) {
      block = '手里还没技能'
    } else if ((item.key == 'pack2' || item.key == 'pack5') && skillFull.value) {
      block = '技能名额满了（' + MAX_OWNED_SKILLS + ' 个）'
    } else if (item.key == 'drop' && deckSize.value <= DECK_MIN) {
      block = '牌组不能少于 ' + DECK_MIN + ' 张'
    }
    return {
      ok: true,
      name: item.name,
      tag: item.once ? rareName(item.rare) + ' · 唯一' : rareName(item.rare),
      desc: item.desc,
      price: item.price,
      first: false,
      block: block
    } as Detail
  }

  function skillDetail(k : number, slot : number) : Detail {
    if (isNaN(k) || k >= DRAW_SKILLS.length) {
      return noDetail()
    }
    const one = DRAW_SKILLS[k]
    let block = ''
    if (skillFull.value) {
      block = '名额满了（' + MAX_OWNED_SKILLS + ' 个），想换先卖掉一个'
    } else if (save.value.gold < one.unlock) {
      block = '金币不够'
    }
    // 技能这儿额外报两件事：能放哪个槽、能升到几级 ——
    // 两样都影响「这一百块值不值」，而货架格子上写不下
    const lv = one.maxLevel > 0 ? '可升到 ' + one.maxLevel + ' 级' : '不能升级'
    // 槽是上货时就定好的，这儿照实报；那个槽现在满着就买不了
    let where = slot == SLOT_NONE ? kindText(k) : '放进' + slotName(slot)
    if (slot != SLOT_NONE && !canPlaceIn(save.value.loadout, k, slot)) {
      where = where + '（现在满着，无法购买）'
      if (block == '') {
        block = slotName(slot) + '满着，无法购买'
      }
    }
    return {
      ok: true,
      name: one.name,
      tag: where + ' · ' + lv,
      desc: one.desc,
      price: one.unlock,
      first: one.first,
      block: block
    } as Detail
  }

  function pipDetail(v : number) : Detail {
    if (isNaN(v)) {
      return noDetail()
    }
    const face = faceOfValue(v)
    return {
      ok: true,
      name: '点数卡 +' + face,
      tag: '一次性 · 永久改一张牌',
      desc: '挑牌组里一张牌，让它**同时**也算 ' + face
        + ' 点 —— 原来那个点数照旧算，所以那张牌两头都钓得上。'
        + '牌面不变，不会变成 J，也不触发点数技。',
      price: PIP_PRICE,
      first: false,
      block: save.value.gold < PIP_PRICE ? '金币不够' : ''
    } as Detail
  }

  function cardDetail(text : string) : Detail {
    const price = rankOfText(text) == 'J' ? 80 : 40
    let block = ''
    if (save.value.gold < price) {
      block = '金币不够'
    }
    const rank = rankOfText(text)
    const same = countOfRank(save.value, rank)
    return {
      ok: true,
      name: cardLabel(text),
      tag: '加进牌组 · 现在有 ' + same + ' 张 ' + rank,
      desc: rank == 'J'
        ? 'J 通吃：堆上有牌时打出它，整堆收走。所以它比别的牌贵一倍。'
        : '加进这一轮的牌组。那个点数多一张，就多一次撞上的机会 ——'
          + '代价是牌组变厚（局更长，你技能覆盖面的占比被稀释）。',
      price: price,
      first: false,
      block: block
    } as Detail
  }

  // 点货架上一件：开详情，**不买**
  function tapGoods(at : number) {
    if (at != guidePackAt.value && guideLock()) {
      return
    }
    const list = shelfGoods(save.value)
    if (at >= list.length || list[at].sold) {
      return
    }
    detailAt.value = at
  }

  function closeDetail() {
    detailAt.value = -1
  }

  // 详情框里点「确定购买」。真正的买在这儿分流到原来那两套
  function confirmBuy() {
    const at = detailAt.value
    if (at < 0) {
      return
    }
    const one = detail.value
    if (!one.ok || one.block != '') {
      return
    }
    const list = shelfGoods(save.value)
    if (at >= list.length || list[at].sold) {
      closeDetail()
      return
    }
    const kind = list[at].kind
    closeDetail()
    if (kind == GOODS_FIX) {
      doBuyFix(at)
      return
    }
    doBuyShelf(at)
  }

  function doBuyShelf(at : number) {
    const list = shelfGoods(save.value)
    if (at >= list.length || list[at].sold) {
      return
    }
    if (list[at].kind == GOODS_SKILL) {
      buySkill(at, parseInt(list[at].tag), list[at].slot)
      return
    }
    // 点数卡要挑一张牌贴上去，所以它走选牌那条路（**先不扣钱**，
    // 跟改造道具一个待遇：挑到一半取消了不该白花）
    if (list[at].kind == GOODS_PIP) {
      const v = parseInt(list[at].tag)
      if (isNaN(v)) {
        return
      }
      if (save.value.gold < PIP_PRICE) {
        uni.showToast({ title: '金币不够', icon: 'none' })
        return
      }
      pickMode.value = 'pip'
      pickStep.value = v
      pickAt.value = at
      pickPrice.value = PIP_PRICE
      pickFirst.value = -1
      return
    }
    const text = list[at].tag
    const price = rankOfText(text) == 'J' ? 80 : 40
    if (save.value.gold < price) {
      uni.showToast({ title: '金币不够', icon: 'none' })
      return
    }
    const data = loadDrawSave()
    data.gold = data.gold - price
    const cards = deckOf(data)
    cards.push(text)
    setDeck(data, cards)
    markSold(data, at)
    commit(data)
    uni.showToast({ title: text + ' 加进牌组了', icon: 'none' })
  }

  // 买一个技能。名额满了买不动 —— 想换先卖掉一个
  function buySkill(at : number, k : number, slot : number) {
    if (isNaN(k) || k >= DRAW_SKILLS.length) {
      return
    }
    if (skillFull.value) {
      uni.showToast({
        title: '名额满了（' + MAX_OWNED_SKILLS + ' 个），先卖掉一个',
        icon: 'none'
      })
      return
    }
    if (slot != SLOT_NONE && !canPlaceIn(save.value.loadout, k, slot)) {
      uni.showToast({ title: slotName(slot) + '满着，无法购买', icon: 'none' })
      return
    }
    const price = DRAW_SKILLS[k].unlock
    if (save.value.gold < price) {
      uni.showToast({ title: '金币不够', icon: 'none' })
      return
    }
    const data = loadDrawSave()
    data.gold = data.gold - price
    const note = takeSkill(data, k, slot)
    markSold(data, at)
    commit(data)
    uni.showToast({ title: note, icon: 'none' })
  }

  // ---------- 买了立刻用 ----------
  //
  // pickMode 不是空串就表示「正等你挑牌」。
  // push 系要挑一张再问方向（往上还是往下）；同化要挑两张
  const pickMode = ref<string>('')
  const pickStep = ref<number>(0)
  const pickFirst = ref<number>(-1)
  // 正在用的是货架上第几件、多少钱。改完才扣钱、才标卖掉 ——
  // 挑牌挑到一半取消了不该白花
  const pickAt = ref<number>(-1)
  const pickPrice = ref<number>(0)

  const pickTitle = computed<string>(() : string => {
    if (pickMode.value == 'same') {
      return '同化'
    }
    if (pickMode.value == 'drop') {
      return '弃饵'
    }
    if (pickMode.value == 'pip') {
      return '点数卡 +' + faceOfValue(pickStep.value)
    }
    if (pickMode.value == 'wash') {
      return '洗点'
    }
    return pickMode.value == 'sharpen' ? '砺钩' : '推 ' + pickStep.value + ' 格'
  })

  // 挑技能那两件（砺钩、洗点）列哪几个。
  //
  // 砺钩只列**升得动的**（等级没满 + 槽里有空格）；
  // 洗点列**所有手里有的** —— 它是重摇位置，跟等级和空格没关系
  const skillPickList = computed<number[]>(() : number[] => {
    const out : number[] = []
    for (let k = 0; k < DRAW_SKILLS.length; k++) {
      if (save.value.levels[k] < 0) {
        continue
      }
      if (pickMode.value == 'sharpen'
        && !canUpgrade(save.value.loadout, save.value.levels, k)) {
        continue
      }
      out.push(k)
    }
    return out
  })

  // 买砺钩之前先看有没有升得动的（买了才发现没地方升就太坑了）
  function hasUpgradable() : boolean {
    for (let k = 0; k < DRAW_SKILLS.length; k++) {
      if (canUpgrade(save.value.loadout, save.value.levels, k)) {
        return true
      }
    }
    return false
  }

  const pickTip = computed<string>(() : string => {
    if (pickMode.value == 'same') {
      return pickFirst.value < 0
        ? '先点一张当样子'
        : '再点一张，它会变成上面那张'
    }
    if (pickMode.value == 'drop') {
      return '点一张牌，从牌组里拿掉'
    }
    if (pickMode.value == 'sharpen') {
      return '点一个技能升一级'
    }
    if (pickMode.value == 'wash') {
      return '点一个技能，重摇它占的位置'
    }
    if (pickMode.value == 'pip') {
      return '点一张牌，让它也算 ' + faceOfValue(pickStep.value) + ' 点'
    }
    return '点一张牌，然后选往上推还是往下推'
  })

  // 这一件挑的是技能还是牌
  const picksSkill = computed<boolean>(() : boolean => {
    return pickMode.value == 'sharpen' || pickMode.value == 'wash'
  })

  // 技能那一行底下写什么：砺钩报「管几个 → 几个」，洗点报现在管着什么
  function skillPickNote(k : number) : string {
    const level = save.value.levels[k]
    if (pickMode.value == 'sharpen') {
      return '升到 ' + levelText(k, level + 1) + '，管 '
        + rankSizeOf(level) + ' 个点数 → ' + rankSizeOf(level + 1) + ' 个'
    }
    return DRAW_SKILLS[k].desc
  }

  function onPickSkill(k : number) {
    if (pickMode.value == 'sharpen') {
      doSharpen(k)
      return
    }
    doWash(k)
  }

  // 洗点：把这个技能占的位置重摇一遍，槽不变（见 draw-skills 的 washSkill）
  function doWash(k : number) {
    const data = loadDrawSave()
    if (data.levels[k] < 0) {
      cancelPick()
      return
    }
    const was = coverageText(data.loadout, k)
    data.loadout = washSkill(data.loadout, data.levels, k)
    data.gold = data.gold - pickPrice.value
    markSold(data, pickAt.value)
    commit(data)
    const now = coverageText(data.loadout, k)
    cancelPick()
    uni.showToast({
      title: DRAW_SKILLS[k].name + '：' + (was == '' ? '未装' : was)
        + ' → ' + (now == '' ? '未装' : now),
      icon: 'none'
    })
  }

  // 整副牌按点数摊成 13 行。at 是它在牌组数组里的下标 ——
  // 改造要按下标改，所以得一路带着。
  //
  // 行分组按**牌面点数**（rankOfText 会切掉 '+' 后面那截），
  // 所以一张 ♠3·7 还是排在 3 那一行 —— 它牌面就是 3
  type PickItem = {
    at : number
    text : string
    red : boolean
    // 贴过点数卡吗。贴过的要描一下，不然挑牌的时候看不出哪张已经加强过
    pipped : boolean
  }

  type PickRow = {
    rank : string
    items : PickItem[]
  }

  const deckRows = computed<PickRow[]>(() : PickRow[] => {
    const cards = deckOf(save.value)
    const rows : PickRow[] = []
    for (let r = 0; r < RANKS.length; r++) {
      const items : PickItem[] = []
      for (let i = 0; i < cards.length; i++) {
        if (rankOfText(cards[i]) != RANKS[r]) {
          continue
        }
        const suit = suitOfText(cards[i])
        items.push({
          at: i,
          // 写 cardLabel 而不是原文：♠3+7 在界面上是「♠3·7」
          text: cardLabel(cards[i]),
          red: suit == SUITS[1] || suit == SUITS[2],
          pipped: pipsOfText(cards[i]).length > 0
        } as PickItem)
      }
      rows.push({ rank: RANKS[r], items: items } as PickRow)
    }
    return rows
  })

  function doBuyFix(at : number) {
    const list = shelfGoods(save.value)
    if (at >= list.length || list[at].sold) {
      return
    }
    const item = fixItemOf(list[at].tag)
    // **货架上这件和表里对不上就什么都不做。**
    //
    // fixItemOf 查不到的时候返回表里第 0 件（推一格）—— 那是个方便的兜底，
    // 可在这儿它是个陷阱：key 认不出来就会静默地卖成另一件货。
    // 【加架】和【平价】写进表之后、接线之前正是这么坏的：
    // 它们掉进下面那个 else，被当成「同化」卖了（标价还正好一样）。
    //
    // 所以这道闸要摆在最前面：对不上就报一句、不扣钱。
    // 下次往表里加货，漏接线会当场看得见
    if (item.key != list[at].tag) {
      uni.showToast({ title: '这件货还没接线（' + list[at].tag + '）', icon: 'none' })
      return
    }
    if (save.value.gold < item.price) {
      uni.showToast({ title: '金币不够', icon: 'none' })
      return
    }
    // 开包是另一路：它当场扣钱、当场标卖掉（理由见 openPack 上面那段）
    if (isPack(item.key)) {
      openPack(at, item.key, item.price)
      return
    }
    // 四件唯一扩容也是当场结清的：它们不用挑什么 —— 点一下，
    // 规则里那个数就变了。所以没有「挑到一半取消」那回事
    if (item.once) {
      buyGrow(at, item.key, item.price)
      return
    }
    // **先不扣钱** —— 挑牌挑到一半取消了不该白花。
    // 扣钱、标卖掉都在真正改完那一刻（doPush / doSame / doDrop）
    if (item.key == 'sharpen') {
      // 砺钩挑的是技能，不是牌 —— 先看有没有升得动的
      if (!hasUpgradable()) {
        uni.showToast({ title: '没有升得动的技能（满级了，或者槽满了）', icon: 'none' })
        return
      }
      pickMode.value = 'sharpen'
    } else if (item.key == 'wash') {
      if (ownedCount.value == 0) {
        uni.showToast({ title: '手里还没技能', icon: 'none' })
        return
      }
      pickMode.value = 'wash'
    } else if (item.step > 0) {
      pickMode.value = 'push'
    } else if (item.key == 'drop') {
      pickMode.value = 'drop'
    } else if (item.key == 'same') {
      pickMode.value = 'same'
    } else {
      // 走到这儿就是表里加了货、这个分支没跟上。
      // **不猜**（从前这儿是 `: 'same'`，于是认不出来的一律卖成同化）
      uni.showToast({ title: '这件货还没接线（' + item.key + '）', icon: 'none' })
      return
    }
    pickStep.value = item.step
    pickAt.value = at
    pickPrice.value = item.price
    pickFirst.value = -1
  }

  function cancelPick() {
    pickMode.value = ''
    pickFirst.value = -1
    pickStep.value = 0
    pickAt.value = -1
    pickPrice.value = 0
  }

  // ---------- 四件唯一扩容（加栏、加架、加权、平价） ----------
  //
  // 全是**唯一**道具：一轮只买得到一次，买过就不再上货
  //（见 draw-save 的 takenOnceKeys）。这儿那道「已经买过」的闸
  // 是第二层保险 —— 手快点两下不该买两次。
  //
  // 这四件是全表唯一改**规则**的货。别的道具改的是「我手里多了什么」，
  // 这四件改的是「这一轮我能有多少」：
  //
  //   加栏 —— 道具栏宽一格。那一栏**刷不动**，所以它纯粹是运气面变宽。
  //   加架 —— 技能/卡牌栏宽一格。那一栏**刷得动**，所以它还让每次刷新更值。
  //   加权 —— 点数槽多一格，也就是多一次升级的余量。
  //   平价 —— 刷新价拍平成 30，不再翻倍。
  //
  // 四件里三件是「**越早买越值**」（加栏、加架、平价都是按剩下的关数折现），
  // 只有加权什么时候买都一样值。那也是加权能压成史诗、
  // 另外三件压在稀有和普通的理由（见 FIX_ITEMS 里各自那段）。
  //
  // 加权**只抬容量、不填格子**：多出来那一格是空的，得再刷到砺钩
  // 才用得上。所以它买的是「升得动」，不是「升一级」——
  // 不然 180 块就等于一个打折的砺钩，那两件货就重了
  function buyGrow(at : number, key : string, price : number) {
    if (save.value.gold < price) {
      uni.showToast({ title: '金币不够', icon: 'none' })
      return
    }
    const data = loadDrawSave()
    // 买加权之前先数一下库里躺着几个 —— growRank 会顺手把装得下的
    // 都装上去（fillBench），装完就数不出来了
    const benched = key == 'weight' ? benchedCount(data) : 0
    let done = false
    if (key == 'shelf') {
      done = growShelf(data)
    } else if (key == 'card') {
      done = growCard(data)
    } else if (key == 'flat') {
      done = makeFlat(data)
    } else {
      done = growRank(data)
    }
    if (!done) {
      uni.showToast({ title: '这件已经买过了', icon: 'none' })
      return
    }
    data.gold = data.gold - price
    markSold(data, at)
    commit(data)
    uni.showToast({ title: growNote(key, data, benched), icon: 'none' })
  }

  // 买完报什么。每一件都要说清**什么时候生效** ——
  // 这四件没有一个是「当场看得见」的，不说的话会像没反应
  function growNote(key : string, data : DrawSave, benched : number) : string {
    if (key == 'shelf') {
      // 道具那一栏刷新不补货（见 rollShelf 的 keepFix），所以只能等下一关
      return '道具栏变成 ' + fixSlotsOf(data) + ' 格（下一关的货开始生效）'
    }
    if (key == 'card') {
      // 这一栏刷新会重摇，所以当场刷一次就看得见多出来的那格
      return '技能/卡牌栏变成 ' + cardSlotsOf(data) + ' 格（换一批就看得见）'
    }
    if (key == 'flat') {
      return '换一批固定 ' + FLAT_REROLL + ' 块了，不再翻倍'
    }
    return benched > 0
      ? '点数槽变成 ' + rankCapOf(data.loadout) + ' 格，库里那个当场装上了'
      : '点数槽变成 ' + rankCapOf(data.loadout) + ' 格 —— 空着的，等砺钩来填'
  }

  // ---------- 开包（技能二选一 / 五选一 / 牌六选一） ----------

  // 摇出来的候选。技能装技能下标，牌装牌面文本
  const packSkills = ref<number[]>([] as number[])
  // 跟 packSkills 一一对应：每个候选摊开时定好的槽
  const packSlots = ref<number[]>([] as number[])
  const packCards = ref<string[]>([] as string[])
  // 开包是**先扣钱后挑**，跟别的道具相反。
  //
  // 别的道具是「挑到一半取消了不该白花」，可开包一摊开就把随机结果
  // 给你看了 —— 要是能看完再取消，那就是免费窥牌：看一眼不满意退掉，
  // 下次再买（同一件货），等于花 0 块无限重摇。所以钱在摆出候选那一刻就扣，
  // 货也那一刻就标卖掉；挑哪一个是你唯一剩下的自由
  const packOpen = computed<boolean>(() : boolean => {
    return packSkills.value.length > 0 || packCards.value.length > 0
  })

  const packTitle = computed<string>(() : string => {
    return packSkills.value.length > 0
      ? '技能 ' + packSkills.value.length + ' 选 1'
      : '牌 ' + packCards.value.length + ' 选 1'
  })

  type PackCard = {
    text : string
    red : boolean
  }

  const packCardViews = computed<PackCard[]>(() : PackCard[] => {
    const out : PackCard[] = []
    for (let i = 0; i < packCards.value.length; i++) {
      const suit = suitOfText(packCards.value[i])
      out.push({
        text: packCards.value[i],
        red: suit == SUITS[1] || suit == SUITS[2]
      } as PackCard)
    }
    return out
  })

  // 买一个包：当场摇候选、当场扣钱、当场标卖掉
  function openPack(at : number, key : string, price : number) {
    const want = packSize(key)
    if (key == 'cards6') {
      const drawn : string[] = []
      for (let i = 0; i < want; i++) {
        const suit = SUITS[Math.floor(Math.random() * SUITS.length)]
        const rank = RANKS[Math.floor(Math.random() * RANKS.length)]
        // **不去重** —— 摇出两张一样的是真有可能的事，
        // 而「六张里有两张重了」本身就是这一包的运气
        drawn.push(cardText(suit, rank))
      }
      const data = loadDrawSave()
      data.gold = data.gold - price
      markSold(data, at)
      commit(data)
      packCards.value = drawn
      return
    }
    // 技能包。名额满了开不了 —— 开出来没处放等于白花
    if (skillFull.value) {
      uni.showToast({
        title: '名额满了（' + MAX_OWNED_SKILLS + ' 个），先卖掉一个',
        icon: 'none'
      })
      return
    }
    // 只摇**手里没有的** —— 同名只有一个，摇到已有的等于少一个选项
    const free : number[] = []
    for (let k = 0; k < DRAW_SKILLS.length; k++) {
      if (save.value.levels[k] < 0) {
        free.push(k)
      }
    }
    if (free.length == 0) {
      uni.showToast({ title: '技能全齐了', icon: 'none' })
      return
    }
    // 候选之间去重（跟牌不同：摇出两个一样的技能就是少给了一个选项）。
    // 池子不够 want 个就给几个算几个。
    //
    // 挑掉一个之后整个换成剩下那些 —— UTS 那边数组删不了元素，
    // 只能换引用（跟 rollShelf 里那段一个写法）
    const picks : number[] = []
    let pool : number[] = free
    for (let i = 0; i < want && pool.length > 0; i++) {
      const at2 = Math.floor(Math.random() * pool.length)
      picks.push(pool[at2])
      const rest : number[] = []
      for (let j = 0; j < pool.length; j++) {
        if (j != at2) {
          rest.push(pool[j])
        }
      }
      pool = rest
    }
    // 每个候选摊开时就定好槽，弹窗里看得见
    const slots : number[] = []
    for (let i = 0; i < picks.length; i++) {
      slots.push(rollSlotFor(picks[i]))
    }
    const data = loadDrawSave()
    data.gold = data.gold - price
    markSold(data, at)
    commit(data)
    packSlots.value = slots
    packSkills.value = picks
  }

  function clearPack() {
    packSkills.value = [] as number[]
    packSlots.value = [] as number[]
    packCards.value = [] as string[]
    packPick.value = -1
  }

  // 放弃这一包：一个都不拿。钱不退 —— 摊开那一刻就扣了（理由见 packOpen 上面那段）
  function abandonPack() {
    uni.showModal({
      title: '放弃这一包？',
      content: '一个都不拿，花的钱不退。',
      confirmText: '放弃',
      cancelText: '再看看',
      success: (res) => {
        if (res.confirm) {
          clearPack()
        }
      }
    })
  }

  // 技能包里选中的那个（技能下标），-1 = 还没选
  const packPick = ref<number>(-1)

  // 这个候选定好的槽现在满着：选不了
  function packBlocked(si : number) : boolean {
    if (si >= packSkills.value.length || si >= packSlots.value.length) {
      return false
    }
    const slot = packSlots.value[si]
    return slot != SLOT_NONE && !canPlaceIn(save.value.loadout, packSkills.value[si], slot)
  }

  const packAnyBlocked = computed<boolean>(() : boolean => {
    for (let i = 0; i < packSkills.value.length; i++) {
      if (packBlocked(i)) {
        return true
      }
    }
    return false
  })

  function pickPackSkill(si : number) {
    if (packBlocked(si)) {
      uni.showToast({ title: slotName(packSlots.value[si]) + '满着，无法选择', icon: 'none' })
      return
    }
    packPick.value = packSkills.value[si]
  }

  function confirmPackSkill() {
    if (packPick.value < 0) {
      return
    }
    takePackSkill(packPick.value)
  }

  function takePackSkill(k : number) {
    let slot = SLOT_NONE
    for (let i = 0; i < packSkills.value.length && i < packSlots.value.length; i++) {
      if (packSkills.value[i] == k) {
        slot = packSlots.value[i]
      }
    }
    const data = loadDrawSave()
    const note = takeSkill(data, k, slot)
    commit(data)
    clearPack()
    if (guideStep.value == GUIDE_BUY) {
      // 引导里买的那一个：不弹 toast，换成收尾那一页
      guideStep.value = GUIDE_END
      return
    }
    uni.showToast({ title: note, icon: 'none' })
  }

  // ---------- 新手引导 ----------
  //
  // 每个存档第一次进店走一遍：欢迎 → 买下【技能二选一】并挑一个 → 收尾。
  // 第二步**拦住别的操作**（别的货、换一批、卖出、退出、开始下一关），
  // 只放那件二选一过去 —— 第一店一定上它、第 1 关的奖励也够买（见 rollShelf、DRAW_LEVELS）。
  // 老档第一次进店时货架上没有它、或者钱不够，就只给欢迎页，不强买
  const GUIDE_NONE : number = 0
  const GUIDE_WELCOME : number = 1
  const GUIDE_BUY : number = 2
  const GUIDE_END : number = 3
  const guideStep = ref<number>(GUIDE_NONE)

  const guideText = computed<string>(() : string => {
    if (guideStep.value == GUIDE_WELCOME) {
      return '过关赢来的金币在这儿花：买技能、买牌、改牌组。没花完的钱每关还会生利息。'
        + '\n\n第一次来，先买一个技能带进下一关吧。'
    }
    return '技能占着几个花色或点数（写在下面「我的技能」里），打出的牌落在上面就会触发。'
      + '\n\n剩下的钱可以接着逛，也可以攒着吃利息。'
  })

  // 货架上还没卖掉的那件技能二选一的下标，没有就 -1
  const guidePackAt = computed<number>(() : number => {
    const list = shelfGoods(save.value)
    for (let i = 0; i < list.length; i++) {
      if (list[i].kind == GOODS_FIX && list[i].tag == 'pack2' && !list[i].sold) {
        return i
      }
    }
    return -1
  })

  function startGuide() {
    if (guideStep.value != GUIDE_NONE || shopGuided(drawSaveSlot())) {
      return
    }
    guideStep.value = GUIDE_WELCOME
  }

  function guideNext() {
    if (guideStep.value == GUIDE_WELCOME) {
      if (guidePackAt.value >= 0 && save.value.gold >= fixItemOf('pack2').price) {
        guideStep.value = GUIDE_BUY
        return
      }
    }
    // 收尾，或者买不成二选一的老档：引导到此为止
    guideStep.value = GUIDE_NONE
    setShopGuided(drawSaveSlot())
  }

  // 第二步里拦操作：拦下了返回 true
  function guideLock() : boolean {
    if (guideStep.value != GUIDE_BUY) {
      return false
    }
    uni.showToast({ title: '先买下「技能二选一」', icon: 'none' })
    return true
  }

  function takePackCard(text : string) {
    const data = loadDrawSave()
    const cards = deckOf(data)
    cards.push(text)
    setDeck(data, cards)
    commit(data)
    clearPack()
    uni.showToast({ title: text + ' 加进牌组了', icon: 'none' })
  }

  // 包摊开着就离开页面的话，**替你拿第一个** ——
  // 钱已经扣了，候选也已经摇定，这时候两手空空出去纯属亏。
  // 拿第一个是任意的，但它好过什么都不给
  function autoTakePack() {
    if (packSkills.value.length > 0) {
      for (let i = 0; i < packSkills.value.length; i++) {
        if (!packBlocked(i)) {
          takePackSkill(packSkills.value[i])
          return
        }
      }
      // 全都选不了：等于放弃
      clearPack()
      return
    }
    if (packCards.value.length > 0) {
      takePackCard(packCards.value[0])
    }
  }

  function onPickCard(at : number) {
    if (pickMode.value == 'drop') {
      askDrop(at)
      return
    }
    if (pickMode.value == 'pip') {
      doPip(at)
      return
    }
    if (pickMode.value == 'same') {
      if (pickFirst.value < 0) {
        pickFirst.value = at
        return
      }
      if (pickFirst.value == at) {
        // 点同一张等于取消选中
        pickFirst.value = -1
        return
      }
      doSame(pickFirst.value, at)
      return
    }
    askPush(at)
  }

  // 推点数：往上还是往下，挑完牌当场问
  function askPush(at : number) {
    const cards = deckOf(save.value)
    if (at >= cards.length) {
      return
    }
    uni.showModal({
      title: '推 ' + pickStep.value + ' 格',
      content: cards[at] + ' 往哪边推？点数到 A 和 K 就停，不绕圈。',
      confirmText: '往上 +' + pickStep.value,
      cancelText: '往下 −' + pickStep.value,
      success: (res) => {
        doPush(at, res.confirm ? pickStep.value : -pickStep.value)
      }
    })
  }

  // 点数挪 delta 格。**到 A 和 K 就停，不绕圈** ——
  // 绕圈的话「推三格」能把 K 变成 3，那就不是「推」而是「随便改」了，
  // 而「挑一张接近目标点数的牌」这个决策正是这件道具的全部内容
  function doPush(at : number, delta : number) {
    const data = loadDrawSave()
    const cards = deckOf(data)
    if (at >= cards.length) {
      cancelPick()
      return
    }
    const suit = suitOfText(cards[at])
    const was = rankIndexOf(rankOfText(cards[at]))
    if (was < 0) {
      cancelPick()
      return
    }
    let to = was + delta
    if (to < 0) {
      to = 0
    }
    if (to > RANKS.length - 1) {
      to = RANKS.length - 1
    }
    if (to == was) {
      uni.showToast({ title: '已经到头了，推不动', icon: 'none' })
      cancelPick()
      return
    }
    const wasText = cards[at]
    // **点数卡贴的那几个点数留着** —— 推的是牌面那个点数，
    // 不是「把这张牌重做一遍」。不留的话「先贴点数卡再推一格」
    // 会把九十块悄悄抹掉
    let next = suit + RANKS[to]
    const pips = pipsOfText(wasText)
    for (let i = 0; i < pips.length; i++) {
      next = addPip(next, pips[i])
    }
    cards[at] = next
    data.gold = data.gold - pickPrice.value
    setDeck(data, cards)
    // 这会儿才标卖掉 —— 改成了才算买了
    markSold(data, pickAt.value)
    commit(data)
    uni.showToast({
      title: cardLabel(wasText) + ' → ' + cardLabel(cards[at]),
      icon: 'none'
    })
    cancelPick()
  }

  // 点数卡：给这张牌贴一个额外点数，它从此**同时**算几个点数。
  //
  // 牌面不动 —— 所以它不会变成 J（通吃焊在 rank 上），也不触发点数技
  //（triggersOf 读的是 rank）。它只多了一条钓牌的出路，
  // 详见 draw-levels 的 PIP_PRICE 那段
  function doPip(at : number) {
    const data = loadDrawSave()
    const cards = deckOf(data)
    if (at >= cards.length) {
      cancelPick()
      return
    }
    const was = cards[at]
    const next = addPip(was, pickStep.value)
    if (next == was) {
      // 贴重了。**不扣钱** —— 这张已经算那个点数了，贴上去一点用没有
      uni.showToast({ title: '这张已经算 ' + faceOfValue(pickStep.value) + ' 点了', icon: 'none' })
      return
    }
    cards[at] = next
    data.gold = data.gold - pickPrice.value
    setDeck(data, cards)
    markSold(data, pickAt.value)
    commit(data)
    uni.showToast({
      title: cardLabel(was) + ' → ' + cardLabel(next) + '（两个点数都算）',
      icon: 'none'
    })
    cancelPick()
  }

  // 同化：右边那张**完全变成**左边那张 —— 点数、花色、
  // **连点数卡贴的那几个点数一起**（它是整张照抄）。
  //
  // 于是牌组里会出现两张一模一样的牌。规则上没冲突（牌只按点数、花色
  // 参与判定，没有唯一性约束），而那两张必然互相钓得上 —— 这就是买它的理由。
  //
  // 「连点数卡一起抄」让它多了一个用法：贴好一张核心牌，
  // 再花一百块复制一张。两张加起来比贴两次点数卡（180）便宜
  function doSame(from : number, to : number) {
    const data = loadDrawSave()
    const cards = deckOf(data)
    if (from >= cards.length || to >= cards.length) {
      cancelPick()
      return
    }
    const was = cards[to]
    cards[to] = cards[from]
    data.gold = data.gold - pickPrice.value
    setDeck(data, cards)
    markSold(data, pickAt.value)
    commit(data)
    uni.showToast({ title: was + ' → ' + cards[to], icon: 'none' })
    cancelPick()
  }

  // 弃饵：问一句再删。删牌是不可逆的，而且一次性道具买了就用掉了
  function askDrop(at : number) {
    const cards = deckOf(save.value)
    if (at >= cards.length) {
      return
    }
    if (cards.length <= DECK_MIN) {
      uni.showToast({ title: '牌组不能少于 ' + DECK_MIN + ' 张', icon: 'none' })
      return
    }
    const left = countOfRank(save.value, rankOfText(cards[at])) - 1
    uni.showModal({
      title: '弃饵',
      content: '把 ' + cards[at] + ' 从牌组里拿掉？拿掉之后这个点数还剩 '
        + left + ' 张。' + (left == 0 ? '（这个点数就从牌组里消失了）' : ''),
      confirmText: '拿掉',
      cancelText: '再想想',
      success: (res) => {
        if (res.confirm) {
          doDrop(at)
        }
      }
    })
  }

  function doDrop(at : number) {
    const data = loadDrawSave()
    const cards = deckOf(data)
    if (at >= cards.length || cards.length <= DECK_MIN) {
      cancelPick()
      return
    }
    const was = cards[at]
    const next : string[] = []
    for (let i = 0; i < cards.length; i++) {
      if (i != at) {
        next.push(cards[i])
      }
    }
    data.gold = data.gold - pickPrice.value
    setDeck(data, next)
    markSold(data, pickAt.value)
    commit(data)
    uni.showToast({ title: was + ' 从牌组里拿掉了', icon: 'none' })
    cancelPick()
  }

  function rankIndexOf(rank : string) : number {
    for (let i = 0; i < RANKS.length; i++) {
      if (RANKS[i] == rank) {
        return i
      }
    }
    return -1
  }

  function kindText(k : number) : string {
    return DRAW_SKILLS[k].kind == KIND_RANK ? '只放点数槽' : '通用'
  }

  // 技能卡右边那行状态：升得动、满级了、还是槽满了升不动。
  //
  // 升级本身走商店的【砺钩】，所以这儿只报状态不给按钮 ——
  // 「槽满了」那一条尤其要说出来，不然你买了砺钩才发现没地方升
  function upgradeHint(k : number) : string {
    const level = save.value.levels[k]
    if (level < 0) {
      return ''
    }
    if (level >= DRAW_SKILLS[k].maxLevel) {
      return '已满级'
    }
    return canUpgrade(save.value.loadout, save.value.levels, k)
      ? '可升级'
      : '槽满了'
  }

  const ownedCount = computed<number>(() : number => {
    return ownedSkillCount(save.value)
  })

  // 拥有的技能下标（等级 >= 0 的），「我的技能」那一栏就列这些
  const ownedKeys = computed<number[]>(() : number[] => {
    const out : number[] = []
    for (let k = 0; k < DRAW_SKILLS.length; k++) {
      if (save.value.levels[k] >= 0) {
        out.push(k)
      }
    }
    return out
  })

  // 技能卡底下那行：装在哪、管着什么；没装就说能管多大
  function coverText(k : number) : string {
    const level = save.value.levels[k]
    if (level < 0) {
      return '未解锁'
    }
    const where = slotOf(save.value.loadout, k)
    if (where == SLOT_NONE) {
      const suitPart = DRAW_SKILLS[k].kind == KIND_RANK ? '' : '花色槽 ' + suitSizeOf(level) + ' 格 / '
      return '未装 · 可占 ' + suitPart + '点数槽 ' + rankSizeOf(level) + ' 格'
    }
    return (where == SLOT_SUIT ? '花色槽：' : '点数槽：') + coverageText(save.value.loadout, k)
  }

  function commit(data : DrawSave) {
    saveDraw(data)
    save.value = data
  }

  // 用砺钩升一级。钱在这儿扣 —— 挑到一半取消了不该白花
  function doSharpen(k : number) {
    const data = loadDrawSave()
    if (!canUpgrade(data.loadout, data.levels, k)) {
      uni.showToast({ title: '这个升不动了', icon: 'none' })
      return
    }
    data.gold = data.gold - pickPrice.value
    data.levels[k] = data.levels[k] + 1
    // 该多占的那一格当场摇出来，已经占着的不动 ——
    // 升级买的是「多管一格」，摇的是「多管哪一格」
    data.loadout = rollExpand(data.loadout, data.levels, k)
    markSold(data, pickAt.value)
    commit(data)
    cancelPick()
    uni.showToast({
      title: DRAW_SKILLS[k].name + ' ' + levelText(k, data.levels[k])
        + ' · 管 ' + coverageText(data.loadout, k),
      icon: 'none'
    })
  }

  function sell(k : number) {
    if (guideLock()) {
      return
    }
    const level = save.value.levels[k]
    if (level < 0) {
      return
    }
    const price = sellPriceOf(k, level)
    uni.showModal({
      title: '卖出' + DRAW_SKILLS[k].name,
      content: levelText(k, level) + '的' + DRAW_SKILLS[k].name + '卖 ' + price
        + ' 金币？卖了要再有得等它重新上货。',
      success: (res) => {
        if (!res.confirm) {
          return
        }
        const data = loadDrawSave()
        data.gold = data.gold + price
        data.levels[k] = -1
        data.loadout = removeSkill(data.loadout, k)
        // 腾出来的格子让库里躺着的当场顶上去（跟买加权一个待遇，
        // 见 draw-save 的 fillBench）—— 「槽里空出位置」只该有一条后果
        const up = fillBench(data)
        commit(data)
        if (up > 0) {
          uni.showToast({ title: '腾出的位子让库里那 ' + up + ' 个顶上了', icon: 'none' })
        }
      }
    })
  }

  // 原先这儿有 tapSuit / tapRank（点格子手动分配）和 pick（选中技能），
  // 整套删掉了 —— 位置在拿到和升级那一刻就摇定，格子现在是只读的。
  //
  // 卖出留着，而且它是你能影响位置的两条路之一（另一条是买【加权】）：
  // 卖掉一个技能腾出格子，库里躺着的就当场摇位置顶上去，
  // 没有躺着的就空着等后面买的。那是一笔赌 —— 腾出来的格子
  // 不保证摇到哪一格（买哪个技能现在是你挑的，占哪儿还是摇的）

  const LEVELS_ROUTE : string = 'pages/examples/blackjack/draw-levels'
  const FISHING_ROUTE : string = 'pages/examples/blackjack/ap-fishing'

  // 开始下一关：清掉 inShop，回摸打页开局。
  // 从摸打结算进来的就退回去（那边 onShow 会开下一关）；
  // 从关卡页「开启挑战」直接进来的，换成摸打页
  function goNext() {
    if (guideLock()) {
      return
    }
    const data = loadDrawSave()
    data.inShop = false
    commit(data)
    const pages = getCurrentPages()
    if (pages.length > 1 && pages[pages.length - 2].route == FISHING_ROUTE) {
      uni.navigateBack({})
      return
    }
    uni.redirectTo({ url: '/' + FISHING_ROUTE })
  }

  // 退出：回关卡页，inShop 留着。栈里有关卡页就一路退回去
  //（中间那个摸打页一起出栈），没有就直接换过去
  function goExit() {
    if (guideLock()) {
      return
    }
    const pages = getCurrentPages()
    for (let i = pages.length - 2; i >= 0; i--) {
      if (pages[i].route == LEVELS_ROUTE) {
        uni.navigateBack({ delta: pages.length - 1 - i })
        return
      }
    }
    uni.redirectTo({ url: '/' + LEVELS_ROUTE })
  }

  // 这一关的第一批货：摇好**写进存档**。
  //
  // 存档而不是存在页面里，是因为货架要是每次进店重摇，退出去再进来
  // 就能刷到想要的那张 —— 而商店是过一关进一次，那等于白送无限次重摇，
  // 花钱刷新那条路也就白设了（排竿那边同样把货架存进了档）
  function ensureShelf() {
    if (save.value.shelf.length > 0) {
      // 老货架上没定槽的技能补定一下（见 fillShelfSlots）
      const data = loadDrawSave()
      if (fillShelfSlots(data)) {
        commit(data)
      }
      return
    }
    const data = loadDrawSave()
    rollShelf(data, false)
    commit(data)
  }

  onShow(() => {
    refresh()
    ensureShelf()
    startGuide()
  })

  // 包摊开着就被切走 / 退出去的话，替你拿第一个（见 autoTakePack）
  onHide(() => {
    autoTakePack()
  })

  onUnload(() => {
    autoTakePack()
  })

  refresh()
  ensureShelf()
</script>

<style>
  .page {
    flex: 1;
    padding: 16px;
    background-color: #0b5d3b;
  }

  .head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .title {
    color: #e8b23a;
    font-size: 22px;
    font-weight: bold;
  }

  /* 金币和名额竖着摆在右上角 */
  .head-right {
    align-items: flex-end;
  }

  .gold {
    color: #fff3c4;
    font-size: 16px;
    font-weight: bold;
  }

  .own {
    color: #9fd9bd;
    font-size: 11px;
    margin-top: 2px;
  }

  /* 名额满了描成橙的 —— 货架上的技能这时候买不动，这事得醒目 */
  .own-full {
    color: #ff9e80;
    font-weight: bold;
  }

  .body {
    flex: 1;
    margin-top: 10px;
  }

  /* ---------- 牌组改造 ---------- */

  /* ---------- 下一关的庄家 ---------- */

  /* 描成暗红，跟下面两栏货（绿底）分开 —— 它不是货，是题目 */
  .foe-box {
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    background-color: #5c2328;
    border-left-width: 4px;
    border-left-style: solid;
    border-left-color: #e06c75;
  }

  .foe-title {
    color: #ffd7d9;
    font-size: 12px;
    font-weight: bold;
  }

  .foe-none {
    color: #f0b9bd;
    font-size: 10px;
    margin-top: 3px;
  }

  /* 覆盖面在最前 —— 跟对局页的技能栏一个规矩：
     你问的是「我这张牌会不会撞上它的技能」，所以先给锚点 */
  .foe-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
  }

  .foe-cover {
    color: #ffffff;
    font-size: 11px;
    font-weight: bold;
    margin-right: 6px;
  }

  .foe-name {
    color: #ffd7d9;
    font-size: 11px;
    margin-right: 6px;
  }

  .foe-level {
    color: #f0b9bd;
    font-size: 10px;
  }

  .section {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    margin-top: 10px;
  }

  .section-note {
    color: #9fd9bd;
    font-size: 10px;
    line-height: 15px;
    margin-top: 2px;
  }

  /* 「买牌」那一行的标题和换一批按钮，左右分开 */
  .shelf-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .reroll {
    color: #e8b23a;
    font-size: 12px;
    font-weight: bold;
  }

  .fix-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .fix {
    width: 72px;
    height: 48px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  /* 买不起 / 已买：压暗 */
  .fix-off {
    opacity: 0.45;
  }

  /* ---------- 道具那一栏（一件一行） ---------- */

  .goods-list {
    margin-top: 6px;
  }

  /* 一行：左边名字 + 说明，右边价钱。
     **左边那条竖杠**（border-left）是稀有度的位置 —— 四格宽，
     在一列里扫下来对得齐，比整圈描边好认 */
  .goods {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 7px 10px;
    margin-bottom: 5px;
    border-radius: 8px;
    background-color: #0e6b45;
    border-left-width: 4px;
    border-left-style: solid;
    border-left-color: #6f9c85;
  }

  /* 稀有度：**换竖杠的颜色**。
     不用底色，因为底色已经被「道具 / 卡牌 / 技能」那三类占了
     （绿 / 白 / 紫）—— 两套信息抢同一个通道就都读不出来了。
     普通灰绿、稀有蓝、史诗紫 */
  .goods-rare {
    border-left-color: #4ea8de;
  }

  .goods-epic {
    border-left-color: #c77dff;
  }

  /* 新手引导要你点的那一件：整圈金边 */
  .goods-guide {
    border-width: 2px;
    border-style: solid;
    border-color: #e8b23a;
    border-left-width: 4px;
    border-left-color: #e8b23a;
  }

  .guide-tip {
    margin-top: 6px;
    padding: 8px 10px;
    border-radius: 8px;
    background-color: #e8b23a;
  }

  .guide-tip-text {
    color: #2a1a00;
    font-size: 12px;
    font-weight: bold;
    line-height: 17px;
  }

  .goods-off {
    opacity: 0.45;
  }

  /* 名字和说明占满剩下的宽度，价钱靠右 */
  .goods-main {
    flex: 1;
  }

  .goods-head {
    flex-direction: row;
    align-items: center;
  }

  .goods-name {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
  }

  .fix-tier {
    color: #9fd9bd;
    font-size: 9px;
    margin-left: 6px;
  }

  .goods-rare .fix-tier {
    color: #9fd3f5;
  }

  .goods-epic .fix-tier {
    color: #e3c4ff;
  }

  .goods-desc {
    color: #cfe8d8;
    font-size: 10px;
    line-height: 14px;
    margin-top: 2px;
  }

  .goods-price {
    color: #fff3c4;
    font-size: 13px;
    font-weight: bold;
    margin-left: 10px;
  }

  /* 买牌那几格：白底，像张牌 */
  .fix-card {
    background-color: #ffffff;
    border-color: #ffffff;
  }

  .fix-name {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
  }

  .fix-card .fix-name {
    color: #1a1a1a;
  }

  .fix-red {
    color: #d33b3b;
  }

  .fix-price {
    color: #fff3c4;
    font-size: 11px;
    margin-top: 2px;
  }

  .fix-card .fix-price {
    color: #8a6b00;
  }

  /* 三样混在同一栏，所以得一眼分得出来：
     形状一样，只靠底色分：牌是白的（像张牌）、技能是紫的、点数卡是金的。
     点数卡不用蓝色 —— 道具栏的稀有度已经占了蓝 */
  .fix-skill {
    background-color: #5b3a8e;
    border-color: #8b63c9;
  }

  .fix-pip {
    background-color: #f2c14e;
    border-color: #f2c14e;
  }

  .fix-pip .fix-name {
    color: #5a3a00;
  }

  .fix-pip .fix-price {
    color: #6b4a00;
  }

  /* 贴过点数卡的牌：描一圈金边。
     挑牌的时候「哪张已经加强过」是最要紧的信息 ——
     再贴一张点数卡该挑没贴过的，而同化该挑贴过的来复制 */
  .pick-card-pip {
    border-color: #e8b23a;
  }

  /* 「♠3·7」比「♠3」长，字得小一号才塞得进那个格子 */
  .pick-text-pip {
    font-size: 10px;
  }

  /* ---------- 开包弹层 ---------- */

  .pack-cards {
    flex-direction: row;
    flex-wrap: wrap;
  }

  /* 比选牌弹层那些格子大一截 —— 这儿只摆 6 张，
     而且每一张都是要你挑的，不是一片牌海里的一格 */
  .pack-card {
    width: 62px;
    height: 48px;
    margin-right: 8px;
    margin-bottom: 8px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    border-width: 2px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .pack-card-text {
    color: #1a1a1a;
    font-size: 18px;
    font-weight: bold;
  }

  /* ---------- 货品详情弹层 ---------- */

  /* 弹窗遮罩：铺满整页，弹窗摆正中 */
  .mask {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
  }

  .buy-box {
    width: 300px;
    padding: 16px;
    border-radius: 12px;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .buy-head {
    flex-direction: row;
    align-items: center;
  }

  .buy-name {
    color: #ffffff;
    font-size: 17px;
    font-weight: bold;
  }

  /* 价钱靠右顶到底 —— 它是这一框里第二要紧的数 */
  .buy-price {
    flex: 1;
    color: #fff3c4;
    font-size: 17px;
    font-weight: bold;
    text-align: right;
  }

  .buy-tag {
    color: #9fd9bd;
    font-size: 11px;
    margin-top: 3px;
  }

  .buy-desc {
    color: #ffffff;
    font-size: 13px;
    line-height: 19px;
    margin-top: 8px;
  }

  /* 买不了的原因。描红摆在钮上面 —— 点了才告诉人就太晚了 */
  .buy-block {
    color: #ff9e80;
    font-size: 12px;
    font-weight: bold;
    margin-top: 8px;
  }

  .buy-actions {
    flex-direction: row;
    margin-top: 14px;
  }

  .buy-btn {
    height: 36px;
    flex: 1;
    border-radius: 18px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: #e8b23a;
  }

  .buy-btn-off {
    opacity: 0.4;
  }

  .buy-btn-plain {
    margin-right: 0;
    background-color: #0b5637;
    border-width: 1px;
    border-style: solid;
    border-color: #6f9c85;
  }

  .buy-btn-text {
    color: #2a1a00;
    font-size: 14px;
    font-weight: bold;
  }

  .buy-btn-text-plain {
    color: #cfe8d8;
  }

  /* ---------- 选牌弹层 ---------- */

  .pick-box {
    width: 320px;
    padding: 14px;
    border-radius: 12px;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .pick-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .pick-title {
    color: #e8b23a;
    font-size: 16px;
    font-weight: bold;
  }

  .pick-sub {
    color: #9fd9bd;
    font-size: 11px;
  }

  .pick-tip {
    color: #9fd9bd;
    font-size: 11px;
    line-height: 16px;
    margin-top: 4px;
  }

  .pick-body {
    max-height: 320px;
    margin-top: 8px;
  }

  /* 弹窗里的技能卡（技能包、砺钩、洗点共用） */
  .my-skill {
    padding: 10px;
    margin-bottom: 8px;
    border-radius: 10px;
    background-color: #0b4f33;
    border-width: 1px;
    border-style: solid;
    border-color: #2f7a57;
  }

  .pack-sell {
