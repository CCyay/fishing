<template>
  <view class="page">
    <view class="head">
      <text class="title">商店</text>
      <view class="head-right">
        <!-- 金币后面挂着「下关利息 +N」。
             这条**必须摆在这儿**：利息要成为一个决策，你得在掏钱的那一刻
             看得见不掏的回报。摆在结算页就太晚了 —— 那时候钱已经花完了。
             它还顺带把档位说清楚：买掉 30 块掉一档的话，这个数当场就变 -->
        <text id="md-skill-gold" class="gold">金币 {{ save.gold }}{{ interestText }}</text>
        <!-- 生命跟金币同一行。技能库几件、槽装了几个，下面那两栏自己报，这儿不重复 -->
        <text id="md-lives" class="lives">♥ {{ livesNow }}</text>
      </view>
    </view>
    <!-- 手里还有没开的彩票：提一句什么时候开，不然买完像没反应 -->
    <text v-if="save.lotto > 0" id="md-lotto" class="lotto-line"
      >彩票 {{ save.lotto }} 张 · 下次进商店开奖</text
    >
    <!-- 这一页两栏货 + 一份家当清单：
         上栏是道具（改手头已有的东西），下栏是技能和卡牌（往这一轮里添东西）。
         「把技能摆到哪个格子」那套手动分配取消了，摇位置那套也取消了 ——
         **槽上印死标签**，你选的是「这件技能嵌哪个槽」（见 slotViews） -->

    <scroll-view class="body sv-out" direction="vertical">
      <!-- ---------- 下一关的庄家 ---------- -->
      <!--
        **花色公开，点数藏着**（见 draw-skills 的 coverageHint）。

        预告它要解决的是「买的时候不知道下一关什么题」—— 从前这一页
        什么都不报，于是购买只能凭通用强度，而【弃饵】那类针对性道具
        压根没有发挥的前提（那段注释自己记着「不成立」）。

        可**全公开就把牌桌上的推理删掉了**：点数是钓牌判定那条轴，
        知道了是哪几个点数，你就能用弃饵和推点数把它们从牌组里抽干，
        一关一关做成作业。所以点数只报个数。

        这一块摆在最上面 —— 它是这一页所有决策的前提
      -->
      <view class="foe-box">
        <text class="foe-title">{{ foeTitle }}</text>
        <!-- 角色名和特殊技：**固定的那层**，可以背。
             特殊技给全文不给名字，因为名字背不出规则 —— 「硬壳」
             看不出「它打的 ♠ 钓不上」，而那正是这一关要你改打法的地方 -->
        <text v-if="foeRoleName != ''" id="md-foe-role" class="foe-role"
          >庄家：{{ foeRoleName }}</text
        >
        <text v-if="foeSpecial != ''" id="md-foe-special" class="foe-special"
          >{{ foeSpecial }}</text
        >
        <text v-if="foePreview.length == 0" class="foe-none">{{ foeNone }}</text>
        <view
          v-for="(one, fi) in foePreview"
          :key="'fp-' + fi"
          :id="'md-foe-' + fi"
          class="foe-row">
          <text class="foe-cover">{{ one.cover }}</text>
          <text class="foe-name">{{ one.name }}</text>
          <text class="foe-level">{{ one.level }}</text>
        </view>
      </view>

      <!-- ---------- 一次性道具 ---------- -->
      <!--
        买了**立刻用**：点一下弹出选的界面，选完生效，道具就没了。
        所以这儿没有「库存」那一层 —— 不用存买了几个、用了没有。

        改牌组那几件动的是**双方共用的那副牌**（摸打不像排竿那样对半分），
        所以你改过的牌对方也摸得到。它的收益来自「往自己技能的点数上靠」：
        那几个点数的牌变多，你的技能触发率跟着上去，而对方的技能
        摇在别的点数上，这笔改造对它没用
      -->
      <view class="shelf-head">
        <text class="section">道具</text>
        <!-- 看现在的牌组：改造道具改的就是它，买之前得知道它长什么样 -->
        <text id="md-deck" class="reroll" @click="showDeck = true">牌组 {{ deckSize }} 张</text>
      </view>
      <!-- 新手引导第二步：就地提示，不盖遮罩（要让人点得到下面那件货） -->
      <view v-if="guideStep == GUIDE_BUY" id="md-guide-tip" class="guide-tip">
        <text class="guide-tip-text">点下面金框的「技能二选一」买下它，从两个技能里挑一个带进下一关</text>
      </view>
      <!-- 道具**一件一行**（横着摆格子的版本删了）。
           换成竖排是因为表里进了砺钩、洗点、三个包、四件唯一扩容 ——
           「加权」「平价」这种名字光看猜不出来，而它们一件 80 到 180 块，
           是整轮最重的几笔。买之前看不见效果那就不是取舍而是赌名字，
           而 76px 宽的格子塞不进一句说明。
           稀有度描在左边那条竖杠和档位那行小字上 -->
      <view class="goods-list">
        <text v-if="fixList.length == 0" class="section-note">这一批的道具没了。</text>
        <view
          v-for="(one, fi) in fixList"
          :key="'fx-' + fi"
          :id="'md-fix-' + one.tag"
          class="goods"
          :class="{
            'goods-rare': one.rare == RARE_RARE,
            'goods-epic': one.rare == RARE_EPIC,
            'goods-off': save.gold < one.price,
            'goods-guide': guideStep == GUIDE_BUY && one.at == guidePackAt
          }"
          @click="tapGoods(one.at)">
          <!-- 横排小卡片：名字、档位、价钱。说明点开详情看 -->
          <text class="goods-name">{{ one.name }}</text>
          <text class="fix-tier">{{ one.tier }}</text>
          <text class="goods-price">{{ one.price }}</text>
        </view>
      </view>

      <!-- 技能、卡牌、点数卡**混在同一栏** —— 三样是同一件事的三种形态：
           都是「花钱添一样东西进这一轮」。上面那一栏管的是「改手头已有的」。
           这一排刷得动（道具是机会，这儿是行情） -->
      <view class="shelf-head">
        <text class="section">技能 · 卡牌 · 点数</text>
        <text id="md-reroll" class="reroll" @click="doReroll">换一批 {{ rerollPrice }}</text>
      </view>
      <!-- 原先这儿写「技能名额满了，想换先卖掉一个」。名额没了，
           满槽也照样买得动（嵌进去会换掉里头那件），所以这句改成
           **一个槽都没有**那种情况 —— 那是「还没选角色」，开了包没处放 -->
      <text v-if="noSlots" class="section-note"
        >还没选角色，没有槽可以嵌技能。</text
      >
      <view class="fix-row">
        <view
          v-for="(one, ci) in cardList"
          :key="'cg-' + ci"
          :id="'md-card-' + ci"
          class="fix"
          :class="{
            'fix-card': !one.isSkill && !one.isPip,
            'fix-skill': one.isSkill,
            'fix-pip': one.isPip,
            'fix-off': one.sold || save.gold < one.price
          }"
          @click="tapGoods(one.at)">
          <text class="fix-name" :class="{ 'fix-red': one.red }">{{ one.name }}</text>
          <text class="fix-price">{{ one.sold ? '已买' : (one.isSkill ? one.tier + ' ' : '') + one.price }}</text>
        </view>
      </view>


      <!-- 本轮的槽。
           **按槽列，不按技能列** —— 从前这一栏是「我拥有的技能」，
           每一行报它装在哪、管什么。现在倒过来了：槽是角色卡印死的、
           数量固定、标签固定，技能只是嵌在里头的那件可换的东西。
           空槽也得列出来 —— 它是你下一次买技能的落点，是信息 -->
      <view class="my-head">
        <text class="section">我的槽</text>
        <text id="md-role-line" class="role-line">{{ roleLine }}</text>
      </view>
      <text v-if="slotViews.length == 0" class="empty">还没选角色</text>
      <!-- 只展示：一排小标签「槽上印的点数 · 装着哪件」。装上、卸下、卖出都在下面技能库里 -->
      <view class="slot-chips">
        <view
          v-for="(one, mi) in slotViews"
          :key="'slot-' + mi"
          :id="'md-slot-' + mi"
          class="slot-chip"
          :class="{ 'skill-empty': one.now < 0 }">
          <text class="slot-label">{{ one.label }}</text>
          <text class="slot-row-name">{{ one.now < 0 ? '空着' : DRAW_SKILLS[one.now].name }}</text>
        </view>
      </view>

      <!-- 技能库：拥有的全部技能（装着的也在）。装上 / 换槽、卖出都在这儿，随时能做。
           买来的技能先进这儿；满了就买不了，得先卖掉一件 -->
      <view class="my-head">
        <text class="section">技能库</text>
        <text id="md-lib-count" class="role-line" :class="{ 'own-full': libFull }"
          >{{ save.library.length }}/{{ libCap }}</text
        >
      </view>
      <text v-if="save.library.length == 0" class="empty">还没有技能</text>
      <view
        v-for="k in save.library"
        :key="'lib-' + k"
        :id="'md-lib-' + k"
        class="skill">
        <view class="skill-head">
          <text class="skill-name">{{ DRAW_SKILLS[k].name }}</text>
          <text v-if="DRAW_SKILLS[k].first" class="skill-key">{{ KEYWORD_FIRST }}</text>
        </view>
        <text class="skill-desc">{{ DRAW_SKILLS[k].desc }}</text>
        <view class="skill-foot">
          <text class="skill-cover">{{ libWhere(k) }}</text>
          <view
            v-if="slotOfSkill(save, k) >= 0"
            :id="'md-unequip-' + k"
            class="sell-btn equip-btn"
            @click.stop="unequipSlot(slotOfSkill(save, k))">
            <text class="equip-text">卸下</text>
          </view>
          <view :id="'md-equip-' + k" class="sell-btn equip-btn" @click.stop="openEquip(k)">
            <text class="equip-text">{{ slotOfSkill(save, k) >= 0 ? '换槽' : '装上' }}</text>
          </view>
          <view :id="'md-libsell-' + k" class="sell-btn" @click.stop="sellSkill(k)">
            <text class="sell-text">卖出 +{{ sellPriceOf(k) }}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 退出：回关卡页，下次开启挑战还是先进这个商店（存档里记着 inShop）。
         开始下一关：离开商店，去打下一关。
         摆在所有弹窗**前面**：后渲染的层级高，摆在后面遮罩就盖不住它 -->
    <view class="back-row">
      <view id="md-exit" class="back-btn back-btn-plain" @click="goExit">
        <text class="back-text back-text-plain">退出</text>
      </view>
      <view id="md-next" class="back-btn" @click="goNext">
        <text class="back-text">开始下一关</text>
      </view>
    </view>

    <!-- 现有牌组：只看不改。按点数一行，贴过点数卡的描金边 -->
    <view v-if="showDeck" class="mask" @click="showDeck = false">
      <view class="pick-box" @click.stop="noop">
        <view class="pick-head">
          <text class="pick-title">现有牌组</text>
          <text class="pick-sub">{{ deckSize }} 张</text>
        </view>
        <scroll-view class="pick-body sv-out" direction="vertical">
          <view v-for="(row, ri) in deckRows" :key="'dv-' + ri" class="pick-line">
            <text class="pick-rank">{{ row.rank }}</text>
            <view class="pick-cards">
              <view
                v-for="(one, ci) in row.items"
                :key="'dvc-' + ri + '-' + ci"
                class="pick-card"
                :class="{ 'pick-card-pip': one.pipped }">
                <text
                  class="pick-card-text"
                  :class="{ 'fix-red': one.red, 'pick-text-pip': one.pipped }"
                  >{{ one.text }}</text
                >
              </view>
              <text v-if="row.items.length == 0" class="deck-none">没有</text>
            </view>
          </view>
        </scroll-view>
        <text id="md-deck-close" class="pick-close" @click.stop="showDeck = false">收起来</text>
      </view>
    </view>

    <!-- 新手引导：欢迎（第一步）和收尾（第三步）。第二步是道具栏上方那张提示卡 -->
    <view v-if="guideStep == GUIDE_WELCOME || guideStep == GUIDE_END" class="mask">
      <view class="buy-box" @click.stop="noop">
        <text id="md-guide-title" class="buy-name">{{ guideStep == GUIDE_WELCOME ? '欢迎来到商店' : '拿到第一个技能了！' }}</text>
        <text class="buy-desc">{{ guideText }}</text>
        <view class="buy-actions">
          <view id="md-guide-ok" class="buy-btn" @click="guideNext">
            <text class="buy-btn-text">{{ guideStep == GUIDE_WELCOME ? '去买技能' : '知道了' }}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 货品详情：**点货架上任何一件都先开这个**，确定了才真买。
         理由见脚本里 detailAt 上面那段（名字已经说不清这些货了，
         而一次误点能毁掉半轮预算）。
         买不了的时候「确定购买」压暗，并且把原因写在钮上面 ——
         点了才告诉人就太晚了 -->
    <view v-if="detailOpen" class="mask" @click="closeDetail">
      <view class="buy-box" @click.stop="noop">
        <view class="buy-head">
          <text id="md-buy-name" class="buy-name">{{ detail.name }}</text>
          <text v-if="detail.first" class="skill-key">{{ KEYWORD_FIRST }}</text>
          <text id="md-buy-price" class="buy-price">{{ detail.price }}</text>
        </view>
        <text class="buy-tag">{{ detail.tag }}</text>
        <text id="md-buy-desc" class="buy-desc">{{ detail.desc }}</text>
        <text v-if="detail.block != ''" class="buy-block">{{ detail.block }}</text>
        <view class="buy-actions">
          <view
            id="md-buy-ok"
            class="buy-btn"
            :class="{ 'buy-btn-off': detail.block != '' }"
            @click.stop="confirmBuy">
            <text class="buy-btn-text">确定购买</text>
          </view>
          <view id="md-buy-no" class="buy-btn buy-btn-plain" @click.stop="closeDetail">
            <text class="buy-btn-text buy-btn-text-plain">再看看</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 选牌：整副牌按点数摊成 13 行，点一张就是挑它。
         一次性道具买了立刻用，所以这块是「买完当场弹出来」的。
         点遮罩取消 —— 除了 pickForced 那一种（钱已经扣过，取消等于白花），
         见 cancelPick -->
    <view v-if="pickMode != ''" class="mask" @click="cancelPick">
      <view class="pick-box" @click.stop="noop">
        <view class="pick-head">
          <text class="pick-title">{{ pickTitle }}</text>
          <text class="pick-sub">{{ picksSlot ? usedSlots + '/' + slotCount + ' 槽' : deckSize + ' 张' }}</text>
        </view>
        <text class="pick-tip">{{ pickTip }}</text>

        <!-- 买技能挑的是**槽**，不是牌。
             原先这儿是砺钩和洗点的「挑技能」（挑一件去升级 / 重摇位置），
             两件道具都删了 —— 位置是印的，没有可摇的；没有等级，没有可升的。
             现在这块变成「这件技能嵌哪个槽」，是买技能的第二步 -->
        <scroll-view v-if="picksSlot" class="pick-body sv-out" direction="vertical">
          <view
            v-for="(one, si) in slotViews"
            :key="'ps-' + si"
            :id="'md-pick-slot-' + si"
            class="my-skill"
            :class="{ 'my-skill-on': one.now < 0, 'my-skill-swap': one.now >= 0 }"
            @click="onPickSlot(one.at)">
            <view class="my-skill-head">
              <text class="my-skill-cover">{{ one.label }}</text>
              <text class="my-skill-name">{{ one.now < 0 ? '空着' : DRAW_SKILLS[one.now].name }}</text>
              <text class="my-skill-level">盖 {{ one.cover }} 张</text>
            </view>
            <text class="my-skill-desc">{{ slotNote(one) }}</text>
          </view>
        </scroll-view>

        <scroll-view v-else class="pick-body sv-out" direction="vertical">
          <view v-for="(row, ri) in deckRows" :key="'dr-' + ri" class="pick-line">
            <text class="pick-rank">{{ row.rank }}</text>
            <view class="pick-cards">
              <view
                v-for="(one, ci) in row.items"
                :key="'pc-' + ri + '-' + ci"
                :id="'md-pick-' + one.at"
                class="pick-card"
                :class="{
                  'pick-card-on': one.at == pickFirst,
                  'pick-card-pip': one.pipped
                }"
                @click="onPickCard(one.at)">
                <text
                  class="pick-card-text"
                  :class="{ 'fix-red': one.red, 'pick-text-pip': one.pipped }"
                  >{{ one.text }}</text
                >
              </view>
            </view>
          </view>
        </scroll-view>
        <!-- pickForced 那一种不给「取消」钮 —— 点了也不会动
             （见 cancelPick），摆一颗按下去没反应的钮比没有更糟 -->
        <text v-if="!pickForced" class="pick-close" @click.stop="cancelPick">取消</text>
      </view>
    </view>

    <!-- 开包：摊开 N 个候选，挑 1 个。
         **没有取消** —— 钱在摊开那一刻就扣了（见 openPack 上面那段），
         所以这儿只剩「挑哪个」。点遮罩也关不掉 -->
    <view v-if="packOpen" class="mask">
      <view class="pick-box" @click.stop="noop">
        <view class="pick-head">
          <text class="pick-title">{{ packTitle }}</text>
          <text class="pick-sub">挑 1 个</text>
        </view>

        <!-- 技能包：点一下只是**选中**（描金边），再点底下的钮才拿走 ——
             钱已经扣了、只能挑一次，一下误触就拿错了 -->
        <scroll-view v-if="packSkills.length > 0" class="pick-body sv-out" direction="vertical">
          <view
            v-for="(k, si) in packSkills"
            :key="'pk-' + si"
            :id="'md-pack-skill-' + k"
            class="my-skill"
            :class="{ 'my-skill-on': packPick == k }"
            @click="pickPackSkill(si)">
            <view class="my-skill-head">
              <text class="my-skill-name">{{ DRAW_SKILLS[k].name }}</text>
              <text v-if="DRAW_SKILLS[k].first" class="skill-key">{{ KEYWORD_FIRST }}</text>
            </view>
            <text class="my-skill-desc">{{ DRAW_SKILLS[k].desc }}</text>
            <!-- 包里不问「嵌哪个槽」（见 takePackSkill），所以这儿报一声
                 它会落到哪儿 —— 不然拿完才发现换掉了一件就太晚了 -->
            <text class="my-skill-level">{{ packLand }}</text>
          </view>
        </scroll-view>

        <scroll-view v-else class="pick-body sv-out" direction="vertical">
          <view class="pack-cards">
            <view
              v-for="(one, ci) in packCardViews"
              :key="'pcd-' + ci"
              :id="'md-pack-card-' + ci"
              class="pack-card"
              @click="takePackCard(one.text)">
              <text class="pack-card-text" :class="{ 'fix-red': one.red }">{{ one.label }}</text>
            </view>
          </view>
        </scroll-view>
        <!-- 原先这儿有一块「腾位置：卖掉一个已有技能」—— 候选因为槽满
             选不了的时候就地卖一件。整块删了：槽满也挑得下来（嵌的时候
             换掉里头那件），所以「选不了」这种状态不存在了 -->
        <view class="buy-actions">
          <view
            v-if="packSkills.length > 0"
            id="md-pack-ok"
            class="buy-btn"
            :class="{ 'buy-btn-off': packPick < 0 }"
            @click="confirmPackSkill">
            <text class="buy-btn-text">{{ packPick < 0 ? '先点一个技能' : '就要它' }}</text>
          </view>
          <!-- 放弃：一个都不拿。钱在摊开那一刻就扣了，不退（见 packOpen 上面那段）。
               新手引导里不给放弃 —— 那一步就是要你拿到第一个技能 -->
          <view
            v-if="guideStep != GUIDE_BUY"
            id="md-pack-skip"
            class="buy-btn buy-btn-plain"
            @click="abandonPack">
            <text class="buy-btn-text buy-btn-text-plain">放弃</text>
          </view>
        </view>
      </view>
    </view>

  </view>
</template>

<script setup lang="uts">
  import { SUITS } from '@/pages/examples/blackjack/cards.uts'
  import {
    DRAW_SKILLS,
    DRAW_ROLES,
    KEYWORD_FIRST,
    // coverageHint 只给庄家预告用（花色给全、点数只报个数）。
    // coverageText（报全）和 slotLabels 不再引 —— 自己这边的覆盖面
    // 现在直接读槽上印的标签，不用从 loadout 倒推
    coverageHint,
    sellPriceOf,
    slotCover,
    // 抬头那行「角色 · 特殊技」要报特殊技的名字
    SPECIAL_SKILLS,
    specialIndexOf
    // 原先这儿还引着一片旧模型的东西（rankCapOf / isEquipped / hasRankRoom /
    // rollExpand / washSkill / canUpgrade / removeSkill / levelText /
    // rankSizeOf）。槽上印死标签之后那套全删了 —— 没有位置可摇、
    // 没有格子可扩、没有等级可升
  } from '@/pages/examples/blackjack/draw-skills.uts'
  import {
    DrawSave,
    emptyDrawSave,
    loadDrawSave,
    saveDraw,
    DRAW_RUN_LENGTH,
    deckOf,
    setDeck,
    suitOfText,
    rankOfText,
    shelfGoods,
    rollShelf,
    markSold,
    rerollTimes,
    countOfRank,
    // 买技能 = 嵌进一个槽；卖技能 = 把那个槽清空
    equipSkill,
    unequipAt,
    addToLibrary,
    dropFromLibrary,
    libraryFull,
    slotOfSkill,
    slotLabelAt,
    hasSkill,
    filledSlots,
    foeKitOf,
    cardText,
    cardLabel,
    pipsOfText,
    addPip,
    faceOfValue,
    GOODS_PIP,
    fixSlotsOf,
    cardSlotsOf,
    rerollPriceOf,
    growShelf,
    growCard,
    makeFlat,
    growLibrary,
    rollShopCard,
    libraryCapFor,
    cardPriceOf,
    hasFace,
    rankFace,
    fusedRank,
    valueOfRankText,
    DECK_RANKS,
    ZERO_RANK,
    BLANK_RANK,
    GOODS_FIX,
    GOODS_SKILL,
    drawSaveSlot,
    difficultyOf,
    shopGuided,
    setShopGuided
  } from '@/pages/examples/blackjack/draw-save.uts'
  import {
    drawLevelById,
    levelForDiff,
    maxLivesOf,
    foeCoverOf,
    // 庄家预告里「固定的那层」：角色名 + 特殊技全文。
    // 条数也要（带两条的排版不一样，见 foeSpecial）
    foeRoleAt,
    foeSpecialNameAt,
    foeSpecialDescAt,
    foeSpecialCountAt,
    // 牌组的两头：买牌不能超上限、弃饵不能低于下限
    DECK_MIN,
    DECK_CAP,
    FLAT_REROLL,
    PIP_PRICE,
    interestOf,
    fixItemOf,
    packSize,
    isPack,
    rareName,
    RARE_COMMON,
    RARE_RARE,
    RARE_EPIC
  } from '@/pages/examples/blackjack/draw-levels.uts'

  const save = ref<DrawSave>(emptyDrawSave())

  function refresh() {
    save.value = loadDrawSave()
  }

  function noop() {}

  // ---------- 牌组改造 ----------

  // 货架上的一件货。at 是它在 shelfGoods 里的下标 ——
  // 买下来要按这个下标标「卖掉」，所以得一路带着
  type ShelfView = {
    at : number
    tag : string
    name : string
    price : number
    red : boolean
    isSkill : boolean
    // 点数卡（买了要挑一张牌贴上去，所以它跟买牌不是一条路）
    isPip : boolean
    // 稀有度（RARE_*）和它的名字。只有道具有，技能和卡牌一律 RARE_COMMON
    rare : number
    tier : string
    // 一句话说明。只有道具有（技能和卡牌的名字就是说明）
    desc : string
    sold : boolean
  }

  // 道具那几件。**卖掉的直接不列** —— 买完就没了，
  // 摆个「已买」的空格子只是占地方
  const fixList = computed<ShelfView[]>(() : ShelfView[] => {
    const list = shelfGoods(save.value)
    const out : ShelfView[] = []
    for (let i = 0; i < list.length; i++) {
      if (list[i].kind != GOODS_FIX || list[i].sold) {
        continue
      }
      const item = fixItemOf(list[i].tag)
      out.push({
        at: i,
        tag: list[i].tag,
        name: item.name,
        price: item.price,
        red: false,
        isSkill: false,
        isPip: false,
        rare: item.rare,
        // 唯一道具额外标一笔「唯一」—— 它比稀有度更要紧：
        // 稀有是「不常见」，唯一是「这一轮就这一次」
        tier: item.once ? rareName(item.rare) + ' · 唯一' : rareName(item.rare),
        desc: item.desc,
        sold: false
      } as ShelfView)
    }
    return out
  })

  // 道具那一栏的副标题。格数会变（买过加栏就 4 格），所以写成 computed
  // 技能和卡牌那一栏。卖掉的**留着显示「已买」** —— 跟道具相反，
  // 因为这一排刷得动，留着那一格能看出「这批我买过什么」
  const cardList = computed<ShelfView[]>(() : ShelfView[] => {
    const list = shelfGoods(save.value)
    const out : ShelfView[] = []
    for (let i = 0; i < list.length; i++) {
      const one = list[i]
      if (one.kind == GOODS_FIX) {
        continue
      }
      // 点数卡：tag 是它给的点数值，名字写成「+7」
      if (one.kind == GOODS_PIP) {
        const v = parseInt(one.tag)
        if (isNaN(v)) {
          continue
        }
        out.push({
          at: i,
          tag: one.tag,
          name: '+' + faceOfValue(v),
          price: PIP_PRICE,
          red: false,
          isSkill: false,
          isPip: true,
          rare: RARE_COMMON,
          tier: '',
          desc: '',
          sold: one.sold
        } as ShelfView)
        continue
      }
      if (one.kind == GOODS_SKILL) {
        const k = parseInt(one.tag)
        if (isNaN(k) || k >= DRAW_SKILLS.length) {
          continue
        }
        out.push({
          at: i,
          tag: one.tag,
          name: DRAW_SKILLS[k].name,
          price: DRAW_SKILLS[k].unlock,
          red: false,
          isSkill: true,
          isPip: false,
          // 这一栏不分稀有度 —— 稀有度管的是**道具**那一栏。
          // 这一栏的随机性走的是另一条路：刷新（花钱、价钱翻倍涨）
          rare: RARE_COMMON,
          // tier 这一格原先标技能定好的槽（「花色」/「点数」）。
          // 只剩一个槽之后没什么可标的了
          tier: '',
          desc: '',
          sold: one.sold
        } as ShelfView)
        continue
      }
      const suit = suitOfText(one.tag)
      out.push({
        at: i,
        tag: one.tag,
        // cardLabel：无点数牌写「♠无」而不是存档里那个 '♠-'
        name: cardLabel(one.tag),
        // 价钱统一走 cardPriceOf（J、零点、无点数各有各的价）
        price: cardPriceOf(one.tag),
        // ♥♦ 是红的（SUITS 的顺序是 ♠♥♦♣）
        red: suit == SUITS[1] || suit == SUITS[2],
        isSkill: false,
        isPip: false,
        rare: RARE_COMMON,
        tier: '',
        desc: '',
        sold: one.sold
      } as ShelfView)
    }
    return out
  })

  // 槽全嵌满了吗。
  //
  // 从前这是「名额满了」（4 件上限），满了就**买不动**。现在满了照样买得动
  // —— 只是得换掉槽里那件（见 embedSkill）。于是决策从
  // 「要不要先卖一个」变成了「这件比槽里那件好吗」，直接得多。
  //
  // 它只剩一个用处：技能包（二选一 / 五选一）在**一个槽都没有**的时候
  // 该拦住 —— 那种情况是「还没选角色」，开出来没处放
  const noSlots = computed<boolean>(() : boolean => {
    return save.value.slotSkills.length == 0
  })

  // 这一轮的角色有几个槽、嵌了几件（抬头报「槽 N/M」）
  const slotCount = computed<number>(() : number => {
    return save.value.slotSkills.length
  })

  // 技能库上限、生命上限都按难度（见 draw-levels 的 libraryCapOf / maxLivesOf）
  // 走 libraryCapFor —— 买过【扩库】要算上那一格
  const libCap = computed<number>(() : number => {
    return libraryCapFor(save.value, difficultyOf(drawSaveSlot()))
  })

  const libFull = computed<boolean>(() : boolean => {
    return libraryFull(save.value, libCap.value)
  })

  // 生命 0 = 这一轮还没开打（开局才补满），这时候报满的
  const livesNow = computed<number>(() : number => {
    return save.value.lives > 0 ? save.value.lives : maxLivesOf(difficultyOf(drawSaveSlot()))
  })

  const usedSlots = computed<number>(() : number => {
    return filledSlots(save.value)
  })

  // 角色名 + 那件常驻特殊技（抬头上摆着 —— 它是这一轮的方向）
  const roleLine = computed<string>(() : string => {
    const r = save.value.role
    if (r < 0 || r >= DRAW_ROLES.length) {
      return '没选角色'
    }
    const at = specialIndexOf(DRAW_ROLES[r].special)
    return DRAW_ROLES[r].name + (at < 0 ? '' : ' · ' + SPECIAL_SKILLS[at].name)
  })

  // ---------- 下一关的庄家 ----------
  //
  // 商店是打赢一关之后进的，所以 save.runLevel 已经是**下一关**的号了
  //（settleWin 推过去的）—— 直接拿它查关卡表就是你下一个对手
  type FoeSkill = {
    cover : string
    name : string
    level : string
  }

  // 庄家现在是**角色**：技能名单由关号定死（见 draw-levels 的 DRAW_FOE_ROLES），
  // 摇的只有「每件技能占哪些标签」，而那个摇定也在 settleWin 推关号的那一刻
  // 就存住了（存档的 foeSlots）。
  //
  // 所以这块预告现在是两种信息叠起来的：
  //
  // - **固定的那层**（角色名 + 特殊技 + 带哪几件技能）—— 可以背下来，
  //   打到第 9 关你就该知道「雾叟挑潮，带照水和冻结」。这是设计稿里
  //   「庄家要有性格」那条的全部兑现方式；
  // - **摇的那层**（占哪几个点数）—— 花色给全、点数只报个数（见 coverageHint），
  //   所以你知道它多硬，不知道它硬在哪儿。
  //
  // 「摇完就存」那条规矩现在只管第二层，但依然必须有：每次读都重摇的话，
  // 退出再进就能一直刷到标签摆得最舒服的那一套
  const foePreview = computed<FoeSkill[]>(() : FoeSkill[] => {
    const out : FoeSkill[] = []
    const id = save.value.runLevel
    if (id < 1 || id > DRAW_RUN_LENGTH) {
      return out
    }
    const kit = foeKitOf(save.value, id)
    const levels = kit.levels
    for (let k = 0; k < DRAW_SKILLS.length && k < levels.length; k++) {
      if (levels[k] < 0) {
        continue
      }
      out.push({
        // 花色给全，点数只报个数（见 coverageHint 那段）
        cover: coverageHint(kit.loadout, k),
        name: DRAW_SKILLS[k].name,
        level: ''
      } as FoeSkill)
    }
    return out
  })

  // 庄家的角色名。固定的那层信息里最该先看见的一条
  const foeRoleName = computed<string>(() : string => {
    const id = save.value.runLevel
    if (id < 1 || id > DRAW_RUN_LENGTH) {
      return ''
    }
    return foeRoleAt(id).name
  })

  // 庄家特殊技：**名字 + 全文都给**。
  //
  // 跟点数标签不一样，这个不藏 —— 它不是「被针对就失效」的东西，
  // 而是这一关的规则本身。你知道湾主硬壳（它的 ♠ 钓不上）之后要做的
  // 不是躲，是改打法。藏起来只会让你第一次打莫名其妙输掉
  const foeSpecial = computed<string>(() : string => {
    const id = save.value.runLevel
    if (id < 1 || id > DRAW_RUN_LENGTH) {
      return ''
    }
    const name = foeSpecialNameAt(id)
    if (name == '') {
      return ''
    }
    // 带两条的（龙王：逆钩 + 浊水）全文里已经逐条标了名字，
    // 这儿再套一层就成了「逆钩 · 浊水：逆钩：……」
    if (foeSpecialCountAt(id) > 1) {
      return foeSpecialDescAt(id)
    }
    return name + '：' + foeSpecialDescAt(id)
  })

  const foeTitle = computed<string>(() : string => {
    const id = save.value.runLevel
    if (id < 1 || id > DRAW_RUN_LENGTH) {
      return '下一关'
    }
    const lv = levelForDiff(drawLevelById(id), difficultyOf(drawSaveSlot()))
    // 顺带报它这一关的**覆盖面预算**（见 draw-levels 的 foeCoverOf）。
    //
    // 为什么敢报这个数：它说的是「它卡得住多少张牌」，是强度；
    // 而不公开的是「卡的是哪几个点数」，那才是能被针对的东西。
    // 配装既然是摇的，不给个强度刻度就没法判断「这一关该不该抱紧钱包」
    const cover = foeCoverOf(id)
    return '下一关 · 第 ' + id + ' 关「' + lv.name + '」'
      + (lv.random ? ' · 随机出牌' : (lv.smart ? ' · 会记牌' : ' · 随手出牌'))
      + (cover > 0 ? ' · 盖 ' + cover + ' 张' : '')
  })

  // 一个技能都没带的那几关（浅滩 1–4）也得说句话 ——
  // 空着会让人以为是没加载出来
  const foeNone = computed<string>(() : string => {
    const id = save.value.runLevel
    if (id < 1 || id > DRAW_RUN_LENGTH) {
      return '这一轮打完了。'
    }
    return '它不带技能。'
  })

  // 技能 / 卡牌那一栏的副标题。格数和刷新价都会被唯一道具改掉，
  // 所以两件事都在这儿报一声 —— 买过的那件得看得见它在生效
  // 「下关利息 +N」。没息就什么都不显示 ——
  // 前两三关你根本攒不到 50 块，挂个「+0」只是噪音
  const interestText = computed<string>(() : string => {
    const got = interestOf(save.value.gold)
    return got > 0 ? ' · 下关利息 +' + got : ''
  })

  // 点数槽那行小字。买过加权就把那一格点出来 ——
  // 不然「6/7」那个 7 是哪来的没人看得明白

  const deckSize = computed<number>(() : number => {
    return deckOf(save.value).length
  })

  // 走 rerollPriceOf 而不是 cardRerollCost —— 买过【平价】就是固定价
  const rerollPrice = computed<number>(() : number => {
    return rerollPriceOf(save.value)
  })

  // 换一批。**只换下栏，道具那几件原样留着** ——
  // 道具是「这一关的机会」，买完就没；技能和卡牌是「这一关的行情」，刷得动。
  //
  // 价钱翻倍涨（见 cardRerollCost）：第一次 20 块比一张牌还便宜，
  // 第三次就是 J 的价钱了。买过【平价】那条曲线就拍平成 30
  function doReroll() {
    if (guideLock()) {
      return
    }
    const cost = rerollPrice.value
    if (save.value.gold < cost) {
      uni.showToast({ title: '金币不够，换一批要 ' + cost, icon: 'none' })
      return
    }
    const data = loadDrawSave()
    data.gold = data.gold - cost
    rollShelf(data, true)
    commit(data)
  }

  // 买技能/卡牌那一栏的一件。两种货走同一个入口 ——
  // 它们在界面上混着摆，所以点击也该是同一道口子
  // ---------- 买之前先看详情 ----------
  //
  // 两栏货**点一下都是先看详情，不是直接买**。
  //
  // 为什么要加这一层：这一页的货已经不是「看名字就知道买什么」了 ——
  // 道具有十四种（加权、平价那种名字猜不出来）、技能二十多个
  // （desc 是一整句规则，还带「优先」这类关键字）、点数卡要看清它给哪个点数。
  // 而价钱从 30 到 180，一次误点能毁掉半轮的预算。
  //
  // 从前的手感是「点一下，钱就没了」或者「点一下，直接跳进选牌界面」——
  // 那在四件货、名字即说明的时候成立，现在不成立了。
  //
  // 这一层只做一件事：**把那件货摊开给你看，再问一次**。
  // 确定之后原来那套流程一个字都没改（doBuyFix / doBuyShelf），
  // 所以「挑牌挑到一半取消了不扣钱」那些规矩照旧
  const detailAt = ref<number>(-1)

  // 详情框里摆什么。
  //
  // **它永远是个对象，不是 null** —— 开没开看 ok 那一位。
  // 这么写是为了模板：`detail!.name` 那种非空断言在 uvue 模板里不保险，
  // 而 `v-if="detailOpen"` + `detail.name` 一定编得过
  type Detail = {
    ok : boolean
    name : string
    // 名字底下那行小标签：档位 / 通用还是点数槽 / 「唯一」
    tag : string
    desc : string
    price : number
    // 带「优先」关键字吗（只有技能有）
    first : boolean
    // 买不了的理由。空串表示买得了
    block : string
  }

  function noDetail() : Detail {
    return {
      ok: false, name: '', tag: '', desc: '', price: 0, first: false, block: ''
    } as Detail
  }

  const detail = computed<Detail>(() : Detail => {
    const at = detailAt.value
    if (at < 0) {
      return noDetail()
    }
    const list = shelfGoods(save.value)
    if (at >= list.length || list[at].sold) {
      return noDetail()
    }
    const one = list[at]
    if (one.kind == GOODS_FIX) {
      return fixDetail(one.tag)
    }
    if (one.kind == GOODS_SKILL) {
      return skillDetail(parseInt(one.tag))
    }
    if (one.kind == GOODS_PIP) {
      return pipDetail(parseInt(one.tag))
    }
    return cardDetail(one.tag)
  })

  const detailOpen = computed<boolean>(() : boolean => {
    return detail.value.ok
  })

  function fixDetail(key : string) : Detail {
    const item = fixItemOf(key)
    // 查表没查着就是表里加了货没接线（见 doBuyFix 开头那道闸）
    if (item.key != key) {
      return noDetail()
    }
    // 买不了的理由在这儿就算清楚 —— 别等点了确定才告诉人
    let block = ''
    if (save.value.gold < item.price) {
      block = '金币不够'
    } else if ((item.key == 'pack2' || item.key == 'pack5') && libFull.value) {
      block = '技能库满了（' + libCap.value + ' 件），先卖掉一件'
    } else if ((item.key == 'pack2' || item.key == 'pack5') && noSlots.value) {
      // 开出来没处放。**不拦「槽满了」** —— 满了也能开，嵌进去换掉一件
      block = '还没选角色 —— 没有槽可嵌'
    } else if ((item.key == 'drop' || item.key == 'fuse') && deckSize.value <= DECK_MIN) {
      // 熔合也会少一张（右边那张熔掉了）
      block = '牌组不能少于 ' + DECK_MIN + ' 张'
    } else if (item.key == 'copy' && deckSize.value >= DECK_CAP) {
      block = '牌组满了（' + DECK_CAP + ' 张）'
    }
    return {
      ok: true,
      name: item.name,
      tag: item.once ? rareName(item.rare) + ' · 唯一' : rareName(item.rare),
      desc: item.desc,
      price: item.price,
      first: false,
      block: block
    } as Detail
  }

  function skillDetail(k : number) : Detail {
    if (isNaN(k) || k >= DRAW_SKILLS.length) {
      return noDetail()
    }
    const one = DRAW_SKILLS[k]
    let block = ''
    if (noSlots.value) {
      block = '还没选角色 —— 没有槽可嵌'
    } else if (save.value.gold < one.unlock) {
      block = '金币不够'
    } else if (libFull.value) {
      block = '技能库满了（' + libCap.value + ' 件），先卖掉一件'
    } else if (hasSkill(save.value, k)) {
      // 同一件技能嵌两个槽毫无意义（触发时只算一次，见 triggersOf 的去重）
      block = '已经在技能库里了'
    }
    // 原先这儿报「能升到几级」和「点数槽有没有空位」。
    // 等级没了，而「有没有空位」也不再是闸 —— 满了照样买得动，
    // 只是得换掉槽里那件（**换掉会退一半**，见 onPickSlot）。
    // 所以改报**有几个空槽**：那是你确定之后马上要做的决定（挑哪个槽）。
    //
    // 「金币不够」那道闸按**全价**算，不扣换掉的退款 —— 退款要到
    // 挑完槽才知道有没有，而这儿还不知道你会挑哪个。
    // 按全价要是严了一点，那是对的方向：它顺带保证 onPickSlot
    // 扣完钱不会把金币扣成负的
    const where = '进技能库 · 现有 ' + save.value.library.length + '/' + libCap.value
    return {
      ok: true,
      name: one.name,
      // 带「优先」的报一句它是什么意思 —— 只摆个标签的话没人知道
      tag: one.first ? where + ' · 优先：同一张牌上有几个效果时，先结算它' : where,
      desc: one.desc,
      price: one.unlock,
      first: one.first,
      block: block
    } as Detail
  }

  function pipDetail(v : number) : Detail {
    if (isNaN(v)) {
      return noDetail()
    }
    const face = faceOfValue(v)
    return {
      ok: true,
      name: '点数卡 +' + face,
      tag: '一次性 · 永久改一张牌',
      desc: '挑牌组里一张牌，让它**同时**也算 ' + face
        + ' 点 —— 原来那个点数照旧算，所以那张牌两头都钓得上。'
        + '牌面不变，不会变成 J，也不触发点数技。',
      price: PIP_PRICE,
      first: false,
      block: save.value.gold < PIP_PRICE ? '金币不够' : ''
    } as Detail
  }

  function cardDetail(text : string) : Detail {
    const price = cardPriceOf(text)
    let block = ''
    // 牌组上限先判，钱后判 —— 上限是硬的（攒再多钱也买不动），
    // 而「金币不够」会让人以为再打一关就能买
    if (deckSize.value >= DECK_CAP) {
      block = '牌组满了（' + DECK_CAP + ' 张）'
    } else if (save.value.gold < price) {
      block = '金币不够'
    }
    const rank = rankOfText(text)
    const same = countOfRank(save.value, rank)
    let desc = '加进这一轮的牌组。那个点数多一张，就多一次撞上的机会 ——'
      + '代价是牌组变厚（局更长，你技能覆盖面的占比被稀释）。'
    if (rank == 'J') {
      desc = 'J 通吃：堆上有牌时打出它，整堆收走。所以它比别的牌贵一倍。'
    } else if (rank == ZERO_RANK) {
      desc = '零点牌：0 点跟谁都不相等，所以它钓不到牌，对方也按点数钓不走它。'
        + '但它还在点数轴上 —— 见底会收走它，撒网把它算偶数，磁钩拿它能钩 A。'
    } else if (rank == BLANK_RANK) {
      desc = '无点数牌：一个点数都没有。按点数钓不到，也不会被按点数钓走 ——'
        + '只有 J、顺色、收色带得走它。没牌可钓的回合打它，什么也不送给对手。'
    }
    return {
      ok: true,
      name: cardLabel(text),
      tag: '加进牌组 · 现在有 ' + same + ' 张 ' + rankFace(rank),
      desc: desc,
      price: price,
      first: false,
      block: block
    } as Detail
  }

  // 点货架上一件：开详情，**不买**
  function tapGoods(at : number) {
    if (at != guidePackAt.value && guideLock()) {
      return
    }
    const list = shelfGoods(save.value)
    if (at >= list.length || list[at].sold) {
      return
    }
    detailAt.value = at
  }

  function closeDetail() {
    detailAt.value = -1
  }

  // 详情框里点「确定购买」。真正的买在这儿分流到原来那两套
  function confirmBuy() {
    const at = detailAt.value
    if (at < 0) {
      return
    }
    const one = detail.value
    if (!one.ok || one.block != '') {
      return
    }
    const list = shelfGoods(save.value)
    if (at >= list.length || list[at].sold) {
      closeDetail()
      return
    }
    const kind = list[at].kind
    closeDetail()
    if (kind == GOODS_FIX) {
      doBuyFix(at)
      return
    }
    doBuyShelf(at)
  }

  function doBuyShelf(at : number) {
    const list = shelfGoods(save.value)
    if (at >= list.length || list[at].sold) {
      return
    }
    if (list[at].kind == GOODS_SKILL) {
      buySkill(at, parseInt(list[at].tag))
      return
    }
    // 点数卡要挑一张牌贴上去，所以它走选牌那条路（**先不扣钱**，
    // 跟改造道具一个待遇：挑到一半取消了不该白花）
    if (list[at].kind == GOODS_PIP) {
      const v = parseInt(list[at].tag)
      if (isNaN(v)) {
        return
      }
      if (save.value.gold < PIP_PRICE) {
        uni.showToast({ title: '金币不够', icon: 'none' })
        return
      }
      pickMode.value = 'pip'
      pickStep.value = v
      pickAt.value = at
      pickPrice.value = PIP_PRICE
      pickFirst.value = -1
      return
    }
    const text = list[at].tag
    const price = cardPriceOf(text)
    // 跟 cardDetail 同一对闸、同一个顺序。两处都判是因为详情框那边
    // 只是把按钮压暗，真正扣钱的是这儿 —— 闸该在动钱的那一行前面
    if (deckSize.value >= DECK_CAP) {
      uni.showToast({ title: '牌组满了（' + DECK_CAP + ' 张）', icon: 'none' })
      return
    }
    if (save.value.gold < price) {
      uni.showToast({ title: '金币不够', icon: 'none' })
      return
    }
    const data = loadDrawSave()
    data.gold = data.gold - price
    const cards = deckOf(data)
    cards.push(text)
    setDeck(data, cards)
    markSold(data, at)
    commit(data)
    uni.showToast({ title: cardLabel(text) + ' 加进牌组了', icon: 'none' })
  }

  // 买一个技能：**先不扣钱**，弹出挑槽（跟改造道具一个待遇 ——
  // 挑到一半取消了不该白花）。真正的嵌入和扣钱在 onPickSlot 里。
  //
  // 名额那道闸没了（槽满照样买得动，只是会换掉里头那件）。
  // 唯一还拦的是「一个槽都没有」—— 那说明这一轮还没选角色
  function buySkill(at : number, k : number) {
    if (isNaN(k) || k >= DRAW_SKILLS.length) {
      return
    }
    if (noSlots.value) {
      uni.showToast({ title: '还没选角色 —— 没有槽可装', icon: 'none' })
      return
    }
    if (libFull.value) {
      uni.showToast({ title: '技能库满了（' + libCap.value + ' 件），先卖掉一件', icon: 'none' })
      return
    }
    const price = DRAW_SKILLS[k].unlock
    if (save.value.gold < price) {
      uni.showToast({ title: '金币不够', icon: 'none' })
      return
    }
    const data = loadDrawSave()
    data.gold = data.gold - price
    addToLibrary(data, k)
    markSold(data, at)
    commit(data)
    // 买到手了，顺手问一句装哪个槽 —— 不装也行，取消就留在技能库里
    askEquip(k, false)
  }

  // 弹「装进哪个槽」。forced = 不许取消（新手引导里那一次）
  function askEquip(k : number, forced : boolean) {
    pickMode.value = 'slot'
    pickStep.value = k
    pickAt.value = -1
    pickPrice.value = 0
    pickFirst.value = -1
    pickForced.value = forced
  }

  // 技能库里那件「装上 / 换槽」
  function openEquip(k : number) {
    if (noSlots.value) {
      uni.showToast({ title: '还没选角色 —— 没有槽可装', icon: 'none' })
      return
    }
    askEquip(k, false)
  }

  // 卸下第 at 个槽里那件：回技能库，不卖
  function unequipSlot(at : number) {
    if (guideLock()) {
      return
    }
    const data = loadDrawSave()
    const was = unequipAt(data, at)
    if (was < 0) {
      return
    }
    commit(data)
    uni.showToast({ title: DRAW_SKILLS[was].name + ' 卸回技能库', icon: 'none' })
  }

  // 卖掉技能库里一件（装着的一并卸下），退买价的一半
  function sellSkill(k : number) {
    if (guideLock()) {
      return
    }
    const price = sellPriceOf(k)
    uni.showModal({
      title: '卖出' + DRAW_SKILLS[k].name,
      content: '把【' + DRAW_SKILLS[k].name + '】卖 ' + price + ' 金币？'
        + (slotOfSkill(save.value, k) >= 0 ? '它装着的那个槽会空出来。' : ''),
      success: (res) => {
        if (!res.confirm) {
          return
        }
        const data = loadDrawSave()
        data.gold = data.gold + price
        dropFromLibrary(data, k)
        commit(data)
        uni.showToast({ title: DRAW_SKILLS[k].name + ' 卖掉了', icon: 'none' })
      }
    })
  }

  // 技能库里那一件装在哪
  function libWhere(k : number) : string {
    const at = slotOfSkill(save.value, k)
    return at >= 0 ? '装在 ' + slotLabelAt(save.value, at) + ' 槽' : '没装'
  }


  // ---------- 买了立刻用 ----------
  //
  // pickMode 不是空串就表示「正等你挑牌」。
  // push 系要挑一张再问方向（往上还是往下）；同化要挑两张
  const pickMode = ref<string>('')
  const pickStep = ref<number>(0)
  const pickFirst = ref<number>(-1)
  // 正在用的是货架上第几件、多少钱。改完才扣钱、才标卖掉 ——
  // 挑牌挑到一半取消了不该白花
  const pickAt = ref<number>(-1)
  const pickPrice = ref<number>(0)

  const pickTitle = computed<string>(() : string => {
    if (pickMode.value == 'same') {
      return '同化'
    }
    if (pickMode.value == 'drop') {
      return '弃饵'
    }
    if (pickMode.value == 'copy') {
      return '拓印'
    }
    if (pickMode.value == 'fuse') {
      return '熔合'
    }
    if (pickMode.value == 'blank') {
      return '抹点'
    }
    if (pickMode.value == 'pip') {
      return '点数卡 +' + faceOfValue(pickStep.value)
    }
    // 买技能的第二步：挑槽。标题报技能名 —— 弹层里问的是
    // 「它嵌哪儿」，所以得一直看得见「它」是谁
    if (pickMode.value == 'slot') {
      return '【' + DRAW_SKILLS[pickStep.value].name + '】装进哪个槽'
    }
    // 'sharpen'（砺钩）和 'wash'（洗点）两支删了 —— 两件道具都没了
    return '推 ' + pickStep.value + ' 格'
  })

  // ---------- 买技能：挑一个槽嵌进去 ----------
  //
  // 原先这儿是砺钩和洗点那两件的「挑技能」弹层（skillPickList / hasUpgradable /
  // skillPickNote / onPickSkill / doWash）。两件都删了，整套跟着没。
  //
  // 换上来的是**挑槽**：买技能不再是「花钱 + 听天由命摇个位置」，
  // 而是「花钱 + 一个决策」—— 磁钩嵌在连号的槽上，它的 +1 能钓到
  // 自己的下一个槽；嵌在散号上那条链就断了。
  //
  // pickMode == 'slot' 的时候 pickStep 装的是**要嵌的那件技能**
  //（借 pickStep 这个字段，它本来装「推几格」—— 两种模式不会同时开）
  type SlotView = {
    at : number
    // 槽上印着什么（'6 7'、'♥'）
    label : string
    // 盖住多少张牌
    cover : number
    // 现在嵌着哪件，-1 = 空着
    now : number
  }

  const slotViews = computed<SlotView[]>(() : SlotView[] => {
    const out : SlotView[] = []
    const r = save.value.role
    if (r < 0 || r >= DRAW_ROLES.length) {
      return out
    }
    const slots = DRAW_ROLES[r].slots
    for (let i = 0; i < slots.length; i++) {
      out.push({
        at: i,
        label: slots[i],
        cover: slotCover(slots[i]),
        now: i < save.value.slotSkills.length ? save.value.slotSkills[i] : -1
      } as SlotView)
    }
    return out
  })

  const pickTip = computed<string>(() : string => {
    if (pickMode.value == 'same') {
      return pickFirst.value < 0
        ? '先点一张当样子'
        : '再点一张，它会变成上面那张'
    }
    if (pickMode.value == 'drop') {
      return '点一张牌，从牌组里拿掉'
    }
    if (pickMode.value == 'copy') {
      return '点一张牌，牌组里多一张一模一样的'
    }
    if (pickMode.value == 'fuse') {
      return pickFirst.value < 0
        ? '先点一张（无点数的不行）'
        : '再点一张同花色的，两张合成一张，点数相加'
    }
    if (pickMode.value == 'blank') {
      return '点一张牌，它从此没有点数'
    }
    if (pickMode.value == 'slot') {
      return '点一个槽装上【' + DRAW_SKILLS[pickStep.value].name
        + '】，槽里原来那件卸回技能库' + (pickForced.value ? '' : '。取消就先放在技能库里')
    }
    if (pickMode.value == 'pip') {
      return '点一张牌，让它也算 ' + faceOfValue(pickStep.value) + ' 点'
    }
    return '点一张牌，然后选往上推还是往下推'
  })

  // 这一件挑的是槽还是牌
  const picksSlot = computed<boolean>(() : boolean => {
    return pickMode.value == 'slot'
  })

  // 槽那一行底下写什么：空着就报它能管什么，嵌着就报换掉谁、退多少
  function slotNote(one : SlotView) : string {
    if (one.now < 0) {
      return '空着 · 装上就管 ' + one.label + '（' + one.cover + ' 张）'
    }
    if (one.now == pickStep.value) {
      return '它现在就装在这儿'
    }
    return '现在是【' + DRAW_SKILLS[one.now].name + '】—— 换下来回技能库'
  }

  // 点一个槽：真正把技能嵌进去，钱在这儿扣。
  //
  // ---- 换掉槽里那件要**退一半** ----
  //
  // 不退的话「换掉」就是一条白给的路：卖出退解锁价的一半，而卖出和
  // 买入在同一个商店里摆着 —— 所以「先卖再买」永远比「直接换」多赚
  // sellPriceOf(旧) 金币，而两条路的结果一模一样。
  //
  // 那种差价不是取舍，是**对操作顺序的收费** —— 知道的人多拿一笔，
  // 不知道的人白亏，而界面上看不出来。退了之后两条路等价，
  // 「卖出」那颗钮就只剩一个正当用途：**我现在不想买，先把槽腾出来**
  function onPickSlot(at : number) {
    const k = pickStep.value
    if (k < 0 || k >= DRAW_SKILLS.length) {
      clearPick()
      return
    }
    const data = loadDrawSave()
    const note = equipSkill(data, k, at)
    commit(data)
    clearPick()
    if (guideStep.value == GUIDE_BUY) {
      // 新手引导里那一包：装上槽才算完，换成收尾那一页
      guideStep.value = GUIDE_END
      return
    }
    if (note != '') {
      uni.showToast({ title: note, icon: 'none' })
    }
  }


  // 整副牌按点数摊成 13 行。at 是它在牌组数组里的下标 ——
  // 改造要按下标改，所以得一路带着。
  //
  // 行分组按**牌面点数**（rankOfText 会切掉 '+' 后面那截），
  // 所以一张 ♠3·7 还是排在 3 那一行 —— 它牌面就是 3
  type PickItem = {
    at : number
    text : string
    red : boolean
    // 贴过点数卡吗。贴过的要描一下，不然挑牌的时候看不出哪张已经加强过
    pipped : boolean
  }

  type PickRow = {
    rank : string
    items : PickItem[]
  }

  // 「现有牌组」弹窗开着没有
  const showDeck = ref<boolean>(false)

  const deckRows = computed<PickRow[]>(() : PickRow[] => {
    const cards = deckOf(save.value)
    const rows : PickRow[] = []
    // A–K 之后还有零点、无点数两行（DECK_RANKS）。那两行**没牌就不列** ——
    // 大多数牌组里一张都没有，列出来两行「没有」只是噪音
    for (let r = 0; r < DECK_RANKS.length; r++) {
      const rank = DECK_RANKS[r]
      const items : PickItem[] = []
      for (let i = 0; i < cards.length; i++) {
        if (rankOfText(cards[i]) != rank) {
          continue
        }
        const suit = suitOfText(cards[i])
        items.push({
          at: i,
          // 写 cardLabel 而不是原文：♠3+7 在界面上是「♠3·7」
          text: cardLabel(cards[i]),
          red: suit == SUITS[1] || suit == SUITS[2],
          pipped: pipsOfText(cards[i]).length > 0
        } as PickItem)
      }
      if (items.length == 0 && (rank == ZERO_RANK || rank == BLANK_RANK)) {
        continue
      }
      rows.push({ rank: rankFace(rank), items: items } as PickRow)
    }
    // 熔合出来的大点数（14 以上）不在 DECK_RANKS 里，统统归到最后一行「熔」，
    // 不然它们在这张表里就看不见、也挑不着
    const fused : PickItem[] = []
    for (let i = 0; i < cards.length; i++) {
      if (DECK_RANKS.indexOf(rankOfText(cards[i])) >= 0) {
        continue
      }
      const suit = suitOfText(cards[i])
      fused.push({
        at: i,
        text: cardLabel(cards[i]),
        red: suit == SUITS[1] || suit == SUITS[2],
        pipped: pipsOfText(cards[i]).length > 0
      } as PickItem)
    }
    if (fused.length > 0) {
      rows.push({ rank: '熔', items: fused } as PickRow)
    }
    return rows
  })

  function doBuyFix(at : number) {
    const list = shelfGoods(save.value)
    if (at >= list.length || list[at].sold) {
      return
    }
    const item = fixItemOf(list[at].tag)
    // **货架上这件和表里对不上就什么都不做。**
    //
    // fixItemOf 查不到的时候返回表里第 0 件（推一格）—— 那是个方便的兜底，
    // 可在这儿它是个陷阱：key 认不出来就会静默地卖成另一件货。
    // 【加架】和【平价】写进表之后、接线之前正是这么坏的：
    // 它们掉进下面那个 else，被当成「同化」卖了（标价还正好一样）。
    //
    // 所以这道闸要摆在最前面：对不上就报一句、不扣钱。
    // 下次往表里加货，漏接线会当场看得见
    if (item.key != list[at].tag) {
      uni.showToast({ title: '这件货还没接线（' + list[at].tag + '）', icon: 'none' })
      return
    }
    if (save.value.gold < item.price) {
      uni.showToast({ title: '金币不够', icon: 'none' })
      return
    }
    // 开包是另一路：它当场扣钱、当场标卖掉（理由见 openPack 上面那段）
    if (isPack(item.key)) {
      openPack(at, item.key, item.price)
      return
    }
    // 四件唯一扩容也是当场结清的：它们不用挑什么 —— 点一下，
    // 规则里那个数就变了。所以没有「挑到一半取消」那回事
    if (item.once) {
      buyGrow(at, item.key, item.price)
      return
    }
    // 彩票也当场结清：没什么可挑的，记一张，下次进店开
    if (item.key == 'lotto') {
      buyLotto(at, item.price)
      return
    }
    // **先不扣钱** —— 挑牌挑到一半取消了不该白花。
    // 扣钱、标卖掉都在真正改完那一刻（doPush / doSame / doDrop）
    //
    // 原先这儿还有砺钩和洗点两支（它们挑的是技能，不是牌）。两件都删了
    if (item.step > 0) {
      pickMode.value = 'push'
    } else if (item.key == 'drop') {
      pickMode.value = 'drop'
    } else if (item.key == 'same') {
      pickMode.value = 'same'
    } else if (item.key == 'copy' || item.key == 'fuse' || item.key == 'blank') {
      // 这三件的 pickMode 就是它的 key（拓印、熔合、抹点）
      pickMode.value = item.key
    } else {
      // 走到这儿就是表里加了货、这个分支没跟上。
      // **不猜**（从前这儿是 `: 'same'`，于是认不出来的一律卖成同化）
      uni.showToast({ title: '这件货还没接线（' + item.key + '）', icon: 'none' })
      return
    }
    pickStep.value = item.step
    pickAt.value = at
    pickPrice.value = item.price
    pickFirst.value = -1
  }

  // 这一次挑**不许取消**。
  //
  // 只有一种情况立它：开包开出技能、而槽全满了，于是转去挑槽
  //（见 takePackSkill）。那时候钱已经在摊开候选那一刻扣过了，
  // 取消等于花钱买了个空 —— 跟包本身「没有取消」那条规矩是同一条。
  //
  // 别的挑槽（货架上直买）照旧能取消：那边钱还没扣（见 buySkill）
  const pickForced = ref<boolean>(false)

  function cancelPick() {
    if (pickForced.value) {
      return
    }
    pickMode.value = ''
    pickFirst.value = -1
    pickStep.value = 0
    pickAt.value = -1
    pickPrice.value = 0
  }

  // 真正清掉挑选状态。cancelPick 是「用户想退出」，这个是「挑完了」——
  // 后者不受 pickForced 管，不然嵌完也退不出来
  function clearPick() {
    pickForced.value = false
    pickMode.value = ''
    pickFirst.value = -1
    pickStep.value = 0
    pickAt.value = -1
    pickPrice.value = 0
  }

  // ---------- 三件唯一扩容（加栏、加架、平价） ----------
  //
  // 全是**唯一**道具：一轮只买得到一次，买过就不再上货
  //（见 draw-save 的 takenOnceKeys）。这儿那道「已经买过」的闸
  // 是第二层保险 —— 手快点两下不该买两次。
  //
  // 这四件是全表唯一改**规则**的货。别的道具改的是「我手里多了什么」，
  // 这四件改的是「这一轮我能有多少」：
  //
  //   加栏 —— 道具栏宽一格。那一栏**刷不动**，所以它纯粹是运气面变宽。
  //   加架 —— 技能/卡牌栏宽一格。那一栏**刷得动**，所以它还让每次刷新更值。
  //   加权 —— 点数槽多一格，也就是多一次升级的余量。
  //   平价 —— 刷新价拍平成 30，不再翻倍。
  //
  // 四件里三件是「**越早买越值**」（加栏、加架、平价都是按剩下的关数折现），
  // 只有加权什么时候买都一样值。那也是加权能压成史诗、
  // 另外三件压在稀有和普通的理由（见 FIX_ITEMS 里各自那段）。
  //
  // 加权**只抬容量、不填格子**：多出来那一格是空的，得再刷到砺钩
  // 才用得上。所以它买的是「升得动」，不是「升一级」——
  // 不然 180 块就等于一个打折的砺钩，那两件货就重了
  function buyGrow(at : number, key : string, price : number) {
    if (save.value.gold < price) {
      uni.showToast({ title: '金币不够', icon: 'none' })
      return
    }
    const data = loadDrawSave()
    let done = false
    if (key == 'shelf') {
      done = growShelf(data)
    } else if (key == 'card') {
      done = growCard(data)
    } else if (key == 'library') {
      done = growLibrary(data)
    } else {
      done = makeFlat(data)
    }
    if (!done) {
      uni.showToast({ title: '这件已经买过了', icon: 'none' })
      return
    }
    data.gold = data.gold - price
    markSold(data, at)
    commit(data)
    uni.showToast({ title: growNote(key, data), icon: 'none' })
  }

  // 买完报什么。每一件都要说清**什么时候生效** ——
  // 这三件没有一个是「当场看得见」的，不说的话会像没反应
  function growNote(key : string, data : DrawSave) : string {
    if (key == 'shelf') {
      // 道具那一栏刷新不补货（见 rollShelf 的 keepFix），所以只能等下一关
      return '道具栏变成 ' + fixSlotsOf(data) + ' 格（下一关的货开始生效）'
    }
    if (key == 'card') {
      // 这一栏刷新会重摇，所以当场刷一次就看得见多出来的那格
      return '技能/卡牌栏变成 ' + cardSlotsOf(data) + ' 格（换一批就看得见）'
    }
    if (key == 'library') {
      return '技能库变成 ' + libraryCapFor(data, difficultyOf(drawSaveSlot())) + ' 格'
    }
    return '换一批固定 ' + FLAT_REROLL + ' 块了，不再翻倍'
  }

  // ---------- 彩票 ----------
  //
  // 买下来只是记一张（save.lotto），开奖在下一次进店那一刻（draw-save 的 drawLottery），
  // 进门那句播报在 announcePrize
  function buyLotto(at : number, price : number) {
    if (save.value.gold < price) {
      uni.showToast({ title: '金币不够', icon: 'none' })
      return
    }
    const data = loadDrawSave()
    data.gold = data.gold - price
    data.lotto = data.lotto + 1
    markSold(data, at)
    commit(data)
    uni.showToast({ title: '彩票收好了，下次进商店开奖', icon: 'none' })
  }

  // 进店报一声上一次开奖的结果，报完清掉（prize 写回 -1），退出再进不重报
  function announcePrize() {
    if (save.value.prize < 0) {
      return
    }
    const won = save.value.prize
    const data = loadDrawSave()
    data.prize = -1
    commit(data)
    uni.showModal({
      title: '彩票开奖',
      content: won > 0 ? '中了 ' + won + ' 金币，已经进账。' : '一张都没中。',
      showCancel: false,
      confirmText: '知道了'
    })
  }

  // ---------- 开包（技能二选一 / 五选一 / 牌六选一） ----------

  // 摇出来的候选。技能装技能下标，牌装牌面文本。
  // 原先还有个 packSlots（跟 packSkills 一一对应，每个候选定好的槽），
  // 花色槽砍掉之后没用了
  const packSkills = ref<number[]>([] as number[])
  const packCards = ref<string[]>([] as string[])
  // 开包是**先扣钱后挑**，跟别的道具相反。
  //
  // 别的道具是「挑到一半取消了不该白花」，可开包一摊开就把随机结果
  // 给你看了 —— 要是能看完再取消，那就是免费窥牌：看一眼不满意退掉，
  // 下次再买（同一件货），等于花 0 块无限重摇。所以钱在摆出候选那一刻就扣，
  // 货也那一刻就标卖掉；挑哪一个是你唯一剩下的自由
  const packOpen = computed<boolean>(() : boolean => {
    return packSkills.value.length > 0 || packCards.value.length > 0
  })

  const packTitle = computed<string>(() : string => {
    return packSkills.value.length > 0
      ? '技能 ' + packSkills.value.length + ' 选 1'
      : '牌 ' + packCards.value.length + ' 选 1'
  })

  type PackCard = {
    text : string
    // 界面上怎么写（无点数牌写「♠无」）。text 留原文，挑中时按它加进牌组
    label : string
    red : boolean
  }

  const packCardViews = computed<PackCard[]>(() : PackCard[] => {
    const out : PackCard[] = []
    for (let i = 0; i < packCards.value.length; i++) {
      const suit = suitOfText(packCards.value[i])
      out.push({
        text: packCards.value[i],
        label: cardLabel(packCards.value[i]),
        red: suit == SUITS[1] || suit == SUITS[2]
      } as PackCard)
    }
    return out
  })

  // 买一个包：当场摇候选、当场扣钱、当场标卖掉
  function openPack(at : number, key : string, price : number) {
    const want = packSize(key)
    if (key == 'cards6') {
      // 跟货架摆牌同一套（rollShopCard）：从现有牌组里按张数加权抽，
      // 到了上限的点数不出，零点 / 无点数牌偶尔出一张
      const drawn : string[] = []
      for (let i = 0; i < want; i++) {
        const card = rollShopCard(save.value)
        // **不去重** —— 摇出两张一样的是真有可能的事，
        // 而「六张里有两张重了」本身就是这一包的运气
        if (card != '') {
          drawn.push(card)
        }
      }
      // 一张都抽不出来（每个点数都到上限了）：不扣钱，别让人花六十块开个空包
      if (drawn.length == 0) {
        uni.showToast({ title: '每个点数都到上限了，没有牌可卖', icon: 'none' })
        return
      }
      const data = loadDrawSave()
      data.gold = data.gold - price
      markSold(data, at)
      commit(data)
      packCards.value = drawn
      return
    }
    // 技能包。**一个槽都没有就开不了** —— 开出来没处放等于白花。
    // 槽满了照样能开（挑完会换掉槽里那件）
    if (noSlots.value) {
      uni.showToast({ title: '还没选角色 —— 没有槽可嵌', icon: 'none' })
      return
    }
    if (libFull.value) {
      uni.showToast({ title: '技能库满了（' + libCap.value + ' 件），先卖掉一件', icon: 'none' })
      return
    }
    // 只摇**槽里还没有的** —— 同一件嵌两个槽毫无意义（触发只算一次）
    const free : number[] = []
    for (let k = 0; k < DRAW_SKILLS.length; k++) {
      if (!hasSkill(save.value, k)) {
        free.push(k)
      }
    }
    if (free.length == 0) {
      uni.showToast({ title: '技能全齐了', icon: 'none' })
      return
    }
    // 候选之间去重（跟牌不同：摇出两个一样的技能就是少给了一个选项）。
    // 池子不够 want 个就给几个算几个。
    //
    // 挑掉一个之后整个换成剩下那些 —— UTS 那边数组删不了元素，
    // 只能换引用（跟 rollShelf 里那段一个写法）
    const picks : number[] = []
    let pool : number[] = free
    for (let i = 0; i < want && pool.length > 0; i++) {
      const at2 = Math.floor(Math.random() * pool.length)
      picks.push(pool[at2])
      const rest : number[] = []
      for (let j = 0; j < pool.length; j++) {
        if (j != at2) {
          rest.push(pool[j])
        }
      }
      pool = rest
    }
    // 原先每个候选摊开时还定好一个槽（花色 / 点数），弹窗里看得见。
    // 只剩一个槽之后没这回事了
    const data = loadDrawSave()
    data.gold = data.gold - price
    markSold(data, at)
    commit(data)
    packSkills.value = picks
  }

  function clearPack() {
    packSkills.value = [] as number[]
    packCards.value = [] as string[]
    packPick.value = -1
  }

  // 放弃这一包：一个都不拿。钱不退 —— 摊开那一刻就扣了（理由见 packOpen 上面那段）
  function abandonPack() {
    uni.showModal({
      title: '放弃这一包？',
      content: '一个都不拿，花的钱不退。',
      confirmText: '放弃',
      cancelText: '再看看',
      success: (res) => {
        if (res.confirm) {
          clearPack()
        }
      }
    })
  }

  // 技能包里选中的那个（技能下标），-1 = 还没选
  const packPick = ref<number>(-1)

  // 原先这儿有 packBlocked（「它定好的那个槽满着吗」，满着就不给挑）
  // 和 packAnyBlocked（带一块「就地卖技能腾位置」的面板）。
  //
  // 两个都删了：**包里的技能一概挑得下来**。槽满了也能挑 —— 嵌的时候
  // 换掉里头那件就是（见 embedSkill）。包是花过钱才摊开的，
  // 为了「现在没位子」把候选压暗太狠，而且那块腾位置面板
  // 在「嵌进去会换掉」这条规则下根本没有存在的理由了

  // 包里挑中的那件会落到哪个槽（见 takePackSkill：第一个空槽，
  // 全满就再问你一次）。摊开之前就报出来 ——
  // 「会换掉一件」这种后果不能等拿完才说
  const packLand = computed<string>(() : string => {
    if (slotViews.value.length == 0) {
      return '还没选角色，没处放'
    }
    return '挑完之后你来定嵌进哪个槽'
  })

  function pickPackSkill(si : number) {
    packPick.value = packSkills.value[si]
  }

  function confirmPackSkill() {
    if (packPick.value < 0) {
      return
    }
    // true：弹「挑哪个槽」让你定嵌在哪
    takePackSkill(packPick.value, true)
  }

  // 从包里挑中一件：**嵌进哪个槽由你定**，跟货架上买技能一样弹「挑哪个槽」。
  // 槽上印的点数不一样，嵌哪个结果就不一样 —— 这是个真决定，不替人取第一个空槽。
  //
  // 借货架那套挑槽弹层（pickMode = 'slot'），但**价钱传 0** ——
  // 包的钱在摊开那一刻就扣过了（见 openPack）。再扣一次就是双重收费。
  //
  // canAsk = false 是**离开页面那条路**（见 autoTakePack）：那时候弹层
  // 弹出来也没人点得了，所以退回「嵌第 0 槽」—— 拿到点东西好过两手空空
  function takePackSkill(k : number, canAsk : boolean) {
    const data = loadDrawSave()
    // **一个槽都没有**（还没选角色）就直接收摊。
    //
    // 正常走不到：开包那两件在 fixDetail 里就被 noSlots 挡住了。
    // 但要是走到了，下面两条路都会坏 —— 挑槽弹层会摆出一张空列表
    //（而它不许取消），嵌第 0 槽则会被 embedSkill 的越界检查静默吞掉
    if (data.slotSkills.length == 0) {
      clearPick()
      clearPack()
      uni.showToast({ title: '还没选角色 —— 没有槽可嵌', icon: 'none' })
      return
    }
    addToLibrary(data, k)
    commit(data)
    clearPack()
    if (canAsk) {
      askEquip(k, guideStep.value == GUIDE_BUY)
      return
    }
    // 离开页面那条路（autoTakePack）：问不了，就先放在技能库里
    uni.showToast({ title: DRAW_SKILLS[k].name + ' 放进技能库了', icon: 'none' })
  }


  // ---------- 新手引导 ----------
  //
  // 每个存档第一次进店走一遍：欢迎 → 买下【技能二选一】并挑一个 → 收尾。
  // 第二步**拦住别的操作**（别的货、换一批、卖出、退出、开始下一关），
  // 只放那件二选一过去 —— 第一店一定上它、第 1 关的奖励也够买（见 rollShelf、DRAW_LEVELS）。
  // 老档第一次进店时货架上没有它、或者钱不够，就只给欢迎页，不强买
  const GUIDE_NONE : number = 0
  const GUIDE_WELCOME : number = 1
  const GUIDE_BUY : number = 2
  const GUIDE_END : number = 3
  const guideStep = ref<number>(GUIDE_NONE)

  const guideText = computed<string>(() : string => {
    if (guideStep.value == GUIDE_WELCOME) {
      return '过关赢来的金币在这儿花：买技能、买牌、改牌组。没花完的钱每关还会生利息。'
        + '\n\n第一次来，先买一个技能带进下一关吧。'
    }
    return '技能装在槽上才生效：打出的牌落在槽上印的点数上就会触发。没装的放在技能库里，随时能换上去。'
      + '\n\n剩下的钱可以接着逛，也可以攒着吃利息。'
  })

  // 货架上还没卖掉的那件技能二选一的下标，没有就 -1
  const guidePackAt = computed<number>(() : number => {
    const list = shelfGoods(save.value)
    for (let i = 0; i < list.length; i++) {
      if (list[i].kind == GOODS_FIX && list[i].tag == 'pack2' && !list[i].sold) {
        return i
      }
    }
    return -1
  })

  function startGuide() {
    if (guideStep.value != GUIDE_NONE || shopGuided(drawSaveSlot())) {
      return
    }
    guideStep.value = GUIDE_WELCOME
  }

  function guideNext() {
    if (guideStep.value == GUIDE_WELCOME) {
      if (guidePackAt.value >= 0 && save.value.gold >= fixItemOf('pack2').price) {
        guideStep.value = GUIDE_BUY
        return
      }
    }
    // 收尾，或者买不成二选一的老档：引导到此为止
    guideStep.value = GUIDE_NONE
    setShopGuided(drawSaveSlot())
  }

  // 第二步里拦操作：拦下了返回 true
  function guideLock() : boolean {
    if (guideStep.value != GUIDE_BUY) {
      return false
    }
    uni.showToast({ title: '先买下「技能二选一」', icon: 'none' })
    return true
  }

  function takePackCard(text : string) {
    const data = loadDrawSave()
    const cards = deckOf(data)
    cards.push(text)
    setDeck(data, cards)
    commit(data)
    clearPack()
    uni.showToast({ title: cardLabel(text) + ' 加进牌组了', icon: 'none' })
  }

  // 包摊开着就离开页面的话，**替你拿第一个** ——
  // 钱已经扣了，候选也已经摇定，这时候两手空空出去纯属亏。
  // 拿第一个是任意的，但它好过什么都不给。
  //
  // 原先这儿还要跳过「选不了的」（槽满），现在一概拿得下来，
  // 所以直接拿第 0 个。
  //
  // canAsk 传 false：这会儿页面正在走掉，弹「挑哪个槽」没人点得了
  function autoTakePack() {
    // ---- 挑槽挑到一半被切走 ----
    //
    // 只有「开包开出技能、槽全满」那一种会立 pickForced（钱已付），
    // 所以它跟包摊开着被切走是同一个问题，解法也一样：嵌第 0 槽。
    // 不管这一下的话那件技能连钱一起没了
    if (pickForced.value && pickMode.value == 'slot') {
      const k = pickStep.value
      clearPick()
      if (k >= 0 && k < DRAW_SKILLS.length) {
        takePackSkill(k, false)
      }
      return
    }
    if (packSkills.value.length > 0) {
      takePackSkill(packSkills.value[0], false)
      return
    }
    if (packCards.value.length > 0) {
      takePackCard(packCards.value[0])
    }
  }

  function onPickCard(at : number) {
    if (pickMode.value == 'drop') {
      askDrop(at)
      return
    }
    // 零点牌、无点数牌没有能推、能贴的那个点数 —— 推点数和点数卡都不对它们下手
    // 点数卡不贴零点 / 无点数牌（见 draw-save 的 ZERO_RANK 那段）。
    // 推点数只拦无点数牌 —— 零点牌推得动（往上一格就是 A），熔合出来的大点数也推得动
    if (pickMode.value == 'pip' && !hasFace(deckOf(save.value)[at])) {
      uni.showToast({ title: '这张没有点数可改', icon: 'none' })
      return
    }
    if (pickMode.value == 'push' && rankOfText(deckOf(save.value)[at]) == BLANK_RANK) {
      uni.showToast({ title: '无点数牌推不动', icon: 'none' })
      return
    }
    if (pickMode.value == 'pip') {
      doPip(at)
      return
    }
    if (pickMode.value == 'copy') {
      askCopy(at)
      return
    }
    if (pickMode.value == 'blank') {
      askBlank(at)
      return
    }
    if (pickMode.value == 'fuse') {
      if (pickFirst.value < 0) {
        if (!fusable(deckOf(save.value)[at])) {
          uni.showToast({ title: '熔合不收无点数的牌', icon: 'none' })
          return
        }
        pickFirst.value = at
        return
      }
      if (pickFirst.value == at) {
        pickFirst.value = -1
        return
      }
      askFuse(pickFirst.value, at)
      return
    }
    if (pickMode.value == 'same') {
      if (pickFirst.value < 0) {
        pickFirst.value = at
        return
      }
      if (pickFirst.value == at) {
        // 点同一张等于取消选中
        pickFirst.value = -1
        return
      }
      doSame(pickFirst.value, at)
      return
    }
    askPush(at)
  }

  // 推点数：往上还是往下，挑完牌当场问
  function askPush(at : number) {
    const cards = deckOf(save.value)
    if (at >= cards.length) {
      return
    }
    uni.showModal({
      title: '推 ' + pickStep.value + ' 格',
      content: cardLabel(cards[at]) + ' 往哪边推？往上不封顶（K 再往上是 14），往下最低到 A。',
      confirmText: '往上 +' + pickStep.value,
      cancelText: '往下 −' + pickStep.value,
      success: (res) => {
        doPush(at, res.confirm ? pickStep.value : -pickStep.value)
      }
    })
  }

  // 点数挪 delta 格，按**点数值**算，不按 A–K 那条梯子：
  //   往上**不封顶** —— K 推一格是 14，跟熔合出来的大点数同一套写法（fusedRank）；
  //   往下**最低到 A**，不绕圈 —— 绕圈的话「推三格」能把 A 变成 Q，
  //     那就不是「推」而是「随便改」了；
  //   零点牌往上推一格就是 A，往下推不动（它已经在底下了）。
  // 推到 11 就是一张 J（通吃照样有），这跟原来沿梯子推是一回事
  function doPush(at : number, delta : number) {
    const data = loadDrawSave()
    const cards = deckOf(data)
    if (at >= cards.length) {
      clearPick()
      return
    }
    const suit = suitOfText(cards[at])
    const was = valueOfRankText(rankOfText(cards[at]))
    let to = was + delta
    if (to < 1) {
      // 零点牌往下推：原地不动（下面那句「推不动」接着报）
      to = was < 1 ? was : 1
    }
    if (to == was) {
      uni.showToast({ title: '已经到头了，推不动', icon: 'none' })
      clearPick()
      return
    }
    const wasText = cards[at]
    // **点数卡贴的那几个点数留着** —— 推的是牌面那个点数，
    // 不是「把这张牌重做一遍」。不留的话「先贴点数卡再推一格」
    // 会把九十块悄悄抹掉
    let next = cardText(suit, fusedRank(to))
    const pips = pipsOfText(wasText)
    for (let i = 0; i < pips.length; i++) {
      next = addPip(next, pips[i])
    }
    cards[at] = next
    data.gold = data.gold - pickPrice.value
    setDeck(data, cards)
    // 这会儿才标卖掉 —— 改成了才算买了
    markSold(data, pickAt.value)
    commit(data)
    uni.showToast({
      title: cardLabel(wasText) + ' → ' + cardLabel(cards[at]),
      icon: 'none'
    })
    clearPick()
  }

  // 点数卡：给这张牌贴一个额外点数，它从此**同时**算几个点数。
  //
  // 牌面不动 —— 所以它不会变成 J（通吃焊在 rank 上），也不触发点数技
  //（triggersOf 读的是 rank）。它只多了一条钓牌的出路，
  // 详见 draw-levels 的 PIP_PRICE 那段
  function doPip(at : number) {
    const data = loadDrawSave()
    const cards = deckOf(data)
    if (at >= cards.length) {
      clearPick()
      return
    }
    const was = cards[at]
    const next = addPip(was, pickStep.value)
    if (next == was) {
      // 贴重了。**不扣钱** —— 这张已经算那个点数了，贴上去一点用没有
      uni.showToast({ title: '这张已经算 ' + faceOfValue(pickStep.value) + ' 点了', icon: 'none' })
      return
    }
    cards[at] = next
    data.gold = data.gold - pickPrice.value
    setDeck(data, cards)
    markSold(data, pickAt.value)
    commit(data)
    uni.showToast({
      title: cardLabel(was) + ' → ' + cardLabel(next) + '（两个点数都算）',
      icon: 'none'
    })
    clearPick()
  }

  // 同化：右边那张**完全变成**左边那张 —— 点数、花色、
  // **连点数卡贴的那几个点数一起**（它是整张照抄）。
  //
  // 于是牌组里会出现两张一模一样的牌。规则上没冲突（牌只按点数、花色
  // 参与判定，没有唯一性约束），而那两张必然互相钓得上 —— 这就是买它的理由。
  //
  // 「连点数卡一起抄」让它多了一个用法：贴好一张核心牌，
  // 再花一百块复制一张。两张加起来比贴两次点数卡（180）便宜
  function doSame(from : number, to : number) {
    const data = loadDrawSave()
    const cards = deckOf(data)
    if (from >= cards.length || to >= cards.length) {
      clearPick()
      return
    }
    const was = cards[to]
    cards[to] = cards[from]
    data.gold = data.gold - pickPrice.value
    setDeck(data, cards)
    markSold(data, pickAt.value)
    commit(data)
    uni.showToast({ title: cardLabel(was) + ' → ' + cardLabel(cards[to]), icon: 'none' })
    clearPick()
  }

  // 弃饵：问一句再删。删牌是不可逆的，而且一次性道具买了就用掉了
  function askDrop(at : number) {
    const cards = deckOf(save.value)
    if (at >= cards.length) {
      return
    }
    if (cards.length <= DECK_MIN) {
      uni.showToast({ title: '牌组不能少于 ' + DECK_MIN + ' 张', icon: 'none' })
      return
    }
    const left = countOfRank(save.value, rankOfText(cards[at])) - 1
    uni.showModal({
      title: '弃饵',
      content: '把 ' + cardLabel(cards[at]) + ' 从牌组里拿掉？拿掉之后这个点数还剩 '
        + left + ' 张。' + (left == 0 ? '（这个点数就从牌组里消失了）' : ''),
      confirmText: '拿掉',
      cancelText: '再想想',
      success: (res) => {
        if (res.confirm) {
          doDrop(at)
        }
      }
    })
  }

  function doDrop(at : number) {
    const data = loadDrawSave()
    const cards = deckOf(data)
    if (at >= cards.length || cards.length <= DECK_MIN) {
      clearPick()
      return
    }
    const was = cards[at]
    const next : string[] = []
    for (let i = 0; i < cards.length; i++) {
      if (i != at) {
        next.push(cards[i])
      }
    }
    data.gold = data.gold - pickPrice.value
    setDeck(data, next)
    markSold(data, pickAt.value)
    commit(data)
    uni.showToast({ title: cardLabel(was) + ' 从牌组里拿掉了', icon: 'none' })
    clearPick()
  }

  // ---------- 拓印 / 熔合 / 抹点 ----------
  //
  // 三件都是「挑完才扣钱、才标卖掉」，跟同化、弃饵一个待遇。
  // 动不可逆的（熔合两张变一张、抹点抹掉点数）先问一句

  // 拓印：牌组里多一张一模一样的，点数卡一起抄（牌面文本整串复制）
  function askCopy(at : number) {
    const cards = deckOf(save.value)
    if (at >= cards.length) {
      return
    }
    if (cards.length >= DECK_CAP) {
      uni.showToast({ title: '牌组满了（' + DECK_CAP + ' 张）', icon: 'none' })
      return
    }
    const data = loadDrawSave()
    const next = deckOf(data)
    const text = next[at]
    next.push(text)
    data.gold = data.gold - pickPrice.value
    setDeck(data, next)
    markSold(data, pickAt.value)
    commit(data)
    uni.showToast({ title: '多了一张 ' + cardLabel(text), icon: 'none' })
    clearPick()
  }

  // 熔合收得了哪张：有点数的都行（A–K、J、熔合出来的大点数，**连零点牌也收**）。
  // 零点牌加 0 等于没加，所以熔进去它就直接没了 —— 那是一条清掉零点牌的路。
  // 只有无点数牌不收：它没有点数，「点数相加」对它无从说起
  function fusable(text : string) : boolean {
    return rankOfText(text) != BLANK_RANK
  }

  // 两张熔成的那张的牌面文本：花色照旧，点数相加（fusedRank 管怎么写），
  // 两张贴的点数卡并到一起（去重，跟新点数撞了的不留）
  function fusedText(a : string, b : string) : string {
    const sum = valueOfRankText(rankOfText(a)) + valueOfRankText(rankOfText(b))
    let out = cardText(suitOfText(a), fusedRank(sum))
    const pips = pipsOfText(a).concat(pipsOfText(b))
    for (let i = 0; i < pips.length; i++) {
      if (pips[i] != sum) {
        out = addPip(out, pips[i])
      }
    }
    return out
  }

  function askFuse(firstAt : number, secondAt : number) {
    const cards = deckOf(save.value)
    if (firstAt >= cards.length || secondAt >= cards.length) {
      return
    }
    const a = cards[firstAt]
    const b = cards[secondAt]
    if (!fusable(b)) {
      uni.showToast({ title: '熔合不收无点数的牌', icon: 'none' })
      return
    }
    if (suitOfText(a) != suitOfText(b)) {
      uni.showToast({ title: '熔合要两张同花色的牌', icon: 'none' })
      return
    }
    if (cards.length <= DECK_MIN) {
      uni.showToast({ title: '牌组不能少于 ' + DECK_MIN + ' 张', icon: 'none' })
      return
    }
    const fused = fusedText(a, b)
    // 有一张是零点牌：加 0 等于没加，它就这么没了 —— 话要照实说
    let note = ''
    if (rankOfText(a) == ZERO_RANK || rankOfText(b) == ZERO_RANK) {
      note = '（零点牌加 0 等于没加，熔进去就没了）'
    } else if (rankOfText(fused) == 'J') {
      note = '（加出 11，就是一张 J）'
    }
    uni.showModal({
      title: '熔合',
      content: cardLabel(a) + ' 和 ' + cardLabel(b) + ' 合成一张 ' + cardLabel(fused)
        + '，牌组少一张。' + note,
      confirmText: '熔合',
      cancelText: '再想想',
      success: (res) => {
        if (res.confirm) {
          doFuse(firstAt, secondAt)
        }
      }
    })
  }

  // 新牌放在先点的那张的位置上，后点的那张拿掉
  function doFuse(firstAt : number, secondAt : number) {
    const data = loadDrawSave()
    const cards = deckOf(data)
    if (firstAt >= cards.length || secondAt >= cards.length || cards.length <= DECK_MIN) {
      clearPick()
      return
    }
    const a = cards[firstAt]
    const b = cards[secondAt]
    const fused = fusedText(a, b)
    const next : string[] = []
    for (let i = 0; i < cards.length; i++) {
      if (i == secondAt) {
        continue
      }
      next.push(i == firstAt ? fused : cards[i])
    }
    data.gold = data.gold - pickPrice.value
    setDeck(data, next)
    markSold(data, pickAt.value)
    commit(data)
    uni.showToast({ title: cardLabel(a) + ' + ' + cardLabel(b) + ' → ' + cardLabel(fused), icon: 'none' })
    clearPick()
  }

  // 抹点：问一句再抹 —— 抹掉就回不来了（点数卡一起没）
  function askBlank(at : number) {
    const cards = deckOf(save.value)
    if (at >= cards.length) {
      return
    }
    if (rankOfText(cards[at]) == BLANK_RANK) {
      uni.showToast({ title: '这张本来就没有点数', icon: 'none' })
      return
    }
    uni.showModal({
      title: '抹点',
      content: '把 ' + cardLabel(cards[at]) + ' 的点数抹掉？它从此按点数钓不到牌，'
        + '也不会被按点数钓走' + (pipsOfText(cards[at]).length > 0 ? '（贴的点数卡一起没）' : '') + '。',
      confirmText: '抹掉',
      cancelText: '再想想',
      success: (res) => {
        if (res.confirm) {
          doBlank(at)
        }
      }
    })
  }

  function doBlank(at : number) {
    const data = loadDrawSave()
    const cards = deckOf(data)
    if (at >= cards.length) {
      clearPick()
      return
    }
    const was = cards[at]
    cards[at] = cardText(suitOfText(was), BLANK_RANK)
    data.gold = data.gold - pickPrice.value
    setDeck(data, cards)
    markSold(data, pickAt.value)
    commit(data)
    uni.showToast({ title: cardLabel(was) + ' → ' + cardLabel(cards[at]), icon: 'none' })
    clearPick()
  }

  // 原先这儿有个 rankIndexOf（牌面在 A–K 梯子上第几格），推点数靠它走梯子。
  // 推点数改成按点数值算（往上不封顶）之后它没有调用方了

  // 原先这儿有 kindText（「可升级 / 不可升级」）、upgradeHint（「可升级 /
  // 已满级 / 槽满了」）、ownedCount、ownedKeys。
  //
  // 全没了：等级这件事整个删了，而「拥有」和「嵌在槽里」现在是同一回事 ——
  // 所以「我的技能」那一栏改成按**槽**列（slotViews），
  // 每一行是「这个槽印着什么 + 嵌着哪件 + 卖掉它」

  function commit(data : DrawSave) {
    saveDraw(data)
    save.value = data
  }

  // 卖掉一个槽里的技能：**把那个槽清空**，退解锁价的一半。
  //
  // 从前卖出有三个用途（腾名额、换钱、腾格子给升级），现在只剩一个 ——
  // 腾出这个槽，好嵌别的。而且现在「嵌进去会换掉里头那件」本来就做得到，
  // 所以卖出的真正意义是**把钱拿回来一半**（换掉是直接丢）。
  //
  // at 是槽的下标，不是技能下标 —— 槽才是这一页的主体
  // 原先这儿有 sellSlot（按槽卖出：清空槽、退一半）。技能改成先进技能库之后，
  // 槽这边只「卸下」（unequipSlot），卖出在技能库那一栏（sellSkill）


  // 原先这儿有 tapSuit / tapRank（点格子手动分配）、pick（选中技能）、
  // doSharpen（升级）、coverText（「装在哪、管什么」）。
  //
  // 全没了：**槽上印死标签**，所以不存在「摆位置」；
  // 没有等级，所以不存在「升级」；而「管什么」就写在槽上 ——
  // 这一页现在直接按槽列（见 slotViews），每一行就是
  // 「这个槽印着什么 + 嵌着哪件技能」

  const LEVELS_ROUTE : string = 'pages/examples/blackjack/draw-levels'
  const FISHING_ROUTE : string = 'pages/examples/blackjack/ap-fishing'

  // 开始下一关：清掉 inShop，回摸打页开局。
  // 从摸打结算进来的就退回去（那边 onShow 会开下一关）；
  // 从关卡页「开启挑战」直接进来的，换成摸打页
  function goNext() {
    if (guideLock()) {
      return
    }
    const data = loadDrawSave()
    data.inShop = false
    commit(data)
    const pages = getCurrentPages()
    if (pages.length > 1 && pages[pages.length - 2].route == FISHING_ROUTE) {
      uni.navigateBack({})
      return
    }
    uni.redirectTo({ url: '/' + FISHING_ROUTE })
  }

  // 退出：回关卡页，inShop 留着。栈里有关卡页就一路退回去
  //（中间那个摸打页一起出栈），没有就直接换过去
  function goExit() {
    if (guideLock()) {
      return
    }
    const pages = getCurrentPages()
    for (let i = pages.length - 2; i >= 0; i--) {
      if (pages[i].route == LEVELS_ROUTE) {
        uni.navigateBack({ delta: pages.length - 1 - i })
        return
      }
    }
    uni.redirectTo({ url: '/' + LEVELS_ROUTE })
  }

  // 这一关的第一批货：摇好**写进存档**。
  //
  // 存档而不是存在页面里，是因为货架要是每次进店重摇，退出去再进来
  // 就能刷到想要的那张 —— 而商店是过一关进一次，那等于白送无限次重摇，
  // 花钱刷新那条路也就白设了（排竿那边同样把货架存进了档）
  function ensureShelf() {
    if (save.value.shelf.length > 0) {
      // 这儿原先要给老货架上「还没定槽」的技能补定一个槽（fillShelfSlots）。
      // 定槽随花色槽一起没了，所以货架读出来就直接能用
      return
    }
    const data = loadDrawSave()
    rollShelf(data, false)
    commit(data)
  }

  onShow(() => {
    refresh()
    ensureShelf()
    startGuide()
    announcePrize()
  })

  // 包摊开着就被切走 / 退出去的话，替你拿第一个（见 autoTakePack）
  onHide(() => {
    autoTakePack()
  })

  onUnload(() => {
    autoTakePack()
  })

  refresh()
  ensureShelf()
</script>

<style>
  .page {
    flex: 1;
    padding: 16px;
    background-color: #0b5d3b;
  }

  .head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .title {
    color: #e8b23a;
    font-size: 22px;
    font-weight: bold;
  }

  /* 金币和名额竖着摆在右上角 */
  .head-right {
    flex-direction: row;
    align-items: center;
  }

  .lives {
    color: #ff7a7a;
    font-size: 16px;
    font-weight: bold;
    margin-left: 10px;
  }

  .lotto-line {
    color: #fff3c4;
    font-size: 12px;
    margin-bottom: 6px;
  }

  .gold {
    color: #fff3c4;
    font-size: 16px;
    font-weight: bold;
  }

  .own {
    color: #9fd9bd;
    font-size: 11px;
    margin-top: 2px;
  }

  /* 名额满了描成橙的 —— 货架上的技能这时候买不动，这事得醒目 */
  .own-full {
    color: #ff9e80;
    font-weight: bold;
  }

  .body {
    flex: 1;
    margin-top: 10px;
  }

  /* ---------- 牌组改造 ---------- */

  /* ---------- 下一关的庄家 ---------- */

  /* 描成暗红，跟下面两栏货（绿底）分开 —— 它不是货，是题目 */
  .foe-box {
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    background-color: #5c2328;
    border-left-width: 4px;
    border-left-style: solid;
    border-left-color: #e06c75;
  }

  .foe-title {
    color: #ffd7d9;
    font-size: 12px;
    font-weight: bold;
  }

  .foe-none {
    color: #f0b9bd;
    font-size: 10px;
    margin-top: 3px;
  }

  /* 角色名比技能行更亮更大 —— 它是这一关的名字，背的就是它 */
  .foe-role {
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    margin-top: 4px;
  }

  /* 特殊技全文。字小但不压暗：它是规则，不是补充说明 */
  .foe-special {
    color: #ffd7d9;
    font-size: 10px;
    line-height: 15px;
    margin-top: 2px;
  }

  /* 覆盖面在最前 —— 跟对局页的技能栏一个规矩：
     你问的是「我这张牌会不会撞上它的技能」，所以先给锚点 */
  .foe-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
  }

  .foe-cover {
    color: #ffffff;
    font-size: 11px;
    font-weight: bold;
    margin-right: 6px;
  }

  .foe-name {
    color: #ffd7d9;
    font-size: 11px;
    margin-right: 6px;
  }

  .foe-level {
    color: #f0b9bd;
    font-size: 10px;
  }

  .section {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    margin-top: 10px;
  }

  .section-note {
    color: #9fd9bd;
    font-size: 10px;
    line-height: 15px;
    margin-top: 2px;
  }

  /* 「买牌」那一行的标题和换一批按钮，左右分开 */
  .shelf-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .deck-none {
    color: #6f9c85;
    font-size: 11px;
  }

  .reroll {
    color: #e8b23a;
    font-size: 12px;
    font-weight: bold;
  }

  .fix-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .fix {
    width: 72px;
    height: 48px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  /* 买不起 / 已买：压暗 */
  .fix-off {
    opacity: 0.45;
  }

  /* ---------- 道具那一栏（一件一行） ---------- */

  .goods-list {
    flex-direction: row;
    margin-top: 6px;
  }

  /* 一行：左边名字 + 说明，右边价钱。
     **左边那条竖杠**（border-left）是稀有度的位置 —— 四格宽，
     在一列里扫下来对得齐，比整圈描边好认 */
  .goods {
    flex: 1;
    align-items: center;
    padding: 7px 4px;
    margin-right: 6px;
    margin-bottom: 5px;
    border-radius: 8px;
    background-color: #0e6b45;
    border-left-width: 4px;
    border-left-style: solid;
    border-left-color: #6f9c85;
  }

  /* 稀有度：**换竖杠的颜色**。
     不用底色，因为底色已经被「道具 / 卡牌 / 技能」那三类占了
     （绿 / 白 / 紫）—— 两套信息抢同一个通道就都读不出来了。
     普通灰绿、稀有蓝、史诗紫 */
  .goods-rare {
    border-left-color: #4ea8de;
  }

  .goods-epic {
    border-left-color: #c77dff;
  }

  /* 新手引导要你点的那一件：整圈金边 */
  .goods-guide {
    border-width: 2px;
    border-style: solid;
    border-color: #e8b23a;
    border-left-width: 4px;
    border-left-color: #e8b23a;
  }

  .guide-tip {
    margin-top: 6px;
    padding: 8px 10px;
    border-radius: 8px;
    background-color: #e8b23a;
  }

  .guide-tip-text {
    color: #2a1a00;
    font-size: 12px;
    font-weight: bold;
    line-height: 17px;
  }

  .goods-off {
    opacity: 0.45;
  }

  /* 名字和说明占满剩下的宽度，价钱靠右 */
  .goods-main {
    flex: 1;
  }

  .goods-head {
    flex-direction: row;
    align-items: center;
  }

  .goods-name {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
  }

  .fix-tier {
    color: #9fd9bd;
    font-size: 9px;
    margin-top: 1px;
  }

  .goods-rare .fix-tier {
    color: #9fd3f5;
  }

  .goods-epic .fix-tier {
    color: #e3c4ff;
  }

  .goods-desc {
    color: #cfe8d8;
    font-size: 10px;
    line-height: 14px;
    margin-top: 2px;
  }

  .goods-price {
    color: #fff3c4;
    font-size: 13px;
    font-weight: bold;
    margin-top: 2px;
  }

  /* 买牌那几格：白底，像张牌 */
  .fix-card {
    background-color: #ffffff;
    border-color: #ffffff;
  }

  .fix-name {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
  }

  .fix-card .fix-name {
    color: #1a1a1a;
  }

  .fix-price {
    color: #fff3c4;
    font-size: 11px;
    margin-top: 2px;
  }

  .fix-card .fix-price {
    color: #8a6b00;
  }

  /* 三样混在同一栏，所以得一眼分得出来：
     形状一样，只靠底色分：牌是白的（像张牌）、技能是紫的、点数卡是金的。
     点数卡不用蓝色 —— 道具栏的稀有度已经占了蓝 */
  .fix-skill {
    background-color: #5b3a8e;
    border-color: #8b63c9;
  }

  .fix-pip {
    background-color: #f2c14e;
    border-color: #f2c14e;
  }

  .fix-pip .fix-name {
    color: #5a3a00;
  }

  .fix-pip .fix-price {
    color: #6b4a00;
  }

  /* 贴过点数卡的牌：描一圈金边。
     挑牌的时候「哪张已经加强过」是最要紧的信息 ——
     再贴一张点数卡该挑没贴过的，而同化该挑贴过的来复制 */
  .pick-card-pip {
    border-color: #e8b23a;
  }

  /* 「♠3·7」比「♠3」长，字得小一号才塞得进那个格子 */
  .pick-text-pip {
    font-size: 10px;
  }

  /* ---------- 开包弹层 ---------- */

  .pack-cards {
    flex-direction: row;
    flex-wrap: wrap;
  }

  /* 比选牌弹层那些格子大一截 —— 这儿只摆 6 张，
     而且每一张都是要你挑的，不是一片牌海里的一格 */
  .pack-card {
    width: 62px;
    height: 48px;
    margin-right: 8px;
    margin-bottom: 8px;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    border-width: 2px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .pack-card-text {
    color: #1a1a1a;
    font-size: 18px;
    font-weight: bold;
  }

  /* ---------- 货品详情弹层 ---------- */

  /* 弹窗遮罩：铺满整页，弹窗摆正中 */
  .mask {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
  }

  .buy-box {
    width: 300px;
    padding: 16px;
    border-radius: 12px;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .buy-head {
    flex-direction: row;
    align-items: center;
  }

  .buy-name {
    color: #ffffff;
    font-size: 17px;
    font-weight: bold;
  }

  /* 价钱靠右顶到底 —— 它是这一框里第二要紧的数 */
  .buy-price {
    flex: 1;
    color: #fff3c4;
    font-size: 17px;
    font-weight: bold;
    text-align: right;
  }

  .buy-tag {
    color: #9fd9bd;
    font-size: 11px;
    margin-top: 3px;
  }

  .buy-desc {
    color: #ffffff;
    font-size: 13px;
    line-height: 19px;
    margin-top: 8px;
  }

  /* 买不了的原因。描红摆在钮上面 —— 点了才告诉人就太晚了 */
  .buy-block {
    color: #ff9e80;
    font-size: 12px;
    font-weight: bold;
    margin-top: 8px;
  }

  .buy-actions {
    flex-direction: row;
    margin-top: 14px;
  }

  .buy-btn {
    height: 36px;
    flex: 1;
    border-radius: 18px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: #e8b23a;
  }

  .buy-btn-off {
    opacity: 0.4;
  }

  .buy-btn-plain {
    margin-right: 0;
    background-color: #0b5637;
    border-width: 1px;
    border-style: solid;
    border-color: #6f9c85;
  }

  .buy-btn-text {
    color: #2a1a00;
    font-size: 14px;
    font-weight: bold;
  }

  .buy-btn-text-plain {
    color: #cfe8d8;
  }

  /* ---------- 选牌弹层 ---------- */

  .pick-box {
    width: 320px;
    padding: 14px;
    border-radius: 12px;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .pick-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .pick-title {
    color: #e8b23a;
    font-size: 16px;
    font-weight: bold;
  }

  .pick-sub {
    color: #9fd9bd;
    font-size: 11px;
  }

  .pick-tip {
    color: #9fd9bd;
    font-size: 11px;
    line-height: 16px;
    margin-top: 4px;
  }

  .pick-body {
    max-height: 320px;
    margin-top: 8px;
  }

  /* 弹窗里的技能卡（技能包、砺钩、洗点共用） */
  .my-skill {
    padding: 10px;
    margin-bottom: 8px;
    border-radius: 10px;
    background-color: #0b4f33;
    border-width: 1px;
    border-style: solid;
    border-color: #2f7a57;
  }

  /* 原先这儿是 .pack-sell* 那一组（开包时「腾位置卖技能」那块面板）
     和 .my-skill-off（选不了的候选压暗）。两样都跟着那块面板删了 ——
     槽满也挑得下来，不存在「选不了」 */

  .my-skill-on {
    border-width: 2px;
    border-color: #e8b23a;
    background-color: #155c3d;
  }

  /* 挑槽的时候「已经嵌着东西的槽」。
     亮橙边而不是压暗 —— 它**点得下去**（会换掉里头那件），
     压暗会读成「不能点」。橙色是这一页「要花掉 / 要丢掉」那条线的颜色
     （跟卖出按钮同色） */
  .my-skill-swap {
    border-width: 2px;
    border-color: #ff9e80;
  }

  .my-skill-head {
    flex-direction: row;
    align-items: center;
  }

  .my-skill-name {
    flex: 1;
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
    margin-right: 6px;
  }

  .my-skill-cover {
    color: #9fd9bd;
    font-size: 10px;
    padding: 1px 6px;
    margin-right: 6px;
    border-radius: 7px;
    border-width: 1px;
    border-style: solid;
    border-color: #4f8f70;
  }

  .my-skill-level {
    color: #9fd9bd;
    font-size: 10px;
    margin-top: 4px;
  }

  .my-skill-desc {
    color: #e6f4ec;
    font-size: 12px;
    line-height: 18px;
    margin-top: 6px;
  }

  /* 一行一个点数：左边标点数，右边摊开这个点数的所有牌 */
  .pick-line {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
  }

  .pick-rank {
    width: 24px;
    color: #9fd9bd;
    font-size: 12px;
    font-weight: bold;
  }

  .pick-cards {
    flex: 1;
    flex-direction: row;
    flex-wrap: wrap;
  }

  .pick-card {
    width: 40px;
    height: 28px;
    margin-right: 4px;
    margin-bottom: 4px;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    border-width: 2px;
    border-style: solid;
    border-color: #ffffff;
  }

  /* 同化选中的第一张：描金边 */
  .pick-card-on {
    border-color: #e8b23a;
  }

  .pick-card-text {
    color: #1a1a1a;
    font-size: 12px;
    font-weight: bold;
  }

  .pick-close {
    color: #e8b23a;
    font-size: 13px;
    font-weight: bold;
    text-align: center;
    margin-top: 10px;
  }

  .skill {
    padding: 10px;
    margin-bottom: 8px;
    border-radius: 10px;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #0e6b45;
  }

  /* 没拥有的技能不显示 */
  .empty {
    color: #9fd9bd;
    font-size: 12px;
    margin-bottom: 10px;
  }

  .sell-btn {
    height: 28px;
    padding: 0 10px;
    margin-left: 6px;
    border-radius: 14px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-style: solid;
    border-color: #ff9e80;
  }

  .sell-text {
    color: #ff9e80;
    font-size: 12px;
  }

  /* 一行三样：槽标签（印的）· 技能名（嵌的）· 覆盖面。
     不用 space-between 而是让名字吃掉中间的空 ——
     标签要紧贴在名字左边，那两样是一组 */
  .skill-head {
    flex-direction: row;
    align-items: center;
  }

  .skill-name {
    flex: 1;
    color: #e8b23a;
    font-size: 15px;
    font-weight: bold;
  }

  .skill-level {
    color: #9fd9bd;
    font-size: 11px;
  }

  /* 关键字标记（现在只有「优先」）。
     描成金色小药丸 —— 它不是说明文字，是一类规则标签 */
  .skill-key {
    color: #2a1a00;
    background-color: #e8b23a;
    font-size: 9px;
    font-weight: bold;
    padding: 1px 5px;
    border-radius: 7px;
    margin-left: 6px;
    margin-right: 6px;
  }

  .skill-desc {
    color: #ffffff;
    font-size: 12px;
    margin-top: 4px;
  }

  .slot-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
  }

  .slot-chip {
    flex-direction: row;
    align-items: center;
    padding: 5px 8px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 8px;
    background-color: #0e6b45;
  }

  .slot-row-name {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
    margin-left: 6px;
  }

  .equip-btn {
    border-color: #e8b23a;
  }

  .equip-text {
    color: #e8b23a;
    font-size: 12px;
  }

  .skill-foot {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
  }

  .skill-cover {
    flex: 1;
    color: #fff3c4;
    font-size: 11px;
  }

  /* 原先这儿有 .skill-max（技能卡右边报「可升级 / 已满级 / 槽满了」）。
     没有等级了，整行跟着删 */

  /* 「我的槽」那一栏的抬头：左边标题、右边角色名 + 特殊技。
     角色摆在这儿而不是页面顶上 —— 它是这一栏的主语 */
  .my-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 4px;
    margin-bottom: 6px;
  }

  /* .section 自带 margin-top，跟 .my-head 的叠在一起就空太多了 */
  .my-head .section {
    margin-top: 0;
  }

  .role-line {
    color: #e8b23a;
    font-size: 11px;
  }

  /* 槽上印的标签。白底深字的小方块 —— 它是**印在槽上的**，
     跟嵌进去的技能（金色名字）要一眼分得开 */
  .slot-label {
    color: #1d3b2f;
    background-color: #d8f0e2;
    font-size: 12px;
    font-weight: bold;
    padding: 1px 6px;
    border-radius: 4px;
    margin-right: 6px;
  }

  /* 空槽压暗一点，但列出来 —— 它是你下一次买技能的落点，是信息 */
  .skill-empty {
    opacity: 0.6;
  }

  .back-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
  }

  .back-btn {
    width: 120px;
    height: 34px;
    border-radius: 17px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .back-btn-plain {
    width: 80px;
    margin-right: 10px;
    border-color: #9fd9bd;
  }

  .back-text {
    color: #e8b23a;
    font-size: 14px;
  }

  .back-text-plain {
    color: #9fd9bd;
  }

  /* 红桃、方块描红。**摆在最后**：牌面文字的几个类（.pick-card-text、.pack-card-text）
     自带黑色，排在它后面的话会把红色盖掉 */
  .fix-red {
    color: #d33b3b;
  }

  /* 货架上的卡牌：.fix-card .fix-name 把牌名描黑，优先级比单个 .fix-red 高，
     所以这儿要用同样的写法再盖回红色 */
  .fix-card .fix-red {
    color: #d33b3b;
  }
</style>
