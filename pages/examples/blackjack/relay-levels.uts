// 排竿的十关，以及贴纸位怎么给。
//
// 这十关跟主玩法那二十一关没有关系：另一套难度曲线、另一本通关账、
// 另一个贴纸库。排竿赚的贴纸只在排竿用，主玩法买的也带不过来 ——
// 两种玩法各玩各的，进度不互相绑架。
//
// 难度眼下沿两条线走：庄家分到的牌上贴纸越来越多、庄家排队越来越会算。
//
// 原先还有第三条「一局的轮数越来越长」，改成一副牌对半分之后没了 ——
// 双方各 26 张，打完才算完，每一关的局长都一样。
// 这条线得另外补：庄家开场多落一张、你的队列缩到四张，都是候选。

// 只剩庄家那半副牌要贴贴纸了，所以从贴纸表里拿的东西也只剩这两样
import {
  indexOfKey,
  isFixedRank
} from '@/pages/examples/blackjack/stickers.uts'
import {
  Card
} from '@/pages/examples/blackjack/cards.uts'

// 玩家这边的贴纸整套取消了，换成了 relay-items.uts 那套道具，
// 所以原先那个「拿张 7 当试纸筛出排竿认得的贴纸」的 relayStickerPool 没用了。
//
// 庄家那半副牌也是素牌了 —— 它的难度全在 dealerRules 那排规矩上。
// 贴纸这套在排竿两边都取消了，只剩主玩法还在用。

// 庄家排队的脑子：
//   0 不排 —— 照牌库顺序打，你占大便宜；
//   1 配对 —— 把点数对得上的两张排到相邻位，后一张钩中前一张；
//   2 配对加压大数 —— 配完对，剩下的大数往后放，晚落堆少挨钩
export const DEAL_PLAIN : number = 0
export const DEAL_PAIR : number = 1
export const DEAL_TUNED : number = 2

export type RelayLevel = {
  index : number
  name : string
  // 一局打几轮 —— 已经不决定局长了。一副牌对半分，双方各 26 张，
  // 牌打完才算完（五轮整，加最后一张单挑）。
  // 字段先留着，等难度曲线补新维度的时候改作他用
  rounds : number
  // 这一关庄家挂几条规矩。**具体哪几条是摇出来的**，不写死 ——
  // 每一轮挑战面对的是不同组合，照抄上一轮的配装就不管用了。
  //
  // 但**在一轮之内，规矩摇到就固定**：这儿的数字只决定「累到几条」，
  // 新增的才是新摇的，之前那几条连参数一起原样留着（见 rollDealerRules）。
  // 所以这一列读起来是「第 k 关比第 k-1 关多压几条」。
  //
  // 能摇到哪些由每条规矩自己的 since 门槛决定（见 relay-items）。
  // 从前这儿是「牌组上贴几张贴纸、贴哪几种」，难度藏在一个玩家查不到的
  // 矩阵里；现在换成一排写着字的规矩，进关就看得见被改成了什么样。
  //
  // **条数不等于难度。** 这儿数的是条数，可规矩之间差着量级：定桩、封位
  // 是局部限制（钉住一张牌、废掉一个位置），长手、百搭、同源是乘法 ——
  // 庄家每张牌凭空多几个候选点数，整体钩中率抬一大截。所以重的那几条
  // 各自把 since 压得很后，靠门槛而不是靠条数来兜 ——
  // 往这张表里加新规矩时，先掂量它是哪一类，再定 since
  dealerRules : number
  // 庄家排队的脑子，见上面三个常量
  dealerSmart : number
}

export const RELAY_COUNT : number = 10

// ---------- 金币 ----------
//
// 过关给两笔：一笔固定的过关费，一笔按分差算的赏钱。
//
// 固定那笔随关号涨，保证越往后每关的底子越厚；按分差那笔管的是
// 「赢得有多狠」—— 收 20 张赢它 2 张，和收 12 张赢它 10 张，
// 含金量差远了。赏钱挂在分差上，才逼着人去想怎么赢得更狠，
// 而不是打满轮数了事；「忍住不收攒大的」也是靠它接上的。
//
// ---- 底金为什么是大头，而不是赏钱 ----
//
// 原先底金是 8+2k、赏钱是 gap×3，大头在赏钱那边。那样排有个死结：
// **难度和收入由同一个量决定**。庄家那排规矩里，深钩（它多收 1 张）、
// 逆钩（你少收 1 张）、浑底、压冠、锁花，全是直接砍分差的 ——
// 于是每上一关，规矩把你的分差压薄一层，收入自动跟着掉，
// 下一关更买不起道具，分差再薄一层。越难越穷，越穷越难。
//
// 底金抬到 12+4k，就是拿它当这个螺旋的地板：后期哪怕被压到
// 只赢三张，第 10 关也还有 52+12=64 金币，配得起下一件道具。
// 赏钱抬到 ×4 是为了别把「赢得狠」这条动机压扁 ——
// 地板抬高之后，赏钱那一笔要是不跟着涨，分差就不值钱了
export function baseCoins(index : number) : number {
  return 12 + index * 4
}

export const COIN_PER_GAP : number = 4

export function gapCoins(gap : number) : number {
  return gap > 0 ? gap * COIN_PER_GAP : 0
}

// ---------- 贴纸位 ----------

export const MAX_SLOTS : number = 6

// 打到第几关就有几个贴纸位，不花钱买，随难度直接给。
//
// 早先是拿金币买的，但那让每一关的商店都在问同一个问题
// （扩位还是买战力），而扩位是复利 —— 答案长期都偏向扩位，
// 问了也白问。改成白给之后，金币就只跟「买什么贴纸」较劲，
// 商店里的决策反而更集中。
//
// 位子数也就跟着关卡的轮数走了：前期关短位子少，后期关长位子多，
// 一轮差不多摊得到一张
// 格子数：3 → 4 → 5 → 6，在第 3、6、9 关各涨一格。
//
// 起手三格，正好被开局白送的三件（明竿、幸运、集花）填满 ——
// 于是**第一次进商店买到的东西就没处放**，必须先决定卸掉哪一件。
// 「明竿那份情报 还是 新买的战力」这个问题从第一关就开始问，
// 比等到中段才问有意思得多。
//
// 三关涨一格，是让每一次扩容都隔得够远、能当个小奖励，
// 又不至于到后期还在为一个格子较劲。
// 道具表有二十几件而天花板只有六格，所以越往后「带哪几件」
// 越是这套玩法的主要决策 —— 格子给得太快，这个决策就消失了
export function slotsAt(level : number) : number {
  if (level <= 2) {
    return 3
  }
  if (level <= 5) {
    return 4
  }
  if (level <= 8) {
    return 5
  }
  return MAX_SLOTS
}

// 道具的价钱在 relay-items.uts：底价每件自带（买的是数值），
// 进阶费按落点那一级算（买的是广度），两层分开

// ---------- 上货的稀有度权重 ----------
//
// 跟着关号走。头两关根本不出史诗和传说 —— 那会儿金币也买不起，
// 摆出来只是占着格子；到了后半程反过来，普通的比重压到一成，
// 不然打到第九关货架上还都是轻坠，等于没货可买。
//
// 分段写死而不是拿公式插值：这四条线各是什么形状要一眼看得见，
// 调某一段的手感时也不会牵动别的段
// 货架只出普通和稀有两档 —— 史诗和传说买不到，只能靠进阶升上去。
//
// 这样金币就有了两条形状完全不同的去处：买新的是「广度」，带运气，
// 刷出什么才买得到什么；升级是「深度」，贵，但结果是确定的。
// 高级道具必须做成买不到的，进阶那条线才立得住 ——
// 要是能从货架上直接刷出传说，攒钱一级级升就成了冤大头。
//
// 权重仍然随关号走：前期普通占大头（那会儿也买不起别的），
// 后期倒过来，不然打到第九关货架上还都是十五块的入门货
export function shelfWeights(level : number) : number[] {
  if (level <= 2) {
    return [85, 15]
  }
  if (level <= 4) {
    return [70, 30]
  }
  if (level <= 6) {
    return [55, 45]
  }
  if (level <= 8) {
    return [40, 60]
  }
  return [25, 75]
}

// 按权重摇一个稀有度出来。
//
// has 是各档还有没有货的标记 —— 某一档全攒到上限了就别摇中它，
// 摇中了也开不出东西。roll 传 0..1 的随机数，摇号本身不碰 Math.random，
// 好让调用处自己决定随机源
export function rollRarity(weights : number[], has : boolean[], roll : number) : number {
  let total = 0
  for (let i = 0; i < weights.length; i++) {
    if (i < has.length && has[i]) {
      total = total + weights[i]
    }
  }
  if (total <= 0) {
    return -1
  }
  let hit = roll * total
  for (let i = 0; i < weights.length; i++) {
    if (i >= has.length || !has[i]) {
      continue
    }
    hit = hit - weights[i]
    if (hit <= 0) {
      return i
    }
  }
  return -1
}

// ---------- 盲盒 ----------
//
// 不挑，但打折。货架是「看着买」，盲盒是「赌一把」——
// 货架那五件都不对路的时候，它是另一条路。
//
// 卖的不是「便宜」：便宜到某个份上它就不是另一条路，而是唯一一条路了
//（那正是它原先的毛病，见下面那笔重算的账）。卖的是折扣本身 ——
// 你放弃挑选权，换三成的价。
//
// 稀有度跟货架共用上面那张随关号走的权重表，所以价钱也得跟着走：
// 第一关的盒子里根本没有传说，第十关有两成，两者卖一个价就荒唐了。
//
// 盒子里也只有普通和稀有 —— 货架买不到的，盲盒同样开不出来。
//
// ---- 定价：照货架期望的一半 ----
//
// **基数得照着道具表现在的样子算。** 原先这张价表（13/15/17/19/21）
// 是按「两档价 15/35」推的，那是道具还只有两种价钱那会儿的事；
// 现在普通档底价从 15 铺到 115、均价 56，稀有档均价 121
//（三件没有普通形态的按自己的底价算）。基数翻了三倍，价表却没动，
// 于是盒子成了店里唯一的正解：十几块开一件均价五六十的新道具，
// 货架除了半价位基本没有存在的理由。
//
// 重算，货架期望和这儿的定价：
//
//   关 1-2  普通 85% 稀有 15% → 期望 66 → 卖 35
//   关 3-4  70/30 → 期望 76 → 卖 40
//   关 5-6  55/45 → 期望 85 → 卖 45
//   关 7-8  40/60 → 期望 95 → 卖 50
//   关 9-10 25/75 → 期望 105 → 卖 55
//
// 打的是对半折，不是七折 —— 折扣里有两层，不能只算一层：
//
//   · 挑不着。货架那五件你看着挑，盒子给什么算什么。
//   · **装不上。** 这一层容易漏：道具栏只有 3 到 6 格，而表里四十件。
//     货架上你挑的是马上要装的那件，标价买的就是实打实的战力；
//     盒子开出来的能不能挤进格子全看运气 —— 后期格子满了，
//     开出的多半是躺在库里的一个名字。所以盒子里那件道具的**效用**
//     本来就低于它的标价，照标价的七成收钱还是收贵了。
//
// 只剩两档之后，盲盒不再是「赌一把开传说」了 —— 没这个可能。
// 它的活儿是「铺种类」：同名道具只会有一件，所以盒子从你还没有的
// 里头摇，开出来必定是新东西
export function blindPrice(level : number) : number {
  if (level <= 2) {
    return 35
  }
  if (level <= 4) {
    return 40
  }
  if (level <= 6) {
    return 45
  }
  if (level <= 8) {
    return 50
  }
  return 55
}

// 商店一次上几件货，以及刷新一次多少钱。
//
// 不把解锁的贴纸全摆出来，是这套玩法能重复玩的关键：
// 要是每次都买得到想要的，几轮之后所有挑战都会收敛成同一套最优解。
// 随机上货逼着人在「凑合买眼前这张」和「攒钱赌下一关」之间选
export const SHOP_SIZE : number = 5

// 换一批多少钱。跟着关号走，理由有两条：
//
//   · 后期一关到手六十往上（见 baseCoins），固定十块的刷新等于不要钱 ——
//     「随机上货逼你在凑合买和攒钱赌之间选」这条设计会被刷新直接架空，
//     刷到中意的为止就行了；
//   · 它还是盲盒的**边际成本**。换一批会把盲盒的「这批卖过了」牌子
//     一并撤掉（见 restock），所以「刷新 + 再开一盒」是能反复跑的循环。
//     盒子本身按对半折卖（见 blindPrice），刷新费往上补一截 ——
//     于是头一盒实惠，一盒盒刷下去单价越来越不划算，循环自己会停。
//     不设「一关只准开一个」那种硬闸，是因为格子只有几个：
//     刷到第五盒的时候，开出来的东西本来就装不上了，价钱只要跟上
//     就够劝退，不必再拿规则去堵
export function rerollPrice(level : number) : number {
  return 10 + level * 2
}

// 难度两条线：庄家挂几条规矩、它排队有多会算。
//
// 条数一关关往上加，**摇到的那几条就固定下来**，往后每关只在上头再添。
// 所以难度是「又多压了一条」这种看得见的累积，而不是每关重出一套题：
// 你为了破第 4 关那条压冠买的几件，到第 10 关照样管用 ——
// 那笔「照着规矩配装」的钱才花得下去。
//
// 不重复十遍靠的是**轮**：输了从第一关重来时全套重摇，池子 12 条摇 7 条，
// 下一轮跟这一轮面目全新。一轮之内稳定可规划，轮与轮之间换一套题。
//
// 头一关不给规矩：先让人把「排序」这件事本身摸明白
const LEVELS : RelayLevel[] = [
  {
    index: 1,
    name: '试竿',
    rounds: 3,
    // 干干净净。先把顺序这件事摸明白
    dealerRules: 0,
    dealerSmart: DEAL_PLAIN,
  },
  {
    index: 2,
    name: '顺水',
    rounds: 3,
    // 第一条。第 2 关摇得到的只有「深钩」那一档最温和的 ——
    // 开场那条必须一眼看得见，隐蔽的规矩当开场，
    // 玩家根本意识不到「规矩会变」这件事
    dealerRules: 1,
    dealerSmart: DEAL_PLAIN,
  },
  {
    index: 3,
    name: '逆流',
    rounds: 4,
    // 从这一关起庄家会排队了 —— 它开始主动凑对，自己钩自己刚打的那张
    dealerRules: 1,
    dealerSmart: DEAL_PAIR,
  },
  {
    index: 4,
    name: '暗涌',
    rounds: 4,
    // 两条。这一关起「哪两条」就有得摇了
    dealerRules: 2,
    dealerSmart: DEAL_PAIR,
  },
  {
    index: 5,
    name: '深槽',
    rounds: 4,
    dealerRules: 2,
    dealerSmart: DEAL_PAIR,
  },
  {
    index: 6,
    name: '乱石',
    rounds: 5,
    dealerRules: 3,
    dealerSmart: DEAL_TUNED,
  },
  {
    index: 7,
    name: '回漩',
    rounds: 5,
    // 从这一关起「百搭」进池子 —— 它某个点数成了万能钩子
    dealerRules: 4,
    dealerSmart: DEAL_TUNED,
  },
  {
    index: 8,
    name: '断流',
    rounds: 5,
    // 压冠、锁花进池子。到这一关「带什么道具」就得认真想了，
    // 而且不能照抄上一把 —— 摇出来的组合每次都不一样
    dealerRules: 5,
    dealerSmart: DEAL_TUNED,
  },
  {
    index: 9,
    name: '死水',
    rounds: 6,
    dealerRules: 6,
    dealerSmart: DEAL_TUNED,
  },
  {
    index: 10,
    name: '长夜',
    rounds: 6,
    // 七条。池子里一共十二条，所以最后一关也不是全压上来 ——
    // 留着那几条没摇到的，下一轮挑战才有新东西
    dealerRules: 7,
    dealerSmart: DEAL_TUNED,
  }
]

export function allRelayLevels() : RelayLevel[] {
  return LEVELS
}

export function relayLevelAt(index : number) : RelayLevel {
  for (let i = 0; i < LEVELS.length; i++) {
    if (LEVELS[i].index == index) {
      return LEVELS[i]
    }
  }
  return LEVELS[0]
}

// 头一关随时能打，往后每关要求上一关先通。
// 十关是一条直路，不像主玩法那边是六条并排的钓场
// 道具整套搬去了 relay-items.uts —— 那边是「永续 / 限制」两类加四级进阶，
// 把原先的买断道具、一次性消耗品、贴纸三样一起收编了。
// 这儿只留关卡和经济曲线。
//
// 「竿架」（贴纸位 +1）那一件顺带取消了：它自己也要占一个格子，
// 占一个给一个等于白占

// 金币这条线**整条都在这个文件里**，道具那边一个字也碰不着。
//
// 原先有两件够得着它：熟客（店里打折）和秤钩（过关金币 +20%~70%），
// 两件都整件取消了 —— 都是自加速环，多赚的钱又拿去把它自己升得更高，
// 于是前两关的配装所有人都一样。理由写在 relay-items 末尾。
//
// 于是 baseCoins / gapCoins 算出来的就是最终到手的数：
// 「这一关能赚多少」是条所有人一样的线，调难度时才知道自己在调什么
//
// 道具格数直接用 slotsAt(level)：竿架取消之后没有别的东西能加格子了

// 庄家的牌现在是干净的素牌 —— 原先那个 stickDealerHalf（按间隔往它
// 那半副上贴贴纸）整个取消了。
//
// 难度改由 dealerRules 那排规矩承担：一来它看得见（玩家进关就知道
// 这一关的规矩被改成什么样），二来它不挑牌 —— 贴纸得摊匀，
// 摊不匀它就前两轮火力全开、后面全是素牌，那种忽强忽弱是调不出手感的
