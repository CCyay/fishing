    head: '它这一轮没有点数，打出时把堆上所有牌都染成它的花色',
    tail: ''
  },
  // ----- 断口两件：按轴分，不按类分 -----
  //
  // 奇/偶/红/黑 是四个**平行的 sidegrade**，不是坠子家族那种
  // 从 +1 到 +6 的阶梯。拆成四件的话四件强度一样，
  // 商店就只是在摇你要的那一个 —— 把临场判断变成了老虎机。
  // 一件管四类又太万能。所以按轴拆两件，各自二选一。
  //
  // 两件的共同点：被断掉的牌**点数废了，花色还在**。
  // 这是整个花色流的赢法 —— 点数死了花色没死，收色和集花照样够得着，
  // 而对手只按点数钩，那一堆对它就是废的。
  //
  // 但**废法不同**，而且差别在比大小的时候是反的：
  //
  //   断数 —— 变成 **0 点**。有点数，只是最小，什么都比它大。
  //           所以它是吞口的**粮**：哑掉一整片 0 点，吞口一口全吞了。
  //   断色 —— **失去点数**。压根没有这个属性，没法比，
  //           于是什么都不比它大。所以它是吞口的**墙**：
  //           废掉的那一片谁也吞不动，等于在堆上砌了道坎。
  //
  // 这正是当初「按轴拆两件」想要的差别 —— 不然两件只是换了个筛选条件、
  // 效果一模一样，拆两件就只是让商店多摇一次。
  //
  // 「没点数一律按最大算」这条规则写在 relay.uvue 的 sizeOf，
  // 对所有没点数的来源一个待遇：断色、空位贴纸、压冠、锁花、封位。
  // 断数不在其列 —— 它给的是 0，是个实打实的点数
  //
  // 双刃是有意的：你自己的同类牌也一起哑火，所以得先摸清对面的成色。
  // 探口那条线正好接这儿 —— 它说「庄家有三张奇数」，你就知道该断哪边
  {
    key: 'mutenum',
    name: '断数',
    kind: KIND_LIMITED,
    steps: [0, 0, 0, 0] as number[],
    counts: [] as number[],
    // 原先是 [1,1,2,2]。steps 全 0、counts 空，次数就是这件唯一会变的东西 ——
    // 于是普通和稀有的说明一个字都不差，史诗和传说也一样。
    // 货架能摆「断数·稀有」卖 110，而普通档 40，多花的 70 买到的是同一件东西。
    // 那不是强度问题，是明摆着的坑
    uses: [1, 2, 2, 3] as number[],
    basePrice: 40,
    stride: 1,
    head: '挑奇数或偶数，这一轮双方打出的这类牌都变成 0 点（什么都比它大 —— 吞口一口吞一片）',
    tail: ''
  },
  {
    key: 'mutecolor',
    name: '断色',
    kind: KIND_LIMITED,
    // 归花色流：掐死红色的点数，你的黑色收色照收 ——
    // 这一件跟收色是同一套打法的两头。
    //
    // 跟断数**不是**同一个效果：断数把牌变成 0 点（吞口的粮），
    // 断色让牌失去点数（吞口的墙）。分野见上面那段注释
    steps: [0, 0, 0, 0] as number[],
    counts: [] as number[],
    // 跟断数同样的空档问题，同样改法
    uses: [1, 2, 2, 3] as number[],
    basePrice: 40,
    stride: 1,
    head: '挑红色或黑色，这一轮双方打出的这类牌都失去点数（不是 0 点 —— 比大小时最大）',
    tail: ''
  },
  {
    key: 'hint',
    name: '探口',
    kind: KIND_LIMITED,
    // 不给你看牌，只给几条关于它这一轮手牌的实话 ——
    // 「有两张大于 7」「手里有对子」这种。
    //
    // 比窥筒弱也比窥筒便宜，但弱得有意思：线索是**结构**，
    // 看牌是**清单**。知道「它有对子」你就得防它把那对拆开夹你，
    // 具体是哪一对还得自己盯着堆上推。
    //
    // 进阶换来的不只是条数，更是**成色**（线索池见 relay.uvue 的 buildHints）：
    // 普通给笼统的计数，稀有开始报结构（有没有对子、最大是几点），
    // 史诗能告诉你「有几张跟你现在排的配得上对」—— 这句直接回答
    // 「我这几手会不会被截」，传说则接近点名具体点数。
    //
    // 这样分档是因为四条「有几张红牌」堆一起还是四条废话：
    // 一件情报道具升级后要是只是话变多，那它就没升级
    steps: [1, 2, 3, 4] as number[],
    counts: [] as number[],
    uses: [1, 1, 2, 2] as number[],
    basePrice: 30,
    stride: 1,
    head: '给 ',
    tail: ' 条庄家手牌的线索，越进阶线索越准'
  },
  {
    key: 'bare',
    name: '空钩',
    kind: KIND_LIMITED,
    // 它做的事是**把这张牌的点数变成 0**（fireItem 里 forced = 0），
    // 不是「没有点数」—— 这两样在这套规则里是分开的，差别在比大小：
    //   0 点是有点数，只是最小，什么都比它大；
    //   没点数是压根没这个属性，什么都不比它大（见 relay.uvue 的 sizeOf）。
    //
    // 0 点当不了钩点（shareValue 直接跳过 0 和负数），所以它
    // 钩不上人、按点数也没人钩得上 —— 但**吞口那条「大于」的线吃得动它**，
    // 而且 0 点是最好吃的那种。这一条得写在说明里：
    // 原先只写「不算钩点」，玩家会以为它是块铁板，结果被一口吞了。
    //
    // 保命用：挡庄家那一手大的，或者把自己钩不上的废牌变成安全垫牌。
    // 「它也钩不上人」这个代价是有意留的 —— 白送的保护没什么可想的。
    //
    // steps 摆 0，descOf 会跳过数值那段，所以话全在 head 里。
    //
    // 原先 counts 钉死 1 张、只涨次数，顶档就成了死档：
    // 500 买「一局四次让一张牌变废」，还附带它自己也钩不上人的代价。
    // 后两档改成能垫两张 —— 挡它一手大的同时把自己那张废牌也垫掉，
    // 这才是这件道具真正想做的事
    steps: [0, 0, 0, 0] as number[],
    counts: [1, 1, 2, 2] as number[],
    uses: [1, 2, 3, 4] as number[],
    basePrice: 30,
    stride: 1,
    head: '这一轮点数变成 0 —— 钩不上人，按点数也没人钩得上它（吞口那条线除外）',
    tail: ''
  },
  {
    key: 'clear',
    name: '清水',
    kind: KIND_LIMITED,
    // 不挑目标：盖着的一次全翻开。counts 摆空的
    steps: [0, 0, 0, 0] as number[],
    counts: [] as number[],
    uses: [1, 2, 3, 4] as number[],
    basePrice: 20,
    stride: 1,
    head: '翻开队列里所有盖着的牌',
    tail: ''
  },
  {
    key: 'peek',
    name: '窥筒',
    kind: KIND_LIMITED,
    // 手牌区平时只明示庄家下一张，这件让你多看几张 ——
    // 信息量本身成了可以花钱买的强度。
    //
    // ---- 你挑几张，它整轮翻着 ----
    //
    // 用的时候点**庄家那排**（背面也点得中），挑好按使用，
    // 挑中的那几张当场翻开，而且**这一轮一直翻着** —— 不是弹一次窗看完就没。
    //
    // ---- 它给牌面，不给顺序 ----
    //
    // 关键在于**庄家要等你按下「开始出牌」才排它的出牌顺序**
    //（见 relay.uvue 的 settleDealer）。排竿阶段它那排是照牌库顺序摆的，
    // 位置不作数。所以你照亮一张，知道的是「它手里有这张」，
    // 不是「它第三手打这张」—— 照完它还会重排。
    //
    // 这一条是有意架起来的：顺序是明竿独家卖的东西。
    // 要是开局就排好，按位置照亮就等于按顺序照亮，窥筒会把明竿吃掉。
    //
    // ---- 跟明竿的分工 ----
    //
    // 明竿：**前排、自动、每轮白给、带顺序**。它看过的那几张连排序都冻住，
    //       庄家不许再动 —— 不然它承诺的顺序就成了假话。
    // 窥筒：**任意张、手动、有限次、只给牌面**。
    // 一个告诉你「接下来这几手是什么」，一个告诉你「它手里还藏着什么」。
    //
    // 原先顶档是「一局一次、看 4 张」，那是个死档：传说要 495，
    // 而明竿花 400 就是一局十二次揭示，价差的方向整个反了。
    // 现在两条轴一起放开：普通就照 2 张，顶档照满 5 张、一局三次。
    // 一关六轮，等于有一半的轮次你是摊着牌打的
    steps: [2, 3, 4, 5] as number[],
    counts: [2, 3, 4, 5] as number[],
    uses: [1, 2, 2, 3] as number[],
    basePrice: 35,
    stride: 1,
    head: '点庄家手里的 ',
    tail: ' 张（背面也点得中），照亮它们，这一轮一直翻着 —— 只给牌面，不给出牌顺序'
  },
  {
    key: 'still',
    name: '停口',
    kind: KIND_LIMITED,
    // 点庄家这一轮**还没打的**那几张（背面也点得中，挑的是位置），
    // 让它们**变 0 点**或者**失去点数** —— 用的时候弹窗当场选。
    //
    // 名字是钓鱼话：鱼不咬钩叫停口。
    //
    // ---- 为什么这两种要你自己选 ----
    //
    // 这两样在这套规则里是**反的**（分野见 relay.uvue 的 sizeOf）：
    //   变 0 点 —— 什么都比它大。它钩不上人，落堆之后是你
    //             吞口、巨口最好的**口粮**，一口能吞一整片。
    //   失去点数 —— 什么都不比它大。它钩不上人，也没人钩得动它，
    //             落堆就是一道**墙**，把底下那一段整个封住。
    //
    // 走大数那一路的要粮，想断人后路的要墙。同一件道具两种用法，
    // 而且哪种对得看当下的堆长什么样 —— 这个判断不该替玩家做。
    //
    // ---- 它跟断口那两件不一样 ----
    //
    // 断数、断色按**类别**下手（奇偶 / 红黑），双方一起吃，是把水搅浑；
    // 停口按**位置**下手，只掐庄家，而且掐的是你指定的那几手。
    // 前者是立规矩，后者是点名。
    //
    // 挑的时候那几张多半还盖着，所以这是一次带赌性的点名 ——
    // 配明竿或者窥筒先照亮再下手，才算把这件用明白了
    steps: [0, 0, 0, 0] as number[],
    counts: [1, 2, 2, 3] as number[],
    uses: [1, 1, 2, 2] as number[],
    basePrice: 55,
    stride: 1,
    head: '点庄家这一轮还没打的牌（背面也点得中），让它们变 0 点或失去点数（用时选）',
    tail: ''
  },
  {
    key: 'steal',
    name: '摸底',
    kind: KIND_LIMITED,
    // 从庄家牌组**底下**抽走 N 张，插进你自己牌组顶上 —— 下一轮就摸得到。
    //
    // 一次动两头：它少一张，你多一张，牌数差一下子拉开二。
    // 配上「一方出完、另一方接着打完」那条规则，终局它先没牌，
    // 剩下那几轮堆上全是你自己的牌，能连着钩 —— 这才是它真正贵的地方，
    // 不是「白赚一张牌」那么简单。
    //
    // 抽底不抽顶是有讲究的：底下那张本来这一局多半轮不到它打
    //（双方各 26 张，一局正好打完，但压牌会把牌往底下推）。
    // 从底下拿，等于把它这一局最后才会用的牌提前变成你最先用的。
    //
    // 顺带你会看见抽到的是什么 —— 对面少了这张，你的推断也跟着准一分。
    //
    // 抽来的牌**贴纸撕掉**：庄家那半副是按关卡配置贴过的，
    // 连贴纸一起偷等于白捡一份战力，而你这边的牌一律是素牌。
    // 破了那条规矩，「你的牌是干净的」这个前提就不成立了
    steps: [1, 2, 3, 4] as number[],
    counts: [] as number[],
    uses: [1, 1, 2, 2] as number[],
    basePrice: 55,
    stride: 1,
    head: '从庄家牌组底抽 ',
    tail: ' 张插进你牌组顶'
  },
  // 原先这儿还有「换饵」和「压舱」两件，都取消了。
  //
  //   换饵（把队列里几张换成牌库顶那几张）—— 它做的是「重摇一次」，
  //     而不是「算一算」。排竿的决策是拿现有这几张去凑堆上的钩点，
  //     换一批新的等于把这道题作废重出，看着像解法其实是跳过。
  //
  //   压舱（队列圈几张压回牌库底，这一轮少出几张）—— 它破的是
  //     本文件开头那条「经济中性」铁律：在 26/26 对半分加上
  //     「一方出完、另一方接着打完」的规则下，出牌慢的一方终局
  //     白捡几轮无人干扰的连钩。当初把它留下是当「有意破例」的，
  //     但一件道具的收益要靠数终局能白赚几轮来估，那笔账玩家算不动，
  //     强度也没法调 —— 调 uses 改的不是强弱，是白赚几轮
]

// ---------- 庄家的道具 ----------
//
// 跟玩家那套**基本不通用**，而且清一色是「全局规矩」——
// 挂上去就一直生效，不需要庄家临场判断该不该用。
//
// 这么设计有两个理由：
//   · 庄家的脑子只有 sortDealer 那点排序逻辑。给它会挑时机的主动道具，
//     要么写一套复杂的 AI，要么它用得傻，两头都不讨好；
//   · 难度变得**看得见**。从前难度藏在「牌组上贴了 27 张贴纸」这种
//     玩家根本查不到的矩阵里，现在摆成一排写着字的道具，
//     你一进关就知道这一关的规矩被改成了什么样，可以照着排。
//
// 所以庄家牌组本身是干净的素牌 —— 贴纸那套在它这边也取消了
export type DealerRule = {
  key : string
  name : string
  desc : string
  // 最早可能在第几关摇到。
  //
  // 具体哪几条是开局随机摇的，关卡只定「摇几条」—— 所以得有这个门槛，
  // 不然第二关就可能摇到最狠的那条，而那会儿你什么道具都还没有
  since : number
}

// 全部**经济中性** —— 一条都不许改任何一方每轮出几张。
//
// 这条铁律是吃过亏才立的：在 26/26 对半分加上「一方出完、另一方
// 接着打完」的规则下，谁出得慢谁的牌就撑得久，终局就多出几轮
// 无人干扰的连钩。所以「庄家每轮多打一张」「你每轮少摆一张」
// 这种看着像削你的规矩，实际是在送你终局 —— 方向是反的。
//
// 有四条带随机参数（下面标了 roll 的），每次开这一关重摇：
// 同一关重打不是同一道题，逼人临场适应而不是背答案
export const DEALER_RULES : DealerRule[] = [
  {
    key: 'deep',
    name: '深钩',
    desc: '庄家钩中时，额外多收堆底 1 张',
    since: 2
  },
  {
    key: 'counter',
    name: '逆钩',
    desc: '你钩中时少收 1 张 —— 堆底那张留下',
    since: 3
  },
  {
    key: 'pin',
    name: '定桩',
    desc: '你队列最后一张钉死，拖不动',
    since: 4
  },
  {
    key: 'mute1',
    name: '封位',
    desc: '你每轮打出的第一张不算钩点',
    since: 4
  },
  {
    key: 'reach',
    name: '长手',
    // roll：±1 还是 ±2，每次开这一关重摇。
    //
    // 这一条接的是原先玩家那件「活钩」。同一个效果换个方向之后
    // 性质就变了：挂在你身上是「我不用算了」，挂在庄家身上是
    // 「我得算得更细」—— 它每张牌多两三个候选点数，你排竿时
    // 就得防的不只是等点数那一手。
    //
    // 摇 1 还是 2 而不是钉死，跟百搭、压冠同一个道理：
    // 同一关重打不是同一道题。±2 那一版明显更凶，但你退出重进就换一副面孔，
    // 逼人临场适应而不是背答案
    desc: '庄家的牌还可以按 ±1 的点数算',
    since: 5
  },
  {
    key: 'blunt',
    name: '钝钩',
    desc: '你的牌只按最小的那个候选点数算 —— 幸运那些多出来的路全掐掉',
    since: 6
  },
  {
    key: 'murk',
    name: '浑底',
    desc: '堆最底下那张对你不算钩点 —— 一钩端走整堆这种事没有了',
    since: 6
  },
  {
    key: 'wild',
    name: '百搭',
    // roll：哪个点数是万能的，每次开局重摇
    desc: '庄家有一个点数可以当任意点数用',
    since: 7
  },
  {
    key: 'akin',
    name: '同源',
    desc: '庄家打出的牌跟堆顶同花色时，点数直接算成跟堆顶一样',
    since: 7
  },
  {
    key: 'crown',
    name: '压冠',
    // roll：压哪两个点数，每次开局重摇
    desc: '你有两个点数一律失去点数 —— 钩不上人，也没人钩得上，吞口也吞不动',
    since: 8
  },
  {
    key: 'lock',
    name: '锁花',
    // roll：锁哪个花色，每次开局重摇
    desc: '你有一个花色一律失去点数 —— 钩不上人，也没人钩得上',
    since: 8
  },
  {
    key: 'chill',
    name: '寒流',
    desc: '你带的限制类道具，这一关每件少用 1 次（最少还剩 1 次）',
    since: 9
  }
]

// 第 level 关摇得到哪几条
export function rulesFor(level : number) : DealerRule[] {
  const out : DealerRule[] = []
  for (let i = 0; i < DEALER_RULES.length; i++) {
    if (DEALER_RULES[i].since <= level) {
      out.push(DEALER_RULES[i])
    }
  }
  return out
}

// ---------- 摇这一关的规矩 ----------
//
// 存成「key」或者「key=参数」的字符串，因为带参数的那四条
// （长手 ±1 还是 ±2、百搭哪个点数、压冠哪两个点数、锁花哪个花色）
// 必须跟规矩一起存进档：
//
// 商店要提前把下一关的规矩摊给你看 —— 「买道具之前先知道要面对什么」
// 是这套经济能算得动的前提。那就得在进商店之前摇好、存下来，
// 不能等进了牌桌再摇，否则商店写的和牌桌跑的是两回事。
//
// 编码成一个字符串而不是给存档加四个字段：参数是跟着规矩走的，
// 拆开存迟早会出现「有参数没规矩」或者反过来的半拉状态
export function encodeRule(key : string, arg : string) : string {
  return arg == '' ? key : key + '=' + arg
}

export function ruleKeyOf(entry : string) : string {
  const at = entry.indexOf('=')
  return at < 0 ? entry : entry.substring(0, at)
}

export function ruleArgOf(entry : string) : string {
  const at = entry.indexOf('=')
  return at < 0 ? '' : entry.substring(at + 1)
}

// 摇 want 条出来。带参数的顺手把参数也摇了。
// suits 从外面传进来 —— 这个文件不该去认花色表
export function rollDealerRules(level : number, want : number, suits : string[]) : string[] {
  const pool = rulesFor(level)
  const out : string[] = []
  const used : boolean[] = []
  for (let i = 0; i < pool.length; i++) {
    used.push(false)
  }
  let left = want
  if (left > pool.length) {
    left = pool.length
  }
  let guard = 0
  while (out.length < left && guard < 200) {
    guard = guard + 1
    const at = Math.floor(Math.random() * pool.length)
    if (used[at]) {
      continue
    }
    used[at] = true
    out.push(encodeRule(pool[at].key, rollRuleArg(pool[at].key, suits)))
  }
  return out
}

function rollRuleArg(key : string, suits : string[]) : string {
  // 长手：±1 还是 ±2
  if (key == 'reach') {
    return '' + (1 + Math.floor(Math.random() * 2))
  }
  if (key == 'wild') {
    return '' + (1 + Math.floor(Math.random() * 13))
  }
  if (key == 'crown') {
    const a = 1 + Math.floor(Math.random() * 13)
    // 两个点数不能撞 —— 撞了等于只压了一个
    let b = a
    let guard = 0
    while (b == a && guard < 50) {
      b = 1 + Math.floor(Math.random() * 13)
      guard = guard + 1
    }
    return '' + a + ',' + b
  }
  if (key == 'lock' && suits.length > 0) {
    return suits[Math.floor(Math.random() * suits.length)]
  }
  return ''
}

// 哪几条带随机参数。商店和图鉴照这个决定要不要写「每关重摇」
export function ruleRolls(key : string) : boolean {
  return key == 'reach' || key == 'wild' || key == 'crown' || key == 'lock'
}

export function dealerRuleAt(key : string) : DealerRule {
  for (let i = 0; i < DEALER_RULES.length; i++) {
    if (DEALER_RULES[i].key == key) {
      return DEALER_RULES[i]
    }
  }
  return DEALER_RULES[0]
}

// ---------- 查表 ----------

export function itemAt(key : string) : RelayItem {
  for (let i = 0; i < RELAY_ITEMS.length; i++) {
    if (RELAY_ITEMS[i].key == key) {
      return RELAY_ITEMS[i]
    }
  }
  return RELAY_ITEMS[0]
}

export function itemIndexOf(key : string) : number {
  for (let i = 0; i < RELAY_ITEMS.length; i++) {
    if (RELAY_ITEMS[i].key == key) {
      return i
    }
  }
  return -1
}

// 这件道具**最低**从第几级起。
//
// 绝大多数是普通档起步。少数几件压根没有普通形态 —— 它们只有一个样子，
// 而那个样子本身就值一个稀有：并色就是这种，四门花色并成两门是个
// 一步到位的规矩，没有「并一半」这种中间状态可言。
//
// 不给 RelayItem 加字段而是开一张查表，是为了不动另外二十几件的定义 ——
// 这类道具本来就是少数，为它们给每一件都加个 floor: 0 不划算。
//
// 底线和上限撞在一起（floor == maxTierOf）就等于「买到手即满级」：
// nextTierOf 直接返回 -1，商店那边显示不出「升」这颗按钮
export function floorTierOf(key : string) : number {
  // 并色（四门并两门）、归标（大牌归不归 11）、落水（砸不砸平）
  // 都是是非题，没有中间状态
  return key == 'fold' || key == 'toll' || key == 'flood'
    ? TIER_RARE : TIER_COMMON
}

// 这件道具最高能升到第几级。级数不齐，别拿 TIER_LEGEND 当上限
export function maxTierOf(item : RelayItem) : number {
  const last = item.steps.length - 1
  return last < 0 ? 0 : last
}

// 把一个等级夹进这件道具真实存在的区间 [floor, max]。
//
// 下限也要夹：并色没有普通形态，读 steps[0] 读到的是个占位值。
// 夹在这儿是最省事的 —— valueAt / usesAt / countAt / descOf 全走这一道，
// 补一处就都对了
export function clampTier(item : RelayItem, tier : number) : number {
  const top = maxTierOf(item)
  const floor = floorTierOf(item.key)
  const low = floor > top ? top : floor
  if (tier < low) {
    return low
  }
  return tier > top ? top : tier
}

// 这一级的主数值
export function valueAt(item : RelayItem, tier : number) : number {
  return item.steps[clampTier(item, tier)]
}

// 这一级每局能用几次。永续类返回 0
export function usesAt(item : RelayItem, tier : number) : number {
  if (item.kind != KIND_LIMITED || item.uses.length == 0) {
    return 0
  }
  const at = clampTier(item, tier)
  return at < item.uses.length ? item.uses[at] : item.uses[item.uses.length - 1]
}

// 这一级一次能点几张牌。不挑目标的返回 0 ——
// 清水是全翻，窥筒是看对面，断口是挑一整类
export function countAt(item : RelayItem, tier : number) : number {
  if (item.counts.length == 0) {
    return 0
  }
  const at = clampTier(item, tier)
  return at < item.counts.length ? item.counts[at] : item.counts[item.counts.length - 1]
}

// 拼这一级的说明。三段各自可有可无：
//   「指定 N 张」—— counts 是空的就不摆（不挑目标的道具）
//   数值 —— steps 是 0 就不摆（空钩、清水、断口没有数值可言）
//   「每局 N 次」—— 永续类不摆
export function descOf(item : RelayItem, tier : number) : string {
  const n = valueAt(item, tier)
  const c = countAt(item, tier)
  let out = n == 0 ? item.head + item.tail : item.head + n + item.tail
  if (c > 0) {
    out = '指定 ' + c + ' 张，' + out
  }
  if (item.kind == KIND_LIMITED) {
    out = out + ' · 每局 ' + usesAt(item, tier) + ' 次'
  }
  return out
}

// ---------- 级别的名字和颜色 ----------

export function tierName(tier : number) : string {
  if (tier <= TIER_COMMON) {
    return '普通'
  }
  if (tier == TIER_RARE) {
    return '稀有'
  }
  if (tier == TIER_EPIC) {
    return '史诗'
  }
  return '传说'
}

// 哪件走哪条路。
//
// 集中写一张表，而不是在每件道具里挂个字段：这个映射本身就是
// 「三条路各有哪些货」这一件事，摊开摆在一处才看得出哪条路厚哪条路薄 ——
// 散在二十多个字面量里，想数一数花色流有几件都得翻一遍
export function wayOf(key : string) : number {
  // 点数：改自己牌算几点，去够堆上的钩点
  if (key.indexOf('sink') == 0 || key.indexOf('lift') == 0) {
    return WAY_VALUE
  }
  // 吞口认的是「大于」，算在点数这一路 —— 它读的还是点数，
  // 只是比大小而不是比相等。真要单开一条「大小」的路，
  // 得再有几件跟它成套的（改堆的高低、把大牌压到堆顶之类）才撑得住
  // 定标、归标、挡口是「埋桩 / 够桩 / 护桩」那一套。它们认的还是点数
  //（桩的点数就是钩点，挡口挡不挡得住也看点数），所以归点数这一路
  if (key == 'lucky' || key == 'bare' || key == 'mark' || key == 'toll'
    || key == 'mutenum' || key == 'swallow' || key == 'maw' || key == 'ebb'
    || key == 'flood' || key == 'guard' || key == 'bury' || key == 'tidy') {
    return WAY_VALUE
  }
  // 情报：看得见对面和牌堆。浑水是反过来 —— 让它看不见，同样是情报这条路
  if (key == 'sight' || key == 'peek' || key == 'hint'
    || key == 'clear' || key == 'rod' || key == 'murky' || key == 'still') {
    return WAY_INFO
  }
  // 并色和染水都是「把花色变得好用」：一个把四门并成两门，
  // 一个把整堆染成一门。缠线归点数那一路 —— 它拆的是钩点，不是花色
  if (key == 'fold' || key == 'dye') {
    return WAY_SUIT
  }
  if (key == 'tangle') {
    return WAY_VALUE
  }
  // 花色：基础规则只认点数，这一路把花色也变成能用的。
  //
  // 断色算在这一路，是因为它的用处不在「削弱」而在「立规矩」——
  // 把一半颜色的点数锁死之后，只有按花色钩的人还捞得上来，
  // 那正是这一路的赢法。断数走的是点数轴，归那一路
  if (key == 'gather' || key == 'bysuit' || key == 'mutecolor') {
    return WAY_SUIT
  }
  return WAY_NONE
}

export function wayName(way : number) : string {
  if (way == WAY_VALUE) {
    return '点数'
  }
  if (way == WAY_INFO) {
    return '情报'
  }
  if (way == WAY_SUIT) {
    return '花色'
  }
  return '通用'
}

export function wayColor(way : number) : string {
  if (way == WAY_VALUE) {
    return '#ff9e80'
  }
  if (way == WAY_INFO) {
    return '#6fc3ff'
  }
  if (way == WAY_SUIT) {
    return '#7ce0a3'
  }
  return '#9fd9bd'
}

export function tierColor(tier : number) : string {
  if (tier <= TIER_COMMON) {
    return '#cfeade'
  }
  if (tier == TIER_RARE) {
    return '#6fc3ff'
  }
  if (tier == TIER_EPIC) {
    return '#c58cff'
  }
  return '#e8b23a'
}

// ---------- 价钱 ----------
//
// 分两层，各管各的：
//
//   底价（basePrice，每件自己带）—— 买的是「数值」。
//     坠子家族六件同构，差别只有推得动多少，所以差别全落在这儿：
//     15 / 25 / 40 / 60 / 85 / 115。
//
//   进阶费（下面这个，各件同价）—— 买的是「广度」。
//     多点一张、多用一次，这份好处跟数值多大没关系 ——
//     给 +1 多一张，和给 +6 多一张，都是「多一张」。
//     所以没道理按底价的比例收，那样铁坠升一级要上千，等于不许升。
//
// 两层分开之后，「买一件铁坠(115) 还是 把轻坠升到能点两张(15+70)」
// 是两笔数量级相当、但买到不同东西的账 —— 这才叫取舍

// 进阶到第 toTier 级要多少。跟是哪件道具无关
//
//   升到稀有 70、升到史诗 140、升到传说 260
//
// 翻倍递进而不是线性，是因为格子有限、广度有上限 ——
// 不把后面几级定贵，后期就只剩「无脑升满」一条路了。
//
// 这是**单独一级**的价。跨级的道具要把走过的每一级都算上，
// 见 upgradeCostOf —— 原先只收落点那一级，账是不平的
export function upgradePrice(toTier : number) : number {
  if (toTier <= TIER_RARE) {
    return 70
  }
  if (toTier == TIER_EPIC) {
    return 140
  }
  return 260
}

// 直接买一件第 tier 级的要多少 = 底价 + 一路升上来的进阶费。
//
// 定成这样，「买稀有档」和「买普通档再升一级」是同一个价 ——
// 两条路花一样的钱拿到一样的东西，不留套利的空子。
// 商店只卖普通和稀有两档，所以实际只会用到 tier 0 和 1
export function buyPrice(item : RelayItem, tier : number) : number {
  let sum = item.basePrice
  const top = clampTier(item, tier)
  // 从**它自己的底线**往上数，不是从普通档往上数 ——
  // 并色那种没有普通形态的，它的稀有档就是底价，
  // 不该再替一个根本不存在的普通档补一笔 70
  const floor = floorTierOf(item.key)
  for (let t = floor + 1; t <= top; t++) {
    sum = sum + upgradePrice(t)
  }
  return sum
}

// 这件现在升一级要花多少、升到第几级。升不动了返回 -1 的价。
//
// 跨级的道具（stride 2）一跳两级，跳过头就被自己的最高级截住 ——
// 所以末一跳可能只走一级
export function nextTierOf(item : RelayItem, now : number) : number {
  const top = maxTierOf(item)
  if (now >= top) {
    return -1
  }
  const want = now + item.stride
  return want > top ? top : want
}

export function upgradeCostOf(item : RelayItem, now : number) : number {
  const to = nextTierOf(item, now)
  if (to < 0) {
    return -1
  }
  // **走过几级就收几级的钱**，不是只收落点那一级。
  //
  // 原先只收落点，跨级道具的账就平不了：顺钩从普通起步走
  // 0→史诗(140)→传说(260) 共 460，从稀有起步走 稀有→传说(260) 共 390，
  // 终点一模一样却差 70。差的正是那个你会直接跨过去、
  // 一秒都没用上的史诗档 —— 从普通起步的人白买了它。
  //
  // 改成累加之后，任何一档的总价恒等于 buyPrice(item, tier)，
  // 无论你是直接买那一档、一级级升上去、还是跨级跳上去。
  // 这正是 buyPrice 那边早就写着的那条规矩（「不留套利的空子」），
  // 只是进阶这一侧漏了
  let sum = 0
  for (let t = now + 1; t <= to; t++) {
    sum = sum + upgradePrice(t)
  }
  return sum
}

// ---------- 秤钩：加成怎么算 ----------
//
// 数值表在这个文件里（steps），所以算钱的函数也放这儿 ——
// 从前它在 relay-levels.uts，那会儿加成是写死的三成，
// 现在随等级走，数值和算法分在两个文件里迟早对不上。
//
// 收「这件现在在第几级」，没装就传 -1。
//
// 原先这儿还有个 discountOf（熟客：店里打折）。熟客整件取消了 ——
// 它打的折连自己的进阶费一起打，等于每升一档都让下一档更便宜，
// 是个自加速环；配上秤钩之后实际购买力能到三倍以上，
// 于是「早期抢到这两件」就压过了所有别的规划。
// 一件道具的作用要是「让你更容易买到别的道具」，它就不是一个选项，
// 而是一道必经的关口

// 秤钩：过关金币加成，20% / 35% / 50% / 70%
export function coinBonusOf(tier : number, coins : number) : number {
  if (tier < 0) {
    return coins
  }
  const pct = valueAt(itemAt('scale'), tier)
  return Math.floor(coins * (100 + pct) / 100)
}
