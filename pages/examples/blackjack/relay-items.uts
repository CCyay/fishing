    //
    // 拿当下的钩机会，换一个堆最深处的钩点 —— 后面你自己再拿一张
    // 同点数的来收，从堆底一路端到那张，整堆全归你。
    //
    // 所以它是一手**两张牌的活**：埋哪一张、隔多远再来接，
    // 这正是排竿这个玩法要你想的事。埋得早收得多，但中间隔的轮次越长，
    // 庄家把它钩走的机会也越多 —— 它埋在最底下，谁钩中它谁就端走整堆，
    // 那把刀是双刃的。
    //
    // 「这一下不钩」是有意的：又埋又钩就没有代价了
    steps: [0, 0, 0, 0] as number[],
    counts: [1, 2, 3, 4] as number[],
    uses: [1, 2, 3, 4] as number[],
    basePrice: 45,
    stride: 1,
    head: '它打出时沉到堆底，这一下不钩任何东西',
    tail: ''
  },
  {
    key: 'swallow',
    name: '吞口',
    kind: KIND_LIMITED,
    // 指定一张，这一轮它**按大小吞**：落堆之后从紧挨着它的那张往回数，
    // 一路吞掉比它小的，撞上比它大的（或者一样大的）就停。
    //
    // 这是第三条钩线 —— 基础规则认「等于」，收色认「同色」，这件认「大于」。
    // 三条线各有各的脾气：
    //   等于 —— 精确，要算差几点；
    //   同色 —— 可靠，收得少；
    //   大于 —— 看堆的形状。堆顶摞着一串小牌就能一口气全吞，
    //           但堆顶压着张 K 就一张也吞不动。
    //
    // 所以它的强弱完全由堆的成色决定，得盯着堆打，不是随手一点。
    // 顺带跟断口那两件有联动：被断掉的牌算 0 点，什么都比它大 ——
    // 一整片哑掉的牌正好一口吞了
    steps: [0, 0, 0, 0] as number[],
    counts: [1, 2, 3, 4] as number[],
    uses: [1, 2, 3, 4] as number[],
    basePrice: 50,
    stride: 1,
    head: '这一轮它往回一路吞掉比它小的，撞上不比它小的就停',
    tail: ''
  },
  {
    key: 'bysuit',
    name: '收色',
    kind: KIND_LIMITED,
    // 指定一张，这一轮它的**点数按 0 算**，打出时把堆上**所有**
    // 同花色的牌一并收走 —— 散在哪儿都算，不是钩一张再扫一段。
    // 堆上一张同花色的都没有，它就留在堆里，什么也没发生。
    //
    // 这是花色流的骨架：基础规则只认点数，有了它花色才是一条
    // 独立的收线，而不是集花那样借点数绕一下。
    //
    // 代价是那张牌在点数那条线上彻底作废：0 点钩不上人，也没人钩得上它。
    // 所以用哪张是有讲究的 —— 拿一张本来就配不上对的废牌来收色最划算，
    // 拿一张能配对的大牌去收，等于同时丢掉了另一条路。
    //
    // 跟断色是一对：断色把一半颜色的点数锁死，堆上对手钩不动，
    // 而你这张照样按花色一把捞走
    steps: [0, 0, 0, 0] as number[],
    counts: [1, 2, 3, 4] as number[],
    uses: [1, 2, 3, 4] as number[],
    basePrice: 50,
    stride: 1,
    head: '它点数按 0 算，打出时把堆上所有同花色的一并收走',
    tail: ''
  },
  // ----- 断口两件：按轴分，不按类分 -----
  //
  // 奇/偶/红/黑 是四个**平行的 sidegrade**，不是坠子家族那种
  // 从 +1 到 +6 的阶梯。拆成四件的话四件强度一样，
  // 商店就只是在摇你要的那一个 —— 把临场判断变成了老虎机。
  // 一件管四类又太万能。所以按轴拆两件，各自二选一。
  //
  // 两件的共同点：被断掉的牌**点数没了，花色还在**。
  // 这是整个花色流的赢法 —— 点数死了花色没死，收色和集花照样够得着，
  // 而对手只按点数钩，那一堆对它就是废的。
  //
  // 双刃是有意的：你自己的同类牌也一起哑火，所以得先摸清对面的成色。
  // 探口那条线正好接这儿 —— 它说「庄家有三张奇数」，你就知道该断哪边
  {
    key: 'mutenum',
    name: '断数',
    kind: KIND_LIMITED,
    steps: [0, 0, 0, 0] as number[],
    counts: [] as number[],
    uses: [1, 1, 2, 2] as number[],
    basePrice: 40,
    stride: 1,
    head: '挑奇数或偶数，这一轮双方打出的这类牌都按 0 点算',
    tail: ''
  },
  {
    key: 'mutecolor',
    name: '断色',
    kind: KIND_LIMITED,
    // 归花色流：掐死红色的点数，你的黑色收色照收 ——
    // 这一件跟收色是同一套打法的两头
    steps: [0, 0, 0, 0] as number[],
    counts: [] as number[],
    uses: [1, 1, 2, 2] as number[],
    basePrice: 40,
    stride: 1,
    head: '挑红色或黑色，这一轮双方打出的这类牌都按 0 点算',
    tail: ''
  },
  {
    key: 'hint',
    name: '探口',
    kind: KIND_LIMITED,
    // 不给你看牌，只给一条关于它这一轮手牌的实话 ——
    // 「有两张大于 7」「有三张奇数」「手里有对子」这种。
    //
    // 比窥筒弱也比窥筒便宜，但弱得有意思：线索是**结构**，
    // 看牌是**清单**。知道「它有对子」你就得防它把那对拆开夹你，
    // 具体是哪一对还得自己盯着堆上推
    steps: [1, 2, 3, 4] as number[],
    counts: [] as number[],
    uses: [1, 1, 2, 2] as number[],
    basePrice: 30,
    stride: 1,
    head: '给 ',
    tail: ' 条庄家手牌的线索'
  },
  {
    key: 'bare',
    name: '空钩',
    kind: KIND_LIMITED,
    // 没有数值可显示，只有张数和次数 —— steps 摆 0，descOf 会跳过数值那段。
    //
    // 保命用：钩不上人，也没人钩得上它。
    // 拿来挡庄家那一手大的，或者把自己钩不上的废牌变成安全垫牌。
    // 「它也钩不上人」这个代价是有意留的 —— 白送的保护没什么可想的
    steps: [0, 0, 0, 0] as number[],
    counts: [1, 1, 1, 1] as number[],
    uses: [1, 2, 3, 4] as number[],
    basePrice: 30,
    stride: 1,
    head: '这一轮不算钩点',
    tail: ''
  },
  {
    key: 'clear',
    name: '清水',
    kind: KIND_LIMITED,
    // 不挑目标：盖着的一次全翻开。counts 摆空的
    steps: [0, 0, 0, 0] as number[],
    counts: [] as number[],
    uses: [1, 2, 3, 4] as number[],
    basePrice: 20,
    stride: 1,
    head: '翻开队列里所有盖着的牌',
    tail: ''
  },
  {
    key: 'peek',
    name: '窥筒',
    kind: KIND_LIMITED,
    // 手牌区平时只明示庄家下一张，这件让你多看几张 ——
    // 信息量本身成了可以花钱买的强度。
    //
    // 进阶加的是「看几张」而不是次数：它是信息道具，
    // plan 阶段你要的是一次把局面看清楚好排序，
    // 分四次每次看一张没有意义
    steps: [1, 2, 3, 4] as number[],
    counts: [] as number[],
    uses: [1, 1, 1, 1] as number[],
    basePrice: 25,
    stride: 1,
    head: '看庄家手牌 ',
    tail: ' 张'
  },
  {
    key: 'swap',
    name: '换饵',
    kind: KIND_LIMITED,
    // 进阶加的是一次能换几张，次数保持一次
    steps: [0, 0, 0, 0] as number[],
    counts: [1, 2, 3, 4] as number[],
    uses: [1, 1, 1, 1] as number[],
    basePrice: 30,
    stride: 1,
    head: '换成牌库顶那张',
    tail: ''
  },
  {
    key: 'ballast',
    name: '压舱',
    kind: KIND_LIMITED,
    // 挑几张是当场由你圈的，道具本身不定死 —— counts 摆空的。
    //
    // 唯一能让双方出牌数错开的道具。用了这一轮你少出几张，
    // 终局就比庄家多出几轮 —— 那几轮没有对手插进来，
    // 堆上全是你自己的牌加残留，能连着钩。
    // 它把「清垃圾」变成了终局布局，也是 playStep 里那个
    // 「一方出完、另一方接着打」的跳过逻辑唯一的触发器
    steps: [0, 0, 0, 0] as number[],
    counts: [] as number[],
    uses: [1, 2, 3, 4] as number[],
    basePrice: 35,
    stride: 1,
    head: '队列圈几张压回牌库底，不补牌',
    tail: ''
  }
]

// ---------- 查表 ----------

export function itemAt(key : string) : RelayItem {
  for (let i = 0; i < RELAY_ITEMS.length; i++) {
    if (RELAY_ITEMS[i].key == key) {
      return RELAY_ITEMS[i]
    }
  }
  return RELAY_ITEMS[0]
}

export function itemIndexOf(key : string) : number {
  for (let i = 0; i < RELAY_ITEMS.length; i++) {
    if (RELAY_ITEMS[i].key == key) {
      return i
    }
  }
  return -1
}

// 这件道具最高能升到第几级。级数不齐，别拿 TIER_LEGEND 当上限
export function maxTierOf(item : RelayItem) : number {
  const last = item.steps.length - 1
  return last < 0 ? 0 : last
}

function clampTier(item : RelayItem, tier : number) : number {
  const top = maxTierOf(item)
  if (tier < 0) {
    return 0
  }
  return tier > top ? top : tier
}

// 这一级的主数值
export function valueAt(item : RelayItem, tier : number) : number {
  return item.steps[clampTier(item, tier)]
}

// 这一级每局能用几次。永续类返回 0
export function usesAt(item : RelayItem, tier : number) : number {
  if (item.kind != KIND_LIMITED || item.uses.length == 0) {
    return 0
  }
  const at = clampTier(item, tier)
  return at < item.uses.length ? item.uses[at] : item.uses[item.uses.length - 1]
}

// 这一级一次能点几张牌。不挑目标的返回 0 ——
// 清水是全翻，窥筒是看对面，压舱挑几张由你当场圈
export function countAt(item : RelayItem, tier : number) : number {
  if (item.counts.length == 0) {
    return 0
  }
  const at = clampTier(item, tier)
  return at < item.counts.length ? item.counts[at] : item.counts[item.counts.length - 1]
}

// 拼这一级的说明。三段各自可有可无：
//   「指定 N 张」—— counts 是空的就不摆（不挑目标的道具）
//   数值 —— steps 是 0 就不摆（空钩、清水、压舱没有数值可言）
//   「每局 N 次」—— 永续类不摆
export function descOf(item : RelayItem, tier : number) : string {
  const n = valueAt(item, tier)
  const c = countAt(item, tier)
  let out = n == 0 ? item.head + item.tail : item.head + n + item.tail
  if (c > 0) {
    out = '指定 ' + c + ' 张，' + out
  }
  if (item.kind == KIND_LIMITED) {
    out = out + ' · 每局 ' + usesAt(item, tier) + ' 次'
  }
  return out
}

// ---------- 级别的名字和颜色 ----------

export function tierName(tier : number) : string {
  if (tier <= TIER_COMMON) {
    return '普通'
  }
  if (tier == TIER_RARE) {
    return '稀有'
  }
  if (tier == TIER_EPIC) {
    return '史诗'
  }
  return '传说'
}

// 哪件走哪条路。
//
// 集中写一张表，而不是在每件道具里挂个字段：这个映射本身就是
// 「三条路各有哪些货」这一件事，摊开摆在一处才看得出哪条路厚哪条路薄 ——
// 散在二十多个字面量里，想数一数花色流有几件都得翻一遍
export function wayOf(key : string) : number {
  // 点数：改自己牌算几点，去够堆上的钩点
  if (key.indexOf('sink') == 0 || key.indexOf('lift') == 0) {
    return WAY_VALUE
  }
  // 吞口认的是「大于」，算在点数这一路 —— 它读的还是点数，
  // 只是比大小而不是比相等。真要单开一条「大小」的路，
  // 得再有几件跟它成套的（改堆的高低、把大牌压到堆顶之类）才撑得住
  if (key == 'lucky' || key == 'live' || key == 'bare'
    || key == 'mutenum' || key == 'swallow' || key == 'bury') {
    return WAY_VALUE
  }
  // 情报：看得见对面和牌堆。浑水是反过来 —— 让它看不见，同样是情报这条路
  if (key == 'sight' || key == 'peek' || key == 'hint'
    || key == 'clear' || key == 'rod' || key == 'murky') {
    return WAY_INFO
  }
  // 花色：基础规则只认点数，这一路把花色也变成能用的。
  //
  // 断色算在这一路，是因为它的用处不在「削弱」而在「立规矩」——
  // 把一半颜色的点数锁死之后，只有按花色钩的人还捞得上来，
  // 那正是这一路的赢法。断数走的是点数轴，归那一路
  if (key == 'gather' || key == 'bysuit' || key == 'mutecolor') {
    return WAY_SUIT
  }
  return WAY_NONE
}

export function wayName(way : number) : string {
  if (way == WAY_VALUE) {
    return '点数'
  }
  if (way == WAY_INFO) {
    return '情报'
  }
  if (way == WAY_SUIT) {
    return '花色'
  }
  return '通用'
}

export function wayColor(way : number) : string {
  if (way == WAY_VALUE) {
    return '#ff9e80'
  }
  if (way == WAY_INFO) {
    return '#6fc3ff'
  }
  if (way == WAY_SUIT) {
    return '#7ce0a3'
  }
  return '#9fd9bd'
}

export function tierColor(tier : number) : string {
  if (tier <= TIER_COMMON) {
    return '#cfeade'
  }
  if (tier == TIER_RARE) {
    return '#6fc3ff'
  }
  if (tier == TIER_EPIC) {
    return '#c58cff'
  }
  return '#e8b23a'
}

// ---------- 价钱 ----------
//
// 分两层，各管各的：
//
//   底价（basePrice，每件自己带）—— 买的是「数值」。
//     坠子家族六件同构，差别只有推得动多少，所以差别全落在这儿：
//     15 / 25 / 40 / 60 / 85 / 115。
//
//   进阶费（下面这个，各件同价）—— 买的是「广度」。
//     多点一张、多用一次，这份好处跟数值多大没关系 ——
//     给 +1 多一张，和给 +6 多一张，都是「多一张」。
//     所以没道理按底价的比例收，那样铁坠升一级要上千，等于不许升。
//
// 两层分开之后，「买一件铁坠(115) 还是 把轻坠升到能点两张(15+70)」
// 是两笔数量级相当、但买到不同东西的账 —— 这才叫取舍

// 进阶到第 toTier 级要多少。跟是哪件道具无关
//
//   升到稀有 70、升到史诗 140、升到传说 260
//
// 翻倍递进而不是线性，是因为格子有限、广度有上限 ——
// 不把后面几级定贵，后期就只剩「无脑升满」一条路了。
//
// 按落点那一级算，还顺手把跨级的账算对了：stride 2 的道具
// 从普通直接跳史诗，收的就是史诗那一档的 140，
// 比分两步走（70 + 140）便宜，但中间那级的效果你也没拿到 ——
// 少花钱少拿货，账是平的
export function upgradePrice(toTier : number) : number {
  if (toTier <= TIER_RARE) {
    return 70
  }
  if (toTier == TIER_EPIC) {
    return 140
  }
  return 260
}

// 直接买一件第 tier 级的要多少 = 底价 + 一路升上来的进阶费。
//
// 定成这样，「买稀有档」和「买普通档再升一级」是同一个价 ——
// 两条路花一样的钱拿到一样的东西，不留套利的空子。
// 商店只卖普通和稀有两档，所以实际只会用到 tier 0 和 1
export function buyPrice(item : RelayItem, tier : number) : number {
  let sum = item.basePrice
  const top = clampTier(item, tier)
  for (let t = 1; t <= top; t++) {
    sum = sum + upgradePrice(t)
  }
  return sum
}

// 这件现在升一级要花多少、升到第几级。升不动了返回 -1 的价。
//
// 跨级的道具（stride 2）一跳两级，跳过头就被自己的最高级截住 ——
// 所以末一跳可能只走一级
export function nextTierOf(item : RelayItem, now : number) : number {
  const top = maxTierOf(item)
  if (now >= top) {
    return -1
  }
  const want = now + item.stride
  return want > top ? top : want
}

export function upgradeCostOf(item : RelayItem, now : number) : number {
  const to = nextTierOf(item, now)
  return to < 0 ? -1 : upgradePrice(to)
}

// ---------- 秤钩 / 熟客：这两件的加成怎么算 ----------
//
// 数值表在这个文件里（steps），所以算钱的函数也放这儿 ——
// 从前它们在 relay-levels.uts，那会儿加成是写死的三成和八折，
// 现在随等级走，数值和算法分在两个文件里迟早对不上。
//
// 两个函数都收「这件现在在第几级」，没装就传 -1

// 秤钩：过关金币加成，20% / 35% / 50% / 70%
export function coinBonusOf(tier : number, coins : number) : number {
  if (tier < 0) {
    return coins
  }
  const pct = valueAt(itemAt('scale'), tier)
  return Math.floor(coins * (100 + pct) / 100)
}

// 熟客：店里打折，八折 / 七折 / 六折 / 五折。
// 算价的地方一律过这道，免得漏掉一处就有个不打折的角落
export function discountOf(tier : number, price : number) : number {
  if (tier < 0) {
    return price
  }
  const off = valueAt(itemAt('regular'), tier)
  const cut = Math.floor(price * off / 10)
  return cut < 1 ? 1 : cut
}
