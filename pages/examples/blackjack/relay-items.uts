// 排竿的道具。
//
// 这套取代了原先的贴纸。换掉的理由不是道具更好，是贴纸本来就不是
// 为排竿设计的：
//
//   · 那 80 种贴纸的四个流派（控制/混沌/奇偶/重量）全都建立在主玩法的
//     机制上 —— 手牌上限、回合结束补牌、看对手手牌。排竿没有手牌、
//     没有补牌、没有回合结束，它们在这儿不是弱，是结构性地无法存在。
//     relayStickerPool 那套「拿张 7 当试纸看点数变没变」的动态筛选，
//     不是筛选，是抢救：80 种捞出三十几种，其中二十种是空位类，
//     而空位类在排竿里的效果压根没实现（playOne 只把它们的点数清空）。
//     真正生效的十几种全是「点数 ±N」，同质得没有机制差异。
//
//   · 更根本的是决策形态。贴纸是「贴在某张牌上」，决策是「贴哪张」——
//     而排竿排完序就自动演完，plan 之后插不上手，所以「贴哪张」
//     始终是对未来的押注。道具是「改善这一轮的排序条件」，
//     决策是「这一局的几次机会用在哪一轮」—— plan 阶段你看得见
//     堆上有什么、队列里有什么、庄家下一张打什么，这个决策
//     建立在完整信息上。
//
// stickers.uts 原样留给主玩法，两套系统并存互不干扰。

// ---------- 两类 ----------
//
// 没有「一次性」那一类。一次性道具有个治不好的毛病：玩家舍不得用，
// 攒着攒着就通关了 —— 原先的「翻箱」「清水」就是这个下场。
// 限制类的「每局 N 次、下一局回满」正是它的解药：不用白不用，
// 但也不能滥用。
//
// 两类怎么分，就看一件事：**用它的时候要不要挑目标**。
//
//   · 要挑 —— 限制类。「挑哪张」本身就是决策，而决策要值钱，
//     次数就得有限。指定一张牌 +1，你得先算清楚它落堆时
//     堆底摆着什么、庄家下一张会不会先把那个钩点端走 ——
//     plan 阶段这些你都看得见，所以这是道算术题，不是押注。
//
//   · 不用挑 —— 永续类。它改的是这一局的规矩本身（队列多长、
//     钩中能多收几张、金币怎么算），装上就在那儿，没有「什么时候用」
//     可言，自然也就不必限次。
//
// 照这条线划下来，「你的牌点数统统 +1」这种就不该做成永续：
// 它是全局平移，你自己牌之间的配对关系压根没变，变的只是跟庄家
// 怎么对齐 —— 既难算明白，装上之后也再没有可想的了。
// 改成「挑一张 +1」，它立刻就有了决策
export const KIND_LASTING : number = 0
export const KIND_LIMITED : number = 1

// ---------- 四级 ----------
//
// 进阶就是升级 —— 稀有度在这儿是**等级**，不是稀缺度。
//
// 所以不按稀有度限制携带数量。那会让进阶把自己锁死：
// 「传说只能带 1 个」的话，你花钱把第二件升到传说就等于钱白花，
// 玩家很快会学会「只升一件到顶、其余卡在史诗」。
// 携带数量只看道具栏格数，取舍落在「带满 6 件普通 还是 升 3 件到传说」。
//
// 商店只卖普通和稀有，后两级买不到 —— 进阶是拿到史诗、传说的唯一路子。
// 货架上能直接刷出传说的话，一级级攒钱升的人就成了冤大头
export const TIER_COMMON : number = 0
export const TIER_RARE : number = 1
export const TIER_EPIC : number = 2
export const TIER_LEGEND : number = 3

// ---------- 三条路子 ----------
//
// 开局白送的三件各代表一条，剩下的靠你自己往哪边加码：
//
//   点数 —— 改自己牌的点数去够钩点。最直接，也最吃「差几点」的算术。
//   信息 —— 看得见庄家手里什么、堆里什么结构。不直接变强，
//           但让每一步排序都算得出账。
//   花色 —— 顺着花色走另一条钩线。基础规则只认点数，
//           这一路是把花色也变成能用的东西。
//
// 还有一类不属于任何一路（秤钩这种只管钱的），归「通用」。
// 分路只影响商店怎么陈列和你怎么规划，不影响结算
// ---------- 一条底线：点数不会变成负数 ----------
//
// 任何往下减的东西 —— 提子六件、落水、以后再加的什么 ——
// **减到 0 就停**。这是规则，不是某件道具的特例，所以道具说明里一律不写。
//
// 为什么要立这条：
//   · 负数在规则里跟 0 是一个待遇（shareValue 一律跳过 ≤0），
//     多出来的那截数字不产生任何玩法，只会在牌面上冒出「-3」这种东西；
//   · 「0 点牌」得是个数得清的状态。落水要数场上有几张 0，
//     留着负数的话它就得同时认 0 和一切负数，一件道具两套说法；
//   · 减法叠起来会越叠越离谱（提子 −6 再吃一发落水 −5 就是 −11），
//     而那个 −11 跟 0 打起来一模一样。留着它只是在攒无意义的数。
//
// 实现是一道统一的闸（relay.uvue 的 noNegative），
// 摆在算候选点数的出口上，所有减法都得过它 —— 不靠每件道具自己夹
export const WAY_NONE : number = 0
export const WAY_VALUE : number = 1
export const WAY_INFO : number = 2
export const WAY_SUIT : number = 3

export type RelayItem = {
  key : string
  name : string
  kind : number
  // 每一级的主数值。级数不齐的道具（比如长竿只有两级）
  // 就只摆两个，最高级 = steps.length - 1
  steps : number[]
  // 每一级能一次指定几张牌。不挑目标的（清水、窥筒、断口那两件）摆空的
  counts : number[]
  // 限制类每一级能用几次。永续类摆空的
  uses : number[]
  // 这件道具在普通档的牌面价。
  //
  // 价钱分两层：底价买的是「数值」—— 坠子家族 +1 到 +6 六件同构，
  // 差别只在推得动多少，所以差别得由底价来背；
  // 进阶费买的是「广度」—— 多点一张、多用一次，这份好处跟数值没关系，
  // 所以各件同价（见 upgradePrice）。
  //
  // 两层分开之后，「买一件 +6 还是把手里的 +1 升到能点三张」
  // 才是两笔算得清的账
  basePrice : number
  // 一次进阶往上跨几级。多数是 1，效果陡的给 2 ——
  // 那几件每升一档都是成倍地强（钩中多收一张、每张牌多一个候选点数），
  // 一级一级卖太便宜了，跨两级卖，价钱按落点那一级算。
  //
  // 跨过头会被 maxTierOf 截住，所以最后一跳可能不足 stride 级 ——
  // 比如 [1,2,3,4] 配 stride 2：0 → 2 → 3，末一跳只走了一级
  stride : number
  // 描述拆成「前缀 + 数值 + 后缀」三段拼。
  // 不用占位符替换：UTS 的 String.replace 在 Kotlin 那边是全替换、
  // 在 JS 那边只换第一处，跨端行为对不上，拼接最省事也最稳
  head : string
  tail : string
}

// ---------- 道具表 ----------
//
// 33 件：永续 9、限制 24（其中坠子家族 6、提子家族 6）。
//
// 永续那 9 件全是「不用挑目标」的：队列多长、钩中怎么算、金币怎么算。
//
// 限制类里有两件挑的是**庄家那排**而不是你自己的队列（窥筒、停口）——
// 它们共用一套「点庄家手牌」的选择态，见 relay.uvue 的 aimsFoe / pickFoe。
// 要挑目标的一律进了限制类。
//
// 限制类的进阶只走一条路：**加张数、加次数**，数值一律钉死。
// 想要更大的数值，是换一件买，不是把手里这件升上去 ——
// 于是「买一件 +6，还是把手里的 +1 升到能点三张」成了两笔算得清的账：
// 前者一次推得远，后者一轮里够得着的牌多。
//
// 坠子六件同构，差别只有数值，所以差别全由底价背（15 到 115）；
// 进阶费买的是广度，跟数值无关，所以各件同价。
//
// ---- 张数和次数不许挂在同一条梯子上 ----
//
// 这条是吃过亏立的。原先 counts 和 uses 都是 [1,2,3,4]，
// 顶档就是 4 张 × 4 次 = **一局改 16 次点数** —— 你一局总共才打 26 张牌。
//
// 更糟的是它把上面那笔「算得清的账」算翻了：底价那条轴是线性的
//（+1 到 +6，15 到 115），梯子那条轴是相乘的，乘的一定赢。
// 于是轻坠升满（16 次 +1）稳赢铁坠普通（1 次 +6）——
// 钩中要的是精确命中，十六次小修远比一次大修管用，
// 「换一件更重的买」这条路就彻底没人走了。
//
// 所以两条轴只许涨一条：counts 走 [1,2,3,4]，uses 走 [1,1,2,2]。
// 顶档 4 张 × 2 次 = 8 次，还是这件道具最宽的时候，但不再压过家族那条轴

export const RELAY_ITEMS : RelayItem[] = [
  // ----- 永续：改这一局的规矩，装上就在那儿，不用挑目标 -----
  {
    key: 'rod',
    name: '长竿',
    kind: KIND_LASTING,
    // 多摆出来几张，但**每轮照样只打五张** —— 多出来的那几张
    // 这一轮轮不到，留到下一轮接着用。
    //
    // 所以它买的不是「打得多」，是「看得远、挑得着」：
    // 六张里挑五张打，拖动排序顺手就把不想打的那张挪到第六位去。
    // 做成「打六张」就变成单纯的加量了，那既改局长又改节奏，
    // 还得给庄家也补一张，不然一边倒。
    //
    // 只有两级。再多排序负担就过头了，一排七张已经是极限。
    // 级数不齐的道具就摆这么多，maxTierOf 按 steps 的长度算
    steps: [1, 2] as number[],
    counts: [] as number[],
    uses: [] as number[],
    basePrice: 70,
    stride: 1,
    head: '多摆出 ',
    tail: ' 张备选，每轮仍只打五张'
  },
  // 原先这儿有件「活钩」（你的牌还可以按 ±N 算，永续，能升到 ±3）。
  // 整件取消，挪到庄家那边去了（见 DEALER_RULES 的「长手」）。
  //
  // 取消的理由是它太强，而太强的根子在**它是永续的全局规矩**：
  // ±3 之后你手上每一张牌都有七个候选点数，几乎张张都钩得中 ——
  // 「差几点」这道算术题整个消失了，而那道题正是排竿的核心。
  // 别的点数道具都要你挑牌、算次数，只有它是装上就不用再想。
  //
  // 同一个效果放在庄家身上反而好：它让**你**的算术变难而不是变没有，
  // 而且庄家那套是按关卡摇的，不会一路叠到顶
  {
    key: 'murky',
    name: '浑水',
    kind: KIND_LASTING,
    // 把水搅浑，庄家自己也看不清手里几张 —— 它**只看得见五张里的其中几张**，
    // 剩下的对它是盲的。照样得排序，只是盲的那几张只能瞎插。
    //
    // 打的是它的**算计**，不是它的牌。庄家的厉害之处全在 sortDealer
    // 那套「把配得上对的排到相邻位」，遮掉一张就够它配错一次；
    // 遮到三张，它那套脑子基本就废了。
    //
    // 所以封顶三张（五张里遮三张），再多就不是削弱是抹掉了 ——
    // 对手变成纯随机之后这游戏也没什么可算的了
    steps: [1, 2, 3] as number[],
    counts: [] as number[],
    uses: [] as number[],
    basePrice: 60,
    stride: 1,
    head: '庄家每轮有 ',
    tail: ' 张牌自己也看不见，只能瞎插进出牌顺序'
  },
  {
    key: 'tidy',
    name: '拢堆',
    kind: KIND_LIMITED,
    // 发动的那一轮：有牌打下去没钩上，就把本轮打出的牌按点数
    // 从大到小重排 —— 大的沉底，小的浮顶。
    //
    // 这件**当场换掉这个玩法的地基**：基础规则里堆就是出牌顺序，
    // 「你相邻两张之间夹着它一张，配对就把中间那张一并收走」全靠这个顺序。
    // 拢堆一开，顺序没了，堆变成一道梯子 ——
    // 改成「钩中下面那张大牌，上面所有更小的一并归你」。
    //
    // 做成按轮发动而不是挂着一直生效，是因为「哪一轮翻地基」
    // 本身就是个好决策：堆薄的时候翻没意义，堆厚、而且你手里
    // 正好有张大牌的时候翻，一钩就是一片。挂着不管反而没得想。
    //
    // 只排本轮打出的，上几轮沉在底下的不动 —— 那是跨轮的记忆，
    // 连它一起抹平的话，「堆底埋着什么」这条线就断了
    steps: [0, 0, 0, 0] as number[],
    counts: [] as number[],
    uses: [1, 2, 3, 4] as number[],
    basePrice: 75,
    stride: 1,
    head: '这一轮没钩上的牌按点数从大到小重排 —— 堆成一道梯子，钩得越深收得越多',
    tail: ''
  },
  {
    key: 'fold',
    name: '并色',
    kind: KIND_LASTING,
    // 方块当红心，梅花当黑桃 —— 四门花色并成两门。
    //
    // 这是花色那一路的**地基**，不是又一件加成。基础规则只认点数，
    // 花色那条线全靠收色和集花撑着，而这两件都吃「堆上有没有同花色的」——
    // 四门分着的时候，堆上一张牌是你要的花色的概率只有四分之一，
    // 收色多半收个空，集花多半对不上。并上之后翻倍到一半，
    // 那两件才从「看运气」变成「算得出来」。
    //
    // **只管你自己那两条按花色收的线**。庄家的同源（跟堆顶同花色就白送点数）
    // 和锁花（锁死你一个花色）都不受影响 —— 那是它的规矩，
    // 没道理让你花钱买的道具反过来去喂它、去加倍坑自己。
    //
    // 只有一档，也升不动（floorTierOf 把它钉在稀有，而稀有就是它的上限）：
    // 四门并成两门是个一步到位的规矩，没有「并一半」这种中间状态。
    // 硬要给它编四档，编出来的也是「并 1.5 门」这种没人看得懂的东西。
    //
    // steps 的 0 那格够不着，还是填了同样的值 —— clampTier 万一夹到那儿，
    // 读出来的数也得是对的
    // 110 而不是 90：它是**两记大招共用的引信**——
    // 既让收色的覆盖面从四分之一翻到一半，又让集花几乎不再扑空。
    // 一件道具同时给两条线开锁，价钱得照着两条线收
    steps: [1, 1] as number[],
    counts: [] as number[],
    uses: [] as number[],
    basePrice: 110,
    stride: 1,
    head: '方块当红心、梅花当黑桃 —— 你的收色和集花按并完的花色算',
    tail: ''
  },
  // 原先这儿有件「留底」（钩中堆最底下那张时把它留下不收走），取消了。
  // 它是为了让埋下去的桩能反复吃而加的，但一条「每次钩底都少收一张」
  // 的常驻规矩，影响面远超它想服务的那一套打法
  {
    key: 'flood',
    name: '落水',
    kind: KIND_LASTING,
    // **任何人**打出 0 点牌时，此牌左侧所有牌的点数 −X。
    // X = 这时候堆上 0 点牌的张数（含刚打出的这张）。
    // 减到 0 就停 —— 那是全局规则，不是这件的特例，见文件头那条底线。
    //
    // ---- 为什么它不像别的永续件那样只管你 ----
    //
    // 并色、巨口、挡口都只照顾你这边，因为它们给的是**好处**。
    // 这件给的不是好处，是**改牌桌的物理**：水位落下去，谁的牌都一起沉。
    //
    // 而「一起沉」在这儿天然对你有利 —— 砸平之后等点数那条线废了，
    // 可庄家**只有**那一条线，你还有吞口、巨口、收色三条备胎。
    // 这条规矩越公平，它越吃亏。
    //
    // 名字照实说：牌是砸下去那块石头，波纹往下铺开，石头自己不动。
    //
    // ---- 它是「0 点」那一路的地基 ----
    //
    // 在这件之前，0 点是**纯负债**：等点数那条线跳过 ≤0
    //（见 cards.uts 的 shareValue），所以 0 点牌钩不了人也没人钩得了它，
    // 唯一的用处是当垫牌、或者喂自己的吞口。没有任何一条路让你靠 0 收牌。
    //
    // 这件给了 0 一个正面用途，而且不是「让 0 能钩 0」那种把它塞回
    // 老路子的做法 —— 它让 0 去**改写整张牌桌的数字**。
    //
    // ---- 它是雪崩，不是匀速下沉 ----
    //
    // 减的量由场上已有的 0 决定，所以每掉一批牌进 0，下一脚就踩得更深：
    //   起始 3 9 5 J 2 7 4 6
    //   第一张 0（X=1）→ 2 8 4 10 1 6 3 5
    //   第二张 0（X=2）→ 0 6 2 8 0 4 1 3
    //   第三张 0（X=5）→ 0 1 0 3 0 0 0 0
    // 三张见底。而且它**自动收敛** —— 全归 0 之后再减也没意义，
    // 所以数字看着会失控，实际效果有天花板：「整堆归零」。
    //
    // ---- 砸平之后靠什么收 ----
    //
    // 等点数那条线双方都废了，这是代价也是身份。能收的只剩两条：
    //   吞口 / 巨口 —— 满堆 sizeOf 都是 0，一张大牌一路吞到底，整堆一口；
    //   收色 —— 认花色不认点数，完全不受影响。
    // 所以这一路的完整形状是「断数铺 0 → 落水引爆 → 巨口或收色一勺端走」。
    //
    // 断数是这一路的引信，而且因为落水**认任何人打出的 0**，
