  .page {
    flex: 1;
    padding: 14px;
    background-color: #0b5d3b;
  }

  .page-title {
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
  }

  .page-desc {
    color: #9fd9bd;
    font-size: 12px;
    margin-top: 4px;
  }

  .slots {
    flex: 1;
    margin-top: 10px;
  }

  .slot {
    background-color: #084730;
    border-radius: 10px;
    padding: 10px 12px;
    margin-top: 10px;
    border-width: 1px;
    border-style: solid;
    border-color: #084730;
  }

  .slot-current {
    border-color: #e8b23a;
  }

  .slot-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .slot-name {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
  }

  .slot-badge {
    color: #e8b23a;
    font-size: 12px;
  }

  .slot-info {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .slot-text {
    color: #cfeade;
    font-size: 12px;
    margin-right: 12px;
  }

  .slot-empty {
    color: #8fc7ab;
    font-size: 12px;
    margin-top: 4px;
  }

  .slot-actions {
    flex-direction: row;
    margin-top: 8px;
  }

  .slot-btn {
    height: 32px;
    border-radius: 16px;
    padding: 0 18px;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
    background-color: #0e6b45;
  }

  .slot-btn-primary {
    background-color: #e8b23a;
  }

  .slot-btn-danger {
    background-color: #8c2f2a;
  }

  .slot-btn-text {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
  }

  .slot-btn-text-dark {
    color: #3b2a00;
  }

  .back-btn {
    height: 44px;
    border-radius: 22px;
    align-items: center;
    justify-content: center;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .back-text {
    color: #e8b23a;
    font-size: 15px;
    font-weight: bold;
  }
</style>
