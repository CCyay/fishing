<template>
  <view class="page">
    <!-- 标题必须印着是谁的档：这一页两个游戏共用，
         url 上的 scope 传错的话，这儿是唯一看得出来的地方 -->
    <text id="bj-saves-title" class="page-title">{{ gameName }}存档</text>
    <text class="page-desc">{{ pageDesc }}</text>

    <view class="slots">
      <view
        v-for="slot in slots"
        :key="slot.index"
        class="slot"
        :class="{ 'slot-current': slot.index == activeIndex }">
        <view class="slot-head">
          <text class="slot-name">{{ slot.data.exists ? slot.data.label : '空存档' }}</text>
          <text v-if="slot.index == activeIndex" class="slot-badge">使用中</text>
        </view>

        <!-- 三个分支必须是**相邻兄弟**，中间插别的节点 v-else 就接不上了。
             两个游戏的槽位摘要看的是完全不同的字段：排竿的档里 cleared 和
             tickets 永远是空的，摆出来只会让人以为「进度丢了」 -->
        <text v-if="!slot.data.exists" class="slot-empty">槽位 {{ slot.index }} 尚未创建</text>
        <view v-else-if="isRelay" class="slot-info">
          <text class="slot-text">最远 {{ bestOf(slot) }}</text>
          <text class="slot-text">{{ runOf(slot) }}</text>
          <text class="slot-text">金币 {{ slot.data.runCoins }}</text>
          <text class="slot-text"
            >道具 {{ itemsOf(slot) }} 件 · {{ slot.data.runSlots }} 格</text
          >
        </view>
        <view v-else class="slot-info">
          <text class="slot-text"
            >兑换券 {{ ticketsOfSlot(slot) }} · 随机券 {{ randomTicketsOfSlot(slot) }}</text
          >
          <text class="slot-text"
            >战绩 {{ slot.data.win }}/{{ slot.data.lose }}/{{ slot.data.push }}</text
          >
          <text class="slot-text">通关 {{ slot.data.cleared.length }}</text>
          <text class="slot-text">已贴 {{ stuckOf(slot) }} · 存货 {{ ownedOf(slot) }} 张</text>
        </view>

        <view class="slot-actions">
          <view
            v-if="slot.data.exists"
            class="slot-btn slot-btn-primary"
            @click="useSlot(slot.index)">
            <text class="slot-btn-text slot-btn-text-dark">使用</text>
          </view>
          <view v-else class="slot-btn slot-btn-primary" @click="createSlot(slot.index)">
            <text class="slot-btn-text slot-btn-text-dark">新建</text>
          </view>
          <view
            v-if="slot.data.exists"
            class="slot-btn slot-btn-danger"
            @click="removeSlot(slot.index)">
            <text class="slot-btn-text">删除</text>
          </view>
        </view>
      </view>
    </view>

    <view id="bj-saves-back" class="back-btn" @click="goBack">
      <text class="back-text">返回</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { countStuck } from '@/pages/examples/blackjack/cards.uts'
  import {
    SaveData,
    SLOT_COUNT,
    sumOf,
    loadFishAt,
    writeFishAt,
    clearFishAt,
    fishSaveSlot,
    setFishSaveSlot,
    newFishSave,
    loadRelayAt,
    writeRelayAt,
    clearRelayAt,
    relaySaveSlot,
    setRelaySaveSlot,
    newRelaySave,
    FISH_SAVE_NAME,
    RELAY_SAVE_NAME
  } from '@/pages/examples/blackjack/save.uts'
  import { RELAY_COUNT } from '@/pages/examples/blackjack/relay-levels.uts'

  type Slot = {
    index : number
    data : SaveData
  }

  const slots = ref<Slot[]>([] as Slot[])
  const activeIndex = ref<number>(1)
  // 这一页两个游戏共用，scope 决定动哪一套存档。
  // 从 url 上带过来（home 传 fish、relay-levels 传 relay），见下面的 onLoad
  const isRelay = ref<boolean>(false)

  // ---------- 分发只在这五个函数里 ----------
  //
  // 别处一律走它们。各处自己 if 一遍的话迟早有一处写反，
  // 而写反的后果是把人家另一个游戏的档切了或者删了 —— 这种错没法回滚

  function loadOne(index : number) : SaveData {
    return isRelay.value ? loadRelayAt(index) : loadFishAt(index)
  }

  function usedSlot() : number {
    return isRelay.value ? relaySaveSlot() : fishSaveSlot()
  }

  function pickSlot(index : number) {
    if (isRelay.value) {
      setRelaySaveSlot(index)
    } else {
      setFishSaveSlot(index)
    }
  }

  function makeSlot(index : number) {
    if (isRelay.value) {
      writeRelayAt(index, newRelaySave(RELAY_SAVE_NAME + ' ' + index))
    } else {
      writeFishAt(index, newFishSave(FISH_SAVE_NAME + ' ' + index))
    }
  }

  function dropSlot(index : number) {
    if (isRelay.value) {
      clearRelayAt(index)
    } else {
      clearFishAt(index)
    }
  }

  // 标题和说明都印着玩法名 —— **scope 传错的时候这是唯一肉眼抓得住的地方**，
  // 所以必须有
  const gameName = computed<string>(() : string => {
    return isRelay.value ? RELAY_SAVE_NAME : FISH_SAVE_NAME
  })

  const pageDesc = computed<string>(() : string => {
    return isRelay.value
      ? '存档记录最远战绩，以及这一轮的关号、金币和道具'
      : '存档记录兑换券、战绩、通关进度和牌组上的贴纸'
  })

  // 排竿那一半的槽位摘要
  function bestOf(slot : Slot) : string {
    const best = slot.data.relayBest
    return best > 0 ? best + '/' + RELAY_COUNT : '一关未通'
  }

  function runOf(slot : Slot) : string {
    const lv = slot.data.runLevel
    if (lv <= 0) {
      return '本轮未开始'
    }
    return lv > RELAY_COUNT ? '本轮已通关' : '本轮第 ' + lv + ' 关'
  }

  // 道具库里有几件。runTiers 存的是「等级 + 1」，所以大于 0 就是有
  function itemsOf(slot : Slot) : number {
    let n = 0
    for (let i = 0; i < slot.data.runTiers.length; i++) {
      if (slot.data.runTiers[i] > 0) {
        n = n + 1
      }
    }
    return n
  }

  // 手里各种稀有度的券加起来
  function ticketsOfSlot(slot : Slot) : number {
    return sumOf(slot.data.tickets)
  }

  function randomTicketsOfSlot(slot : Slot) : number {
    return sumOf(slot.data.randomTickets)
  }

  // 已经贴到牌组上的贴纸张数
  function stuckOf(slot : Slot) : number {
    return countStuck(slot.data.stuck)
  }

  // 手里还没贴出去的贴纸张数
  function ownedOf(slot : Slot) : number {
    return sumOf(slot.data.stickersOwned)
  }

  function refresh() {
    activeIndex.value = usedSlot()
    const list : Slot[] = []
    for (let i = 1; i <= SLOT_COUNT; i++) {
      const slot : Slot = {
        index: i,
        data: loadOne(i)
      }
      list.push(slot)
    }
    slots.value = list
  }

  function useSlot(index : number) {
    pickSlot(index)
    refresh()
    uni.showToast({
      icon: 'none',
      title: '已切换到' + gameName.value + '存档 ' + index
    })
  }

  function createSlot(index : number) {
    makeSlot(index)
    pickSlot(index)
    refresh()
    uni.showToast({
      icon: 'none',
      title: '已创建' + gameName.value + '存档 ' + index
    })
  }

  function removeSlot(index : number) {
    uni.showModal({
      title: '删除' + gameName.value + '存档',
      content: gameName.value + '存档 ' + index + ' 的进度会全部清空，确定删除？',
      success: (res) => {
        if (res.confirm) {
          dropSlot(index)
          refresh()
        }
      }
    })
  }

  // 两个上游（钓鱼主页、排竿入口页）都能推它进来，所以补一道栈兜底 ——
  // 栈里只剩这一页的时候 navigateBack 是空操作，按了没反应
  function goBack() {
    if (getCurrentPages().length > 1) {
      uni.navigateBack()
      return
    }
    uni.redirectTo({
      url: '/pages/examples/blackjack/menu'
    })
  }

  onLoad((options : OnLoadOptions) => {
    // 漏传就按钓鱼走。传错传漏都看得见 —— 标题、说明、弹窗都印着玩法名
    const scope = options['scope']
    isRelay.value = scope != null && ('' + scope) == 'relay'
    refresh()
  })

  onShow(() => {
    refresh()
  })

  // **这儿原来有一句裸 refresh()，删掉了。**
  // 它跑在 onLoad 之前，scope 还没读进来，于是 scope=relay 时首帧
  // 会按钓鱼读一遍三个槽 —— 摆出来的是另一个游戏的档。
  // onLoad 必定在 onShow 之前跑，两处都调了 refresh，首帧不会空
</script>

<style>
  .page {
    flex: 1;
    padding: 14px;
    background-color: #0b5d3b;
  }

  .page-title {
    color: #ffffff;
    font-size: 20px;
    font-weight: bold;
  }

  .page-desc {
    color: #9fd9bd;
    font-size: 12px;
    margin-top: 4px;
  }

  .slots {
    flex: 1;
    margin-top: 10px;
  }

  .slot {
    background-color: #084730;
    border-radius: 10px;
    padding: 10px 12px;
    margin-top: 10px;
    border-width: 1px;
    border-style: solid;
    border-color: #084730;
  }

  .slot-current {
    border-color: #e8b23a;
  }

  .slot-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .slot-name {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
  }

  .slot-badge {
    color: #e8b23a;
    font-size: 12px;
  }

  .slot-info {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  .slot-text {
    color: #cfeade;
    font-size: 12px;
    margin-right: 12px;
  }

  .slot-empty {
    color: #8fc7ab;
    font-size: 12px;
    margin-top: 4px;
  }

  .slot-actions {
    flex-direction: row;
    margin-top: 8px;
  }

  .slot-btn {
    height: 32px;
    border-radius: 16px;
    padding: 0 18px;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
    background-color: #0e6b45;
  }

  .slot-btn-primary {
    background-color: #e8b23a;
  }

  .slot-btn-danger {
    background-color: #8c2f2a;
  }

  .slot-btn-text {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
  }

  .slot-btn-text-dark {
    color: #3b2a00;
  }

  .back-btn {
    height: 44px;
    border-radius: 22px;
    align-items: center;
    justify-content: center;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .back-text {
    color: #e8b23a;
    font-size: 15px;
    font-weight: bold;
  }
</style>
