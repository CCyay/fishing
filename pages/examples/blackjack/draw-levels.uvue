<template>
  <view class="page">
    <!-- 这儿不报金币：钱只在商店里花得出去，而商店只在过关那一下进得去
         （结算框上那颗「去商店」）。在关卡页摆个花不掉的数，
         除了让人惦记没别的用 -->
    <view class="head">
      <view>
        <text class="title">摸打钓鱼</text>
        <text id="md-slot-name" class="sub">{{ save.label }} · 最远 {{ save.best }}/{{ DRAW_RUN_LENGTH }}</text>
      </view>
    </view>

    <!-- 本轮进度。原先底下还有一行规则提示（输一次从头来、这关掉技能的
         概率多少），删了 —— 那两条打过一轮就记住了，而它每次进这一页
         都在重复一遍 -->
    <view class="run-box">
      <text id="md-run" class="run-text">{{ runText }}</text>
    </view>

    <!-- 整轮打通了才在这儿给一颗按钮（重开一轮）。
         没打通的时候不摆 —— 开打的入口就是下面那张关卡卡片本身，
         同一件事没必要摆两个按钮 -->
    <view v-if="allCleared" id="md-go" class="go-btn" @click="go">
      <text class="go-text">再来一轮</text>
    </view>

    <!-- 这一排没有「商店」：**商店只在过关那一下进得去** ——
         打赢一关，结算框上会冒出「去商店」。
         从关卡页随时能进的话，「这一关赚的钱怎么花」就不再是
         一个跟着那一关走的决定了（排竿那边同样是打赢才开店） -->
    <view class="top-actions">
      <!-- 技能：看自己带着什么。商店进不去的时候这是唯一的查看口 ——
           「我带着什么」是决定开不开打的依据，不该只有商店里看得见 -->
      <view id="md-open-skills" class="top-btn" @click="openSkills">
        <text class="top-btn-text">技能</text>
      </view>
      <!-- 角色图鉴：全表都列，**双方共用这一个池子** ——
           你在终局选的是它们，庄家摇到的也是它们。
           所以这一页既是「我能挑谁」，也是「对面可能是谁」 -->
      <view id="md-open-roles" class="top-btn" @click="showRoles = true">
        <text class="top-btn-text">角色</text>
      </view>
      <!-- 这儿原先还有颗「终局」。去掉了 —— 终局自己有一张牌子
           （下面那张，带「开启挑战」和「选角色」），
           同一个入口没必要摆两处 -->
      <view id="md-open-rules" class="top-btn" @click="showRules = true">
        <text class="top-btn-text">规则</text>
      </view>
      <view id="md-open-saves" class="top-btn" @click="showSaves = true">
        <text class="top-btn-text">存档</text>
      </view>
    </view>

    <!-- 两张牌子：这一关，和终局。各自带自己的按钮。
         **庄家带什么不在这儿说** —— 那是你上了桌才该知道的事
         （对局页顶上横着摆出来）。预先摊开的话，这一页就变成了
         一张作业表：照着它配装、算清楚再上桌，而那恰好把
         「上桌之后才发现它这手有讲究」这件事给删了 -->
    <scroll-view class="levels sv-out" direction="vertical">
      <view v-if="!allCleared" class="card">
        <view class="card-head">
          <text class="now-id">第 {{ level.id }} 关</text>
          <text class="now-name">{{ level.chapter }} · {{ level.name }}</text>
          <text class="now-reward">过关 {{ level.reward }} 金</text>
        </view>

        <!-- 进度：十二个点，过了的实心、正打的亮着、后面的空着。
             摆在这张牌子里 —— 它说的就是这张牌子上那个关号的来历。
             **不摆成十二个格子**：摆成格子就像能点，可这一轮只打得了
             当前这一关（输一次从头来），十二格里十一格是死的。
             这条原则是排竿那边先立的 -->
        <view class="dots">
          <view
            v-for="one in dots"
            :key="'dot-' + one"
            class="dot"
            :class="{ 'dot-done': one < save.runLevel, 'dot-now': one == save.runLevel }"></view>
        </view>
        <text id="md-run-meta" class="run-meta">{{ runMeta }}</text>

        <!-- 这一轮你是谁。**摆在难度上面** —— 它是比难度更靠前的前提：
             难度定这一关多难，角色定这一整轮你往哪儿走。
             还没选的时候这一行不在（那时候点开启挑战就是去选） -->
        <text v-if="myRoleLine != ''" id="md-my-role" class="my-role">{{ myRoleLine }}</text>

        <!-- 难度：开打前选。一轮开始了（过了第 1 关或者卡在商店）就锁住，
             输了 / 放弃之后才能换 -->
        <view class="diff-row">
          <text class="diff-label">难度</text>
          <view
            v-for="(name, di) in DIFF_NAMES"
            :key="'df-' + di"
            :id="'md-diff-' + di"
            class="diff-btn"
            :class="{ 'diff-on': di == diff, 'diff-locked': !canPickDiff && di != diff }"
            @click="pickDiff(di)">
            <text class="diff-text" :class="{ 'diff-text-on': di == diff }">{{ name }}</text>
          </view>
        </view>
        <text class="diff-note">{{ diffNote }}</text>

        <view class="card-acts">
          <view id="md-now" class="card-btn card-btn-main" @click="go">
            <text class="card-btn-text card-btn-text-dark">开启挑战</text>
          </view>
          <!-- 放弃：本轮作废，从第 1 关重来。摆在开打旁边是有意的 ——
               打不过去的时候，「推倒重来」是个正当选择，不该藏起来 -->
          <view id="md-give-up" class="card-btn" @click="askGiveUp">
            <text class="card-btn-text">放弃挑战</text>
          </view>
        </view>
      </view>

      <!-- 终局。跟上面那张一个样式，但它不在那条十二关的线上 -->
      <view class="card card-final">
        <view class="card-head">
          <text class="now-id">终局对决</text>
          <!-- 空着撑开，把右边那个标签推到头 —— 这张牌子没有章节名可写 -->
          <view class="card-head-gap"></view>
          <text class="now-reward">不记账</text>
        </view>
        <!-- 只留口号。机制那段（随机满配、不记账、不推关号……）删了 ——
             「不记账」右上角那个标签已经点出来了，剩下的上桌自然知道 -->
        <text class="card-slogan">使出你的全力向王座发起挑战</text>
        <!-- 终局难度摆在牌子上，直接开打也按它来。
             跟角色面板里那一排是同一个值（finalDiff），哪边改都一样 -->
        <view class="diff-row">
          <text class="diff-label">难度</text>
          <view
            v-for="(name, di) in DIFF_NAMES"
            :key="'fc-' + di"
            :id="'md-final-card-diff-' + di"
            class="diff-btn"
            :class="{ 'diff-on': di == finalDiff }"
            @click="pickFinalDiff(di)">
            <text class="diff-text" :class="{ 'diff-text-on': di == finalDiff }">{{ name }}</text>
          </view>
        </view>
        <text class="diff-note">{{ finalDiffNote }}</text>
        <view class="card-acts">
          <view id="md-final" class="card-btn card-btn-main" @click="goFinal">
            <text class="card-btn-text card-btn-text-dark">开启挑战</text>
          </view>
          <!-- 这个弹层跟闯关的角色选择共用，所以得指明是哪个模式
               （终局三步走到底，闯关只走第一步 —— 见 roleMode） -->
          <view id="md-custom" class="card-btn" @click="openFinalRole">
            <text class="card-btn-text">自定义技能</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- ---------- 终局：选角色卡 + 往槽里嵌技能 ---------- -->
    <!--
      这是**实体卡那套结构**（设计文档第十三节）：先挑一张角色卡，
      它上面印着几个槽（有的印数字、有的印花色），再从技能池里
      给每个槽嵌一张技能。

      跟从前那个「自定义技能」的区别在**约束**：那边是在一张全表上
      自由勾选 + 调等级（于是只有一个最优解，在商店里算半天），
      这边是「四个印死的槽，哪件技能配哪个数字」—— 一道组合题。

      两步走：先选角色（roleAt < 0 时显示角色列表），
      选完显示那几个槽，点一个槽再挑技能。

      **闯关也走这个弹层，但只走第一步**（roleMode == 'run'）：
      选完角色当场开打，槽是空的 —— 技能得在商店买来一件件嵌。
      共用的理由是「选角色」这件事两边一模一样，差的只是选完干什么
    -->
    <view v-if="showCustom" class="mask" @click="closeFinal">
      <view class="skill-box" @click.stop="noop">
        <view class="skill-box-head">
          <text id="md-role-title" class="skill-box-title">{{ roleAt < 0 ? (roleMode == 'run' ? '这一轮用谁' : '选一张角色卡') : DRAW_ROLES[roleAt].name }}</text>
          <text class="skill-box-sub">{{ roleAt < 0 ? DRAW_ROLES.length + ' 个' : '盖住 ' + roleCover(roleAt) + ' 张牌' }}</text>
        </view>

        <!-- 第一步：角色列表。卡片跟「角色」图鉴那边同一个样子：
             名字 + 特殊技 + 覆盖张数（锁着的换成门槛），下面是槽、特殊技效果 -->
        <scroll-view v-if="roleAt < 0" class="skill-box-body sv-out" direction="vertical">
          <view
            v-for="(role, ri) in DRAW_ROLES"
            :key="'rl-' + ri"
            :id="'md-role-' + ri"
            class="my-skill"
            :class="{ 'my-skill-off': !roleOpen(ri) }"
            @click="tapRole(ri)">
            <view class="my-skill-head">
              <text class="my-skill-name">{{ role.name }}</text>
              <text class="my-skill-key">{{ specialNameOf(ri) }}</text>
              <view class="my-skill-gap"></view>
              <text class="my-skill-cover">{{ roleOpen(ri) ? roleCover(ri) + ' 张' : roleLock(ri) }}</text>
            </view>
            <text class="my-skill-level">槽：{{ slotsText(ri) }}</text>
            <text class="my-skill-desc">{{ specialDescOf(ri) }}</text>
          </view>
        </scroll-view>

        <!-- 第二步：那几个槽。点一个槽进技能列表 -->
        <scroll-view v-else-if="slotPick < 0" class="skill-box-body sv-out" direction="vertical">
          <text class="skill-box-empty">{{ specialNameOf(roleAt) }}（常驻）：{{ specialDescOf(roleAt) }}</text>
          <!-- 终局自己的难度，**跟闯关那档分开记**（不写存档）——
               终局是不记账的沙盒：你可能想用简单试一套配装、
               再用困难拿同一套挑战。绑死在闯关那档上就没法分开玩了 -->
          <view class="diff-row">
            <text class="diff-label">难度</text>
            <view
              v-for="(name, di) in DIFF_NAMES"
              :key="'fd-' + di"
              :id="'md-final-diff-' + di"
              class="diff-btn"
              :class="{ 'diff-on': di == finalDiff }"
              @click="pickFinalDiff(di)">
              <text class="diff-text" :class="{ 'diff-text-on': di == finalDiff }">{{ name }}</text>
            </view>
          </view>
          <text class="diff-note">{{ finalDiffNote }}</text>
          <view
            v-for="(label, si) in DRAW_ROLES[roleAt].slots"
            :key="'sl-' + si"
            :id="'md-slot-' + si"
            class="my-skill"
            :class="{ 'my-skill-on': slotSkills[si] >= 0 }"
            @click="slotPick = si">
            <view class="my-skill-head">
              <text class="my-skill-cover">{{ slotCover(label) }} 张</text>
              <text class="my-skill-name">{{ label }}</text>
              <view class="my-skill-gap"></view>
              <text class="my-skill-pick">{{ slotSkills[si] >= 0 ? DRAW_SKILLS[slotSkills[si]].name : '空着，点一下嵌技能' }}</text>
            </view>
            <text v-if="slotSkills[si] >= 0" class="my-skill-desc">{{ DRAW_SKILLS[slotSkills[si]].desc }}</text>
            <text v-else class="my-skill-desc">{{ slotHint(label) }}</text>
          </view>
          <text class="skill-box-empty">{{ doubleHint }}</text>
        </scroll-view>

        <!-- 第三步：给这个槽挑技能 -->
        <scroll-view v-else class="skill-box-body sv-out" direction="vertical">
          <text class="skill-box-empty">嵌进 {{ DRAW_ROLES[roleAt].slots[slotPick] }} 槽（已嵌的会被换掉）</text>
          <view
            v-for="(skill, k) in DRAW_SKILLS"
            :key="'ps-' + k"
            :id="'md-pickskill-' + k"
            class="my-skill"
            :class="{ 'my-skill-on': slotSkills[slotPick] == k, 'my-skill-off': usedElsewhere(k) }"
            @click="embed(k)">
            <view class="my-skill-head">
              <text class="my-skill-name">{{ skill.name }}</text>
              <text v-if="skill.first" class="my-skill-key">{{ KEYWORD_FIRST }}</text>
              <view class="my-skill-gap"></view>
              <text class="my-skill-cover">{{ usedElsewhere(k) ? '已嵌在别的槽' : '' }}</text>
            </view>
            <text class="my-skill-desc">{{ skill.desc }}</text>
          </view>
        </scroll-view>

        <view class="card-acts">
          <view v-if="roleAt >= 0 && slotPick < 0" id="md-final-go" class="card-btn card-btn-main" @click="goFinalRole">
            <text class="card-btn-text card-btn-text-dark">{{ embedCount > 0 ? '开打' : '空着手开打' }}</text>
          </view>
          <view v-if="slotPick >= 0" class="card-btn card-btn-main" @click="clearSlot">
            <text class="card-btn-text card-btn-text-dark">清空这个槽</text>
          </view>
          <view class="card-btn" @click="backFinal">
            <text class="card-btn-text">{{ slotPick >= 0 ? '回到槽位' : (roleAt >= 0 ? '换角色' : '关闭') }}</text>
          </view>
        </view>
      </view>
    </view>


    <!-- ---------- 角色图鉴 ---------- -->
    <!--
      全表都列，只读。**双方共用这一个池子**：你在终局挑的是它们，
      庄家摇到的也是它们 —— 所以这一页既回答「我能挑谁」，
      也回答「对面可能是谁」。

      每个角色要报三样，缺一样就看不出它的性格：
        **槽** —— 几个、各管什么（花色槽 12 张 —— J 不触发技能、数字槽一格 4 张）；
        **特殊技** —— 常驻那件，三档效果都列出来；
        **覆盖面** —— 八个角色唯一能横着比的那个数
    -->
    <view v-if="showRoles" class="mask" @click="showRoles = false">
      <view class="skill-box" @click.stop="noop">
        <view class="skill-box-head">
          <text class="skill-box-title">角色</text>
          <text class="skill-box-sub">{{ DRAW_ROLES.length }} 个 · 你和庄家共用</text>
        </view>
        <!-- 卡片跟选角色那一步同一个样子（见 showCustom 的第一步） -->
        <scroll-view class="skill-box-body sv-out" direction="vertical">
          <view
            v-for="(role, ri) in DRAW_ROLES"
            :key="'rb-' + ri"
            :id="'md-rolebook-' + ri"
            class="my-skill">
            <view class="my-skill-head">
              <text class="my-skill-name">{{ role.name }}</text>
              <text class="my-skill-key">{{ specialNameOf(ri) }}</text>
              <view class="my-skill-gap"></view>
              <text class="my-skill-cover">{{ roleCover(ri) }} 张</text>
            </view>
            <!-- 槽一行：「6 7（8 张） / 8 9（8 张）」—— 斜杠分槽，
                 括号里是这个槽盖住多少张牌 -->
            <text class="my-skill-level">槽：{{ slotsText(ri) }}</text>
            <text class="my-skill-desc">{{ specialDescOf(ri) }}</text>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- 技能图鉴：**全表都列**，嵌在槽里的描亮并标出落在哪个槽。
         只读 —— 买、卖都在商店里，而商店只在过关那一下进得去。
         标签是角色卡印死的，所以这儿不存在「摆到哪儿」，只报「嵌在哪个槽」 -->
    <view v-if="showSkills" class="mask" @click="closeSkills">
      <view class="skill-box" @click.stop="noop">
        <view class="skill-box-head">
          <!-- 抬头写**角色名**而不是「技能」—— 这一栏问的是「我带着什么」，
               而那句话的主语是角色。没选角色就退回「技能」 -->
          <text class="skill-box-title">技能</text>
          <!-- 查询框有字的时候这儿报**匹配到几件**，不报总数 ——
               筛着的时候「共 N 种」是句废话，而「匹配 3 件」正好是
               你刚敲完那个词想知道的事 -->
          <text class="skill-box-sub"
            >{{ query == '' ? '共 ' + DRAW_SKILLS.length + ' 种' : '匹配 ' + mySkills.length + ' 件' }}</text
          >
        </view>
        <!-- 那件常驻特殊技。它不占槽，所以下面那张按槽列的表里没有它 ——
             不单独报一句的话它就彻底看不见了 -->

        <!-- 查询框。原先这儿是一段讲规则的说明（技能在哪买、怎么嵌槽、
             槽满了会换掉里头那件）。换掉的理由是**这一栏要解决的是查找**：
             全表三十来件，而弹层一屏放得下三四件，所以翻到底要滑七八次。
             那段规则你在商店里买第一件时就学会了，摆在这儿每次开都看一遍。

             匹配**名字和效果说明**两样 —— 想找「能压到堆底的有哪些」时，
             记得住效果记不住名字才是常态（照 shop.uvue 那个查贴纸的框） -->
        <view class="search">
          <input
            id="md-skill-search"
            class="search-input"
            type="text"
            confirm-type="search"
            placeholder="查技能：名字或效果，如「堆底」「花色」"
            placeholder-class="search-hint"
            v-model="query" />
          <text v-if="query != ''" id="md-skill-search-clear" class="search-clear" @click="clearQuery"
            >清空</text
          >
        </view>
        <!-- 一件都没匹配上得给句话，不然列表空着没交代。
             **单独一个 id** —— .skill-box-empty 这个类上面那行角色也在用，
             按类取会取到角色那行 -->
        <text
          v-if="query != '' && mySkills.length == 0"
          id="md-skill-none"
          class="skill-box-empty"
          >没有匹配「{{ query }}」的技能</text
        >
        <scroll-view class="skill-box-body sv-out" direction="vertical">
          <!-- key 用**技能下标**不用数组下标 —— 查询框一筛数组就重排了
               （见 MySkill.skill 那段） -->
          <view
            v-for="one in mySkills"
            :key="'ms-' + one.skill"
            :id="'md-skill-' + one.skill"
            class="my-skill"
            :class="{ 'my-skill-off': !one.owned }">
            <view class="my-skill-head">
              <text class="my-skill-cover">{{ one.cover }}</text>
              <text class="my-skill-name">{{ one.name }}</text>
              <!-- 「优先」关键字：效果在钓牌判定之前结算 -->
              <text v-if="one.first" class="my-skill-key">{{ KEYWORD_FIRST }}</text>
              <text class="my-skill-level">{{ one.level }}</text>
            </view>
            <text class="my-skill-desc">{{ one.desc }}</text>
          </view>
        </scroll-view>
        <text class="skill-box-close" @click.stop="closeSkills">收起来</text>
      </view>
    </view>

    <!-- 规则：现行规则一页说清。改规则的时候这儿要跟着改（见 RULES） -->
    <view v-if="showRules" class="mask" @click="showRules = false">
      <view class="skill-box" @click.stop="noop">
        <view class="skill-box-head">
          <text class="skill-box-title">规则</text>
        </view>
        <scroll-view class="skill-box-body sv-out" direction="vertical">
          <view v-for="(sec, ri) in RULES" :key="'rule-' + ri" :id="'md-rule-' + ri" class="rule-sec">
            <text class="rule-title">{{ sec.title }}</text>
            <text v-for="(line, li) in sec.lines" :key="'rl-' + ri + '-' + li" class="rule-line">{{ line }}</text>
          </view>
        </scroll-view>
        <text class="skill-box-close" @click.stop="showRules = false">收起来</text>
      </view>
    </view>

    <!-- 存档：三个槽，切换 / 新建 / 删除 -->
    <view v-if="showSaves" class="mask">
      <view class="save-box">
        <text class="save-title">摸打钓鱼存档</text>
        <view v-for="slot in slots" :key="'sv-' + slot.index" class="save-slot" :class="{ 'save-slot-current': slot.index == slotIndex }">
          <view class="save-info">
            <text class="save-name">{{ slot.data.exists ? slot.data.label : '空存档' }}</text>
            <text class="save-meta">{{ slot.data.exists ? '最远 ' + slot.data.best + ' · 本轮第 ' + Math.min(slot.data.runLevel, DRAW_RUN_LENGTH) + ' 关' : '槽位 ' + slot.index }}</text>
          </view>
          <view class="save-btn" @click="useSlot(slot.index)">
            <text class="save-btn-text">{{ slot.data.exists ? (slot.index == slotIndex ? '使用中' : '使用') : '新建' }}</text>
          </view>
          <view v-if="slot.data.exists" :id="'md-del-' + slot.index" class="save-btn save-btn-danger" @click="removeSlot(slot.index)">
            <text class="save-btn-text">删除</text>
          </view>
        </view>
        <text class="save-close" @click="showSaves = false">关闭</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    DrawLevel,
    drawLevelById,
    levelForDiff,
    DIFF_NAMES,
    maxLivesOf,
    DIFF_EASY,
    DIFF_NORMAL,
    DIFF_HARD
  } from '@/pages/examples/blackjack/draw-levels.uts'
  import {
    DRAW_SKILLS,
    KEYWORD_FIRST,
    // 原先这儿还引着 coverageText（从 loadout 倒推覆盖面）和 levelText
    // （报等级）。两样都没了 —— 标签印在槽上，直接读；等级整个删了
    //
    // 「选角色卡 + 嵌技能」现在闯关和终局**共用**（见 goRole / goFinalRole）
    DRAW_ROLES,
    SPECIAL_SKILLS,
    specialIndexOf,
    isSuitSlot,
    roleCover,
    slotLabels,
    slotCover,
    // 闯关的角色解锁门槛。这三个从前写好了零调用 ——
    // 现在闯关要选角色，它们才有了落点
    roleUnlocked,
    ROLE_UNLOCK,
    ROLE_UNLOCK_CLEAR
  } from '@/pages/examples/blackjack/draw-skills.uts'
  import {
    DrawSave,
    DRAW_SLOT_COUNT,
    DRAW_SAVE_NAME,
    emptyDrawSave,
    loadDrawSave,
    loadDrawAt,
    writeDrawAt,
    clearDrawAt,
    newDrawSave,
    drawSaveSlot,
    setDrawSaveSlot,
    saveDraw,
    resetDrawRun,
    runCleared,
    DRAW_RUN_LENGTH,
    // 槽数就是上限（MAX_OWNED_SKILLS / ownedSkillCount 那套名额删了）
    filledSlots,
    slotLabelAt,
    // 开启挑战先选角色：选完 pickRole 写进存档，hasRole 判断本轮选过没有
    pickRole,
    hasRole,
    difficultyOf,
    setDifficulty,
    runFresh
  } from '@/pages/examples/blackjack/draw-save.uts'

  type SlotView = {
    index : number
    data : DrawSave
  }

  const save = ref<DrawSave>(emptyDrawSave())
  const slotIndex = ref<number>(1)
  const slots = ref<SlotView[]>([])
  const showSaves = ref<boolean>(false)
  const showSkills = ref<boolean>(false)
  // 技能图鉴那个查询框里敲的字。空串就是不过滤。
  // 跟 showSkills 摆在一起 —— 它只服务那一个弹层（筛的逻辑见 matches）
  const query = ref<string>('')

  function clearQuery() {
    query.value = ''
  }

  // 开 / 关技能图鉴。**两头都清查询词** ——
  // 留着的话下次开出来是一张筛过的表，而那看着就是「技能怎么少了」。
  // 开的时候也清一遍：进这个弹层的意图是「看我带着什么」，不是接着上次查
  function openSkills() {
    query.value = ''
    showSkills.value = true
  }

  function closeSkills() {
    query.value = ''
    showSkills.value = false
  }

  // 弹层里面点着不关，交给外面那层遮罩关（跟排竿的道具面板一个路子）
  function noop() {}

  function refresh() {
    save.value = loadDrawSave()
    slotIndex.value = drawSaveSlot()
    diff.value = difficultyOf(slotIndex.value)
    // 终局那档默认跟着闯关的 —— 进来就是你习惯的难度。
    // 手动选过就不再跟（不然打一局回来 onShow 一刷新，选的就被冲掉了）
    if (!finalDiffPicked) {
      finalDiff.value = diff.value
    }
    const list : SlotView[] = []
    for (let i = 1; i <= DRAW_SLOT_COUNT; i++) {
      list.push({ index: i, data: loadDrawAt(i) })
    }
    slots.value = list
  }

  // 进度条那一排点，1 到 12。
  // 摆个数组而不是让 v-for 直接遍历数字 —— 后者在 uvue 那边没把握
  const dots = computed<number[]>(() : number[] => {
    const out : number[] = []
    for (let i = 1; i <= DRAW_RUN_LENGTH; i++) {
      out.push(i)
    }
    return out
  })

  // 这一轮眼下要打的那一关
  // 这一关按难度改过的样子（过关奖励跟着难度走，见 levelForDiff）
  const level = computed<DrawLevel>(() : DrawLevel => {
    return levelForDiff(drawLevelById(save.value.runLevel), diff.value)
  })

  // ---- 难度 ----
  const diff = ref<number>(DIFF_NORMAL)

  const canPickDiff = computed<boolean>(() : boolean => {
    return runFresh(save.value)
  })

  const diffNote = computed<string>(() : string => {
    if (diff.value == DIFF_EASY) {
      return '庄家前 4 关随机出牌、之后不记牌；过关金币 ×1.5'
    }
    if (diff.value == DIFF_HARD) {
      return '庄家每一关都记牌；过关金币 ×0.75'
    }
    return '庄家第 1 关随机出牌、第 3 关起记牌；过关金币 ×1'
  })

  function pickDiff(d : number) {
    if (d == diff.value) {
      return
    }
    if (!canPickDiff.value) {
      uni.showToast({ title: '这一轮已经开打了，输了或放弃后才能换难度', icon: 'none' })
      return
    }
    diff.value = d
    setDifficulty(slotIndex.value, d)
  }

  const allCleared = computed<boolean>(() : boolean => {
    return runCleared(save.value)
  })

  // 技能图鉴：**全表都列**，手里有的把等级和覆盖面标出来。
  //
  // 全列是有理由的：技能在商店买，而**上什么货是摇的** —— 所以
  //「这游戏里一共有哪些技能、各管什么」是你盘算这一轮的底图：
  // 它决定你看见某件货的时候值不值得掏钱，也决定你值不值得攒钱等。
  // 排竿那边的道具图鉴是同一个路子（列全，手里有的标等级）。
  //
  // 管什么排在最前 —— 跟对局页的技能栏一个规矩：你问的是
  //「我这张 7 会触发什么」，所以先给锚点再给名字
  type MySkill = {
    // 它在 DRAW_SKILLS 里的下标。**v-for 的 key 要用它，不能用数组下标**
    // —— 查询框一筛，下标就换了含义（第 0 行不再是表里第 0 件），
    // 用数组下标当 key 等于告诉渲染层「这一行还是原来那一行」。
    //
    // 不叫 at：这个类型里「at」会被读成「嵌在第几个槽」（见下面 level）
    skill : number
    owned : boolean
    cover : string
    name : string
    level : string
    desc : string
    // 带「优先」关键字吗（效果在钓牌判定之前结算）
    first : boolean
  }

  // 查询词匹配**名字和效果说明**两样。
  //
  // 说明也进匹配范围是故意的：三十来件技能里有一半你记得住效果、记不住名字
  //（「那个把牌压到堆底的叫什么」）。key 也匹配 —— 它是英文，
  // 敲得快而且不会跟中文撞（照 shop.uvue 那个查贴纸的框）
  function matches(k : number) : boolean {
    const q = query.value.trim().toLowerCase()
    if (q == '') {
      return true
    }
    const one = DRAW_SKILLS[k]
    if (one.name.toLowerCase().indexOf(q) >= 0) {
      return true
    }
    if (one.desc.toLowerCase().indexOf(q) >= 0) {
      return true
    }
    return one.key.toLowerCase().indexOf(q) >= 0
  }

  // 技能图鉴：**跟这一轮无关**，全表一视同仁地列（名字、价钱、效果）。
  // 这一轮带着什么、装在哪，去「技能库」看（商店页的只管理模式）。
  //
  // 查询框有字的时候筛一道 —— **筛在这儿不在模板里**：
  // 「匹配到几件」那句提示读的是 mySkills.length，筛在模板里它就永远是 29
  const mySkills = computed<MySkill[]>(() : MySkill[] => {
    const out : MySkill[] = []
    for (let k = 0; k < DRAW_SKILLS.length; k++) {
      if (!matches(k)) {
        continue
      }
      out.push({
        skill: k,
        owned: true,
        cover: DRAW_SKILLS[k].unlock + ' 金币',
        name: DRAW_SKILLS[k].name,
        level: '',
        desc: DRAW_SKILLS[k].desc,
        first: DRAW_SKILLS[k].first
      } as MySkill)
    }
    // 按价格从低到高；同价的照技能表的先后
    out.sort((x : MySkill, y : MySkill) : number => {
      const d = DRAW_SKILLS[x.skill].unlock - DRAW_SKILLS[y.skill].unlock
      return d != 0 ? d : x.skill - y.skill
    })
    return out
  })


  // 这一轮的角色有几个槽、嵌了几件（弹层抬头报「槽 N/M」）
  const slotCount = computed<number>(() : number => {
    return save.value.slotSkills.length
  })

  const usedSlots = computed<number>(() : number => {
    return filledSlots(save.value)
  })

  // 这一轮你是谁：角色名 · 特殊技 · 几个槽管多少张。
  //
  // **这一行以前压根不存在**，而角色是这一轮所有决策的前提
  //（买什么技能、往哪个点数改牌组全看槽上印着什么）。
  // 关卡页从前只报关号、难度、奖励 —— 于是选完角色进去打一局回来，
  // 你就看不见自己选了谁了。商店里有这一行，可商店只在过关那一下进得去
  const myRoleLine = computed<string>(() : string => {
    const r = save.value.role
    if (r < 0 || r >= DRAW_ROLES.length) {
      return ''
    }
    const at = specialIndexOf(DRAW_ROLES[r].special)
    return DRAW_ROLES[r].name
      + (at < 0 ? '' : ' · ' + SPECIAL_SKILLS[at].name)
      + ' · 槽 ' + usedSlots.value + '/' + slotCount.value
      + '（盖 ' + roleCover(r) + ' 张）'
  })

  // 原先这儿有 foeLines（庄家带了哪几个技能）和 nextName（往后是第几关），
  // 两样都删了。
  //
  // 庄家那几个技能**不该在上桌前给**：那是对局页顶上横着摆的东西。
  // 预先摊开，这一页就成了一张作业表 —— 照着配装、算清楚再上桌，
  // 而那恰好把「上桌之后才发现它这手有讲究」这件事删掉了。
  // 下一关的名字同理：知道叫什么没用，到了自然看得见

  const runText = computed<string>(() : string => {
    const data = save.value
    if (runCleared(data)) {
      return '本轮 12 关全部通关！'
    }
    return '本轮第 ' + data.runLevel + ' 关'
  })

  // 原先这儿有个 dropText（「输一次从头来 · 这关掉技能的概率 N%」）。
  // 整条删了 —— 那两件事打过一轮就记住了，而它每次进这一页都重复一遍。
  // 技能名额那句话也不缺地方说：技能弹层的副标题上写着「你有 N/4」

  // 原先这儿有个 goText（那颗大按钮上的字）。按钮没了 ——
  // 未通关时开打的入口是关卡卡片本身，通关时那颗按钮的字写死「再来一轮」

  function go() {
    if (runCleared(save.value)) {
      const data = loadDrawSave()
      resetDrawRun(data)
      saveDraw(data)
      refresh()
      return
    }
    // 上次是从商店退出来的：先回商店，在那儿点「开始下一关」才开打
    if (loadDrawSave().inShop) {
      uni.navigateTo({ url: '/pages/examples/blackjack/draw-skills' })
      return
    }
    // **这一轮还没选角色：先选**。
    //
    // 角色给的是那件常驻特殊技（整轮都在，不占槽）和那几个印死的槽，
    // 所以它是这一轮所有决策的前提 —— 买什么技能、往哪个点数改牌组，
    // 全看槽上印着什么。开打之后再选就全错位了。
    //
    // resetDrawRun 会清掉 role（输了重开要重选），所以每一轮都走一次
    if (!hasRole(save.value)) {
      roleMode.value = 'run'
      roleAt.value = -1
      slotSkills.value = [] as number[]
      slotPick.value = -1
      showCustom.value = true
      return
    }
    uni.navigateTo({ url: '/pages/examples/blackjack/ap-fishing' })
  }

  // 原先这儿有个 openSkills（随时进商店），删了 ——
  // 商店只在打赢一关的结算框上进得去

  // 放弃这一轮：跟打输了一个下场 —— 技能、金币全清，从第 1 关重来。
  // 问一句再动手
  function askGiveUp() {
    uni.showModal({
      title: '放弃这一轮？',
      content: '本轮作废，技能和金币清空，从第 1 关重来。最远纪录留着。',
      confirmText: '放弃',
      cancelText: '再打打',
      success: (res) => {
        if (res.confirm) {
          const data = loadDrawSave()
          resetDrawRun(data)
          saveDraw(data)
          refresh()
        }
      }
    })
  }

  // 原先这儿有一套自定义终局配装的东西（openCustom / customCount /
  // toggleCustom / bumpCustom，加上 goFinal 的 custom 分支）。整套删了。
  //
  // 理由是它跟这个玩法的主题对着干：货架上货什么是摇的、位置摇定、
  // 升级要等货架上出砺钩 —— 一路都在说「适应摇出来的东西」，
  // 而自定义配装是「先想好再执行」。开了这个口子，那条规矩就只剩
  // 正常模式在守，而终局本该是它最纯粹的样子：两边都顶配，比的是用法

  // 终局模式：一局定胜负，**一个字都不写存档** ——
  // 不推关号、不发金币、输了也不清家当。
  //
  // 正常模式里一局的分量很重（输一次十二关白打），所以人会保守地打；
  // 终局不记账，于是你敢拿任何疯招去试。它卖的就是这个
  function goFinal() {
    uni.navigateTo({ url: '/pages/examples/blackjack/ap-fishing?mode=final&diff=' + finalDiff.value })
  }

  // ---------- 终局：选角色卡 + 嵌技能 ----------
  //
  // 三步：选角色 → 看槽 → 给槽挑技能。只活在这一页（终局不记账，
  // 配装也不进存档），通过 URL 参数捎给对局页。
  //
  // 从前这儿是「自定义技能」（全表自由勾选 + 调等级）。换掉的理由是
  // **约束才有题**：自由勾选只有一个最优解，而「四个印死的槽，
  // 哪件技能配哪个数字」是一道组合题 —— 磁钩插在连号的槽上，
  // 它的 +1 能钓到自己的下一个槽；插在散号上那条链就断了
  const showCustom = ref<boolean>(false)
  // 选中的角色（DRAW_ROLES 下标），-1 = 还没选
  const roleAt = ref<number>(-1)
  // 正在给第几个槽挑技能，-1 = 不在挑
  const slotPick = ref<number>(-1)
  // 每个槽嵌了哪件技能（DRAW_SKILLS 下标），-1 = 空着。跟角色的 slots 一一对应
  const slotSkills = ref<number[]>([] as number[])

  // 这个弹层**两个模式共用**：
  //
  // - 'final'（终局）：选角色 → 看槽 → 给槽挑技能，三步走。
  //   终局是顶配沙盒，所以技能直接给你挑；
  // - 'run'（闯关）：**只有第一步**。选完角色就开打，
  //   槽是空的 —— 技能要在商店里一件一件买来嵌。
  //
  // 两者的区别就是这个玩法的主线：终局比的是「这套配装好不好」，
  // 闯关比的是「摇出来的东西你怎么用」。所以闯关这边
  // 一开始什么都没有，而角色定的是**你往哪个方向攒**
  const roleMode = ref<string>('final')

  // 闯关模式的角色解锁：按最远纪录放（见 draw-skills 的 ROLE_UNLOCK）。
  // 终局不设门槛 —— 它不记账，拦着没意义，而且那是「试配装」的地方
  function roleOpen(ri : number) : boolean {
    if (roleMode.value != 'run') {
      return true
    }
    return roleUnlocked(ri, save.value.best, save.value.best >= DRAW_RUN_LENGTH)
  }

  // 锁着的角色报门槛。报得出具体数字才叫目标，「未解锁」只是一堵墙
  function roleLock(ri : number) : string {
    if (roleOpen(ri)) {
      return ''
    }
    const need = ROLE_UNLOCK[ri]
    return need == ROLE_UNLOCK_CLEAR
      ? '通关一次才解锁'
      : '打到第 ' + need + ' 关才解锁'
  }

  // 点一个角色。终局进第二步（看槽），闯关**当场定下来并开打**
  function tapRole(ri : number) {
    if (!roleOpen(ri)) {
      uni.showToast({ title: roleLock(ri), icon: 'none' })
      return
    }
    if (roleMode.value == 'run') {
      const data = loadDrawSave()
      // 槽在这儿置空（pickRole 干的），所以**这一下必须写存档** ——
      // 不然退出再进能换角色，而角色是这一轮的方向，换了等于白给
      pickRole(data, ri)
      saveDraw(data)
      showCustom.value = false
      refresh()
      uni.navigateTo({ url: '/pages/examples/blackjack/ap-fishing' })
      return
    }
    roleAt.value = ri
    slotPick.value = -1
    const blank : number[] = []
    for (let i = 0; i < DRAW_ROLES[ri].slots.length; i++) {
      blank.push(-1)
    }
    slotSkills.value = blank
  }

  // 这件技能已经嵌在别的槽里了吗 —— **一张卡只有一张**（实体卡那条限制），
  // 所以同一件技能不能嵌两个槽
  function usedElsewhere(k : number) : boolean {
    for (let i = 0; i < slotSkills.value.length; i++) {
      if (i != slotPick.value && slotSkills.value[i] == k) {
        return true
      }
    }
    return false
  }

  function embed(k : number) {
    if (slotPick.value < 0) {
      return
    }
    if (usedElsewhere(k)) {
      uni.showToast({ title: DRAW_SKILLS[k].name + ' 已经嵌在别的槽里了', icon: 'none' })
      return
    }
    const next = slotSkills.value.slice(0)
    next[slotPick.value] = k
    slotSkills.value = next
    slotPick.value = -1
  }

  function clearSlot() {
    if (slotPick.value < 0) {
      return
    }
    const next = slotSkills.value.slice(0)
    next[slotPick.value] = -1
    slotSkills.value = next
    slotPick.value = -1
  }

  const embedCount = computed<number>(() : number => {
    let n = 0
    for (let i = 0; i < slotSkills.value.length; i++) {
      if (slotSkills.value[i] >= 0) {
        n = n + 1
      }
    }
    return n
  })

  // 角色图鉴那个面板开着没有
  const showRoles = ref<boolean>(false)

  // ---- 规则弹窗 ----
  //
  // 写死的文字。规则改了这儿要跟着改 —— 数字（手牌 4 张、生命、技能库上限……）
  // 跟代码里的常量对应：HAND_SIZE（ap-fishing）、DIFF_LIVES / LIBRARY_CAPS / DIFF_REWARD_RATE
  //（draw-levels），利息档位见 interestOf
  type RuleSec = {
    title : string
    lines : string[]
  }
  const showRules = ref<boolean>(false)
  const RULES : RuleSec[] = [
    { title: '对局', lines: [
      '一副 52 张。双方开局各 4 张手牌，庄家先手，轮流每回合打 1 张，回合末补足 4 张。',
      '牌库和双方手牌都空了，积分高的赢。堆里剩下的牌不算分。'
    ] } as RuleSec,
    { title: '出一张牌的顺序', lines: [
      '① 进场：牌落到堆上（沉底的落堆底），先受场上效果影响（压邻、封色、分水……）。',
      '② 发动这张牌的技能：同一张牌有几个效果时，先执行带「优先」的。',
      '③ 匹配：这张牌还在堆上的话，跟堆里同点数的牌对上，就收走从那张到堆顶的整段。收走几张记几分。'
    ] } as RuleSec,
    { title: 'J', lines: [
      'J 只有通吃：堆上有牌时打 J，整堆收走；空堆上打 J 只收走它自己。',
      'J 不触发任何技能；让牌「没有点数」的场上效果也挡不住它通吃。'
    ] } as RuleSec,
    { title: '角色和技能', lines: [
      '每一轮开局选一张角色卡：它带一件常驻特殊技，还有几个印着点数或花色的槽。',
      '技能装进槽才生效：打出的牌落在槽上印的点数或花色上，就触发那个槽里的技能。',
      '技能是通用的，装进哪个槽都行；管哪些牌由槽决定（花色槽 12 张，点数一个 4 张）。'
    ] } as RuleSec,
    { title: '闯关', lines: [
      '一轮 12 关。赢了拿金币（过关奖励 + 胜分，胜分最多 +10），然后进商店。',
      '没花完的钱每关生利息：攒到 30 给 3，之后每 40 给 5，最多 25。',
      '输一关扣 1 点生命，退回上一个商店（金币、技能、货架都是那时的样子）；第 1 关输了就重打。生命用完，这一轮作废，从第 1 关重来。',
      '平局重打这一关，不扣生命。'
    ] } as RuleSec,
    { title: '商店和技能库', lines: [
      '买来的技能先放进技能库，再装进槽。装上、卸下、换槽都不花钱。',
      '技能库满了就买不了技能，得先卖掉一件；卖出拿回买价的一半。',
      '道具买了立刻用；货架可以花钱换一批，价钱翻倍涨。'
    ] } as RuleSec,
    { title: '难度（一轮开始前选）', lines: [
      '简单：庄家前 4 关随机出牌、之后不记牌；过关金币 ×1.5；生命 3；技能库 8 件。',
      '普通：庄家第 1 关随机出牌、第 3 关起记牌；过关金币 ×1；生命 2；技能库 6 件。',
      '困难：庄家每一关都记牌；过关金币 ×0.75（第 1 关保底 80）；生命 1；技能库 5 件。'
    ] } as RuleSec,
    { title: '终局对决', lines: [
      '一局定胜负，不记账：不发金币、不推关号、不动存档。',
      '可以自定义角色和技能，也可以随机。难度只管庄家怎么出牌、配装多满。'
    ] } as RuleSec
  ]

  // 终局那一局的难度。**不写存档** —— 终局是不记账的沙盒，
  // 它的难度也该是一次性的。默认跟着闯关那档（见 refresh），
  // 在角色面板里随时能改
  const finalDiff = ref<number>(DIFF_NORMAL)

  // 卡片上那一行：现有金币 / 生命。生命 0 = 这一轮还没开打，报满的
  const runMeta = computed<string>(() : string => {
    const max = maxLivesOf(diff.value)
    const lives = save.value.lives > 0 ? save.value.lives : max
    return '金币 ' + save.value.gold + ' · 生命 ' + lives + '/' + max
  })
  // 这一页里手动选过终局难度没有（见 refresh）
  let finalDiffPicked : boolean = false

  function pickFinalDiff(d : number) {
    finalDiff.value = d
    finalDiffPicked = true
  }

  // 难度在终局管两件事：庄家怎么出牌、它的槽嵌满没有。
  //
  // 奖励倍率那条在这儿不生效 —— 终局不发金币（它一个字都不写存档）
  const finalDiffNote = computed<string>(() : string => {
    if (finalDiff.value == DIFF_EASY) {
      return '庄家随手出牌，而且只嵌一半的槽'
    }
    if (finalDiff.value == DIFF_HARD) {
      return '庄家记牌、槽全嵌，而且专摇覆盖面最大的角色'
    }
    return '庄家记牌、槽全嵌，角色随机'
  })

  // 槽位一行：「6 7（8 张） / 8 9（8 张）」。
  // 斜杠分**槽**，括号里是这个槽盖住多少张牌 ——
  // 不写张数的话「♥」和「6 7」看着差不多，可实际上一个 13 张一个 8 张
  function slotsText(ri : number) : string {
    const slots = DRAW_ROLES[ri].slots
    let text = ''
    for (let i = 0; i < slots.length; i++) {
      text = text + (text == '' ? '' : ' / ') + slots[i] + '（' + slotCover(slots[i]) + ' 张）'
    }
    return text
  }

  // 这儿原先有个 specialTiersText（把三档效果用 → 连起来）。
  // 特殊技能改成**不能升级**之后只有一句效果，specialDescOf 就够了

  // 空槽上那行说明：这个槽嵌进来的技能会管什么
  function slotHint(slot : string) : string {
    const labels = slotLabels(slot)
    let suits = 0
    let ranks = 0
    for (let i = 0; i < labels.length; i++) {
      if (isSuitSlot(labels[i])) {
        suits = suits + 1
      } else {
        ranks = ranks + 1
      }
    }
    if (suits > 0 && ranks > 0) {
      return '嵌进来的技能同时管这一门花色和那几个点数，一共 ' + slotCover(slot) + ' 张牌'
    }
    if (suits > 0) {
      return '这一门 ' + slotCover(slot) + ' 张牌都会触发嵌进来的技能'
    }
    return ranks > 1
      ? '这 ' + ranks + ' 个点数（共 ' + slotCover(slot) + ' 张）都会触发嵌进来的技能'
      : '这个点数的 4 张牌会触发嵌进来的技能'
  }

  function specialNameOf(ri : number) : string {
    const at = specialIndexOf(DRAW_ROLES[ri].special)
    return at < 0 ? '' : SPECIAL_SKILLS[at].name
  }

  // 那件常驻技能的**初始档**说明（终局不升级，所以只报第 0 档）
  function specialDescOf(ri : number) : string {
    const at = specialIndexOf(DRAW_ROLES[ri].special)
    return at < 0 ? '' : SPECIAL_SKILLS[at].desc
  }

  // 哪些牌会**双触发**（花色槽和数字槽同时命中）—— 开局就该看得见，
  // 那是这个角色的组合点。没有花色槽的角色不存在双触发
  const doubleHint = computed<string>(() : string => {
    if (roleAt.value < 0) {
      return ''
    }
    const slots = DRAW_ROLES[roleAt.value].slots
    const suits : string[] = []
    const ranks : string[] = []
    // 一个槽可能印着好几样，所以要摊到标签这一层数
    for (let i = 0; i < slots.length; i++) {
      const labels = slotLabels(slots[i])
      for (let j = 0; j < labels.length; j++) {
        if (isSuitSlot(labels[j])) {
          suits.push(labels[j])
        } else {
          ranks.push(labels[j])
        }
      }
    }
    if (suits.length == 0 || ranks.length == 0) {
      return '这个角色没有双触发的牌（槽位全是' + (suits.length > 0 ? '花色' : '点数') + '）。'
    }
    let text = ''
    for (let s = 0; s < suits.length; s++) {
      for (let r = 0; r < ranks.length; r++) {
        text = text + (text == '' ? '' : '、') + suits[s] + ranks[r]
      }
    }
    return '双触发：' + text + ' —— 这几张会同时触发两件技能。'
  })

  // 打开终局那套三步配装。roleMode 得在这儿置回来 ——
  // 闯关的角色选择用的是同一个弹层，上一次开的可能是那个
  function openFinalRole() {
    roleMode.value = 'final'
    roleAt.value = -1
    slotSkills.value = [] as number[]
    slotPick.value = -1
    showCustom.value = true
  }

  function closeFinal() {
    showCustom.value = false
    slotPick.value = -1
  }

  // 返回上一步：挑技能 → 回槽位 → 换角色 → 关闭
  function backFinal() {
    if (slotPick.value >= 0) {
      slotPick.value = -1
      return
    }
    if (roleAt.value >= 0) {
      roleAt.value = -1
      slotSkills.value = [] as number[]
      return
    }
    showCustom.value = false
  }

  function goFinalRole() {
    if (roleAt.value < 0) {
      return
    }
    showCustom.value = false
    uni.navigateTo({
      url: '/pages/examples/blackjack/ap-fishing?mode=final'
        + '&role=' + roleAt.value
        + '&slots=' + slotSkills.value.join(',')
        + '&diff=' + finalDiff.value
    })
  }

  function useSlot(index : number) {
    const data = loadDrawAt(index)
    if (!data.exists) {
      writeDrawAt(index, newDrawSave(DRAW_SAVE_NAME + ' ' + index))
    }
    setDrawSaveSlot(index)
    refresh()
  }

  // 正在用的那个档也能删：删完这个槽位直接换成一个全新的空档接着用
  //（refresh 里的 loadDrawSave 发现当前槽没档，会就地新建一个）
  function removeSlot(index : number) {
    uni.showModal({
      title: '删除存档',
      content: '删掉「' + loadDrawAt(index).label + '」？最远纪录和本轮进度都会清空。'
        + (index == slotIndex.value ? '这个槽位会换成一个新档。' : ''),
      confirmText: '删除',
      success: (res) => {
        if (res.confirm) {
          clearDrawAt(index)
          refresh()
        }
      }
    })
  }

  // 从对局、技能页回来都要刷新：金币和通关进度可能变了
  onShow(() => {
    refresh()
  })

  refresh()
</script>

<style>
  .page {
    flex: 1;
    padding: 16px;
    background-color: #0b5d3b;
  }

  .head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .title {
    color: #e8b23a;
    font-size: 24px;
    font-weight: bold;
  }

  .sub {
    color: #9fd9bd;
    font-size: 12px;
    margin-top: 2px;
  }

  .run-box {
    margin-top: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    background-color: #0e3a28;
  }

  .run-text {
    color: #e8b23a;
    font-size: 15px;
    font-weight: bold;
  }

  /* .run-sub（那行规则提示）删了，样式一起 */

  .go-btn {
    height: 46px;
    border-radius: 23px;
    margin-top: 10px;
    align-items: center;
    justify-content: center;
    background-color: #e8b23a;
  }

  .go-text {
    color: #3b2a00;
    font-size: 17px;
    font-weight: bold;
  }

  .top-actions {
    flex-direction: row;
    margin-top: 10px;
  }

  .top-btn {
    flex: 1;
    height: 40px;
    border-radius: 20px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .top-btn-text {
    color: #e8b23a;
    font-size: 15px;
    font-weight: bold;
  }

  /* 进度：一排小点。十二个点占一行，比十二个格子省一屏，
     而且它不像能点的东西 —— 那正是要的 */
  .dots {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 6px;
    background-color: #0e3a28;
    border-width: 1px;
    border-style: solid;
    border-color: #1b8a58;
  }

  .dot-done {
    background-color: #7ce0a3;
    border-color: #7ce0a3;
  }

  /* 正打的那个：金的，而且大一圈 */
  .dot-now {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: #e8b23a;
    border-color: #e8b23a;
  }

  .levels {
    flex: 1;
    margin-top: 12px;
  }

  /* 一张牌子。原先这块地方摆的是十二个关卡格子，
     而那十二格里只有一格点得动 */
  .card {
    padding: 12px;
    margin-bottom: 10px;
    border-radius: 10px;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  /* 终局那张：底色压暗一档，边框也不抢 —— 它不在那条十二关的线上 */
  .card-final {
    background-color: #0e3a28;
    border-color: #1b8a58;
  }

  .card-head {
    flex-direction: row;
    align-items: center;
  }

  /* 没有章节名可写的牌子，拿它把右边那个标签推到头 */
  .card-head-gap {
    flex: 1;
  }

  /* 口号那一行。比机制说明亮一档 —— 它是这张牌子的脸面，
     底下那行小字才是规则 */
  .card-slogan {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
    margin-top: 10px;
  }

  /* .card-note（牌子上那段机制说明）用完就没了，样式一起删 */

  /* 牌子底下那排按钮：主按钮金底，次的只描边 */
  .rule-sec {
    margin-bottom: 12px;
  }

  .rule-title {
    color: #e8b23a;
    font-size: 14px;
    font-weight: bold;
    margin-bottom: 4px;
  }

  .rule-line {
    color: #e6f4ec;
    font-size: 12px;
    line-height: 19px;
    margin-top: 2px;
  }

  .run-meta {
    color: #ff9e80;
    font-size: 12px;
    margin-top: 8px;
  }

  .card-acts {
    flex-direction: row;
    margin-top: 12px;
  }

  /* 难度：三颗小胶囊，选中的填金 */
  .diff-row {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
  }

  .diff-label {
    color: #9fd9bd;
    font-size: 12px;
    margin-right: 8px;
  }

  .diff-btn {
    height: 26px;
    padding: 0 14px;
    margin-right: 6px;
    border-radius: 13px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .diff-on {
    background-color: #e8b23a;
  }

  /* 一轮开打之后没选中的那两颗压暗：点得到（会提示为什么不能换），但看着就是锁着的 */
  .diff-locked {
    opacity: 0.35;
  }

  .diff-text {
    color: #e8b23a;
    font-size: 12px;
  }

  .diff-text-on {
    color: #3b2a00;
    font-weight: bold;
  }

  .diff-note {
    color: #9fd9bd;
    font-size: 11px;
    margin-top: 6px;
  }

  /* 这一轮的角色。金色 + 左边一条竖杠 —— 跟难度那一行（淡绿）
     分得开：那是这一关的设置，这是整轮的身份 */
  .my-role {
    color: #e8b23a;
    font-size: 12px;
    font-weight: bold;
    margin-top: 8px;
    padding-left: 8px;
    border-left-width: 3px;
    border-left-style: solid;
    border-left-color: #e8b23a;
  }

  .card-btn {
    flex: 1;
    height: 40px;
    border-radius: 20px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .card-btn-main {
    background-color: #e8b23a;
  }

  .card-btn-text {
    color: #e8b23a;
    font-size: 14px;
    font-weight: bold;
  }

  .card-btn-text-dark {
    color: #3b2a00;
  }

  .now-id {
    color: #e8b23a;
    font-size: 18px;
    font-weight: bold;
    margin-right: 8px;
  }

  .now-name {
    flex: 1;
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
  }

  .now-reward {
    color: #fff3c4;
    font-size: 12px;
  }

  /* 原先这张牌子里还列着庄家带的技能（.now-label / .now-foe / .now-skill），
     底下还有一块「往后是第 N 关」（.next-box / .next-text），
     以及一行「开启挑战」的提示字（.now-go）。
     全删了 —— 庄家带什么是上了桌才该知道的事，而开打现在是颗真按钮 */

  /* 技能面板 */
  .skill-box {
    width: 300px;
    padding: 16px;
    border-radius: 12px;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .skill-box-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .skill-box-title {
    color: #e8b23a;
    font-size: 16px;
    font-weight: bold;
  }

  .skill-box-sub {
    color: #9fd9bd;
    font-size: 11px;
  }

  .skill-box-body {
    max-height: 340px;
    margin-top: 8px;
  }

  .skill-box-empty {
    color: #9fd9bd;
    font-size: 11px;
    line-height: 16px;
  }

  /* 查询框。样式照 shop.uvue 那个查贴纸的框 ——
     两处做的是同一件事（在一张全表里找一件），长得一样才认得出 */
  .search {
    flex-direction: row;
    align-items: center;
    background-color: #084730;
    border-radius: 8px;
    padding: 2px 10px;
    margin-top: 8px;
  }

  .search-input {
    flex: 1;
    height: 32px;
    color: #ffffff;
    font-size: 13px;
  }

  .search-hint {
    color: #6fa98c;
    font-size: 13px;
  }

  .search-clear {
    color: #9fd9bd;
    font-size: 12px;
    padding: 4px 6px;
    margin-left: 6px;
  }

  .my-skill {
    padding: 8px 9px;
    margin-bottom: 6px;
    border-radius: 8px;
    background-color: #0b5d3b;
  }

  .my-skill-head {
    flex-direction: row;
    align-items: center;
  }

  /* 管什么排最前，跟对局页的技能栏一个规矩 */
  .my-skill-cover {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    margin-right: 6px;
  }

  .my-skill-name {
    flex: 1;
    color: #e8b23a;
    font-size: 13px;
    font-weight: bold;
  }

  .my-skill-level {
    color: #9fd9bd;
    font-size: 10px;
  }

  /* 图鉴里还没拿到的那几种：压暗。
     信息留着（你得知道池子里有什么），但一眼看得出不是你的 */
  .my-skill-off {
    opacity: 0.45;
  }

  /* 自定义弹层里带上的那几个：描一圈金边 */
  .my-skill-on {
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  /* 可点的等级：看着像个按钮，点一下循环切换 */
  .my-skill-pick {
    color: #3b2a00;
    background-color: #e8b23a;
    font-size: 10px;
    font-weight: bold;
    border-radius: 8px;
    padding: 2px 7px;
  }

  /* 名额满了描成橙的，跟商店那边一个规矩 */
  .own-full {
    color: #ff9e80;
    font-weight: bold;
  }

  /* 关键字标记（现在只有「优先」）。跟商店那边 .skill-key 一个样子 */
  .my-skill-key {
    color: #2a1a00;
    background-color: #e8b23a;
    font-size: 9px;
    font-weight: bold;
    padding: 1px 5px;
    border-radius: 7px;
    margin-left: 5px;
    margin-right: 8px;
  }

  .my-skill-desc {
    color: #cfeade;
    font-size: 10px;
    line-height: 15px;
