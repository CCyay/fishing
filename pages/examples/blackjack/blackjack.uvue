<template>
  <view class="page">
    <!-- 顶部信息栏 -->
    <view class="topbar">
      <view class="topbar-item">
        <text class="topbar-label">关卡</text>
        <text id="bj-level-name" class="topbar-value">{{ level.index }} · {{ level.name }}</text>
      </view>
      <view class="topbar-item">
        <text class="topbar-label">回合</text>
        <text id="bj-turn" class="topbar-value">{{ turnNo }}</text>
      </view>
      <view class="topbar-item">
        <text class="topbar-label">强化</text>
        <text id="bj-boost" class="topbar-value">{{ playerBoost ? '就绪' : '—' }}</text>
      </view>
    </view>

    <!-- 庄家：桌上的牌 + 总点数 -->
    <view class="side">
      <view class="side-info">
        <text class="side-name">庄家</text>
        <text class="side-sub"
          >手牌 {{ dealerHand.length }}{{ dealerHiddenCount > 0 ? ' · 暗牌 ' + dealerHiddenCount : ''
          }}{{ dealerStood ? ' · 已停牌' : '' }}{{ boostHint(dealerBoost) }}</text
        >
      </view>
      <text id="bj-dealer-total" class="side-total" :class="{ 'total-bust': dealerBust }"
        >{{ dealerShown }}</text
      >
      <scroll-view id="bj-dealer-board" class="board" direction="horizontal">
        <view class="board-row">
          <text v-if="dealerBoard.length == 0" class="played-tip">未出牌</text>
          <view
            v-for="(card, index) in dealerBoard"
            :key="'db-' + index"
            :id="'bj-dealer-card-' + index"
            class="card"
            :class="{
              'card-stickered': card.stickerKey != S_NONE && !card.faceDown,
              'card-tapped': card.tapped,
              'card-back': card.faceDown,
              'card-ready': phase == 'swap' || phase == 'strike' || phase == 'samepick'
                || phase == 'seizepick' || phase == 'strippick' || phase == 'shuntpick'
                || phase == 'martyrpick'
                || (phase == 'echopick' && echoFromDealer)
            }"
            @click="tapDealerCard(index)">
            <text v-if="card.faceDown" class="card-back-mark">?</text>
            <text v-else class="card-rank" :class="{ 'card-red': isRed(card) }">{{ card.rank }}</text>
            <text v-if="!card.faceDown" class="card-suit" :class="{ 'card-red': isRed(card) }">{{
              card.suit
            }}</text>
            <text v-if="!card.faceDown && card.stickerKey != S_NONE" class="card-sticker">{{
              stickerName(card)
            }}</text>
            <text v-if="!card.faceDown && cardMark(card) != ''" class="card-mark">{{
              cardMark(card)
            }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 目标与提示 -->
    <view class="message-box" :class="'message-' + resultKind">
      <text id="bj-message" class="message-text">{{ message }}</text>
    </view>

    <!-- 你：桌上的牌可以点着横置 -->
    <view class="side">
      <view class="side-info">
        <text class="side-name">你</text>
        <text class="side-sub"
          >目标 {{ GOAL }}{{ playerStood ? ' · 已停牌' : '' }}{{ boostHint(playerBoost) }}</text
        >
      </view>
      <text id="bj-player-total" class="side-total" :class="{ 'total-bust': playerBust }"
        >{{ playerScore }}</text
      >
      <scroll-view id="bj-player-board" class="board" direction="horizontal">
        <view class="board-row">
          <text v-if="playerBoard.length == 0" class="played-tip">未出牌</text>
          <view
            v-for="(card, index) in playerBoard"
            :key="'pb-' + index"
            :id="'bj-board-' + index"
            class="card"
            :class="{
              'card-stickered': card.stickerKey != S_NONE,
              'card-tapped': card.tapped,
              'card-ready': canTap(card) || phase == 'insert' || phase == 'swap'
                || phase == 'samepick' || phase == 'cutpick' || phase == 'strippick'
                || phase == 'shuntpick' || phase == 'morphpick'
                || (phase == 'echopick' && !echoFromDealer)
            }"
            @click="tapCard(index)">
            <text class="card-rank" :class="{ 'card-red': isRed(card) }">{{ card.rank }}</text>
            <text class="card-suit" :class="{ 'card-red': isRed(card) }">{{ card.suit }}</text>
            <text v-if="card.stickerKey != S_NONE" class="card-sticker">{{ stickerName(card) }}</text>
            <text v-if="cardMark(card) != ''" class="card-mark">{{ cardMark(card) }}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 手牌 / 窥探 / 结算 -->
    <view class="hand-area">
      <view v-if="phase != 'over'" class="hand-head">
        <text class="hand-title">你的手牌 {{ playerHand.length }}/{{ HAND_SIZE }}</text>
        <text v-if="phase == 'player'" id="bj-stand" class="stand-btn" @click="stand">停牌</text>
        <text class="hand-tip">{{ handTip }}</text>
      </view>

      <!-- 窥探：看一眼牌库顶，决定留着还是压到底 -->
      <view v-if="phase == 'peek'" id="bj-peek" class="peek-box">
        <text class="peek-label">牌库顶</text>
        <view class="card" :class="{ 'card-stickered': peekCard.stickerKey != S_NONE }">
          <text class="card-rank" :class="{ 'card-red': isRed(peekCard) }">{{ peekCard.rank }}</text>
          <text class="card-suit" :class="{ 'card-red': isRed(peekCard) }">{{ peekCard.suit }}</text>
          <text v-if="peekCard.stickerKey != S_NONE" class="card-sticker">{{
            stickerName(peekCard)
          }}</text>
        </view>
        <text id="bj-peek-keep" class="peek-btn" @click="finishPeek(false)">留着</text>
        <text id="bj-peek-bottom" class="peek-btn" @click="finishPeek(true)">压到牌底</text>
      </view>

      <!-- 立即类贴纸打出后，发不发动你自己定 -->
      <view v-if="phase == 'confirm'" id="bj-confirm" class="peek-box">
        <text class="peek-label">发动效果？</text>
        <text id="bj-use-yes" class="peek-btn" @click="confirmPlay(true)">发动</text>
        <text id="bj-use-no" class="peek-btn" @click="confirmPlay(false)">不发动</text>
      </view>

      <!-- 扫哪一边，你说了算。按点数的问大小，按奇偶的问奇偶 -->
      <view v-if="phase == 'cullpick'" id="bj-cullpick" class="peek-box">
        <text class="peek-label">扫哪一类？</text>
        <text id="bj-cull-big" class="peek-btn" @click="chooseCull(true)">{{ cullFirstText }}</text>
        <text id="bj-cull-small" class="peek-btn" @click="chooseCull(false)">{{
          cullSecondText
        }}</text>
      </view>

      <!-- 双子：牌库里同点数的牌全摊在这，挑一张 -->
      <scroll-view v-if="phase == 'pick'" id="bj-pick" class="pick-box" direction="horizontal">
        <view class="board-row">
          <view
            v-for="(card, index) in twinPicks"
            :key="'tp-' + index"
            :id="'bj-pick-' + index"
            class="card card-hand"
            :class="{ 'card-stickered': card.stickerKey != S_NONE }"
            @click="pickTwin(index)">
            <text class="card-rank" :class="{ 'card-red': isRed(card) }">{{ card.rank }}</text>
            <text class="card-suit" :class="{ 'card-red': isRed(card) }">{{ card.suit }}</text>
            <text v-if="card.stickerKey != S_NONE" class="card-sticker">{{ stickerName(card) }}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 弃牌堆摊开：复生拿回手上，回魂直接摆到桌上 -->
      <scroll-view
        v-if="phase == 'revivepick' || phase == 'recallpick'"
        id="bj-revive"
        class="pick-box"
        direction="horizontal">
        <view class="board-row">
          <view
            v-for="(card, index) in playerDiscard"
            :key="'rv-' + index"
            :id="'bj-revive-' + index"
            class="card card-hand"
            :class="{ 'card-stickered': card.stickerKey != S_NONE }"
            @click="pickDiscardPile(index)">
            <text class="card-rank" :class="{ 'card-red': isRed(card) }">{{ card.rank }}</text>
            <text class="card-suit" :class="{ 'card-red': isRed(card) }">{{ card.suit }}</text>
            <text v-if="card.stickerKey != S_NONE" class="card-sticker">{{ stickerName(card) }}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 借刀：庄家手牌全摊开，挑一张替他打出去 -->
      <scroll-view v-if="phase == 'borrow'" id="bj-borrow" class="pick-box" direction="horizontal">
        <view class="board-row">
          <view
            v-for="(card, index) in dealerHand"
            :key="'bw-' + index"
            :id="'bj-borrow-' + index"
            class="card card-hand"
            :class="{ 'card-stickered': card.stickerKey != S_NONE }"
            @click="pickBorrow(index)">
            <text class="card-rank" :class="{ 'card-red': isRed(card) }">{{ card.rank }}</text>
            <text class="card-suit" :class="{ 'card-red': isRed(card) }">{{ card.suit }}</text>
            <text v-if="card.stickerKey != S_NONE" class="card-sticker">{{ stickerName(card) }}</text>
          </view>
        </view>
      </scroll-view>

      <!-- 结算前的最后机会：横置一张翻盘，或者直接认了 -->
      <view v-if="phase == 'respond'" id="bj-respond" class="peek-box">
        <text class="peek-label">横置一张桌上的牌翻盘</text>
        <text id="bj-give-up" class="peek-btn" @click="giveUpRespond">认了，结算</text>
      </view>

      <view
        v-if="
          phase != 'over' &&
          phase != 'peek' &&
          phase != 'respond' &&
          phase != 'pick' &&
          phase != 'borrow' &&
          phase != 'revivepick' &&
          phase != 'recallpick' &&
          phase != 'confirm' &&
          phase != 'cullpick'
        "
        id="bj-hand"
        class="hand">
        <view
          v-for="(card, index) in playerHand"
          :key="'h-' + index"
          :id="'bj-hand-' + index"
          class="card card-hand"
          :class="{ 'card-stickered': card.stickerKey != S_NONE }"
          @click="playCard(index)">
          <text class="card-rank" :class="{ 'card-red': isRed(card) }">{{ card.rank }}</text>
          <text class="card-suit" :class="{ 'card-red': isRed(card) }">{{ card.suit }}</text>
          <text v-if="card.stickerKey != S_NONE" class="card-sticker">{{ stickerName(card) }}</text>
        </view>
      </view>

      <view v-if="phase == 'over'" class="over-box">
        <text id="bj-result" class="over-text">{{ resultText }}</text>
        <view id="bj-back" class="btn btn-primary" @click="goBack">
          <text class="btn-text">返回关卡</text>
        </view>
      </view>
    </view>

    <!-- 底部状态与入口 -->
    <view class="toolbar">
      <text id="bj-phase" class="toolbar-text">{{ phaseText }}</text>
      <text id="bj-discard-toggle" class="toolbar-link" @click="toggleDiscard"
        >弃牌 {{ playerDiscard.length }}/{{ dealerDiscard.length }}</text
      >
      <text id="bj-rules" class="toolbar-link" @click="showRules">规则</text>
      <text id="bj-quit" class="toolbar-link" @click="goBack">退出</text>
    </view>

    <!-- 弃牌堆浮层 -->
    <view v-if="showDiscard" class="overlay">
      <view class="overlay-panel">
        <view class="overlay-header">
          <text class="overlay-title">弃牌堆</text>
          <text id="bj-discard-count" class="overlay-count"
            >我 {{ playerDiscard.length }} / 庄 {{ dealerDiscard.length }}</text
          >
          <text id="bj-discard-close" class="overlay-close" @click="toggleDiscard">关闭</text>
        </view>
        <scroll-view class="overlay-body">
          <text class="discard-label">我方弃牌</text>
          <view id="bj-player-discard" class="mini-cards">
            <text v-if="playerDiscard.length == 0" class="played-tip">暂无</text>
            <view
              v-for="(card, index) in playerDiscard"
              :key="'pd-' + index"
              class="mini-card"
              :class="{ 'card-stickered': card.stickerKey != S_NONE }">
              <text class="mini-rank" :class="{ 'card-red': isRed(card) }">{{ card.rank }}</text>
              <text class="mini-suit" :class="{ 'card-red': isRed(card) }">{{ card.suit }}</text>
            </view>
          </view>

          <text class="discard-label">庄家弃牌</text>
          <view id="bj-dealer-discard" class="mini-cards">
            <text v-if="dealerDiscard.length == 0" class="played-tip">暂无</text>
            <view
              v-for="(card, index) in dealerDiscard"
              :key="'dd-' + index"
              class="mini-card"
              :class="{ 'card-stickered': card.stickerKey != S_NONE }">
              <text class="mini-rank" :class="{ 'card-red': isRed(card) }">{{ card.rank }}</text>
              <text class="mini-suit" :class="{ 'card-red': isRed(card) }">{{ card.suit }}</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    Card,
    GOAL,
    HAND_SIZE,
    bestTotal,
    openTotal,
    countFaceDown,
    buildDeck,
    cloneCard,
    isRedSuit,
    shownValue,
    worthOf,
    effectiveValue
  } from '@/pages/examples/blackjack/cards.uts'
  import {
    stickerAt,
    rarityAt,
    hasTapEffect,
    isPlayEffect,
    needsOpponentBoard,
    needsLeftCard,
    needsOwnHand,
    S_PEEK,
    S_STEAL,
    S_GIVE,
    S_BEG,
    S_BOOST,
    S_CHEER,
    S_BUTTERFLY,
    S_SWAP,
    S_TWINS,
    S_RUTHLESS,
    S_REGRET,
    S_INSIGHT,
    S_BACKFLOW,
    S_TRADE,
    S_SWITCH,
    S_PURGE,
    S_COLLAPSE,
    S_ERODE,
    S_STEP,
    S_CUTIN,
    S_BORROW,
    S_STANDBY,
    S_ECHO,
    S_REFLECT,
    S_GRAFT,
    S_REVIVE,
    S_SEIZE,
    S_STRIP,
    S_SHUNT,
    S_MARTYR,
    S_RECALL,
    S_DEVOUR,
    S_MORPH,
    S_NONE,
    hasDownside,
    downsideText,
    needsOpponentHand,
    isEchoable,
    isGraftable,
    isSeizable,
    isLastingSticker,
    rarityOfKey,
    INSIGHT_DEPTH,
    SCOPE_OWN,
    SCOPE_CROSS,
    SCOPE_ANY,
    baseEffectOf,
    countOf,
    isSwapSticker,
    swapScopeOf,
    isCullSticker,
    isFriskSticker,
    cullModeOf,
    cullScopeOf,
    friskScopeOf,
    cullAsksDirection,
    cullPicksTarget,
    S_SAME,
    CULL_BIGGER,
    CULL_SMALLER,
    CULL_EQUAL,
    CULL_ODD,
    CULL_EVEN,
    isParityCull,
    cullFlipsInstead,
    achievementAt,
    ACH_TWIN_PAIR,
    ACH_EXACT_GOAL,
    ACH_DEALER_BUST,
    ACH_BEHIND,
    ACH_STAND_BROKEN,
    ACH_FORESEE,
    ACH_COMEBACK,
    ACH_FLOW,
    BEHIND_GAP,
    FLOW_DRAWS
  } from '@/pages/examples/blackjack/stickers.uts'
  import {
    SaveData,
    emptySave,
    loadCurrentSave,
    saveCurrent,
    currentLevel,
    unlockShop,
    addTickets,
    markAchieved
  } from '@/pages/examples/blackjack/save.uts'
  import { Level, levelAt, dealerStuck } from '@/pages/examples/blackjack/levels.uts'

  const DEALER_DELAY : number = 700
  // 同一次挑战里最多平局重开几次，超了就算这关没过
  const MAX_PUSH : number = 2
  // 注意别在 setup() 里重置它 —— 洗牌重开走的就是 setup
  let pushCount = 0

  const save = ref<SaveData>(emptySave())
  const level = ref<Level>(levelAt(1))

  const playerDeck = ref<Card[]>([] as Card[])
  const playerCursor = ref<number>(0)
  const dealerDeck = ref<Card[]>([] as Card[])
  const dealerCursor = ref<number>(0)

  const playerHand = ref<Card[]>([] as Card[])
  const dealerHand = ref<Card[]>([] as Card[])

  // 桌上已打出、正在计点的牌。贴纸牌打出后就留在这里等着被横置
  const playerBoard = ref<Card[]>([] as Card[])
  const dealerBoard = ref<Card[]>([] as Card[])

  const playerDiscard = ref<Card[]>([] as Card[])
  const dealerDiscard = ref<Card[]>([] as Card[])
  const showDiscard = ref<boolean>(false)

  // 强化留下的状态：下一张立即类贴纸的效果连发两次
  const playerBoost = ref<boolean>(false)
  const dealerBoost = ref<boolean>(false)
  // 正等你决定发不发动的那张立即类贴纸在桌上的位置
  let pendingPlayAt = -1

  // 窥探翻开的那张牌，等你决定留着还是压到牌底
  const peekCard = ref<Card>(blankCard())
  // 双子摊开的候选牌，以及它们在牌库里的下标
  const twinPicks = ref<Card[]>([] as Card[])
  let twinAt : number[] = []

  const turnNo = ref<number>(0)
  // 停牌状态。停牌的一方不再出牌，等对方也停了才结算；
  // 停牌时的点数记下来，一旦被改动就自动退出停牌
  const playerStood = ref<boolean>(false)
  const dealerStood = ref<boolean>(false)
  let playerStoodAt = 0
  let dealerStoodAt = 0
  // dealer：庄家行动中；player：你的回合，可以横置和出牌；
  // peek：等你处理窥探；begging：庄家乞讨，等你交一张牌；cheer：鼓舞打出后等你指定目标；
  // respond：局面已经对你不利，结算前给你的最后一次横置机会；over：结束
  const phase = ref<string>('dealer')
  const message = ref<string>('')
  const resultKind = ref<string>('idle')
  const resultText = ref<string>('')

  // 响应窗口里挂起的结局，等你横置完再看是不是还成立
  let pendingKind = ''
  let pendingTip = ''

  let dealerTimer = -1
  // 庄家还欠一次出牌（横置效果打断了它的行动）
  let dealerPending = false
  // 强化翻倍时，这些效果还欠你几次
  let peekLeft = 0
  let begLeft = 0
  // 还要挑几张手牌，以及挑出来干什么：
  // drop 弃掉、sink 压回牌库底、trade 递给庄家换一张
  let dropLeft = 0
  let pickMode = 'drop'
  // 换位阶段：能挑的范围，以及发起换位的那张贴纸牌在自己桌上的位置
  let swapScope = 0
  let swapSelfAt = -1
  // 本局一度落后过多少点，用来判「逆风翻盘」
  let maxBehind = 0
  // 还能再翻负几张庄家的牌
  let strikeLeft = 0
  // 正等你选扫描方向的那张贴纸，以及它在桌上的位置
  let pendingCullAt = -1
  let pendingCullId = S_NONE
  // 插队时，要挪动的那张牌现在在哪
  let insertFrom = -1
  // 同点正等你挑尺子，这是它在桌上的位置
  let sameFrom = -1
  // 狠心还要你挑几张牌弃掉
  let cutLeft = 0
  // 借刀还要你替庄家打出几张
  let borrowLeft = 0
  // 按兵欠下的回合数：轮到自己时让给对方，让一次扣一次。
  // 横置按兵交出的是「当前这一回合」，所以只有强化翻倍多出来的才记在这
  let playerPause = 0
  let dealerPause = 0
  // 按兵刚发动，这一回合的出牌权就该交出去了
  let standbyFired = false
  // 回响/返照正等你挑牌：挑的是庄家桌上的（返照）还是自己桌上的（回响），还欠几次。
  // 模板要靠它决定高亮哪一边的牌，所以得是响应式的
  const echoFromDealer = ref<boolean>(false)
  let echoLeft = 0
  // 移植正等你挑手牌，这是移植牌在桌上的位置
  let graftAt = -1
  // 夺取正等你挑庄家的牌，这是夺取牌在自己桌上的位置
  let seizeAt = -1
  // 转嫁正等你挑往哪加：要加多少点、转嫁牌自己在桌上哪个位置
  let shuntWorth = 0
  let shuntAt = -1
  // 献身正等你挑拉谁下水，这是献身牌自己在桌上的位置
  let martyrAt = -1
  // 回魂正等你从弃牌堆挑牌，这是回魂牌自己在桌上的位置
  let recallAt = -1
  // 吞并正等你挑手牌，这是吞并牌在桌上的位置
  let devourAt = -1
  // 化形正等你挑塞给谁：塞多少点、化形牌自己在桌上哪个位置
  let morphAt = -1
  let morphWorth = 0

  function blankCard() : Card {
    const card : Card = {
      suit: '♠',
      rank: 'A',
      value: 1,
      stickerKey: S_NONE,
      tapped: false,
      forced: -1,
      faceDown: false,
      negated: false,
      extra: 0,
      altValue: -1
    }
    return card
  }

  // ---------- 点数 ----------

  // 桌上的牌每张都可能有多个候选点数，总分取不爆的最优组合
  const playerScore = computed<number>(() : number => {
    return bestTotal(playerBoard.value)
  })

  // 庄家的真实点数，判定和它自己的决策都用这个
  const dealerScore = computed<number>(() : number => {
    return bestTotal(dealerBoard.value)
  })

  // 你能看到的庄家点数：盖着的牌算不进去
  const dealerOpenScore = computed<number>(() : number => {
    return openTotal(dealerBoard.value)
  })

  const dealerHiddenCount = computed<number>(() : number => {
    return countFaceDown(dealerBoard.value)
  })

  // 有暗牌时只给你看明面的点数，后面缀个问号
  const dealerShown = computed<string>(() : string => {
    if (dealerHiddenCount.value == 0) {
      return dealerScore.value.toString()
    }
    return dealerOpenScore.value + '+?'
  })

  // 最优组合下还是超，才是真的爆了
  const playerBust = computed<boolean>(() : boolean => {
    return playerScore.value > GOAL
  })

  const dealerBust = computed<boolean>(() : boolean => {
    return dealerScore.value > GOAL
  })

  // ---------- 初始化 ----------

  // 开一局。平局重来时也走这里，牌会重新洗过
  function setup() {
    const data = loadCurrentSave()
    save.value = data
    level.value = levelAt(currentLevel())

    playerDeck.value = buildDeck(data.stuck)
    playerCursor.value = 0
    dealerDeck.value = buildDeck(dealerStuck(level.value))
    dealerCursor.value = 0

    playerHand.value = [] as Card[]
    dealerHand.value = [] as Card[]
    tidyPlayerHand()
    tidyDealerHand()

    playerBoard.value = [] as Card[]
    dealerBoard.value = [] as Card[]
    playerDiscard.value = [] as Card[]
    dealerDiscard.value = [] as Card[]
    playerBoost.value = false
    dealerBoost.value = false
    playerStood.value = false
    dealerStood.value = false
    playerStoodAt = 0
    dealerStoodAt = 0
    pendingPlayAt = -1
    pendingKind = ''
    dealerPending = false
    dropLeft = 0
    pickMode = 'drop'
    swapSelfAt = -1
    insertFrom = -1
    sameFrom = -1
    pendingCullAt = -1
    pendingCullId = S_NONE
    cutLeft = 0
    borrowLeft = 0
    playerPause = 0
    dealerPause = 0
    standbyFired = false
    echoFromDealer.value = false
    echoLeft = 0
    graftAt = -1
    seizeAt = -1
    shuntWorth = 0
    shuntAt = -1
    martyrAt = -1
    recallAt = -1
    devourAt = -1
    morphAt = -1
    morphWorth = 0
    strikeLeft = 0
    maxBehind = 0
    // 轮到你行动时才 +1，所以从 0 起
    turnNo.value = 0
    resultKind.value = 'idle'
    resultText.value = ''
    message.value = '目标 ' + GOAL + ' 点。每次只能出一张牌或者停牌，双方都停牌才结算。'

    phase.value = 'dealer'
    dealerTimer = setTimeout(dealerTurn, DEALER_DELAY)
  }

  // ---------- 摸牌 ----------

  // 整理手牌：多于 HAND_SIZE 就把多出来的弃进弃牌堆，少于就立刻从牌库补满。
  // 牌库抽完后补不满，手牌只会越打越少，直到没牌可出触发判定。
  function tidyPlayerHand() {
    const hand : Card[] = []
    const over : Card[] = []
    for (let i = 0; i < playerHand.value.length; i++) {
      if (i < HAND_SIZE) {
        hand.push(playerHand.value[i])
      } else {
        over.push(playerHand.value[i])
      }
    }
    if (over.length > 0) {
      playerDiscard.value = pushCards(playerDiscard.value, over)
    }
    while (hand.length < HAND_SIZE && playerCursor.value < playerDeck.value.length) {
      hand.push(cloneCard(playerDeck.value[playerCursor.value]))
      playerCursor.value = playerCursor.value + 1
    }
    playerHand.value = hand
  }

  function tidyDealerHand() {
    const hand : Card[] = []
    const over : Card[] = []
    for (let i = 0; i < dealerHand.value.length; i++) {
      if (i < HAND_SIZE) {
        hand.push(dealerHand.value[i])
      } else {
        over.push(dealerHand.value[i])
      }
    }
    if (over.length > 0) {
      dealerDiscard.value = pushCards(dealerDiscard.value, over)
    }
    while (hand.length < HAND_SIZE && dealerCursor.value < dealerDeck.value.length) {
      hand.push(cloneCard(dealerDeck.value[dealerCursor.value]))
      dealerCursor.value = dealerCursor.value + 1
    }
    dealerHand.value = hand
  }

  function removeAt(list : Card[], index : number) : Card[] {
    const next : Card[] = []
    for (let i = 0; i < list.length; i++) {
      if (i != index) {
        next.push(list[i])
      }
    }
    return next
  }

  function pushCards(pile : Card[], cards : Card[]) : Card[] {
    const next : Card[] = []
    for (let i = 0; i < pile.length; i++) {
      next.push(pile[i])
    }
    for (let i = 0; i < cards.length; i++) {
      next.push(cards[i])
    }
    return next
  }

  function pushCard(pile : Card[], card : Card) : Card[] {
    const one : Card[] = [card]
    return pushCards(pile, one)
  }

  // ---------- 回合 ----------
  //
  // 每次轮到自己，只能出一张牌或者停牌。对方停了牌，自己就能一直出下去，
  // 直到自己也停牌、或者爆掉。双方都停牌才结算，比谁更接近 GOAL。
  // 停牌不是终点：只要自己桌上的点数被改动过（被讨走、被塞牌、蝴蝶改写），
  // 就自动退出停牌状态，可以接着出牌。

  // 该谁行动了。lastWasDealer 表示刚刚动完的是不是庄家
  function nextAction(lastWasDealer : boolean) {
    if (phase.value == 'over') {
      return
    }
    if (playerStood.value && dealerStood.value) {
      settleStand(true)
      return
    }
    // 对方还没停就换对方动；对方停了就自己接着来
    let dealerGoes = lastWasDealer ? playerStood.value : !dealerStood.value

    // 按兵欠下的回合在这里还：轮到谁谁让一手。
    // 但对方已经收手了就没得让 —— 再让下去就是两边干瞪眼，
    // 而且对方收手本来就是你按兵想等到的结果，等到了就该动了
    if (!dealerGoes && playerPause > 0) {
      if (dealerStood.value) {
        playerPause = 0
      } else {
        playerPause = playerPause - 1
        dealerGoes = true
      }
    } else if (dealerGoes && dealerPause > 0) {
      if (playerStood.value) {
        dealerPause = 0
      } else {
        dealerPause = dealerPause - 1
        dealerGoes = false
      }
    }

    if (dealerGoes) {
      phase.value = 'dealer'
      dealerTimer = setTimeout(dealerTurn, DEALER_DELAY)
      return
    }
    // 轮到你。没牌可出就只能停
    if (playerHand.value.length == 0 && !playerStood.value) {
      playerStood.value = true
      playerStoodAt = playerScore.value
      message.value = '你没牌可出了，自动停牌在 ' + playerScore.value + ' 点。'
      afterAction(false)
      return
    }
    turnNo.value = turnNo.value + 1
    phase.value = 'player'
  }

  function dealerTurn() {
    // 庄家每次行动也只能横置一张
    dealerTapOne()
    if (phase.value == 'over') {
      return
    }
    if (phase.value == 'begging') {
      // 庄家讨牌中，等你交完再接着出牌
      dealerPending = true
      return
    }
    // 庄家按兵：这一回合他不出牌了
    if (standbyFired) {
      standbyFired = false
      afterAction(true)
      return
    }
    dealerPlayCard()
  }

  function dealerPlayCard() {
    if (phase.value == 'over') {
      return
    }
    // 没牌可出只能停，有牌也可能主动收手
    if (dealerHand.value.length == 0 || dealerWantsStand()) {
      dealerStood.value = true
      dealerStoodAt = dealerScore.value
      message.value = '庄家停牌，停在 ' + dealerScore.value + ' 点。'
      afterAction(true)
      return
    }

    const index = chooseDealerCard()
    const card = dealerHand.value[index]
    dealerHand.value = removeAt(dealerHand.value, index)

    // 高关卡的庄家最先打出的几张盖着，结算才翻
    if (dealerBoard.value.length < level.value.dealerHidden) {
      card.faceDown = true
    }
    dealerBoard.value = pushCard(dealerBoard.value, card)
    message.value = card.faceDown
      ? '庄家盖了一张牌。'
      : '庄家打出 ' + cardText(card) + '，庄家 ' + dealerShown.value + ' 点。'

    // 复生同理：等它自己从弃牌堆捞完再补
    if (baseEffectOf(card.stickerKey) != S_REVIVE) {
      tidyDealerHand()
    }

    // 立即类贴纸：没代价的直接发动，有代价的才让庄家算一下划不划算
    if (isPlayEffect(card.stickerKey)) {
      const at = dealerBoard.value.length - 1
      if (!hasDownside(card.stickerKey) || dealerWantsPlayEffect(card, at)) {
        let times = 1
        if (dealerBoost.value) {
          times = 2
          dealerBoost.value = false
        }
        runEffect(card.stickerKey, true, times, at)
      }
    }

    afterAction(true)
  }

  // 你主动停牌
  function stand() {
    if (phase.value != 'player') {
      return
    }
    playerStood.value = true
    playerStoodAt = playerScore.value
    message.value = '你停牌，停在 ' + playerScore.value + ' 点。'
    afterAction(false)
  }

  // 一次行动做完：先看爆没爆，再看该谁动
  function afterAction(lastWasDealer : boolean) {
    refreshStand()
    checkAchievements()
    if (checkInstantEnd()) {
      return
    }
    nextAction(lastWasDealer)
  }

  // ---------- 成就 ----------
  //
  // 有些贴纸不靠通关拿，得先在牌桌上做出对应的事。
  // 每次行动后扫一遍，达成了就当场解锁

  function checkAchievements() {
    // 自己桌上出现相邻两张点数相同 —— 这正是蝴蝶在做的事
    for (let i = 1; i < playerBoard.value.length; i++) {
      if (worthOf(playerBoard.value[i]) == worthOf(playerBoard.value[i - 1])) {
        gainAchievement(ACH_TWIN_PAIR)
        break
      }
    }
    // 一局之内摸了足够多的牌，手牌来回换过好几轮
    if (playerCursor.value >= FLOW_DRAWS) {
      gainAchievement(ACH_FLOW)
    }
    // 记下本局最难看的时候落后多少，赢了才用得上
    const gap = dealerScore.value - playerScore.value
    if (gap > maxBehind) {
      maxBehind = gap
    }
  }

  function gainAchievement(id : number) {
    const data = save.value
    if (!markAchieved(data, id)) {
      return
    }
    save.value = data
    saveCurrent(data)
    const ach = achievementAt(id)
    toast('达成【' + ach.name + '】，解锁贴纸【' + stickerAt(ach.sticker).name + '】')
  }

  // 点数被改动过就自动退出停牌，可以接着出牌
  function refreshStand() {
    if (playerStood.value && playerScore.value != playerStoodAt) {
      playerStood.value = false
      message.value = message.value + ' 你的点数变了，自动退出停牌。'
    }
    if (dealerStood.value && dealerScore.value != dealerStoodAt) {
      dealerStood.value = false
      // 把已经收手的庄家又拽回牌桌
      gainAchievement(ACH_STAND_BROKEN)
    }
  }

  function playCard(index : number) {
    // 双子之后是在挑弃哪张，不是出牌
    if (phase.value == 'discard') {
      dropCard(index)
      return
    }
    // 移植之后是在挑拆哪张的贴纸
    if (phase.value == 'graftpick') {
      pickGraft(index)
      return
    }
    // 吞并之后是在挑吞哪张的点数
    if (phase.value == 'devourpick') {
      pickDevour(index)
      return
    }
    if (phase.value != 'player') {
      return
    }
    if (index >= playerHand.value.length) {
      return
    }
    const card = playerHand.value[index]
    playerHand.value = removeAt(playerHand.value, index)
    playerBoard.value = pushCard(playerBoard.value, card)
    message.value = '你打出 ' + cardText(card) + '，现在 ' + playerScore.value + ' 点。'

    // 复生要自己填上刚腾出来的手牌位，先别急着从牌库补
    if (baseEffectOf(card.stickerKey) != S_REVIVE) {
      tidyPlayerHand()
    }

    // 立即类贴纸落到桌上就结算。
    // 只有可能反噬自己的效果才停下来问一句 —— 窥探、垫脚这种永远该发动的，
    // 问了等于白按一下，牌组里贴纸越多这种空确认越拖节奏
    if (isPlayEffect(card.stickerKey)) {
      const at = playerBoard.value.length - 1
      if (hasDownside(card.stickerKey)) {
        pendingPlayAt = at
        phase.value = 'confirm'
        message.value = '打出 ' + cardText(card) + '，【' + stickerName(card)
          + '】' + downsideText(card.stickerKey) + '，要发动吗？' + wasteHint(card, at)
        return
      }
      firePlayEffect(at)
      return
    }
    afterAction(false)
  }

  // 发动刚打出的那张立即类贴纸
  function firePlayEffect(at : number) {
    if (at >= playerBoard.value.length) {
      afterAction(false)
      return
    }
    const card = playerBoard.value[at]
    // 强化攒下的翻倍在这里兑现
    let times = 1
    if (playerBoost.value) {
      times = 2
      playerBoost.value = false
      message.value = '【强化】生效，效果连发两次。'
    }
    runEffect(card.stickerKey, false, times, at)
    // 效果如果还在等你挑牌或选方向，就停在那个阶段
    if (phase.value == 'player') {
      afterAction(false)
    }
  }

  // 这次发动大概率白费的话，先说一声，省得浪费掉
  function wasteHint(card : Card, at : number) : string {
    const id = card.stickerKey
    if (needsLeftCard(id) && at == 0) {
      return '（左边没有牌，发动没效果）'
    }
    if (needsOpponentBoard(id) && dealerBoard.value.length == 0) {
      return '（庄家桌上没牌可讨）'
    }
    if (needsOwnHand(id) && playerHand.value.length == 0) {
      return '（手上没牌可换）'
    }
    if (needsOpponentHand(id) && dealerHand.value.length == 0) {
      return '（庄家手上没牌）'
    }
    if (id == S_CHEER && dealerCheerChoiceOfPlayer(at) < 0) {
      return '（自己桌上没有横置的牌）'
    }
    if (id == S_STANDBY && dealerStood.value) {
      return '（庄家已经停牌，让给他也不会动）'
    }
    return ''
  }

  // 你桌上有没有横置过、值得用鼓舞转回来的牌
  function dealerCheerChoiceOfPlayer(skip : number) : number {
    for (let i = 0; i < playerBoard.value.length; i++) {
      if (i != skip && playerBoard.value[i].tapped) {
        return i
      }
    }
    return -1
  }

  // 有代价的那几张才会走到这里，由你拍板
  function confirmPlay(use : boolean) {
    if (phase.value != 'confirm') {
      return
    }
    const at = pendingPlayAt
    pendingPlayAt = -1
    phase.value = 'player'

    if (!use) {
      message.value = '没发动，这张就当普通牌算点数。'
      afterAction(false)
      return
    }
    firePlayEffect(at)
  }

  // ---------- 横置 ----------

  // 这张牌现在能不能横置发动
  function canTap(card : Card) : boolean {
    if (phase.value != 'player' && phase.value != 'respond') {
      return false
    }
    return !card.tapped && hasTapEffect(card.stickerKey)
  }

  function tapCard(index : number) {
    // 狠心阶段点桌上的牌是挑要弃掉的那张
    if (phase.value == 'cutpick') {
      pickCut(index)
      return
    }
    // 回响阶段点自己桌上的牌是挑让哪张再响一次
    if (phase.value == 'echopick') {
      pickEcho(false, index)
      return
    }
    // 祛除阶段点自己桌上的牌是拆自己的贴纸
    if (phase.value == 'strippick') {
      pickStrip(false, index)
      return
    }
    // 转嫁阶段点自己桌上的牌是把点数加给它
    if (phase.value == 'shuntpick') {
      pickShunt(false, index)
      return
    }
    // 化形阶段点自己桌上的牌是挑把点数塞给谁
    if (phase.value == 'morphpick') {
      pickMorph(index)
      return
    }
    // 同点阶段点桌上的牌是挑尺子
    if (phase.value == 'samepick') {
      pickSame(false, index)
      return
    }
    // 插队阶段点桌上的牌是挑插到哪
    if (phase.value == 'insert') {
      pickInsert(index)
      return
    }
    // 换位阶段点桌上的牌是挑对调目标
    if (phase.value == 'swap') {
      pickSwap(false, index)
      return
    }
    // 庄家乞讨时点桌上的牌是交牌，不是横置
    if (phase.value == 'begging') {
      giveToDealer(index)
      return
    }
    if (phase.value == 'cheer') {
      cheerReset(index)
      return
    }
    if (phase.value != 'player' && phase.value != 'respond') {
      return
    }
    if (index >= playerBoard.value.length) {
      return
    }

    const card = playerBoard.value[index]
    if (card.tapped) {
      toast('这张牌已经横置过了，得用【鼓舞】才能重置')
      return
    }
    if (!hasTapEffect(card.stickerKey)) {
      toast(card.stickerKey == S_NONE ? '普通牌没有横置效果' : '这张贴纸不是横置发动的')
      return
    }
    // 横置是不可逆的，这次发动白费的话先拦一下
    const waste = wasteHint(card, index)
    if (waste != '') {
      toast('现在横置没用' + waste)
      return
    }

    const responding = phase.value == 'respond'

    // 横置状态要写回数组，整体替换一次保证视图刷新
    const board = cloneBoard(playerBoard.value)
    board[index].tapped = true
    playerBoard.value = board

    runEffect(card.stickerKey, false, 1, index)

    // 按兵横置完，这一回合就交出去了，不再给你出牌的机会
    if (standbyFired) {
      standbyFired = false
      if (phase.value == 'player') {
        afterAction(false)
      }
      return
    }

    // 响应窗口里横置完就要落定结果，除非效果还在等你操作
    if (responding && phase.value == 'respond') {
      settleRespond()
    }
  }

  // 庄家的横置：每次行动前挑一张时机到了的横置牌发动
  function dealerTapOne() {
    for (let i = 0; i < dealerBoard.value.length; i++) {
      const card = dealerBoard.value[i]
      if (card.tapped || !hasTapEffect(card.stickerKey)) {
        continue
      }
      // 强化要等手上有立即类的牌可以翻倍才值得横
      if (card.stickerKey == S_BOOST) {
        if (!dealerBoost.value && dealerHasPlayCard()) {
          tapDealerAt(i)
          return
        }
        continue
      }
      if (dealerWantsPlayEffect(card, i)) {
        tapDealerAt(i)
        return
      }
    }
  }

  // 庄家手上有没有值得被强化翻倍的立即类贴纸牌
  function dealerHasPlayCard() : boolean {
    for (let i = 0; i < dealerHand.value.length; i++) {
      if (isPlayEffect(dealerHand.value[i].stickerKey)) {
        return true
      }
    }
    return false
  }

  function tapDealerAt(index : number) {
    const board = cloneBoard(dealerBoard.value)
    board[index].tapped = true
    dealerBoard.value = board

    const card = dealerBoard.value[index]
    message.value = '庄家横置 ' + cardText(card) + '，发动【' + stickerAt(card.stickerKey).name + '】'
    runEffect(card.stickerKey, true, 1, index)
  }

  // 庄家要不要发动这张贴纸。立即类是打出的当下问，横置类是每次行动前问，
  // 判断条件一样 —— 横置版和立即版本来就是同一个效果
  function dealerWantsPlayEffect(card : Card, index : number) : boolean {
    if (card.stickerKey == S_INSIGHT) {
      return dealerCursor.value < dealerDeck.value.length
    }
    const id = baseEffectOf(card.stickerKey)
    if (id == S_PEEK) {
      return dealerCursor.value < dealerDeck.value.length
    }
    if (id == S_STEAL) {
      return playerHand.value.length > 0
    }
    if (id == S_BEG) {
      return playerBoard.value.length > 0
    }
    if (id == S_GIVE) {
      // 奉献是把自己的牌塞给你，你快满了才划算
      return playerScore.value + shownValue(card) > GOAL
    }
    if (id == S_BUTTERFLY) {
      // 蝴蝶：左边得有牌，而且改完自己的点数要更接近目标
      if (index == 0) {
        return false
      }
      const board = cloneBoard(dealerBoard.value)
      board[index - 1].forced = shownValue(board[index])
      const after = bestTotal(board)
      return after <= GOAL && after > dealerScore.value
    }
    if (id == S_CHEER) {
      // 鼓舞：桌上得有横置过的牌可以重置
      return dealerCheerChoice(index) >= 0
    }
    if (id == S_SWAP) {
      // 置换：手上全是会爆的牌才值得整手换掉
      if (dealerHand.value.length == 0) {
        return false
      }
      for (let i = 0; i < dealerHand.value.length; i++) {
        if (dealerNextScore(dealerHand.value[i]) <= GOAL) {
          return false
        }
      }
      return true
    }
    if (id == S_TWINS) {
      // 双子：再来一张同点数的也不会爆才值得找
      return dealerScore.value + shownValue(card) <= GOAL
    }
    if (id == S_RUTHLESS) {
      // 桌上真有一张砍掉能更靠近 42 的牌才发动
      return dealerCutChoice() >= 0
    }
    if (id == S_BORROW) {
      // 你手上有一张能把你顶爆的才动手。顶不爆的话，
      // 这一下等于白帮你出牌，还替你把手牌补了
      for (let i = 0; i < playerHand.value.length; i++) {
        if (playerScore.value + shownValue(playerHand.value[i]) > GOAL) {
          return true
        }
      }
      return false
    }
    if (id == S_STANDBY) {
      // 自己点数已经够看了就把回合让出去，等你先摊牌。
      // 你已经停牌的话让了也没人动，白费一次横置
      return !playerStood.value && dealerScore.value >= GOAL - 8
    }
    if (id == S_GRAFT) {
      // 手上得有带贴纸的牌才搬得动
      return graftChoice(dealerHand.value) >= 0
    }
    if (id == S_SEIZE) {
      return seizeCount(playerBoard.value) > 0
    }
    if (id == S_STRIP) {
      return stripChoice(playerBoard.value) >= 0
    }
    if (id == S_SHUNT) {
      // 能把你顶爆才值得烧掉这张牌。顶不爆的话，
      // 挪给自己另一张牌总点数根本没变，白白少一张牌在桌上
      const worth = worthOf(card)
      return playerBoard.value.length > 0 && playerScore.value + worth > GOAL
    }
    if (id == S_MARTYR) {
      if (playerBoard.value.length == 0) {
        return false
      }
      // 自己已经爆了，烧掉这张正好退回线内，还顺手拆你一张 —— 一举两得
      if (dealerScore.value > GOAL) {
        return true
      }
      // 否则得你快凑齐了才值得拆，拆早了你还有的是时间重新垒
      return playerScore.value >= GOAL - 10
    }
    if (id == S_ECHO) {
      return dealerEchoChoice(true) >= 0
    }
    if (id == S_REFLECT) {
      // 你桌上得有他借得到的贴纸才值得横
      return dealerEchoChoice(false) >= 0
    }
    if (id == S_REGRET) {
      // 快贴顶了才舍得收回左边那张，给自己腾出继续要牌的空间
      return index > 0 && dealerScore.value >= GOAL - 3
    }
    if (id == S_BACKFLOW) {
      // 手上有会爆的牌就压回去一张
      return dealerHasBustCard()
    }
    if (id == S_TRADE) {
      // 手上有会爆的牌，正好塞给你换一张
      return dealerHasBustCard() && playerHand.value.length > 0
    }
    if (id == S_SWITCH || id == S_PURGE) {
      // 整手都是会爆的牌才值得掀桌
      return dealerAllBust()
    }
    if (id == S_COLLAPSE) {
      // 自己快贴顶了才舍得把左边那张翻负，翻一张等于退两倍点数
      return index > 0 && dealerScore.value >= GOAL - 3
    }
    if (id == S_ERODE) {
      // 你越接近目标，把你的大牌翻负越划算
      return playerScore.value >= GOAL - 12 && biggestOpen(playerBoard.value) >= 0
    }
    if (isCullSticker(id)) {
      // 扫场只看一件事：扫完自己是不是更接近目标了
      return cullWorthIt(id, index)
    }
    if (isFriskSticker(id)) {
      // 打散你手里的牌，你手上有牌才有意义
      return playerHand.value.length > 0
    }
    if (id == S_STEP) {
      // 手上有会爆的牌就过一手
      return dealerHasBustCard() && dealerCursor.value < dealerDeck.value.length
    }
    // 窃听对庄家没意义 —— 它本来就会算你的牌
    return false
  }

  // 模拟一遍扫场，看庄家扫完是不是更划算。方向也一并挑好
  function cullWorthIt(id : string, at : number) : boolean {
    if (at >= dealerBoard.value.length) {
      return false
    }
    const mode = dealerCullMode(id, at)
    const line = worthOf(dealerBoard.value[at])
    const scope = cullScopeOf(id)

    // 扫完之后自己桌上还剩什么
    let mine = dealerBoard.value
    if (scope == SCOPE_OWN || scope == SCOPE_ANY) {
      mine = keepAfterCull(dealerBoard.value, line, mode, at)
    }
    const after = bestTotal(mine)
    if (after > GOAL) {
      return false
    }
    // 对面被扫掉多少
    let hisAfter = playerScore.value
    if (scope == SCOPE_CROSS || scope == SCOPE_ANY) {
      hisAfter = bestTotal(keepAfterCull(playerBoard.value, line, mode, -1))
    }
    // 自己变好，或者把你削下去了，就值得
    return after > dealerScore.value || hisAfter < playerScore.value
  }

  function keepAfterCull(board : Card[], line : number, mode : number, keep : number) : Card[] {
    const left : Card[] = []
    for (let i = 0; i < board.length; i++) {
      if (i == keep) {
        left.push(board[i])
        continue
      }
      if (!overLine(board[i], line, mode)) {
        left.push(board[i])
      }
    }
    return left
  }

  // 这张牌过没过线。大于 / 小于 / 等于 / 奇 / 偶，五种尺子。
  // 算的是牌面点数加转嫁吞并堆上来的加成，但不看翻负 ——
  // 一张 K 就算被翻成了负的，比大小时它还是 10 点的牌
  function overLine(card : Card, line : number, mode : number) : boolean {
    const v = worthOf(card)
    if (mode == CULL_BIGGER) {
      return v > line
    }
    if (mode == CULL_SMALLER) {
      return v < line
    }
    if (mode == CULL_ODD) {
      return v % 2 != 0
    }
    if (mode == CULL_EVEN) {
      return v % 2 == 0
    }
    return v == line
  }

  // 庄家手上有没有一打出去就爆的牌
  function dealerHasBustCard() : boolean {
    for (let i = 0; i < dealerHand.value.length; i++) {
      if (dealerNextScore(dealerHand.value[i]) > GOAL) {
        return true
      }
    }
    return false
  }

  function dealerAllBust() : boolean {
    if (dealerHand.value.length == 0) {
      return false
    }
    for (let i = 0; i < dealerHand.value.length; i++) {
      if (dealerNextScore(dealerHand.value[i]) <= GOAL) {
        return false
      }
    }
    return true
  }

  // 把庄家盖着的牌全翻开
  function revealDealer() {
    if (dealerHiddenCount.value == 0) {
      return
    }
    const board = cloneBoard(dealerBoard.value)
    for (let i = 0; i < board.length; i++) {
      board[i].faceDown = false
    }
    dealerBoard.value = board
  }

  function cloneBoard(board : Card[]) : Card[] {
    const next : Card[] = []
    for (let i = 0; i < board.length; i++) {
      next.push(cloneCard(board[i]))
    }
    return next
  }

  // ---------- 贴纸效果 ----------

  function runEffect(rawId : string, byDealer : boolean, times : number, at : number) {
    // 洞察是加深版的窥探，连看三张
    if (rawId == S_INSIGHT) {
      doPeek(byDealer, INSIGHT_DEPTH * times)
      return
    }
    // 横置版跟对应的立即类共用同一套实现，只是动的张数可能不同
    const id = baseEffectOf(rawId)
    const count = countOf(rawId) * times

    if (id == S_BACKFLOW) {
      doBackflow(byDealer, count)
      return
    }
    if (id == S_TRADE) {
      doTrade(byDealer, count)
      return
    }
    if (id == S_SWITCH) {
      doSwitch()
      return
    }
    if (id == S_BORROW) {
      doBorrow(byDealer, count)
      return
    }
    if (id == S_STANDBY) {
      doStandby(byDealer, count)
      return
    }
    if (id == S_ECHO || id == S_REFLECT) {
      doEcho(byDealer, id == S_REFLECT, times)
      return
    }
    if (id == S_GRAFT) {
      doGraft(byDealer, at)
      return
    }
    if (id == S_REVIVE) {
      doRevive(byDealer)
      return
    }
    if (id == S_SEIZE) {
      doSeize(byDealer, at)
      return
    }
    if (id == S_STRIP) {
      doStrip(byDealer)
      return
    }
    if (id == S_SHUNT) {
      doShunt(byDealer, at)
      return
    }
    if (id == S_MARTYR) {
      doMartyr(byDealer, at)
      return
    }
    if (id == S_RECALL) {
      doRecall(byDealer, at)
      return
    }
    if (id == S_DEVOUR) {
      doDevour(byDealer, at)
      return
    }
    if (id == S_MORPH) {
      doMorph(byDealer, at)
      return
    }
    if (id == S_PURGE) {
      doPurge()
      return
    }
    if (isSwapSticker(id)) {
      doShift(byDealer, id, at)
      return
    }
    if (id == S_COLLAPSE) {
      doCollapse(byDealer, count, at)
      return
    }
    if (id == S_ERODE) {
      doErode(byDealer, count)
      return
    }
    if (id == S_STEP) {
      doStep(byDealer, count)
      return
    }
    if (id == S_CUTIN) {
      doCutIn(byDealer, at)
      return
    }
    if (isCullSticker(id) || isFriskSticker(id)) {
      // 同点要你先挑一张牌当尺子
      if (cullPicksTarget(id)) {
        doSamePick(byDealer, at)
        return
      }
      // 方向由发动的人当场定，写死方向的话这张贴纸就只能贴在一头了
      if (cullAsksDirection(id) && !byDealer) {
        pendingCullAt = at
        pendingCullId = id
        phase.value = 'cullpick'
        message.value = '【' + stickerAt(id).name + '】以 '
          + effectiveValue(playerBoard.value[at]) + ' 点为界，扫大的还是扫小的？'
        return
      }
      const mode = byDealer ? dealerCullMode(id, at) : cullModeOf(id)
      if (isFriskSticker(id)) {
        doFrisk(byDealer, id, at, mode)
      } else {
        doCull(byDealer, id, at, mode, -1)
      }
      return
    }
    if (id == S_PEEK) {
      doPeek(byDealer, count)
      return
    }
    if (id == S_STEAL) {
      doSteal(byDealer, count)
      return
    }
    if (id == S_GIVE) {
      doGive(byDealer, at)
      return
    }
    if (id == S_BEG) {
      doBeg(byDealer, times)
      return
    }
    if (id == S_BOOST) {
      // 强化：下一次横置的效果连发两次
      if (byDealer) {
        dealerBoost.value = true
      } else {
        playerBoost.value = true
        message.value = '【强化】已就位，你下一次横置的效果会连发两次。'
      }
      return
    }
    if (id == S_BUTTERFLY) {
      doButterfly(byDealer, times, at)
      return
    }
    if (id == S_CHEER) {
      doCheer(byDealer, at)
      return
    }
    if (id == S_SWAP) {
      doSwap(byDealer, times)
      return
    }
    if (id == S_TWINS) {
      doTwins(byDealer, times, at)
      return
    }
    if (id == S_RUTHLESS) {
      doRuthless(byDealer, times, at)
      return
    }
    if (id == S_REGRET) {
      doRegret(byDealer, times, at)
    }
  }

  // 狠心：挑自己桌上任意一张弃掉。固定弃左邻的话，这张贴纸能不能用
  // 就全看它落在什么位置，牌一摆下去就没得选了
  function doRuthless(byDealer : boolean, times : number, at : number) {
    if (byDealer) {
      let dropped = 0
      for (let i = 0; i < times; i++) {
        const pick = dealerCutChoice()
        if (pick < 0) {
          break
        }
        const card = dealerBoard.value[pick]
        dealerBoard.value = removeAt(dealerBoard.value, pick)
        dealerDiscard.value = pushCard(dealerDiscard.value, card)
        dropped = dropped + 1
      }
      if (dropped == 0) {
        return
      }
      message.value = '庄家【狠心】弃掉 ' + dropped.toString() + ' 张自己的牌，现在 '
        + dealerScore.value.toString() + ' 点。'
      return
    }

    if (playerBoard.value.length == 0) {
      message.value = '桌上没有牌可以弃。'
      return
    }
    // 强化翻倍时要连弃两张，一张一张地挑
    cutLeft = times
    phase.value = 'cutpick'
    message.value = cutLeft > 1
      ? '【狠心】点自己桌上的牌弃掉，还要挑 ' + cutLeft.toString() + ' 张。'
      : '【狠心】点自己桌上一张牌弃掉。'
  }

  // 庄家弃哪张：挑弃掉之后最接近 42 的那张。
  // 一张都不弃更好的话返回 -1，白白扔牌没意义
  function dealerCutChoice() : number {
    const board = dealerBoard.value
    if (board.length == 0) {
      return -1
    }
    const now = dealerScore.value
    let best = -1
    // 现在就爆了的话，任何能压回线内的弃法都比不动强
    let bestGap = now > GOAL ? 999 : GOAL - now
    for (let i = 0; i < board.length; i++) {
      const after = bestTotal(removeAt(board, i))
      const gap = after > GOAL ? 999 : GOAL - after
      if (gap < bestGap) {
        bestGap = gap
        best = i
      }
    }
    return best
  }

  // 你点了桌上一张牌，弃掉它
  function pickCut(index : number) {
    if (phase.value != 'cutpick' || index >= playerBoard.value.length) {
      return
    }
    const card = playerBoard.value[index]
    playerBoard.value = removeAt(playerBoard.value, index)
    playerDiscard.value = pushCard(playerDiscard.value, card)
    cutLeft = cutLeft - 1

    // 还欠一张，但桌上已经空了就只能作罢
    if (cutLeft > 0 && playerBoard.value.length > 0) {
      message.value = '【狠心】再点一张弃掉，还剩 ' + cutLeft.toString() + ' 张。'
      return
    }
    cutLeft = 0
    phase.value = 'player'
    message.value = '【狠心】弃掉 ' + cardText(card) + '，现在 '
      + playerScore.value.toString() + ' 点。'
    afterAction(false)
  }

  // 悔过：把左边那张牌收回手里，之后弃一张手牌
  function doRegret(byDealer : boolean, times : number, at : number) {
    let taken = 0
    let self = at
    for (let i = 0; i < times; i++) {
      const left = self - 1
      if (left < 0) {
        break
      }
      if (byDealer) {
        const card = dealerBoard.value[left]
        dealerBoard.value = removeAt(dealerBoard.value, left)
        // 收回来的牌重新算一张干净的手牌，横置状态和被改写的点数都清掉
        dealerHand.value = pushCard(dealerHand.value, freshCard(card))
      } else {
        const card = playerBoard.value[left]
        playerBoard.value = removeAt(playerBoard.value, left)
        playerHand.value = pushCard(playerHand.value, freshCard(card))
      }
      self = self - 1
      taken = taken + 1
    }
    if (taken == 0) {
      message.value = '左边没有牌可以收回。'
      return
    }

    if (byDealer) {
      for (let i = 0; i < taken; i++) {
        dealerDropWorst()
      }
      message.value = '庄家【悔过】收回 ' + taken + ' 张牌，现在 ' + dealerScore.value + ' 点。'
      return
    }
    dropLeft = taken
    phase.value = 'discard'
    message.value = '【悔过】收回 ' + taken + ' 张牌，点一张手牌弃掉。'
  }

  // 从桌上收回手里的牌要还原成没打出过的样子
  function freshCard(origin : Card) : Card {
    const card = cloneCard(origin)
    card.tapped = false
    card.forced = -1
    card.faceDown = false
    card.negated = false
    // 转嫁来的点数、化形塞的候选值也一并清掉 —— 收回手里的牌要干干净净，
    // 不然再打出去还带着上一轮的加成
    card.extra = 0
    card.altValue = -1
    return card
  }

  // 牌换到对方桌上就不再是暗牌了
  function faceUp(origin : Card) : Card {
    const card = cloneCard(origin)
    card.faceDown = false
    return card
  }

  // 崩落：把自己左边那张牌强制翻负。牌还留在桌上，只是从加分变成了扣分
  function doCollapse(byDealer : boolean, count : number, at : number) {
    const board = cloneBoard(byDealer ? dealerBoard.value : playerBoard.value)
    if (at >= board.length) {
      return
    }
    let done = 0
    for (let i = 1; i <= count; i++) {
      const left = at - i
      if (left < 0) {
        break
      }
      board[left].negated = true
      done = done + 1
    }
    if (done == 0) {
      message.value = '左边没有牌可以翻。'
      return
    }
    if (byDealer) {
      dealerBoard.value = board
      message.value = '庄家把自己左边 ' + done + ' 张牌翻成了负数。'
    } else {
      playerBoard.value = board
      message.value = '左边 ' + done + ' 张牌翻成负数，现在 ' + playerScore.value + ' 点。'
    }
  }

  // 侵蚀 / 蚕食：把对方桌上的牌强制翻成负数。一正一负，拉开的差距是点数的两倍。
  // 翻哪张由你挑 —— 有时候翻掉带贴纸的那张比翻最大的更值
  function doErode(byDealer : boolean, count : number) {
    if (byDealer) {
      // 庄家不用挑，直接照最大的翻
      const board = cloneBoard(playerBoard.value)
      let done = 0
      for (let i = 0; i < count; i++) {
        const at = biggestOpen(board)
        if (at < 0) {
          break
        }
        board[at].negated = true
        done = done + 1
      }
      if (done == 0) {
        message.value = '庄家没找到能翻的牌。'
        return
      }
      playerBoard.value = board
      message.value = '庄家把你 ' + done + ' 张牌翻成了负数，现在 ' + playerScore.value + ' 点。'
      return
    }

    if (biggestOpen(dealerBoard.value) < 0) {
      message.value = '庄家桌上没有能翻的牌。'
      return
    }
    strikeLeft = count
    phase.value = 'strike'
    message.value = '点庄家桌上的牌，把它强制翻成负数。'
  }

  // 你挑中了要翻负的那张
  function pickStrike(index : number) {
    if (phase.value != 'strike') {
      return
    }
    if (index >= dealerBoard.value.length) {
      return
    }
    if (dealerBoard.value[index].negated) {
      toast('这张已经是负的了，翻不动')
      return
    }

    const board = cloneBoard(dealerBoard.value)
    board[index].negated = true
    dealerBoard.value = board
    message.value = board[index].faceDown
      ? '翻了一张盖着的牌，不知道是什么，反正现在是负的。'
      : '把 ' + cardText(board[index]) + ' 翻成了负数，庄家 ' + dealerShown.value + ' 点。'

    strikeLeft = strikeLeft - 1
    if (strikeLeft > 0 && biggestOpen(dealerBoard.value) >= 0) {
      message.value = message.value + ' 还能再翻一张。'
      return
    }
    strikeLeft = 0
    phase.value = 'player'
    afterAction(false)
  }

  // 桌上还没被翻过、点数最大的那张。翻它收益最大
  function biggestOpen(board : Card[]) : number {
    let pick = -1
    for (let i = 0; i < board.length; i++) {
      if (board[i].negated) {
        continue
      }
      if (pick < 0 || worthOf(board[i]) > worthOf(board[pick])) {
        pick = i
      }
    }
    return pick
  }

  // 垫脚：多摸一张再弃一张，等于把牌库顶那张过一遍手
  function doStep(byDealer : boolean, count : number) {
    if (byDealer) {
      for (let i = 0; i < count; i++) {
        if (dealerCursor.value >= dealerDeck.value.length) {
          break
        }
        dealerHand.value = pushCard(dealerHand.value, cloneCard(dealerDeck.value[dealerCursor.value]))
        dealerCursor.value = dealerCursor.value + 1
        dealerDropWorst()
      }
      message.value = '庄家过了一手牌。'
      return
    }
    if (playerCursor.value >= playerDeck.value.length) {
      message.value = '牌库空了，摸不到牌。'
      return
    }
    const drawn = cloneCard(playerDeck.value[playerCursor.value])
    playerCursor.value = playerCursor.value + 1
    playerHand.value = pushCard(playerHand.value, drawn)
    pickMode = 'drop'
    dropLeft = count
    phase.value = 'discard'
    message.value = '摸到 ' + cardText(drawn) + '，挑一张手牌弃掉。'
  }

  // 插队：把刚打出的这张挪到桌上别的位置。
  // 位置决定谁是它的左邻，也决定它当了谁的左邻 —— 左邻系全看这个
  function doCutIn(byDealer : boolean, at : number) {
    if (byDealer) {
      dealerCutIn(at)
      return
    }
    if (playerBoard.value.length <= 1) {
      message.value = '桌上就这一张，插不了队。'
      return
    }
    insertFrom = at
    phase.value = 'insert'
    message.value = '点自己桌上一张牌，把这张插到它左边。'
  }

  // 你挑中了要插到谁的左边
  function pickInsert(index : number) {
    if (phase.value != 'insert') {
      return
    }
    const from = insertFrom
    insertFrom = -1
    phase.value = 'player'

    if (index >= playerBoard.value.length || index == from) {
      message.value = '位置没变。'
      afterAction(false)
      return
    }
    playerBoard.value = moveCard(playerBoard.value, from, index)
    message.value = '插好了队，现在 ' + playerScore.value + ' 点。'
    afterAction(false)
  }

  // 把 from 位置的牌抽出来，插到 to 的左边
  function moveCard(board : Card[], from : number, to : number) : Card[] {
    const card = board[from]
    const rest = removeAt(board, from)
    // 抽走之后右边的牌都往左移了一格，目标下标要跟着挪
    const target = to > from ? to - 1 : to
    const next : Card[] = []
    for (let i = 0; i < rest.length; i++) {
      if (i == target) {
        next.push(card)
      }
      next.push(rest[i])
    }
    if (target >= rest.length) {
      next.push(card)
    }
    return next
  }

  // 庄家插队：往最小的那张右边插，「较劲」这类比左邻大就加分的贴纸能吃满
  function dealerCutIn(at : number) {
    if (dealerBoard.value.length <= 1) {
      return
    }
    let small = 0
    for (let i = 0; i < dealerBoard.value.length; i++) {
      if (i != at && worthOf(dealerBoard.value[i]) < worthOf(dealerBoard.value[small])) {
        small = i
      }
    }
    // 插到最小那张的右边，也就是它右邻的位置
    dealerBoard.value = moveCard(dealerBoard.value, at, small + 1)
    message.value = '庄家把刚打的牌插到了别处。'
  }

  // 门槛系：拿这张牌的点数当尺子，把桌上过线的牌一律扫进弃牌堆。
  // 尺子就是它自己的点数，所以贴在几点上，这张贴纸就有多强
  // line 传 -1 表示拿发起这张牌自己的点数当尺子；
  // 同点会把你挑中的那张牌的点数传进来
  function doCull(byDealer : boolean, id : string, at : number, mode : number, line : number) {
    const own = byDealer ? dealerBoard.value : playerBoard.value
    if (at >= own.length) {
      return
    }
    const rule = line >= 0 ? line : worthOf(own[at])
    const scope = cullScopeOf(id)
    const flips = cullFlipsInstead(id)

    let mine = 0
    let his = 0
    // 扫自己这边：发起的那张牌自己不算在内
    if (scope == SCOPE_OWN || scope == SCOPE_ANY) {
      mine = flips ? flipBoard(byDealer, rule, mode, at) : cullBoard(byDealer, rule, mode, at)
    }
    // 扫对面
    if (scope == SCOPE_CROSS || scope == SCOPE_ANY) {
      his = flips ? flipBoard(!byDealer, rule, mode, -1) : cullBoard(!byDealer, rule, mode, -1)
    }

    const word = cullWord(mode, rule)
    const act = flips ? '翻负' : '扫掉'
    if (mine + his == 0) {
      message.value = '桌上没有' + word + '的牌。'
      return
    }
    if (byDealer) {
      message.value = '庄家' + act + '了 ' + (mine + his) + ' 张' + word + '的牌。'
    } else {
      message.value = act + ' ' + (mine + his) + ' 张' + word + '的牌，现在 '
        + playerScore.value + ' 点。'
    }
    checkInstantEnd()
  }

  // 同点：先挑一张牌当尺子，再把全场同点数的都扫掉
  function doSamePick(byDealer : boolean, at : number) {
    if (byDealer) {
      // 庄家自己挑：哪个点数在你桌上出现得最多就扫哪个
      const line = dealerBestSameLine()
      if (line < 0) {
        message.value = '庄家的【同点】没找到可扫的。'
        return
      }
      doCull(true, S_SAME, at, CULL_EQUAL, line)
      return
    }
    if (playerBoard.value.length + dealerBoard.value.length == 0) {
      message.value = '场上没有牌可挑。'
      return
    }
    sameFrom = at
    phase.value = 'samepick'
    message.value = '挑场上一张牌，全场跟它同点数的牌都会被扫掉。'
  }

  // 你挑中了当尺子的那张牌
  function pickSame(fromDealer : boolean, index : number) {
    if (phase.value != 'samepick') {
      return
    }
    const board = fromDealer ? dealerBoard.value : playerBoard.value
    if (index >= board.length) {
      return
    }
    if (fromDealer && board[index].faceDown) {
      toast('盖着的牌看不出点数，挑不了')
      return
    }
    const line = worthOf(board[index])
    const at = sameFrom
    sameFrom = -1
    phase.value = 'player'
    doCull(false, S_SAME, at, CULL_EQUAL, line)
    if (phase.value == 'player') {
      afterAction(false)
    }
  }

  // 庄家挑哪个点数：数一遍你桌上哪个点数最多，扫它
  function dealerBestSameLine() : number {
    let best = -1
    let most = 0
    for (let i = 0; i < playerBoard.value.length; i++) {
      const v = worthOf(playerBoard.value[i])
      let count = 0
      for (let k = 0; k < playerBoard.value.length; k++) {
        if (worthOf(playerBoard.value[k]) == v) {
          count = count + 1
        }
      }
      if (count > most) {
        most = count
        best = v
      }
    }
    return best
  }

  // 扫的是哪一类牌，说人话
  function cullWord(mode : number, line : number) : string {
    if (mode == CULL_ODD) {
      return '奇数'
    }
    if (mode == CULL_EVEN) {
      return '偶数'
    }
    if (mode == CULL_BIGGER) {
      return '比 ' + line + ' 点大'
    }
    if (mode == CULL_SMALLER) {
      return '比 ' + line + ' 点小'
    }
    return '正好 ' + line + ' 点'
  }

  // 你自己定扫哪边。拿奇偶当尺子的那几张问的是奇/偶，其余问的是大/小
  function chooseCull(first : boolean) {
    if (phase.value != 'cullpick') {
      return
    }
    const at = pendingCullAt
    const id = pendingCullId
    pendingCullAt = -1
    pendingCullId = S_NONE
    phase.value = 'player'

    let mode = first ? CULL_BIGGER : CULL_SMALLER
    if (isParityCull(id)) {
      mode = first ? CULL_ODD : CULL_EVEN
    }
    if (isFriskSticker(id)) {
      doFrisk(false, id, at, mode)
    } else {
      doCull(false, id, at, mode, -1)
    }
    if (phase.value == 'player') {
      afterAction(false)
    }
  }

  // 搜身 / 肃清：拿点数当尺子扫手牌。
  // 手牌弃掉会立刻补满，所以这不是让对方少牌，是把他攒好的一手打散
  function doFrisk(byDealer : boolean, id : string, at : number, mode : number) {
    const own = byDealer ? dealerBoard.value : playerBoard.value
    if (at >= own.length) {
      return
    }
    const line = effectiveValue(own[at])
    const scope = friskScopeOf(id)

    let his = friskHand(!byDealer, line, mode)
    let mine = 0
    if (scope == SCOPE_ANY) {
      mine = friskHand(byDealer, line, mode)
    }

    if (mine + his == 0) {
      message.value = '手牌里没有过线的牌。'
      return
    }
    const word = mode == CULL_BIGGER ? '更大' : (mode == CULL_SMALLER ? '更小' : '一样大')
    if (byDealer) {
      message.value = '庄家以 ' + line + ' 点为界，抽走了你 ' + his + ' 张' + word + '的手牌。'
    } else {
      message.value = '以 ' + line + ' 点为界扫掉庄家 ' + his + ' 张手牌'
        + (mine > 0 ? '，自己也弃了 ' + mine + ' 张' : '') + '，各自补满。'
    }
  }

  // 扫掉一方手牌里过线的，然后补满。返回扫掉几张
  function friskHand(onDealer : boolean, line : number, mode : number) : number {
    const hand = onDealer ? dealerHand.value : playerHand.value
    const left : Card[] = []
    const gone : Card[] = []
    for (let i = 0; i < hand.length; i++) {
      const v = worthOf(hand[i])
      const over = mode == CULL_BIGGER
        ? v > line
        : (mode == CULL_SMALLER ? v < line : v == line)
      if (over) {
        gone.push(hand[i])
      } else {
        left.push(hand[i])
      }
    }
    if (gone.length == 0) {
      return 0
    }
    if (onDealer) {
      dealerHand.value = left
      dealerDiscard.value = pushCards(dealerDiscard.value, gone)
      tidyDealerHand()
    } else {
      playerHand.value = left
      playerDiscard.value = pushCards(playerDiscard.value, gone)
      tidyPlayerHand()
    }
    return gone.length
  }

  // 庄家扫哪边：两个方向都模拟一遍，挑对自己更划算的
  function dealerCullMode(id : string, at : number) : number {
    if (!cullAsksDirection(id)) {
      return cullModeOf(id)
    }
    const big = cullScoreFor(id, at, CULL_BIGGER)
    const small = cullScoreFor(id, at, CULL_SMALLER)
    return big >= small ? CULL_BIGGER : CULL_SMALLER
  }

  // 按某个方向扫完之后，庄家的处境有多好：自己越接近目标、你越远越好
  function cullScoreFor(id : string, at : number, mode : number) : number {
    if (at >= dealerBoard.value.length) {
      return -999
    }
    // 扫手牌的那两张不影响桌面点数，只按能打散你几张牌算收益
    if (isFriskSticker(id)) {
      return countOverLine(playerHand.value, effectiveValue(dealerBoard.value[at]), mode)
    }
    const line = effectiveValue(dealerBoard.value[at])
    const scope = cullScopeOf(id)
    let mine = dealerBoard.value
    if (scope == SCOPE_OWN || scope == SCOPE_ANY) {
      mine = keepAfterCull(dealerBoard.value, line, mode, at)
    }
    const after = bestTotal(mine)
    if (after > GOAL) {
      return -999
    }
    let yours = playerScore.value
    if (scope == SCOPE_CROSS || scope == SCOPE_ANY) {
      yours = bestTotal(keepAfterCull(playerBoard.value, line, mode, -1))
    }
    return after - yours
  }

  function countOverLine(hand : Card[], line : number, mode : number) : number {
    let total = 0
    for (let i = 0; i < hand.length; i++) {
      const v = worthOf(hand[i])
      const over = mode == CULL_BIGGER
        ? v > line
        : (mode == CULL_SMALLER ? v < line : v == line)
      if (over) {
        total = total + 1
      }
    }
    return total
  }

  // 把一侧桌上过线的牌扫进弃牌堆，返回扫掉几张。keep 是要留下的那张的下标
  // 偏科不弃牌，只把扫中的翻负 —— 牌留在桌上，但从加分变成了扣分
  function flipBoard(onDealer : boolean, line : number, mode : number, keep : number) : number {
    const board = cloneBoard(onDealer ? dealerBoard.value : playerBoard.value)
    let hit = 0
    for (let i = 0; i < board.length; i++) {
      if (i == keep || board[i].negated) {
        continue
      }
      if (overLine(board[i], line, mode)) {
        board[i].negated = true
        hit = hit + 1
      }
    }
    if (hit == 0) {
      return 0
    }
    if (onDealer) {
      dealerBoard.value = board
    } else {
      playerBoard.value = board
    }
    return hit
  }

  function cullBoard(onDealer : boolean, line : number, mode : number, keep : number) : number {
    const board = onDealer ? dealerBoard.value : playerBoard.value
    const left : Card[] = []
    const gone : Card[] = []
    for (let i = 0; i < board.length; i++) {
      if (i == keep) {
        left.push(board[i])
        continue
      }
      if (overLine(board[i], line, mode)) {
        gone.push(board[i])
      } else {
        left.push(board[i])
      }
    }
    if (gone.length == 0) {
      return 0
    }
    if (onDealer) {
      dealerBoard.value = left
      dealerDiscard.value = pushCards(dealerDiscard.value, gone)
    } else {
      playerBoard.value = left
      playerDiscard.value = pushCards(playerDiscard.value, gone)
    }
    return gone.length
  }

  // 换位：拿这张贴纸牌本身去跟另一张对调。
  // 同侧就是换排列顺序（「左边那张牌」系列会认新邻居），
  // 异侧则是把它连同点数一起送到对面，再把对面那张换过来
  function doShift(byDealer : boolean, id : string, at : number) {
    const scope = swapScopeOf(id)
    if (byDealer) {
      dealerShift(scope, at)
      return
    }
    if (!canShift(scope)) {
      message.value = '桌上没有能跟它对调的牌。'
      return
    }
    swapScope = scope
    swapSelfAt = at
    phase.value = 'swap'
    message.value = scope == SCOPE_CROSS
      ? '挑一张庄家桌上的牌，跟这张对调。'
      : (scope == SCOPE_ANY ? '全场任选一张牌，跟这张对调。' : '挑自己桌上另一张牌跟它对调。')
  }

  // 这个范围下有没有牌可以跟它换
  function canShift(scope : number) : boolean {
    if (scope == SCOPE_CROSS) {
      return dealerBoard.value.length > 0
    }
    if (scope == SCOPE_ANY) {
      return playerBoard.value.length >= 2 || dealerBoard.value.length > 0
    }
    return playerBoard.value.length >= 2
  }

  // 庄家桌上的牌平时不能点，只有在挑对调目标或挑翻负目标时才响应
  function tapDealerCard(index : number) {
    if (phase.value == 'swap') {
      pickSwap(true, index)
      return
    }
    // 返照阶段点庄家桌上的牌是挑借哪张来用
    if (phase.value == 'echopick') {
      pickEcho(true, index)
      return
    }
    // 夺取阶段点庄家桌上的牌是挑搬哪张贴纸
    if (phase.value == 'seizepick') {
      pickSeize(index)
      return
    }
    // 祛除阶段点庄家桌上的牌是拆他的贴纸
    if (phase.value == 'strippick') {
      pickStrip(true, index)
      return
    }
    // 转嫁阶段点庄家桌上的牌是把点数塞给他
    if (phase.value == 'shuntpick') {
      pickShunt(true, index)
      return
    }
    // 献身阶段点庄家桌上的牌是挑拉谁一起下场
    if (phase.value == 'martyrpick') {
      pickMartyr(index)
      return
    }
    if (phase.value == 'samepick') {
      pickSame(true, index)
      return
    }
    if (phase.value == 'strike') {
      pickStrike(index)
    }
  }

  // 你挑中了要跟贴纸牌对调的那张
  function pickSwap(fromDealer : boolean, index : number) {
    if (phase.value != 'swap') {
      return
    }
    const board = fromDealer ? dealerBoard.value : playerBoard.value
    if (index >= board.length) {
      return
    }
    if (!fromDealer && index == swapSelfAt) {
      toast('不能跟它自己换')
      return
    }
    if (swapScope == SCOPE_OWN && fromDealer) {
      toast('这张贴纸只能换自己桌上的牌')
      return
    }
    if (swapScope == SCOPE_CROSS && !fromDealer) {
      toast('这张贴纸要拿去跟庄家的牌换')
      return
    }

    applyShift(false, swapSelfAt, fromDealer, index)
    swapSelfAt = -1
    phase.value = 'player'
    afterAction(false)
  }

  // 真正把两张牌换过来
  function applyShift(aDealer : boolean, aAt : number, bDealer : boolean, bAt : number) {
    if (aDealer == bDealer) {
      // 同侧：只是换个排列顺序，点数总和不变
      const board = cloneBoard(aDealer ? dealerBoard.value : playerBoard.value)
      const tmp = board[aAt]
      board[aAt] = board[bAt]
      board[bAt] = tmp
      if (aDealer) {
        dealerBoard.value = board
      } else {
        playerBoard.value = board
      }
      message.value = '两张牌换了位置。'
      return
    }

    // 异侧：牌连着点数一起搬过去，盖着的牌到了对面就得翻明
    const mine = cloneBoard(playerBoard.value)
    const his = cloneBoard(dealerBoard.value)
    const myAt = aDealer ? bAt : aAt
    const hisAt = aDealer ? aAt : bAt
    const myCard = faceUp(mine[myAt])
    const hisCard = faceUp(his[hisAt])
    mine[myAt] = hisCard
    his[hisAt] = myCard
    playerBoard.value = mine
    dealerBoard.value = his
    message.value = '把 ' + cardText(myCard) + ' 和庄家的 ' + cardText(hisCard) + ' 对调了。'
  }

  // 庄家换位：拿这张贴纸牌去换你桌上最小的那张，把点数甩过来
  function dealerShift(scope : number, at : number) {
    if (scope == SCOPE_OWN) {
      // 纯换位置对庄家没什么好算的，跳过
      return
    }
    if (playerBoard.value.length == 0 || at >= dealerBoard.value.length) {
      return
    }
    let mineAt = 0
    for (let i = 1; i < playerBoard.value.length; i++) {
      if (worthOf(playerBoard.value[i]) < worthOf(playerBoard.value[mineAt])) {
        mineAt = i
      }
    }
    // 自己这张比你那张大才划算，否则换了反而给你送分
    if (worthOf(dealerBoard.value[at]) <= worthOf(playerBoard.value[mineAt])) {
      return
    }
    applyShift(true, at, false, mineAt)
    message.value = '庄家把 ' + cardText(playerBoard.value[mineAt]) + ' 换走了。'
  }

  // 回流：挑一张自己的手牌压回牌库底，补一张。压到底基本等于这局不会再见到它
  function doBackflow(byDealer : boolean, count : number) {
    if (byDealer) {
      for (let i = 0; i < count; i++) {
        dealerSinkWorst()
      }
      message.value = '庄家把手牌压回了牌库底。'
      return
    }
    if (playerHand.value.length == 0) {
      message.value = '手上没牌可压。'
      return
    }
    pickMode = 'sink'
    dropLeft = count
    phase.value = 'discard'
    message.value = '点一张手牌压回牌库底。'
  }

  // 互市 / 潜渡：挑一张手牌给对方，再从对方手里随机换回一张
  function doTrade(byDealer : boolean, count : number) {
    if (byDealer) {
      for (let i = 0; i < count; i++) {
        dealerTradeOnce()
      }
      message.value = '庄家跟你换了张牌。'
      return
    }
    if (playerHand.value.length == 0 || dealerHand.value.length == 0) {
      message.value = '有一方手上没牌，换不成。'
      return
    }
    pickMode = 'trade'
    dropLeft = count
    phase.value = 'discard'
    message.value = '点一张手牌递给庄家，随机换回他的一张。'
  }

  // 易主：双方手牌整个对调
  function doSwitch() {
    const mine = playerHand.value
    playerHand.value = dealerHand.value
    dealerHand.value = mine
    tidyPlayerHand()
    tidyDealerHand()
    message.value = '双方手牌整个对调了。'
  }

  // 清算：双方手牌全部弃掉，各自重新补满
  function doPurge() {
    playerDiscard.value = pushCards(playerDiscard.value, playerHand.value)
    playerHand.value = [] as Card[]
    tidyPlayerHand()
    dealerDiscard.value = pushCards(dealerDiscard.value, dealerHand.value)
    dealerHand.value = [] as Card[]
    tidyDealerHand()
    message.value = '双方手牌全部清空，各自重新补满。'
  }

  // 随机弃掉一方的一张手牌，然后补满
  function dropRandom(byDealer : boolean) {
    if (byDealer) {
      if (dealerHand.value.length == 0) {
        return
      }
      const at = Math.floor(Math.random() * dealerHand.value.length)
      const card = dealerHand.value[at]
      dealerHand.value = removeAt(dealerHand.value, at)
      dealerDiscard.value = pushCard(dealerDiscard.value, card)
      tidyDealerHand()
      return
    }
    if (playerHand.value.length == 0) {
      return
    }
    const at = Math.floor(Math.random() * playerHand.value.length)
    const card = playerHand.value[at]
    playerHand.value = removeAt(playerHand.value, at)
    playerDiscard.value = pushCard(playerDiscard.value, card)
    tidyPlayerHand()
  }

  // 庄家版的回流：把打出去最容易爆的那张压回牌库底
  function dealerSinkWorst() {
    if (dealerHand.value.length == 0) {
      return
    }
    let worst = 0
    for (let i = 1; i < dealerHand.value.length; i++) {
      if (dealerNextScore(dealerHand.value[i]) > dealerNextScore(dealerHand.value[worst])) {
        worst = i
      }
    }
    const card = dealerHand.value[worst]
    dealerHand.value = removeAt(dealerHand.value, worst)
    dealerDeck.value = pushCard(dealerDeck.value, card)
    tidyDealerHand()
  }

  // 庄家版的互市：把最会爆的那张塞给你，随机换你一张
  function dealerTradeOnce() {
    if (dealerHand.value.length == 0 || playerHand.value.length == 0) {
      return
    }
    let worst = 0
    for (let i = 1; i < dealerHand.value.length; i++) {
      if (dealerNextScore(dealerHand.value[i]) > dealerNextScore(dealerHand.value[worst])) {
        worst = i
      }
    }
    const given = dealerHand.value[worst]
    dealerHand.value = removeAt(dealerHand.value, worst)

    const at = Math.floor(Math.random() * playerHand.value.length)
    const taken = playerHand.value[at]
    playerHand.value = removeAt(playerHand.value, at)

    playerHand.value = pushCard(playerHand.value, given)
    dealerHand.value = pushCard(dealerHand.value, taken)
  }

  // 置换：手牌全弃掉，多弃少补会立刻补满，等于换一手牌
  function doSwap(byDealer : boolean, times : number) {
    for (let i = 0; i < times; i++) {
      if (byDealer) {
        dealerDiscard.value = pushCards(dealerDiscard.value, dealerHand.value)
        dealerHand.value = [] as Card[]
        tidyDealerHand()
      } else {
        playerDiscard.value = pushCards(playerDiscard.value, playerHand.value)
        playerHand.value = [] as Card[]
        tidyPlayerHand()
      }
    }
    message.value = byDealer ? '庄家换了一手牌。' : '你把手牌全弃了，重新补满。'
  }

  // 双子：把牌库里所有相同基础点数的牌摊开，自己挑一张进手牌，再弃掉一张手牌
  function doTwins(byDealer : boolean, times : number, at : number) {
    const board = byDealer ? dealerBoard.value : playerBoard.value
    if (at >= board.length) {
      return
    }
    const worth = shownValue(board[at])

    if (byDealer) {
      // 庄家自己挑：优先带贴纸的那张
      if (dealerDrawTwin(worth)) {
        dealerDropWorst()
        message.value = '庄家用【双子】从牌库找来一张 ' + worth + ' 点的牌。'
      } else {
        message.value = '庄家的【双子】没找到 ' + worth + ' 点的牌。'
      }
      return
    }

    // 你来挑：把候选全摊出来
    twinAt = [] as number[]
    const picks : Card[] = []
    for (let i = playerCursor.value; i < playerDeck.value.length; i++) {
      if (shownValue(playerDeck.value[i]) == worth) {
        twinAt.push(i)
        picks.push(cloneCard(playerDeck.value[i]))
      }
    }
    if (picks.length == 0) {
      message.value = '牌库里没有 ' + worth + ' 点的牌了。'
      return
    }
    twinPicks.value = picks
    phase.value = 'pick'
    message.value = '【双子】摊开了牌库里 ' + picks.length + ' 张 ' + worth + ' 点的牌，挑一张。'
  }

  // 你从摊开的候选里挑中了一张
  function pickTwin(index : number) {
    if (phase.value != 'pick') {
      return
    }
    if (index >= twinAt.length) {
      return
    }
    const deckAt = twinAt[index]
    const picked = cloneCard(playerDeck.value[deckAt])

    const next : Card[] = []
    for (let i = 0; i < playerDeck.value.length; i++) {
      if (i != deckAt) {
        next.push(playerDeck.value[i])
      }
    }
    playerDeck.value = next
    playerHand.value = pushCard(playerHand.value, picked)

    twinPicks.value = [] as Card[]
    twinAt = [] as number[]
    dropLeft = 1
    phase.value = 'discard'
    message.value = '拿到 ' + cardText(picked) + '，现在点一张手牌弃掉。'
  }

  // 庄家版的双子：不摊牌，直接挑带贴纸的那张
  function dealerDrawTwin(worth : number) : boolean {
    let found = -1
    for (let i = dealerCursor.value; i < dealerDeck.value.length; i++) {
      if (shownValue(dealerDeck.value[i]) != worth) {
        continue
      }
      if (dealerDeck.value[i].stickerKey != S_NONE) {
        found = i
        break
      }
      if (found < 0) {
        found = i
      }
    }
    if (found < 0) {
      return false
    }

    const picked = cloneCard(dealerDeck.value[found])
    const next : Card[] = []
    for (let i = 0; i < dealerDeck.value.length; i++) {
      if (i != found) {
        next.push(dealerDeck.value[i])
      }
    }
    dealerDeck.value = next
    dealerHand.value = pushCard(dealerHand.value, picked)
    return true
  }

  // 庄家弃牌：扔掉打出去最容易爆的那张
  function dealerDropWorst() {
    if (dealerHand.value.length == 0) {
      return
    }
    let worst = 0
    for (let i = 1; i < dealerHand.value.length; i++) {
      if (dealerNextScore(dealerHand.value[i]) > dealerNextScore(dealerHand.value[worst])) {
        worst = i
      }
    }
    const card = dealerHand.value[worst]
    dealerHand.value = removeAt(dealerHand.value, worst)
    dealerDiscard.value = pushCard(dealerDiscard.value, card)
  }

  // 双子之后你要弃的牌还剩几张
  // 挑一张手牌处理掉。同一个选牌界面被三种效果共用，靠 pickMode 区分去向
  function dropCard(index : number) {
    if (phase.value != 'discard') {
      return
    }
    if (index >= playerHand.value.length) {
      return
    }
    const card = playerHand.value[index]
    playerHand.value = removeAt(playerHand.value, index)

    if (pickMode == 'sink') {
      // 回流：压到牌库最底下，这局多半再也摸不到
      playerDeck.value = pushCard(playerDeck.value, card)
      message.value = '把 ' + cardText(card) + ' 压回了牌库底。'
    } else if (pickMode == 'trade') {
      // 互市：递给庄家，再从他手里随机抽一张回来
      dealerHand.value = pushCard(dealerHand.value, card)
      if (dealerHand.value.length > 1) {
        const at = Math.floor(Math.random() * (dealerHand.value.length - 1))
        const taken = dealerHand.value[at]
        dealerHand.value = removeAt(dealerHand.value, at)
        playerHand.value = pushCard(playerHand.value, taken)
        message.value = '递出 ' + cardText(card) + '，换回了 ' + cardText(taken) + '。'
      } else {
        message.value = '递出 ' + cardText(card) + '，庄家没牌可换给你。'
      }
    } else {
      playerDiscard.value = pushCard(playerDiscard.value, card)
      message.value = '弃掉了 ' + cardText(card) + '。'
    }
    tidyPlayerHand()

    dropLeft = dropLeft - 1
    if (dropLeft > 0 && playerHand.value.length > 0) {
      message.value = message.value + ' 还要再挑一张。'
      return
    }
    dropLeft = 0
    pickMode = 'drop'
    phase.value = 'player'
    afterAction(false)
  }

  // 蝴蝶：把左边那张牌的点数改成和这张牌一样。翻倍时接着往左再改一张
  function doButterfly(byDealer : boolean, times : number, at : number) {
    const board = cloneBoard(byDealer ? dealerBoard.value : playerBoard.value)
    if (at >= board.length) {
      return
    }
    const worth = shownValue(board[at])
    let changed = 0
    for (let i = 1; i <= times; i++) {
      const left = at - i
      if (left < 0) {
        break
      }
      board[left].forced = worth
      changed = changed + 1
    }
    if (changed == 0) {
      message.value = byDealer ? '庄家的【蝴蝶】左边没有牌。' : '这张【蝴蝶】左边没有牌可改。'
      return
    }

    if (byDealer) {
      dealerBoard.value = board
      message.value = '庄家发动【蝴蝶】，左边 ' + changed + ' 张牌都变成 ' + worth + ' 点。'
    } else {
      playerBoard.value = board
      message.value = '发动【蝴蝶】，左边 ' + changed + ' 张牌都变成 ' + worth + ' 点，现在 '
        + playerScore.value + ' 点。'
    }
    checkInstantEnd()
  }

  // 窥：看一眼牌库顶，可以把它压到牌底
  function doPeek(byDealer : boolean, times : number) {
    if (byDealer) {
      for (let i = 0; i < times; i++) {
        dealerPeekOnce()
      }
      return
    }
    if (playerCursor.value >= playerDeck.value.length) {
      toast('牌库已经空了')
      return
    }
    // 翻倍的窥探就是连看两张，看完第一张再接着处理第二张
    peekLeft = times - 1
    peekCard.value = cloneCard(playerDeck.value[playerCursor.value])
    phase.value = 'peek'
    message.value = '牌库顶是 ' + cardText(peekCard.value) + '，留着还是压到牌底？'
  }

  function finishPeek(toBottom : boolean) {
    if (phase.value != 'peek') {
      return
    }
    if (toBottom) {
      sinkPlayerTop()
      message.value = '把 ' + cardText(peekCard.value) + ' 压到了牌库底。'
      // 会用窥探改牌序了，才配拿到它的加强版
      gainAchievement(ACH_FORESEE)
    } else {
      message.value = '把 ' + cardText(peekCard.value) + ' 留在了牌库顶。'
    }

    if (peekLeft > 0 && playerCursor.value < playerDeck.value.length) {
      peekLeft = peekLeft - 1
      peekCard.value = cloneCard(playerDeck.value[playerCursor.value])
      message.value = '再看一张：牌库顶是 ' + cardText(peekCard.value) + '。'
      return
    }
    peekLeft = 0
    phase.value = 'player'
  }

  // 把牌库顶那张挪到牌库最后，游标不动
  function sinkPlayerTop() {
    const deck : Card[] = []
    const top = playerDeck.value[playerCursor.value]
    for (let i = 0; i < playerDeck.value.length; i++) {
      if (i != playerCursor.value) {
        deck.push(playerDeck.value[i])
      }
    }
    deck.push(top)
    playerDeck.value = deck
  }

  function dealerPeekOnce() {
    if (dealerCursor.value >= dealerDeck.value.length) {
      return
    }
    const top = dealerDeck.value[dealerCursor.value]
    // 摸上来就会爆的牌，庄家会把它压到底
    if (dealerScore.value + top.value <= GOAL) {
      return
    }
    const deck : Card[] = []
    for (let i = 0; i < dealerDeck.value.length; i++) {
      if (i != dealerCursor.value) {
        deck.push(dealerDeck.value[i])
      }
    }
    deck.push(top)
    dealerDeck.value = deck
  }

  // 盗：随机偷对方一张手牌弃掉，对方立刻补一张
  function doSteal(byDealer : boolean, times : number) {
    let taken = 0
    for (let i = 0; i < times; i++) {
      if (byDealer) {
        if (playerHand.value.length == 0) {
          break
        }
        const at = Math.floor(Math.random() * playerHand.value.length)
        const card = playerHand.value[at]
        playerHand.value = removeAt(playerHand.value, at)
        playerDiscard.value = pushCard(playerDiscard.value, card)
        tidyPlayerHand()
        taken = taken + 1
      } else {
        if (dealerHand.value.length == 0) {
          break
        }
        const at = Math.floor(Math.random() * dealerHand.value.length)
        const card = dealerHand.value[at]
        dealerHand.value = removeAt(dealerHand.value, at)
        dealerDiscard.value = pushCard(dealerDiscard.value, card)
        tidyDealerHand()
        taken = taken + 1
      }
    }
    if (taken == 0) {
      message.value = byDealer ? '庄家想偷牌，你手上没牌了。' : '庄家手上没牌可偷。'
      return
    }
    message.value = byDealer
      ? '庄家偷走并弃掉你 ' + taken + ' 张手牌，你补了 ' + taken + ' 张。'
      : '你偷走并弃掉庄家 ' + taken + ' 张手牌。'
  }

  // 转嫁：把这张牌的点数加到场上任意一张牌上，然后自己烧掉。
  // 加给庄家就是硬塞点数顶他爆；加给自己总点数不变，但把点数堆到了一张牌上 ——
  // 破碎翻负、双生的 11 减、削峰以自身为界，都吃这个堆高
  function doShunt(byDealer : boolean, at : number) {
    const own = byDealer ? dealerBoard.value : playerBoard.value
    if (at >= own.length) {
      return
    }
    const worth = worthOf(own[at])
    const other = byDealer ? playerBoard.value : dealerBoard.value
    // 除了转嫁自己，场上还有没有牌能接这点数
    if (own.length - 1 + other.length == 0) {
      message.value = '场上没有别的牌能接这点数。'
      burnOut(byDealer, at)
      return
    }

    if (byDealer) {
      // 能顶爆你就往你身上加；顶不爆就挪给自己另一张，点数本来就是他的
      if (playerBoard.value.length > 0 && playerScore.value + worth > GOAL) {
        addExtra(false, 0, worth)
        message.value = '庄家把 ' + worth.toString() + ' 点转嫁到了你的牌上。'
      } else {
        let target = -1
        for (let i = 0; i < dealerBoard.value.length; i++) {
          if (i != at) {
            target = i
            break
          }
        }
        if (target >= 0) {
          addExtra(true, target, worth)
          message.value = '庄家把 ' + worth.toString() + ' 点挪到了自己另一张牌上。'
        } else if (playerBoard.value.length > 0) {
          addExtra(false, 0, worth)
          message.value = '庄家把 ' + worth.toString() + ' 点转嫁到了你的牌上。'
        }
      }
      burnOut(true, at)
      return
    }
    shuntAt = at
    shuntWorth = worth
    phase.value = 'shuntpick'
    message.value = '【转嫁】把 ' + worth.toString() + ' 点加给场上任意一张牌，它自己烧掉。'
  }

  function addExtra(toDealer : boolean, index : number, worth : number) {
    const board = toDealer ? dealerBoard.value : playerBoard.value
    if (index >= board.length || index < 0) {
      return
    }
    const next = cloneBoard(board)
    next[index].extra = next[index].extra + worth
    if (toDealer) {
      dealerBoard.value = next
    } else {
      playerBoard.value = next
    }
  }

  // 你挑中了把点数加给谁
  function pickShunt(toDealer : boolean, index : number) {
    if (phase.value != 'shuntpick') {
      return
    }
    const board = toDealer ? dealerBoard.value : playerBoard.value
    if (index >= board.length) {
      return
    }
    if (!toDealer && index == shuntAt) {
      toast('不能加给转嫁自己，它马上就烧掉了')
      return
    }
    if (board[index].faceDown) {
      toast('这张牌还盖着，加不上去')
      return
    }
    addExtra(toDealer, index, shuntWorth)
    const worth = shuntWorth
    const self = shuntAt
    shuntWorth = 0
    shuntAt = -1
    // 点数交出去了，空壳撤下桌
    burnOut(false, self)
    phase.value = 'player'
    message.value = '【转嫁】把 ' + worth.toString() + ' 点加给了'
      + (toDealer ? '庄家' : '自己') + '的一张牌。'
    afterAction(false)
  }

  // 化形：烧掉自己，把自己的点数塞给另一张牌当候选。
  // 跟转嫁的区别在第几层：转嫁是第 4 层硬加（原值 + 10，可能把你顶爆），
  // 化形是第 3 层给选项（原值「或」10，结算时挑有利的，永远不亏）
  function doMorph(byDealer : boolean, at : number) {
    const board = byDealer ? dealerBoard.value : playerBoard.value
    if (at >= board.length) {
      return
    }
    if (board.length <= 1) {
      message.value = '桌上没有别的牌可以化形。'
      return
    }
    const worth = worthOf(board[at])
    if (byDealer) {
      const pick = morphChoice(dealerBoard.value, at, worth)
      if (pick < 0) {
        message.value = '庄家的【化形】没找到合适的目标。'
        return
      }
      setAltValue(true, pick, worth)
      burnOut(true, at)
      message.value = '庄家【化形】，把 ' + worth.toString() + ' 点变成了另一张牌的选择。'
      checkInstantEnd()
      return
    }
    morphAt = at
    morphWorth = worth
    phase.value = 'morphpick'
    message.value = '【化形】挑自己桌上一张牌，它从此还能按 ' + worth.toString() + ' 点算。'
  }

  // 塞给哪张最划算：挨个试一遍，看烧掉自己之后哪种摆法最接近 42
  function morphChoice(board : Card[], at : number, worth : number) : number {
    let best = -1
    let bestGap = 999
    for (let i = 0; i < board.length; i++) {
      if (i == at) {
        continue
      }
      const test = cloneBoard(board)
      test[i].altValue = worth
      const after = bestTotal(removeAt(test, at))
      const gap = after > GOAL ? 999 : GOAL - after
      if (gap < bestGap) {
        bestGap = gap
        best = i
      }
    }
    return best
  }

  function setAltValue(onDealer : boolean, index : number, worth : number) {
    const board = onDealer ? dealerBoard.value : playerBoard.value
    if (index >= board.length) {
      return
    }
    const next = cloneBoard(board)
    next[index].altValue = worth
    if (onDealer) {
      dealerBoard.value = next
    } else {
      playerBoard.value = next
    }
  }

  // 你挑中了要把点数塞给谁
  function pickMorph(index : number) {
    if (phase.value != 'morphpick' || index >= playerBoard.value.length) {
      return
    }
    if (index == morphAt) {
      toast('不能塞给化形自己，它马上就烧掉了')
      return
    }
    const worth = morphWorth
    const self = morphAt
    morphAt = -1
    morphWorth = 0
    setAltValue(false, index, worth)
    burnOut(false, self)
    phase.value = 'player'
    message.value = '【化形】那张牌从此还能按 ' + worth.toString() + ' 点算，现在 '
      + playerScore.value.toString() + ' 点。'
    afterAction(false)
  }

  // 吞并：弃一张手牌，把它的点数吃到这张牌上。
  // 跟移植正好凑成一对：同样是拆一张手牌，移植要的是它的贴纸，吞并要的是它的点数。
  // 手上一张贴了天灾的 K，拿效果还是拿 10 点，二选一
  function doDevour(byDealer : boolean, at : number) {
    const hand = byDealer ? dealerHand.value : playerHand.value
    if (hand.length == 0) {
      message.value = byDealer ? '庄家手上没牌可吞。' : '手上没有牌可以吞。'
      return
    }
    if (byDealer) {
      const pick = devourChoice(dealerHand.value, dealerScore.value)
      if (pick < 0) {
        message.value = '庄家的【吞并】没找到合用的牌。'
        return
      }
      applyDevour(true, at, pick)
      return
    }
    devourAt = at
    phase.value = 'devourpick'
    message.value = '【吞并】挑一张手牌弃掉，把它的点数吃过来。'
  }

  // 吞哪张：吃下去不能爆，越靠近 42 越好
  function devourChoice(hand : Card[], now : number) : number {
    let best = -1
    let bestGap = now > GOAL ? 999 : GOAL - now
    for (let i = 0; i < hand.length; i++) {
      const after = now + shownValue(hand[i])
      if (after > GOAL) {
        continue
      }
      const gap = GOAL - after
      if (gap < bestGap) {
        bestGap = gap
        best = i
      }
    }
    return best
  }

  function applyDevour(byDealer : boolean, at : number, handAt : number) {
    const hand = byDealer ? dealerHand.value : playerHand.value
    const board = byDealer ? dealerBoard.value : playerBoard.value
    if (at >= board.length || handAt >= hand.length) {
      return
    }
    const card = hand[handAt]
    const worth = shownValue(card)

    if (byDealer) {
      dealerHand.value = removeAt(dealerHand.value, handAt)
      dealerDiscard.value = pushCard(dealerDiscard.value, card)
      tidyDealerHand()
    } else {
      playerHand.value = removeAt(playerHand.value, handAt)
      playerDiscard.value = pushCard(playerDiscard.value, card)
      tidyPlayerHand()
    }

    addExtra(byDealer, at, worth)
    message.value = (byDealer ? '庄家吞掉 ' : '你吞掉 ') + cardText(card)
      + '，那张牌 +' + worth.toString() + ' 点。'
    checkInstantEnd()
  }

  // 你挑中了要吞哪张手牌
  function pickDevour(index : number) {
    if (phase.value != 'devourpick' || index >= playerHand.value.length) {
      return
    }
    const at = devourAt
    devourAt = -1
    phase.value = 'player'
    applyDevour(false, at, index)

    if (phase.value != 'player') {
      return
    }
    afterAction(false)
  }

  // 回魂：烧掉自己，从弃牌堆捞一张直接摆到桌上。
  // 跟复生的分工：复生捞回手里慢慢用，回魂当场上桌抢一个回合，
  // 代价是点数没得挑 —— 捞什么就吃什么
  function doRecall(byDealer : boolean, at : number) {
    const pile = byDealer ? dealerDiscard.value : playerDiscard.value
    if (pile.length == 0) {
      message.value = byDealer ? '庄家的弃牌堆是空的。' : '自己的弃牌堆还是空的，没得捞。'
      return
    }
    if (byDealer) {
      // 先算烧掉这张之后剩多少点，再挑一张摆上去不会爆的
      const afterBurn = bestTotal(removeAt(dealerBoard.value, at))
      const pick = recallChoice(pile, afterBurn)
      if (pick < 0) {
        message.value = '庄家的弃牌堆里没有合用的牌。'
        return
      }
      const card = freshCard(pile[pick])
      dealerDiscard.value = removeAt(dealerDiscard.value, pick)
      burnOut(true, at)
      dealerBoard.value = pushCard(dealerBoard.value, card)
      message.value = '庄家【回魂】，把 ' + cardText(card) + ' 直接摆了上来。'
      if (isPlayEffect(card.stickerKey)) {
        runEffect(card.stickerKey, true, 1, dealerBoard.value.length - 1)
      }
      checkInstantEnd()
      return
    }
    recallAt = at
    phase.value = 'recallpick'
    message.value = '【回魂】从弃牌堆挑一张，直接摆到桌上。'
  }

  // 捞哪张摆上去：不能爆，越靠近 42 越好
  function recallChoice(pile : Card[], now : number) : number {
    let best = -1
    let bestGap = now > GOAL ? 999 : GOAL - now
    for (let i = 0; i < pile.length; i++) {
      const after = now + shownValue(pile[i])
      if (after > GOAL) {
        continue
      }
      const gap = GOAL - after
      if (gap < bestGap) {
        bestGap = gap
        best = i
      }
    }
    return best
  }

  // 你挑中了要摆哪张上来
  function pickRecall(index : number) {
    if (phase.value != 'recallpick' || index >= playerDiscard.value.length) {
      return
    }
    // 摆上去的按干净的牌算，横置、被改写的点数、转嫁来的加成全清掉 ——
    // 不然一张堆了一身加成的牌能被反复捞回来打
    const card = freshCard(playerDiscard.value[index])
    playerDiscard.value = removeAt(playerDiscard.value, index)
    const self = recallAt
    recallAt = -1
    burnOut(false, self)
    playerBoard.value = pushCard(playerBoard.value, card)
    phase.value = 'player'
    message.value = '【回魂】把 ' + cardText(card) + ' 直接摆了上来，现在 '
      + playerScore.value.toString() + ' 点。'

    // 摆上去的牌带立即类贴纸就当场发动，跟正常打出一样
    if (isPlayEffect(card.stickerKey)) {
      runEffect(card.stickerKey, false, 1, playerBoard.value.length - 1)
    }
    if (phase.value != 'player') {
      return
    }
    afterAction(false)
  }

  // 弃牌堆摊开时点一张：复生是拿回手里，回魂是直接摆上桌
  function pickDiscardPile(index : number) {
    if (phase.value == 'revivepick') {
      pickRevive(index)
      return
    }
    if (phase.value == 'recallpick') {
      pickRecall(index)
    }
  }

  // 献身：拉庄家桌上一张牌一起下场。
  // 现有的清除手段全是按条件扫（狠心、削峰、斩首、天灾），
  // 这是唯一一张能点名弃掉一张的 —— 代价是自己也搭进去，所以不能乱用
  function doMartyr(byDealer : boolean, at : number) {
    const target = byDealer ? playerBoard.value : dealerBoard.value
    if (target.length == 0) {
      // 没牌可拉就不烧了，这张留在桌上照常算点数
      message.value = byDealer ? '庄家想献身，你桌上还没有牌。' : '庄家桌上没有牌可以拉。'
      return
    }
    if (byDealer) {
      const pick = martyrChoice(playerBoard.value)
      const card = playerBoard.value[pick]
      discardBoardCard(false, pick)
      burnOut(true, at)
      message.value = '庄家【献身】，拉着你的 ' + cardText(card) + ' 一起下场。'
      checkInstantEnd()
      return
    }
    martyrAt = at
    phase.value = 'martyrpick'
    message.value = '【献身】挑一张庄家桌上的牌，跟它同归于尽。'
  }

  // 拉哪张：点数越大越该拉，带贴纸的再加权
  function martyrChoice(board : Card[]) : number {
    let best = 0
    let bestScore = -1
    for (let i = 0; i < board.length; i++) {
      const card = board[i]
      let score = worthOf(card)
      if (card.stickerKey != S_NONE) {
        score = score + 5 + rarityOfKey(card.stickerKey) * 3
      }
      if (score > bestScore) {
        bestScore = score
        best = i
      }
    }
    return best
  }

  function discardBoardCard(fromDealer : boolean, index : number) {
    const board = fromDealer ? dealerBoard.value : playerBoard.value
    if (index >= board.length) {
      return
    }
    const card = board[index]
    if (fromDealer) {
      dealerBoard.value = removeAt(dealerBoard.value, index)
      dealerDiscard.value = pushCard(dealerDiscard.value, card)
    } else {
      playerBoard.value = removeAt(playerBoard.value, index)
      playerDiscard.value = pushCard(playerDiscard.value, card)
    }
  }

  // 你挑中了要拉谁下水。暗牌也能拉 —— 弃掉它不需要先看清是什么
  function pickMartyr(index : number) {
    if (phase.value != 'martyrpick' || index >= dealerBoard.value.length) {
      return
    }
    const card = dealerBoard.value[index]
    const self = martyrAt
    martyrAt = -1
    discardBoardCard(true, index)
    burnOut(false, self)
    phase.value = 'player'
    message.value = '【献身】跟庄家的 ' + (card.faceDown ? '一张暗牌' : cardText(card)) + ' 同归于尽。'
    afterAction(false)
  }

  // 燃尽：效果发动完把这张牌从桌上撤下来进弃牌堆。
  // 它因此不贡献点数 —— 转嫁把点数搬走了，留着空壳在桌上没道理
  function burnOut(byDealer : boolean, at : number) {
    const board = byDealer ? dealerBoard.value : playerBoard.value
    if (at >= board.length) {
      return
    }
    const card = board[at]
    if (byDealer) {
      dealerBoard.value = removeAt(dealerBoard.value, at)
      dealerDiscard.value = pushCard(dealerDiscard.value, card)
    } else {
      playerBoard.value = removeAt(playerBoard.value, at)
      playerDiscard.value = pushCard(playerDiscard.value, card)
    }
  }

  // 夺取：把对方桌上一张牌的贴纸搬到自己这张上。
  // 搬走永续类的话对面的点数当场就变，可能直接把他顶爆；
  // 横置状态留在原牌上不跟着搬，所以他横置用过的天灾搬过来还能再横一次
  function doSeize(byDealer : boolean, at : number) {
    const from = byDealer ? playerBoard.value : dealerBoard.value
    if (seizeCount(from) == 0) {
      message.value = byDealer ? '你桌上没有他能搬的贴纸。' : '庄家桌上没有能搬的贴纸。'
      return
    }
    if (byDealer) {
      const pick = seizeChoice(playerBoard.value)
      if (pick < 0) {
        return
      }
      applySeize(true, at, pick)
      return
    }
    seizeAt = at
    phase.value = 'seizepick'
    message.value = '【夺取】挑一张庄家桌上的贴纸牌，把那张贴纸搬过来。'
  }

  // 盖着的牌不能搬 —— 看不见上面是什么
  function canSeizeCard(card : Card) : boolean {
    return !card.faceDown && isSeizable(card.stickerKey)
  }

  function seizeCount(board : Card[]) : number {
    let n = 0
    for (let i = 0; i < board.length; i++) {
      if (canSeizeCard(board[i])) {
        n = n + 1
      }
    }
    return n
  }

  // 搬哪张：贴纸越贵越先搬
  function seizeChoice(board : Card[]) : number {
    let best = -1
    let bestRarity = -1
    for (let i = 0; i < board.length; i++) {
      if (!canSeizeCard(board[i])) {
        continue
      }
      const rarity = rarityOfKey(board[i].stickerKey)
      if (rarity > bestRarity) {
        bestRarity = rarity
        best = i
      }
    }
    return best
  }

  function applySeize(byDealer : boolean, at : number, fromIndex : number) {
    const ownBoard = byDealer ? dealerBoard.value : playerBoard.value
    const fromBoard = byDealer ? playerBoard.value : dealerBoard.value
    if (at >= ownBoard.length || fromIndex >= fromBoard.length) {
      return
    }
    if (!canSeizeCard(fromBoard[fromIndex])) {
      return
    }
    const key = fromBoard[fromIndex].stickerKey

    // 对面那张剥成普通牌。横置状态是牌的，留在原地不跟着走
    const stripped = cloneBoard(fromBoard)
    stripped[fromIndex].stickerKey = S_NONE
    if (byDealer) {
      playerBoard.value = stripped
    } else {
      dealerBoard.value = stripped
    }

    const next = cloneBoard(byDealer ? dealerBoard.value : playerBoard.value)
    next[at].stickerKey = key
    if (byDealer) {
      dealerBoard.value = next
    } else {
      playerBoard.value = next
    }

    message.value = (byDealer ? '庄家夺走了你的【' : '你夺走了庄家的【') + stickerAt(key).name + '】。'

    // 搬来的是立即类，牌已经在桌上了，当场发动
    if (isPlayEffect(key)) {
      runEffect(key, byDealer, 1, at)
    }
    checkInstantEnd()
  }

  function pickSeize(index : number) {
    if (phase.value != 'seizepick' || index >= dealerBoard.value.length) {
      return
    }
    if (!canSeizeCard(dealerBoard.value[index])) {
      toast(dealerBoard.value[index].faceDown ? '这张牌还盖着，看不清是什么' : '这张牌上没有能搬的贴纸')
      return
    }
    const at = seizeAt
    seizeAt = -1
    phase.value = 'player'
    applySeize(false, at, index)

    if (phase.value != 'player') {
      return
    }
    afterAction(false)
  }

  // 祛除：把场上任意一张牌的贴纸抹掉。
  // 全场任选而不是只能拆庄家的 —— 他桌上常常没有值得拆的，
  // 能拆自己的话至少总有事做（较劲摆错了位置、移植完剩下的空壳）
  function doStrip(byDealer : boolean) {
    if (byDealer) {
      const pick = stripChoice(playerBoard.value)
      if (pick < 0) {
        message.value = '庄家的【祛除】没找到能拆的贴纸。'
        return
      }
      applyStrip(false, pick, true)
      return
    }
    if (stripCount(playerBoard.value) + stripCount(dealerBoard.value) == 0) {
      message.value = '场上没有贴纸可以拆。'
      return
    }
    phase.value = 'strippick'
    message.value = '【祛除】挑场上任意一张贴纸牌，去掉它的贴纸。'
  }

  function canStripCard(card : Card) : boolean {
    return !card.faceDown && card.stickerKey != S_NONE
  }

  function stripCount(board : Card[]) : number {
    let n = 0
    for (let i = 0; i < board.length; i++) {
      if (canStripCard(board[i])) {
        n = n + 1
      }
    }
    return n
  }

  // 庄家拆哪张：永续类最该拆，其次是还没横置的横置类。
  // 已经发动完的立即类拆了等于拆空壳，排最后
  function stripChoice(board : Card[]) : number {
    let best = -1
    let bestScore = -1
    for (let i = 0; i < board.length; i++) {
      if (!canStripCard(board[i])) {
        continue
      }
      const key = board[i].stickerKey
      let score = 1
      if (isLastingSticker(key)) {
        score = 30
      } else if (hasTapEffect(key) && !board[i].tapped) {
        score = 20
      }
      score = score + rarityOfKey(key)
      if (score > bestScore) {
        bestScore = score
        best = i
      }
    }
    return best
  }

  function applyStrip(fromDealer : boolean, index : number, byDealer : boolean) {
    const board = fromDealer ? dealerBoard.value : playerBoard.value
    if (index >= board.length || !canStripCard(board[index])) {
      return
    }
    const name = stickerAt(board[index].stickerKey).name
    const next = cloneBoard(board)
    next[index].stickerKey = S_NONE
    if (fromDealer) {
      dealerBoard.value = next
    } else {
      playerBoard.value = next
    }
    message.value = (byDealer ? '庄家用【祛除】拆掉了' : '【祛除】拆掉了')
      + (fromDealer ? '庄家的【' : '你的【') + name + '】。'
    checkInstantEnd()
  }

  function pickStrip(fromDealer : boolean, index : number) {
    if (phase.value != 'strippick') {
      return
    }
    const board = fromDealer ? dealerBoard.value : playerBoard.value
    if (index >= board.length) {
      return
    }
    if (!canStripCard(board[index])) {
      toast(board[index].faceDown ? '这张牌还盖着，看不清是什么' : '这张牌上没有贴纸')
      return
    }
    phase.value = 'player'
    applyStrip(fromDealer, index, false)

    if (phase.value != 'player') {
      return
    }
    afterAction(false)
  }

  // 复生：从自己弃牌堆里捞一张直接回手上。
  // 打出复生腾出的那个手牌位由它自己填 —— 所以出牌前没调 tidyHand，
  // 捞完才补。弃牌堆空了就照常从牌库补，这张就当普通牌算点数
  function doRevive(byDealer : boolean) {
    if (byDealer) {
      const pick = reviveChoice(dealerDiscard.value)
      if (pick >= 0) {
        const card = freshCard(dealerDiscard.value[pick])
        dealerDiscard.value = removeAt(dealerDiscard.value, pick)
        dealerHand.value = pushCard(dealerHand.value, card)
        message.value = '庄家用【复生】从弃牌堆捞回了一张牌。'
        // 手上本来就满着就丢掉最没用的那张，别让 tidyHand 把刚捞的扔了
        if (dealerHand.value.length > HAND_SIZE) {
          dealerDropWorst()
        }
      } else {
        message.value = '庄家的弃牌堆是空的。'
      }
      tidyDealerHand()
      return
    }

    if (playerDiscard.value.length == 0) {
      message.value = '自己的弃牌堆还是空的，没得捞。'
      tidyPlayerHand()
      return
    }
    phase.value = 'revivepick'
    message.value = '【复生】从弃牌堆里挑一张拿回手上。'
  }

  // 庄家捞哪张：贴纸最贵的那张，没贴纸的就捞点数最大的
  function reviveChoice(pile : Card[]) : number {
    let best = -1
    let bestScore = -1
    for (let i = 0; i < pile.length; i++) {
      const key = pile[i].stickerKey
      const score = key == S_NONE ? shownValue(pile[i]) : 20 + rarityOfKey(key)
      if (score > bestScore) {
        bestScore = score
        best = i
      }
    }
    return best
  }

  // 你从弃牌堆里挑中了一张
  function pickRevive(index : number) {
    if (phase.value != 'revivepick' || index >= playerDiscard.value.length) {
      return
    }
    // 捞回来的算一张干净的手牌，横置状态和被改写的点数都清掉
    const card = freshCard(playerDiscard.value[index])
    playerDiscard.value = removeAt(playerDiscard.value, index)
    playerHand.value = pushCard(playerHand.value, card)

    phase.value = 'player'
    message.value = '【复生】捞回了 ' + cardText(card) + '。'

    // 手上本来就满着的时候捞回来的（复生被移植、回响间接发动就会这样），
    // 得你自己挑一张弃 —— 交给 tidyHand 的话它会直接把刚捞回来的那张扔掉
    if (playerHand.value.length > HAND_SIZE) {
      dropLeft = playerHand.value.length - HAND_SIZE
      pickMode = 'drop'
      phase.value = 'discard'
      message.value = message.value + ' 手牌满了，挑一张弃掉。'
      return
    }
    tidyPlayerHand()
    afterAction(false)
  }

  // 移植：弃一张手牌，把它的贴纸搬到这张牌上。
  // 这是绕开「强效果都贴在大牌上」的办法 —— 天灾贴在 K 上出不起，
  // 拿一张 3 点的牌把它接过来，效果一样，代价从 10 点变成 3 点。
  // 搬的是贴纸不是牌，所以永续类会一直生效，横置类还能留着等时机
  function doGraft(byDealer : boolean, at : number) {
    if (byDealer) {
      const pick = graftChoice(dealerHand.value)
      if (pick < 0) {
        message.value = '庄家的【移植】没找到能搬的贴纸。'
        return
      }
      applyGraft(true, at, pick)
      return
    }
    if (graftChoice(playerHand.value) < 0) {
      message.value = '手上没有带贴纸的牌可以搬。'
      return
    }
    graftAt = at
    phase.value = 'graftpick'
    message.value = '【移植】挑一张手牌弃掉，把它的贴纸搬过来。'
  }

  // 手牌里最值得搬的那张：贴纸越贵的效果一般也越值钱
  function graftChoice(hand : Card[]) : number {
    let best = -1
    let bestRarity = -1
    for (let i = 0; i < hand.length; i++) {
      const key = hand[i].stickerKey
      if (!isGraftable(key)) {
        continue
      }
      const rarity = rarityOfKey(key)
      if (rarity > bestRarity) {
        bestRarity = rarity
        best = i
      }
    }
    return best
  }

  // 把手牌第 handAt 张的贴纸搬到桌上第 at 张牌上
  function applyGraft(byDealer : boolean, at : number, handAt : number) {
    const hand = byDealer ? dealerHand.value : playerHand.value
    const board = byDealer ? dealerBoard.value : playerBoard.value
    if (at >= board.length || handAt >= hand.length) {
      return
    }
    const card = hand[handAt]
    const key = card.stickerKey
    if (!isGraftable(key)) {
      return
    }

    if (byDealer) {
      dealerHand.value = removeAt(dealerHand.value, handAt)
      dealerDiscard.value = pushCard(dealerDiscard.value, card)
      tidyDealerHand()
    } else {
      playerHand.value = removeAt(playerHand.value, handAt)
      playerDiscard.value = pushCard(playerDiscard.value, card)
      tidyPlayerHand()
    }

    // 贴纸搬过来，原来那张移植被盖掉 —— 一张牌只能有一种贴纸
    const next = cloneBoard(byDealer ? dealerBoard.value : playerBoard.value)
    next[at].stickerKey = key
    if (byDealer) {
      dealerBoard.value = next
    } else {
      playerBoard.value = next
    }

    message.value = (byDealer ? '庄家把 ' : '你把 ') + cardText(card) + ' 上的【'
      + stickerAt(key).name + '】移植了过来。'

    // 搬来的是立即类，这张牌已经在桌上了，当场就发动
    if (isPlayEffect(key)) {
      runEffect(key, byDealer, 1, at)
    }
  }

  // 你挑中了要拆哪张手牌
  function pickGraft(index : number) {
    if (phase.value != 'graftpick' || index >= playerHand.value.length) {
      return
    }
    if (!isGraftable(playerHand.value[index].stickerKey)) {
      toast('这张牌上没有能搬的贴纸')
      return
    }
    const at = graftAt
    graftAt = -1
    phase.value = 'player'
    applyGraft(false, at, index)

    // 搬来的效果自己跳到别的阶段就别抢
    if (phase.value != 'player') {
      return
    }
    afterAction(false)
  }

  // 回响 / 返照：让一张已经发动过的立即类贴纸再响一次。
  // 回响挑自己桌上的，返照挑对方桌上的 —— 后者是把他的牌抢来用，
  // 效果一律按发动者的立场结算，所以借他的斩首扫的是他的桌，
  // 但借他的奉献送出去的也是你自己的牌
  function doEcho(byDealer : boolean, reflect : boolean, times : number) {
    // 挑谁桌上的牌：回响挑自己的，返照挑对面的
    const fromDealer = reflect ? !byDealer : byDealer

    if (byDealer) {
      const pick = dealerEchoChoice(fromDealer)
      if (pick < 0) {
        message.value = reflect ? '庄家的【返照】没找到能借的牌。' : '庄家的【回响】没找到能再响的牌。'
        return
      }
      fireEcho(true, fromDealer, pick)
      return
    }

    const board = fromDealer ? dealerBoard.value : playerBoard.value
    if (echoChoiceCount(board) == 0) {
      message.value = fromDealer ? '庄家桌上没有能借的贴纸牌。' : '自己桌上没有能再响的贴纸牌。'
      return
    }
    echoFromDealer.value = fromDealer
    echoLeft = times
    phase.value = 'echopick'
    message.value = fromDealer
      ? '【返照】挑一张庄家桌上的贴纸牌，那个效果改由你发动。'
      : '【回响】挑一张自己桌上的贴纸牌，再发动一次它的效果。'
  }

  // 盖着的牌不算 —— 返照的价值在于看准了抢，盲抢没意思
  function canEchoCard(card : Card) : boolean {
    return !card.faceDown && isEchoable(card.stickerKey)
  }

  function echoChoiceCount(board : Card[]) : number {
    let n = 0
    for (let i = 0; i < board.length; i++) {
      if (canEchoCard(board[i])) {
        n = n + 1
      }
    }
    return n
  }

  // 庄家挑哪张：捡贴纸最贵的那张响，稀有度高的效果一般也更值钱
  function dealerEchoChoice(fromDealer : boolean) : number {
    const board = fromDealer ? dealerBoard.value : playerBoard.value
    let best = -1
    let bestRarity = -1
    for (let i = 0; i < board.length; i++) {
      if (!canEchoCard(board[i])) {
        continue
      }
      const rarity = rarityOfKey(board[i].stickerKey)
      if (rarity > bestRarity) {
        bestRarity = rarity
        best = i
      }
    }
    return best
  }

  // 让 index 这张牌的效果再响一次
  function fireEcho(byDealer : boolean, fromDealer : boolean, index : number) {
    const board = fromDealer ? dealerBoard.value : playerBoard.value
    if (index >= board.length) {
      return
    }
    if (!canEchoCard(board[index])) {
      return
    }
    const key = board[index].stickerKey
    // 借来的牌在对面桌上，位置对不上自己这边，就拿自己桌上最右端当落点。
    // 依赖位置的效果（改左邻、以自身点数为界）于是全部按你自己的牌算
    const own = byDealer ? dealerBoard.value : playerBoard.value
    const at = fromDealer == byDealer ? index : own.length - 1
    message.value = (byDealer ? '庄家借' : '你借')
      + (fromDealer == byDealer ? '自己的' : '对面的')
      + '【' + stickerAt(key).name + '】再响一次。'
    runEffect(key, byDealer, 1, at)
  }

  // 你挑中了要再响的那张牌
  function pickEcho(fromDealer : boolean, index : number) {
    if (phase.value != 'echopick' || fromDealer != echoFromDealer.value) {
      return
    }
    const board = fromDealer ? dealerBoard.value : playerBoard.value
    if (index >= board.length) {
      return
    }
    if (!canEchoCard(board[index])) {
      toast(board[index].faceDown ? '这张牌还盖着，看不清是什么' : '这张牌没有能再响的立即类贴纸')
      return
    }
    phase.value = 'player'
    fireEcho(false, fromDealer, index)
    echoLeft = echoLeft - 1

    // 效果自己跳到别的阶段（比如又要你挑牌）就别抢
    if (phase.value != 'player') {
      return
    }
    if (echoLeft > 0 && echoChoiceCount(board) > 0) {
      phase.value = 'echopick'
      message.value = '还能再响 ' + echoLeft.toString() + ' 次，再挑一张。'
      return
    }
    echoLeft = 0
    afterAction(false)
  }

  // 按兵：这一回合不出牌，把行动权让给对方。
  // 跟停牌的区别是它不交出结算权 —— 停牌之后对方出到满意就停，当场结算，
  // 你再没机会补牌；按兵只是让对方先动一张，轮回来你照样能出，
  // 而这时你已经看见他落在几点了
  function doStandby(byDealer : boolean, times : number) {
    standbyFired = true
    // 头一次让出的就是当前这一回合，强化翻倍多出来的才要记账
    const extra = times - 1
    if (byDealer) {
      dealerPause = dealerPause + extra
      message.value = '庄家【按兵】不动，把这一回合让给你。'
    } else {
      playerPause = playerPause + extra
      message.value = '【按兵】这一回合不出牌，看庄家先动。'
    }
  }

  // 借刀：替对方从他手牌里挑一张打到他桌上。
  // 爆牌当场判负，所以这是把「让对方爆」变成可控操作的效果 ——
  // 代价是那张牌上如果有他的立即类贴纸，等于你亲手帮他发动了
  function doBorrow(byDealer : boolean, times : number) {
    if (byDealer) {
      // 庄家对你用：他挑一张最可能把你顶爆的
      let done = 0
      for (let i = 0; i < times; i++) {
        const pick = borrowChoice(playerHand.value, playerScore.value)
        if (pick < 0) {
          break
        }
        forceOutCard(false, pick)
        done = done + 1
      }
      if (done == 0) {
        message.value = '庄家想借你的刀，你手上没牌了。'
      }
      return
    }

    if (dealerHand.value.length == 0) {
      message.value = '庄家手上没牌。'
      return
    }
    borrowLeft = times
    phase.value = 'borrow'
    message.value = '【借刀】庄家手牌摊开了，挑一张替他打出去。'
  }

  // 挑哪张最毒：优先能让对方当场爆掉的，否则挑点数最大的
  function borrowChoice(hand : Card[], now : number) : number {
    if (hand.length == 0) {
      return -1
    }
    let best = 0
    let bestWorth = -99
    for (let i = 0; i < hand.length; i++) {
      const worth = shownValue(hand[i])
      if (now + worth > GOAL) {
        return i
      }
      if (worth > bestWorth) {
        bestWorth = worth
        best = i
      }
    }
    return best
  }

  // 把某一方手里的第 index 张牌强行打到他自己桌上，
  // 牌上的立即类贴纸由牌的主人发动
  function forceOutCard(toDealer : boolean, index : number) {
    const hand = toDealer ? dealerHand.value : playerHand.value
    if (index >= hand.length) {
      return
    }
    const card = faceUp(hand[index])
    if (toDealer) {
      dealerHand.value = removeAt(dealerHand.value, index)
      dealerBoard.value = pushCard(dealerBoard.value, card)
      tidyDealerHand()
      message.value = '【借刀】替庄家打出 ' + cardText(card) + '，他现在 '
        + dealerScore.value.toString() + ' 点。'
    } else {
      playerHand.value = removeAt(playerHand.value, index)
      playerBoard.value = pushCard(playerBoard.value, card)
      tidyPlayerHand()
      message.value = '庄家用【借刀】替你打出 ' + cardText(card) + '，你现在 '
        + playerScore.value.toString() + ' 点。'
    }
    // 牌是谁的，贴纸就由谁发动 —— 这是借刀唯一的反噬风险
    if (isPlayEffect(card.stickerKey)) {
      const board = toDealer ? dealerBoard.value : playerBoard.value
      runEffect(card.stickerKey, toDealer, 1, board.length - 1)
    }
    checkInstantEnd()
  }

  // 你从摊开的庄家手牌里挑中了一张
  function pickBorrow(index : number) {
    if (phase.value != 'borrow' || index >= dealerHand.value.length) {
      return
    }
    forceOutCard(true, index)
    borrowLeft = borrowLeft - 1

    // 效果链里可能已经跳到别的阶段（比如庄家那张牌触发了乞讨），那就别抢
    if (phase.value != 'borrow') {
      return
    }
    if (borrowLeft > 0 && dealerHand.value.length > 0) {
      message.value = '【借刀】再挑一张，还剩 ' + borrowLeft.toString() + ' 张。'
      return
    }
    borrowLeft = 0
    phase.value = 'player'
    afterAction(false)
  }

  // 奉：把这张牌送到对方桌上，点数改记给对方
  function doGive(byDealer : boolean, at : number) {
    if (byDealer) {
      if (at >= dealerBoard.value.length) {
        return
      }
      const card = faceUp(dealerBoard.value[at])
      dealerBoard.value = removeAt(dealerBoard.value, at)
      playerBoard.value = pushCard(playerBoard.value, card)
      message.value = '庄家把 ' + cardText(card) + ' 奉给了你，点数记到你名下。'
    } else {
      if (at >= playerBoard.value.length) {
        return
      }
      const card = playerBoard.value[at]
      playerBoard.value = removeAt(playerBoard.value, at)
      dealerBoard.value = pushCard(dealerBoard.value, card)
      message.value = '你把 ' + cardText(card) + ' 奉给了庄家，点数记到庄家名下。'
    }
    checkInstantEnd()
  }

  // 乞：对方从他桌上的牌里挑一张交过来
  function doBeg(byDealer : boolean, times : number) {
    if (byDealer) {
      // 庄家跟你讨牌，轮到你挑一张交出去
      if (playerBoard.value.length == 0) {
        message.value = '庄家想讨牌，你桌上还没有牌。'
        return
      }
      begLeft = times - 1
      phase.value = 'begging'
      message.value = '庄家发动【乞讨】，点一张你桌上的牌交给他。'
      return
    }

    let got = 0
    for (let i = 0; i < times; i++) {
      if (dealerBoard.value.length == 0) {
        break
      }
      const at = dealerGiveChoice()
      // 讨过来的牌摊在你桌上，盖着的也得翻明
      const card = faceUp(dealerBoard.value[at])
      dealerBoard.value = removeAt(dealerBoard.value, at)
      playerBoard.value = pushCard(playerBoard.value, card)
      got = got + 1
    }
    if (got == 0) {
      message.value = '庄家桌上没有牌可以讨。'
      return
    }
    message.value = '你讨来了庄家 ' + got + ' 张牌，现在 ' + playerScore.value + ' 点。'
    checkInstantEnd()
  }

  // 庄家被讨牌时挑哪张：挑交出去之后自己最不吃亏的
  function dealerGiveChoice() : number {
    let best = 0
    let bestGap = -1
    for (let i = 0; i < dealerBoard.value.length; i++) {
      const left = removeAt(dealerBoard.value, i)
      const mine = bestTotal(left)
      if (mine > GOAL) {
        continue
      }
      // 自己留下的点数越接近目标越好
      const gap = GOAL - mine
      if (bestGap < 0 || gap < bestGap) {
        best = i
        bestGap = gap
      }
    }
    return best
  }

  function giveToDealer(index : number) {
    if (phase.value != 'begging') {
      return
    }
    if (index >= playerBoard.value.length) {
      return
    }
    const card = playerBoard.value[index]
    playerBoard.value = removeAt(playerBoard.value, index)
    dealerBoard.value = pushCard(dealerBoard.value, card)
    message.value = '你把 ' + cardText(card) + ' 交给了庄家。'

    if (begLeft > 0 && playerBoard.value.length > 0) {
      begLeft = begLeft - 1
      message.value = '庄家还要一张，再点一张交给他。'
      return
    }
    begLeft = 0
    if (checkInstantEnd()) {
      return
    }
    // 庄家是在自己的行动阶段讨的牌，交完之后它还欠一次出牌
    if (dealerPending) {
      dealerPending = false
      dealerPlayCard()
      return
    }
    phase.value = 'player'
  }

  // 鼓舞：打出的当下重置自己桌上一张牌，就这一次。
  // 目标随便挑，挑到没横置的牌就白费了 —— 这是它的代价，也让它没法重置自己套娃
  function doCheer(byDealer : boolean, at : number) {
    if (byDealer) {
      dealerCheerNow(at)
      return
    }
    phase.value = 'cheer'
    message.value = '打出【鼓舞】，点一张自己桌上的牌把它重置。'
  }

  function dealerCheerNow(at : number) {
    const pick = dealerCheerChoice(at)
    if (pick < 0) {
      return
    }
    const board = cloneBoard(dealerBoard.value)
    board[pick].tapped = false
    dealerBoard.value = board
  }

  // 庄家重置哪张：挑还能再发动一次的
  function dealerCheerChoice(skip : number) : number {
    let pick = -1
    for (let i = 0; i < dealerBoard.value.length; i++) {
      if (i == skip || !dealerBoard.value[i].tapped) {
        continue
      }
      if (!hasTapEffect(dealerBoard.value[i].stickerKey)) {
        continue
      }
      if (pick < 0) {
        pick = i
      }
    }
    return pick
  }

  function cheerReset(index : number) {
    if (phase.value != 'cheer') {
      return
    }
    if (index >= playerBoard.value.length) {
      return
    }
    const card = playerBoard.value[index]
    if (card.tapped) {
      const board = cloneBoard(playerBoard.value)
      board[index].tapped = false
      playerBoard.value = board
      message.value = '重置了 ' + cardText(card) + '，它可以再横置一次。'
    } else {
      // 明知没效果也允许选，选完就当浪费掉
      message.value = cardText(card) + ' 本来就没横置，这次【鼓舞】白用了。'
    }

    phase.value = 'player'
    afterAction(false)
  }

  // ---------- 庄家 AI ----------

  // 庄家打出这张牌之后会是多少点
  function dealerNextScore(card : Card) : number {
    const next = pushCard(dealerBoard.value, card)
    return bestTotal(next)
  }

  // 庄家收不收手。这是它最重要的决策，难度越高越会算
  function dealerWantsStand() : boolean {
    // 手上每张打出去都会爆，那只能停
    let hasSafe = false
    for (let i = 0; i < dealerHand.value.length; i++) {
      if (dealerNextScore(dealerHand.value[i]) <= GOAL) {
        hasSafe = true
        break
      }
    }
    if (!hasSafe) {
      return true
    }

    // 你已经停牌了，庄家只要压过你就收手，不用冒险
    if (playerStood.value && dealerScore.value > playerScore.value) {
      return true
    }

    // 够接近目标就见好就收，线的高低看难度
    let line = GOAL - 10
    if (level.value.ai == 2) {
      line = GOAL - 6
    } else if (level.value.ai == 3) {
      line = GOAL - 4
    }
    return dealerScore.value >= line
  }

  function chooseDealerCard() : number {
    const hand = dealerHand.value
    if (level.value.ai == 1) {
      return Math.floor(Math.random() * hand.length)
    }

    // 稳健 / 精算：先找能正好凑到目标的牌
    if (level.value.ai == 3) {
      for (let i = 0; i < hand.length; i++) {
        if (dealerNextScore(hand[i]) == GOAL) {
          return i
        }
      }
    }

    // 选打出后最接近目标又不爆的牌
    let best = -1
    let bestScore = -1
    for (let i = 0; i < hand.length; i++) {
      const next = dealerNextScore(hand[i])
      if (next <= GOAL && next > bestScore) {
        best = i
        bestScore = next
      }
    }
    if (best >= 0) {
      return best
    }

    // 都会爆，打点数最小的
    let smallest = 0
    for (let i = 1; i < hand.length; i++) {
      if (hand[i].value < hand[smallest].value) {
        smallest = i
      }
    }
    return smallest
  }

  // ---------- 判定 ----------

  // 爆牌才会立刻结束对局。够到 GOAL 不会自动获胜 —— 得先停牌，
  // 等对方也停了才结算，这中间对方还有机会把你的点数搅乱
  function endKind() : string {
    const p = playerScore.value > GOAL
    const d = dealerScore.value > GOAL
    if (p && d) {
      return 'push'
    }
    if (p) {
      return 'lose'
    }
    if (d) {
      return 'win'
    }
    return ''
  }

  function endTip(kind : string) : string {
    const p = playerScore.value
    const d = dealerScore.value
    if (kind == 'push') {
      return '双方都爆了（你 ' + p + '，庄家 ' + d + '）。'
    }
    if (kind == 'lose') {
      return '你爆了（' + p + ' 点）。'
    }
    return '庄家爆了（' + d + ' 点）。'
  }

  // 双方都停牌了，比谁更接近 GOAL。
  // 比输了不是马上完 —— 只要还有牌能横置，就先给一次翻盘机会
  function settleStand(allowRespond : boolean) {
    const p = playerScore.value
    const d = dealerScore.value
    if (p > d) {
      finish('win', '双方停牌，你 ' + p + ' 点比庄家 ' + d + ' 点更接近 ' + GOAL + '。')
      return
    }

    const kind = p < d ? 'lose' : 'push'
    const tip = p < d
      ? '双方停牌，庄家 ' + d + ' 点比你 ' + p + ' 点更接近 ' + GOAL + '。'
      : '双方停牌，都是 ' + p + ' 点。'
    if (allowRespond && canRespond()) {
      openRespond(kind, tip)
      return
    }
    finish(kind, tip)
  }

  // 平局不分胜负，洗牌重开这一局。
  // 但重开是有限的：故意打成双爆来换一手好牌，最多混两次
  function restartMatch(tip : string) {
    if (dealerTimer != -1) {
      clearTimeout(dealerTimer)
      dealerTimer = -1
    }
    const data = save.value
    data.push = data.push + 1
    save.value = data
    saveCurrent(data)

    pushCount = pushCount + 1
    if (pushCount > MAX_PUSH) {
      finish('lose', tip + ' 这一关已经平局 ' + MAX_PUSH + ' 次，算没过。')
      return
    }

    resultKind.value = 'push'
    message.value = tip + ' 平局，洗牌重来（' + pushCount + '/' + MAX_PUSH + '）。'
    phase.value = 'dealer'
    dealerTimer = setTimeout(setup, 1600)
  }

  // 横置效果改了点数，立刻看看是不是已经分出胜负。
  // 结局对你不利、而你手上还有横置机会时，先给一个响应窗口再结算
  function checkInstantEnd() : boolean {
    const kind = endKind()
    if (kind == '') {
      return false
    }
    if (kind != 'win' && canRespond()) {
      openRespond(kind, endTip(kind))
      return true
    }
    finish(kind, endTip(kind))
    return true
  }

  // 桌上还有没横置过、且真能发动的牌，才值得给响应机会
  function canRespond() : boolean {
    for (let i = 0; i < playerBoard.value.length; i++) {
      const card = playerBoard.value[i]
      if (card.tapped || !hasTapEffect(card.stickerKey)) {
        continue
      }
      if (needsOpponentBoard(card.stickerKey) && dealerBoard.value.length == 0) {
        continue
      }
      if (needsLeftCard(card.stickerKey) && i == 0) {
        continue
      }
      // 按兵只是把回合让出去，而响应窗口之后就要结算了，让了也没用
      if (baseEffectOf(card.stickerKey) == S_STANDBY) {
        continue
      }
      return true
    }
    return false
  }

  // 结算前的最后一次横置机会，用不用随你
  function openRespond(kind : string, tip : string) {
    pendingKind = kind
    pendingTip = tip
    phase.value = 'respond'
    message.value = tip + ' 结算前你还能横置一张牌翻盘，或者直接认了。'
  }

  // 响应窗口里横置完，重新看局面：翻盘了就接着打，没翻盘就落定。
  // 这一次不再给响应机会，免得无限续命
  function settleRespond() {
    refreshStand()
    const kind = endKind()
    if (kind != '') {
      finish(kind, endTip(kind))
      return
    }
    // 没爆了 —— 在结算前的最后一刻救了回来
    gainAchievement(ACH_COMEBACK)
    // 双方还都停着就直接结算，否则说明点数被改动、停牌已解除，接着打
    if (playerStood.value && dealerStood.value) {
      settleStand(false)
      return
    }
    pendingKind = ''
    phase.value = 'player'
    message.value = '局面被你扳回来了，接着打。'
  }

  function giveUpRespond() {
    if (phase.value != 'respond') {
      return
    }
    if (pendingKind == '') {
      phase.value = 'player'
      return
    }
    finish(pendingKind, pendingTip)
  }

  function finish(kind : string, tip : string) {
    // 结算了就把庄家的暗牌全翻开
    revealDealer()
    // 平局不算一局结果，洗牌重开
    if (kind == 'push') {
      restartMatch(tip)
      return
    }
    if (dealerTimer != -1) {
      clearTimeout(dealerTimer)
      dealerTimer = -1
    }
    phase.value = 'over'
    resultKind.value = kind

    // 赢下来的方式本身也能解锁贴纸
    if (kind == 'win') {
      if (playerScore.value == GOAL) {
        gainAchievement(ACH_EXACT_GOAL)
      }
      if (dealerScore.value > GOAL) {
        gainAchievement(ACH_DEALER_BUST)
      }
      if (maxBehind >= BEHIND_GAP) {
        gainAchievement(ACH_BEHIND)
      }
    }

    const data = save.value
    let extra = ''
    if (kind == 'win') {
      data.win = data.win + 1
      // 券和解锁只在首次通关时给。重打是为了刷成就和试牌组，不是刷券
      const firstClear = level.value.index > data.cleared
      if (firstClear) {
        const rarity = level.value.rewardRarity
        addTickets(data, rarity, level.value.rewardCount)
        extra = ' 获得 ' + level.value.rewardCount + ' 张' + rarityAt(rarity).name + '券。'

        // 通关解锁本关指定的贴纸，跟庄家用没用过无关
        const fresh = unlockShop(data, level.value.unlockStickers)
        if (fresh.length > 0) {
          let names = ''
          for (let i = 0; i < fresh.length; i++) {
            if (i > 0) {
              names = names + '、'
            }
            names = names + stickerAt(fresh[i]).name
          }
          extra = extra + ' 解锁【' + names + '】。'
        }
        data.cleared = level.value.index
      } else {
        extra = ' 这关之前通过了，不再给券。'
      }
    } else if (kind == 'lose') {
      // 输了什么都不扣，改完牌组可以再打这一关
      data.lose = data.lose + 1
      extra = ' 可以改完牌组再打这一关。'
    } else {
      data.push = data.push + 1
      extra = ' 平局不算通关，可以再打一次。'
    }

    save.value = data
    saveCurrent(data)

    resultText.value = tip + extra
    message.value = tip
  }

  // ---------- 杂项 ----------

  function isRed(card : Card) : boolean {
    return isRedSuit(card.suit)
  }

  function stickerName(card : Card) : string {
    return stickerAt(card.stickerKey).name
  }

  function cardText(card : Card) : string {
    return card.suit + card.rank
  }

  // 牌面底下那行小字：被蝶改过的点数、横置状态。
  // 挤成一行是为了给完整的贴纸名让出位置，牌面只有 64px 高
  function cardMark(card : Card) : string {
    let text = ''
    if (card.negated) {
      text = '负'
    }
    if (card.forced >= 0) {
      text = text == '' ? card.forced.toString() + '点' : text + card.forced
    }
    if (card.tapped) {
      text = text == '' ? '横置' : text + '·横'
    }
    return text
  }

  function boostHint(on : boolean) : string {
    return on ? ' · 强化就绪' : ''
  }

  function toast(tip : string) {
    uni.showToast({
      icon: 'none',
      title: tip
    })
  }

  function toggleDiscard() {
    showDiscard.value = !showDiscard.value
  }

  // 扫场选方向的两个按钮：按点数的问大小，按奇偶的问奇偶
  const cullFirstText = computed<string>(() : string => {
    return isParityCull(pendingCullId) ? '扫奇数' : '扫比它大的'
  })

  const cullSecondText = computed<string>(() : string => {
    return isParityCull(pendingCullId) ? '扫偶数' : '扫比它小的'
  })

  const handTip = computed<string>(() : string => {
    if (phase.value == 'player') {
      return '点手牌打出，或停牌'
    }
    if (phase.value == 'confirm') {
      return '这张贴纸发不发动'
    }
    if (phase.value == 'peek') {
      return '处理窥探'
    }
    if (phase.value == 'begging') {
      return '点一张自己桌上的牌交给庄家'
    }
    if (phase.value == 'cheer') {
      return '点一张自己桌上的牌重置'
    }
    if (phase.value == 'respond') {
      return '结算前的最后一次横置'
    }
    if (phase.value == 'discard') {
      return '点一张手牌弃掉'
    }
    if (phase.value == 'pick') {
      return '从摊开的牌里挑一张'
    }
    if (phase.value == 'swap') {
      return '挑一张牌跟它对调'
    }
    if (phase.value == 'insert') {
      return '挑一张牌，插到它左边'
    }
    if (phase.value == 'samepick') {
      return '挑一张牌当尺子'
    }
    if (phase.value == 'cutpick') {
      return '点自己桌上一张牌弃掉'
    }
    if (phase.value == 'borrow') {
      return '挑一张替庄家打出去'
    }
    if (phase.value == 'echopick') {
      return echoFromDealer.value ? '挑一张庄家的贴纸借来用' : '挑一张自己的贴纸再响一次'
    }
    if (phase.value == 'graftpick') {
      return '挑一张手牌，搬走它的贴纸'
    }
    if (phase.value == 'devourpick') {
      return '挑一张手牌，吞掉它的点数'
    }
    if (phase.value == 'morphpick') {
      return '挑一张牌，把点数变成它的选择'
    }
    if (phase.value == 'revivepick') {
      return '从弃牌堆挑一张拿回手上'
    }
    if (phase.value == 'seizepick') {
      return '挑一张庄家的贴纸夺过来'
    }
    if (phase.value == 'strippick') {
      return '挑一张牌，拆掉它的贴纸'
    }
    if (phase.value == 'shuntpick') {
      return '挑一张牌，把点数加给它'
    }
    if (phase.value == 'martyrpick') {
      return '挑一张庄家的牌一起下场'
    }
    if (phase.value == 'recallpick') {
      return '从弃牌堆挑一张摆到桌上'
    }
    if (phase.value == 'strike') {
      return '挑庄家的牌翻负'
    }
    if (phase.value == 'cullpick') {
      return '选扫大的还是扫小的'
    }
    return '等庄家出牌…'
  })

  const phaseText = computed<string>(() : string => {
    if (phase.value == 'dealer') {
      return '庄家行动中'
    }
    if (phase.value == 'player') {
      return '轮到你出牌'
    }
    if (phase.value == 'peek') {
      return '窥探中'
    }
    if (phase.value == 'begging') {
      return '交牌给庄家'
    }
    if (phase.value == 'cheer') {
      return '选牌重置'
    }
    if (phase.value == 'respond') {
      return '最后响应'
    }
    if (phase.value == 'discard') {
      return '弃牌'
    }
    if (phase.value == 'pick') {
      return '双子选牌'
    }
    if (phase.value == 'cutpick') {
      return '选牌弃掉'
    }
    if (phase.value == 'borrow') {
      return '借刀选牌'
    }
    if (phase.value == 'echopick') {
      return echoFromDealer.value ? '返照选牌' : '回响选牌'
    }
    if (phase.value == 'graftpick') {
      return '移植选牌'
    }
    if (phase.value == 'devourpick') {
      return '吞并选牌'
    }
    if (phase.value == 'morphpick') {
      return '化形选牌'
    }
    if (phase.value == 'revivepick') {
      return '复生选牌'
    }
    if (phase.value == 'seizepick') {
      return '夺取选牌'
    }
    if (phase.value == 'strippick') {
      return '祛除选牌'
    }
    if (phase.value == 'shuntpick') {
      return '转嫁选牌'
    }
    if (phase.value == 'martyrpick') {
      return '献身选牌'
    }
    if (phase.value == 'recallpick') {
      return '回魂选牌'
    }
    if (phase.value == 'confirm') {
      return '选择是否发动'
    }
    if (phase.value == 'swap') {
      return '挑牌对调'
    }
    if (phase.value == 'insert') {
      return '挑位置插队'
    }
    if (phase.value == 'samepick') {
      return '挑尺子'
    }
    if (phase.value == 'strike') {
      return '挑牌翻负'
    }
    if (phase.value == 'cullpick') {
      return '选扫描方向'
    }
    return '对局结束'
  })

  function showRules() {
    uni.showModal({
      title: '规则',
      content: '· 双方牌组都是固定的 52 张，2-10 按面值，J、Q、K 都算 10 点。\n'
        + '· 点数从不在出牌时定死：A 可算 1 或 11，点数类贴纸还能再变，\n'
        + '  总分每次都按不爆的前提往 ' + GOAL + ' 点靠，自动挑最好的算法。\n'
        + '· 双方各保持 ' + HAND_SIZE + ' 张手牌，多弃少补。\n'
        + '· 轮到自己时只能出一张牌，或者停牌。对方停牌后你可以一直出下去。\n'
        + '· 双方都停牌才结算，点数更接近 ' + GOAL + ' 的一方获胜；爆牌当场判负。\n'
        + '· 停牌不是终点：只要你桌上的点数被改动过，就自动退出停牌继续打。\n'
        + '· 双方同时爆牌算平局，洗牌重来；同一关最多平局 ' + MAX_PUSH + ' 次，再平就算没过。\n'
        + '· 贴纸分三类：永续（在场就一直生效）、立即（打出的当下选择发不发动）、\n'
        + '  横置（留在桌上，想用的时候横置它）。贴纸牌无论发不发动都照常计点。\n'
        + '· 横置过的牌自己转不回来，只有【鼓舞】能把它转回去。\n'
        + '· 结局对你不利时，结算前还会给你一次额外的横置机会翻盘。\n'
        + '· 高关卡的庄家会盖牌：它最先打出的几张你看不到，点数显示成「明面+?」，\n'
        + '  要到结算才翻开。盖着的牌被你讨走或送过来时会翻明。\n'
        + '· 通关奖励 ' + level.value.rewardCount + ' 张'
        + rarityAt(level.value.rewardRarity).name + '券；输了不扣东西，可以改牌组再打。\n'
        + '· 券只在首次通关时发，通过的关卡还能回来重打，用来刷成就和试牌组。\n'
        + '· 有些贴纸靠通关解锁，有些要在牌桌上做出对应的事才解锁，去货架上看条件。',
      showCancel: false,
      confirmText: '知道了'
    })
  }

  function goBack() {
    uni.navigateBack()
  }

  onUnmounted(() => {
    if (dealerTimer != -1) {
      clearTimeout(dealerTimer)
      dealerTimer = -1
    }
  })

  setup()
</script>

<style>
  /* 整页固定一屏，纵向不滚动 */
  .page {
    flex: 1;
    padding: 8px 10px;
    background-color: #0b5d3b;
  }

  /* 顶部信息栏 */
  .topbar {
    flex-direction: row;
    justify-content: space-between;
    background-color: #084730;
    border-radius: 8px;
    padding: 6px 10px;
  }

  .topbar-item {
    flex: 1;
    align-items: center;
  }

  .topbar-label {
    color: #9fd9bd;
    font-size: 11px;
  }

  .topbar-value {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
  }

  /* 对局双方 */
  .side {
    flex: 1;
    min-height: 82px;
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    background-color: #0e6b45;
    border-radius: 8px;
    padding: 6px 10px;
  }

  .side-info {
    width: 64px;
  }

  .side-name {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
  }

  .side-sub {
    color: #9fd9bd;
    font-size: 10px;
  }

  .side-total {
    width: 62px;
    color: #e8b23a;
    font-size: 28px;
    font-weight: bold;
    text-align: center;
  }

  .total-bust {
    color: #ff8a80;
  }

  /* 桌上打出的牌，多了可以横向滑 */
  .board {
    flex: 1;
    height: 68px;
  }

  .board-row {
    flex-direction: row;
    align-items: center;
  }

  .played-tip {
    color: #8fc7ab;
    font-size: 11px;
  }

  /* 牌面 */
  .card {
    width: 46px;
    height: 64px;
    background-color: #ffffff;
    border-radius: 5px;
    margin-right: 6px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-style: solid;
    border-color: #ffffff;
  }

  .card-hand {
    margin-right: 5px;
  }

  .card-stickered {
    border-color: #e8b23a;
  }

  /* 还能横置发动的牌，描边亮一点 */
  .card-ready {
    border-color: #7ce0a3;
  }

  /* 横置过的牌，压暗表示用过了 */
  .card-tapped {
    background-color: #bdbdbd;
    border-color: #8a8a8a;
  }

  /* 盖着的暗牌：看不到牌面，也算不进明面的点数 */
  .card-back {
    background-color: #123f6b;
    border-color: #0b2a48;
  }

  .card-back-mark {
    color: #7fb2e5;
    font-size: 22px;
    font-weight: bold;
  }

  .card-rank {
    color: #1a1a1a;
    font-size: 17px;
    font-weight: bold;
  }

  .card-suit {
    color: #1a1a1a;
    font-size: 13px;
  }

  .card-red {
    color: #d93025;
  }

  /* 贴纸名要完整显示，牌面又只有 46px 宽，字号压到 10px 刚好放下两个字 */
  .card-sticker {
    color: #b8860b;
    font-size: 10px;
    font-weight: bold;
  }

  /* 蝶改过的点数 + 横置状态，合并成一行 */
  .card-mark {
    color: #1f7a4d;
    font-size: 9px;
    font-weight: bold;
  }

  /* 提示信息 */
  .message-box {
    height: 40px;
    margin-top: 6px;
    border-radius: 6px;
    padding: 4px 10px;
    justify-content: center;
    background-color: #084730;
  }

  .message-win {
    background-color: #1f7a4d;
  }

  .message-lose {
    background-color: #8c2f2a;
  }

  .message-push {
    background-color: #6b5a1e;
  }

  .message-text {
    color: #ffffff;
    font-size: 12px;
    line-height: 16px;
  }

  /* 手牌区 */
  .hand-area {
    height: 96px;
    margin-top: 6px;
  }

  .hand-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .hand-title {
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
  }

  .hand-tip {
    color: #9fd9bd;
    font-size: 11px;
  }

  /* 停牌按钮：这一局最重要的决定 */
  .stand-btn {
    color: #3b2a00;
    font-size: 12px;
    font-weight: bold;
    background-color: #e8b23a;
    border-radius: 12px;
    padding: 3px 14px;
  }

  .hand {
    flex-direction: row;
    margin-top: 4px;
  }

  /* 双子摊开的候选牌，多了可以横向滑 */
  .pick-box {
    height: 70px;
    margin-top: 4px;
  }

  /* 窥探面板 */
  .peek-box {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
  }

  .peek-label {
    color: #9fd9bd;
    font-size: 11px;
    margin-right: 8px;
  }

  .peek-btn {
    color: #3b2a00;
    font-size: 12px;
    font-weight: bold;
    background-color: #e8b23a;
    border-radius: 12px;
    padding: 5px 12px;
    margin-left: 8px;
  }

  .over-box {
    flex: 1;
    align-items: center;
    justify-content: center;
  }

  .over-text {
    color: #ffffff;
    font-size: 13px;
    text-align: center;
  }

  .btn {
    height: 40px;
    border-radius: 20px;
    margin-top: 6px;
    padding: 0 28px;
    align-items: center;
    justify-content: center;
  }

  .btn-primary {
    background-color: #e8b23a;
  }

  .btn-text {
    color: #3b2a00;
    font-size: 15px;
    font-weight: bold;
  }

  /* 底部状态 */
  .toolbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
  }

  .toolbar-text {
    color: #8fc7ab;
    font-size: 11px;
  }

  .toolbar-link {
    color: #e8b23a;
    font-size: 12px;
  }

  /* 弃牌堆浮层 */
  .overlay {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    align-items: center;
    justify-content: center;
    padding: 16px;
  }

  .overlay-panel {
    width: 100%;
    max-height: 70%;
    background-color: #0e6b45;
    border-radius: 10px;
    padding: 10px 12px;
  }

  .overlay-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .overlay-title {
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
  }

  .overlay-count {
    color: #e8b23a;
    font-size: 12px;
  }

  .overlay-close {
    color: #ffffff;
    font-size: 13px;
  }

  .overlay-body {
    max-height: 340px;
    margin-top: 6px;
  }

  .discard-label {
    color: #9fd9bd;
    font-size: 12px;
    margin-top: 6px;
  }

  .mini-cards {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .mini-card {
    width: 28px;
    height: 38px;
    background-color: #ffffff;
    border-radius: 4px;
    margin-right: 5px;
    margin-top: 5px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-style: solid;
    border-color: #ffffff;
  }

  .mini-rank {
    color: #1a1a1a;
    font-size: 12px;
    font-weight: bold;
  }

  .mini-suit {
    color: #1a1a1a;
    font-size: 10px;
  }
</style>
