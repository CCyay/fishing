<template>
  <view class="page">
    <view class="head">
      <view class="head-item">
        <text class="head-label">金币</text>
        <text id="rs-coins" class="head-value head-coin">{{ save.runCoins }}</text>
      </view>
      <view class="head-item">
        <text class="head-label">下一关</text>
        <text id="rs-next" class="head-value">{{ nextText }}</text>
      </view>
      <view class="head-item">
        <text class="head-label">道具栏</text>
        <text id="rs-slots" class="head-value">{{ usedSlots }}/{{ save.runSlots }}</text>
      </view>
    </view>

    <view class="bar">
      <text class="bar-text">{{ barText }}</text>
    </view>

    <text v-if="gained != ''" class="gained">{{ gained }}</text>

    <scroll-view class="body">
      <!-- 道具栏：这一关带上场的就是这几件。
           格数随关卡白给，不花钱 —— 所以这一块只管配，不管买 -->
      <text class="section">道具栏 {{ save.runSlots }} 格 · 点一下卸掉不想带的</text>
      <view class="slot-row">
        <view
          v-for="(key, si) in slotKeys"
          :key="'s-' + si"
          :id="'rs-slot-' + si"
          class="slot"
          :class="{ 'slot-empty': key == '' }"
          @click="tapSlot(si)">
          <text v-if="key == ''" class="slot-plus">空</text>
          <text v-else class="slot-name" :style="'color: ' + tierColor(tierOf(key))">{{
            nameOf(key)
          }}</text>
        </view>
      </view>

      <!-- 道具库紧挨着道具栏：这两块是一套操作 ——
           点库里的一件就装进上面的空格，隔着别的分区来回够太难受。
           右边那颗按钮是进阶，跟「装上场」分开点，免得误触花钱 -->
      <text class="section">道具库 {{ ownedTotal }} 件 · 点名字装上场 · 点「升」进阶</text>
      <view class="lib-list">
        <text v-if="libKeys.length == 0" class="dim">库里还没有道具，下面买</text>
        <view
          v-for="(key, li) in libKeys"
          :key="'l-' + li"
          :id="'rs-lib-' + li"
          class="lib-item">
          <view class="lib-main" :class="{ 'chip-out': !canEquip(key) }" @click="tapLib(key)">
            <text class="chip-name" :style="'color: ' + tierColor(tierOf(key))">{{
              nameOf(key)
            }}</text>
            <!-- 标一下它走哪条路，攒同一路的才看得出自己在走什么 -->
            <text class="lib-way" :style="'color: ' + wayColor(wayOf(key))">{{
              wayName(wayOf(key))
            }}</text>
            <text class="lib-tier">{{ tierName(tierOf(key)) }}</text>
            <text v-if="equipped(key)" class="lib-on">已带</text>
          </view>
          <text
            v-if="upCostOf(key) > 0"
            :id="'rs-up-' + li"
            class="lib-up"
            :class="{ 'lib-up-poor': save.runCoins < upCostOf(key) }"
            @click="tapUpgrade(key)"
            >升 {{ upCostOf(key) }}</text
          >
          <text v-else class="lib-top">满级</text>
        </view>
      </view>

      <!-- 货架：随机上货，买走一件就空一格。
           只出普通和稀有 —— 史诗、传说买不到，只能靠进阶升上去。
           盲盒跟道具摆在一排，每批只有一个，是兜底：
           货架上没中意的、或者钱不够买那几件时，它是唯一还买得动的 -->
      <view class="shelf-head">
        <text class="section">货架 · 第 {{ save.runLevel }} 关的行情</text>
        <text id="rs-reroll" class="reroll" @click="reroll">换一批 {{ rerollCost }}</text>
      </view>
      <!-- 盲盒的概率摆在明面上。要赌总得先知道赌的是什么 -->
      <text class="odds">盲盒 {{ blindOdds }}</text>
      <view class="lib-row">
        <view
          v-for="(one, gi) in shelf"
          :key="'g-' + gi"
          :id="'rs-buy-' + gi"
          class="goods"
          :class="{ 'goods-sold': one.key == '', 'goods-sale': one.key != '' && gi == saleAt }"
          @click="buyItem(gi)">
          <text v-if="one.key == ''" class="goods-sold-text">已售</text>
          <view v-else class="goods-inner">
            <text class="goods-name" :style="'color: ' + tierColor(one.tier)">{{
              nameOf(one.key)
            }}</text>
            <text class="goods-way" :style="'color: ' + wayColor(wayOf(one.key))">{{
              wayName(wayOf(one.key))
            }}</text>
            <text class="goods-price" :class="{ 'goods-price-sale': gi == saleAt }">{{
              priceAt(gi)
            }}</text>
            <text v-if="gi == saleAt" class="goods-tag">半价</text>
          </view>
        </view>
        <!-- 盲盒：这一批就这一个，买完等换批 -->
        <view
          id="rs-blind"
          class="goods goods-blind"
          :class="{ 'goods-sold': blindSold }"
          @click="buyBlind">
          <text v-if="blindSold" class="goods-sold-text">已售</text>
          <view v-else class="goods-inner">
            <text class="goods-name goods-blind-name">盲盒</text>
            <text class="goods-price">{{ blindCost }}</text>
          </view>
        </view>
      </view>

      <text v-if="tip != ''" class="tip">{{ tip }}</text>
    </scroll-view>

    <view class="actions">
      <view id="rs-go" class="act-btn act-btn-primary" @click="goNext">
        <text class="act-text act-text-dark">{{ goText }}</text>
      </view>
      <view id="rs-quit" class="act-btn" @click="goHome">
        <text class="act-text">回首页</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  // 排竿的商店，每打完一关就进这儿一趟。
  //
  // 三件事在这页办完：把赢来的金币花掉（买道具、给道具进阶）、
  // 把道具装进道具栏、然后进下一关。
  //
  // 货架是随机上货的，这是这套玩法经得起重复玩的关键 ——
  // 要是每次都买得到想要的，几轮之后所有挑战都会收敛成同一套最优解。
  //
  // 但**进阶不随机**：手里的道具随时能升，只要钱够。
  // 升级要是也得靠刷新运气，攒钱这件事就没法计划了
  import {
    SaveData,
    emptySave,
    loadCurrentSave,
    saveCurrent,
    cloneSave,
    firstFreeSlot,
    setRunEquip,
    itemTierOf,
    ownsRunItem,
    addRunItem,
    upgradeRunItem,
    runSpare,
    runEquipped,
    trimEquip,
    setCurrentRelayLevel
  } from '@/pages/examples/blackjack/save.uts'
  import {
    RELAY_COUNT,
    SHOP_SIZE,
    REROLL_PRICE,
    blindPrice,
    shelfWeights,
    rollRarity,
    slotsAt,
    relayLevelAt
  } from '@/pages/examples/blackjack/relay-levels.uts'
  import {
    RELAY_ITEMS,
    itemAt,
    itemIndexOf,
    maxTierOf,
    nextTierOf,
    upgradePrice,
    buyPrice,
    descOf as itemDescAt,
    tierName,
    tierColor,
    wayOf,
    wayName,
    wayColor,
    discountOf
  } from '@/pages/examples/blackjack/relay-items.uts'

  // 货架上的一件：卖哪件、卖第几级。
  // 同一件道具在普通档和稀有档是两个价、两种货
  type Goods = {
    key : string
    tier : number
  }

  const save = ref<SaveData>(emptySave())
  // 货架上这一批。买走的位置留个空 key 占位，不重排 ——
  // 一买就整排往左跳，手会点错
  const shelf = ref<Goods[]>([] as Goods[])
  // 这一批的盲盒卖掉没有。每批就一个，买完等换批
  const blindSold = ref<boolean>(false)
  // 这一批哪一件半价。-1 表示没有
  const saleAt = ref<number>(-1)
  const tip = ref<string>('')
  // 刚打完那一关赚了多少，进店时在顶上说一句
  const gained = ref<string>('')

  const nextText = computed<string>(() : string => {
    const lv = save.value.runLevel
    if (lv > RELAY_COUNT) {
      return '已通关'
    }
    return lv + ' ' + relayLevelAt(lv).name
  })

  const goText = computed<string>(() : string => {
    return save.value.runLevel > RELAY_COUNT ? '看结算' : '进下一关'
  })

  const slotKeys = computed<string[]>(() : string[] => {
    const list : string[] = []
    for (let i = 0; i < save.value.runSlots; i++) {
      list.push(i < save.value.runEquip.length ? save.value.runEquip[i] : '')
    }
    return list
  })

  const usedSlots = computed<number>(() : number => {
    let n = 0
    for (let i = 0; i < slotKeys.value.length; i++) {
      if (slotKeys.value[i] != '') {
        n = n + 1
      }
    }
    return n
  })

  // 库里有的那些道具，按表的顺序列 ——
  // 同名只会有一件，所以这儿就是一串 key
  const libKeys = computed<string[]>(() : string[] => {
    const list : string[] = []
    for (let i = 0; i < RELAY_ITEMS.length; i++) {
      const at = itemIndexOf(RELAY_ITEMS[i].key)
      if (at >= 0 && at < save.value.runTiers.length && save.value.runTiers[at] > 0) {
        list.push(RELAY_ITEMS[i].key)
      }
    }
    return list
  })

  const ownedTotal = computed<number>(() : number => {
    return libKeys.value.length
  })

  // 格子决定这一关带几件上场，不是总共能有几件 ——
  // 库里八件、格子三个，就得挑三件
  const barText = computed<string>(() : string => {
    const free = save.value.runSlots - usedSlots.value
    if (free <= 0) {
      return '道具栏装满了。想换别的先点一格卸下来'
    }
    return '还空着 ' + free + ' 格 · 限制类的次数下一关自己回满'
  })

  const rerollCost = computed<number>(() : number => {
    return discountOf(regularTier(), REROLL_PRICE)
  })

  // ---------- 上货 ----------
  //
  // 货架只出普通和稀有两档。史诗、传说买不到 —— 那两档只能靠进阶升上去，
  // 不然攒钱一级级升的人就成了冤大头。
  //
  // 同名道具只会有一件，所以手里已经有的一律不再上架：
  // 手上那件该走的是进阶，不是再买一件

  function restock() {
    const list : Goods[] = []
    for (let i = 0; i < SHOP_SIZE; i++) {
      const one = pickGoods()
      if (one.key == '') {
        break
      }
      list.push(one)
    }
    shelf.value = list
    blindSold.value = false
    // 这一批挑一件半价。摆完货才挑 —— 挑的是位置不是道具，
    // 于是特价落在哪一件全看运气，有时是件便宜的，有时是件贵的
    saleAt.value = list.length > 0 ? Math.floor(Math.random() * list.length) : -1
  }

  // 上一件货，分两层抽。
  //
  // 第一层按关号摇档位：头两关八成半是普通，后半程反过来。
  // 不这么分的话，第一关货架上全摆稀有等于逗人 —— 那会儿金币也买不起；
  // 打到第九关还全是最便宜那档，又等于没货可买。
  //
  // 第二层在还没买过的里头随便挑一件
  function pickGoods() : Goods {
    const tier = rollRarity(shelfWeights(save.value.runLevel), tierHasStock(), Math.random())
    if (tier < 0) {
      return { key: '', tier: 0 } as Goods
    }
    const list = freshKeys()
    if (list.length == 0) {
      return { key: '', tier: 0 } as Goods
    }
    const key = list[Math.floor(Math.random() * list.length)]
    // 摇中稀有档、但这件只有一级（长竿那种）的话，就还按普通档卖
    const top = maxTierOf(itemAt(key))
    return { key: key, tier: tier > top ? top : tier } as Goods
  }

  // 还没买过、而且这一批货架上也还没摆着的那些。
  // 摆两件同名的在一排，买了一件另一件就作废，那是白占格子
  function freshKeys() : string[] {
    const list : string[] = []
    for (let i = 0; i < RELAY_ITEMS.length; i++) {
      const key = RELAY_ITEMS[i].key
      if (ownsRunItem(save.value, key) || onShelf(key)) {
        continue
      }
      list.push(key)
    }
    return list
  }

  function onShelf(key : string) : boolean {
    for (let i = 0; i < shelf.value.length; i++) {
      if (shelf.value[i].key == key) {
        return true
      }
    }
    return false
  }

  // 两档各还有没有货。没有还没买过的道具了就整个不摇了
  function tierHasStock() : boolean[] {
    const any = freshKeys().length > 0
    return [any, any] as boolean[]
  }

  function reroll() {
    const cost = rerollCost.value
    if (save.value.runCoins < cost) {
      warn('金币不够换这一批，差 ' + (cost - save.value.runCoins))
      return
    }
    confirmBuy('换一批新货？', cost, () => {
      const data = save.value
      data.runCoins = data.runCoins - cost
      commit(data, '')
      restock()
      tip.value = '换了一批新货'
    })
  }

  // ---------- 买 ----------

  // 这一批里有一件半价。
  //
  // 它的用处是把「按计划买」和「捡便宜」摆在一起为难人：
  // 特价那张未必是你要的路子，但半价的史诗跟原价的稀有摆在一排，
  // 这一笔钱花在哪儿就不是显然的了。
  // 熟客的八折照样叠在半价上面 —— 两样都是折扣，没有互斥的道理
  function priceAt(index : number) : number {
    const one = shelf.value[index]
    if (one.key == '') {
      return 0
    }
    // 底价买数值、进阶费买广度，买一件第 N 级的就是两样加起来
    let base = buyPrice(itemAt(one.key), one.tier)
    if (index == saleAt.value) {
      base = Math.floor(base / 2)
      if (base < 1) {
        base = 1
      }
    }
    return discountOf(regularTier(), base)
  }

  function buyItem(index : number) {
    const one = shelf.value[index]
    if (one.key == '') {
      return
    }
    const cost = priceAt(index)
    const data = save.value
    if (data.runCoins < cost) {
      warn('金币不够，差 ' + (cost - data.runCoins))
      return
    }
    // 同名只会有一件。上货那边已经把买过的剔掉了，这儿再兜一道 ——
    // 上一次上货之后可能又从盲盒里开出了同一件
    if (ownsRunItem(data, one.key)) {
      warn('【' + nameOf(one.key) + '】已经有了，手上那件去点「升」')
      return
    }
    const head = index == saleAt.value ? '半价买下【' : '买下【'
    confirmBuy(head + nameOf(one.key) + '·' + tierName(one.tier) + '】？', cost, () => {
      doBuyItem(index, one, cost)
    })
  }

  function doBuyItem(index : number, one : Goods, cost : number) {
    const data = save.value
    if (!addRunItem(data, one.key, one.tier)) {
      return
    }
    data.runCoins = data.runCoins - cost
    // 买来的顺手装进空格，省得还要回去点一遍。格子满了就先躺在库里
    const slot = firstFreeSlot(data)
    if (slot >= 0) {
      setRunEquip(data, slot, one.key)
    }
    // 买走的留个空位，不把后面的挪上来 —— 一买就整排往左跳，手会点错
    const next : Goods[] = []
    for (let i = 0; i < shelf.value.length; i++) {
      next.push(i == index ? ({ key: '', tier: 0 } as Goods) : shelf.value[i])
    }
    shelf.value = next
    commit(data, '')
    tip.value = slot >= 0
      ? '买下【' + nameOf(one.key) + '】，装进第 ' + (slot + 1) + ' 格'
      : '买下【' + nameOf(one.key) + '】，道具栏满了，先在库里躺着'
  }

  // ---------- 进阶 ----------
  //
  // 不绑货架：手里的道具随时能升，只要钱够。
  // 升级要是也得靠刷新运气，攒钱这件事就没法计划了

  // 这件升一级要多少。已经满级返回 0
  function upCostOf(key : string) : number {
    const now = itemTierOf(save.value, key)
    if (now < 0) {
      return 0
    }
    const to = nextTierOf(itemAt(key), now)
    if (to < 0) {
      return 0
    }
    return discountOf(regularTier(), upgradePrice(to))
  }

  function tapUpgrade(key : string) {
    const data = save.value
    const now = itemTierOf(data, key)
    const item = itemAt(key)
    const to = nextTierOf(item, now)
    if (to < 0) {
      warn('【' + nameOf(key) + '】已经满级了')
      return
    }
    const cost = upCostOf(key)
    if (data.runCoins < cost) {
      warn('金币不够，差 ' + (data.runCoins < cost ? cost - data.runCoins : 0))
      return
    }
    // 跨级的道具一跳两级，确认框里要把落点说清楚，
    // 不然玩家以为花了两级的钱只升了一级
    const jump = to - now > 1 ? '（直接跳到 ' + tierName(to) + '）' : ''
    confirmBuy(
      '把【' + nameOf(key) + '】升到 ' + tierName(to) + jump + '？\n\n'
        + itemDescAt(item, to),
      cost,
      () => {
        const d = save.value
        if (!upgradeRunItem(d, key)) {
          return
        }
        d.runCoins = d.runCoins - cost
        commit(d, '')
        tip.value = '【' + nameOf(key) + '】升到 ' + tierName(itemTierOf(d, key))
      }
    )
  }

  const blindCost = computed<number>(() : number => {
    return discountOf(regularTier(), blindPrice(save.value.runLevel))
  })

  // 开出各档的概率，摊开写给人看。
  //
  // 盲盒是要花钱赌的，赌之前总得知道赌的是什么概率 ——
  // 藏着不写，那是坑人不是设计。
  // 权重加起来正好 100，所以直接当百分比用
  const blindOdds = computed<string>(() : string => {
    const weights = shelfWeights(save.value.runLevel)
    let text = ''
    for (let i = 0; i < weights.length; i++) {
      if (weights[i] <= 0) {
        continue
      }
      if (text != '') {
        text = text + ' · '
      }
      text = text + tierName(i) + ' ' + weights[i] + '%'
    }
    return text
  })

  // 开一个盲盒：先按权重摇稀有度，再从那一档里随便挑一张。
  //
  // 稀有度跟货架用同一张随关号走的权重表，所以早期开不出传说。
  // 但挑具体哪张时不偏向「库里已经有的」—— 盲盒本来就是赌，
  // 偏向了就成了另一个货架
  function buyBlind() {
    const cost = blindCost.value
    const data = save.value
    if (blindSold.value) {
      return
    }
    if (data.runCoins < cost) {
      warn('金币不够，差 ' + (cost - data.runCoins))
      return
    }
    // 概率写在确认框里 —— 掏钱那一下才是真正需要看见它的时候
    uni.showModal({
      title: '开一个盲盒？',
      content: '花 ' + cost + ' 金币，还剩 ' + (data.runCoins - cost)
        + '\n\n开出的概率：' + blindOdds.value,
      confirmText: '开',
      cancelText: '算了',
      success: (res) => {
        if (res.confirm) {
          doBuyBlind(cost)
        }
      }
    })
  }

  // 盲盒：从你还没有的那些里摇一件出来。
  //
  // 同名只会有一件，所以盒子必须从「还没有的」里摇 ——
  // 开出重复的等于白花钱。这也正是它现在的定位：
  // 货架贵但挑得着，盒子便宜但挑不着，开出来必定是新东西
  function doBuyBlind(cost : number) {
    const data = save.value
    const list = freshKeysForBlind()
    if (list.length == 0) {
      warn('道具都买齐了，盒子里没有你还没有的')
      return
    }
    const tier = rollRarity(shelfWeights(data.runLevel), [true, true] as boolean[], Math.random())
    const key = list[Math.floor(Math.random() * list.length)]
    const top = maxTierOf(itemAt(key))
    let got = tier < 0 ? 0 : tier
    if (got > top) {
      got = top
    }
    if (!addRunItem(data, key, got)) {
      return
    }
    data.runCoins = data.runCoins - cost
    const slot = firstFreeSlot(data)
    if (slot >= 0) {
      setRunEquip(data, slot, key)
    }
    blindSold.value = true
    commit(data, '')
    tip.value = '盲盒开出【' + nameOf(key) + '】（' + tierName(got) + '）'
      + (slot >= 0 ? '，装进第 ' + (slot + 1) + ' 格' : '，道具栏满了先躺库里')
  }

  // 盲盒不看货架上摆着什么 —— 它是另一条路，
  // 只要求「你还没有这件」
  function freshKeysForBlind() : string[] {
    const list : string[] = []
    for (let i = 0; i < RELAY_ITEMS.length; i++) {
      if (!ownsRunItem(save.value, RELAY_ITEMS[i].key)) {
        list.push(RELAY_ITEMS[i].key)
      }
    }
    return list
  }

  // ---------- 道具库与道具栏 ----------

  function nameOf(key : string) : string {
    return itemAt(key).name
  }

  function tierOf(key : string) : number {
    return itemTierOf(save.value, key)
  }

  function equipped(key : string) : boolean {
    return runEquipped(save.value, key)
  }

  // 这件现在能不能往格子上放：库里有、而且还没装上场
  function canEquip(key : string) : boolean {
    return runSpare(save.value, key)
  }

  // 熟客现在是一件永续道具，折扣随它的等级走。
  // 只认「带上场没有」—— 躺在库里的不算数，跟别的永续道具一个规矩
  function regularTier() : number {
    return runEquipped(save.value, 'regular') ? itemTierOf(save.value, 'regular') : -1
  }

  // 点库里的道具：装进第一个空格。
  // 卸下来不会丢 —— 道具一直在库里，格子只是「这一关带哪几件」
  function tapLib(key : string) {
    const data = save.value
    if (!canEquip(key)) {
      tip.value = '这件已经带上场了'
      return
    }
    const slot = firstFreeSlot(data)
    if (slot < 0) {
      tip.value = '道具栏满了，先点一格把它卸下来'
      return
    }
    setRunEquip(data, slot, key)
    commit(data, '')
    tip.value = '第 ' + (slot + 1) + ' 格装上【' + nameOf(key) + '】'
  }

  // 点格子上的道具：卸回库里。库存不变，只是这一关不带它
  function tapSlot(index : number) {
    if (index >= slotKeys.value.length || slotKeys.value[index] == '') {
      return
    }
    const key = slotKeys.value[index]
    const data = save.value
    setRunEquip(data, index, '')
    commit(data, '')
    tip.value = '【' + nameOf(key) + '】放回库里了'
  }

  // ---------- 出门 ----------

  function goNext() {
    const data = save.value
    const lv = data.runLevel
    if (lv > RELAY_COUNT) {
      // 十关打完了，这一轮到头 —— 回入口那边看战绩
      uni.navigateBack()
      return
    }
    // 出了这个门就不在商店了。放下牌子，「继续」才会直奔牌桌
    data.runShop = false
    saveCurrent(data)
    save.value = cloneSave(data)
    setCurrentRelayLevel(lv)
    uni.redirectTo({
      url: '/pages/examples/blackjack/relay'
    })
  }

  function goHome() {
    // 中途走人不算输，这一轮的家当都存着。
    // runShop 那个牌子还立着 —— 下次点「继续」会回到这儿，
    // 东西没买完不至于被直接推上牌桌
    uni.navigateBack()
  }

  function commit(data : SaveData, msg : string) {
    saveCurrent(data)
    save.value = cloneSave(data)
    if (msg != '') {
      tip.value = msg
    }
  }

  // 买不成的话要当场弹出来。
  // 压在页面最底下那行小字里等于没提示 —— 手指在货架上，眼睛不在那儿
  function warn(msg : string) {
    uni.showToast({
      icon: 'none',
      title: msg
    })
  }

  // 花钱之前问一句。金币是一轮挑战里最要紧的东西，
  // 点歪一下少一件道具，这一轮可能就折在某一关上了
  function confirmBuy(title : string, cost : number, onYes : () => void) {
    uni.showModal({
      title: title,
      content: '花 ' + cost + ' 金币，还剩 ' + (save.value.runCoins - cost),
      confirmText: '买',
      cancelText: '算了',
      success: (res) => {
        if (res.confirm) {
          onYes()
        }
      }
    })
  }

  onLoad((options : OnLoadOptions) => {
    // 上一关赚了多少，从牌桌那边带过来的。路上编过码，这儿解回来
    const got = options['got']
    if (got != null) {
      gained.value = decodeURIComponent('' + got)
    }
  })

  onShow(() => {
    const data = loadCurrentSave()
    // 格数纯粹由关号白送（竿架那件取消了）。在这儿对一次 ——
    // 进店时正好是下一关的关号，于是「打到第几关就有几格」对得上
    const want = slotsAt(data.runLevel)
    if (data.runSlots != want) {
      data.runSlots = want
      saveCurrent(data)
    }
    // 格子上装着库里已经没有的、或者同一件占了两格的，清掉兜个底
    trimEquip(data)
    save.value = data
    // 这一批货只上一次。每次回到这页都重抽的话，
    // 出去看一眼再回来就换了一批，等于白送刷新
    if (shelf.value.length == 0) {
      restock()
    }
  })

  save.value = loadCurrentSave()
  restock()
</script>

<style>
  .page {
    flex: 1;
