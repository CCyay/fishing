  /* 左栏宽度写死 —— 不写死的话名字长短不一，右边那栏起始位置
     就会一行一个样，整列读起来是歪的 */
  .lib-head {
    width: 62px;
    margin-right: 8px;
  }

  .lib-desc {
    flex: 1;
    color: #9fd9bd;
    font-size: 10px;
