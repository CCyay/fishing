    margin-top: 2px;
  }

  /* 盲盒跟贴纸摆一排，描紫分开 —— 那几件是看着买的，这个是赌的 */
  .goods-blind {
    border-color: #d59bff;
  }

  .goods-blind-name {
    color: #d59bff;
  }

  /* 道具 */
  .item-row {
    margin-top: 4px;
  }

  .item {
    background-color: #0e6b45;
    border-radius: 8px;
    padding: 6px 9px;
    margin-bottom: 5px;
    border-width: 1px;
