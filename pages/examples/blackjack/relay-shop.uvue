    color: #e8b23a;
    font-size: 11px;
  }

  /* 这一批的半价货：描红，价钱也换个色 —— 扫一眼就该看见 */
  .goods-sale {
    border-color: #ff7a59;
    background-color: #12764e;
  }

  .goods-price-sale {
    color: #ff9e80;
  }

  /* 半价的角标：贴在卡片右上角。
     外侧那个角跟卡片同半径，内侧那个角切一刀，看着像条压角的带子 */
  .goods-ribbon {
    position: absolute;
    top: 0;
    right: 0;
    color: #3b2a00;
    background-color: #e8b23a;
    font-size: 9px;
    font-weight: bold;
    padding: 1px 5px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
  }

  /* 选中的那件：描白一圈，跟没选的分开 */
  .goods-on {
    border-color: #ffffff;
  }

  /* 选中那件的效果 + 买下按钮，摆在货架正上方。
     没选东西的时候摆盲盒的概率，所以这块地方一直有内容、高度不跳 */
  .pick-row {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
