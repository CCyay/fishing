    justify-content: center;
  }

  .chip-out {
    opacity: 0.4;
  }

  .chip-name {
    font-size: 13px;
    font-weight: bold;
  }

  .chip-count {
    color: #9fd9bd;
    font-size: 9px;
  }

  /* 道具库一件一行：左边点了装上场，右边那颗点了进阶。
     两件事分开点 —— 挤成一块的话，想装上场结果花了钱 */
  .lib-list {
    margin-top: 4px;
  }

  .lib-item {
    flex-direction: row;
    align-items: center;
    height: 36px;
    margin-bottom: 5px;
  }

  .lib-main {
    flex: 1;
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding: 0 9px;
    border-radius: 8px;
    background-color: #0e6b45;
  }

  .lib-tier {
    color: #9fd9bd;
    font-size: 10px;
    margin-left: 6px;
  }

  /* 走哪条路的标签。攒同一路的才看得出自己在走什么 */
  .lib-way {
    font-size: 10px;
    font-weight: bold;
    margin-left: 6px;
  }

  .goods-way {
    font-size: 9px;
