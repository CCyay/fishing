// 摸打钓鱼的 12 关。**12 关 = 12 个庄家角色**（见 DRAW_FOE_ROLES）：
//   浅滩 1–4：不带技能（1–2 随手出牌，3–4 会记牌，第 4 关上第一条特殊技）
//   河湾 5–8：一关一个主题，两两成对（淤滩→硬壳、掐口→偏流），盖 4–13 张
//   深海 9–12：每关换一种压力（信息 / 清场 / 压底 / 满配），盖 16–21 张
// 一轮要连胜 12 关，输一次从第 1 关重来（照排竿）。
//
// 关卡表本身只剩 7 个字段（原先那两个写死庄家配装的 levels / loadout 删了）
// —— 庄家配装现在来自角色表，而标签每一轮重摇（见 draw-save 的 rollFoeKit）。
//
// 为什么 12 关、金币怎么定，见根目录《摸打钓鱼-技能与关卡设计.md》；
// 十二个庄家角色为什么这么排，见《摸打钓鱼-庄家角色设计.md》

import {
  // 覆盖面的尺子：点数标签 4 张、花色标签 13 张
  RANK_CELL_COVER,
  SUIT_CELL_COVER,
  // 十二个庄家角色各自带的那几件技能（见 DRAW_FOE_ROLES）
  SK_HOOK,
  SK_TIDE,
  SK_SUITED,
  SK_LANTERN,
  SK_FREEZE,
  SK_LOWTIDE,
  SK_SUITIFY,
  SK_SPILL,
  SK_ODD,
  SK_HUEVOID,
  SK_VOID
  // 原先这儿还引着：
  //   UPGRADE_PRICE —— 砺钩的标价。砺钩删了。
  //   DrawLoadout / DRAW_SKILLS / SKILL_RANKS / emptyLoadout / FULL_COVER
  //     —— 关卡表里那两个写死的 levels / loadout 字段用的，字段删了。
  //   DrawKit / KitSlot / kitFromSlots / rollLabels —— rollFoeKitFor 用的，
  //     那个函数删了（见下面那块墓碑：摇和落盘必须是两步）。
} from '@/pages/examples/blackjack/draw-skills.uts'

export type DrawLevel = {
  id : number
  name : string
  chapter : string
  // 庄家会不会记牌。不会的话钓得到就钓，钓不到随手打
  smart : boolean
  // 庄家完全随机出牌：钓得到也不挑，手里随便打一张。只给第 1 关 ——
  // 新手关，让人先把「怎么钓」摸熟
  random : boolean
  // 过关给多少金币（再加胜分奖励）
  reward : number

  // ---- 原先这儿有 levels / loadout（庄家带什么，写死在表里）----
  //
  // 它们早就是死数据了（对局页读出来之后立刻被摇出来的那套覆盖掉），
  // 现在**庄家配装整个搬到 DRAW_FOE_ROLES 上**了，所以两个字段一起删。
  //
  // 关卡表现在只管「这一关叫什么、庄家怎么出牌、过关给多少钱」——
  // 带什么技能查 foeRoleAt(关号)
}

// 赢多少分额外给多少金币，最多这么多
export const MARGIN_BONUS_CAP : number = 10

// ---------- 商店的货 ----------

// 一次性道具。买了**立刻用**，所以没有「库存」那一层。
//
// 分四路：改牌组构成（推点数、同化、弃饵）、改技能（砺钩、洗点）、
// 开包（技能二选一/五选一、牌六选一）、**永久扩容**（加栏、加权）。
//
// 每次进店只上 SHOP_FIX_COUNT 种 —— 看见什么买什么，
// **买完就没了，刷新也不补**。这跟下面那一栏（技能和卡牌，刷新能补货）
// 是有意分开的：道具是「这一关的机会」，那一栏是「这一关的行情」
//
// ---------- 稀有度 ----------
//
// 三档。**档位越高越难摇到，但概率随关号往上走**（见 rareWeight）。
//
// 为什么要分档：十一种道具平摊权重的话，「这一关刷到什么」就是一次
// 均匀抽样 —— 后期和前期看见的东西没区别，而这个玩法是**一轮十二关
// 越往后家当越厚**。稀有度把货架变成一条曲线：前期摆的是零件
//（推点数、买牌、弃饵），后期才见得着翻盘的那几件。
//
// 它同时解决了另一件事：史诗那几件（五选一、加权）单看定价压不住 ——
// 后期钱多，180 块不是门槛。真正的门槛变成「**它出不出来**」
export const RARE_COMMON : number = 0
export const RARE_RARE : number = 1
export const RARE_EPIC : number = 2

export function rareName(rare : number) : string {
  if (rare == RARE_EPIC) {
    return '史诗'
  }
  return rare == RARE_RARE ? '稀有' : '普通'
}

// 第 level 关（1 起）上货时，这一档每件货占多少权重。
//
// 普通恒定、稀有和史诗往上爬 —— 爬的斜率越高档位越高，
// 于是三条线在第 12 关附近收到同一个量级上：
//
//            第 1 关      第 6 关      第 12 关
//   普通       100          100          100
//   稀有        18           53           95
//   史诗         3           23           47
//
// 按件数折成「一次上货里摆得出某档」的概率。
// 加了拓印 / 熔合 / 抹点 / 彩票 / 扩库之后表是
// **16 件：普通 8、稀有 7、史诗 1**，一次摆 3 种（模拟 20 万次）：
//
//             史诗      稀有（任一件）   某一件普通   某一件稀有
//   第 1 关    约 1%      约 39%          约 32%       约 6%
//   第 6 关    约 6%      约 72%          约 25%       约 14%
//   第 12 关   约 10%     约 85%          约 20%       约 19%
//
// 折成一整轮（第 2–12 关共 11 店）：某一件普通约见 2.7 次、某一件稀有约 1.6 次、
// 史诗【技能五选一】约 0.7 次。（11 件那会儿是 4.0 / 2.4 / 1.1。）
//
// **摊薄是这次加货的代价**。经验线是「一件货一轮至少见两次，才算能计划的东西」，
// 3 格道具栏按这条线大约撑得住 15–17 件 —— 现在正卡在线上，稀有档已经偏少。
// 再加货之前先动 SHOP_FIX_COUNT（3 → 4，16 件 4 格约等于 13 件 3 格），
// 别去拔高权重 —— 权重一拔，档位之间的相对关系也跟着变了。
// （【对调】做过又删了：它只对看花色的构筑有用，占一个名额不值。）
//
// 稀有后期八成上下，意味着稀有那几件（推三格、同化、熔合、技能二选一、
// 加栏、加架、扩库）后期基本每店都有一件 —— 它们是「刷到就赚」的那一类，常见是对的。
//
// 这几个数跟表的件数绑着 —— 往某一档加货会把别的档摊薄，
// 加完记得回来重算一遍
export function rareWeight(rare : number, level : number) : number {
  const step = level < 1 ? 0 : level - 1
  if (rare == RARE_EPIC) {
    return 3 + 4 * step
  }
  if (rare == RARE_RARE) {
    return 18 + 7 * step
  }
  return 100
}

export type FixItem = {
  key : string
  name : string
  price : number
  // 一句话说明。**必填** ——
  //
  // 这一栏早先只摆名字 + 价钱，因为头四件（推一格、推两格、推三格、同化）
  // 的名字就是说明。后来表里进了砺钩、洗点、三个包、四件唯一扩容 ——
  // 「加权」「平价」这种名字光看是猜不出来的，而它们一件 80 到 180 块，
  // 是整轮里最重的几笔。买之前看不见效果，那就不是取舍而是赌名字
  desc : string
  // 推几格。不改点数的一律 0
  step : number
  // 稀有度（RARE_*）
  rare : number
  // **唯一**：一轮之内只能买一次，买过就不再上货。
  // 三件扩容道具（加栏、加架、平价）是这一类 —— 它们改的是规则本身，
  // 能叠买的话「攒钱买到满」会变成唯一的正解
  once : boolean
}

// ---- 这儿原先有个 floor 字段和 FLOOR_SHARE（保底份额） ----
//
// 机制是：一件货在上货池里至少占多少**份额**（不是权重 —— 纯权重压不住后期，
// 因为稀有和史诗的权重往上爬、池子总量跟着涨，固定权重的份额会被稀释）。
//
// 全表只有两件需要它：【砺钩】（升级的唯一通道）和【洗点】（唯一的救济口）。
// 那两件都跟角色卡结构冲突、已经删了，于是**保底这套机制没有服务对象了**
//（weightsFor 跟着删，rollFixKeys 回到纯 rareWeight 加权抽）。
//
// 别的货都是「刷到就赚、刷不到算了」—— 它们不是通道，没有保底的理由

export const FIX_ITEMS : FixItem[] = [
  // 推点数那三件：一格、两格便宜又常见（普通），三格跨度大 —— 它能
  // 把一张 4 直接推到你技能管着的 7 上，那是精确调牌，所以压成稀有。
  //
  // **往上不封顶、往下最低到 A**（见 draw-skills.uvue 的 doPush）。
  // 从前到 K 就停；改成跟熔合同一套「点数可以超过 13」之后，
  // K 推一格就是 14 —— 一张没人对得上的大点数。零点牌也推得动（往上一格是 A）
  { key: 'push1', name: '推一格', desc: '挑一张牌，点数 ±1（往上不封顶）', price: 30,
    step: 1, rare: RARE_COMMON, once: false } as FixItem,
  { key: 'push2', name: '推两格', desc: '挑一张牌，点数 ±2（往上不封顶）', price: 50,
    step: 2, rare: RARE_COMMON, once: false } as FixItem,
  { key: 'push3', name: '推三格', desc: '挑一张牌，点数 ±3（往上不封顶）', price: 70,
    step: 3, rare: RARE_RARE, once: false } as FixItem,
  // 同化：右边那张完全变成左边那张（点数和花色都一样）。
  // 于是牌组里出现两张一模一样的牌，那两张必然互相钓得上
  //
  // 稀有：造一对必然互钓的牌是整张表里最直接的「加分结构」
  { key: 'same', name: '同化', desc: '挑两张牌，右边那张完全变成左边那张', price: 100,
    step: 0, rare: RARE_RARE, once: false } as FixItem,
  // 弃饵：从牌组里拿掉一张。
  //
  // ---- 它的用处是**提纯**，不是针对对手 ----
  //
  // 这一条当初想错过一次，记在这儿免得再想错：曾以为它能「抽走对手
  // 技能覆盖的那几个点数」。**不成立** —— 商店是打赢一关之后进的，
  // 那会儿你面对的是**下一关**的庄家，而它带什么技能你还没见过
  //（关卡页不报庄家信息，对局页那排是当前关的）。
  //
  // 它真正的用处是反过来的：**把自己用不上的牌删掉**。牌库变薄，
  // 你技能覆盖的那几个点数在里头的占比就上去了 —— 跟「推点数」
  // 一头一尾：一个把牌往自己的点数上拽，一个把够不着的清出去。
  //
  // 顺带还是条节奏轴：牌库薄 = 回合少 = 分差小。领先了就删牌收口，
  // 落后了就买牌加厚 —— 这条轴从前只有「加」没有「减」。
  //
  // 删到底能把某个点数**清空**，那条路是有意留着的（见 DECK_MIN）。
  // 它要针对对手只有一条路：**打过一轮，记住了第几关的庄家带什么**——
  // 那是熟练玩家的功课，不是界面递给你的信息。
  //
  // 比买牌（40）贵一点：买牌只是加一张，这个动的是整副牌的成色。
  //
  // 普通：它是「清出去」那条轴上唯一的一件，得常见得够你真能提纯一副牌
  //（删四张要刷到它四次）
  { key: 'drop', name: '弃饵', desc: '挑一张牌，从牌组里拿掉', price: 50,
    step: 0, rare: RARE_COMMON, once: false } as FixItem,
  // ---- 牌组改造第二批：拓印 / 熔合 / 抹点 ----
  //
  // 前面那几件管的是「加 / 减 / 推」，这三件补的是**复制、合并、清空**。
  //
  // 拓印：挑一张，牌组里多一张一模一样的（点数卡一起抄）。
  // 跟同化（100）的区别是**厚度**：同化是两张变一对、牌组不变厚；
  // 拓印是凭空多一张，代价是牌组变厚（受 DECK_CAP 管）。
  // 它也是唯一能把一张贴好点数卡的核心牌「再来一张」的办法 —— 所以不比同化便宜太多
  { key: 'copy', name: '拓印', desc: '挑一张牌，牌组里多一张一模一样的（点数卡一起抄）',
    price: 60, step: 0, rare: RARE_COMMON, once: false } as FixItem,
  // 熔合：两张**同花色**的牌合成一张，**点数相加**，可以超过 13（♠8 + ♠9 = ♠17）。
  // 两张都贴过点数卡的话，点数卡一起带到新牌上。
  //
  // 它一次做三件事：
  //   **牌组薄一张**（跟弃饵一样，所以受 DECK_MIN 管）；
  //   **造一个指定的点数** —— 5+8 造一张 K，比推三格跨得远，但两张牌换一张；
  //   **造一个没人对得上的大点数** —— 14 以上的牌原牌里一张都没有，
  //     只有别的熔合牌、磁钩（差 1）、齐顶碰得到。它几乎是一张安全饵，
  //     **可它留在你手里也几乎钓不到东西** —— 那是代价。
  //
  // **加出 11 就是 J**，通吃照样有（见 draw-save 的 fusedRank）。
  // 造 J 本来就有便宜路（推一格把 10 推成 J 只要 30），熔合这条更贵，不拦。
  // J 也能当料（算 11 点）—— 把通吃熔掉换一个大点数，是你自己的决定。
  //
  // **零点牌也收**：0 加上去等于没加，所以它熔进去就直接没了，另一张原样留着 ——
  // 这是一条花 90 块清掉零点牌的路（比弃饵贵，但弃饵要刷得到）。
  // 只有无点数牌不收：它没有点数，「相加」无从说起。
  // **熔合出来的牌还能再熔**（它的点数是个真数），所以 ♠K + ♠K + ♠K 能熔到 39 ——
  // 一张三十九点的牌没人钓得上，也钓不上任何人，花两次钱换一张死牌，不拦
  { key: 'fuse', name: '熔合', desc: '挑两张同花色的牌合成一张，点数相加（可以超过 13，加出 11 就是 J）',
    price: 90, step: 0, rare: RARE_RARE, once: false } as FixItem,
  // 抹点：挑一张，它从此**没有点数**（点数卡一起抹掉），变成一张无点数牌。
  //
  // 无点数牌按点数钓不到、也不会被按点数钓走 —— 只有 J、顺色、收色带得走它。
  // 所以它是一张**永远安全的饵**：没牌可钓的回合打它，什么也不送给对手。
  // 代价是那张牌这一轮再也钓不到东西（也不触发点数槽）。
  //
  // 跟弃饵是一对：弃饵把用不上的牌**删掉**（牌库变薄、局变短），
  // 抹点把它**留着当饵**（厚度不变、多一张安全牌）。
  // J 也抹得掉 —— 那是你自己的决定，不拦
  { key: 'blank', name: '抹点', desc: '挑一张牌，它从此没有点数（按点数钓不到，也不会被按点数钓走）',
    price: 40, step: 0, rare: RARE_COMMON, once: false } as FixItem,
  // 彩票：下一次进商店时开奖（见 draw-save 的 drawLottery）。
  //
  // 期望（32.5）略高于票价（30），但一半上下是白买 —— 它卖的是**波动**，
  // 不是稳赚。攒钱吃利息的那条路跟它天然相斥：30 块够把利息推上一档。
  // 不是唯一道具，可以每店都买；同一批货里最多摆一张（rollFixKeys 不重复）
  { key: 'lotto', name: '彩票', desc: '下次进商店开奖：一半上下落空，最多中 200',
    price: 30, step: 0, rare: RARE_COMMON, once: false } as FixItem,
  // ---- 这儿原先有【砺钩】和【洗点】，跟角色卡那套结构**冲突，整件删掉** ----
  //
  // 砺钩是「挑一个技能升一级」。可角色卡的槽上**印死了标签**，
  // 一槽一技能 —— 技能的覆盖面由槽决定，它自己没有等级可升，
  // 也没有格子可扩。而特殊技**不可升级**（那是定下来的），
  // 所以砺钩连第二个用处都没有。
  //
  // 洗点是「把技能占的位置重摇一遍」。位置现在是**印**的，
  // 压根没有可摇的东西 —— 这一件是「摇位置」那条规矩的救济口，
  // 规矩没了，救济口跟着没。
  //
  // 它俩一起带走了**保底份额**那套机制（FixItem.floor / FLOOR_SHARE / weightsFor）：
  // 全表只有这两件需要保底（一件是升级的唯一通道，一件是唯一的救济口），
  // 别的货都是「刷到就赚、刷不到算了」。
  //
  // 顺带带走的还有 UPGRADE_PRICE（砺钩的标价是它唯一的用处）
  // 和技能的等级概念（见 draw-skills 里那几段墓碑注释）。
  //
  // ---- 这一下换来的是什么 ----
  //
  // 一轮之内**没有数值成长了，只有结构选择**：哪件技能嵌哪个槽、牌组怎么改。
  // 那是角色卡那次改动本来就想要的 —— 它把「攒钱把磁钩升满」那条
  // 算术题换成了「这件技能配哪个数字」那道组合题

  // ---- 三个「包」：买下来当场摊开 N 个随机候选，挑 1 个 ----
  //
  // 它们跟货架上直接摆着的技能/卡牌是两种买法：
  //
  //   货架 —— **店里有什么**。这一批上了什么就只能买什么，
  //           想换得花钱刷新（而刷新价翻倍涨）。
  //   包   —— **自己开一次**。候选是当场摇的，所以它卖的是
  //           「跳过货架的随机性」：直接摊 N 个给你挑。
  //
  // 定价按候选数走：挑的面越宽越贵。技能两选一（80）比货架上
  // 单买一个技能（40~150，平均八十上下）不便宜，但你**挑得着**；
  // 五选一（160）基本是「这一关我要定一个技能」的价钱。
  //
  // 卡牌六选一只要 60：牌本身便宜（40/80），所以包的溢价也小。
  //
  // 稀有度照「挑的面」排：牌六选一是零件（普通），技能二选一是一次
  // 像样的选择（稀有），五选一基本等于「这一关我点一个技能」—— 史诗
  { key: 'pack2', name: '技能二选一', desc: '当场摊 2 个没有的技能，挑 1 个',
    price: 80, step: 0, rare: RARE_RARE, once: false } as FixItem,
  // 五选一**留在史诗，但降到 120**。
  //
  // 它不是唯一道具，定位是「这一关我要定一个技能」，可史诗一轮期望
  // 只出 0.9 次 —— 约四成轮次整轮见不到。那种稀缺配 160 的价钱是错配：
  // 好不容易见着一次，还可能买不起。
  //
  // 降档和降价两条路里选了**降价**：加权降档之后史诗就只剩它一件了，
  // 再降档这一层档位就空了，rareWeight 里史诗那条曲线成了死代码。
  // 而「一轮大概见一次、见着就买得起」正好是这件货该有的手感
  { key: 'pack5', name: '技能五选一', desc: '当场摊 5 个没有的技能，挑 1 个',
    price: 120, step: 0, rare: RARE_EPIC, once: false } as FixItem,
  { key: 'cards6', name: '牌六选一', desc: '当场摊 6 张随机牌，挑 1 张加进牌组',
    price: 60, step: 0, rare: RARE_COMMON, once: false } as FixItem,
  // ---- 下面四件是永久扩容。都是**唯一**：一轮只买得到一次 ----
  //
  // 它们跟表里别的货不是一类东西。别的货改的是「这一关我手里多了什么」，
  // 这四件改的是**规则里的一个数**，而且改完一直有效到这一轮结束：
  //
  //   加栏 → 道具栏几格      加架 → 技能/卡牌栏几格
  //   加权 → 点数槽几格      平价 → 刷新怎么计价
  //
  // 四件里**三件是「越早买越值」**（加栏、加架、平价都按剩下的关数折现），
  // 只有加权什么时候买都一样值。那条「时效性」是它们定档的主要依据，
  // 详见各自那一段和 rareWeight 上面那张表。
  //
  // ---- 加栏：道具栏从 3 格变 4 格 ----
  //
  // 它买的不是一件货，是**后面每一关的选择面**。所以它的价值完全
  // 取决于什么时候买到：第 3 关买，剩下九关每关多看一件；第 11 关买，
  // 多看两件就打完了。
  //
  // 正因为这样它压成**稀有**而不是史诗 —— 史诗的出现概率是往后爬的
  //（见 rareWeight），而一件「越早买越值」的货配一条「越晚越容易见」
  // 的曲线，等于设计出来就是让人错过。稀有在第 4、5 关就有几成机会见着，
  // 那才是它该出现的位置。
  //
  // 120 块：约等于两关的收入。买它这一关你基本买不了别的了，
  // 那是它该有的分量
  { key: 'shelf', name: '加栏', desc: '道具栏永久多 1 格（下一关生效）', price: 120,
    step: 0, rare: RARE_RARE, once: true } as FixItem,
  // ---- 这儿原先有【加权】（点数槽 6 格 → 7 格），跟着砺钩一起删了 ----
  //
  // 它卖的是「多一次升级的余量」，而槽的格数现在**由角色卡印死**。
  // 硬要留的话得回答「新那一格印什么标签」——
  // 答案只能是「摇一个」，而那恰好把刚去掉的「摇位置」又请回来了。
  //
  // 这件货的历史值得留一句：它原先配史诗，结果是**两重稀缺叠乘**
  //（史诗一轮期望 0.9 次 × 那一格要第 3 次砺钩才填得上），
  // 期望收益接近 0；后来降到稀有才算救活。现在连带它一起删，
  // 那次校准也就作废了
  // ---- 加架：技能 / 卡牌那一栏从 4 格变 5 格 ----
  //
  // 跟加栏是同一件事的另一半：加栏宽的是上面那栏（道具），
  // 加架宽的是下面那栏（技能和卡牌）。
  //
  // 两件货的**手感不一样**，所以价钱也不一样：
  //
  //   加栏（120）宽的那一栏**刷不动**。多一格就是多一次「这一关
  //           能不能撞上我要的那件道具」，纯粹是运气面变宽。
  //   加架（100）宽的那一栏**刷得动**。多一格不只是多看一件，
  //           它还让每一次刷新更值 —— 同样的刷新钱买到五个结果而不是四个。
  //
  // 所以加架便宜一点，但跟【平价】凑在一起会很凶：五格 × 三十块一刷，
  // 那基本是「这一关我要什么技能点什么技能」。那条路成立是对的 ——
  // 它要两件唯一道具都摇到，而且两件都得早
  { key: 'card', name: '加架', desc: '技能/卡牌栏永久多 1 格（换一批就看得见）',
    price: 100, step: 0, rare: RARE_RARE, once: true } as FixItem,
  // ---- 扩库：技能库永久 +1 格 ----
  //
  // 技能库上限按难度给（8 / 6 / 5，见 libraryCapOf）。库满了技能买不进来，
  // 只能先卖一件 —— 而卖只退一半。所以库的格数就是「能留几件备用」，
  // 换角色槽、换打法的余地全在这儿。
  //
  // **对困难最值钱**：困难只有 5 格，而锁江一个人就有 4 个槽 ——
  // 扩到 6 格才有两件周转。简单本来就有 8 格，几乎用不上它。
  // 那是对的：救济该往难的那头倾斜。
  //
  // 什么时候买都差不多值（不按剩下关数折现），所以跟加栏、加架一样放稀有
  { key: 'library', name: '扩库', desc: '技能库永久多 1 格', price: 100,
    step: 0, rare: RARE_RARE, once: true } as FixItem,
  // ---- 平价：换一批固定 30 块，不再翻倍 ----
  //
  // 刷新价本来是翻倍涨的（20 / 40 / 80 / 160，见 cardRerollCost），
  // 那条曲线的意思是「刷一两次是常规操作，刷到满意为止不行」。
  // 平价把它拍平成一个数：30 块一次，刷到你没钱为止。
  //
  // ---- 它为什么是**普通**而不是稀有 ----
  //
  // 这是全表唯一一件「档位压低是因为时效性」的货。
  //
  // 它的收益是「**后面每一关**每一次刷新省下的钱」，所以越早买越值：
  // 第 3 关买，剩下九关的刷新全按 30 算；第 11 关买，省两次钱就打完了。
  // 而稀有和史诗的权重是**往后爬**的（见 rareWeight）—— 一件越早越值的货
  // 配一条越晚越容易见的曲线，等于设计出来让人错过。
  //
  // 普通的权重是**恒定**的，也就是「任何一关都一样容易撞上」。
  // 那正是一件时效性道具该有的出现方式。
  //
  // 加栏也是越早越值，但它压在稀有 —— 两件货的区别在**分量**：
  // 加栏改的是「每关能看见几件道具」，那是结构性的；平价改的只是
  // 一个价钱，省下来的钱整轮加起来也就一两百。小收益配常见，
  // 大收益配稀缺，这条比「时效性」优先。
  //
  // 80 块：约等于三次刷新的差价。所以它大概在第四五关之前买到才回本 ——
  // 那也是「越早越值」的另一种说法
  { key: 'flat', name: '平价', desc: '换一批永久固定 30 块，不再翻倍', price: 80,
    step: 0, rare: RARE_COMMON, once: true } as FixItem
]

// 三个包各摊几个候选
export function packSize(key : string) : number {
  if (key == 'pack2') {
    return 2
  }
  if (key == 'pack5') {
    return 5
  }
  return key == 'cards6' ? 6 : 0
}

// 这件货是不是「包」（买了当场摊候选挑一个）
export function isPack(key : string) : boolean {
  return key == 'pack2' || key == 'pack5' || key == 'cards6'
}

// 牌组的下限。只有这一条，**不限制「每个点数至少留几张」**。
//
// 于是「把某个点数全删掉」走得通：四张 7 花两百块清空。那是有意留着的，
// 但它不是一条便宜的路 —— 两百块是三四关的收入，而且弃饵得在货架上
// 连着出现四次（十种道具里每次只上三种）。
//
// 它也不是**当场**就能针对谁：你买的时候还没见过下一关的庄家
//（见 FIX_ITEMS 里弃饵那段）。要靠它封死对手，得先打过一轮、
// 记住第几关的庄家吃哪几个点数 —— 代价够大的极端解法应该成立，
// 但它该是熟练玩家的功课，不是随手就能使的一招
export const DECK_MIN : number = 40

// 牌组的上限。标准 52 张 + 12 张（一关买一张的理论极限）。
//
// 它守的是**技能的触发率还算得准**这件事：第三节那两张概率表
// （一个点数标签 28%、六个 92%）全是按 52 张算的。
// 牌组买到 90 张，那些数就全是假的 —— 而玩家读的还是那个数。
//
// 两处要守它：
//   商店买牌（`draw-skills.uvue` 的 cardDetail / doBuyShelf）；
//   【囤饵】开局往库里塞牌（`ap-fishing.uvue` 的 baitFor）——
//     塞不下就少塞几张，而且**要说一声**，静默吞掉的话
//     玩家只会以为技能坏了。
//
// 跟 DECK_MIN 是一对，所以摆在一起 ——
// 「牌组能多厚 / 多薄」是同一个问题的两头
export const DECK_CAP : number = 64

export function fixItemOf(key : string) : FixItem {
  for (let i = 0; i < FIX_ITEMS.length; i++) {
    if (FIX_ITEMS[i].key == key) {
      return FIX_ITEMS[i]
    }
  }
  return FIX_ITEMS[0]
}

// 原先这儿有个 weightsFor：先按稀有度算权重，再把带**保底份额**的抬上去
//（解 w = f × 总量 那个方程，因为总量里含着 w 自己）。
//
// 保底只服务砺钩和洗点，两件都删了，所以它没有服务对象了 ——
// 上货回到纯 rareWeight 加权抽（见下面 rollFixKeys）

// 按稀有度权重摇 want 种道具（**不重复**）。
//
// skip 是这一轮已经买过的唯一道具 —— 它们不再上货（见 FixItem.once）。
//
// 做法是「按权重抽一个 → 从池子里剔掉 → 再抽」。每一轮都重新累一遍
// 总权重，次数少（want 顶多四五个），没必要为此搭个前缀和。
//
// 剔掉而不是允许重复：同一批里摆两个弃饵就浪费了一格 ——
// 道具是买完就没的，重复的那一格等于白摆
export function rollFixKeys(level : number, want : number, skip : string[]) : string[] {
  // 候选池：排掉已经买过的唯一道具
  let pool : number[] = []
  for (let i = 0; i < FIX_ITEMS.length; i++) {
    let skipped = false
    for (let s = 0; s < skip.length; s++) {
      if (skip[s] == FIX_ITEMS[i].key) {
        skipped = true
        break
      }
    }
    if (!skipped) {
      pool.push(i)
    }
  }
  const out : string[] = []
  for (let n = 0; n < want && pool.length > 0; n++) {
    // 这一轮每件货的权重，纯按稀有度算（保底份额那套已经删了）
    const w : number[] = []
    let total = 0
    for (let i = 0; i < pool.length; i++) {
      const one = rareWeight(FIX_ITEMS[pool[i]].rare, level)
      w.push(one)
      total = total + one
    }
    // 权重全是正数，total 不会是 0；保一手免得将来改表改出个 0 来
    let roll = total > 0 ? Math.floor(Math.random() * total) : 0
    let hit = pool.length - 1
    for (let i = 0; i < pool.length; i++) {
      roll = roll - w[i]
      if (roll < 0) {
        hit = i
        break
      }
    }
    out.push(FIX_ITEMS[pool[hit]].key)
    // 抽中的剔出池子。UTS 那边数组删不了元素，只能换引用
    const rest : number[] = []
    for (let i = 0; i < pool.length; i++) {
      if (i != hit) {
        rest.push(pool[i])
      }
    }
    pool = rest
  }
  return out
}

// 每次进店上几种道具（底数；买过【加栏】之后 +1，见 fixSlotsOf）。
//
// **3 而不是 11（全摆）**：全摆出来就没有「这次刷到了什么」可言，
// 十一种的区别退化成一条价格梯子，照着钱包挑最贵的买就行。
// 也不该太少 —— 一种就全凭运气，连取舍都没有。
//
// 定 3 是对着**十一种**定的（三种推点数、同化、弃饵、三个包、三件唯一扩容）。
// 原先四种的时候摆 2 个正好是一个取舍；十一种里摆 2 个就太窄了，
// 想要的那件十关也刷不着几次。
//
// 删掉砺钩 / 洗点 / 加权之后表从十四种缩到十一种，这个 3 **没跟着降** ——
// 池子小了，3 格的覆盖率反而更高（27% → 一关摆得出某一特定件），
// 那对剩下这几件「刷到就赚」的货是对的。
//
// 后来又加了五件（拓印、熔合、抹点、彩票、扩库），表涨到十六种，
// 这个 3 **仍然没动** —— 一件特定的货摆出来的概率掉到两成上下（见 rareWeight 上面那张表）。
// 先看实际手感；嫌稀再提到 4
export const SHOP_FIX_COUNT : number = 3

// 加栏加几格。定 1 而不是让它叠买 —— 它是唯一道具（once），
// 所以这个数就是「买过」和「没买过」的差
export const SHELF_BONUS : number = 1

// 加架加几格（技能 / 卡牌那一栏）。同样定 1、同样唯一
export const CARD_BONUS : number = 1

// 扩库加几格（技能库）。同样定 1、同样唯一
export const LIBRARY_BONUS : number = 1

// 彩票一张开出来的分布：LOTTO_ODDS 是百分比（加起来 100），LOTTO_PRIZES 是对应奖金。
//   45% 落空 · 35% 中 30（回本）· 15% 中 80 · 5% 中 200
// 期望 0×.45 + 30×.35 + 80×.15 + 200×.05 = 32.5，票价 30
export const LOTTO_ODDS : number[] = [45, 35, 15, 5]
export const LOTTO_PRIZES : number[] = [0, 30, 80, 200]

// 货架上的牌价。从前「J 卖 80，其余 40」硬编码在商店页两处（详情框、扣钱），
// 挪到这儿统一（见 draw-save 的 cardPriceOf）。
//
// 零点牌和普通牌同价：它钓不到东西，可它是见底 / 撒网的料，也是一张安全饵。
// 无点数牌贵一点：它是**永远**的安全饵（零点牌还会被见底、撒网收走），
// 而且只有 J、顺色、收色带得走它 —— 堆在场上就是一块甩不掉的石头
export const CARD_PRICE : number = 40
export const JACK_PRICE : number = 80
export const ZERO_CARD_PRICE : number = 40
export const BLANK_CARD_PRICE : number = 50
// 货架摆牌时，几张里出一张零点 / 无点数牌（1/N，两种各半）
export const SPECIAL_CARD_ODDS : number = 8
// 牌组里一个点数到了这么多张，商店就不再卖这个点数（见 draw-save 的 rollShopCard）。
// 标准牌组每个点数 4 张，这儿是它的两倍
export const RANK_SELL_CAP : number = 8
// 落在角色槽上的牌（槽上印的点数或花色）在商店里的权重是别的牌的几倍。
//
// 定 2，按标准牌组算「摆出来的牌落在自己槽上」的比例：
//
//   角色              不加权    ×2
//   锁江 A 2 3 4       31%     47%
//   篓翁 6 7 / 8 9     31%     47%
//   沉钩 ♣ / K         37%     47%（♣K 落在两个槽上，不叠加）
//   明镜 ♥ / 3 4       37%     54%
//   夜钓 A / 5 / 9     23%     38%
//
// 也就是从「三张里一张是你的」提到「两张里一张是你的」——
// 自己的牌明显常见了，可另一半照常是行情，刷新、买别的点数仍然是个选项。
// 定 3 的话锁江会到 57%、明镜 63%，货架基本只剩自己那几个点数，
// 「这一店有什么」就不成其为问题了
export const SLOT_CARD_WEIGHT : number = 2

// 原先这儿还有个 RANK_BONUS（加权加几格点数槽）。
// 加权整件删了（槽数由角色卡定，加出来那一格印什么没有来源），
// 所以这个常量没有调用方了，跟着删

// ---------- 点数卡 ----------
//
// 给牌组里某一张牌贴一个**额外点数**，于是那张牌同时算几个点数：
// ♠3 贴了 7 之后，3 和 7 都钓得上它，它也钓得上 3 和 7。
//
// 它和「买牌」是同一条轴的两头：
//
//   买牌（40/80）  牌组多一张 → 那个点数多一次撞上的机会，
//                  **代价是牌组变厚**（局更长、你技能覆盖面占比被稀释）
//   点数卡（90）    牌组**不变厚**，但某一张牌多一条出路
//
// 后者贵一倍多，因为它没有那份代价，而且更精准 ——
// 你可以专挑一张「花色落在自己花色槽上」的牌去贴，
// 让那一张同时吃两个点数，成为这一轮的核心牌。
//
// 90 块是故意比单买一个便宜技能（40~60）贵的：牌组改造这条路
// 不该比技能便宜，不然它就成了默认选项。
//
// 它**不改牌面点数、也不改 rank**，所以：
//   · 不会把牌变成 J（通吃焊在 rank 上）
//   · 不触发点数技（triggersOf 读的是 rank）
//   · 庄家的记牌（outsideCount 按 rank 数）看不见它 ——
//     那是个**已知的近似**：贴过点数卡的牌对庄家来说是「隐藏的一条出路」。
//     牌组是双方共用的，所以这份便宜双方都占得到，但只有你知道贴在哪
export const PIP_PRICE : number = 90

// 下面那一栏上几件（技能和卡牌混着摆）的**底数**；
// 买过【加架】之后 +1，见 cardSlotsOf。
//
// 4 件：一行摆得下，而且挑得动。再多就是眼花，再少不如不挑。
// 技能只上你还没有的，摆完了就全摆牌（见 rollShelf）
export const SHOP_CARD_COUNT : number = 4

// 刷新第 times 次（从 0 起）要多少钱。**翻倍涨**。
//
// 第一次 20，比最便宜的一张牌（40）还便宜 —— 所以「这批不顺眼就刷一次」
// 是常规操作。第二次 40 就等于一张牌的价钱，开始犹豫；第三次 80
// 是 J 的价钱，基本不划算。实际上你会刷一到两次，那正是想要的档位。
//
// 线性涨（20/40/60）压不住：后期金币多，六十块刷到满意为止太便宜了。
//
// 【平价】那件唯一道具**把这条曲线整个换掉**，拍平成 FLAT_REROLL ——
// 真正该读的是 rerollPriceOf（它查过存档再决定走哪条）
export function cardRerollCost(times : number) : number {
  let cost = 20
  for (let i = 0; i < times; i++) {
    cost = cost * 2
  }
  return cost
}

// 买过【平价】之后，每次刷新都是这个价。
//
// 定 30 而不是 20（第一次刷新的原价）：平价卖的是「刷得起第三第四次」，
// 不是「刷新变便宜了」。头两次反而比原来贵一点（30 对 20 / 40），
// 第三次起才回本（30 对 80）—— 于是它不是无脑划算，
// 而是「我这一轮打算靠刷货架过日子」才买的那件
export const FLAT_REROLL : number = 30

// ---------- 利息 ----------
//
// 每过一关按**手头存款**给息：每 FULL 块给 STEP 块，最多 CAP。
//
// 这一条改的不是收入，是**「攒着」这个选项存不存在**。
//
// 从前金币不花就是死钱 —— 一分钱攒到第 12 关也还是一分钱，
// 所以最优解永远是「这一关有什么买什么，花光」。那让商店的取舍
// 退化成了「在摆出来这几件里挑最贵的买得起的」。
//
// 有了利息，「这一关什么都不买」成了一个真选项：手里压着 200 块
// 每关白拿 25，相当于每关多小半个技能的钱。于是你会开始算
// 「现在这件 80 块的推三格，值不值我少拿两关的利息」。
//
// 它跟稀有度是**互补**的：稀有度给了「值得攒钱等后期那几件」的理由
//（史诗越往后越容易见，见 rareWeight），利息给攒钱本身加收益。
// 两条合起来，前期省钱后期爆发才成为一条真路线。
//
// 数怎么定的：每关基础奖励 30 块上下（见 DRAW_LEVELS 的 reward）。
// 封顶 25 就是「存够 200 块，每关白拿将近一关的收入」——
// 够诱人，但没到「攒钱必胜」。40 一档而不是 10 一档，是为了让
// 「再攒 40 就跳一档」成为一个看得见的小目标。
//
// ---- 为什么档距从 50 改成 40，还多加了一个 30 的首档 ----
//
// 原来 50 一档，对**前期太粗**了：浅滩每关收入 30 上下，前三关的存款
// 峰值常落在 30–80 之间，而那个区间里利息要么 0 要么 5，基本无感。
//
// 可利息最需要立起来的恰恰是前期 —— 它要教会你「攒着有用」这件事。
// 第 1 关不买东西攒下 30 块，第 2 关结算时该看见点东西，
// 否则这一条规则在它最该起作用的时候是隐形的。
//
// 所以：
//   · 档距 40（原 50）—— 整条曲线往前挪，80 就能摸到第二档；
//   · **30 一档给 +3** —— 一关不买就看得见回报，是个「首杀」。
//     它是唯一一个不走档距的特例，值得这点不整齐。
//
// 于是前期这样走：30→3、40→5、80→10、120→15、160→20、200→25（封顶）
export const INTEREST_FULL : number = 40
export const INTEREST_STEP : number = 5
export const INTEREST_CAP : number = 25
// 首档：攒到这个数就给 INTEREST_FIRST，不等第一个整档
export const INTEREST_SEED : number = 30
export const INTEREST_FIRST : number = 3

export function interestOf(gold : number) : number {
  if (gold < INTEREST_SEED) {
    return 0
  }
  if (gold < INTEREST_FULL) {
    return INTEREST_FIRST
  }
  const got = Math.floor(gold / INTEREST_FULL) * INTEREST_STEP
  return got > INTEREST_CAP ? INTEREST_CAP : got
}

// ---- 原先这儿有三个表助手：noSkills / levelsOf / loadoutOf ----
//
// 它们是给关卡表里那两个写死的 levels / loadout 字段服务的。
// 那两个字段删了（庄家配装搬到 DRAW_FOE_ROLES 上），三个助手跟着没。
//
// 于是关卡表瘦成了一行一关：**叫什么、怎么出牌、给多少钱**。
// 「这一关的庄家是谁」查 DRAW_FOE_ROLES（按关号下标），
// 两张表按关号对齐 —— 加一关要同时加两边
export const DRAW_LEVELS : DrawLevel[] = [
  // ---------- 浅滩 ----------
  // 第 1 关给 80 而不是 30：新档 0 金币，第一个商店要是连【技能二选一】（80）
  // 都买不起，进店就只能干看。80 + 胜分保证第一店至少能拿下一个技能
  { id: 1, chapter: '浅滩', name: '试竿', smart: false, random: true, reward: 80 } as DrawLevel,
  { id: 2, chapter: '浅滩', name: '涨潮', smart: false, random: false, reward: 30 } as DrawLevel,
  { id: 3, chapter: '浅滩', name: '老渔夫', smart: true, random: false, reward: 30 } as DrawLevel,
  { id: 4, chapter: '浅滩', name: '滩头', smart: true, random: false, reward: 30 } as DrawLevel,
  // ---------- 河湾 ----------
  { id: 5, chapter: '河湾', name: '回水', smart: true, random: false, reward: 45 } as DrawLevel,
  { id: 6, chapter: '河湾', name: '暗礁', smart: true, random: false, reward: 45 } as DrawLevel,
  { id: 7, chapter: '河湾', name: '望潮', smart: true, random: false, reward: 45 } as DrawLevel,
  { id: 8, chapter: '河湾', name: '湾口', smart: true, random: false, reward: 45 } as DrawLevel,
  // ---------- 深海 ----------
  { id: 9, chapter: '深海', name: '雾海', smart: true, random: false, reward: 60 } as DrawLevel,
  { id: 10, chapter: '深海', name: '漩涡', smart: true, random: false, reward: 60 } as DrawLevel,
  { id: 11, chapter: '深海', name: '鲸落', smart: true, random: false, reward: 60 } as DrawLevel,
  { id: 12, chapter: '深海', name: '深渊', smart: true, random: false, reward: 60 } as DrawLevel
]

// 原先这儿还跟着第 5–12 关各自写死的 levels / loadout（手调过的庄家配装，
// 带一长串注释解释「压邻接了护饵的位子」之类）。
//
// 那些配装的**设计意图搬进了 DRAW_FOE_ROLES**，而且在那边才是活的 ——
// 这边的早就是死数据了（对局页读出来之后立刻被摇出来的那套覆盖掉）。
// 要调某一关庄家多强，改那张表

export const DRAW_LEVEL_COUNT : number = DRAW_LEVELS.length

// ======================= 庄家角色 =======================
//
// 设计稿：根目录《摸打钓鱼-庄家角色设计.md》。
//
// **十二关 = 十二个角色。** 一个角色 = 一件固定的特殊技 + 一份固定的技能名单，
// 而那些技能占哪个点数 / 哪门花色**是摇的**。
//
// ---- 跟玩家角色正好反过来 ----
//
//                槽型      标签（具体哪个）    插什么技能
//   玩家角色      印死        **印死**          **你选**
//   庄家角色      印死        **摇**            印死
//
// 两边各自的理由：
//
//   玩家那边印死标签，是为了让「哪件技能配哪个数字」成为一道组合题
//   （磁钩插在连号槽上，+1 能钓到自己的下一个槽）。
//
//   庄家那边印死的得是**技能名单**，因为那是你能学的东西 ——
//   打过一轮你就知道第 8 关那位带什么（商店还会提前预告）。
//   而**位置摇**保证你学不到头：知道它带顺色，但不知道这回落在哪门花色上。
//
// 一句话：**它是谁 → 查得到。它卡在哪 → 查不到。**
//
// 这替掉的是 rollKitFor（连「带什么技能」都摇）。那套的毛病是
// **庄家没有性格** —— 第 9 关这次摇到顺色+见底、下次窥视+换水，
// 玩家学不到任何东西，它只是一个强度数字。
export type FoeSlot = {
  // 这个槽里印死的那件技能（DRAW_SKILLS 下标）
  skill : number
  // 它占几个标签，以及是花色标签还是点数标签
  count : number
  suit : boolean
}

export type FoeRole = {
  // 角色名。场景名在 DRAW_LEVELS 的 name 里，两者是两回事
  name : string
  // 带哪条特殊技（DRAW_FOE_SPECIALS 的 key）。空串 = 不带
  special : string
  slots : FoeSlot[]
  desc : string
}

// ---------- 庄家特殊技：十一条 ----------
//
// 三条规矩（设计稿第三节，一条都不动）：
//
//   1. **不进商店池** —— 玩家永远拿不到。它们是关卡的性质，不是装备。
//   2. **不占槽** —— 挂在角色上，整局生效，不靠「打出某张牌」触发。
//   3. **守铁律** —— 没有一条直接改积分。积分永远等于收走的张数，
//      它们改的是「钓得到钓不到」「收得了几张」「你看得见什么」。
//
// 跟玩家的 SPECIAL_SKILLS **不是一张表**：那套能被商店碰到（本来能升级，
// 现在也不能了），而这套三条规矩都只对它自己成立。
//
// 命名避了四处重（技能表里有同义的名字，撞了在 UI 上分不清）：
//   添手 ≠ 满篓 · 淤滩 ≠ 压舱 · 掐口 ≠ 窄口 · 再钩 ≠ 连竿
// 后两条的效果确实就是那两件的庄家版，但名字得分得开
export type FoeSpecial = {
  key : string
  name : string
  desc : string
}

export const DRAW_FOE_SPECIALS : FoeSpecial[] = [
  { key: 'hand', name: '添手',
    desc: '庄家起手和手牌上限都 +1 张' } as FoeSpecial,
  { key: 'silt', name: '淤滩',
    desc: '开局庄家先从牌库顶往堆上垫 3 张，都算 0 点' } as FoeSpecial,
  { key: 'pinch', name: '掐口',
    desc: '你每回合只补到 3 张' } as FoeSpecial,
  { key: 'drift', name: '偏流',
    desc: '庄家打出的牌落堆底，不落堆顶' } as FoeSpecial,
  // 「钓不上」说的是**它当不了匹配的那一张**，不是「永远拿不走」——
  // 从更深处钓起的时候它照旧被连带收走（跟护饵一个待遇，见 shelled）。
  // 初稿写的是「只有 J 收得走」，那跟实现不符：J 只是最省事的那条解
  { key: 'shell', name: '硬壳',
    desc: '庄家打出的 ♠ 钓不上（钓更深的牌时才连带收走）' } as FoeSpecial,
  { key: 'pick', name: '挑潮',
    desc: '庄家回合末补牌时从库顶 2 张挑 1 张（另一张沉底）' } as FoeSpecial,
  { key: 'guard', name: '守滩',
    desc: '庄家每次钓到牌之后，自动往堆上垫一张自己的手牌' } as FoeSpecial,
  { key: 'again', name: '再钩',
    desc: '庄家钓到牌时可以再打一张（一回合最多连两次）' } as FoeSpecial,
  { key: 'seal', name: '封竿',
    desc: '摇定一个点数：你打出它只是落堆，钓不到任何牌' } as FoeSpecial,
  // ---- 下面两条**现在没有载体，所以也没有实现** ----
  //
  // 当初是给终局留的（那一局不记账，可以上最凶的）。可终局的庄家摇的是
  // **玩家那张角色表**（DRAW_ROLES，见 ap-fishing 的 rollRoleKit）——
  // 双方同构是那个模式的全部意义，所以它带不了庄家专属的特殊技。
  //
  // 留在表里不删，是因为它们是两条**想清楚了的**设计（逆钩砍 J 的上限、
  // 浊水藏堆的中段），哪天要加「庄家专属的终局关」就直接拿来用。
  // 对应的效果代码一行都没写 —— 加的时候记得（落点见设计稿第八节）
  { key: 'rev', name: '逆钩',
    desc: '你打 J 只收堆顶 3 张，不通吃（庄家的 J 照旧通吃）' } as FoeSpecial,
  { key: 'murk', name: '浊水',
    desc: '堆超过 10 张时你只看得见最上面 5 张（庄家照旧全看得见）' } as FoeSpecial
]

export function foeSpecialOf(key : string) : FoeSpecial | null {
  for (let i = 0; i < DRAW_FOE_SPECIALS.length; i++) {
    if (DRAW_FOE_SPECIALS[i].key == key) {
      return DRAW_FOE_SPECIALS[i]
    }
  }
  return null
}

// 这一关庄家那条特殊技的名字 / 全文。没带就是空串 ——
// 商店预告和对局页的技能栏都读它
export function foeSpecialNameAt(level : number) : string {
  const one = foeSpecialOf(foeRoleAt(level).special)
  return one == null ? '' : one!.name
}

export function foeSpecialDescAt(level : number) : string {
  const one = foeSpecialOf(foeRoleAt(level).special)
  return one == null ? '' : one!.desc
}

// ---------- 覆盖面：对标玩家角色的 16～21 张 ----------
//
// 一个点数标签 4 张、一个花色标签 13 张（见 draw-skills 的那两个常量）。
//
// **终点定在 21 而不是满配** —— 现有 8 个玩家角色覆盖 16～21 张，
// 庄家末关跟最强的玩家角色持平就够了。
//（设计稿初稿写的是 50，那是按「2 花色槽 + 6 点数槽」算的，
//  可花色槽早从摇的那套模型里砍了，而角色卡的覆盖面是卡上印多少就多少。
//  按 50 走会让庄家末关是玩家的 2.4 倍 —— 那是个算错。）
//
//   关      5   6   7   8   9  10  11  12
//   盖      4   8  12  13  16  17  21  21
//   槽数    1   1   2   1   2   2   2   3
//
// 覆盖面**单调**（「越往后越强」要能指望得上，单调是底线）。
// 槽数**故意不单调**：第 8 关只一个 ♠ 槽，是「专精 vs 泛用」那条轴 ——
// 照玩家角色里深海钓手的做法（只两件技能，但一件管整门花色）
export function foeCoverOf(level : number) : number {
  const r = foeRoleAt(level)
  let cover = 0
  for (let i = 0; i < r.slots.length; i++) {
    const one = r.slots[i]
    cover = cover + one.count * (one.suit ? SUIT_CELL_COVER : RANK_CELL_COVER)
  }
  return cover
}

// 第几关的庄家。关号越界就退回第 1 关那个（它什么都不带，最安全）
export function foeRoleAt(level : number) : FoeRole {
  if (level < 1 || level > DRAW_FOE_ROLES.length) {
    return DRAW_FOE_ROLES[0]
  }
  return DRAW_FOE_ROLES[level - 1]
}

const NO_SLOTS : FoeSlot[] = []

export const DRAW_FOE_ROLES : FoeRole[] = [
  // ---------- 浅滩：不带技能、也不带特殊技 ----------
  //
  // 这四关是教规则的：第 1 关教「怎么钓」、第 2 关让你自己挑饵、
  // 第 3 关第一次碰上会记牌的对手。**那三件事本身就是新东西**，
  // 再叠一条改规则的只会糊成一团。
  //
  // 第 4 关（浅滩关底）上第一条特殊技，而且是最温和的那条 ——
  // 添手只给庄家多一张手牌，一条规则都没改。关底该让你意识到
  // 「原来庄家还能有额外的东西」，不该让你输在没见过的规则上
  { name: '试手', special: '', slots: NO_SLOTS,
    desc: '刚摸到竿的。随手出牌，什么都不带' } as FoeRole,
  { name: '浪客', special: '', slots: NO_SLOTS,
    desc: '闲逛的。会挑饵了，但还不记牌' } as FoeRole,
  { name: '老钓', special: '', slots: NO_SLOTS,
    desc: '守了半辈子河的。**它开始记牌了** —— 这一关的全部内容' } as FoeRole,
  { name: '滩公', special: 'hand', slots: NO_SLOTS,
    desc: '滩头的老人。手里比别人多一张牌' } as FoeRole,
  // ---------- 河湾：一关一个主题，而且两两成对 ----------
  //
  // 回漩（淤滩）造厚堆 → 湾主（硬壳）让厚堆里一批牌永远死着；
  // 礁母（掐口）削你手牌 → 潮眼（偏流）让你钩不着它的牌。
  // 前一关种下的概念，后一关加码
  { name: '回漩', special: 'silt', slots: [
      // 一个点数槽 = 4 张。磁钩是最基础那件，第一关有技能的庄家配它正好
      { skill: SK_HOOK, count: 1, suit: false } as FoeSlot
    ], desc: '水在这儿打转。开局堆上就压着三张死牌 —— 它教你 J 有多值' } as FoeRole,
  { name: '礁母', special: 'pinch', slots: [
      // 两个点数标签 = 8 张。压邻让紧挨着它右边落下的那张作废 ——
      // 跟掐口（削你手牌到三张）同向：两条都在减你能用的东西
      { skill: SK_VOID, count: 2, suit: false } as FoeSlot
    ], desc: '礁石底下的。你每回合只补到三张，而挨着它落下的牌还会作废' } as FoeRole,
  { name: '潮眼', special: 'drift', slots: [
      // 两个槽、12 张。观潮管两个点数，磁钩管一个
      { skill: SK_TIDE, count: 2, suit: false } as FoeSlot,
      { skill: SK_HOOK, count: 1, suit: false } as FoeSlot
    ], desc: '看得见潮眼在哪。它的牌打到堆底 —— 你得连带收一大段才碰得到' } as FoeRole,
  { name: '湾主', special: 'shell', slots: [
      // **一整门花色 13 张，只一件技能** —— 专精那一头（照玩家角色「深海钓手」）。
      // 而且槽和特殊技是**同一门花色**：它打的 ♠ 既触发顺色、又钓不走。
      // 那是湾主这一关的全部内容
      { skill: SK_SUITED, count: 1, suit: true } as FoeSlot
    ], desc: '守着湾口收税。它打出的黑桃钓不走，而那门花色正是它的技能' } as FoeRole,
  // ---------- 深海：每关换一种压力 ----------
  { name: '雾叟', special: 'pick', slots: [
      // 三件信息类凑一关：它不抢你的分，它让你**算不准**
      { skill: SK_LANTERN, count: 2, suit: false } as FoeSlot,
      { skill: SK_FREEZE, count: 2, suit: false } as FoeSlot
    ], desc: '雾里看不清人。你的手牌它全看得见，还能锁住一张' } as FoeRole,
  { name: '涡心', special: 'guard', slots: [
      // ---- 这一关的理由**换过一次** ----
      //
      // 原来是「染水 + 见底那条组合」：染黑 → 见底的 N 拉满 → 整堆压下去。
      // 见底改成死数 −1 之后那条翻倍没了（理由见 draw-skills 见底那段），
      // 所以这一关不再是「看组合的威力」。
      //
      // 现在它是**水位关**，而守滩正好把它说圆了：
      //   守滩逼它每钓一次就往堆上垫一张 → 堆只会越来越厚；
      //   见底每回合把整堆往下挪一格 → 厚堆里的低点数一层层见底；
      //   染水把堆染成一门花色 → 它的顺色通道全程敞着。
      // 三条都指向同一件事：**它在养一个厚堆，而厚堆对它有利对你没利**。
      // 你要赢就得抢在水位把牌喂熟之前把锅端走。
      //
      // 强度上这一关**被削了**（原来那条组合是整关的爆点）。
      // 没有补回来 —— 补多少得先用模拟器量，而模拟器还没搬过来
      { skill: SK_SUITIFY, count: 1, suit: true } as FoeSlot,
      { skill: SK_LOWTIDE, count: 1, suit: false } as FoeSlot
    ], desc: '漩涡中心。它染水、它见底，而它每钓一次就往堆上再垫一张' } as FoeRole,
  { name: '鲸骸', special: 'again', slots: [
      // 两件都在「抹点数」那一族，加再钩的雪球 —— 堆冻住、长厚、而它连钩。
      // 你得抢在它之前把锅端走
      { skill: SK_HUEVOID, count: 1, suit: true } as FoeSlot,
      { skill: SK_ODD, count: 2, suit: false } as FoeSlot
    ], desc: '鲸落下去的地方。它封色、它分水，而它钓到就接着打' } as FoeRole,
  { name: '渊君', special: 'seal', slots: [
      // 满配：两条钓牌通道（顺色、磁钩）+ 一件清场（掏库）。
      // **最标准、最全面的一套**，没有偏科 —— 打到这儿比的不是读题，是硬实力
      { skill: SK_SUITED, count: 1, suit: true } as FoeSlot,
      { skill: SK_SPILL, count: 1, suit: false } as FoeSlot,
      { skill: SK_HOOK, count: 1, suit: false } as FoeSlot
    ], desc: '渊里的那个。它封掉你一个点数，然后用最全的一套跟你打' } as FoeRole
]

// ---------- 摇这一关庄家的配装：这儿没有，在 draw-save ----------
//
// 原先这儿有个 rollFoeKitFor(level)：按角色表摇标签，返回一整个 DrawKit。
// 删了，因为它跟 `draw-save` 的那一对**重了**，而重的那一半是错的那一半：
//
//   rollFoeKit(data, level)  —— 摇标签，**存进档**（存的是字符串）
//   foeKitOf(data, level)    —— 从档里那份标签**现算**出 DrawKit
//
// 「摇」和「翻成配装」必须是两步，因为中间那一步是**落盘**：
// 商店会预告下一关的庄家，每次读都重摇就是假情报，
// 而且退出再进能一直刷到好摇的位置。
// rollFoeKitFor 把两步合成了一步，所以它压根没地方调 ——
// 谁调它都会绕过落盘那一下。

// ---------- 难度 ----------
//
// 三档，管两件事：庄家怎么出牌、过关给多少金币。
//
//   简单 —— 浅滩四关（1–4）庄家完全随机出牌，之后各关都不记牌；过关奖励 ×1.5
//   普通 —— 照关卡表原样（第 1 关随机、第 2 关不记牌、第 3 关起记牌）
//   困难 —— 十二关全都记牌，没有随机关；过关奖励 ×0.75
//
// 倍率只乘关卡的**基础奖励**，胜分奖励和利息不跟着变 ——
// 那两样奖励的是「打得好」「忍住没花」，跟难度无关。
//
// 困难的第 1 关**保底 FIRST_REWARD_FLOOR**：第一个商店必上【技能二选一】，
// 新手引导也要你买它，第 1 关给的钱不够买就卡死了
export const DIFF_EASY : number = 0
export const DIFF_NORMAL : number = 1
export const DIFF_HARD : number = 2
export const DIFF_NAMES : string[] = ['简单', '普通', '困难']

// 技能库上限：一轮里最多拥有几件技能（装在槽上的也算）。
// 困难给 5 —— 最多槽的角色（江口闸官）有 4 个槽，至少得留一格周转
const LIBRARY_CAPS : number[] = [8, 6, 5]
// 生命：输一关扣 1 点、退回上一个商店；扣光了整轮作废
const DIFF_LIVES : number[] = [3, 2, 1]

export function libraryCapOf(diff : number) : number {
  return diff >= 0 && diff < LIBRARY_CAPS.length ? LIBRARY_CAPS[diff] : LIBRARY_CAPS[1]
}

export function maxLivesOf(diff : number) : number {
  return diff >= 0 && diff < DIFF_LIVES.length ? DIFF_LIVES[diff] : DIFF_LIVES[1]
}
const DIFF_REWARD_RATE : number[] = [1.5, 1.0, 0.75]
const EASY_RANDOM_UNTIL : number = 4
const FIRST_REWARD_FLOOR : number = 80

// 这一关在这个难度下的样子。返回一份新的，不改 DRAW_LEVELS 本身
export function levelForDiff(lv : DrawLevel, diff : number) : DrawLevel {
  let random = lv.random
  let smart = lv.smart
  if (diff == DIFF_EASY) {
    random = lv.id <= EASY_RANDOM_UNTIL
    smart = false
  } else if (diff == DIFF_HARD) {
    random = false
    smart = true
  }
  const rate = diff >= 0 && diff < DIFF_REWARD_RATE.length ? DIFF_REWARD_RATE[diff] : 1.0
  let reward = Math.round(lv.reward * rate)
  if (lv.id == 1 && reward < FIRST_REWARD_FLOOR) {
    reward = FIRST_REWARD_FLOOR
  }
  return {
    id: lv.id,
    name: lv.name,
    chapter: lv.chapter,
    smart: smart,
    random: random,
    reward: reward
  } as DrawLevel
}

export function drawLevelById(id : number) : DrawLevel {
  for (let i = 0; i < DRAW_LEVELS.length; i++) {
    if (DRAW_LEVELS[i].id == id) {
      return DRAW_LEVELS[i]
    }
  }
  return DRAW_LEVELS[0]
}
