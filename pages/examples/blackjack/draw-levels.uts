// 摸打钓鱼的 12 关。三章各 4 关，庄家的技能一章比一章多：
//   浅滩 1–4：没有技能（1–2 随手出牌，3–4 会记牌）
//   河湾 5–8：1 个技能，后两关升过级
//   深海 9–12：2 个槽都用上，最后两关接近满装
// 一轮要连胜 12 关，输一次从第 1 关重来（照排竿）。
// 为什么 12 关、金币怎么定，见根目录《摸打钓鱼-技能与关卡设计.md》

import {
  DrawLoadout,
  DRAW_SKILLS,
  SKILL_RANKS,
  SK_GUARD,
  SK_HOOK,
  SK_TIDE,
  SK_PEEK,
  SK_TOP,
  SK_STIR,
  // 砺钩的标价。常量定在 draw-skills 那边（技能的事），这儿只引用 ——
  // 反过来会成环：那边已经在引这边的东西了
  UPGRADE_PRICE,
  emptyLoadout
} from '@/pages/examples/blackjack/draw-skills.uts'

export type DrawLevel = {
  id : number
  name : string
  chapter : string
  // 庄家会不会记牌。不会的话钓得到就钓，钓不到随手打
  smart : boolean
  // 庄家完全随机出牌：钓得到也不挑，手里随便打一张。只给第 1 关 ——
  // 新手关，让人先把「怎么钓」摸熟
  random : boolean
  // 庄家每个技能的等级，-1 表示没有
  levels : number[]
  loadout : DrawLoadout
  // 过关给多少金币（再加胜分奖励）
  reward : number
}

// 赢多少分额外给多少金币，最多这么多
export const MARGIN_BONUS_CAP : number = 10

// ---------- 商店的货 ----------

// 一次性道具。买了**立刻用**，所以没有「库存」那一层。
//
// 分四路：改牌组构成（推点数、同化、弃饵）、改技能（砺钩、洗点）、
// 开包（技能二选一/五选一、牌六选一）、**永久扩容**（加栏、加权）。
//
// 每次进店只上 SHOP_FIX_COUNT 种 —— 看见什么买什么，
// **买完就没了，刷新也不补**。这跟下面那一栏（技能和卡牌，刷新能补货）
// 是有意分开的：道具是「这一关的机会」，那一栏是「这一关的行情」
//
// ---------- 稀有度 ----------
//
// 三档。**档位越高越难摇到，但概率随关号往上走**（见 rareWeight）。
//
// 为什么要分档：十二种道具平摊权重的话，「这一关刷到什么」就是一次
// 均匀抽样 —— 后期和前期看见的东西没区别，而这个玩法是**一轮十二关
// 越往后家当越厚**。稀有度把货架变成一条曲线：前期摆的是零件
//（推点数、买牌、弃饵），后期才见得着翻盘的那几件。
//
// 它同时解决了另一件事：史诗那几件（五选一、加权）单看定价压不住 ——
// 后期钱多，180 块不是门槛。真正的门槛变成「**它出不出来**」
export const RARE_COMMON : number = 0
export const RARE_RARE : number = 1
export const RARE_EPIC : number = 2

export function rareName(rare : number) : string {
  if (rare == RARE_EPIC) {
    return '史诗'
  }
  return rare == RARE_RARE ? '稀有' : '普通'
}

// 第 level 关（1 起）上货时，这一档每件货占多少权重。
//
// 普通恒定、稀有和史诗往上爬 —— 爬的斜率越高档位越高，
// 于是三条线在第 12 关附近收到同一个量级上：
//
//            第 1 关      第 6 关      第 12 关
//   普通       100          100          100
//   稀有        18           53           95
//   史诗         3           23           47
//
// 按件数折成「一次上货里摆得出史诗」的概率
//（表里普通 6 件、稀有 6 件、史诗 2 件，一次摆 3 种）：
//
//   第 1 关   约 2.5%   —— 基本见不着
//   第 6 关   约 14%    —— 偶尔撞上
//   第 12 关  约 21%    —— 五次进店见一次
//
// 那正是想要的形状 —— 不是「后期必出」，是「后期值得期待」。
// 顺带算一下稀有：第 1 关一次上货里约有四成摆得出一件，
// 第 12 关接近八成，所以砺钩那条升级线前期紧、后期顺。
//
// 这几个数跟表的件数绑着 —— 往某一档加货会把别的档摊薄，
// 加完记得回来重算一遍
export function rareWeight(rare : number, level : number) : number {
  const step = level < 1 ? 0 : level - 1
  if (rare == RARE_EPIC) {
    return 3 + 4 * step
  }
  if (rare == RARE_RARE) {
    return 18 + 7 * step
  }
  return 100
}

export type FixItem = {
  key : string
  name : string
  price : number
  // 一句话说明。**必填** ——
  //
  // 这一栏早先只摆名字 + 价钱，因为头四件（推一格、推两格、推三格、同化）
  // 的名字就是说明。后来表里进了砺钩、洗点、三个包、四件唯一扩容 ——
  // 「加权」「平价」这种名字光看是猜不出来的，而它们一件 80 到 180 块，
  // 是整轮里最重的几笔。买之前看不见效果，那就不是取舍而是赌名字
  desc : string
  // 推几格。不改点数的一律 0
  step : number
  // 稀有度（RARE_*）
  rare : number
  // **唯一**：一轮之内只能买一次，买过就不再上货。
  // 四件扩容道具（加栏、加架、加权、平价）是这一类 —— 它们改的是规则本身，
  // 能叠买的话「攒钱买到槽满」会变成唯一的正解
  once : boolean
  // **保底份额**：这件货在上货池里至少占多少权重（0~1），0 表示不保底。
  //
  // ---- 为什么是「份额」而不是「权重」 ----
  //
  // 纯权重保底压不住后期：稀有和史诗的权重是往上爬的（见 rareWeight），
  // 池子总量跟着涨，同一个固定权重的**份额**会被越稀释。
  // 份额保底才能让一件货在整轮十二关里出现率恒定。
  //
  // ---- 谁需要它 ----
  //
  // 两件：【砺钩】（升级的唯一通道）和【洗点】（位置摇定的唯一救济口）。
  //
  // 它们俩的问题是一样的：**档位决定出现率，可它们是「通道」不是「奖励」**。
  // 砺钩按稀有算，整轮期望只出两次上下 —— 而点数槽 6 格正好被
  // 「4 个技能占 4 格 + 升 2 级占 2 格」填满，槽容量和砺钩产量对死了。
  // 后果是绝大多数轮次技能停在初始级，而初始点数技触发率只有 28%
  //（见设计文档第三节），「满级才和颜色技一样常用」那个状态根本到不了。
  //
  // 0.09 这个数是倒推的：一次上货摆 3 种，要让「这一关摆得出砺钩」
  // 落在 27% 上下，它就得占池子的一成 —— 份额 0.09 加上
  // 「抬完之后总量也变大」那一层，正好是一成。
  // 于是整轮期望从约 2 次涨到约 3.3 次，刚好够把槽填满（含加权那第 7 格）
  floor : number
}

// 保底份额：砺钩和洗点用这个数（理由见 FixItem.floor）
export const FLOOR_SHARE : number = 0.09

export const FIX_ITEMS : FixItem[] = [
  // 推点数那三件：一格、两格便宜又常见（普通），三格跨度大 —— 它能
  // 把一张 4 直接推到你技能管着的 7 上，那是精确调牌，所以压成稀有
  { key: 'push1', name: '推一格', desc: '挑一张牌，点数 ±1', price: 30,
    step: 1, rare: RARE_COMMON, once: false, floor: 0 } as FixItem,
  { key: 'push2', name: '推两格', desc: '挑一张牌，点数 ±2', price: 50,
    step: 2, rare: RARE_COMMON, once: false, floor: 0 } as FixItem,
  { key: 'push3', name: '推三格', desc: '挑一张牌，点数 ±3', price: 70,
    step: 3, rare: RARE_RARE, once: false, floor: 0 } as FixItem,
  // 同化：右边那张完全变成左边那张（点数和花色都一样）。
  // 于是牌组里出现两张一模一样的牌，那两张必然互相钓得上
  //
  // 稀有：造一对必然互钓的牌是整张表里最直接的「加分结构」
  { key: 'same', name: '同化', desc: '挑两张牌，右边那张完全变成左边那张', price: 100,
    step: 0, rare: RARE_RARE, once: false, floor: 0 } as FixItem,
  // 弃饵：从牌组里拿掉一张。
  //
  // ---- 它的用处是**提纯**，不是针对对手 ----
  //
  // 这一条当初想错过一次，记在这儿免得再想错：曾以为它能「抽走对手
  // 技能覆盖的那几个点数」。**不成立** —— 商店是打赢一关之后进的，
  // 那会儿你面对的是**下一关**的庄家，而它带什么技能你还没见过
  //（关卡页不报庄家信息，对局页那排是当前关的）。
  //
  // 它真正的用处是反过来的：**把自己用不上的牌删掉**。牌库变薄，
  // 你技能覆盖的那几个点数在里头的占比就上去了 —— 跟「推点数」
  // 一头一尾：一个把牌往自己的点数上拽，一个把够不着的清出去。
  //
  // 顺带还是条节奏轴：牌库薄 = 回合少 = 分差小。领先了就删牌收口，
  // 落后了就买牌加厚 —— 这条轴从前只有「加」没有「减」。
  //
  // 删到底能把某个点数**清空**，那条路是有意留着的（见 DECK_MIN）。
  // 它要针对对手只有一条路：**打过一轮，记住了第几关的庄家带什么**——
  // 那是熟练玩家的功课，不是界面递给你的信息。
  //
  // 比买牌（40）贵一点：买牌只是加一张，这个动的是整副牌的成色。
  //
  // 普通：它是「清出去」那条轴上唯一的一件，得常见得够你真能提纯一副牌
  //（删四张要刷到它四次）
  { key: 'drop', name: '弃饵', desc: '挑一张牌，从牌组里拿掉', price: 50,
    step: 0, rare: RARE_COMMON, once: false, floor: 0 } as FixItem,
  // 砺钩：挑一个手里的技能，升一级。
  //
  // ---- 升级从「攒够钱就能升」改成「等得到这件货」 ----
  //
  // 从前技能卡上挂着一颗「升级 90」的按钮，有钱就点。那让升级变成了
  // 一道算术：攒 240 就能把磁钩升满，照着存钱条走就行。
  //
  // 改成道具之后它变成**机会**：这一关货架上出不出砺钩不由你定，
  // 出了就得当场决定升哪个。跟「技能掉什么不由你挑」、「位置摇定」
  // 是同一条思路 —— 这个玩法的主题是适应摇出来的东西，不是执行计划。
  //
  // ---- 价钱为什么拍平成一个数 ----
  //
  // 技能表里原来按级定价（升 1 级 90、升 2 级 150）。现在一律 100：
  // 稀缺性替掉了价格梯度 —— 升到 2 级不比升到 1 级贵，
  // 但你得**等货架上再出一个**。
  //
  // 卖出价跟着改（见 draw-skills 的 investedOf）：一个技能值
  // 解锁价 + UPGRADE_PRICE×等级
  //
  // ---- 它**带保底份额**，档位只管显示 ----
  //
  // 原先它只是「稀有」，整轮期望出两次上下。可它是升级的**唯一通道**，
  // 而点数槽 6 格正好被「4 个技能 + 升 2 级」填满 —— 槽容量和砺钩产量
  // 对死了，结果绝大多数轮次技能停在初始级（点数技触发率只有 28%）。
  //
  // 那不是稀缺，那是把一条路堵死。所以给它 FLOOR_SHARE 保底：
  // 每关约 27% 摆得出来，整轮期望约 3.3 次 —— 刚够把槽填满。
  // 它仍然标「稀有」，因为那个标签说的是分量，不是掉率
  { key: 'sharpen', name: '砺钩', desc: '挑一个技能升一级（要点数槽有空格）',
    price: UPGRADE_PRICE, step: 0, rare: RARE_RARE, once: false,
    floor: FLOOR_SHARE } as FixItem,
  // 洗点：挑一个技能，把它占的点数（或花色）**重摇一遍**。
  //
  // 这是「位置摇定」那条规矩唯一的救济口。摇定是核心设计，但偶尔会
  // 摇出没法用的一手 —— 技能落在 A、2 上，而那两个点数一局碰不上几次。
  //
  // 它给的不是「改成我要的」，是**再摇一次的机会** —— 结果照旧随机，
  // 可能洗得更烂。所以它救急而不破规矩，定价也按「赌一把」来：
  // 70，跟推三格同价，比保证生效的砺钩（100）便宜。
  //
  // 普通：它是救济口。救济口稀有就不成救济 —— 摇出一手废位置的时候
  // 你需要它**现在**在货架上，不是「等等看后面刷不刷到」。
  //
  // 它也**带保底份额**。普通的权重恒定 100，看着够常见，可池子总量
  // 往后涨（稀有和史诗的权重在爬），所以它的份额越往后越薄：
  // 第 1 关一次上货有三成多摆得出来，第 12 关只剩两成。
  // 一个救济口不该在最需要它的后期变稀 —— 保底之后整轮恒定 27% 上下
  { key: 'wash', name: '洗点', desc: '挑一个技能，把它占的位置重摇一遍（可能更烂）',
    price: 70, step: 0, rare: RARE_COMMON, once: false,
    floor: FLOOR_SHARE } as FixItem,
  // ---- 三个「包」：买下来当场摊开 N 个随机候选，挑 1 个 ----
  //
  // 它们跟货架上直接摆着的技能/卡牌是两种买法：
  //
  //   货架 —— **店里有什么**。这一批上了什么就只能买什么，
  //           想换得花钱刷新（而刷新价翻倍涨）。
  //   包   —— **自己开一次**。候选是当场摇的，所以它卖的是
  //           「跳过货架的随机性」：直接摊 N 个给你挑。
  //
  // 定价按候选数走：挑的面越宽越贵。技能两选一（80）比货架上
  // 单买一个技能（40~150，平均八十上下）不便宜，但你**挑得着**；
  // 五选一（160）基本是「这一关我要定一个技能」的价钱。
  //
  // 卡牌六选一只要 60：牌本身便宜（40/80），所以包的溢价也小。
  //
  // 稀有度照「挑的面」排：牌六选一是零件（普通），技能二选一是一次
  // 像样的选择（稀有），五选一基本等于「这一关我点一个技能」—— 史诗
  { key: 'pack2', name: '技能二选一', desc: '当场摊 2 个没有的技能，挑 1 个',
    price: 80, step: 0, rare: RARE_RARE, once: false, floor: 0 } as FixItem,
  // 五选一**留在史诗，但降到 120**。
  //
  // 它不是唯一道具，定位是「这一关我要定一个技能」，可史诗一轮期望
  // 只出 0.9 次 —— 约四成轮次整轮见不到。那种稀缺配 160 的价钱是错配：
  // 好不容易见着一次，还可能买不起。
  //
  // 降档和降价两条路里选了**降价**：加权降档之后史诗就只剩它一件了，
  // 再降档这一层档位就空了，rareWeight 里史诗那条曲线成了死代码。
  // 而「一轮大概见一次、见着就买得起」正好是这件货该有的手感
  { key: 'pack5', name: '技能五选一', desc: '当场摊 5 个没有的技能，挑 1 个',
    price: 120, step: 0, rare: RARE_EPIC, once: false, floor: 0 } as FixItem,
  { key: 'cards6', name: '牌六选一', desc: '当场摊 6 张随机牌，挑 1 张加进牌组',
    price: 60, step: 0, rare: RARE_COMMON, once: false, floor: 0 } as FixItem,
  // ---- 下面四件是永久扩容。都是**唯一**：一轮只买得到一次 ----
  //
  // 它们跟表里别的货不是一类东西。别的货改的是「这一关我手里多了什么」，
  // 这四件改的是**规则里的一个数**，而且改完一直有效到这一轮结束：
  //
  //   加栏 → 道具栏几格      加架 → 技能/卡牌栏几格
  //   加权 → 点数槽几格      平价 → 刷新怎么计价
  //
  // 四件里**三件是「越早买越值」**（加栏、加架、平价都按剩下的关数折现），
  // 只有加权什么时候买都一样值。那条「时效性」是它们定档的主要依据，
  // 详见各自那一段和 rareWeight 上面那张表。
  //
  // ---- 加栏：道具栏从 3 格变 4 格 ----
  //
  // 它买的不是一件货，是**后面每一关的选择面**。所以它的价值完全
  // 取决于什么时候买到：第 3 关买，剩下九关每关多看一件；第 11 关买，
  // 多看两件就打完了。
  //
  // 正因为这样它压成**稀有**而不是史诗 —— 史诗的出现概率是往后爬的
  //（见 rareWeight），而一件「越早买越值」的货配一条「越晚越容易见」
  // 的曲线，等于设计出来就是让人错过。稀有在第 4、5 关就有几成机会见着，
  // 那才是它该出现的位置。
  //
  // 120 块：约等于两关的收入。买它这一关你基本买不了别的了，
  // 那是它该有的分量
  { key: 'shelf', name: '加栏', desc: '道具栏永久多 1 格（下一关生效）', price: 120,
    step: 0, rare: RARE_RARE, once: true, floor: 0 } as FixItem,
  // ---- 加权：点数槽从 6 格变 7 格 ----
  //
  // 点数槽的格数是整个技能体系的总预算：每个技能占 等级+1 格
  //（见 rankSizeOf），升级要有空格才升得动（见 canUpgrade）。
  // 所以多一格 = **多一次升级**，或者多装一个技能。
  //
  // 它跟加栏相反，**什么时候买到都一样值**：那一格不会过期，
  // 它只是把你这一轮的上限抬高一档。所以它配得上史诗那条
  // 「越往后越容易见」的曲线 —— 第 10 关摇到它照样是实打实的收益。
  //
  // 180 块，全表最贵。贵在它是唯一能动「总预算」的一件：
  // 别的货都在那 6 格里面做取舍，只有它把 6 变成 7。
  //
  // ---- 它从史诗降到了稀有 ----
  //
  // 原先配史诗，结果是**两重稀缺叠乘**：史诗一轮期望出 0.9 次，
  // 而那第 7 格要第 3 次砺钩才填得上，砺钩一轮才出 2.2 次 ——
  // 两个一乘，全表最贵的一件货期望收益接近 0。那一格买来是空的。
  //
  // 修的顺序是先砺钩再它：砺钩有了保底份额（整轮约 3.3 次）之后，
  // 第 7 格才真有东西填；这时候再把它降到稀有，让你见得着。
  //
  // **没有附带免费升一级** —— 那等于一个打折的砺钩，两件货就重了
  //（8.6 那条已经否掉过）。它卖的始终是「升得动」，不是「升一级」
  { key: 'weight', name: '加权', desc: '点数槽永久多 1 格（多一次升级的余量）',
    price: 180, step: 0, rare: RARE_RARE, once: true, floor: 0 } as FixItem,
  // ---- 加架：技能 / 卡牌那一栏从 4 格变 5 格 ----
  //
  // 跟加栏是同一件事的另一半：加栏宽的是上面那栏（道具），
  // 加架宽的是下面那栏（技能和卡牌）。
  //
  // 两件货的**手感不一样**，所以价钱也不一样：
  //
  //   加栏（120）宽的那一栏**刷不动**。多一格就是多一次「这一关
  //           能不能撞上我要的那件道具」，纯粹是运气面变宽。
  //   加架（100）宽的那一栏**刷得动**。多一格不只是多看一件，
  //           它还让每一次刷新更值 —— 同样的刷新钱买到五个结果而不是四个。
  //
  // 所以加架便宜一点，但跟【平价】凑在一起会很凶：五格 × 三十块一刷，
  // 那基本是「这一关我要什么技能点什么技能」。那条路成立是对的 ——
  // 它要两件唯一道具都摇到，而且两件都得早
  { key: 'card', name: '加架', desc: '技能/卡牌栏永久多 1 格（换一批就看得见）',
    price: 100, step: 0, rare: RARE_RARE, once: true, floor: 0 } as FixItem,
  // ---- 平价：换一批固定 30 块，不再翻倍 ----
  //
  // 刷新价本来是翻倍涨的（20 / 40 / 80 / 160，见 cardRerollCost），
  // 那条曲线的意思是「刷一两次是常规操作，刷到满意为止不行」。
  // 平价把它拍平成一个数：30 块一次，刷到你没钱为止。
  //
  // ---- 它为什么是**普通**而不是稀有 ----
  //
  // 这是全表唯一一件「档位压低是因为时效性」的货。
  //
  // 它的收益是「**后面每一关**每一次刷新省下的钱」，所以越早买越值：
  // 第 3 关买，剩下九关的刷新全按 30 算；第 11 关买，省两次钱就打完了。
  // 而稀有和史诗的权重是**往后爬**的（见 rareWeight）—— 一件越早越值的货
  // 配一条越晚越容易见的曲线，等于设计出来让人错过。
  //
  // 普通的权重是**恒定**的，也就是「任何一关都一样容易撞上」。
  // 那正是一件时效性道具该有的出现方式。
  //
  // 加栏也是越早越值，但它压在稀有 —— 两件货的区别在**分量**：
  // 加栏改的是「每关能看见几件道具」，那是结构性的；平价改的只是
  // 一个价钱，省下来的钱整轮加起来也就一两百。小收益配常见，
  // 大收益配稀缺，这条比「时效性」优先。
  //
  // 80 块：约等于三次刷新的差价。所以它大概在第四五关之前买到才回本 ——
  // 那也是「越早越值」的另一种说法
  { key: 'flat', name: '平价', desc: '换一批永久固定 30 块，不再翻倍', price: 80,
    step: 0, rare: RARE_COMMON, once: true, floor: 0 } as FixItem
]

// 三个包各摊几个候选
export function packSize(key : string) : number {
  if (key == 'pack2') {
    return 2
  }
  if (key == 'pack5') {
    return 5
  }
  return key == 'cards6' ? 6 : 0
}

// 这件货是不是「包」（买了当场摊候选挑一个）
export function isPack(key : string) : boolean {
  return key == 'pack2' || key == 'pack5' || key == 'cards6'
}

// 牌组的下限。只有这一条，**不限制「每个点数至少留几张」**。
//
// 于是「把某个点数全删掉」走得通：四张 7 花两百块清空。那是有意留着的，
// 但它不是一条便宜的路 —— 两百块是三四关的收入，而且弃饵得在货架上
// 连着出现四次（十种道具里每次只上三种）。
//
// 它也不是**当场**就能针对谁：你买的时候还没见过下一关的庄家
//（见 FIX_ITEMS 里弃饵那段）。要靠它封死对手，得先打过一轮、
// 记住第几关的庄家吃哪几个点数 —— 代价够大的极端解法应该成立，
// 但它该是熟练玩家的功课，不是随手就能使的一招
export const DECK_MIN : number = 40

export function fixItemOf(key : string) : FixItem {
  for (let i = 0; i < FIX_ITEMS.length; i++) {
    if (FIX_ITEMS[i].key == key) {
      return FIX_ITEMS[i]
    }
  }
  return FIX_ITEMS[0]
}

// 池子里每件货这一关的权重：先按稀有度算，再把带**保底份额**的抬上去。
//
// 保底怎么算（见 FixItem.floor）：一件货要占到份额 f，它的权重得是
//
//     w = f × 总量
//
// 可总量里又含着 w 自己 —— 抬了它，总量也跟着涨。把 Σf 那部分挪到
// 左边解出来就是下面那个 base / (1 − Σf)：
//
//     w = f × base / (1 − Σf)      base = 按稀有度算出来的池子总量
//
// 然后取 max(按档位的权重, 保底的权重) —— 它是**保底**，不是定值。
// 洗点在前几关的自然份额本来就高过保底，那几关保底不生效
function weightsFor(pool : number[], level : number) : number[] {
  let base = 0
  let floorSum = 0
  for (let i = 0; i < pool.length; i++) {
    base = base + rareWeight(FIX_ITEMS[pool[i]].rare, level)
    floorSum = floorSum + FIX_ITEMS[pool[i]].floor
  }
  // 保底份额加起来要是逼近 1，下面那个除法会炸 —— 现在是 0.18，
  // 这道闸是防将来往表里加第三第四件保底货
  if (floorSum > 0.5) {
    floorSum = 0.5
  }
  const scale = base / (1 - floorSum)
  const out : number[] = []
  for (let i = 0; i < pool.length; i++) {
    const one = FIX_ITEMS[pool[i]]
    const byRare = rareWeight(one.rare, level)
    const byFloor = one.floor > 0 ? Math.round(one.floor * scale) : 0
    out.push(byRare > byFloor ? byRare : byFloor)
  }
  return out
}

// 按稀有度权重摇 want 种道具（**不重复**）。
//
// skip 是这一轮已经买过的唯一道具 —— 它们不再上货（见 FixItem.once）。
//
// 做法是「按权重抽一个 → 从池子里剔掉 → 再抽」。每一轮都重新累一遍
// 总权重，次数少（want 顶多四五个），没必要为此搭个前缀和。
//
// 剔掉而不是允许重复：同一批里摆两个弃饵就浪费了一格 ——
// 道具是买完就没的，重复的那一格等于白摆
export function rollFixKeys(level : number, want : number, skip : string[]) : string[] {
  // 候选池：排掉已经买过的唯一道具
  let pool : number[] = []
  for (let i = 0; i < FIX_ITEMS.length; i++) {
    let skipped = false
    for (let s = 0; s < skip.length; s++) {
      if (skip[s] == FIX_ITEMS[i].key) {
        skipped = true
        break
      }
    }
    if (!skipped) {
      pool.push(i)
    }
  }
  const out : string[] = []
  for (let n = 0; n < want && pool.length > 0; n++) {
    // 这一轮每件货的权重（算过保底份额了，见 weightsFor）
    const w = weightsFor(pool, level)
    let total = 0
    for (let i = 0; i < w.length; i++) {
      total = total + w[i]
    }
    // 权重全是正数，total 不会是 0；保一手免得将来改表改出个 0 来
    let roll = total > 0 ? Math.floor(Math.random() * total) : 0
    let hit = pool.length - 1
    for (let i = 0; i < pool.length; i++) {
      roll = roll - w[i]
      if (roll < 0) {
        hit = i
        break
      }
    }
    out.push(FIX_ITEMS[pool[hit]].key)
    // 抽中的剔出池子。UTS 那边数组删不了元素，只能换引用
    const rest : number[] = []
    for (let i = 0; i < pool.length; i++) {
      if (i != hit) {
        rest.push(pool[i])
      }
    }
    pool = rest
  }
  return out
}

// 每次进店上几种道具（底数；买过【加栏】之后 +1，见 fixSlotsOf）。
//
// **3 而不是 12（全摆）**：全摆出来就没有「这次刷到了什么」可言，
// 十二种的区别退化成一条价格梯子，照着钱包挑最贵的买就行。
// 也不该太少 —— 一种就全凭运气，连取舍都没有。
//
// 定 3 是因为道具表涨到十四种了（三种推点数、同化、弃饵、砺钩、洗点、
// 三个包、四件唯一扩容）。原先四种的时候摆 2 个正好是一个取舍；
// 十四种里摆 2 个就太窄了，想要的那件十关也刷不着几次
export const SHOP_FIX_COUNT : number = 3

// 加栏加几格。定 1 而不是让它叠买 —— 它是唯一道具（once），
// 所以这个数就是「买过」和「没买过」的差
export const SHELF_BONUS : number = 1

// 加架加几格（技能 / 卡牌那一栏）。同样定 1、同样唯一
export const CARD_BONUS : number = 1

// 加权加几格点数槽。同样定 1、同样唯一
export const RANK_BONUS : number = 1

// ---------- 点数卡 ----------
//
// 给牌组里某一张牌贴一个**额外点数**，于是那张牌同时算几个点数：
// ♠3 贴了 7 之后，3 和 7 都钓得上它，它也钓得上 3 和 7。
//
// 它和「买牌」是同一条轴的两头：
//
//   买牌（40/80）  牌组多一张 → 那个点数多一次撞上的机会，
//                  **代价是牌组变厚**（局更长、你技能覆盖面占比被稀释）
//   点数卡（90）    牌组**不变厚**，但某一张牌多一条出路
//
// 后者贵一倍多，因为它没有那份代价，而且更精准 ——
// 你可以专挑一张「花色落在自己花色槽上」的牌去贴，
// 让那一张同时吃两个点数，成为这一轮的核心牌。
//
// 90 块是故意比单买一个便宜技能（40~60）贵的：牌组改造这条路
// 不该比技能便宜，不然它就成了默认选项。
//
// 它**不改牌面点数、也不改 rank**，所以：
//   · 不会把牌变成 J（通吃焊在 rank 上）
//   · 不触发点数技（triggersOf 读的是 rank）
//   · 庄家的记牌（outsideCount 按 rank 数）看不见它 ——
//     那是个**已知的近似**：贴过点数卡的牌对庄家来说是「隐藏的一条出路」。
//     牌组是双方共用的，所以这份便宜双方都占得到，但只有你知道贴在哪
export const PIP_PRICE : number = 90

// 下面那一栏上几件（技能和卡牌混着摆）的**底数**；
// 买过【加架】之后 +1，见 cardSlotsOf。
//
// 4 件：一行摆得下，而且挑得动。再多就是眼花，再少不如不挑。
// 技能只上你还没有的，摆完了就全摆牌（见 rollShelf）
export const SHOP_CARD_COUNT : number = 4

// 刷新第 times 次（从 0 起）要多少钱。**翻倍涨**。
//
// 第一次 20，比最便宜的一张牌（40）还便宜 —— 所以「这批不顺眼就刷一次」
// 是常规操作。第二次 40 就等于一张牌的价钱，开始犹豫；第三次 80
// 是 J 的价钱，基本不划算。实际上你会刷一到两次，那正是想要的档位。
//
// 线性涨（20/40/60）压不住：后期金币多，六十块刷到满意为止太便宜了。
//
// 【平价】那件唯一道具**把这条曲线整个换掉**，拍平成 FLAT_REROLL ——
// 真正该读的是 rerollPriceOf（它查过存档再决定走哪条）
export function cardRerollCost(times : number) : number {
  let cost = 20
  for (let i = 0; i < times; i++) {
    cost = cost * 2
  }
  return cost
}

// 买过【平价】之后，每次刷新都是这个价。
//
// 定 30 而不是 20（第一次刷新的原价）：平价卖的是「刷得起第三第四次」，
// 不是「刷新变便宜了」。头两次反而比原来贵一点（30 对 20 / 40），
// 第三次起才回本（30 对 80）—— 于是它不是无脑划算，
// 而是「我这一轮打算靠刷货架过日子」才买的那件
export const FLAT_REROLL : number = 30

// ---------- 利息 ----------
//
// 每过一关按**手头存款**给息：每 FULL 块给 STEP 块，最多 CAP。
//
// 这一条改的不是收入，是**「攒着」这个选项存不存在**。
//
// 从前金币不花就是死钱 —— 一分钱攒到第 12 关也还是一分钱，
// 所以最优解永远是「这一关有什么买什么，花光」。那让商店的取舍
// 退化成了「在摆出来这几件里挑最贵的买得起的」。
//
// 有了利息，「这一关什么都不买」成了一个真选项：手里压着 200 块
// 每关白拿 25，相当于每关多小半个技能的钱。于是你会开始算
// 「现在这件 80 块的推三格，值不值我少拿两关的利息」。
//
// 它跟稀有度是**互补**的：稀有度给了「值得攒钱等后期那几件」的理由
//（史诗越往后越容易见，见 rareWeight），利息给攒钱本身加收益。
// 两条合起来，前期省钱后期爆发才成为一条真路线。
//
// 数怎么定的：每关基础奖励 30 块上下（见 DRAW_LEVELS 的 reward）。
// 封顶 25 就是「存够 200 块，每关白拿将近一关的收入」——
// 够诱人，但没到「攒钱必胜」。40 一档而不是 10 一档，是为了让
// 「再攒 40 就跳一档」成为一个看得见的小目标。
//
// ---- 为什么档距从 50 改成 40，还多加了一个 30 的首档 ----
//
// 原来 50 一档，对**前期太粗**了：浅滩每关收入 30 上下，前三关的存款
// 峰值常落在 30–80 之间，而那个区间里利息要么 0 要么 5，基本无感。
//
// 可利息最需要立起来的恰恰是前期 —— 它要教会你「攒着有用」这件事。
// 第 1 关不买东西攒下 30 块，第 2 关结算时该看见点东西，
// 否则这一条规则在它最该起作用的时候是隐形的。
//
// 所以：
//   · 档距 40（原 50）—— 整条曲线往前挪，80 就能摸到第二档；
//   · **30 一档给 +3** —— 一关不买就看得见回报，是个「首杀」。
//     它是唯一一个不走档距的特例，值得这点不整齐。
//
// 于是前期这样走：30→3、40→5、80→10、120→15、160→20、200→25（封顶）
export const INTEREST_FULL : number = 40
export const INTEREST_STEP : number = 5
export const INTEREST_CAP : number = 25
// 首档：攒到这个数就给 INTEREST_FIRST，不等第一个整档
export const INTEREST_SEED : number = 30
export const INTEREST_FIRST : number = 3

export function interestOf(gold : number) : number {
  if (gold < INTEREST_SEED) {
    return 0
  }
  if (gold < INTEREST_FULL) {
    return INTEREST_FIRST
  }
  const got = Math.floor(gold / INTEREST_FULL) * INTEREST_STEP
  return got > INTEREST_CAP ? INTEREST_CAP : got
}

function noSkills() : number[] {
  const list : number[] = []
  for (let i = 0; i < DRAW_SKILLS.length; i++) {
    list.push(-1)
  }
  return list
}

// 「技能下标:等级」写成一串，没写到的就是 -1
function levelsOf(pairs : number[]) : number[] {
  const list = noSkills()
  for (let i = 0; i + 1 < pairs.length; i += 2) {
    list[pairs[i]] = pairs[i + 1]
  }
  return list
}

// suits：和 ♠♥♦♣ 对齐的四格；ranks：「点数, 技能」成对写
function loadoutOf(suits : number[], ranks : string[], skills : number[]) : DrawLoadout {
  const lo = emptyLoadout()
  for (let s = 0; s < suits.length; s++) {
    lo.suitOwner[s] = suits[s]
  }
  for (let i = 0; i < ranks.length; i++) {
    for (let r = 0; r < SKILL_RANKS.length; r++) {
      if (SKILL_RANKS[r] == ranks[i]) {
        lo.rankOwner[r] = skills[i]
      }
    }
  }
  return lo
}

const N : number = -1

export const DRAW_LEVELS : DrawLevel[] = [
  // ---------- 浅滩 ----------
  // 第 1 关给 80 而不是 30：新档 0 金币，第一个商店要是连【技能二选一】（80）
  // 都买不起，进店就只能干看。80 + 胜分保证第一店至少能拿下一个技能
  { id: 1, chapter: '浅滩', name: '试竿', smart: false, random: true, levels: noSkills(), loadout: emptyLoadout(), reward: 80 },
  { id: 2, chapter: '浅滩', name: '涨潮', smart: false, random: false, levels: noSkills(), loadout: emptyLoadout(), reward: 30 },
  { id: 3, chapter: '浅滩', name: '老渔夫', smart: true, random: false, levels: noSkills(), loadout: emptyLoadout(), reward: 30 },
  { id: 4, chapter: '浅滩', name: '滩头', smart: true, random: false, levels: noSkills(), loadout: emptyLoadout(), reward: 30 },
  // ---------- 河湾：1 个技能 ----------
  {
    id: 5, chapter: '河湾', name: '回水', smart: true, random: false, reward: 45,
    levels: levelsOf([SK_HOOK, 0]),
    loadout: loadoutOf([N, N, N, N], ['7'], [SK_HOOK])
  },
  {
    id: 6, chapter: '河湾', name: '暗礁', smart: true, random: false, reward: 45,
    levels: levelsOf([SK_GUARD, 0]),
    loadout: loadoutOf([SK_GUARD, N, N, N], [], [])
  },
  {
    id: 7, chapter: '河湾', name: '望潮', smart: true, random: false, reward: 45,
    levels: levelsOf([SK_TIDE, 1]),
    loadout: loadoutOf([N, SK_TIDE, SK_TIDE, N], [], [])
  },
  {
    id: 8, chapter: '河湾', name: '湾口', smart: true, random: false, reward: 45,
    levels: levelsOf([SK_HOOK, 1]),
    loadout: loadoutOf([N, N, N, N], ['4', '7', '10'], [SK_HOOK, SK_HOOK, SK_HOOK])
  },
  // ---------- 深海：两个槽 ----------
  {
    id: 9, chapter: '深海', name: '雾海', smart: true, random: false, reward: 60,
    levels: levelsOf([SK_GUARD, 0, SK_HOOK, 1]),
    loadout: loadoutOf([SK_GUARD, N, N, N], ['3', '6', '9'], [SK_HOOK, SK_HOOK, SK_HOOK])
  },
  {
    id: 10, chapter: '深海', name: '漩涡', smart: true, random: false, reward: 60,
    levels: levelsOf([SK_TIDE, 1, SK_TOP, 0, SK_PEEK, 0]),
    loadout: loadoutOf([N, SK_TIDE, SK_TIDE, N], ['Q', '5'], [SK_TOP, SK_PEEK])
  },
  {
    id: 11, chapter: '深海', name: '鲸落', smart: true, random: false, reward: 60,
    levels: levelsOf([SK_GUARD, 1, SK_HOOK, 2]),
    loadout: loadoutOf([SK_GUARD, N, N, SK_GUARD], ['A', '3', '5', '7', '9', 'Q'],
      [SK_HOOK, SK_HOOK, SK_HOOK, SK_HOOK, SK_HOOK, SK_HOOK])
  },
  {
    id: 12, chapter: '深海', name: '深渊', smart: true, random: false, reward: 60,
    levels: levelsOf([SK_TIDE, 1, SK_HOOK, 1, SK_TOP, 0, SK_STIR, 0, SK_GUARD, 0]),
    loadout: loadoutOf([N, SK_TIDE, SK_TIDE, N], ['2', '6', '10', 'K', '8', '4'],
      [SK_HOOK, SK_HOOK, SK_HOOK, SK_TOP, SK_STIR, SK_GUARD])
  }
]

export const DRAW_LEVEL_COUNT : number = DRAW_LEVELS.length

// ---------- 难度 ----------
//
// 三档，管两件事：庄家怎么出牌、过关给多少金币。
//
//   简单 —— 浅滩四关（1–4）庄家完全随机出牌，之后各关都不记牌；过关奖励 ×1.5
//   普通 —— 照关卡表原样（第 1 关随机、第 2 关不记牌、第 3 关起记牌）
//   困难 —— 十二关全都记牌，没有随机关；过关奖励 ×0.75
//
// 倍率只乘关卡的**基础奖励**，胜分奖励和利息不跟着变 ——
// 那两样奖励的是「打得好」「忍住没花」，跟难度无关。
//
// 困难的第 1 关**保底 FIRST_REWARD_FLOOR**：第一个商店必上【技能二选一】，
// 新手引导也要你买它，第 1 关给的钱不够买就卡死了
export const DIFF_EASY : number = 0
export const DIFF_NORMAL : number = 1
export const DIFF_HARD : number = 2
export const DIFF_NAMES : string[] = ['简单', '普通', '困难']
const DIFF_REWARD_RATE : number[] = [1.5, 1.0, 0.75]
const EASY_RANDOM_UNTIL : number = 4
const FIRST_REWARD_FLOOR : number = 80

// 这一关在这个难度下的样子。返回一份新的，不改 DRAW_LEVELS 本身
export function levelForDiff(lv : DrawLevel, diff : number) : DrawLevel {
  let random = lv.random
  let smart = lv.smart
  if (diff == DIFF_EASY) {
    random = lv.id <= EASY_RANDOM_UNTIL
    smart = false
  } else if (diff == DIFF_HARD) {
    random = false
    smart = true
  }
  const rate = diff >= 0 && diff < DIFF_REWARD_RATE.length ? DIFF_REWARD_RATE[diff] : 1.0
  let reward = Math.round(lv.reward * rate)
  if (lv.id == 1 && reward < FIRST_REWARD_FLOOR) {
    reward = FIRST_REWARD_FLOOR
  }
  return {
    id: lv.id,
    name: lv.name,
    chapter: lv.chapter,
    smart: smart,
    random: random,
    levels: lv.levels,
    loadout: lv.loadout,
    reward: reward
  } as DrawLevel
}

export function drawLevelById(id : number) : DrawLevel {
  for (let i = 0; i < DRAW_LEVELS.length; i++) {
    if (DRAW_LEVELS[i].id == id) {
      return DRAW_LEVELS[i]
    }
  }
  return DRAW_LEVELS[0]
}
