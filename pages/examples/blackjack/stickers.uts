// 贴纸定义。贴纸贴在基础牌上，让这张牌变成特殊牌。
// 一张贴纸只能贴一张牌，撕下来就能再贴到别处。
// 每种贴纸按稀有度决定单价和最多能拥有几张：越稀有越贵、越少，
// 强力贴纸因此贴不满整副牌。同一个数字可以贴好几张同种贴纸（最多 4 张，因为只有 4 张牌）。
//
// 贴纸分三类：
// · 点数类：只要牌在堆上就一直有效，改的是「这张牌算几点」。本版生效的就是这一批。
// · 空位类：落进牌堆但没有数字（点数算 0）。它占一个堆位，换来一个跟数字无关的效果。
// · 立即类：打出的当下发动。不属于上面两类的都归这里。
//
// 下面这几条是贴纸描述里反复用到的共同规则，只在这里写一遍，
// 各张贴纸的 desc 保持客观，不重复解释（牌桌的规则说明里也列了一份）：
//
//   顺位：十三个数首尾相接。K 往上一位是 A，A 往下一位是 K。
//   钓点：点数得在 1 以上才当得了钓点。
//   空位：落堆时没有点数 —— 撞不上别人，也没人撞得上它，但花色照样算数。
//   0：提系压到底压出来的。跟没有点数一样当不了钓点，花色同样还在。
//   背面牌：数字和花色都不算数。新加进堆的背面牌一律沉到最左侧（堆底）——
//           钓牌是从撞中的位置往上收，所以沉在底下的基本带不走，会一直攒着。
//           【起底】是把它们翻回来变成分的唯一一条路。
//   落堆位置：默认压在堆顶（最右）；标「落堆底」的放最左侧。
//   J：四张全都焊死【通吃】，贴不了别的贴纸。
//
// 点数类一共六套派生，各管一层，互不冲突（见 cards.uts 的 valueOptions）：
//   暗桩改写基础值 → 坠子/提系加减一个定值 → 幸运和福星按顺位上下浮动、
//   倒影翻到轴的对面、游动和跳钩跳单独一位、放线和长线顺延一段。
//
// 每张贴纸用一个字符串 key 认身份，不用数字编号 ——
// 数字编号删一张就得把后面全部前移，存档也跟着错位；
// key 稳定不动，删增贴纸谁也不影响谁。
// 内存里仍然按数组下标索引（贴纸矩阵要用），下标由 STICKERS 的顺序决定，
// 不手工维护；存档里存的是 key，读档时再查回下标。

export type Sticker = {
  key : string
  name : string
  // 稀有度决定单价和拥有上限，见 RARITIES
  rarity : number
  desc : string
}

export type Rarity = {
  id : number
  name : string
  // 每张售价
  price : number
  // 这种稀有度的贴纸最多能拥有几张（已经贴出去的也算在内）
  own : number
  // 商店里的标色
  color : string
}

export const RARITY_COMMON : number = 0
export const RARITY_RARE : number = 1
export const RARITY_EPIC : number = 2
export const RARITY_LEGEND : number = 3

export const RARITIES : Rarity[] = [
  { id: 0, name: '普通', price: 150, own: 4, color: '#cfeade' },
  { id: 1, name: '稀有', price: 320, own: 3, color: '#7cc4ff' },
  { id: 2, name: '史诗', price: 600, own: 2, color: '#d59bff' },
  { id: 3, name: '传说', price: 1000, own: 1, color: '#ffb347' }
]

export function rarityAt(id : number) : Rarity {
  for (let i = 0; i < RARITIES.length; i++) {
    if (RARITIES[i].id == id) {
      return RARITIES[i]
    }
  }
  return RARITIES[0]
}

// 贴纸 key。加新贴纸就在 STICKERS 里追加一条、在这里补一个常量。
// 已有的 key 不要改 —— 存档按 key 记录贴纸贴在哪，改了老存档就对不上。
// key 和 name 分成两个字段，所以改显示名不用动存档（埋钩的 key 还是 give）

// 点数类
export const S_LUCKY : string = 'lucky'
export const S_BLESSED : string = 'blessed'
export const S_SINKER1 : string = 'sinker1'
export const S_SINKER2 : string = 'sinker2'
export const S_SINKER3 : string = 'sinker3'
export const S_SINKER4 : string = 'sinker4'
export const S_SINKER5 : string = 'sinker5'
export const S_SINKER6 : string = 'sinker6'
export const S_MINUS1 : string = 'minus1'
export const S_MINUS2 : string = 'minus2'
export const S_MINUS3 : string = 'minus3'
export const S_MINUS4 : string = 'minus4'
export const S_MINUS5 : string = 'minus5'
export const S_MINUS6 : string = 'minus6'
export const S_STAKE : string = 'stake'
// 齐顶的点数要看牌堆，是 cards.uts 算不出来的东西 ——
// 它的点数在 fishing.uvue 落堆那一刻现查现定
export const S_PEAK : string = 'peak'
// 大数流派：11 及以上是大数，10 及以下是小数。
// 归深把大数牌拢到 11 这个私有钓点上，深水把小数的收益压到最低
export const S_ANCHOR : string = 'anchor'
export const S_DEEP : string = 'deep'
// 放大系：把堆上的牌往大数区间推。
// 前三张改别人的点数，自己站开（空位、不判撞）；后两张从别人身上抽点数，
// 自己必须在场（立即类）—— 类别是按机制定的，不是按档位
export const S_RISE : string = 'rise'
export const S_PROP : string = 'prop'
export const S_SURGE : string = 'surge'
export const S_DRAIN : string = 'drain'
// 0 数流派：0 点当不了钓点，但花色还在、还算偶数、还喂得了续钩。
// 卸力跟暗桩对称（覆盖成定值），空钩跟归深对称（追加一个候选）
export const S_SLACK : string = 'slack'
export const S_BARE : string = 'bare'
export const S_GLEAN : string = 'glean'
export const S_DRY : string = 'dry'
// 同源：用花色给钩牌做精准制导 —— 挑中哪张，哪张就变成跟它同点数
export const S_AKIN : string = 'akin'
export const S_SHADOW : string = 'shadow'
export const S_DRIFT : string = 'drift'
export const S_HOOK : string = 'hook'
export const S_LINE : string = 'line'
export const S_LONGLINE : string = 'longline'
// 手牌与牌库
export const S_PEEK : string = 'peek'
export const S_SINK1 : string = 'sink1'
export const S_SINK2 : string = 'sink2'
export const S_PROBE1 : string = 'probe1'
export const S_PROBE2 : string = 'probe2'
// 探底看的是庄家的牌库，摸底（probe1/2）翻的是他的手牌，两码事
export const S_PROBE3 : string = 'probe3'
// 控制流派：看清对手手上有什么，再决定留什么给他
export const S_SPY : string = 'spy'
export const S_PRESS : string = 'press'
export const S_UNHOOK : string = 'unhook'
// 让对手手牌顶过上限，他回合结束就不补牌了 —— 牌池从此冻在你看过的那几张里
export const S_FEED : string = 'feed'
export const S_LEAD : string = 'lead'
export const S_SHUT : string = 'shut'
export const S_PICKED : string = 'picked'
export const S_SCAN : string = 'scan'
export const S_WASH : string = 'wash'
export const S_SAME : string = 'same'
export const S_EMPTY : string = 'empty'
// 牌堆结构
export const S_GIVE : string = 'give'
export const S_REEL : string = 'reel'
export const S_STRIP : string = 'strip'
export const S_SAND : string = 'sand'
export const S_GRIT : string = 'grit'
export const S_VEIL : string = 'veil'
export const S_DREDGE : string = 'dredge'
// 空位类
export const S_LURE : string = 'lure'
export const S_MIRROR : string = 'mirror'
export const S_STREAK : string = 'streak'
export const S_CAST : string = 'cast'
// 分水：红黑二选一，跟撒网（奇偶二选一）对称
export const S_SPLIT : string = 'split'
export const S_MURKY : string = 'murky'
export const S_GATE : string = 'gate'
export const S_MASK : string = 'mask'
export const S_STIR : string = 'stir'
export const S_DIG : string = 'dig'
export const S_GATHER : string = 'gather'
export const S_EVENS : string = 'evens'
export const S_NARROW : string = 'narrow'
export const S_AGAIN : string = 'again'
export const S_CALM : string = 'calm'
// 从牌库连着往外打的三张。停手的条件各不相同，机制是同一套
export const S_TROLL : string = 'troll'
export const S_VOLLEY : string = 'volley'
export const S_SIEVE : string = 'sieve'
// 拖网不是空位类：它自己有点数，照常落堆，只是落下去时多收一段
export const S_DRAG : string = 'drag'
// 花色系
export const S_SMEAR : string = 'smear'
export const S_HUE : string = 'hue'
export const S_BLEND : string = 'blend'
export const S_UNIFY : string = 'unify'
export const S_DYE : string = 'dye'

// 没贴贴纸的普通牌用空串表示
export const S_NONE : string = ''

// J 身上焊死的效果。它不进 STICKERS —— 不上架、不能买、不能撕、也不能换，
// 所以没理由占掉贴纸矩阵的一列，更没理由在商店和牌组编辑里露面
export const S_HAUL : string = 'haul'

const HAUL : Sticker = {
  key: 'haul',
  name: '通吃',
  rarity: 3,
  desc: '打出时把整个牌堆连同这张牌一起收走。J 自带，撕不下来也换不掉'
}

// 这个数字身上的贴纸是不是焊死的
export function isFixedRank(rank : string) : boolean {
  return rank == 'J'
}

