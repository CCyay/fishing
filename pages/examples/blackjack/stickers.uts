// 贴纸定义。贴纸贴在基础牌上，让这张牌变成特殊牌。
// 一张贴纸只能贴一张牌，撕下来就能再贴到别处。
// 每种贴纸按稀有度决定单价和最多能拥有几张：越稀有越贵、越少，
// 强力贴纸因此贴不满整副牌。同一个数字可以贴好几张同种贴纸（最多 4 张，因为只有 4 张牌）。
//
// 贴纸分三类：
// · 点数类：只要牌在堆上就一直有效，改的是「这张牌算几点」。本版生效的就是这一批。
// · 空位类：落进牌堆但没有数字（点数算 0）。它占一个堆位，换来一个跟数字无关的效果。
// · 立即类：打出的当下发动。不属于上面两类的都归这里。
//
// 下面这几条是贴纸描述里反复用到的共同规则，只在这里写一遍，
// 各张贴纸的 desc 保持客观，不重复解释（牌桌的规则说明里也列了一份）：
//
//   顺位：十三个数首尾相接。K 往上一位是 A，A 往下一位是 K。
//   钓点：点数得在 1 以上才当得了钓点。
//   空位：落堆时没有点数 —— 撞不上别人，也没人撞得上它，但花色照样算数。
//   0：提系压到底压出来的。跟没有点数一样当不了钓点，花色同样还在。
//   背面牌：数字和花色都不算数。新加进堆的背面牌一律沉到最左侧（堆底）——
//           钓牌是从撞中的位置往上收，所以沉在底下的基本带不走，会一直攒着。
//           【起底】是把它们翻回来变成分的唯一一条路。
//   落堆位置：默认压在堆顶（最右）；标「落堆底」的放最左侧。
//   J：四张全都焊死【通吃】，贴不了别的贴纸。
//
// 点数类一共六套派生，各管一层，互不冲突（见 cards.uts 的 valueOptions）：
//   暗桩改写基础值 → 坠子/提系加减一个定值 → 幸运和福星按顺位上下浮动、
//   倒影翻到轴的对面、游动和跳钩跳单独一位、放线和长线顺延一段。
//
// 每张贴纸用一个字符串 key 认身份，不用数字编号 ——
// 数字编号删一张就得把后面全部前移，存档也跟着错位；
// key 稳定不动，删增贴纸谁也不影响谁。
// 内存里仍然按数组下标索引（贴纸矩阵要用），下标由 STICKERS 的顺序决定，
// 不手工维护；存档里存的是 key，读档时再查回下标。

export type Sticker = {
  key : string
  name : string
  // 稀有度决定单价和拥有上限，见 RARITIES
  rarity : number
  desc : string
}

export type Rarity = {
  id : number
  name : string
  // 每张售价
  price : number
  // 这种稀有度的贴纸最多能拥有几张（已经贴出去的也算在内）
  own : number
  // 商店里的标色
  color : string
}

export const RARITY_COMMON : number = 0
export const RARITY_RARE : number = 1
export const RARITY_EPIC : number = 2
export const RARITY_LEGEND : number = 3

export const RARITIES : Rarity[] = [
  { id: 0, name: '普通', price: 150, own: 4, color: '#cfeade' },
  { id: 1, name: '稀有', price: 320, own: 3, color: '#7cc4ff' },
  { id: 2, name: '史诗', price: 600, own: 2, color: '#d59bff' },
  { id: 3, name: '传说', price: 1000, own: 1, color: '#ffb347' }
]

export function rarityAt(id : number) : Rarity {
  for (let i = 0; i < RARITIES.length; i++) {
    if (RARITIES[i].id == id) {
      return RARITIES[i]
    }
  }
  return RARITIES[0]
}

// 贴纸 key。加新贴纸就在 STICKERS 里追加一条、在这里补一个常量。
// 已有的 key 不要改 —— 存档按 key 记录贴纸贴在哪，改了老存档就对不上。
// key 和 name 分成两个字段，所以改显示名不用动存档（埋钩的 key 还是 give）

