export const STICKER_COUNT : number = STICKERS.length
// 同一个数字只有 4 张牌，所以最多贴 4 张贴纸。
// 不限种类：4 张全贴轻坠可以，四种各一张也可以
// 留着给展示和文案用。贴纸矩阵改成「数字 × 花色」之后，
// 这条限制由结构本身保证了 —— 一个数字就四个格子，填满就是满
export const MAX_STICKERS_PER_RANK : number = 4

// key 查下标。贴纸矩阵按下标索引，但下标是 STICKERS 的顺序决定的，
// 删增贴纸会变；存档里存 key，读档时用这个查回来
export function indexOfKey(key : string) : number {
  for (let i = 0; i < STICKERS.length; i++) {
    if (STICKERS[i].key == key) {
      return i
    }
  }
  return -1
}

export function keyAtIndex(index : number) : string {
  if (index < 0 || index >= STICKERS.length) {
    return S_NONE
  }
  return STICKERS[index].key
}

export function stickerAt(key : string) : Sticker {
  // 通吃不在 STICKERS 里，得先单独认一下
  if (key == S_HAUL) {
    return HAUL
  }
  for (let i = 0; i < STICKERS.length; i++) {
    if (STICKERS[i].key == key) {
      return STICKERS[i]
    }
  }
  return STICKERS[0]
}

export function rarityOfKey(key : string) : number {
  return stickerAt(key).rarity
}

// ---------- 点数派生 ----------
//
// 下面六个函数各管一层，valueOptions 按顺序叠起来。
// 一张牌只贴得下一张贴纸，所以这几层永远不会同时命中 ——
// 分开写是为了让每一套自己说清楚自己在干什么。

// 浮动系：顺位上下各让 N 位，中间的都算。返回 0 表示不是这一系的
export function floatSpanOf(key : string) : number {
  if (key == S_LUCKY) {
    return 1
  }
  if (key == S_BLESSED) {
    return 2
  }
  return 0
}

// 顺延系：还能按后面某一段顺位算。返回 [起, 止]，[0, 0] 表示不是这一系的。
//
// 两张各占一段、互不覆盖，也不被福星的 ±2 吃掉：放线够 +2~+3、长线够 +3~+5。
// 早先放线是 +1~+2，那一整段都在福星的 ±2 里面，同为史诗却严格更弱 ——
// 错在按「够几位」分档，而不是按「够到哪一段」分
export function driftRangeOf(key : string) : number[] {
  if (key == S_LINE) {
    return [2, 3]
  }
  if (key == S_LONGLINE) {
    return [3, 5]
  }
  return [0, 0]
}

// 单点跳位：只多出一个候选，中间的位跳过去。返回 0 表示这张贴纸不跳。
// 游动往回退一位、跳钩往前跳两位 —— 一反一正，都不跟幸运的 ±1 重合。
// 早先游动是 +1，那正好是幸运 ±1 的子集，稀有的反而弱于普通的
export function jumpOffsetOf(key : string) : number {
  if (key == S_DRIFT) {
    return -1
  }
  if (key == S_HOOK) {
    return 2
  }
  return 0
}

// 对称系：拿一个数当轴，把点数翻到对面去。返回那个「和」，0 表示不翻。
// 倒影的和是 22（轴在 11）：10↔12、9↔13、8↔A、7↔2、6↔3、5↔4
export function reflectSumOf(key : string) : number {
  return key == S_SHADOW ? 22 : 0
}

// 孤数：把点数整个改写成一个定值，牌面是几都不算数。返回 -1 表示不改写。
// 挑 11 是因为 J 从不落堆 —— 打出就通吃走了，所以 11 是牌堆里天然的空缺
export function fixedValueOf(key : string) : number {
  if (key == S_STAKE) {
    return 11
  }
  // 卸力：一律按 0 算。返回 0 而不是 -1 —— -1 的意思是「不改写」，
  // 所以问它的地方一律判 >= 0，别写成 > 0
  if (key == S_SLACK) {
    return 0
  }
  return -1
}

// 坠子系加、提系减，都是「一定改」不是「可以改」。
//
// 稀有度按稀缺性排，不按单张强度排 —— 单看一张，+1 和 +6 差不多，
// 都只是把数字挪到别处。值钱的是大数：要把 4、5、6、7 全调到 10，
// 需要的正是 +6、+5、+4、+3，大坠子才是凑套的瓶颈。
// own 上限跟着卡住流派规模：史诗档一种只能有 2 张。
//
// 两头各有一个出口：坠子往上推出 13 成孤数，提系往下压到 0 成死数。
// 两边都排到 6：提系的大数比坠子挑牌 —— −6 只有 7 点以上的牌用着不归零，
// 但把 K、Q 拉到 7、6 这种低位正是它的活，小坠子够不着
export function flatBonusOf(key : string) : number {
  if (key == S_SINKER1) {
    return 1
  }
  if (key == S_SINKER2) {
    return 2
  }
  if (key == S_SINKER3) {
    return 3
  }
  if (key == S_SINKER4) {
    return 4
  }
  if (key == S_SINKER5) {
    return 5
  }
  if (key == S_SINKER6) {
    return 6
  }
  if (key == S_MINUS1) {
    return -1
  }
  if (key == S_MINUS2) {
    return -2
  }
  if (key == S_MINUS3) {
    return -3
  }
  if (key == S_MINUS4) {
    return -4
  }
  if (key == S_MINUS5) {
    return -5
  }
  if (key == S_MINUS6) {
    return -6
  }
  return 0
}

// 归深：这张牌还可以视为 11 点，不管它本来是几。
// 单开一个函数而不是塞进派生系那几个，是因为它不转圈也不按顺位推 ——
// 它是「沉到同一个深度」，把贴了它的牌全接进 11 这个私有钓点
export function anchorsDeep(key : string) : boolean {
  return key == S_ANCHOR
}

// 空钩：这张牌还可以视为 0 点，不管它本来是几。
// 跟归深同构，只是接的网络在另一头 —— 归深把牌接进 11，空钩把牌接进 0。
// 0 当不了钓点，所以它不增加钩面，增加的是「被自己人收走」的路：
// 续钩认 0 点，拾零、拾偶、撒网都收得走
export function baresHook(key : string) : boolean {
  return key == S_BARE
}

// 打出时直接放到牌堆最左侧（堆底），而不是压在堆顶。
// 放堆底就是「活得久」：只有撞中堆底那张才会把它带走，
// 所以那几张要持续生效的贴纸都走这条路 —— 空位类靠它把效果留在场上，
// 暗桩这种点数类靠它把 11 这个钓点钉在堆底，谁想收都得连整摞一块儿收
export function dropsAtBottom(key : string) : boolean {
  return key == S_GATE
    || key == S_BLEND
    || key == S_UNIFY
    || key == S_MIRROR
    || key == S_STAKE
    || key == S_NARROW
    || key == S_AGAIN
    || key == S_CALM
    || key == S_DEEP
}

// ---------- 分类 ----------

// 隐藏贴纸：货架上根本不露面，通关和成就也给不了，只能用随机兑换券抽到。
// 抽中的那一刻就解锁了，之后它会出现在货架上，可以拿普通兑换券正常兑换
export function isHiddenSticker(key : string) : boolean {
  return key == S_LUCKY
}

// 开局就能兑换、不需要解锁的贴纸。
// 随机券的抽池是「已解锁的 + 隐藏的」，没有这几张，新存档的普通随机券
// 就只能抽到幸运一张，跟直接白送没区别
export function isFreeSticker(key : string) : boolean {
  return key == S_SINKER1 || key == S_SINKER2 || key == S_PEEK
}

// 点数类：牌在堆上就一直生效，改的是「这张牌算几点」。
// 判断直接问那六个派生函数，加新的点数贴纸时只要在对应函数里登记一下，
// 这里不用跟着改。提系和游动会返回负数，那两处不能写 > 0
export function isLastingSticker(key : string) : boolean {
  return floatSpanOf(key) > 0
    || driftRangeOf(key)[1] > 0
    || jumpOffsetOf(key) != 0
    || reflectSumOf(key) > 0
    || flatBonusOf(key) != 0
    || fixedValueOf(key) >= 0
    || anchorsDeep(key)
    || baresHook(key)
}

// 空手能从牌库里捞出来的牌。
//
// 本来就是「空位类」这一条，但齐顶得算进来：它自己没有点数，
// 点数是落堆那一刻从牌堆借的，算半张空位牌 —— 只是它借完之后真能钩牌，
// 所以不能塞进 isBlankSticker（那条管的是「落堆没有数字」，
// 塞进去它就永远钩不上东西，效果整个作废）。
// 两件事在这儿分开：一个管落堆算几点，一个管能不能被检索
export function isFetchable(key : string) : boolean {
  return isBlankSticker(key) || key == S_PEAK
}

// 空位类：落进牌堆但没有数字，点数算 0
export function isBlankSticker(key : string) : boolean {
  return key == S_LURE
    || key == S_MIRROR
    || key == S_STREAK
    || key == S_CAST
    || key == S_MURKY
    || key == S_GATE
    || key == S_MASK
    || key == S_STIR
    || key == S_DIG
    || key == S_GATHER
    || key == S_HUE
    || key == S_BLEND
    || key == S_UNIFY
    || key == S_DYE
    || key == S_EVENS
    || key == S_PROBE3
    || key == S_NARROW
    || key == S_AGAIN
    || key == S_CALM
    || key == S_TROLL
    || key == S_VOLLEY
    || key == S_SIEVE
    || key == S_SHUT
    || key == S_DEEP
    || key == S_RISE
    || key == S_PROP
    || key == S_SURGE
    || key == S_GLEAN
    || key == S_DRY
    || key == S_SMEAR
}

// 立即类：打出的当下发动
export function isPlayEffect(key : string) : boolean {
  return key != S_NONE && !isLastingSticker(key) && !isBlankSticker(key)
}

// ---------- 成就 ----------
//
// 有些贴纸不靠通关拿，而是靠在对局里做出对应的事。先做到，再拥有。
//
// 定成就有两条硬规矩：
// 一是条件必须真能达成 —— 手牌恒为 5 张（多弃少补），所以「手上没牌」
//   这种条件在一局里根本不会出现；
// 二是不能拿这张贴纸自己的效果当解锁条件，否则永远解不开。

export type Achievement = {
  id : number
  name : string
  desc : string
  // 达成后解锁的贴纸
  sticker : string
}

export const ACH_TWIN_PAIR : number = 0
export const ACH_EXACT_GOAL : number = 1
export const ACH_DEALER_BUST : number = 2
export const ACH_BEHIND : number = 3
export const ACH_STAND_BROKEN : number = 4
export const ACH_FORESEE : number = 5
export const ACH_COMEBACK : number = 6
export const ACH_FLOW : number = 7

// 逆风翻盘要落后多少分才算数
export const BEHIND_GAP : number = 10
// 川流不息要一局摸满几张牌
export const FLOW_DRAWS : number = 10
// 一网打尽要一次钓走几张
export const BIG_TAKE : number = 6
// 盆满钵满要一局钓满几分。
// 一局进堆的牌总共只有 2 × 回合数（20 到 40 张），还得分给两家，
// 18 分意味着大头都让你捞走了 —— 低关卡局短，基本得去高关卡刷
export const RICH_SCORE : number = 18
// 滴水不漏：把庄家压在几分以内
export const CHOKE_SCORE : number = 5
// 连锅端：撞上堆底那张、把多大的堆整个钓空
export const DEEP_PILE : number = 5

