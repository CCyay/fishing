export const STICKER_COUNT : number = STICKERS.length
// 同一个数字只有 4 张牌，最多贴 4 种不同的贴纸
export const MAX_STICKERS_PER_RANK : number = 4

// key 查下标。贴纸矩阵按下标索引，但下标是 STICKERS 的顺序决定的，
// 删增贴纸会变；存档里存 key，读档时用这个查回来
export function indexOfKey(key : string) : number {
  for (let i = 0; i < STICKERS.length; i++) {
    if (STICKERS[i].key == key) {
      return i
    }
  }
  return -1
}

export function keyAtIndex(index : number) : string {
  if (index < 0 || index >= STICKERS.length) {
    return S_NONE
  }
  return STICKERS[index].key
}

export function stickerAt(key : string) : Sticker {
  for (let i = 0; i < STICKERS.length; i++) {
    if (STICKERS[i].key == key) {
      return STICKERS[i]
    }
  }
  return STICKERS[0]
}

export function rarityOfKey(key : string) : number {
  return stickerAt(key).rarity
}

// 幸运贴纸：开局白送的专属贴纸，商店不卖，庄家也不会有
export function isStarterSticker(key : string) : boolean {
  return key == S_LUCKY
}

// 永续类：牌在场上就一直生效，不需要也不能主动发动
export function isLastingSticker(key : string) : boolean {
  return key == S_LUCKY
    || key == S_PILE
    || key == S_EBB
    || key == S_BLESSED
    || key == S_TWIN
    || key == S_BROKEN
    || key == S_COMPARE
    || key == S_ODDS
    || key == S_EVENS
}

// 横置类：留着等时机横置发动
export function isTapSticker(key : string) : boolean {
  return key == S_REFLECT
    || key == S_STANDBY
    || key == S_BOOST
    || key == S_CROUCH
    || key == S_MIMIC
    || key == S_INSIGHT
    || key == S_AMBUSH
    || key == S_PURGE
    || key == S_GNAW
    || key == S_CALAMITY
    || key == S_PURGEHAND
}

// 立即类：打出的当下发动
export function isPlayEffect(key : string) : boolean {
  return key != S_NONE && !isLastingSticker(key) && !isTapSticker(key)
}

// 这张贴纸有没有可以横置发动的效果
export function hasTapEffect(key : string) : boolean {
  return isTapSticker(key)
}

// 横置版贴纸的效果跟哪张立即类是同一套，归一到那张去实现，
// 免得同一个效果写两遍。洞察虽然也是看牌库，但张数不同，单独处理
export function baseEffectOf(key : string) : string {
  if (key == S_CROUCH) {
    return S_RUTHLESS
  }
  if (key == S_MIMIC) {
    return S_BUTTERFLY
  }
  if (key == S_RANSACK || key == S_AMBUSH) {
    return S_STEAL
  }
  if (key == S_GNAW) {
    return S_ERODE
  }
  return key
}

// 同一个效果动几张牌。这是拉开档次的第一个元素
export function countOf(key : string) : number {
  if (key == S_RANSACK || key == S_AMBUSH || key == S_GNAW) {
    return 2
  }
  return 1
}

// 这个效果有没有可能反过来咬自己一口。
// 只有这种才值得停下来问一句「发不发动」——
// 窥探、垫脚这类永远该发动的，问了等于白按一下，
// 牌组里贴纸密度越高，这种无意义的确认就越拖节奏
export function hasDownside(key : string) : boolean {
  const base = baseEffectOf(key)
  return base == S_GIVE
    || base == S_PURGE
    || base == S_PURGEHAND
    || base == S_SWITCH
    || base == S_CALAMITY
    || base == S_SAME
    // 狠心一旦发动就必须弃掉自己一张牌，没有弃 0 张这个选项 ——
    // 实在没有该弃的，不发动才是对的
    || base == S_RUTHLESS
    // 借刀替庄家出牌，那张牌上要是有他的贴纸，等于你亲手帮他发动
    || base == S_BORROW
    // 移植一发动就得弃掉一张手牌，手上没贴纸牌的话纯亏
    || base == S_GRAFT
    // 吞并加上来的点数是硬加的，眼看要爆的时候可不想吃
    || base == S_DEVOUR
    // 燃尽类发动完牌就烧了，那点数你就拿不到了 —— 要点数还是要效果，
    // 每次打出都得当场选一次，所以一律问
    || isBurnSticker(base)
}

// 代价具体在哪。打出时连着问句一起说清楚，省得每张都得记
export function downsideText(key : string) : string {
  const base = baseEffectOf(key)
  if (isBurnSticker(base)) {
    return '发动完这张牌就烧掉，它的点数不算数'
  }
  if (base == S_BORROW) {
    return '替庄家出的那张牌上，他的贴纸会由他发动'
  }
  if (base == S_GIVE) {
    return '的点数会记到庄家名下'
  }
  if (base == S_RUTHLESS) {
    return '一发动就得弃掉自己一张牌'
  }
  if (base == S_GRAFT) {
    return '要弃掉一张手牌换它的贴纸'
  }
  if (base == S_DEVOUR) {
    return '要弃掉一张手牌换它的点数，吃多了会爆'
  }
  return '会连自己的牌一起算上'
}

// 燃尽类：效果发动完这张牌自己进弃牌堆，不留在桌上，也就不贡献点数。
// 横置类没法燃尽 —— 横置要求牌待在桌上，所以这两类互斥
export function isBurnSticker(key : string) : boolean {
  return key == S_SHUNT || key == S_MARTYR || key == S_RECALL || key == S_MORPH
}

// 移植能搬的贴纸：那张手牌得真有贴纸，而且不能是移植自己 ——
// 搬过来还是一张移植，没完没了
export function isGraftable(key : string) : boolean {
  return key != S_NONE && baseEffectOf(key) != S_GRAFT
}

// 夺取能搬的：对面那张得真有贴纸。夺取自己排除掉 ——
// 搬过来当场又发动一次夺取，选牌阶段会套在一起，不值得为这点花样开这个口子
export function isSeizable(key : string) : boolean {
  const base = baseEffectOf(key)
  return key != S_NONE && base != S_GRAFT && base != S_SEIZE
}

// 回响、返照能挑的只有立即类 —— 永续类没有「发动」这个时刻，
// 横置类归鼓舞管。挑到回响自己会套娃，一并排除
export function isEchoable(key : string) : boolean {
  if (!isPlayEffect(key)) {
    return false
  }
  const base = baseEffectOf(key)
  return base != S_ECHO && base != S_REFLECT
}

// 盗窃、借刀要庄家手上有牌才动得了
export function needsOpponentHand(key : string) : boolean {
  const base = baseEffectOf(key)
  return base == S_STEAL || base == S_BORROW
}

// 下面几个只用来提示「这次发动大概率白费」，不阻止你发动 ——
// 立即类可以选择不发动，要不要浪费由你自己决定

export function needsOpponentBoard(key : string) : boolean {
  const base = baseEffectOf(key)
  return base == S_BEG || base == S_ERODE
}

// 这几张是对自己桌上左边那张牌动手，左边没牌就白费
export function needsLeftCard(key : string) : boolean {
  const base = baseEffectOf(key)
  return base == S_BUTTERFLY || base == S_REGRET || base == S_COLLAPSE
}

// 置换要手上有牌才换得动
export function needsOwnHand(key : string) : boolean {
  return baseEffectOf(key) == S_SWAP
}

// 换位系换的永远是「这张贴纸牌本身」和另一张，区别在于另一张能从哪挑：
// 只能挑自己桌上的 / 只能挑庄家桌上的
export function swapScopeOf(key : string) : number {
  return key == S_SWAPSIDE ? SCOPE_CROSS : SCOPE_OWN
}

export function isSwapSticker(key : string) : boolean {
  return key == S_SWAPSIDE
}

// 门槛系：拿点数或奇偶当尺子，把桌上过线的牌扫掉
export function isCullSticker(key : string) : boolean {
  return key == S_CULL
    || key == S_SAME
    || key == S_BEHEAD
    || key == S_CALAMITY
    || isParityCull(key)
}

// 拿奇偶当尺子的那几张，问的是「扫奇还是扫偶」而不是「扫大还是扫小」
export function isParityCull(key : string) : boolean {
  return key == S_SIFT || key == S_WEED || key == S_BIAS
}

// 除了「同点」要你挑一张牌当尺子，其余扫场的都在发动时问一句扫哪边
export function cullAsksDirection(key : string) : boolean {
  return key != S_SAME
}

// 同点的尺子不是它自己的点数，而是你当场挑的那张牌 ——
// 写死成「跟自己同点」的话，贴在 10/J/Q/K 上才有用，贴别处就是废牌
export function cullPicksTarget(key : string) : boolean {
  return key == S_SAME
}

export function cullModeOf(key : string) : number {
  if (key == S_SAME) {
    return CULL_EQUAL
  }
  return isParityCull(key) ? CULL_ODD : CULL_BIGGER
}

// 门槛系扫谁的桌子
export function cullScopeOf(key : string) : number {
  if (key == S_BEHEAD || key == S_WEED || key == S_BIAS) {
    return SCOPE_CROSS
  }
  if (key == S_CALAMITY || key == S_SAME) {
    return SCOPE_ANY
  }
  return SCOPE_OWN
}

// 偏科不是弃牌，是把扫中的牌翻负
export function cullFlipsInstead(key : string) : boolean {
  return key == S_BIAS
}

// 扫手牌的那两张
export function isFriskSticker(key : string) : boolean {
  return key == S_FRISK || key == S_PURGEHAND
}

// 搜身只翻庄家的手牌，肃清连自己的一起翻
export function friskScopeOf(key : string) : number {
  return key == S_PURGEHAND ? SCOPE_ANY : SCOPE_CROSS
}

// ---------- 成就 ----------
//
// 有些贴纸不靠通关拿，而是靠在对局里做出对应的事。
// 挑选原则：成就本身就是那张贴纸在做的事 —— 你亲手凑出过两张同点数并排，
// 才会解锁把牌变成同点数的「蝴蝶」。先做到，再拥有。
//
// 定成就有两条硬规矩：
// 一是条件必须真能达成 —— 手牌恒为 3 张（多弃少补），所以「手上没牌」「牌库见底」
//   这种条件在一局里根本不会出现；
// 二是不能拿这张贴纸自己的效果当解锁条件，否则永远解不开。

export type Achievement = {
  id : number
  name : string
  desc : string
  // 达成后解锁的贴纸
  sticker : string
}

export const ACH_TWIN_PAIR : number = 0
export const ACH_EXACT_GOAL : number = 1
export const ACH_DEALER_BUST : number = 2
export const ACH_BEHIND : number = 3
export const ACH_STAND_BROKEN : number = 4
export const ACH_FORESEE : number = 5
export const ACH_COMEBACK : number = 6
export const ACH_FLOW : number = 7

// 逆风翻盘要落后多少点才算数
export const BEHIND_GAP : number = 15
// 川流不息要一局摸满几张牌
export const FLOW_DRAWS : number = 10

export const ACHIEVEMENTS : Achievement[] = [
  {
    id: 0,
    name: '一模一样',
    desc: '让自己桌上相邻的两张牌点数相同',
    sticker: 'butterfly'
  },
  {
    id: 1,
    name: '分毫不差',
    desc: '正好凑到 42 点获胜',
    sticker: 'twin'
  },
  {
    id: 2,
    name: '请君入瓮',
    desc: '把庄家逼爆一次',
    sticker: 'give'
  },
  {
    id: 3,
    name: '逆风翻盘',
    desc: '一度落后 15 点以上，最后还是赢了',
    sticker: 'broken'
  },
  {
    id: 4,
    name: '功亏一篑',
    desc: '把已经停牌的庄家拽回牌桌',
    sticker: 'beg'
  },
  {
    id: 5,
    name: '未卜先知',
    desc: '用窥探把一张牌压到牌库底',
    sticker: 'insight'
  },
  {
    id: 6,
    name: '起死回生',
    desc: '在结算前的最后机会里翻盘成功',
    sticker: 'cheer'
  },
  {
    id: 7,
    name: '川流不息',
    desc: '一局之内从牌库摸满 10 张牌',
    sticker: 'swap'
  }
]

export const ACHIEVEMENT_COUNT : number = ACHIEVEMENTS.length

export function achievementAt(id : number) : Achievement {
  for (let i = 0; i < ACHIEVEMENTS.length; i++) {
    if (ACHIEVEMENTS[i].id == id) {
      return ACHIEVEMENTS[i]
    }
  }
  return ACHIEVEMENTS[0]
}
