<template>
  <view class="page">
    <!-- 状态栏占位：原生导航栏去掉了，见 App.uvue 的 .bj-status-bar -->
    <view class="bj-status-bar"></view>
    <!-- 顶栏：双方积分 + 牌库 / 牌堆各剩几张。积分就是收走的牌数。
         三样数并在这一行，所以下面那两块的标题（「庄家手牌 N 张」、
         「牌堆 N 张」）都去掉了 —— 牌都摆在那儿，标题只是重复一遍 -->
    <!-- 关卡条：第几关（终局报难度）+ 生命。生命只在闯关里有 -->
    <view class="level-bar">
      <text id="ap-level" class="level-text">{{ levelTitle }}</text>
      <text v-if="livesText != ''" id="ap-lives" class="lives-text">{{ livesText }}</text>
    </view>
    <view class="score-bar">
      <view class="score-cell">
        <text class="score-label">你</text>
        <text id="ap-my-score" class="score-num" :class="{ 'score-flash': flashMe }">{{ myScore }}</text>
      </view>
      <!-- 中间那格点得动：点开看「外面还剩哪些牌」（见 outsideRows）。
           库和堆两个数挨着放 —— 它们是同一件事的两头：还没摸的、已经摆出来的 -->
      <view id="ap-deck-cell" class="score-cell" @click="showLeft = true">
        <text class="score-label">库 / 堆</text>
        <text class="score-num score-num-dim"
          ><text id="ap-deck-count">{{ deck.length }}</text> / {{ pile.length }}</text
        >
      </view>
      <view class="score-cell">
        <text class="score-label">庄家</text>
        <text id="ap-foe-score" class="score-num" :class="{ 'score-flash': flashFoe }">{{ foeScore }}</text>
      </view>
    </view>

    <!-- 庄家侧：技能一行 + 手牌一行。
         平时只给看牌背；被窥视翻开的那几张明着摆。
         「庄家手牌 N 张」那个标题去掉了 —— 牌就摆在下面，数得出来 -->
    <view class="foe-area">
      <!-- 庄家带的技能，横着摆一排，点一下在说明框里看效果。
           摆出来是有意的 —— 难度该看得见，藏着的话「我怎么突然钓不到了」
           就成了坑人。**那件常驻的（角色带的）接在同一行末尾**：
           两样都是「它带着什么」，分两行反而要扫两眼 -->
      <view class="rule-row">
        <text class="rule-side">庄</text>
        <!-- **特殊技排第一个** —— 它是常驻的（「这一局它是谁」），
             而后面那几个点数技能要打出对应的牌才响。
             先看身份、再看触发条件，这个顺序才顺 -->
        <text
          v-if="foeRoleName != ''"
          id="ap-foe-role"
          class="rule-tag rule-tag-role"
          :class="{ 'rule-tag-on': chipAt == 301 }"
          @click="showRole(true)"
          >{{ foeRoleName }}</text
        >
        <text
          v-for="(chip, ci) in foeChips"
          :key="'fc-' + ci"
          :id="'ap-foe-skill-' + ci"
          class="rule-tag"
          :class="{ 'rule-tag-on': chipAt == 100 + ci }"
          @click="showChip(true, ci)"
          >{{ chip.cover }} {{ chip.name }}</text
        >
        <text v-if="foeChips.length == 0 && foeRoleName == ''" class="rule-none">无技能</text>
      </view>
      <!-- 点它那排有两种意思，看在等哪件技能：
             冻结 —— 「锁这一张」。那几张多半盖着，所以你挑的是**位置**；
             压舱 / 摘钩 / 对换 —— 「挑这一张」。这三件把它的手牌全翻开
             （见 foeOpen 里认 takeSkill 那条），所以你是看着挑的 -->
      <view class="foe-row">
        <view
          v-for="(card, index) in foeHand"
          :key="'fh-' + index"
          :id="'ap-foe-hand-' + index"
          class="card card-small"
          :class="{
            'card-back': !foeOpen(index),
            'card-frozen': isFrozen(card),
            'card-dead': isDead(card),
            'card-pickable': canPickFoe(index)
          }"
          @click="onFoeCard(index)">
          <view v-if="!foeOpen(index)" class="card-back-art card-back-art-small">
            <view class="card-back-gem card-back-gem-small"></view>
          </view>
          <text v-if="foeOpen(index)" class="card-rank card-rank-small" :class="{ 'card-red': isRed(card) }">{{ rankFace(card.rank) }}</text>
          <text v-if="foeOpen(index)" class="card-suit" :class="{ 'card-red': isRed(card) }">{{ card.suit }}</text>
          <text v-if="isFrozen(card)" class="card-frozen-tag">冻</text>
          <!-- 【死水】废掉的标出来。不标的话那张牌看着跟别的一样，
               而它打出来什么也不发生 —— 那就是规则坏了的感觉 -->
          <text v-else-if="isDead(card)" class="card-dead-tag">废</text>
        </view>
      </view>
    </view>

    <!-- 牌堆：从左往右是落下的先后，满一行换行。被护着的描蓝边。
         张数在顶栏（库 / 堆），所以这儿不要标题 ——
         牌堆是这一页最该占地方的东西，标题只会挤它 -->
    <view class="pile-area">
      <scroll-view class="board sv-out">
        <view class="board-row">
          <text v-if="pile.length == 0" class="dim-tip">空堆</text>
          <!-- 【凝水】/【净水】等着的时候，这一排点得动（`card-pickable` 描边）。
               **这是唯一会点堆上的牌的地方** —— 别的挑牌都是挑手牌 -->
          <view
            v-for="(card, index) in pile"
            :key="'pl-' + index"
            :id="'ap-pile-' + index"
            class="card card-in-pile"
            :class="{
              'card-from-foe': pileByFoe[index],
              'card-from-me': !pileByFoe[index],
              'card-guarded': pileGuard[index] != GUARD_NONE,
              'card-warded': wardAt(index),
              'card-burning': pileBurnAt(index) > 0,
              'card-wild': isWildAt(index),
              'card-murked': murked(index),
              'card-pickable': canPickAt(index),
              'card-caught': catching && inCatch(index),
              'card-flying': flyOn && inCatch(index)
            }"
            @click="onPilePick(index)">
            <!-- 点数和花色写的都是它**现在**算什么，不是牌面 ——
                 点数会被顺色抹掉、被见底压下去；花色会被染水整堆改掉。
                 两样跟牌面对不上的都描色（染水改过的花色描同一个色：
                 「这张不按它印着的那个花色算」是一回事） -->
            <!-- 【浊水】藏住的那几格：点数印问号、花色留空，
                 连「红还是黑」都不描（描了就等于报出花色） -->
            <text
              class="card-rank"
              :class="{
                'card-red': pileRed(index) && !murked(index),
                'card-shifted': pileShifted(index) && !murked(index)
              }"
              >{{ murked(index) ? '?' : pileFace(index) }}</text
            >
            <text
              class="card-suit"
              :class="{
                'card-red': pileRed(index) && !murked(index),
                'card-shifted': pileRecolored(index) && !murked(index)
              }"
              >{{ murked(index) ? '' : pileSuitAt(index) }}</text
            >
            <!-- 这张牌上挂着的场上效果，名字直接印在牌上。
                 从前只在下面那条 field-bar 里报「♠3 照水」，得拿着牌面
                 去堆里找哪张是 ♠3 —— 而堆能有四十来张、还会换行。
                 印在牌上就不用对照了：**要破它就得钓走这一张**，
                 所以「是哪一张」是这件事的全部要点 -->
            <text v-if="pileEffectName(index) != '' && !murked(index)" class="card-effect">{{ pileEffectName(index) }}</text>
            <!-- 【燃烧】：这张已经着了，下一次野火就把它收走。
                 **非标不可** —— 不标的话「哪几张烧得掉」只能靠记，
                 而那正是野火的全部决策（要不要再打一次野火） -->
            <text v-if="pileBurnAt(index) > 0 && !murked(index)" class="card-burn-tag">烧</text>
            <!-- 【结冰】：这一格被收走时不走也不计分。
                 **非标不可** —— 不标的话「这一段收起来值几分」玩家算不出来，
                 而那正是结冰的全部内容（照燃烧那个「烧」字的先例）。
                 冰和火互斥（相消），所以两个角标不会同时出现 -->
            <text v-if="frostAt(index) && !murked(index)" class="card-frost-tag">冰</text>
            <!-- ---------- 【叠放】：底下压着几张 ---------- -->
            <!--
              **分两个角标，因为它们是两条不同的信息**：

                盾（凝水垫的）—— 「它还能扛几次」。你要决定该不该去碰它。
                压着的（抬水垫的 / 净水埋的）—— 「收走这一叠值几分」。
                  你要决定该不该去抢它。

              合成一个「×3」就把这两件事糊在一起了 —— 而它们导向
              相反的行动（盾多了别碰，分多了快抢）。

              **非标不可**：叠放的牌在屏幕上压根看不见，不标的话
              「这一叠值几分、扛几次」全靠记，而那是叠放的全部决策
            -->
            <!-- 浊水藏住的格子连角标也不印 —— 「这一叠值几分、扛几次」
                 正是它该藏的那类信息 -->
            <text v-if="wardLayers(index) > 0 && !murked(index)" class="card-ward-tag"
              >盾{{ wardLayers(index) > 1 ? wardLayers(index) : '' }}</text
            >
            <text v-if="underCount(index) > 0 && !murked(index)" class="card-stack-tag"
              >+{{ underCount(index) }}</text
            >
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 场上效果：挂在牌上的那几件，**常驻摆到失效为止**。
         紧贴牌堆下方 —— 它说的就是牌堆的状态。
         点一下在说明框里看全文，外加「挂在哪张牌上、堆里第几张」
         （那是怎么破它：钓走那张，效果就解除）。
         **一件都没有就整行不占位** —— 原先这儿常驻一个「场上效果 · 无」，
         那是一行永远在那儿的废话 -->
    <view v-if="fieldChips.length > 0" class="field-bar">
      <scroll-view class="field-scroll" direction="horizontal">
        <view class="rule-row">
          <text
            v-for="(chip, fi) in fieldChips"
            :key="'fx-' + fi"
            :id="'ap-field-' + fi"
            class="rule-tag"
            :class="{ 'rule-tag-on': chipAt == 200 + fi, 'rule-tag-foe': chip.byFoe }"
            @click="showField(fi)"
            >{{ chip.byFoe ? '庄 ' : '' }}{{ chip.anchor }} {{ chip.name }}</text
          >
        </view>
      </scroll-view>
    </view>

    <!-- 择饵：摊开牌库顶五张，挑一张留在最上面。
         跟观潮同一个朝向（挑的是你回合末要补的），但它是精确挑选 ——
         所以这块得把牌面摆出来点，不能像观潮那样只给「沉/不沉」两颗钮 -->
    <view v-if="pickPending" class="pick-deck">
      <text class="tide-text">择饵：挑一张留在牌库顶（你回合末会补到它），其余沉底</text>
      <view class="pick-deck-row">
        <view
          v-for="(one, pi) in pickTops"
          :key="'pd-' + pi"
          :id="'ap-pick-' + pi"
          class="pick-deck-card"
          @click="onPickDeck(pi)">
          <text class="pick-deck-text" :class="{ 'card-red': isRed(one) }">{{ cardName(one) }}</text>
        </view>
      </view>
    </view>

    <!-- 分饵：点两下 —— **第一下给自己、第二下给对方**。
         标签用 `giftPicks` 的下标顺序算（0 = 给自己、1 = 给对方），
         所以它跟 onGiftCard 里那个「顺序就是语义」是同一份约定。
         点已选中的那张取消（照观潮那条交互） -->
    <view v-if="giftPending" class="pick-deck">
      <text class="tide-text">分饵：点两张 —— 第一张给自己、第二张给庄家，其余沉底（点中的再点一次取消）</text>
      <view class="pick-deck-row">
        <view
          v-for="(one, gi) in giftTops"
          :key="'gf-' + gi"
          :id="'ap-gift-' + gi"
          class="pick-deck-card"
          :class="{ 'tide-card-sunk': giftPicks.indexOf(gi) >= 0 }"
          @click="onGiftCard(gi)">
          <text class="pick-deck-text" :class="{ 'card-red': isRed(one) }">{{ cardName(one) }}</text>
          <text v-if="giftPicks.indexOf(gi) == 0" class="gift-tag">给自己</text>
          <text v-else-if="giftPicks.indexOf(gi) == 1" class="gift-tag">给庄家</text>
        </view>
      </view>
    </view>

    <!-- 观潮：你打出触发了它，看一眼牌库顶那两张，**每张单独**选沉不沉。
         那两张是**你自己**回合末要补的（回合末补牌之后朝向变了）。
         从前只有「两张一起沉 / 都不动」两颗钮 —— 一张想要、一张不想要的时候
         两头都不对。现在点一张标记「沉」，再点一次取消，最后按确定 -->
    <view v-if="tidePending" class="tide-box">
      <text class="tide-text">观潮：牌库顶这两张是你回合末要补的。点一张标记沉到库底，再点取消</text>
      <view class="pick-deck-row">
        <view
          v-for="(one, ti) in tideCards"
          :key="'td-' + ti"
          :id="'ap-tide-card-' + ti"
          class="pick-deck-card"
          :class="{ 'tide-card-sunk': ti < tideMarks.length && tideMarks[ti] }"
          @click="onTideCard(ti)">
          <text class="pick-deck-text" :class="{ 'card-red': isRed(one) }">{{ cardName(one) }}</text>
          <text v-if="ti < tideMarks.length && tideMarks[ti]" class="tide-card-mark">沉</text>
        </view>
      </view>
      <view class="tide-actions">
        <view id="ap-tide-ok" class="tide-btn" @click="onTideDone">
          <text class="tide-btn-text">{{ tideButton }}</text>
        </view>
      </view>
    </view>

    <!-- 换水：挑一张手牌塞回牌库洗掉。
         挑的动作借手牌那一排 —— 点一张就是挑它，不用另搭一块 UI -->
    <view v-if="swapPending" class="tide-box">
      <text class="tide-text">换水：点一张手牌，塞回牌库洗掉（回合末会补新的）</text>
      <view class="tide-actions">
        <view id="ap-swap-skip" class="tide-btn tide-btn-plain" @click="onSwap(-1)">
          <text class="tide-btn-text tide-btn-text-plain">不换</text>
        </view>
      </view>
    </view>

    <!-- 连竿：加打是**可选的**。要打就直接点手牌（canPlay 故意没把它
         排除掉），不打就按这颗钮 —— 技能说明里那个「可」字从此是真的。
         强制加打量出来 D=+3.31，撞破了基线优势 3.03：后手带它比不带更差。

         ⚠ **这一块现在玩家看不到**〔2026-10-16 查明〕：连竿 10-14 删了，
         而 `againWaiting` 只在 passTurn 的非庄家分支里立 —— 可
         `againPending` 只剩【再钩】一个来源，那儿带着 `byFoe &&`。
         详见 afterPlay 里 `SK_AGAIN` 那一支上面那段。
         留着是因为它是「玩家侧加打」唯一的落点；**但它是死的，别照它推断
         玩家现在能做什么** -->
    <view v-if="againWaiting" class="tide-box">
      <text class="tide-text">连竿：可以再打一张（点手牌出牌），也可以收手留着下回合</text>
      <view class="tide-actions">
        <view id="ap-again-skip" class="tide-btn tide-btn-plain" @click="onAgainSkip">
          <text class="tide-btn-text tide-btn-text-plain">收手</text>
        </view>
      </view>
    </view>

    <!-- 凝水 / 净水：挑**堆上**一张。两件共用这一块，提示语按技能换。
         不挑也行 —— 牌已经丢弃了，所以「不挑」就是白丢一张
         （跟开包「放弃」一个道理：代价已经付了） -->
    <view v-if="pilePick >= 0" class="tide-box">
      <text class="tide-text">{{ pilePickText }}</text>
      <view class="tide-actions">
        <view id="ap-pile-skip" class="tide-btn tide-btn-plain" @click="onPilePick(-1)">
          <text class="tide-btn-text tide-btn-text-plain">不挑</text>
        </view>
      </view>
    </view>

    <!-- 冻结：挑庄家一张手牌锁住。借它那排点 —— 盖着的也点得中，
         你挑的是位置不是牌面 -->
    <view v-if="freezePending" class="tide-box">
      <text class="tide-text">冻结：点庄家一张手牌锁住它（盖着的也点得中）</text>
      <view class="tide-actions">
        <view id="ap-freeze-skip" class="tide-btn tide-btn-plain" @click="onFreeze(-1)">
          <text class="tide-btn-text tide-btn-text-plain">不冻</text>
        </view>
      </view>
    </view>

    <!-- 【薪潮】盲选：点庄家一张手牌贴【推牌】。**借冻结那一排，不翻开** ——
         所以提示语里要说清「盖着的也点得中」和「你看不见贴的是什么」，
         那正是这件技能的内容（一次下注，不是精准打击）。

         实测盲选跟看着挑差 0.02 分 —— 翻开手牌在这件技能上值 0，
         所以「不翻开」是白赚的设计空间，不是省事 -->
    <view v-if="fuelPending" class="tide-box">
      <text class="tide-text">薪潮：点庄家一张手牌贴上推牌（盖着的也点得中 · 你看不见是哪张）</text>
      <view class="tide-actions">
        <view id="ap-fuel-skip" class="tide-btn tide-btn-plain" @click="onFuel(-1)">
          <text class="tide-btn-text tide-btn-text-plain">不贴</text>
        </view>
      </view>
    </view>

    <!-- 压舱 / 摘钩 / 对换：挑庄家一张手牌。三件共用这一块，
         提示语按技能换 —— 它那排这会儿**全是明的**（见 foeOpen） -->
    <view v-if="takeSkill >= 0" class="tide-box">
      <text class="tide-text">{{ takeText }}</text>
      <view class="tide-actions">
        <view id="ap-take-skip" class="tide-btn tide-btn-plain" @click="onTakeFrom(-1)">
          <text class="tide-btn-text tide-btn-text-plain">放过</text>
        </view>
      </view>
    </view>

    <!-- 对换第二步：挑一张自己的还给庄家。借手牌那一排（照换水） -->
    <view v-if="giveBack >= 0" class="tide-box">
      <text class="tide-text">对换：点一张自己的手牌还给庄家</text>
      <view class="tide-actions">
        <view id="ap-give-skip" class="tide-btn tide-btn-plain" @click="onGiveBack(-1)">
          <text class="tide-btn-text tide-btn-text-plain">不还（白拿一张）</text>
        </view>
      </view>
    </view>

    <!-- 同号：摊开牌库里那几张同点数的（最多 3 张），挑一张。
         照择饵那块的样式 —— 都是「摆出牌面让你点」 -->
    <view v-if="twinPending" class="pick-deck">
      <text class="tide-text">同号：牌库里还有这 {{ twinCards.length }} 张同点数的，挑一张拿到手上</text>
      <view class="pick-deck-row">
        <view
          v-for="(one, ti) in twinCards"
          :key="'tw-' + ti"
          :id="'ap-twin-' + ti"
          class="pick-deck-card"
          @click="onTwin(ti)">
          <text class="pick-deck-text" :class="{ 'card-red': isRed(one) }">{{ cardName(one) }}</text>
        </view>
      </view>
      <view class="tide-actions">
        <view id="ap-twin-skip" class="tide-btn tide-btn-plain" @click="onTwin(-1)">
          <text class="tide-btn-text tide-btn-text-plain">不要</text>
        </view>
      </view>
    </view>

    <!-- ---------- 状态行：回合 + 播报合成一条 ---------- -->
    <!--
      原先这儿是两块：上面一个 message-box（刚发生了什么），
      下面一个 turn-bar（现在该谁）。两块说的是同一件事的两头，
      而且一直占着两行。合成一条之后：**粗体那半是「现在该干什么」，
      后面接刚发生的事**。

      id 留着 ap-turn（e2e 在断言它包含「你的回合」）
    -->
    <!-- 技能说明：点了技能标签才出现，占自己的一块。
         左边一条竖线分色（你的金、庄家的橙），头一行写「谁的 · 管什么 ·
         叫什么 · 几级」，正文是效果本身。点同一个标签再收起 -->
    <view v-if="chipHead != ''" class="chip-desc" :class="{ 'chip-desc-foe': chipAt >= 100 && chipAt < 200 || chipAt == 301 }" @click="closeChip">
      <text class="chip-desc-head">{{ chipHead }}</text>
      <text class="chip-desc-body">{{ chipBody }}</text>
    </view>

    <view class="turn-bar">
      <text id="ap-turn" class="turn-label">{{ turnText }}</text>
      <text v-if="message != ''" class="turn-msg">{{ message }}</text>
    </view>

    <!-- 你这侧：技能一行（跟庄家那侧同一个格式）。
         「技能」那个标签字去掉了 —— 左边那个「你」字就够了，
         而且庄家侧是「庄」，两边对称。
         那件常驻的（角色带的）接在同一行末尾，描一个不同的色 -->
    <view class="rule-row">
      <text class="rule-side">你</text>
      <!-- 特殊技排第一个，跟庄家那侧同一个顺序（理由见那边） -->
      <text
        v-if="myRoleName != ''"
        id="ap-my-role"
        class="rule-tag rule-tag-role"
        :class="{ 'rule-tag-on': chipAt == 300 }"
        @click="showRole(false)"
        >{{ myRoleName }}</text
      >
      <text
        v-for="(chip, ci) in myChips"
        :key="'mc-' + ci"
        :id="'ap-skill-' + ci"
        class="rule-tag"
        :class="{ 'rule-tag-on': chipAt == ci }"
        @click="showChip(false, ci)"
        >{{ chip.cover }} {{ chip.name }}</text
      >
      <text v-if="myChips.length == 0 && myRoleName == ''" class="rule-none">无技能</text>
    </view>

    <!-- 【活水】：牌库顶那两张一直明着。
         摆在手牌**正上方** —— 回合末补牌补的就是它们，
         所以它其实是「你下一张手牌」，挨着手牌看才对得上。
         一局之内它会一直变（每补一次就往下走两张） -->
    <text v-if="liveText != ''" class="live-text">{{ liveText }}</text>

    <!-- 【逆流】的开关：角色带着它才出现。
         摆在手牌上方 —— 它改的是「这一张打下去落哪头」，
         所以得在你点手牌之前就看得见、按得着。
         按钮上写的是技能名**逆流**，不是「沉底」—— 沉底是点数槽里的另一件 -->
    <view v-if="hasSinkSpecial" class="sink-row" @click="sinkOn = !sinkOn">
      <text class="sink-btn" :class="{ 'sink-btn-on': sinkOn }">{{ sinkOn ? '逆流 · 开' : '逆流 · 关' }}</text>
      <text class="sink-note">{{ sinkOn ? '这一张会打到堆底，收「堆底 → 匹配那张」' : '照常落堆顶' }}</text>
    </view>

    <!-- 你的手牌：点一张打出。牌底下的小字是这张会触发的技能。
         「你的手牌 N 张 · 点一张打出」那个标题去掉了 ——
         牌就在眼前，而「点一张打出」是这一页唯一的操作，不用每局提醒 -->
    <view class="hand-area">
      <scroll-view class="hand-scroll" direction="horizontal">
        <view class="hand-row">
          <view
            v-for="(card, index) in hand"
            :key="'h-' + index"
            :id="'ap-hand-' + index"
            class="card card-hand"
            :class="{
              'card-hint': canPlay && canCatch(card, false),
              'card-new': index == newIndex,
              'card-frozen': isFrozen(card)
            }"
            @click="onPlay(index)">
            <text class="card-rank" :class="{ 'card-red': isRed(card) }">{{ rankFace(card.rank) }}</text>
            <text class="card-suit" :class="{ 'card-red': isRed(card) }">{{ card.suit }}</text>
            <!-- 点数卡贴上来的那几个点数。描成金的 ——
                 「这张还算 7 点」是打牌时必须看见的，牌面上写不出来 -->
            <text v-if="pipTag(card) != ''" class="card-pip">{{ pipTag(card) }}</text>
            <text v-if="skillTag(card) != ''" class="card-skill">{{ skillTag(card) }}</text>
            <!-- ---------- 手里的【结冰】= **钥匙** ---------- -->
            <!--
              结冰在两个位置意思正好相反（见 TERMS 那条）：
                堆上 = 障碍（那一格收不走）；
                手里 = **钥匙**（用它打出去那一手，收牌无视结冰）。

              **非标不可**：「什么时候用钥匙」是【藏凌】【寒色】两件技能的
              全部决策内容，而钥匙贴在哪几张牌上玩家只能靠记 ——
              照【死水】（废掉的手牌要标）和【冻结】（锁住的要标）那两条先例。

              跟堆上那个角标**用同一个字、同一个色**，因为它是同一个标签
            -->
            <text v-if="frostOnHand(card)" class="card-frost-tag">冰</text>
        <!-- 【引火】预约的火。跟「冰」挤在同一个角 —— 两个同时挂上
             （引火 + 藏凌）的时候它们落堆就相消，所以玩家看到两个标签
             本身就是「这张落下去两个都没」的提示 -->
        <text v-if="burnOnHand(card)" class="hand-burn-tag">火</text>
            <!-- 【推牌】：庄家给你这张贴过标签，打出去会从牌库涌几张上堆。

                 **非标不可，而且要报数字** —— 它是全表唯一可叠加的标签，
                 所以「有没有」不够，得知道「几张」。而那个数正是你要算的：
                 涌上来的牌先给**庄家**当钩点（他下一手就对着它开火），
                 所以「什么时候打这张」是他塞给你的全部决策。

                 报的是**涌几张**不是层数 —— 玩家要的是后果，而乘法
                 （层数 × 2）写在 surgeTag 里，他不用自己乘 -->
            <text v-if="surgeTag(card) != ''" class="hand-surge-tag">{{ surgeTag(card) }}</text>
            <text v-if="isFrozen(card)" class="card-frozen-tag">冻</text>
            <text v-else-if="foeKnows(index)" class="card-seen">被看</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 退出。对局进行中一直摆着 —— 从前这一页只有结算框里那个出口，
         打到一半想走只能靠系统返回键，那在真机上不是每个人都找得到。
         结算框开着时不显示：那上头自带「返回关卡」-->
    <view v-if="!over" id="ap-quit" class="quit-btn" @click="goBack">
      <text class="quit-text">退出这一局</text>
    </view>

    <!-- 开局切牌：那张牌先停在中间给人看清，再飞向它该去的那一边。
         规则是**按红黑**定先后手，所以这一下必须看清花色的颜色 ——
         那也是底下那行字要带「红 →」「黑 →」的原因。

         它是**纯视觉层**：牌在 newGame 里早就发进手牌了，这儿盖的是副本
         （见 cutFly 的声明）。所以动画出问题也不影响对局。
         交互在动画期间由 canPlay 里那条 `cutPhase == 0` 锁住 -->
    <view v-if="cutPhase > 0" class="cut-layer">
      <view
        id="ap-cut-card"
        class="card cut-card"
        :class="{ 'cut-card-to-foe': cutPhase == 2 && cutToFoe, 'cut-card-to-me': cutPhase == 2 && !cutToFoe }">
        <!-- 牌面走 computed（cutFace / cutSuit / cutRed）而不是在模板里
             断言 `cutFly!` —— 那张牌是可空的，而模板里的非空断言
             在 uvue 的编译里不保险 -->
        <text class="card-rank cut-rank" :class="{ 'card-red': cutRed }">{{ cutFace }}</text>
        <text class="card-suit cut-suit" :class="{ 'card-red': cutRed }">{{ cutSuit }}</text>
      </view>
      <!-- 飞走那一段把字一起淡掉 —— 留着的话它会在半空中突然没了牌、
           只剩一行字，那比没动画更怪 -->
      <text class="cut-note" :class="{ 'cut-note-gone': cutPhase == 2 }">{{ cutLine }}</text>
    </view>

    <!-- 剩牌：点顶栏那个牌库数字打开。
         ---- 为什么报的是「外面还剩」而不是「牌库里剩」 ----

         你要的是「牌组剩余哪些牌」，但**单报牌库会把推理整个删掉**：
         这一轮的牌组构成你自己在商店里改的、所以是已知的，堆上那些看得见，
         被收走的也数得出来 —— 牌库一报，减一减就是**庄家的手牌**，
         精确到花色。那样【窥视】和【照水】两件技能当场作废。

         所以这儿把「牌库 + 庄家手牌」合成一栏报，正好等于庄家那边
         `outsideCount` 知道的东西 —— 它会记牌，你从前只能肉眼数，
         这一块是把那份信息**对称地给你**（设计文档『信息要给够』那条判据）。
         牌库和它手里的分不开，于是推不出它那四张是什么，
         可「我这张 7 外面还剩几张」这类问题全答得上。 -->
    <view v-if="showLeft" class="mask" @click="showLeft = false">
      <view class="left-box" @click.stop="noop">
        <view class="left-head">
          <text class="left-title">外面还剩</text>
          <text class="left-sub">牌库 {{ deck.length }} + 庄家手里 {{ foeHand.length }}</text>
        </view>
        <text class="left-note">庄家也是按这份账记牌的。它手里那几张混在里头 —— 分不出来是有意的。</text>
        <scroll-view class="left-body sv-out" direction="vertical">
          <view v-for="(row, ri) in outsideRows" :key="'lf-' + ri" class="left-row">
            <text class="left-rank" :class="{ 'left-rank-mine': row.mine }">{{ row.rank }}</text>
            <text class="left-num">{{ row.left }}</text>
            <text class="left-of">/ {{ row.total }}</text>
            <text class="left-bar" :class="{ 'left-bar-none': row.left == 0 }">{{ row.bar }}</text>
          </view>
        </scroll-view>
        <text class="left-legend">描亮的点数是你技能管着的</text>
        <text class="left-close" @click.stop="showLeft = false">收起来</text>
      </view>
    </view>

    <!-- 结算：牌库和双方手牌都空了才出现。
         照排竿：赢了往下一关走，输了整轮作废从第 1 关重来；平局重打这一关 -->
    <view v-if="over" class="mask">
      <view class="result-box">
        <text id="ap-result" class="result-title">{{ resultText }}</text>
        <text class="result-sub">你 {{ myScore }} : {{ foeScore }} 庄家</text>
        <text id="ap-reward" class="result-reward">{{ rewardText }}</text>
        <!-- 输了：一排红心，失去的那一颗放大、变灰、淡掉（见 loseHeart） -->
        <view v-if="heartMax > 0" id="ap-hearts" class="hearts">
          <text
            v-for="h in heartList"
            :key="'ht-' + h"
            :id="'ap-heart-' + h"
            class="heart"
            :class="{
              'heart-empty': h > heartBefore,
              'heart-lost': heartBroken && h == heartBefore
            }">♥</text>
        </view>
        <!-- 原先这儿有一行 skillText（「过关掉了什么技能」）。
             技能改成商店买了，结算不再发技能，这一行整条删掉 -->
        <!-- 赢了不再让你挑「下一关 / 去商店」：结算框亮一下就自己进商店，
             从商店回来直接开下一关。这个按钮只是等不及时点的 -->
        <view v-if="outcome == OUT_WIN" id="ap-shop" class="result-btn" @click="goShop">
          <text class="result-btn-text">去商店</text>
        </view>
        <!-- 输了**不能就地重开** —— 新一轮要先选一张角色卡，
             而那个入口在关卡页（见 draw-levels.uvue 的 go）。
             从前这颗钮直接调 newGame，于是重开那一轮 role 恒为 -1：
             没有角色、没有槽，商店里任何技能都买不动，整轮打不下去。
             OUT_NOROLE 那一档（这一局没开起来）走同一颗钮 —— 两处要的
             是同一件事：回关卡页选角色 -->
        <view
          v-if="outcome == OUT_LOSE || outcome == OUT_NOROLE"
          id="ap-restart"
          class="result-btn"
          @click="goBack">
          <text class="result-btn-text">回关卡选角色</text>
        </view>
        <!-- 输了还有生命：回上一个商店（第 1 关前面没有商店，就重打） -->
        <view v-if="outcome == OUT_RETRY && save.inShop" id="ap-retry-shop" class="result-btn" @click="goShop">
          <text class="result-btn-text">回到商店</text>
        </view>
        <view v-if="outcome == OUT_RETRY && !save.inShop" id="ap-retry" class="result-btn" @click="newGame">
          <text class="result-btn-text">重打这一关</text>
        </view>
        <view v-if="outcome == OUT_DRAW" id="ap-replay" class="result-btn" @click="newGame">
          <text class="result-btn-text">重打这一关</text>
        </view>
        <!-- 终局：赢了输了都只有「再来一局」—— 重摇两套新配装。
             没有「下一关」也没有「去商店」，它不在那条线上 -->
        <view v-if="outcome == OUT_FINAL" id="ap-again" class="result-btn" @click="newGame">
          <text class="result-btn-text">再摇一局</text>
        </view>
        <text id="ap-back" class="result-link" @click="goBack">返回关卡</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    SUITS,
    RANKS,
    isRedSuit
  } from '@/pages/examples/blackjack/cards.uts'
  import {
    DRAW_SKILLS,
    KEYWORD_FIRST,
    SKILL_RANKS,
    DrawLoadout,
    SK_HOOK,
    SK_TIDE,
    SK_PEEK,
    SK_SWAP,
    SK_SUITED,
    SK_LANTERN,
    SK_FREEZE,
    SK_LOWTIDE,
    SK_PICK,
    SK_SUITIFY,
    // `SK_SINK`（沉底）**留着** —— 技能 10-15 删了，可它有 4 处引用，
    // 而那几处是 sink **机制**的入口（【逆流】【偏流】【寒流】都在用）。
    // 清它要先把那条路从「沉底的参数」改成「落堆底的参数」，是独立一笔
    SK_SINK,
    SK_AGAIN,
    SK_DEEP,
    SK_PEAK,
    SK_HUE,
    SK_CAST,
    SK_PRESS,
    SK_UNHOOK,
    SK_SWAPCARD,
    SK_NARROW,
    SK_CREEL,
    SK_TWIN,
    // 〔2026-10-16 一共撤掉**十二个**已删技能的常量：
    //   `SK_FLOOD`（洪水）/ `SK_DUMP`（掏手）/ `SK_SPILL`（掏库）/
    //   `SK_EBB`（退潮）/ `SK_VOID`（压邻）/ `SK_HUEVOID`（封色）/
    //   `SK_ODD`（分水）/ `SK_SUITFIND`（同花的牌库搜索）/ `SK_MEASURE`（量水）/
    //   `SK_MERGE`（合流）/ `SK_DREDGE`（抄底）/ `SK_FROSTFALL`（霜降）——
    //   十二件的实现全清了（约 600 行），`draw-skills.uts` 那边的导出也跟着删了。
    //
    //   **剩下两个还留着，而且不能只看技能死没死**：
    //     `SK_SINK`  —— sink 机制的入口，【逆流】【偏流】【寒流】都在用；
    //     `SK_AGAIN` —— `againPending` 那套被庄家规矩【再钩】搭着用。
    //   这两条要先把机制和技能拆开（给机制起自己的名字），才动得了。
    //
    //   顺序永远是「先删函数、再撤 import」。反过来直接编译不过 ——
    //   这一季在 `DUMP_COUNT` 上栽过一次〕
    SK_DRAFT,
    SK_SOFT,
    // 「丢弃换一次精确操作」那一对。SK_CALM 顺带当保护标签的 skill 值
    SK_CALM,
    SK_CLEAN,
    SK_RAISE,
    SK_WILD,
    SK_DEAD,
    // 第四条匹配线：顺子。两件对付「11 那个洞」的办法不同 ——
    // 伏流当通配**填**洞（幅度跟槽标签无关），涉水用差 2 **跨**洞
    SK_FLOW,
    SK_WADE,
    SK_FROST,
    SK_HIDE,
    SK_COLDHUE,
    SK_CHAIN,
    SK_KINDLE,
    // 「推牌」机制那一件（2026-10-16）。`SURGE_PUSH` 是机制的常量
    //（每层推几张，固定 2），`SURGE_LAYERS` 是**引潮自己的**（一次贴几层）
    SK_SURGE,
    SURGE_PUSH,
    SURGE_LAYERS,
    // 【薪潮】：自带燃烧 + 盲选一张贴推牌。`FUEL_TAG` 钉死 1（见它那段）
    SK_FUEL,
    FUEL_TAG,
    // 【分饵】：看牌库顶 `GIFT_LOOK` 张，给自己和对手各 1 张（2026-10-16）
    SK_GIFT,
    GIFT_LOOK,
    // 【漫流】：【推牌】`BRIM_LAYERS` 层；【顺子匹配】（2026-10-16）
    SK_BRIM,
    BRIM_LAYERS,
    STRAIGHT_MIN,
    DEAD_COUNT,
    // 〔`DUMP_COUNT` / `SPILL_COUNT` / `EBB_COUNT` 三个 2026-10-16 全撤了 ——
    //   掏手 / 掏库 / 退潮 的实现（`dumpFor` / `spillFor` / `ebbFor`）
    //   这一轮一起清了，而那三个数**只有它们在读**。
    //
    //   **顺序是硬的：先删函数、再撤 import。** 反过来直接编译不过 ——
    //   这一轮先撤了 import 才发现 dumpFor 还在读它，差一步就犯了。
    //   常量本身也在同一天从 `draw-skills.uts` 删了（`DEAD_COUNT` 那条
    //   「拿手牌数的一半」留下了，它是这一族的通用标尺）〕
    // 【吃水】的上限和「至少吃到几张」
    DRAFT_CAP,
    DRAFT_MIN,
    emptyLoadout,
    triggersOf,
    hasTrigger,
    equippedSkills,
    coverageText,
    DrawKit,
    kitFromRole,
    rollRoleKit,
    // 原先这儿还引着 levelText 和 rollFullKit。等级没了（levelText）、
    // 「随机满配」换成摇角色卡了（rollFullKit → rollRoleKit）
    // 角色那件常驻特殊技能（见 specialLevel）
    DRAW_ROLES,
    SPECIAL_SKILLS,
    specialIndexOf,
    SP_CREEL,
    SP_NARROW,
    SP_CLEAR,
    SP_DEEPHOOK,
    SP_FIRMHOOK,
    SP_BEACH,
    // 【逆涌】（开河工）：对方打出 J 之后推牌 2 层。跟净滩是同一个问题的两半
    SP_JSURGE,
    JSURGE_LAYERS,
    SP_REVERSE,
    SP_LIVEWATER,
    SP_BAIT,
    SP_TWOCOLOR,
    SP_CYCLE,
    // 【归十】：你打出的 Q K 都算 10（见 valuesOf）
    SP_TENS,
    CYCLE_REFILL,
    BAIT_COUNT,
    baitRankOf
  } from '@/pages/examples/blackjack/draw-skills.uts'
  import {
    DrawLevel,
    MARGIN_BONUS_CAP,
    interestOf,
    drawLevelById,
    levelForDiff,
    maxLivesOf,
    // 终局也分难度了（见 finalLevel / rollRoleKit）
    DIFF_EASY,
    DIFF_NORMAL,
    DIFF_HARD,
    // 牌组上限。【囤饵】往牌库塞牌之前要兜一道
    DECK_CAP,
    // 〔DECK_PLAY 2026-10-15 删了 —— 「一局只进场 52 张」那道上限没了，
    //   现在开局只剔 0~1 张凑牌库的奇偶，见 trimDeck〕
    // 闯关的庄家角色：名字 + 那几条庄家专属特殊技（按关号查，见 foeAt）
    foeRoleAt,
    foeRoleHas,
    foeSpecialNameAt,
    foeSpecialDescAt,
    // 三条规矩里写死的那几个数（desc 里也印着同样的数字）
    REV_TOPS,
    MURK_DEEP,
    MURK_SHOW,
    LEAK_DEEP
  } from '@/pages/examples/blackjack/draw-levels.uts'
  import {
    DrawSave,
    DRAW_RUN_LENGTH,
    emptyDrawSave,
    loadDrawSave,
    saveDraw,
    drawSaveSlot,
    difficultyOf,
    settleWin,
    resetDrawRun,
    settleLoss,
    ensureLives,
    ensureFoeKit,
    foeKitOf,
    // 【封竿】封的那个点数（庄家特殊技）
    foeSealRank,
    foeNumOf,
    // 没选角色就不开局（见 newGame 闯关分支开头那道闸）
    hasRole,
    deckOf,
    standardDeck,
    suitOfText,
    rankOfText,
    pipsOfText,
    faceOfValue,
    // 无点数牌（'♠-'）：cardVals 认它，界面上写「无」
    BLANK_RANK,
    rankFace,
    // 熔合出来的点数可以超过 13（'17'），读点数走它
    valueOfRankText
  } from '@/pages/examples/blackjack/draw-save.uts'

  // 摸打钓鱼：一副 52 张。
  // 每回合先从牌库摸 1 张（牌库空了就不摸），再打出 1 张明牌。
  // 打到堆上的牌如果和堆里某张同点数，就把那张、夹在中间的、连同刚打的这张一起收走，张数记作积分。
  // J 通吃：堆上有牌时打 J，整堆收走；空堆上打 J 就只是落在堆上。
  // 牌库和双方手牌都空了，比积分。
  //
  // 早先试过「每回合 2 行动点、摸牌和出牌各花 1 点」和「盖牌 + 花行动点翻牌」两版，
  // 都被模拟打出了必胜套路（囤牌不下饵、埋底收整堆），所以收成了最朴素的摸一打一：
  // 每回合唯一的决定就是打哪张 —— 能钓就钓，钓不到就挑一张最不容易被对方钓走的当饵。
  //
  // 技能（draw-skills.uts）：打出的牌落在某个技能管着的花色 / 点数上就触发。
  // 双方用同一套规则，庄家的技能由关卡给（draw-levels.uts）。没有技能直接改积分。
  //
  // 牌型单独定义一个最简的 —— cards.uts 的 Card 带着贴纸那一整套字段，
  // 而且 buildDeck 会给 J 焊上「通吃」，这个玩法不要这些
  type PlainCard = {
    suit : string
    rank : string
    value : number
    // 商店的【点数卡】贴上来的**额外点数**。空的就是没贴过。
    //
    // 一张牌因此可以**同时算几个点数**：♠3 贴了个 7 之后，
    // 3 和 7 都钓得上它，它也钓得上 3 和 7。
    // 牌面那个 value 照旧是它印着的点数，这儿是加出来的
    extra : number[]
  }

  // 技能栏上的一格：它管着的花色 / 点数，加技能名。
  //
  // **管什么在前，叫什么在后。** 牌桌上你问的是「我这张 7 会触发什么」——
  // 所以先给锚点（7、♠），再给名字。
  //
  // 原先还有个 slot 字段（标「花色」还是「点数」），删了：
  // 覆盖面本身就把话说完了 —— ♥♦ 和 5 7 9 长得完全不一样，
  // 不会看混。「装在哪个槽」是商店里的概念（那儿要数容量），
  // 搬到牌桌上只是在每一格前面占三个字
  type SkillChip = {
    skill : number
    name : string
    cover : string
    level : string
  }

  // 手牌张数。开局发这么多，之后每个回合结束补足到这么多（见 passTurn）。
  //
  // 从 3 改到 4：回合末补牌意味着你是**看着满手牌**做决定的，
  // 而 3 张的选择面太窄 —— 常常只有一张打得出去，那就不叫选
  const HAND_SIZE : number = 4
  // 观潮看牌库顶几张
  const TIDE_LOOK : number = 2
  // 择饵看牌库顶几张（挑一张留顶，其余沉底）
  const PICK_LOOK : number = 5
  // 原先这儿有个 NO_VALUE = -1，当「这张牌没有点数」的哨兵值
  //（顺色落堆之后就是它）。点数改成**列表**之后哨兵值不需要了 ——
  // 「没有点数」就是空列表。
  //
  // 换掉它是顺带把一个坑填了：0 是个**实打实的点数**（见底能把牌压到 0，
  // 而两张 0 点互相钓得上），用一个负数当「没有」就得处处记着
  // 「别让它参与比较」。空列表不用记 —— 它天然什么都匹配不上
  const JACK : string = 'J'
  // 节奏照钓鱼游戏（fishing.uvue）的来：庄家一回合只停一拍，摸牌和出牌一起做完，
  // 打完立刻交回给你 —— 摸牌不用演，手牌张数一跳就看得出来。
  // 早先摸、打、交回各停 0.7 秒，庄家钓到牌的那一回合要等三秒多，太拖
  const FOE_DELAY_MS : number = 600
  // 赢了之后结算框停多久再自动进商店 —— 够看清拿了多少金币就行
  const SHOP_DELAY_MS : number = 1200
  // 输了：结算框亮出来多久之后那颗心碎掉；碎完再过多久退回商店
  const HEART_BREAK_MS : number = 500
  const LOSE_SHOP_MS : number = 1200
  // 收牌特效分三拍：被收的那段亮起来停一下 → 往上飘走 → 积分跳一下。不弹横幅，
  // 只靠牌本身和积分说话。亮的时长照钓鱼游戏的 CATCH_DELAY（560ms）取整
  const CATCH_SHOW_MS : number = 500
  const CATCH_FLY_MS : number = 200
  const SCORE_FLASH_MS : number = 600

  // 护饵护着的牌：记是谁护的。护饵只挡对方的下一回合，对方那回合一结束就失效
  const GUARD_NONE : number = 0
  const GUARD_ME : number = 1
  const GUARD_FOE : number = 2

  const save = ref<DrawSave>(emptyDrawSave())
  const level = ref<DrawLevel>(drawLevelById(1))
  const myLevels = ref<number[]>([] as number[])
  const myLoadout = ref<DrawLoadout>(emptyLoadout())
  // 庄家那一套，跟上面 myLevels / myLoadout 对称。
  //
  // 原先塞在 level 里（level.value.levels / .loadout），可关卡表的那两个字段
  // 已经删了（庄家配装搬到 DRAW_FOE_ROLES，见 draw-levels 的 DrawLevel）——
  // 再往 DrawLevel 里塞，H5 构造对象时会把不认识的字段丢掉，庄家配装就成了 undefined。
  // 所以单独放：level 只管「这一关叫什么、怎么出牌、给多少钱」
  const foeLevels = ref<number[]>([] as number[])
  const foeLoadout = ref<DrawLoadout>(emptyLoadout())

  const deck = ref<PlainCard[]>([])
  const hand = ref<PlainCard[]>([])
  // 和 hand 下标对齐：这张被庄家窥视过
  const handSeen = ref<boolean[]>([])
  const foeHand = ref<PlainCard[]>([])
  // 和 foeHand 下标对齐：这张被你窥视翻开了
  const foeShown = ref<boolean[]>([])
  const pile = ref<PlainCard[]>([])
  // 和 pile 下标对齐：这张**现在算哪几个点数**。
  //
  // 为什么是一个**列表**而不是一个数：
  //
  //   · 商店的【点数卡】能给一张牌贴额外点数，于是它同时算几个点数；
  //   · 顺色落堆就**一个点数都不算**，那是空列表（从前用 NO_VALUE 这个
  //     哨兵值，换成空列表之后「没有点数」和「0 点」天然分得开 ——
  //     0 是个实打实的点数，见底能把牌压到 0，而两张 0 点互相钓得上）；
  //   · 见底把每个点数各自压下去，压到 0 的那个就从列表里掉出来。
  //
  // 钓牌判定（catchStart）读的是这儿，不是 card.value
  const pileVals = ref<number[][]>([])
  // 和 pile 下标对齐：这张**现在是什么花色**。
  //
  // 跟 pileVals 一个道理：牌面那个花色是死的，可堆上的花色会被
  //【染水】整堆改掉。凡是读堆上花色的地方（顺色的匹配、收色、
  // 界面上那个花色字）都得走 pileSuitAt，**不许读 card.suit**。
  //
  //（原先这儿还列着「见底数黑牌」。见底改成死数 −1 之后它不读花色了 ——
  //  那也是改动的一个附带好处：少一处要同步的读点）
  const pileSuit = ref<string[]>([])
  // 和 pile 下标对齐：这张带着几层【燃烧】。0 = 没有，1 = 着了。
  //
  // ---- 它是第六条并行数组，加它的时候改了七处 ----
  //
  //   pushPile / unshiftPile（进场）、removePileAt（拿掉一张）、
  //   finishCatch（含深钩那段 slice）、finishSweep（按掩码重建）、
  //   newGame（清空）
  //〔原先还有一处 `floodFor`（slice 到 hitAt）—— 洪水 2026-10-16 清掉了，
  //  现在是六处。**这张清单是加第七条数组时唯一的依据，必须跟着改**〕
  //
  // 漏一处的后果是**燃烧标记跟错牌** —— 不会崩，只会悄悄算错。
  // 下次要加第七条之前，先把这六条包成一个结构（现在还值不当那次重构）。
  //
  // ---- 只存 0/1，不记「谁点的」----
  //
  // 不记归属是有意的：谁点的火谁都能引爆，所以「对手帮我点火」和
  //「我帮对手点火」同时存在 —— 那是这件技能的互动面。
  // 记归属就得再加一条数组，而换来的只是少一种互动
  const pileBurn = ref<number[]>([])
  // ---------- 【叠放】：按**牌的引用**存，不是第七条平行数组 ----------
  //
  // 上面 pileBurn 那条注释写着「加第七条之前先把这六条包成一个结构」。
  // 叠放正好是那第七条 —— 可它**不需要**按下标存：
  //
  //   `host` 是宿主那张牌的**引用**，所以堆怎么重建都不会错位
  //   （下标会变，引用不会）。这跟 held 一个形状，而 held 已经
  //   验证过这条路（保护、照水、封色都挂在它上面）。
  //
  // 于是六条平行数组一条都不用动，那次重构也不用现在做。
  //
  // ---- 「当前牌」只有一张：pile[i] ----
  //
  // 这是整个机制的支点。每一叠最上面那张就是 pile[i]，而
  // **匹配、点数、花色、燃烧一概只看它** —— 所以 catchStart、valuesOf、
  // 吃水、见底那一大片代码一个字都不用改。
  //
  // 三条叠放因此自洽：
  //   **垫在下面**（保护 / 加点数）—— 当前牌不变，只是多了东西；
  //   **盖在上面**（代替）—— 换掉 pile[i]，原来那张进这个列表、不再参与任何判定。
  //
  // ---- 收走的时候 ----
  //
  //   普通那一叠 → 整叠都收走，算 1 + 底下那几张的分；
  //   带**保护**那一叠 → **只收走垫在底下那张**（它代替宿主被收走），
  //     宿主留在堆上、保护消失。
  //
  // 后者让「积分 = 收走的张数」**精确成立** —— 真的有一张牌离场了。
  // 保护从前是个抽象标签，得在 taken 和 goneRanks 之间分工；
  // 现在它是一张垫着的实体牌，那个分工没了
  type Stacked = {
    // 垫在谁下面 / 被谁盖着。**存引用，不存下标**
    host : PlainCard
    card : PlainCard
    // 这一张是干什么的：STACK_WARD 当盾、STACK_BOOST 加过点数、
    // STACK_BURIED 被盖住了
    kind : number
  }
  const STACK_WARD : number = 0
  const STACK_BOOST : number = 1
  const STACK_BURIED : number = 2
  // **ref** —— 牌堆那一排要按它画角标（见 stackCount / wardAt）
  const stacked = ref<Stacked[]>([] as Stacked[])
  // 和 pile 下标对齐：这张是不是庄家打的。只用来描边，分清谁下的饵
  const pileByFoe = ref<boolean[]>([])
  // 和 pile 下标对齐：护饵状态。
  //
  // ---- 现在**没有任何技能写它**（护饵删了），所以它恒为 GUARD_NONE ----
  //
  // 留着没删是有意的，两条理由：
  //   · 它是堆上五条并行数组之一（pile / pileByFoe / pileGuard / pileVals /
  //     pileSuit），每一处收牌、见底、收色都要同步增删。拆掉它得改二十来处
  //     splice / slice / keep 循环，而那是纯内部重构、一点玩法收益都没有，
  //     风险却实打实（漏一处就错位）。
  //   · 「堆上某张对某一方不算钓点」这个机制本身是有用的 ——
  //     庄家那几条规矩（浑底、定桩，见庄家文档的规矩表）要的正是它。哪天加回来，
  //     guardedAgainst 那一层现成。
  //
  // 恒为 GUARD_NONE 的代价只是 guardedAgainst 恒返回 false、
  // expireGuards 是空操作 —— 两个都在热路径上，但各只有一次比较
  const pileGuard = ref<number[]>([])
  // 被钓走的点数。庄家挑饵时拿来估「外面还剩几张同点数」
  const goneRanks = ref<string[]>([])
  const myScore = ref<number>(0)
  const foeScore = ref<number>(0)
  const myTurn = ref<boolean>(false)
  const over = ref<boolean>(false)
  const message = ref<string>('')
  // ---------- 技能说明：自己一块，不再占播报 ----------
  //
  // 从前点技能是**把说明写进 message**（播报那一行），再点一次恢复战况。
  // 那套有两个毛病：
  //   播报合进状态行之后只有 11px 一行小字，而说明是整句带括号的长文；
  //   而且它跟战况抢同一个位置 —— 一打牌说明就被冲掉。
  //
  // 现在拆开：说明有自己的一块（头一行 + 正文两行），**战况归战况**。
  // 一打牌（message 变）就自动收起，那条还留着
  const chipHead = ref<string>('')
  const chipBody = ref<string>('')
  // 战况一更新，技能说明就收起
  watch(message, (text : string) => {
    chipAt.value = -1
    chipHead.value = ''
    chipBody.value = ''
  })
  // 你这回合刚摸到的那张在手牌里的下标，-1 表示没摸（牌库空了）。描绿边，打出之后清掉
  const newIndex = ref<number>(-1)
  // 技能栏上点亮的那一格：0 起是你的，100 起是庄家的，-1 表示没点
  const chipAt = ref<number>(-1)
  const rewardText = ref<string>('')
  // 结算结果：赢了往下走 / 输了重来 / 整轮打通
  const OUT_NONE : number = 0
  const OUT_WIN : number = 1
  const OUT_LOSE : number = 2
  const OUT_CLEAR : number = 3
  const OUT_DRAW : number = 4
  // 终局模式的结算：赢了输了都只报个胜负，不推关号、不发钱、不清家当
  const OUT_FINAL : number = 5
  // 「这一局没开起来」：闯关但存档里没角色（见 newGame 那道闸）。
  // 它不是一种胜负，所以单独一档 —— 借 OUT_LOSE 的话结算框会按
  // 0:0 的比分报「平局」
  const OUT_NOROLE : number = 6
  // 输了但还有生命：退回上一个商店（第 1 关就重打这一关）
  const OUT_RETRY : number = 7
  const outcome = ref<number>(OUT_NONE)

  // 终局模式：双方随机满配，一局定胜负，跟本轮进度毫无关系。
  //
  // 做成 URL 参数而不是存档里的一个开关：它是一局**不记账**的对局，
  // 存档里不该留下它来过的痕迹。退出页面这个模式就没了，正合适
  let finalMode : boolean = false
  // 终局带进来的角色卡配装（见 draw-levels 的 goFinalRole）：
  //   finalRole  —— 选了哪个角色（DRAW_ROLES 下标），-1 = 没选
  //   finalSlots —— 每个槽嵌了哪件技能，跟角色的 slots 一一对应，-1 = 空着
  //
  // 没带角色就照旧随机满配（老的终局入口还在，那颗按钮直接开打）
  let finalRole : number = -1
  let finalSlots : number[] = []
  // 终局这一局的难度（0 简单 / 1 普通 / 2 困难，照 DIFF_*）。
  // 从关卡页的角色面板带过来，**不读存档** —— 终局不记账，
  // 它的难度也是一次性的
  let finalDiff : number = DIFF_NORMAL

  // ---------- 角色的那件常驻特殊技能 ----------
  //
  // 双方各一个角色（终局模式才有，-1 = 没有）。它跟点数技能是两条线：
  //
  //   点数技能 —— 打出覆盖面里的牌才触发，一局响几次；
  //   特殊技能 —— **常驻**，上场就一直生效。
  //
  // 所以它不进 loadout，而是在各个结算点上现查（见 specialLevel）：
  //   满篓 / 窄口 → handLimit（补几张手牌）
  //   清水         → foeOpen（对方几张手牌明着）
  //   深钩         → finishCatch（钓到时额外收堆底几张）
  //   稳钩         → playFor（头几张落堆自带护）
  //
  // 终局不升级，所以等级恒为 0 档
  const myRole = ref<number>(-1)

  // ---- 庄家那一侧有**两张不同的表**，所以要两个字段 ----
  //
  // foeRole → DRAW_ROLES（玩家那张角色表）的下标。只有**终局**用它 ——
  //   那一局双方同一个结构，庄家摇的就是玩家能挑的那几张卡。
  // foeAt   → 这一关的**关号**（1–12），闯关才有，0 = 不是闯关。
  //   庄家角色由关号定死（见 draw-levels 的 foeRoleAt），带的是
  //   DRAW_FOE_SPECIALS 里那 11 条庄家专属特殊技（添手、淤滩、硬壳……），
  //   跟玩家那 9 件不是一套。
  //
  // 为什么闯关这边存关号而不是表下标：**DrawKit.role 这个字段在两条路上
  // 含义不同**（终局是 DRAW_ROLES 下标，foeKitOf 填的是关号 - 1），
  // 拿它当下标去查另一张表是一定会错的那种错。存关号就只有一个意思，
  // 而 foeRoleAt / foeSpecialNameAt / foeSpecialDescAt 都直接收关号
  const foeRole = ref<number>(-1)
  const foeAt = ref<number>(0)

  // 【封竿】封住的那个点数（空串 = 这一关没封）。
  //
  // 开局算一次就存着，不每次现查 —— 它是**这一局的常量**
  // （来自存档里摇定的那一份，见 foeSealRank），而 catchStart
  // 一局要跑几百次
  const sealedRank = ref<string>('')

  // 这一方打出过几张牌 —— 【稳钩】要数「前 N 张」
  let myPlayed : number = 0
  let foePlayed : number = 0

  // ---------- 终局：牌库空了，双方各再打 1 手就收摊（2026-10-15 规则变更） ----------
  //
  // 原先是「手里的牌打完才收摊」（各 4 张 = 8 手），而**后手优势的 96%
  // 就出在那 8 手里**：那个阶段手牌只减不补、选择面逐手萎缩、钓中率往下掉，
  // 而后手在每一轮都后打、每一手都能回应。拿「无补充阶段的长度」当自变量
  // 量出来是一条很干净的曲线（各 20000 局，剩堆不算分）：
  //
  //   阶段长度   8 手    6 手    4 手    2 手    0 手
  //   后手分差   +3.03  +1.92  +1.25  +0.31  +0.33
  //
  // **2 手和 0 手统计上分不开**（差 0.02，标准误 0.08），所以取 2 手而不是
  // 「牌库一空立刻停」—— 手里的牌还能打一张（不然玩家是被硬收走东西），
  // 而且「抽空牌库提前收摊」那条新路子的收益被这两手摊薄。4 手就不行了（+0.82）。
  //
  // ---- 它和「堆里剩下的牌不算分」是成套的，拆开用会坏 ----
  //
  // 同一组数里，剩堆改判给先手的那一列是 −0.08 / −1.27 / −1.87 / −2.23：
  // **终局一缩短，后手优势跟着没了，再把剩堆判给先手就是过补。**
  // 所以 leftoverFor 整个删了（原先它把剩堆判给「没打最后一手」的一方）。
  //
  // 换来的是这一整轮要的东西：**剩堆没有收款人，于是「让牌卡在堆上」
  // 不再偏向任何一方**。实测 D（先手溢价）：死水 +2.87 → +0.08、
  // 净水 +1.35 → +0.08、寒流 +1.37 → +0.11、霜降 +1.37 → +0.12、
  // 藏凌 +1.10 → +0.06；逆流船夫 +8.42 → +3.95、深海钓手 +5.95 → +3.05
  //（那两张文档挂了「要重新定档」的账，就这么结了）。
  //
  // 这也是**牌组不用再剔成偶数**的原因（trimDeck 跟着删了）：
  // 奇偶原先决定「谁打最后一手」，而那件事现在不值钱了。
  const TAIL_PLAYS : number = 2
  // 牌库刚空那一刻双方合计打了几手。−1 = 牌库还没空过。
  // checkOver 拿它数「还许打几手」，newGame 重置
  let tailFrom : number = -1
  // ---------- 开局切牌定庄（2026-10-15） ----------
  //
  // 这一局谁先手。**开局翻一张定**：红 = 庄家先手、黑 = 你先手
  //（见 newGame 里切牌那段）。原先这件事是写死的 —— 庄家恒先手。
  //
  // 为什么要改：52 张全要打出 → 总共 52 手 → 后手打第 52 手，
  // 而终局剩堆归「没打最后一手」的一方 → **剩堆每一局都归先手**。
  // 那不是概率上的偏，是每一局都如此，而闯关里先手恒是庄家 ——
  // 于是那份补贴每局都落在它身上（设计文档『终局剩堆』第一条、第四条）。
  //
  // 切牌不改剩堆归属（照旧归先手），它改的是**谁当先手**：
  // 于是你有一半的局拿得到剩堆。实体牌桌上「切牌定庄」是现成的仪式，不用解释。
  //
  // 只在开局分派一次（newGame 末尾），所以是个普通变量，不是 ref
  let firstByFoe : boolean = true

  // 特殊技能的几个定值。不升级，所以每件就一个数 ——
  // 挑定的理由在 draw-skills 的 SPECIAL_SKILLS 表里各自那段
  // 清水：对方前几张手牌明着。
  //
  // ---------- 2 → 3 → **4**，同一天两次〔2026-10-16〕 ----------
  //
  // 实测那条曲线（`AI_SEEN=1`、`-n 20000`，目标档 2.7~4.5）：
  //
  //   2 张  X=+1.36   档外
  //   3 张  X=+2.97   进档
  //   4 张  X=+4.09   ← 现在这一档，靠上沿
  //
  // **第二次涨（3 → 4）的理由不是强度，是「挡着它的那件技能删了」**：
  // 原先卡在 3 是因为「4 张 = 全看 = 常驻版【照水】，两件会完全重复」，
  // 而照水当天删了（+0.16，挂牌型吃 1/7 折扣），所以 4 这一档空出来了。
  //
  // ---- 一条被数据否掉的推断，留着当戒 ----
  //
  // 我在 2 → 3 那一轮写过「**最后那一点不确定性最贵**」（因为那一档涨了 +1.61，
  // 比前两张的总和还多）。**3 → 4 只涨 +1.12 —— 否了。**
  // 曲线确实是凸的，但**上凸段在中间，不在末尾**。
  // 一条从两个点推出来的「规律」，第三个点就能打掉它。
  //
  // ---- ⚠ 为什么是「4 张」而不是「全部」----
  //
  // 这儿是**按下标**判的（`foeOpen` 里 `index < CLEAR_OPEN`），而
  // 【满篓】【添手】会把手牌上限抬高 —— 那时候明的仍然只有前 4 张。
  // 所以 `desc` 写的是「对方 4 张手牌一直明着」，不是「全部明着」。
  // 要改成真·全看就得跟着 `handLimit(true)` 走，而那样
  // **+4.09 这个数当场作废**（它是在「按下标明 4 张」下量的）。
  //
  // ⚠ 还有一层：那条曲线整个是在模拟器的 `AI_SEEN=1` 下量的
  //（教 AI 读明牌的实验旋钮，默认关）—— 默认档 AI 压根不读情报，
  // 所以这件技能在模拟器里恒为 0。**真人的实际收益量不出来**
  //（真人拿情报做多步规划，比那个旋钮强），所以这些数是
  //「下限意义上的合格」，而且只能互相比、不能跟别的技能比。详见实测数据台账
  const CLEAR_OPEN : number = 4
  const FIRM_GUARD : number = 4    // 稳钩：每局前几张落堆的牌自带护
  const DEEP_EXTRA : number = 1    // 深钩：钓到时额外收堆底几张
  // 〔活水 2026-10-16 删了（连带潮汐观测员）。这个常量成了死常量 ——
  //   留着是因为 `sinkTops` 那段实现也留着（照「先让技能失效，再清死代码」
  //   那个两步走），而 SP_LIVEWATER 现在是 −1，那段永远跑不到〕
  const LIVE_OPEN : number = 2     // 活水：牌库顶几张明着

  // ---------- 庄家那几条特殊技的定值（见 DRAW_FOE_SPECIALS）----------
  //
  // 淤滩 3 张：**正好够让 J 变值钱、又不至于开局就把堆堆死**。
  //   少于 3 张（比如 1 张）跟没有差不多 —— 一次普通钓牌就连带收走了；
  //   多于 3 张（比如 5 张）会让第 5 关变成「谁先摸到 J 谁赢」，
  //   而那一关的主题是「让你意识到 J 有多值」，不是掷骰子。
  // 挑潮 2 张：跟【观潮】同一个数 —— 两件做的是同一件事
  //   （从库顶几张里挑），数不一样会让人以为规则不同。
  //
  // 【再钩】没有自己的常量：它直接搭在**连竿**那套上（againPending /
  // againUsed，见 finishCatch），而那套的上限本来就是一回合两张
  const SILT_COUNT : number = 3
  const FOE_PICK_TOPS : number = 2

  // 观潮等你选的时候：牌库顶那两张（第 0 张是最顶上那张），
  // 以及每张标没标「沉」。两条数组下标对齐
  const tidePending = ref<boolean>(false)
  const tideCards = ref<PlainCard[]>([] as PlainCard[])
  const tideMarks = ref<boolean[]>([] as boolean[])

  // 确定那颗钮上写什么 —— 写清楚按下去会发生什么，不用另起一行说明
  const tideButton = computed<string>(() : string => {
    let n = 0
    for (let i = 0; i < tideMarks.value.length; i++) {
      if (tideMarks.value[i]) {
        n = n + 1
      }
    }
    if (n == 0) {
      return '都不动'
    }
    return n == tideMarks.value.length ? '两张都沉' : '沉 ' + n + ' 张'
  })
  // 换水等你挑一张手牌塞回去
  const swapPending = ref<boolean>(false)
  // 冻结等你挑庄家的一张手牌（挑的是位置 —— 那几张多半盖着）
  const freezePending = ref<boolean>(false)
  // 【薪潮】在等你盲选一张（照 freezePending ——**不翻开对方手牌**，
  // 所以不能用 takeSkill，那个会被 foeOpen 认成「全翻开」）。
  // fuelLeft 记还要挑几张：FUEL_TAG 现在钉死 1，但照死水那条先例留着计数，
  // 将来调 N 的时候这儿不用改
  const fuelPending = ref<boolean>(false)
  const fuelLeft = ref<number>(0)
  // ---------- 【凝水】/【净水】：等你点**堆上**一张 ----------
  //
  // 装的是「在等哪件技能挑」的技能下标，-1 = 没在等。
  // 两件共用一个状态，理由跟压舱 / 摘钩 / 对换共用 takeSkill 一样：
  // 交互一模一样（点牌堆那一排），区别只在挑完之后干什么。
  //
  // **这是第一个「点堆上的牌」的交互** —— 从前所有挑牌都是挑手牌
  //（自己的或对方的）。所以牌堆那个 v-for 第一次需要 @click
  const pilePick = ref<number>(-1)
  // 【抬水】要加几点 —— 被丢弃那张的**牌面点数**。
  //
  // 得单独存一个：牌已经出场了（丢弃），等你点堆上那张的时候
  // 它早就不在任何地方了。另两件（凝水 / 净水）不用这个数
  const pickStep = ref<number>(0)
  // 要叠上去的那张。等你点堆上一张的这段时间它**不在任何地方** ——
  // 已经从手牌拿走了、又还没进堆，所以得单独存着
  const pickCard = ref<PlainCard | null>(null)
  // ---------- 【野火】挑牌时要记住的技能表 ----------
  //
  // 凝水那三件不需要这个：它们在落堆**之前**丢弃牌，挑完直接走 afterPlay
  //（从头跑一遍尾段）。而野火**已经落堆了**，挑完还得走燃烧那一步
  //（蔓延 + 燃尽）和匹配 —— 所以它要从 TAIL_REST 接着走，
  // 而 afterPlayTail 要技能表。
  //
  // 不用 ref：它跟 pendingSkills 一样是「这一手之内」的，不进界面
  let pickSkills : number[] = []
  // ---------- 【伏流】这一手贴过标签了吗 ----------
  //
  // **重入闸。** 伏流挑完标签之后 onPilePick 会重新调一次 straightFor
  //（贴完要当场用那个标签判顺子），而 straightFor 里那个「玩家侧就暂停」
  // 的分支只看 `!byFoe` —— 不挡的话会**再暂停一次,死循环**。
  //
  // 不能靠 `pilePick` 判：那个在 onPilePick 开头就清了。
  // 每手在 playFor 开头清、每局在 newGame 里清
  let flowPicked : boolean = false
  // 择饵等你从牌库顶五张里挑一张。
  //
  // 这儿把**牌面存了一份**（pickTops），而不是现场从 deck 取 ——
  // 等你选的这段时间 deck 一个字都不该动，而摆出来的牌面
  // 必须跟最后落袋的那张对得上。存一份是最省心的保证
  const pickPending = ref<boolean>(false)
  const pickTops = ref<PlainCard[]>([] as PlainCard[])

  // ---------- 【分饵】等你挑**两张**：第一张给自己、第二张给对方 ----------
  //
  // 它跟择饵的区别是**要点两下**，而「一个回合只停一次」那条规矩照旧 ——
  // 停的是一次，只是这一次里要点两下（`giftPicks` 攒到 2 就结算）。
  //
  // 牌面同样存一份（照 pickTops 那条理由：等你选的这段时间 deck 不该动）。
  // `giftPicks` 存的是**在 giftTops 里的下标**，顺序就是语义：
  // 第 0 个给自己、第 1 个给对方
  const giftPending = ref<boolean>(false)
  const giftTops = ref<PlainCard[]>([] as PlainCard[])
  const giftPicks = ref<number[]>([] as number[])

  // ---------- 动对方手牌那三件（压舱、摘钩、对换）等你挑 ----------
  //
  // 三件共用**一个**状态：存的是「在等哪件技能挑」的技能下标，-1 表示没在等。
  // 不开三个 boolean 是因为它们的交互一模一样 —— 都是「点对方手牌那一排」，
  // 区别只在挑完之后干什么（见 doTakeFrom）。
  //
  // 这三件跟【冻结】的要紧区别：**它们让你看得见**。冻结挑的是位置
  //（那几张多半盖着），这三件一发动就把对方全部手牌翻开给你挑 ——
  // 所以 foeOpen 要认这个状态
  const takeSkill = ref<number>(-1)
  // 【死水】这一手还要挑几张。压舱 / 摘钩 / 对换都只挑一张，
  // 所以那三件走到 onTakeFrom 就结束了；死水要挑 DEAD_COUNT 张，
  // 挑够之前 takeSkill 不清
  const deadLeft = ref<number>(0)
  // 对换的第二步：已经从对方手里挑中了第几张，现在等你挑自己的那张还他。
  // -1 表示不在第二步
  const giveBack = ref<number>(-1)

  // 同号等你从那几张同点数的里挑一张（池子就 3 张，所以摊开让你挑）
  const twinPending = ref<boolean>(false)
  const twinCards = ref<PlainCard[]>([] as PlainCard[])

  // 收牌特效的状态。catching 期间牌还留在堆里（亮着），飘走之后才真的拿掉、才记分
  const catching = ref<boolean>(false)
  // 被收的那一段：[catchFrom, catchTo]，**两端都含**。
  //
  // 从前只有 catchFrom（「从这张到堆顶」），因为收牌永远收上半截。
  // 【沉底】把方向反过来了（收「堆底 → 匹配那张」），所以得记两头
  const catchFrom = ref<number>(-1)
  const catchTo = ref<number>(-1)
  // 散着收的那几张（见底、收色、撒网……）：不连续，所以单独记下标。
  // 非空时按它算，空的时候按 [catchFrom, catchTo] 那一段算
  const catchSet = ref<number[]>([] as number[])
  // 散着收演完之后接着结算的那几件技能，以及从哪一段接着走（见 finishSweep → afterPlayTail）
  let sweepSkills : number[] = []
  let sweepNext : number = 0
  // 打出那张牌带的技能、落没落堆底 —— 技能都结算完之后匹配要用（见 resolveMatch）
  let matchSkills : number[] = []
  let matchSink : boolean = false
  // afterPlayTail 的几段。散着收的技能演完特效，从**它后面那一段**接着走：
  //   见底 演完 → TAIL_EBB（收色……）
  //   收色 演完 → TAIL_CAST（撒网……）
  //   撒网 演完 → TAIL_FLOW（伏流……）
  //   伏流 演完 → TAIL_WADE（涉水……）
  //   涉水 演完 → TAIL_BRIM（漫流……）
  //   漫流 演完 → TAIL_WILD（野火……）
  //   野火 演完 → TAIL_REST（动对方手牌那几件往后）
  // 一色演完从 TAIL_HEAD 接着走（afterPlayHead：窥视、照水……见底）
  //
  // 〔`TAIL_EBB` 的名字是历史 —— 它是 `afterPlayTail` 的**入口段号**
  //   （afterPlay 传的就是它），不是退潮专用的。退潮 2026-10-14 删了，
  //   名字没跟着改，理由写在 `afterPlayTail` 开头那块墓碑里〕
  //
  // ---- **每件散收技能都得有自己的段号**，这不是风格问题 ----
  //
  // 每一段的进入条件是「**上一件传的那个值**」（撒网传 TAIL_FLOW →
  // 伏流判 `from <= TAIL_FLOW`）。两件共用一个段号就一定出错，而且
  // 两种错都是静默的：
  //
  //   共用且后者在前者**后面** → 前者一收牌，后者**被跳过**（作废）；
  //   共用且后者在前者**前面** → 后者**重复执行**一次。
  //
  // 加伏流的时候就踩了第一种（它跟野火共用 TAIL_WILD，于是同一张牌
  // 带撒网 + 伏流时，撒网一收牌伏流就没了）。加新的散收技能记着这条
  const TAIL_HEAD : number = -1
  const TAIL_EBB : number = 0
  const TAIL_CAST : number = 1
  const TAIL_FLOW : number = 2
  const TAIL_WADE : number = 3
  // 【漫流】2026-10-16 插在这儿，后面三个跟着 +1。
  //
  // **插进来就得全套重排** —— 这几个值是「段的先后」，而每一段的进入
  // 条件是 `from <= 它`。所以漏改一个的后果是上面注释里那两种静默错法。
  // 全文只用常量名、没有字面量（grep 确认过），所以改值是安全的
  const TAIL_BRIM : number = 4
  const TAIL_WILD : number = 5
  const TAIL_REST : number = 6
  // ---- 【燃尽】那一步的哨兵（2026-10-14）----
  //
  // 它**不是一个技能段**，而是「整条尾段走完之后、匹配之前」那一步
  //（蔓延 + 全堆带火则扫整堆，见 burnStep）。
  //
  // 它要单独一个号，而且 finishSweep 认到它时要**直接走 resolveMatch、
  // 不回 afterPlayTail** —— 因为尾段后半那几件（死水、摘钩、对换、压舱…）
  // **没有 `from <=` 守卫**（它们各自 return，靠的是「一回合只停一次」），
  // 回去就会重跑一遍。那是 TAIL_* 那段注释里警告过的第二种错法
  const TAIL_BURN : number = 7

  function inCatch(index : number) : boolean {
    if (catchSet.value.length > 0) {
      return catchSet.value.indexOf(index) >= 0
    }
    return index >= catchFrom.value && index <= catchTo.value
  }
  const catchByFoe = ref<boolean>(false)
  const flyOn = ref<boolean>(false)
  const flashMe = ref<boolean>(false)
  const flashFoe = ref<boolean>(false)

  // ---------- 开局切牌的动画（2026-10-15） ----------
  //
  // **它是纯视觉层，一条规则都不碰** —— 牌在 newGame 里早就发进手牌了
  //（见那段 `cutCard` 的处理），这儿只是在上面盖一张一模一样的牌，
  // 让它从中间飞到该去的那一边。所以动画出任何问题都不会影响对局。
  //
  // 为什么要这个动画：切牌定的是**谁先手**，而那是整局唯一一次「凭一张牌
  // 决定一件大事」。原先它只有一行 message，玩家的体验是
  // 「我手里莫名多了一张明牌，而且不知道为什么轮到我先打」。
  //
  // 两段：先在中间**停住给人看清**（花色和颜色都要看清，因为规则是红黑），
  // 再飞向目标手牌。两段都走 CSS transition，不用逐帧
  const cutFly = ref<PlainCard | null>(null)
  // 飞向哪一边：true = 庄家（往上），false = 你（往下）
  const cutToFoe = ref<boolean>(false)
  // 0 = 不显示，1 = 停在中间，2 = 飞走
  const cutPhase = ref<number>(0)
  let cutTimer : number = -1
  // 停多久、飞多久。停的那下要够看清花色 ——
  // 比收牌特效（亮 500ms）长一点，因为这张牌要「读」而不只是「看到」。
  //
  // ⚠ CUT_FLY_MS 要跟 `.cut-card` / `.cut-note` 的 transition-duration
  // 对上（420ms）。**两处分开写是没办法的事** —— CSS 里读不到 UTS 常量。
  // 改一个就要改另一个，不然牌会在飞到一半时被 v-if 摘掉
  const CUT_HOLD_MS : number = 700
  const CUT_FLY_MS : number = 420

  // 切出那张牌的牌面 —— 模板读这三个，不在模板里断言 `cutFly!`
  const cutFace = computed<string>(() : string => {
    const c = cutFly.value
    return c == null ? '' : rankFace(c!.rank)
  })
  const cutSuit = computed<string>(() : string => {
    const c = cutFly.value
    return c == null ? '' : c!.suit
  })
  const cutRed = computed<boolean>(() : boolean => {
    const c = cutFly.value
    return c != null && isRed(c!)
  })
  // 「红 → 庄家先手」/「黑 → 你先手」。**这一句是动画的全部信息量** ——
  // 牌给人看颜色，这行字说它因此定了什么。开局那条 message 里原先也有
  // 同样一句，重复了，所以那边删掉了（见 newGame 末尾那段）
  const cutLine = computed<string>(() : string => {
    return cutToFoe.value ? '红 → 庄家先手' : '黑 → 你先手'
  })
  // ---------- 挂在牌上的效果 ----------
  //
  // 有几个技能的效果要**跨回合**，而且解除条件是「打出它的那张牌离场」——
  // 也就是那张效果牌被谁钓走（谁钓的都算）。
  //
  // 为什么不能照护饵那样做：护饵存在 pileGuard（跟 pile 下标对齐）里，
  // 因为它只活一个回合，回合末一律清掉（expireGuards）。这几个不一样 ——
  // 它们得活到那张牌被钓走为止，而**收牌会把 pile 整段截断**，
  // 下标全变。所以这儿记的是**对象引用**：牌还在堆里就还在，不在了就没了。
  //
  // 这个解除条件本身是个好东西：效果不是「持续 N 回合」而是
  // 「持续到那张牌被拿走」—— 于是对手有办法破它（去钓那张牌），
  // 而你也得掂量把效果挂在多深的位置
  type HeldEffect = {
    // 挂在这张牌上。它离场，效果就解除
    source : PlainCard
    skill : number
    // 冻结用：被锁住的那张手牌。也记引用 —— 手牌的下标一样会变
    target : PlainCard | null
    // 效果是谁打出的。决定它作用在谁身上（对方）
    byFoe : boolean
  }
  // **ref 而不是普通变量** —— 牌桌上那条「场上效果」栏要渲染它
  //（见 fieldChips）。模板读的东西必须是响应式的，不然挂上效果
  // 那一栏不会刷新。代价是全文读写都得带 .value
  const held = ref<HeldEffect[]>([] as HeldEffect[])
  // 刚打出去的那张。挂效果要用它当锚
  let lastPlayed : PlainCard | null = null

  // ---------- 〔删了〕mergeCard / mergeGain（合流吃到的点数） ----------
  //
  // 跟 mergeFor 一起清掉（2026-10-16）。留下**一条还在用的实现判据**：
  //
  // > 堆上「现在算几点」和这一手的**钓牌判定**读的是两个东西 ——
  // > 前者是 `pileVals`，后者是 `valuesOf`（走牌自己的点数，**压根不读
  // > pileVals**）。只改 `pileVals` 的话，牌在界面上写着「同时算 7 和 9」，
  // > 可判定那一下只拿 7 去匹配 —— **界面和判定两张嘴**。
  //
  // 所以任何「改一张牌当前算几点」的技能都得落到两个地方。
  // 归深（追加 11）、软点（追加 1）是现在还活着的两个载体，照它们写。
  //
  // 另一条：这类「这一手的临时状态」**必须认牌**（存 card、比对身份）——
  // 庄家挑牌时 `catchStart` 一回合要跑十几次（那是**落堆之前**的预估），
  // 那会儿 `playFor` 还没跑、变量还留着上一手的值

  // ---------- 【野火】这一手取到同点数的牌了吗 ----------
  //
  // 存那张**打出的**牌。取到了它就无点数（valuesOf 读这个），
  // 取不到就保留点数、但那一手只贴火不收火（见 wildfireFor）。
  //
  // 「认一下牌」那个模式，理由见上一段：庄家挑牌时 catchStart 一回合要跑
  // 十几次（那是落堆前的预估），不认牌别的牌就读到了不属于它的状态。
  // 每手在 playFor 开头清、每局在 newGame 里清。
  //
  // **这个状态位删了**（2026-10-13 定稿）：野火的无点数回到**无条件**，
  // valuesOf 不再需要认牌。留着一个没人读的状态位比删掉更误导 ——
  // 这一季在【涉水】的旋钮上栽过一次（定稿改了、默认值没翻，
  // 整张 all 表拿旧档的数定了新档的价）

  // ---------- 豁免：这一手的收牌无视结冰 ----------
  //
  // 回合级的变量，不是 takeAt 的参数 —— 为什么这么选、以及**必须清掉的
  // 那两处**，都写在 takeAt 上面那段。
  // 普通变量而不是 ref：只在逻辑里读，模板不需要它
  let iceBlindNow : boolean = false

  // ---------- 手里带着【结冰】的那几张 ----------
  //
  // **结冰有两个位置，意思正好相反**（见 TERMS 那条）：
  //   **堆上** = 障碍（那一格被收走时不走、不计分）；
  //   **手里** = 钥匙（用它打出去的那一手，收牌无视结冰）。
  //
  // 而它穿过去之后落堆，又变成新的障碍 —— 这一族自洽就自洽在这儿。
  //
  // ---- 为什么手里的冰不能挂进 held ----
  //
  // `expireHeld()` 按「source 还在不在堆上」过滤，所以挂进去的手牌冰
  // **会在下一次收牌后被立刻清掉**。那条闸是所有在场效果共用的，
  // 为了一个机制放宽它的语义，以后别的效果会跟着漏。
  //
  // 所以单开这个数组。代价是落堆那一下要把它**转成堆上的冰**
  //（见 pushPile / unshiftPile），而那正好是「钥匙用完变障碍」那一步
  let frostHand : PlainCard[] = []

  // 这张牌手里带着冰吗（打出时的豁免、以及落堆要不要转成堆上的冰，都读它）
  function frostOnHand(card : PlainCard) : boolean {
    for (let i = 0; i < frostHand.length; i++) {
      if (frostHand[i] == card) {
        return true
      }
    }
    return false
  }

  // 给手里这张贴冰。**不可叠加**那条在这儿也守着
  function addFrostHand(card : PlainCard) {
    if (frostOnHand(card)) {
      return
    }
    frostHand = frostHand.concat([card])
  }

  // 从手冰表里摘掉（落堆那一下调，接着在堆上贴）
  function dropFrostHand(card : PlainCard) {
    const keep : PlainCard[] = []
    for (let i = 0; i < frostHand.length; i++) {
      if (frostHand[i] != card) {
        keep.push(frostHand[i])
      }
    }
    frostHand = keep
  }

  // ---------- 【引火】的手牌火（2026-10-14） ----------
  //
  // burnHand：手里**预约了火**的那几张。照 frostHand，而且是同一个理由 ——
  // 挂进 held 会被 expireHeld 按「source 还在不在堆上」立刻清掉。
  //
  // 跟冰**不一样**的地方要记住：火只在堆上做事（蔓延、燃尽），
  // 所以手里这一层纯粹是**预约** —— 落堆那一下兑现成 pileBurn，
  // 带在手里什么也不做。冰在手里是钥匙（豁免），火在手里不是
  let burnHand : PlainCard[] = []

  function burnOnHand(card : PlainCard) : boolean {
    for (let i = 0; i < burnHand.length; i++) {
      if (burnHand[i] == card) {
        return true
      }
    }
    return false
  }

  function addBurnHand(card : PlainCard) {
    if (burnOnHand(card)) {
      return
    }
    burnHand = burnHand.concat([card])
  }

  function dropBurnHand(card : PlainCard) {
    const keep : PlainCard[] = []
    for (let i = 0; i < burnHand.length; i++) {
      if (burnHand[i] != card) {
        keep.push(burnHand[i])
      }
    }
    burnHand = keep
  }

  // ---------- 【推牌】的手牌标签（2026-10-16）----------
  //
  // 照 frostHand / burnHand 的形状（对象引用数组），**但有一处关键区别：
  // 它可以叠加，而同一张牌在表里出现几次就是几层。**
  //
  // 为什么用「重复出现」而不是并行数组记层数：加一层是 push 一次、
  // 减一层是 filter 掉一个 —— 不用维护两条数组的对齐，而这个文件里
  // 已经有六条平行数组了（见 pileBurn 那段「漏一处就静默算错」）。
  //
  // 跟冰火两套还有两处不一样，都要记住：
  //
  //   **它贴在对方手里**（引潮挑对方的牌），而冰火那两套贴自己的。
  //     所以清理点不同：这张牌离开**对方**手牌时才摘。
  //   **它在手里什么也不做，离开手牌那一刻才兑现** —— 跟火同理
  //    （火是落堆兑现成 pileBurn），而冰在手里是钥匙（豁免）。
  //
  // 每局在 newGame 清，打出那一下在 playFor 开头**连所有层一起**摘掉
  // （那张牌要离开手牌了，层数随它走 —— 见 surgeFor 的调用点）
  let surgeHand : PlainCard[] = []

  // 这一手要推几层 —— playFor 开头从 surgeHand 摘下来存这儿，endPlay 兑现。
  //
  // **不是 ref**：没人在模板里读它（层数角标读的是 surgeLayers，
  // 那是手牌上的事）。每手在 playFor 开头无条件重写，所以不用额外清
  let surgePending : number = 0

  // 这张牌手里带着几层【推牌】（0 = 没有）
  function surgeLayers(card : PlainCard) : number {
    let n = 0
    for (let i = 0; i < surgeHand.length; i++) {
      if (surgeHand[i] == card) {
        n = n + 1
      }
    }
    return n
  }

  // 贴一层。**没有「不可叠加」那道闸** —— 可叠加正是它跟冰的分野，
  // 而叠加不设上限（代价是局长，见 draw-skills 的 SURGE_PUSH 那段）
  function addSurgeHand(card : PlainCard) {
    surgeHand = surgeHand.concat([card])
  }

  // 手牌角标那个字：报**会涌几张**（层数 × 2），没有就空串。
  //
  // 报后果而不报层数 —— 玩家要的是那个数，而乘法在这儿做掉，
  // 他不用自己乘（照 takeText 那条同样的处理）。
  //
  // **拼串用 '' + value，不能用 .toString()** —— 编译到 Kotlin 是
  // Number.toString(10)，而 Number 上没有那个带进制的重载，整个包编译不过
  //（判据在 cards.uts 的 faceOf）
  function surgeTag(card : PlainCard) : string {
    const n = surgeLayers(card)
    return n == 0 ? '' : ('涌' + (n * SURGE_PUSH))
  }

  // 把这张的**所有层**一次摘掉，返回摘掉几层。
  //
  // 返回值就是「这一手要推几层」—— 调用点在 playFor 开头，
  // 摘下来的层数存着，等这一手结算完（endPlay）再兑现
  function dropSurgeHand(card : PlainCard) : number {
    const keep : PlainCard[] = []
    let gone = 0
    for (let i = 0; i < surgeHand.length; i++) {
      if (surgeHand[i] == card) {
        gone = gone + 1
      } else {
        keep.push(surgeHand[i])
      }
    }
    surgeHand = keep
    return gone
  }

  // 这一手打出的牌**自带结冰**吗（这一族的共同前缀）。
  //
  // 三件都走同一条：打出时它在手里就带着冰 → 豁免；落堆后变成障碍。
  // 所以 playFor 开头把它塞进 frostHand，后面的逻辑一条都不用特判
  //
  // 〔`SK_FROSTFALL` 2026-10-16 从这儿撤了（霜降 10-15 删）。
  //   「自带结冰」是这一族的**签名**，新做冰技能基本都该加进这一行〕
  function selfFrost(skills : number[]) : boolean {
    return hasTrigger(skills, SK_FROST) || hasTrigger(skills, SK_HIDE)
      || hasTrigger(skills, SK_COLDHUE)
  }

  // 收牌特效放完之后还要结算的技能（打出那张触发的）
  let pendingSkills : number[] = []
  // 这儿原先有 lastEvent 和 chipText：技能说明是**写进 message** 的，
  // 所以要记一份「最近的战况」好在收起时还原，再记一份「现在显示的是说明」
  // 好让战况更新时把技能栏熄掉。
  //
  // 说明拆成自己一块（chipHead / chipBody）之后两个都不需要了 ——
  // 说明和战况各占各的位置，谁也不盖谁

  let foeTimer : number = -1
  let catchTimer : number = -1
  let flashTimer : number = -1
  let shopTimer : number = -1
  // 失去生命的动画：输之前有几颗、上限几颗、那一颗碎没碎
  const heartMax = ref<number>(0)
  const heartBefore = ref<number>(0)
  const heartBroken = ref<boolean>(false)
  let heartTimer : number = -1

  const heartList = computed<number[]>(() : number[] => {
    const out : number[] = []
    for (let i = 1; i <= heartMax.value; i++) {
      out.push(i)
    }
    return out
  })

  // 结算框亮出来停一拍，再让那颗心碎掉；有上一个商店的话，碎完自己退回去
  function loseHeart(before : number, max : number, backToShop : boolean) {
    // 画几个格子：**取「上限」和「手上实际有几点」里大的那个**。
    //
    // 两个数会对不上，而且是正常情形：`ensureLives` 只在生命见底时补满，
    // 所以难度表一调（2026-10-15 生命从 4/3/2 退回 3/2/1），**改版前就在进行中
    // 的那一轮手上可能比新上限还多一点**。按 max 画的话那一轮会少画一个格子，
    // 碎掉的那颗就落在了画不出来的位置上。
    // 存档不去动它 —— 输一次就自己落回上限内，而夹存档等于偷走玩家一条命
    heartMax.value = before > max ? before : max
    heartBefore.value = before
    heartBroken.value = false
    heartTimer = setTimeout(() => {
      heartTimer = -1
      heartBroken.value = true
      if (backToShop) {
        shopTimer = setTimeout(goShop, LOSE_SHOP_MS)
      }
    }, HEART_BREAK_MS)
  }

  const canPlay = computed<boolean>(() : boolean => {
    return myTurn.value && !over.value && !catching.value && !tidePending.value
      && !swapPending.value && !freezePending.value && !pickPending.value
      && takeSkill.value < 0 && giveBack.value < 0 && !twinPending.value
      && pilePick.value < 0
      // 【分饵】要点两下才算完，没点完不许出牌（跟别的 pending 同理）
      && !giftPending.value
      // 【薪潮】盲选期间不许出牌（跟别的 pending 一个理由：
      // 那件事没做完。连竿是唯一的例外，见 againWaiting 那段）
      && !fuelPending.value
      // 切牌还飞在半空 —— 这一条跟 catching 同理（动画期间不许动手）。
      // 你先手时 startMyTurn 已经跑过了（myTurn=true），所以不拦这一下
      // 就能抢在那张牌落地之前出牌
      && cutPhase.value == 0
      && hand.value.length > 0
  })

  const turnText = computed<string>(() : string => {
    if (over.value) {
      return '对局结束'
    }
    if (!myTurn.value) {
      return '庄家回合'
    }
    if (tidePending.value) {
      return '你的回合 · 观潮'
    }
    if (swapPending.value) {
      return '你的回合 · 换水'
    }
    if (freezePending.value) {
      return '你的回合 · 冻结'
    }
    if (pickPending.value) {
      return '你的回合 · 择饵'
    }
    // 分饵要点两下，所以抬头里报**还差几张** —— 不报的话点完第一张
    // 看着像卡住了（面板还在、但没说为什么不动）
    if (giftPending.value) {
      return giftPicks.value.length == 0
        ? '你的回合 · 分饵（挑给自己的）'
        : '你的回合 · 分饵（挑给庄家的）'
    }
    if (pilePick.value >= 0) {
      return '你的回合 · ' + DRAW_SKILLS[pilePick.value].name
    }
    if (takeSkill.value >= 0) {
      return '你的回合 · ' + DRAW_SKILLS[takeSkill.value].name
    }
    if (giveBack.value >= 0) {
      return '你的回合 · 对换（还一张）'
    }
    if (twinPending.value) {
      return '你的回合 · 同号'
    }
    if (catching.value) {
      return '你的回合 · 收牌中'
    }
    // 连竿兑现之后还在同一个回合里，但手牌**不会补** ——
    // 得说清楚这是加打的那一张，不然看着像回合没过去
    return againUsed.value ? '你的回合 · 连竿加打' : '你的回合 · 打出一张'
  })

  // 压舱 / 摘钩 / 对换共用一块提示，这儿按技能出话
  const takeText = computed<string>(() : string => {
    if (takeSkill.value == SK_PRESS) {
      return '压舱：点庄家一张手牌，塞回牌库洗掉'
    }
    if (takeSkill.value == SK_UNHOOK) {
      return '摘钩：点庄家一张手牌，拿到你手上'
    }
    if (takeSkill.value == SK_SWAPCARD) {
      return '对换：点庄家一张手牌拿过来，然后挑一张自己的还他'
    }
    if (takeSkill.value == SK_DEAD) {
      // 报**还剩几张**，因为这一件要挑好几张 —— 不报的话点完第一张
      // 界面没变化，看着像点空了
      return '死水：点庄家手牌废掉它（还剩 ' + deadLeft.value
        + ' 张）· J 和已经废了的点不动'
    }
    if (takeSkill.value == SK_SURGE) {
      // **把「打出后涌几张」算给他看** —— 那是这件技能的全部内容，
      // 而他要自己乘一遍（层数 × 2）。乘法写在这儿，他就只用挑牌。
      //
      // 「已经带了的可以再贴」要明说：全表前三个标签都不能叠，
      // 所以玩家的默认预期是反的（见词表【推牌】那条的注释）
      return '引潮：点庄家一张手牌，贴 ' + SURGE_LAYERS + ' 层推牌（他打出后涌 '
        + (SURGE_LAYERS * SURGE_PUSH) + ' 张）· J 点不动，已经带了的可以再贴'
    }
    return ''
  })

  const resultText = computed<string>(() : string => {
    if (outcome.value == OUT_CLEAR) {
      return '全部通关！'
    }
    // 这一支跟比分无关 —— 它是「这一局压根没开起来」（见 newGame 那道闸）。
    // 不复用 OUT_LOSE 就是为了这儿：比分 0:0 会被下面那三行读成「平局」，
    // 而报一句假的胜负比报错更糟
    if (outcome.value == OUT_NOROLE) {
      return '还没选角色'
    }
    if (myScore.value > foeScore.value) {
      return '你赢了'
    }
    if (myScore.value < foeScore.value) {
      return '你输了'
    }
    return '平局'
  })

  // 顶部关卡条那一行
  const levelTitle = computed<string>(() : string => {
    if (level.value.id == 0) {
      return '终局 · ' + level.value.name
    }
    return '第 ' + level.value.id + ' 关「' + level.value.name + '」'
  })

  const livesText = computed<string>(() : string => {
    if (level.value.id == 0 || save.value.lives <= 0) {
      return ''
    }
    return '生命 ' + save.value.lives + '/' + maxLivesOf(difficultyOf(drawSaveSlot()))
  })

  const myChips = computed<SkillChip[]>(() : SkillChip[] => {
    return chipsOf(myLoadout.value, myLevels.value)
  })

  const foeChips = computed<SkillChip[]>(() : SkillChip[] => {
    return chipsOf(foeLoadout.value, foeLevels.value)
  })

  // levels 这个参数留着没删：调用处（myChips / foeChips）两边都有现成的，
  // 而且将来要是再给技能加什么「状态」，入口在这儿。
  // **level 那一栏现在恒为空串** —— 技能没有等级了
  function chipsOf(lo : DrawLoadout, levels : number[]) : SkillChip[] {
    const chips : SkillChip[] = []
    const list = equippedSkills(lo)
    for (let i = 0; i < list.length; i++) {
      const k = list[i]
      chips.push({
        skill: k,
        name: DRAW_SKILLS[k].name,
        cover: coverageText(lo, k),
        level: ''
      })
    }
    return chips
  }

  // 点技能标签：底下那块说明条改成它的效果。再点一次收起
  function showChip(ofFoe : boolean, index : number) {
    const at = ofFoe ? 100 + index : index
    if (chipAt.value == at) {
      closeChip()
      return
    }
    const list = ofFoe ? foeChips.value : myChips.value
    if (index >= list.length) {
      return
    }
    const chip = list[index]
    chipAt.value = at
    const one = DRAW_SKILLS[chip.skill]
    // 带「优先」的挂一句 —— 牌桌上「谁先结算」是实打实影响判断的
    //（见 draw-skills 文件头那段）
    const key = one.first ? ' 〔' + KEYWORD_FIRST + '〕' : ''
    // 头一行：谁的 · 管什么 · 叫什么 · 几级。正文就是效果本身
    chipHead.value = (ofFoe ? '庄家 · ' : '') + chip.cover + ' · '
      + chip.name + ' ' + chip.level + key
    chipBody.value = one.desc
  }

  // 点那个特殊技标签（角色带的常驻技能）：报它的全文。
  //
  // 标签上只写得下「背篓渔夫·满篓」，整句效果在这儿看 ——
  // 那也是它为什么点得动（从前它是一行不可点的小字）
  function showRole(ofFoe : boolean) {
    const at = ofFoe ? 301 : 300
    if (chipAt.value == at) {
      closeChip()
      return
    }
    // 闯关的庄家走它自己那张表（按关号查）
    if (ofFoe && foeAt.value > 0) {
      const name = foeSpecialNameAt(foeAt.value)
      if (name == '') {
        return
      }
      chipAt.value = at
      chipHead.value = '庄家 · ' + foeRoleAt(foeAt.value).name
        + ' · ' + name + ' 〔常驻〕'
      chipBody.value = foeSpecialDescAt(foeAt.value)
      return
    }
    const r = ofFoe ? foeRole.value : myRole.value
    if (r < 0 || r >= DRAW_ROLES.length) {
      return
    }
    const sp = specialIndexOf(DRAW_ROLES[r].special)
    if (sp < 0) {
      return
    }
    chipAt.value = at
    chipHead.value = (ofFoe ? '庄家 · ' : '') + DRAW_ROLES[r].name
      + ' · ' + SPECIAL_SKILLS[sp].name + ' 〔常驻〕'
    chipBody.value = SPECIAL_SKILLS[sp].desc
  }

  function closeChip() {
    chipAt.value = -1
    chipHead.value = ''
    chipBody.value = ''
  }

  function isRed(card : PlainCard) : boolean {
    return isRedSuit(card.suit)
  }

  // 这两门花色对出牌这一方算不算「同色」。
  //
  // 【两色】（SP_TWOCOLOR，夜钓客带的）把♠♣ 并成一门、♦♥ 并成一门。
  // byFoe 是**出牌方** —— 技能是谁的，就按谁的眼睛算。
  //
  // 四个调用点都是「找出同花色的牌并收走」：顺色（catchStart）、
  // 收色（hueFor）、庄家估收成（harvestCount，口径必须跟 hueFor 一致）、
  // 同花（suitFindFor）。
  //
  // **封色（suitSealed）不走这儿**，那是故意的：它是禁止类，
  // 放大一个禁止等于封掉半副牌，而封色是场上效果、双方都受 ——
  // 到时候「谁的两色在起作用」说不清。理由全文在 draw-skills 的技能注释里
  function sameSuit(a : string, b : string, byFoe : boolean) : boolean {
    if (a == b) {
      return true
    }
    if (!hasSpecial(byFoe, SP_TWOCOLOR)) {
      return false
    }
    return isRedSuit(a) == isRedSuit(b)
  }

  // 这一方带的是哪件特殊技能、几级。没带这件就返回 -1。
  //
  // 终局不升级，所以带着就是 0 档 —— 哪天闯关也用上角色卡（那边能升），
  // 这儿改成读等级表就行，调用处一个都不用动
  // 这一方带的是不是这件特殊技能。
  //
  // 原先叫 specialLevel，返回等级（带着是 0 档、没带是 -1）。
  // 特殊技能改成**不能升级**之后没有等级这回事了，所以退化成一个 boolean ——
  // 各处的效果值跟着写死（满篓 +1、深钩 1 张、稳钩前 4 张…），
  // 那几个数挑定的理由在 SPECIAL_SKILLS 表里各自那段
  function hasSpecial(byFoe : boolean, sp : number) : boolean {
    const r = byFoe ? foeRole.value : myRole.value
    if (r < 0 || r >= DRAW_ROLES.length) {
      return false
    }
    return specialIndexOf(DRAW_ROLES[r].special) == sp
  }

  // 闯关的庄家带的是**它自己那张表**上那几条（见 DRAW_FOE_SPECIALS）。
  //
  // 按 key 问而不是按下标：每条的落点都不一样（硬壳 / 炙水在 catchStart、
  // 偏流在 playFor、添手在 handLimit、走水在回合末……），所以调用处写的是
  // `hasFoeSpecial('shell')` 这种能一眼读懂的东西，而不是一个常量下标。
  //
  // **一个角色可能带两条**（东海龙王：逆钩 + 浊水），所以这儿转给 foeRoleHas
  // 去遍历 specials。调用处一处都不用改 —— 它们问的本来就是「带不带某条」。
  //
  // 终局的庄家走 hasSpecial —— 那一局它摇的是玩家那张表
  function hasFoeSpecial(key : string) : boolean {
    if (foeAt.value <= 0) {
      return false
    }
    return foeRoleHas(foeRoleAt(foeAt.value), key)
  }

  // 这儿原先有个 specialText（角色名 + 技能名 + 整句效果，摆在技能栏下面
  // 当一行小字）。布局改过之后那一行没了 —— 技能栏上只摆
  // 「背篓渔夫·满篓」这个标签（roleTag），整句效果点一下看（showRole）

  // ---------- 【囤饵】：开局往牌库塞 BAIT_COUNT 张，再洗 ----------
  //
  // 塞的是「这个角色第一个数字槽那个点数」（见 baitRankOf）——
  // 那个槽的牌变多，嵌在它上面的技能就更常响。
  //
  // 几条要点：
  //   **牌库是共用的** —— 塞进去的牌对手也摸得到（只是他的槽不在那个
  //     标签上，摸到只是普通牌）。这是它三条外部制衡之一。
  //   **塞完要洗** —— 不洗的话那几张堆在库底，等于没塞。
  //   **DECK_CAP 兜一道** —— 牌组买厚了之后可能塞不下，
  //     塞几张算几张，少塞了要说一声（静默吞掉的话玩家只会以为技能坏了）。
  //   花色随机 —— 塞「3 张 7」没说是哪三张 7，随机挑免得总是 ♠
  function baitFor(byFoe : boolean) {
    if (!hasSpecial(byFoe, SP_BAIT)) {
      return
    }
    const r = byFoe ? foeRole.value : myRole.value
    const rank = baitRankOf(r)
    if (rank == '') {
      return
    }
    let room = DECK_CAP - deck.value.length
    if (room <= 0) {
      message.value = message.value + (byFoe ? ' 庄家囤饵：' : ' 囤饵：')
        + '牌组满了，一张也塞不进去。'
      return
    }
    let n = BAIT_COUNT
    if (n > room) {
      n = room
    }
    const next = deck.value.slice(0)
    for (let i = 0; i < n; i++) {
      const suit = SUITS[Math.floor(Math.random() * SUITS.length)]
      next.push({
        suit: suit,
        rank: rank,
        value: valueOfRank(rank),
        extra: [] as number[]
      } as PlainCard)
    }
    // 洗整副 —— 塞完堆在库底等于没塞
    for (let i = next.length - 1; i > 0; i--) {
      const k = Math.floor(Math.random() * (i + 1))
      const tmp = next[i]
      next[i] = next[k]
      next[k] = tmp
    }
    deck.value = next
    const short = n < BAIT_COUNT ? '（牌组快满了，只塞进 ' + n + ' 张）' : ''
    message.value = message.value + (byFoe ? ' 庄家囤饵：' : ' 囤饵：')
      + '牌库里多了 ' + n + ' 张 ' + rank + short + '。'
  }

  // 堆上第 index 张牌带着什么场上效果，返回效果名（多个用「·」连）。
  //
  // 一张牌最多触发两个技能（花色槽一个、点数槽一个），所以最多两个名字。
  // 没有就返回空串，模板那边 v-if 掉
  function pileEffectName(index : number) : string {
    if (index >= pile.value.length) {
      return ''
    }
    const card = pile.value[index]
    let text = ''
    for (let i = 0; i < held.value.length; i++) {
      if (held.value[i].source == card) {
        text = text + (text == '' ? '' : '·') + DRAW_SKILLS[held.value[i].skill].name
      }
    }
    return text
  }

  // 技能行上那个标签只写**角色名 + 技能名**（「背篓渔夫·满篓」）——
  // 一行要塞得下点数技能那几个 chip，所以这儿不能写整句效果。
  // 整句在哪看：点一下它，说明框里有（见 showRole）
  //
  // 庄家那一侧分两路：闯关按关号查 DRAW_FOE_ROLES（它自己那张表），
  // 终局查 DRAW_ROLES（跟玩家同一张）。见 foeRole / foeAt 那段
  function roleTag(byFoe : boolean) : string {
    if (byFoe && foeAt.value > 0) {
      // 浅滩前三关的庄家没有特殊技，只有名字 —— 名字也得报，
      // 它是「这一关是谁」那条可学的信息
      const name = foeRoleAt(foeAt.value).name
      const sp = foeSpecialNameAt(foeAt.value)
      return sp == '' ? name : name + '·' + sp
    }
    const r = byFoe ? foeRole.value : myRole.value
    if (r < 0 || r >= DRAW_ROLES.length) {
      return ''
    }
    const at = specialIndexOf(DRAW_ROLES[r].special)
    return at < 0 ? '' : DRAW_ROLES[r].name + '·' + SPECIAL_SKILLS[at].name
  }

  // ---------- 【逆流】：角色带的那件，每回合你自己选 ----------
  //
  // 点数槽那件【沉底】是**强制**的（打出覆盖面里的牌就落堆底），
  // 逆流是**可选**的 —— 那正是它在设计上最值钱的地方：
  // 它不给数值，给的是每回合多一个决定（落堆顶还是堆底）。
  //
  // 它原先也叫「沉底」，和点数技能同名同效。改名的理由在
  // draw-skills 的 SPECIAL_SKILLS 表里那条 —— 简单说：界面上并排
  // 出现两个沉底，而规则不一样。
  //
  // 开关**保持状态**，不是每回合重置。两者等价（开关就是每回合都在
  // 生效的选择，你随时改得动），但保持状态少按很多次 ——
  // 而且它让「这一局我走堆底路线」成为一个能坚持的策略
  const sinkOn = ref<boolean>(false)

  const hasSinkSpecial = computed<boolean>(() : boolean => {
    return hasSpecial(false, SP_REVERSE)
  })

  // 这一手要不要往堆底落（只管角色那件常驻的；点数槽那件在 playFor 里单独判）
  function wantSink(byFoe : boolean, card : PlainCard, skills : number[]) : boolean {
    if (!hasSpecial(byFoe, SP_REVERSE)) {
      return false
    }
    if (!byFoe) {
      return sinkOn.value
    }
    // ---- 庄家自己算：哪头收得多就往哪头落 ----
    //
    // 钓不到的时候**不沉** —— 沉底空钩是最危险的下饵（那张躺在堆底，
    // 谁匹配到它就通吃整堆，见 foePickCard 里那条 +pile.length*0.5）
    const normal = catchStart(card, true, skills, false)
    const sunk = catchStart(card, true, skills, true)
    const nGain = normal >= 0 ? pile.value.length - normal + 1 : 0
    const sGain = sunk >= 0 ? sunk + 2 : 0
    return sGain > nGain
  }

  // 【活水】：牌库顶那几张写成一行。没带这件、或者牌库空了就是空串
  const liveText = computed<string>(() : string => {
    if (!hasSpecial(false, SP_LIVEWATER) || deck.value.length == 0) {
      return ''
    }
    const tops = topCards(LIVE_OPEN)
    let text = ''
    for (let i = 0; i < tops.length; i++) {
      text = text + (i == 0 ? '' : '、') + cardName(tops[i])
    }
    return '活水 · 牌库顶：' + text
  })

  const myRoleName = computed<string>(() : string => {
    return roleTag(false)
  })

  const foeRoleName = computed<string>(() : string => {
    return roleTag(true)
  })

  function loadoutOf(byFoe : boolean) : DrawLoadout {
    return byFoe ? foeLoadout.value : myLoadout.value
  }

  // ---------- 【死水】废掉的那几张牌 ----------
  //
  // 存的是**牌对象的引用**，不是下标也不是点数 —— 那几张牌会在
  // 手牌 / 堆 / 牌库之间流转，而对象身份一路不变。
  //
  // 为什么不用 held：held 那一族的解除条件是「效果牌离场」，
  // 而死水**不可解**（规格见 draw-skills 那条）。挂进去反而要多写一条
  //「这一条永不过期」的例外。
  //
  // 一局一清（见 newGame）。跨局留着的话，上一局被废的那张牌
  // 这一局还是废的 —— 而牌组是同一副，对象引用也还是同一批
  const deadCards = ref<PlainCard[]>([] as PlainCard[])

  // 这张牌被死水废了吗。
  //
  // 手写循环比对象身份，**不用 indexOf** —— UTS 在各平台上
  // indexOf 怎么比对象并不一致（inPile、pullFromDeck 也是手写的，同一个理由）
  function isDead(card : PlainCard) : boolean {
    for (let i = 0; i < deadCards.value.length; i++) {
      if (deadCards.value[i] == card) {
        return true
      }
    }
    return false
  }

  // ---------- 【通配】贴过标签的那几张牌 ----------
  //
  // 存**牌对象引用**，照 deadCards 那个模式 —— 而**不是**加第七条
  // 并行数组。那不是图省事：标签跟着**牌**走，所以 pushPile /
  // removePileAt / 收牌重建那六处一处都不用改，也就不会出
  //「六条并行数组少一条就错位」那种事。
  //
  // 读的时候比 `pile.value[i]`，所以牌一离开堆标签自动失效 ——
  // 词条里那句「钓走了标签也跟着没」是这么实现的，不需要清理代码。
  //
  // 清单会随局面长一点（离场的牌还留在里面），那是**故意的**：
  // 清理要在每条收牌路后面各加一次，而那正是 burnOnLand 那段警告的
  //「写在调用处就一定会漏」。比引用，零维护
  const wildCards = ref<PlainCard[]>([] as PlainCard[])

  function isWild(card : PlainCard) : boolean {
    for (let i = 0; i < wildCards.value.length; i++) {
      if (wildCards.value[i] == card) {
        return true
      }
    }
    return false
  }

  // 堆上第 index 格带通配吗
  function isWildAt(index : number) : boolean {
    if (index < 0 || index >= pile.value.length) {
      return false
    }
    return isWild(pile.value[index])
  }

  function addWild(card : PlainCard) {
    if (isWild(card)) {
      return
    }
    // **换引用而不是 push** —— 它是 ref，照 addHeld / deadCards 那条理由
    wildCards.value = wildCards.value.concat([card])
  }

  // 打出这张牌会触发哪几件技能。
  //
  // **死水废掉的牌一件都不触发** —— 这是「废牌」的一半
  //（另一半是点数算 0，在 valuesOf 里）。
  // 只写 valuesOf 那一半是不够的：triggersOf 读的是 suit 和 rank，
  // 跟点数毫无关系，所以一张被置 0 的 7 照旧会触发 7 槽上那件技能
  function skillsOf(byFoe : boolean, card : PlainCard) : number[] {
    if (isDead(card)) {
      return [] as number[]
    }
    return triggersOf(loadoutOf(byFoe), card.suit, card.rank)
  }

  // 手牌底下那行小字：这张会触发的技能名
  function skillTag(card : PlainCard) : string {
    const list = skillsOf(false, card)
    let text = ''
    for (let i = 0; i < list.length; i++) {
      text = text + (i == 0 ? '' : '·') + DRAW_SKILLS[list[i]].name
    }
    return text
  }

  // 照**这一轮的牌组构成**发牌，不是照标准 52 张。
  //
  // 构成存在档里（见 draw-save 的 cards），商店里买的改造道具和新牌
  // 都落在那儿。没改造过就是标准 52 张。
  //
  // 终局模式用标准牌：它不读存档的装备，也就不该读存档的牌组 ——
  // 那一局跟你这一轮攒了什么毫无关系
  function buildPlainDeck() : PlainCard[] {
    const list : PlainCard[] = []
    const composed = finalMode ? standardDeck() : deckOf(save.value)
    for (let i = 0; i < composed.length; i++) {
      const rank = rankOfText(composed[i])
      const card : PlainCard = {
        suit: suitOfText(composed[i]),
        rank: rank,
        value: valueOfRank(rank),
        // 终局模式用标准 52 张，身上不带点数卡（standardDeck 写不出 '+'）
        extra: pipsOfText(composed[i])
      }
      list.push(card)
    }
    // Fisher-Yates 洗牌
    for (let i = list.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1))
      const tmp = list[i]
      list[i] = list[j]
      list[j] = tmp
    }
    return list
  }

  // ---------- 开局剔牌：把**发完牌之后的牌库**凑成偶数张（最多剔 1 张） ----------
  //
  // ---- 2026-10-15 改了两处，先说删掉的那一道闸 ----
  //
  // 原先是「剔到不超过 DECK_PLAY（52）张、而且牌组是偶数」。**52 那道上限
  // 删了**：它当初守的是「技能触发率表按 52 张算」和「一局不越拖越长」，
  // 可代价是把买卡的语义削掉一块（买 12 张、剔掉 12 张，等于没买）。
  // 终局规则改成「牌库空 + 双方各打 1 手」之后，一局的长短本来就由牌库
  // 直接定，上限没必要了 —— 牌组现在可以任意厚（上限只剩 DECK_CAP 那个
  // 「权重池」语义）。
  //
  // ---- 偶数这一道**必须留**，而且锁的是牌库、不是牌组 ----
  //
  // 实测（TAIL_PLAYS=2、剩堆不算分、各 20000 局，`md-sim` 的 DROP 旋钮）：
  //
  //              52张偶  50张偶  51张奇  49张奇
  //   后手分差     +0.31   +0.30   −0.90   −0.91
  //   出牌数相等后  +0.31   +0.30   −0.38   −0.40
  //
  // 奇数那两档偏的是**终局那几手的结构**：牌库奇数张时先手多摸一张，于是
  // 牌库空在他的回合末 ——
  //   偶数 → 终局是「先手打、后手打」，后手那一手 100% 无人回应；
  //   奇数 → 终局是「后手打、先手打、后手打」，后手打两手、其中一手被回应。
  // 后手的终局优势被稀释一半。「双方出牌数要相等」那条（见 checkOver）
  // 只补回 43%，剩下的 0.69 分补不掉 —— 所以奇偶得在开局就锁死。
  //
  // **锁牌库而不是锁牌组**：发几张走 handLimit，而【添手】（庄家 +1）和
  // 【掐口】（玩家 −1）会让发牌总数变成奇数 —— 那时「牌组偶数」正好
  // 得出牌库奇数。原先那道闸漏了这两条，而闯关里它们各占一关、恒偏庄家。
  //
  // **调用点在 baitFor 之后、buildRankTotals 之前**，两头都是硬性的：
  //   囤饵塞 3 张（奇数），排在它前面的话这道闸被它绕过去；
  //   剔掉的牌这一局不在场，所以要在算 rankTotal 之前剔 ——
  //     不然庄家的记牌（outsideCount）会把剔掉的也算进「外面还剩几张」。
  //
  // 剔的是**牌顶**（数组末尾，照 drawFor 的 pop）。洗过了，所以剔掉那一张是随机的。
  // 返回剔了几张（0 或 1）—— 开局那句 message 要说一声
  function trimDeck() : number {
    // 发牌总数。切出来那张算在先手那一份里（它进先手的手牌，见下面发牌那段），
    // 所以牌库最终是「牌组 − foeDeal − myDeal」
    const dealt = handLimit(true) + handLimit(false)
    const rest = deck.value.slice(0)
    let cut = 0
    // 一次就够（剔一张奇偶就翻），写成 while 是为了万一 dealt 的算法以后变了。
    // `> dealt` 那个条件是防护：牌组最少 DECK_MIN 张、dealt 最多 9，
    // 所以现实里走不到，但少了它、万一牌组薄过发牌数就会 pop 到负数去
    while (rest.length > dealt && (rest.length - dealt) % 2 != 0) {
      rest.pop()
      cut = cut + 1
    }
    if (cut > 0) {
      deck.value = rest
    }
    return cut
  }

  // 堆里这张对出牌的一方来说是不是被护着：对方护的才挡，自己护的不挡自己
  function guardedAgainst(index : number, byFoe : boolean) : boolean {
    const g = pileGuard.value[index]
    if (g == GUARD_NONE) {
      return false
    }
    return byFoe ? g == GUARD_ME : g == GUARD_FOE
  }

  // ---------- 堆上这一格被**庄家侧的关卡规则**锁住了，当不了匹配点 ----------
  //
  // 两条特殊技走这儿，而且**只有这一个入口**：
  //
  //   【硬壳】 庄家打出的 ♠（认牌面花色）
  //   【炙水】 庄家打出的、**现在带着燃烧**的那些
  //
  // 原先这个函数叫 `shelled`、只管硬壳。改名是因为它回答的那个问题
  // 从一开始就比「是不是硬壳」一般 —— 而七个调用处写的都是
  // `guardedAgainst(i, byFoe) || matchLocked(i, byFoe)`，
  // 加第二条规则时**一处都不用动**。
  // 另开一个 `charred()` 再去七处各加一个 `||` 才是会漏的那条路。
  //
  // 跟护饵（pileGuard）长得像，但**不是同一回事**，所以不能复用它：
  //
  //   护饵是**一张牌的状态**（稳钩给头几张挂上，收走就没了），
  //   这两条是**一整关的规则**（庄家打的每一张都算，打多少张都算）。
  //
  // 存成 pileGuard 的话，每次 pushPile 都得记得判一次 ——
  // 而漏判一次就是「有一张 ♠ 莫名其妙钓得走」那种查不出来的 bug。
  //
  // **J 通吃收得走**：那是这两条唯一的解，而 catchStart 的 J 那一支
  // 在这个函数之前就 return 了，所以这儿天然不管 J
  function matchLocked(index : number, byFoe : boolean) : boolean {
    if (byFoe) {
      return false
    }
    if (!pileByFoe.value[index]) {
      // 两条都只管**庄家打出的**那些。你自己的牌带火照旧钓得走 ——
      // 不然【沸水】×【炙水】就是「堆上所有牌你都碰不到」，
      // 那不是题目，是墙
      return false
    }
    // 硬壳认**牌面**花色，不认 pileSuitAt —— 它说的是「它打出来的那张是 ♠」，
    // 而染水那类改的是「堆上这张现在算什么花色」。
    // 认现算的话，庄家一染水就能把整堆变成硬壳，那太离谱了
    if (hasFoeSpecial('shell') && pile.value[index].suit == SUITS[0]) {
      return true
    }
    // ---- 炙水是硬壳的**状态版** ----
    //
    // 硬壳认的是印死的花色（♠ 四分之一，定额）；炙水认的是燃烧，
    // 而燃烧是**庄家自己造出来的**（沸水在场时落堆的牌都带火、
    // 燎原每打一张牌往两边爬一格）。所以它的覆盖面会长，硬壳的不会。
    //
    // 它也因此**自带一个解**：野火把带火的牌收走 —— 那是庄家自己的牌，
    // 所以它清自己的锁。你的解照旧是 J 或者从更深处连带收走
    return hasFoeSpecial('char') && pileBurnAt(index) > 0
  }

  // ---------- 【浊水】：堆厚过 MURK_DEEP 张时，深处那些你看不见是什么 ----------
  //
  // **纯渲染层** —— 规则一个字没改，堆的数据照旧全在（庄家是程序，
  // 它读的是数据不是屏幕，所以「庄家照旧全看得见」自动成立）。
  //
  // 藏的是**内容**不是**格子**：那一格还画着、描边还告诉你是谁打的，
  // 只有「它是什么牌」变成了问号。两条理由：
  //
  //   v-for 的下标是真实下标，onPilePick / inCatch 全靠它 ——
  //     少渲染几格会让点击和收牌特效全部错位；
  //   「堆有多厚、谁打的多」本来就是数得出来的（张数印在顶栏），
  //     藏那个只会让界面看着像坏了。
  //
  // 它跟记牌那条原则（『信息要给够』）确实是反着的，所以设计稿里
  // 它只给**终局**那张卡（东海龙王）—— 不是普通关卡的规矩
  function murked(index : number) : boolean {
    if (!hasFoeSpecial('murk')) {
      return false
    }
    if (pile.value.length <= MURK_DEEP) {
      return false
    }
    return index < pile.value.length - MURK_SHOW
  }

  // 打出这张会从堆里第几张开始收，-1 表示钓不到。skills 是这张触发的技能。
  //   J 通吃：堆上有牌就从第 0 张收起，护饵也挡不住；
  //   同点数（磁钩：或者比它大 1 的点数）：找最靠前的那张，被对方护着的跳过；
  //   顺色：同花色的也算，跟点数那条**并列**；
  //   钩顶：上面都对不上，就钓堆顶那一张。
  //
  // **从 i = 0 往上找**，所以命中的一定是最深那张 —— 收得最多。
  // 顺色不用为「把中间的牌一起收走」另写一行：返回 i 就是「从那张收到堆顶」。
  //
  // 点数比的是 pileVals 而不是牌面 —— 堆上那张算哪几个点数会变
  //（顺色落堆就一个都不算，见底把整堆压下去，点数卡给它多贴几个）。
  // J 那条还是认 rank：通吃焊在「J 这张牌」上，不是「11 点」上。
  //
  // 两边都是**点数列表**，所以「点数相等」变成了「两个列表有交集」——
  // 一张贴过点数卡的 ♠3+7 跟堆上的 3 和 7 都对得上。
  //
  // ---- sink（沉底）把搜索方向整个反过来 ----
  //
  // 普通打法这张落堆顶，收「匹配那张 → 堆顶」，所以**匹配得越深收得越多**
  // —— 从 i = 0 往上找，命中最深那张。
  //
  // 沉底这张落堆底，收「堆底 → 匹配那张」，所以**匹配得越高收得越多**
  // —— 从堆顶往下找，命中最高那张。两条都是「尽量多收」，只是镜像
  function catchStart(card : PlainCard, byFoe : boolean, skills : number[],
    sink : boolean) : number {
    const size = pile.value.length
    if (card.rank == JACK) {
      // J 通吃：不管落堆顶还是堆底，整堆都收。
      // 沉底时要的是「最高那张」（收到堆顶），普通时是「最深那张」
      if (size == 0) {
        return -1
      }
      // ---------- 【逆钩】：你打 J 只收 REV_TOPS 张 ----------
      //
      // 判在这儿而不是收牌那一头：这个函数返回的就是「从第几张开始收」，
      // 所以把起点往上挪就是全部实现 —— 收牌、算分、记牌、特效
      // 四条路一个字都不用改。
      //
      // **只管玩家**（庄家的 J 照旧通吃）—— 它是关卡的题目，不是场地规则，
      // 跟封竿同一条边界。
      //
      // 两个方向都要收口，不然沉底就成了它的漏洞：
      //   普通（落堆顶）→ 从 size − 3 收到堆顶；
      //   沉底（落堆底）→ 从堆底收到第 2 格。
      // 堆比 3 张还薄的时候退回整堆（那时候「只收 3 张」本来就是整堆）
      if (!byFoe && hasFoeSpecial('rev')) {
        if (size <= REV_TOPS) {
          return sink ? size - 1 : 0
        }
        return sink ? REV_TOPS - 1 : size - REV_TOPS
      }
      return sink ? size - 1 : 0
    }
    // 【封竿】原先在这儿直接拦（被封的点数什么都钓不到）。改成了「算 0 点」，
    // 在 valuesOf 最前面判 —— 0 点钓不到按点数的牌，按花色的照样能用
    const hook = hasTrigger(skills, SK_HOOK)
    const suited = hasTrigger(skills, SK_SUITED)
    // 我这张算哪几个点数。顺色换掉了整个点数，所以它这儿是空的 ——
    // 空列表跟谁都没交集，点数那两条线对它一概不成立
    const mine = valuesOf(card, byFoe, skills)
    // 〔【量水】那一支 2026-10-16 跟 measureFor 一起清掉。它留下三条判据：
    //
    //   **一、「整堆」那类技能判在遍历之前。** 它收得最多，先走普通判定的话
    //     随便命中一张浅的就把它盖掉了（这儿是「先宽后窄」，跟
    //     resolveMatch 里「从堆顶往下找最浅那一张」的方向相反）。
    //
    //   **二、一网打尽的东西，「护着的牌」是网里的洞 —— 不能绕。**
    //     下面那条普通判定撞上【稳钩】/【硬壳】是 `continue`（绕过去接着找），
    //     因为它们挡的是**起点**；而整堆类绕过一张就不叫整堆了，只能整条作废。
    //     这是【稳钩】【硬壳】现在唯一还能「一张挡一整网」的用法 —— 一色那边
    //     也照这条走（见 5058 附近）。
    //
    //   **三、这儿是落堆之前估的**（庄家挑牌、手牌高亮），堆里还没有这张；
    //     凡是「数堆上几张」的技能在这个函数里都得 `+1`，在 afterPlay 里不用〕
    // 普通那三条线。**命中就记下来、不再往下找** —— 这个循环的方向
    // 已经保证了命中的是最深那张（收得最多）
    let best = -1
    for (let n = 0; n < size; n++) {
      // 沉底从堆顶往下数，普通从堆底往上数
      const i = sink ? size - 1 - n : n
      // 护饵和硬壳都是「这张跳过去接着找」—— 它们挡的是**起点**，
      // 不是整次钓牌。绕过一张硬壳，还能钓到它底下那张
      if (guardedAgainst(i, byFoe) || matchLocked(i, byFoe)) {
        continue
      }
      const p = pile.value[i]
      const theirs = pileValsAt(i)
      // 花色比的是 pileSuitAt 而不是牌面 —— 染水能把整堆染成一个花色
      //（而它**先于这一步**结算，见 playFor 里那段）
      if (suited && sameSuit(pileSuitAt(i), card.suit, byFoe)) {
        best = i
        break
      }
      if (anyEquals(mine, theirs, 0)) {
        best = i
        break
      }
      // 磁钩：对得上**比它大 1** 的点数。J 不吃这条（它自己就是通吃）
      if (hook && p.rank != JACK && anyEquals(mine, theirs, 1)) {
        best = i
        break
      }
    }
    // ---------- 【吃水】：第四条并列的匹配线 ----------
    //
    // 从堆顶往下累加，总和不超过 DRAFT_CAP 的那一段。
    // 规则和那两个常量的理由写在 draw-skills 吃水那条注释里。
    //
    // 跟上面三条取**收得更多**的那个：收的是 [i, 堆顶]，所以
    // **下标越小收得越多** —— 取 min。
    //
    // 不是「吃水优先」也不是「普通优先」，而是「哪条收得多走哪条」——
    // 否则加一条线反而可能让你收得更少，那是说不通的。
    //
    // **沉底时不判**：你这张落堆底，而它从堆顶往下数 —— 两件撞在
    // 同一张牌上是真冲突（插槽时得避开），跟退潮从前那个毛病一样
    if (hasTrigger(skills, SK_DRAFT) && !sink) {
      const reach = draftReach(card, byFoe, mine)
      if (reach >= 0 && (best < 0 || reach < best)) {
        best = reach
      }
    }
    if (best >= 0) {
      return best
    }
    // 这儿原先还有一支【钩顶】（都对不上就钓紧贴着你这张的那一张）。
    // 那件技能删了，所以判定到这儿就只有「钓不到」一个结果。
    //
    // 它当初逼出过一条规则值得记着：钩顶钓的是「紧贴着」那张，
    // 所以**沉底的时候要镜像**（普通落堆顶→钓堆顶，沉底落堆底→钓堆底）。
    // 不镜像的话「沉底 + 钩顶」就是个无条件全堆清场 ——
    // 钩顶本来就在「什么都对不上」时触发，那太常见了。
    // 以后再加这类「钓相邻那张」的技能，这条得一起加回来
    return -1
  }

  // ---------- 【吃水】够得着的最深那张 ----------
  //
  // 返回下标，-1 = 没成（爆了，或者只够吃 1 张）。
  //
  // 预算 = DRAFT_CAP − 它自己的点数。多值牌（贴过点数卡的）取**最小**那个
  // —— 预算留最大。照的是「任一个点数对得上就算匹配」那条规则，
  // 往对玩家有利的方向读。
  //
  // 往下走时三条，都是现有规则直推的：
  //   **0 点**加 0、**不断链** —— 它是免费垫片，让你跨过去拿更深的；
  //   **无点数断链** —— 它不在点数轴上，所以顺色 / 封色 / 压邻
  //     是吃水的天然反制（往堆顶丢一张就封掉它）；
  //   **护饵 / 硬壳断链** —— 跟量水一个待遇：这一段必须是连续的，
  //     绕过一张就不叫「从堆顶往下累加」了。
  //
  // 超预算就**停**，不是跳过 —— 点数非负，后面只会更大
  //（0 点那种不增的已经在上面收下了）
  function draftReach(card : PlainCard, byFoe : boolean, mine : number[]) : number {
    const size = pile.value.length
    if (size == 0) {
      return -1
    }
    let own = 99
    for (let k = 0; k < mine.length; k++) {
      if (mine[k] < own) {
        own = mine[k]
      }
    }
    // 它自己没有点数（顺色之类把它抹了）：那它不占预算
    if (own == 99) {
      own = 0
    }
    const budget = DRAFT_CAP - own
    if (budget < 0) {
      return -1
    }
    let sum = 0
    let deepest = -1
    let got = 0
    for (let i = size - 1; i >= 0; i--) {
      if (guardedAgainst(i, byFoe) || matchLocked(i, byFoe)) {
        break
      }
      const vals = pileValsAt(i)
      if (vals.length == 0) {
        break
      }
      let v = 99
      for (let k = 0; k < vals.length; k++) {
        if (vals[k] < v) {
          v = vals[k]
        }
      }
      if (sum + v > budget) {
        break
      }
      sum = sum + v
      deepest = i
      got = got + 1
    }
    // **只够吃 1 张就算没成**（见 draw-skills 的 DRAFT_MIN）——
    // 不然它是「稳赚 2 分、零风险」，而收色和撒网都立过同一条闸
    if (got < DRAFT_MIN) {
      return -1
    }
    return deepest
  }

  function canCatch(card : PlainCard, byFoe : boolean) : boolean {
    const skills = skillsOf(byFoe, card)
    return catchStart(card, byFoe, skills, hasTrigger(skills, SK_SINK)) >= 0
  }

  // 庄家手里第 index 张你看得见吗。
  //
  // 两条路：窥视单独翻开过（foeShown），或者你的照水正亮着 ——
  // 照水是**总开关**，它亮着的时候连它期间新补的牌也一样明着，
  // 所以不能靠往 foeShown 里写标记，得在这儿现判
  function foeOpen(index : number) : boolean {
    if (heldOn(SK_LANTERN, false)) {
      return true
    }
    // 【清水】（角色的常驻技能）：对方**前 CLEAR_OPEN 张**手牌一直明着
    //（2026-10-16 起是 4 张 —— 标准手牌就是 4 张，所以通常等于全看）。
    //
    // 按下标算，所以明的永远是最左边那几张。手牌会打出去、会补，
    // 下标一直在动 —— 于是「哪几张明着」是流动的。那正好，
    // 不然对手能靠藏牌位置骗你。
    //
    // **按下标而不是「全部」是有意的**：手牌上限被【满篓】【添手】抬高时，
    // 它只明前 4 张 —— 对手因此藏得住后面那几张。
    // 这一条写进 desc 了（「4 张」不是「全部」），理由见 CLEAR_OPEN 那段
    if (index < CLEAR_OPEN && hasSpecial(false, SP_CLEAR)) {
      return true
    }
    // 压舱、摘钩、对换正等你挑的时候，它那一手**全明着** ——
    // 这三件技能的说明就是「看对方全部手牌，挑 1 张」，
    // 看不见就没法挑。这也是它们跟【冻结】的分界：冻结挑的是位置
    if (takeSkill.value >= 0) {
      return true
    }
    return index < foeShown.value.length && foeShown.value[index]
  }

  // 你的手牌第 index 张庄家看得见吗。标在牌上告诉你「这张它知道」
  function foeKnows(index : number) : boolean {
    if (heldOn(SK_LANTERN, true)) {
      return true
    }
    return index < handSeen.value.length && handSeen.value[index]
  }

  function inPile(card : PlainCard) : boolean {
    for (let i = 0; i < pile.value.length; i++) {
      if (pile.value[i] == card) {
        return true
      }
    }
    return false
  }

  // 挂一条效果上去。
  //
  // **换引用而不是 push** —— held 是 ref，而牌桌上那条「场上效果」栏
  // 读它渲染。原地 push 在 uvue 这边不保证触发更新，
  // 项目里别的几条 ref 数组（pile、deck…）也都是换引用
  function addHeld(one : HeldEffect) {
    held.value = held.value.concat([one])
  }

  // ---------- 【保护】：挂在 held 里的一个标签 ----------
  //
  // 为什么不另开一条跟 pile 对齐的平行数组：这个文件已经有**五条**了
  //（pile / pileByFoe / pileGuard / pileVals / pileSuit），每一处收牌、
  // 见底、收色都要同步增删，漏一条就错位 —— 注释里为这件事警告过两次。
  //
  // 挂进 held 白拿三样：
  //   **场上效果栏自动显示**（fieldChips 读 held），玩家看得见哪张扛得住；
  //   **牌离场自动清理**（expireHeld 按 source 还在不在堆上过滤）；
  //   **净水自动反制它**（净水清的就是某张牌名下的 held 条目）。
  //
  // skill 字段填**发它那件技能的下标**（SK_CALM）—— held 要一个数，
  // 而用凝水自己的下标最省事，顺带让场上效果栏印出「凝水」
  function wardAt(index : number) : boolean {
    return wardUnder(index) >= 0
  }

  // 第 index 张底下垫着几个**盾** —— 它能扛几次。
  //
  // 保护**能叠多层**，一层扛一次（每层都是一张实体牌，所以账是清的）
  function wardLayers(index : number) : number {
    if (index < 0 || index >= pile.value.length) {
      return 0
    }
    const card = pile.value[index]
    let n = 0
    for (let i = 0; i < stacked.value.length; i++) {
      if (stacked.value[i].kind == STACK_WARD && stacked.value[i].host == card) {
        n = n + 1
      }
    }
    return n
  }

  // 垫在第 index 张底下那个**盾**在 stacked 里的下标，-1 = 没有。
  //
  // 返回下标而不是 bool，因为收牌那一下要把它**取出来**
  //（它代替宿主被收走），不只是问「有没有」。
  // 叠了多层的话**每次取一个** —— 哪一个无所谓，它们都只是一张盾
  function wardUnder(index : number) : number {
    if (index < 0 || index >= pile.value.length) {
      return -1
    }
    const card = pile.value[index]
    for (let i = 0; i < stacked.value.length; i++) {
      if (stacked.value[i].kind == STACK_WARD && stacked.value[i].host == card) {
        return i
      }
    }
    return -1
  }

  // 第 index 张底下压着几张**不算盾的**（抬水垫的 / 净水埋的）。
  //
  // 它回答的是「收走这一叠值几分」—— 盾不算在里头，因为盾不是收成，
  // 它是「还得再收一次」。两个角标分开画就是这个理由（见模板那段）
  function underCount(index : number) : number {
    if (index < 0 || index >= pile.value.length) {
      return 0
    }
    const card = pile.value[index]
    let n = 0
    for (let i = 0; i < stacked.value.length; i++) {
      if (stacked.value[i].host == card && stacked.value[i].kind != STACK_WARD) {
        n = n + 1
      }
    }
    return n
  }

  // 第 index 张底下 / 下面压着几张（画角标用）。盾、加过点的、被盖的都算
  function stackCount(index : number) : number {
    if (index < 0 || index >= pile.value.length) {
      return 0
    }
    const card = pile.value[index]
    let n = 0
    for (let i = 0; i < stacked.value.length; i++) {
      if (stacked.value[i].host == card) {
        n = n + 1
      }
    }
    return n
  }

  // 把第 index 张那一叠底下的牌全取出来（收整叠时用）。
  // 顺带从 stacked 里摘掉 —— 返回的那几张要算分、要进 goneRanks
  function takeStack(index : number) : PlainCard[] {
    if (index < 0 || index >= pile.value.length) {
      return [] as PlainCard[]
    }
    const card = pile.value[index]
    const out : PlainCard[] = []
    const keep : Stacked[] = []
    for (let i = 0; i < stacked.value.length; i++) {
      if (stacked.value[i].host == card) {
        out.push(stacked.value[i].card)
      } else {
        keep.push(stacked.value[i])
      }
    }
    if (out.length > 0) {
      stacked.value = keep
    }
    return out
  }

  // ---------- 【结冰】：挂在 held 里的第二种标签 ----------
  //
  // 走 held 而不是开第七条平行数组，理由跟【保护】那条**一模一样**
  //（见上面那段）：场上效果栏自动显示、牌离场自动清理、净水自动反制。
  // 文件头那条「加第七条之前先把这六条包成一个结构」的警告因此不用动。
  //
  // ---- 它跟保护的分工，这是它值得单独存在的全部理由 ----
  //
  //   **保护** —— 垫着那张**代替宿主离场**，所以收牌方**照旧拿 1 分**；
  //   **结冰** —— **没有牌离场，也没有分**。
  //
  // 一个是续命（保住自己的牌），一个是拒收（削对手的收成）。
  //
  // ---- 它作用在「收牌」，不在「匹配」 ----
  //
  // 现有让牌难拿走的三件（护饵 / 硬壳 / 炙水）全挡在匹配判定上
  //（`matchLocked`：它当不了匹配的那一张）。结冰不碰那儿 ——
  // 带结冰的牌照旧能当匹配点、照旧能发起一次收牌，**只是它自己不跟着走**。
  // 所以它的落点是 takeAt，而不是 catchStart
  function frostAt(index : number) : boolean {
    if (index < 0 || index >= pile.value.length) {
      return false
    }
    return frostOn(pile.value[index])
  }

  // 按**牌**问（净水换牌、叠放那几条都按牌认，照 cleanAt0 那条先例）
  function frostOn(card : PlainCard) : boolean {
    for (let i = 0; i < held.value.length; i++) {
      if (held.value[i].skill == SK_FROST && held.value[i].source == card) {
        return true
      }
    }
    return false
  }

  // 去掉第 index 格的冰。返回去掉了没有
  function clearFrostAt(index : number) : boolean {
    if (index < 0 || index >= pile.value.length) {
      return false
    }
    const card = pile.value[index]
    const keep : HeldEffect[] = []
    let gone = false
    for (let i = 0; i < held.value.length; i++) {
      if (held.value[i].skill == SK_FROST && held.value[i].source == card) {
        gone = true
        continue
      }
      keep.push(held.value[i])
    }
    if (gone) {
      held.value = keep
    }
    return gone
  }

  // 给第 index 格贴冰。返回**真贴上了吗**。
  //
  // 两道闸都在这儿，所以贴冰只有这一个入口：
  //   **碰上燃烧 → 两个一起消失**（清火、不贴冰），见 TERMS 那条；
  //   **不可叠加** → 已经带冰就什么也不做（自带收益递减，
  //     所以结凌打第二次不用另写上限规则）
  function addFrostAt(index : number, byFoe : boolean) : boolean {
    if (index < 0 || index >= pile.value.length) {
      return false
    }
    if (pileBurnAt(index) > 0) {
      const next = pileBurn.value.slice(0)
      next[index] = 0
      pileBurn.value = next
      return false
    }
    if (frostAt(index)) {
      return false
    }
    addHeld({
      source: pile.value[index], skill: SK_FROST,
      target: null, byFoe: byFoe
    } as HeldEffect)
    return true
  }

  // 冰火相消的**另一个方向**：贴火之前问一句。
  //
  // 有冰 → 清掉冰、返回 true，调用处就**不贴火**（两个都没了）。
  //
  // 贴火那几条路各自的做法不一样（沸水落堆时 +1、野火「已带火的直接收走」、
  // 燎原蔓延），所以相消不能写成一个「替你贴火」的函数 ——
  // 但判断那一下必须共用，不然三处各写一遍、漏一处就是单向相克
  function iceMeltsFire(index : number) : boolean {
    if (!frostAt(index)) {
      return false
    }
    clearFrostAt(index)
    return true
  }

  // ---------- 收走第 index 格之前，先过一遍结冰和叠放 ----------
  //
  // **收牌路全走它**（finishSweep / finishCatch / dropPile / dropBottomToFoe）
  //（原先还有一条 floodFor，洪水 2026-10-16 删了）—— 这段逻辑写四遍
  // 必有一遍写错，而写错的表现是「牌没了但分没加」或者反过来，都是静默的。
  //
  // 它干两件事，返回**这一格实际收走几张**：
  //
  //   **带结冰** → 去掉结冰，返回 **0**。**那一格留下，而且一分都不算** ——
  //     这是结冰跟保护唯一但要紧的区别。
  //   带保护 → 取走垫着的一张盾（代替宿主），返回 1。
  //     **宿主留下** —— 所以调用处要先问 blockedAt(i) 再决定留不留，
  //     不能看返回值（返回 1 的两种情况不一样）。
  //   两样都没有 → 宿主 + 底下压着的全收，返回 1 + 那几张。
  //
  // **结冰排在保护之前**：它不消耗任何东西、也不计分，所以先结算免费的
  // 那一层，账更好读（而且一张牌同时带冰和盾时，玩家只看见「冰挡了一次」）。
  //
  // ---- 豁免（【结凌】那半句）读的是 `iceBlindNow`，不是参数 ----
  //
  // 「它这一手不受结冰影响」是个**回合级**的语义，而这一手可能收好几次牌
  //（它自己匹配一次，而同一张牌上的见底 / 收色 / 洪水又各收一次）——
  // 那几次都该豁免。传参就得在五个调用点分别判断「这一手是不是结凌」，
  // 那比读一个回合级的变量更容易错。
  //
  // 代价是**必须及时清掉**，两处都要（见 playFor 和 finishCatch）：
  //   playFor 开头每次重设 —— 结凌那一手没钓中时也不会漏；
  //   finishCatch 收完立刻清 —— 不然走水 / 过闸那两条**庄家规矩**
  //     就在它下面几行，会蹭上我的豁免。
  //
  // gone 是出参：离场那几张的 rank 往里推（庄家记牌的依据）。
  // **算分和记牌口径一致** —— 推进 gone 的张数就是返回的张数，
  // 而结冰那一支两个都是 0
  function takeAt(index : number, gone : string[]) : number {
    if (!iceBlindNow && frostAt(index)) {
      clearFrostAt(index)
      return 0
    }
    const ward = wardUnder(index)
    if (ward >= 0) {
      const shield = pullStacked(ward)
      if (shield != null) {
        gone.push(shield!.rank)
      }
      return 1
    }
    gone.push(pile.value[index].rank)
    let n = 1
    const under = takeStack(index)
    for (let k = 0; k < under.length; k++) {
      gone.push(under[k].rank)
      n = n + 1
    }
    return n
  }

  // 这一格**留在堆上**吗（被结冰或者保护挡住了）。
  //
  // 调用处原先问的是 wardAt(i)，加了结冰之后那个问法不够了 ——
  // 换成这一个，五条收牌路一处都不用再想「还有没有别的挡法」。
  // 口径必须跟 takeAt 一致（连豁免一起），不然会出现
  // 「takeAt 收走了但调用处以为它留下」那种错位
  function blockedAt(index : number) : boolean {
    if (!iceBlindNow && frostAt(index)) {
      return true
    }
    return wardAt(index)
  }

  // 摘掉 stacked 里第 at 条，返回那张牌（保护被消耗时用）
  function pullStacked(at : number) : PlainCard | null {
    if (at < 0 || at >= stacked.value.length) {
      return null
    }
    const card = stacked.value[at].card
    const keep : Stacked[] = []
    for (let i = 0; i < stacked.value.length; i++) {
      if (i != at) {
        keep.push(stacked.value[i])
      }
    }
    stacked.value = keep
    return card
  }

  // 宿主离场了的，整叠跟着清 —— 不然那几张永远留在 stacked 里。
  // 跟 expireHeld 一个道理，所以每次收完牌一起调
  function expireStacked() {
    const keep : Stacked[] = []
    for (let i = 0; i < stacked.value.length; i++) {
      if (inPile(stacked.value[i].host)) {
        keep.push(stacked.value[i])
      }
    }
    stacked.value = keep
  }

  // ---- 原先这儿有 addWard 和 consumeWards，两个都删了 ----
  //
  // 它们是**抽象标签**那一版的保护：保护挂在 held 里，所以要一个函数
  // 去加标签、另一个去「这一批收牌里扛住了的那几张把标签清掉」。
  //
  // 叠放之后保护是**一张垫着的实体牌**，于是：
  //   加 → 往 stacked 里塞一条（见 doPilePick 的凝水那支，而且**能叠多层**）；
  //   消耗 → pullStacked 把那张取出来、进 goneRanks、算一分
  //     （见 takeAt —— 四条收牌路共用）。
  //
  // 删它们顺带修了一个 bug：finishSweep 既走了 pullStacked 又调了
  // consumeWards，**同一个盾被消耗两次**
  //
  // 【净水】：去掉某张牌名下**所有**在场效果。
  //
  // 清的是**标签**不是**结果** —— pileVals 一个字不碰，所以
  // 「已经变 0 或无点数的不还原」（见 draw-skills 净水那条）。
  // 返回清掉几条，给播报用
  function cleanAt(index : number) : number {
    if (index < 0 || index >= pile.value.length) {
      return 0
    }
    return cleanAt0(pile.value[index])
  }

  // 按**牌**清（净水盖住一张之后要清被埋那张的效果，而那时它
  // 已经不在 pile 里了，按下标找不着）
  function cleanAt0(card : PlainCard) : number {
    const keep : HeldEffect[] = []
    let gone = 0
    for (let i = 0; i < held.value.length; i++) {
      if (held.value[i].source == card) {
        gone = gone + 1
        continue
      }
      keep.push(held.value[i])
    }
    if (gone > 0) {
      held.value = keep
    }
    return gone
  }

  // 凝水 / 净水等着的时候那条提示
  const pilePickText = computed<string>(() : string => {
    if (pilePick.value == SK_CALM) {
      return '凝水：点堆上一张给它贴保护 —— 那张被收走时不走一次'
    }
    if (pilePick.value == SK_CLEAN) {
      return '净水：点堆上一张去掉它所有在场效果（已经变 0 或无点数的不还原）'
    }
    if (pilePick.value == SK_RAISE) {
      return '抬水：点堆上一张给它加 ' + pickStep.value
        + ' 点 —— 加完它会判一次匹配'
    }
    // 野火：提示里**点出那条最优选法**，因为它是这件技能的全部决策，
    // 而玩家第一次玩算不出来（火有两条前沿、蔓延在同一手内结算）
    if (pilePick.value == SK_WILD) {
      return '野火：点堆上一张给它贴【燃烧】—— 点在没烧着那一段的中间，'
        + '火往两边各爬一格，全场烧着就整堆收走'
    }
    // 伏流：同理点出选法 —— 通配是**填缺口**用的，而「哪儿是缺口」
    // 要在堆上心算点数，第一次玩算不出来
    if (pilePick.value == SK_FLOW) {
      return '伏流：点堆上一张给它贴【通配】—— 你刚打的那张已经自带通配，'
        + '所以这一张是**第二个**任意点数，点在能补上缺口的那张；贴完当场判顺子'
    }
    return ''
  })

  // 堆上第 index 格现在点得点不得（界面高亮用）。
  //
  // 凝水 / 净水 / 抬水：堆上哪张都行。
  // **野火不行** —— 已经烧着的、带保护的、带冰的那几格点不着
  //（跟 wildfireFor 里那个 free 列表同一个条件）。
  //
  // 不把这三条写进界面的话，玩家会去点一个点不动的格子、
  // 然后以为是 bug —— 而规则上那三格确实是「挡住了」
  function canPickAt(index : number) : boolean {
    if (pilePick.value < 0) {
      return false
    }
    if (pilePick.value == SK_WILD) {
      return pileBurnAt(index) == 0 && !wardAt(index) && !frostAt(index)
    }
    // 伏流：已经带通配的那张再贴一次是空操作，所以点不着。
    //
    // **打出那一张也点不着**〔2026-10-16〕—— 它自带通配（那进了
    //【顺子匹配】的规则），再贴一张标签上去是白费一张。
    // 不挡的话玩家会点它、然后发现什么都没变 —— 而规则上它确实已经是通配了，
    // 所以这是「界面要把规则说清楚」那一类，不是手感问题
    if (pilePick.value == SK_FLOW) {
      const self = pickCard.value == null ? -1 : pileIndexOf(pickCard.value!)
      return index != self && !isWildAt(index)
    }
    return true
  }

  // 玩家点了堆上第 index 张（-1 = 不挑）。
  //
  // 牌**已经丢弃了**（见 playFor 那条分支），所以「不挑」就是白丢一张 ——
  // 跟开包「放弃」一个道理：代价在发动那一刻就付了
  function onPilePick(index : number) {
    const which = pilePick.value
    if (which < 0) {
      return
    }
    // 点不着的格子当没点（界面上它也没高亮，见 canPickAt）——
    // 野火那一档会有这种格子（已烧着 / 带保护 / 带冰）。
    // **不能当成「不挑」**：那会把这一手的点火机会白扔掉
    if (index >= 0 && !canPickAt(index)) {
      return
    }
    const step = pickStep.value
    const card = pickCard.value
    pilePick.value = -1
    pickStep.value = 0
    pickCard.value = null
    // ---- 【野火】走的是另一条路：它**已经落堆了** ----
    //
    // 凝水那三件在落堆之前就把牌丢弃了，所以挑完（或不挑）直接
    // 走 afterPlay 从头跑尾段。野火不行 —— 它的牌在堆上，
    // 而尾段已经跑到它那一段了，回头重跑会把前面那些技能再触发一遍。
    //
    // 所以它从 **TAIL_REST**（野火之后那一段）接着走，而且**必须接**：
    // 后面还有燃烧那一步（蔓延 + 燃尽）和匹配。
    //
    // 「不挑」也照样接 —— 不挑只是没点火，这一手的其余部分照常
    if (which == SK_WILD) {
      const skills = pickSkills
      pickSkills = []
      if (index >= 0 && index < pile.value.length) {
        doWildPick(false, index)
      } else {
        message.value = message.value + ' 野火：没挑，这一手没点火。'
      }
      afterPlayTail(false, skills, TAIL_REST)
      return
    }
    // ---- 【伏流】：贴完标签**还要回去判顺子** ----
    //
    // 这是跟野火不一样的地方：野火贴完火就完事了（燃尽那一步在后面的
    // 通路里），而伏流贴完得**当场**用那个标签去凑顺子 ——
    // 所以它不能像野火那样直接跳到下一段，得重新走一次 straightFor。
    //
    // 重入时 `pilePick` 已经清了（上面那几行），所以那个
    //「玩家侧就暂停」的分支不会再触发 —— 不然会无限等下去
    if (which == SK_FLOW) {
      const skills = pickSkills
      pickSkills = []
      // 立起重入闸 —— 下面那次 straightFor 不能再暂停一遍（见它那段）
      flowPicked = true
      if (index >= 0 && index < pile.value.length) {
        addWild(pile.value[index])
        message.value = message.value + ' 伏流：给第 ' + (index + 1)
          + ' 张贴上【通配】。'
      } else {
        message.value = message.value + ' 伏流：没挑，这一手没贴标签。'
      }
      // 开演收牌特效了就别往下走，演完由 finishSweep 接
      if (!straightFor(false, skills)) {
        afterPlayTail(false, skills, TAIL_WADE)
      }
      return
    }
    if (card == null || index < 0 || index >= pile.value.length) {
      // 没挑：那张牌**哪儿都没去** —— 没进堆、也没叠上去，等于出场了。
      // 代价在发动那一刻就付了（照开包「放弃」那条规矩）
      message.value = message.value + ' '
        + DRAW_SKILLS[which].name + '：没挑，这张白放了。'
      afterPlay(false)
      return
    }
    // 开演收牌特效了就别调 afterPlay —— 演完由 finishSweep 接着走
    if (!doPilePick(which, index, false, step, card!)) {
      afterPlay(false)
    }
  }

  // 真正落效果的那一下。两侧共用 —— 庄家不点屏幕，它走 foePilePick 选下标
  // 返回 **true = 开演收牌特效了**，调用处就别再调 afterPlay ——
  // 演完由 finishSweep 从 TAIL_HEAD 接着走（照一色那条路）。
  // 只有抬水会返 true（另两件不收牌）
  // card 是**要叠上去那张** —— 三条叠放都要把它放进 stacked，
  // 所以它得一路带进来（丢弃那一版不需要，因为牌直接出场了）
  function doPilePick(which : number, index : number, byFoe : boolean,
    step : number, card : PlainCard) : boolean {
    const who = byFoe ? '庄家' : ''
    const name = cardName(pile.value[index])
    // ---------- 凝水：**垫在它下面当盾** ----------
    //
    // 宿主获得保护。被收走的那一下，**垫着这张代替它走**、保护消失。
    // 于是「积分 = 收走的张数」精确成立 —— 真有一张牌离场了
    if (which == SK_CALM) {
      // ---- 保护**能叠多层**，一层扛一次 ----
      //
      // 这不是额外加的规则，是叠放模型自带的：每一层都是一张实体牌，
      // 收走一层就离场一张、算一分。所以每一层都满足
      //「积分 = 收走的张数」—— 叠到三层也不会让账算不清。
      //
      // 从前保护是抽象标签，这儿有一道「已经有了就不许叠」的闸，
      // 理由是「扛两次会让一张牌最多算三次分」。**那个理由随标签变实体牌
      // 一起作废了** —— 拆掉它
      const layers = wardLayers(index)
      stacked.value = stacked.value.concat([{
        host: pile.value[index], card: card, kind: STACK_WARD
      } as Stacked])
      message.value = message.value + ' ' + who + '凝水：垫在 ' + name
        + ' 底下 —— 它现在能扛 ' + (layers + 1) + ' 次。'
      return false
    }
    // ---------- 净水：**盖在它上面代替它** ----------
    //
    // 盖住就等于埋掉 —— 被盖那张不再是「当前牌」，所以它身上的在场效果
    // 一概不生效（照水不照、封色不封、分水不分）。
    //
    // 「已变的点数不还原」自动成立：pileVals[index] 换成**盖上去那张**的
    // 点数，底下那张的点数跟它一起埋了，没有「还原」这回事。
    //
    // 换掉的是**五条平行数组里的三条**（pile / pileVals / pileSuit）——
    // pileByFoe 跟着换成盖牌的归属，pileGuard / pileBurn 留着
    //（护饵和燃烧挂在那个**位置**上，不挂在牌上）
    if (which == SK_CLEAN) {
      const buried = pile.value[index]
      stacked.value = stacked.value.concat([{
        host: card, card: buried, kind: STACK_BURIED
      } as Stacked])
      const nextPile = pile.value.slice(0)
      nextPile[index] = card
      pile.value = nextPile
      const nextVals = pileVals.value.slice(0)
      nextVals[index] = landVals(card, byFoe, [] as number[], false)
      pileVals.value = nextVals
      const nextSuit = pileSuit.value.slice(0)
      nextSuit[index] = card.suit
      pileSuit.value = nextSuit
      const nextBy = pileByFoe.value.slice(0)
      nextBy[index] = byFoe
      pileByFoe.value = nextBy
      // 被埋那张身上的在场效果**当场失效** —— 它不再是当前牌。
      // held 按 source 认牌，所以直接清掉它名下那几条
      const gone = cleanAt0(buried)
      message.value = message.value + ' ' + who + '净水：盖住 ' + name
        + '，现在这一格算 ' + cardName(card) + '。'
        + (gone > 0 ? '它那 ' + gone + ' 条在场效果跟着埋了。' : '')
      return false
    }
    // ---------- 【抬水】：加点数，然后那一张判一次匹配 ----------
    //
    // step 是**被丢弃那张的牌面点数**（不是 valuesOf —— 它已经不在场上了，
    // 而且牌面那个数写在牌上、谁都数得出来，跟退潮一个口径）
    const was = pileValsAt(index)
    if (was.length == 0) {
      // 无点数的牌不在点数轴上，加它没有意义（规则：无点数不受增减影响）
      message.value = message.value + ' ' + who + '抬水：'
        + name + ' 没有点数，抬不动，白丢一张。'
      return false
    }
    const now = raiseVals(was, step)
    const next = pileVals.value.slice(0)
    next[index] = now
    pileVals.value = next
    // **垫在它下面** —— 加的那几点是「底下压着一张牌」的后果，
    // 而不是一个凭空的加值。收走那一叠的时候这张跟着走（多算一分）
    stacked.value = stacked.value.concat([{
      host: pile.value[index], card: card, kind: STACK_BOOST
    } as Stacked])
    message.value = message.value + ' ' + who + '抬水：垫在 ' + name
      + ' 底下，那张加 ' + step + ' 点，现在算 ' + valsText(now) + '。'
    // 点数变了 → 那一张判一次匹配。撞不上就只是点数留在那儿
    const at = raiseMatch(index, byFoe)
    if (at < 0) {
      message.value = message.value + '没撞上。'
      return false
    }
    // 收走「被抬那张 ↔ 匹配那张」，两端都含
    const lo = at < index ? at : index
    const hi = at < index ? index : at
    const taken : number[] = []
    for (let i = lo; i <= hi; i++) {
      taken.push(i)
    }
    message.value = message.value + '撞上 ' + cardName(pile.value[at])
      + '，收走 ' + taken.length + ' 张。'
    // skills 传空：抬水已经结算完了，而被抬那张的技能**不响**
    //（它不是「打出」，见 draw-skills 抬水那条注释）
    return startSweep(byFoe, taken, [] as number[], TAIL_HEAD)
  }

  // 被抬那张现在撞得上谁。返回下标，-1 = 撞不上。
  //
  // 挑**离它最远**的那个 —— 收走的是两者之间那一段，所以越远收得越多。
  // 护饵 / 硬壳挡住的跳过（它们挡的是「当不了匹配的那一张」）
  function raiseMatch(index : number, byFoe : boolean) : number {
    const mine = pileValsAt(index)
    let best = -1
    let far = -1
    for (let i = 0; i < pile.value.length; i++) {
      if (i == index || guardedAgainst(i, byFoe) || matchLocked(i, byFoe)) {
        continue
      }
      if (!anyEquals(mine, pileValsAt(i), 0)) {
        continue
      }
      const d = i > index ? i - index : index - i
      if (d > far) {
        far = d
        best = i
      }
    }
    return best
  }

  // ---------- 〔删了〕mergeFor（合流） ----------
  //
  // **2026-10-16 清掉，约 120 行**（全表清掉的最长一个）。
  // 技能 10-14 删的，X **−1.14**。
  //
  // ---- 死因那一条是全表最容易犯的误算 ----
  //
  // > **「多一个匹配点」漏算了匹配是双向的。** 多一条路钓别人，
  // > 同时也多一条路被别人钓 —— 而这个玩法里「被钓走」的损失
  // > **大于**「钓到」的收益（收走的是一整段，从匹配那张到堆顶）。
  //
  // 加任何「多一个点数 / 多一条匹配线」的技能都要先过这一条。
  //
  // ---- 它留下四条实现判据，每条都还有适用对象 ----
  //
  // **一、「追加」不是「相加」。** 7 吃掉 9 之后它同时算 7 和 9，不是 16 ——
  //   相加过了 13 就没人够得着，**那本身是一道自带的闸**；追加没有那道闸。
  //
  // **二、无点数的牌吃不到点数。** 一张顺色牌打合流要是能把无点数吃回点数，
  //   那就是**给代价开了后门** —— 无点数是那几件技能换钓牌通道付的价。
  //   同理【死水】废掉的牌也吃不到（口径跟 `valuesOf` 第一行对齐：
  //   「废了就是废了，不该还受别的技能摆布」）。
  //
  // **三、保护是贴给那一张牌的，不随牌转移。** 合流把邻居叠到自己底下时，
  //   垫在邻居下面的**盾**跟过来，但它们**不再是盾**（变成普通被埋牌）——
  //   不然合流就顺手偷了一层保护，而那是它说明里没有的第四条好处。
  //
  // **四、「优先」那一族返回话、不写 message。** 调用点在 `playFor` 里
  //   （落堆之后、判定之前），而那会儿 `message` 还会被调用处整个覆盖 ——
  //   所以话存进 `firstNote`，`afterPlay` 开头再贴上去。
  //   **染水（`suitifyFor`）现在是这个写法的唯一载体。**
  //
  // 〔它还是全表唯一「不收走就移掉一个堆位」的东西 —— 那个能力没有别的
  //   载体了。要再做，先想清楚「移掉的那张算谁的分」（合流的答案是
  //   「谁都不算，它只是垫到底下」）〕

  // ---------- 〔删了〕dredgeFor（抄底） ----------
  //
  // **2026-10-16 清掉，约 55 行。** 技能 10-14 删的（X −0.66，
  // 叠放那一族的「反制」那一半 —— 兑现和反制两件都是负的）。
  //
  // ---- 它留下三条判据，而第三条最值钱 ----
  //
  // **一、对双方都生效才有决策。** 它会把你自己垫的盾、埋的牌一起掀走，
  //   所以你得算「掀掉赚几分 vs 拆掉自己几个锅」。
  //   **改成「只收对方的」就没有决策了，只是个按钮。**
  //
  // **二、「清的是标签不是结果」** —— 掀走【抬水】垫的那张时，
  //   它加的点数**不退**（加点早写进了 pileVals，而抄底收的是牌不是账）。
  //   规则上也只能这样：点数退回去就得问「退回去之后那张撞上谁了、
  //   要不要再判一次匹配」—— 那是**连锁判定**，而这个玩法一律拒绝它
  //  （见底那条注释里拒过同一个问题）。
  //
  // **三、叠放那三件的区别，正是「被掀掉之后的下场」**：
  //     盾（凝水）—— 保护**没了**，宿主当场裸着（盾的全部作用就是那张牌）；
  //     加点（抬水）—— 点数**留着**（效果早兑现完了，牌只是收尾）；
  //     被盖（净水）—— 本来就只是躺在那儿攒分，掀走就是掀走。
  //   这条现在没有载体（抄底是唯一会掀叠放的），但它定义了那三件的边界 ——
  //   再做「动叠放」的技能时照这条分。
  //
  // 〔另外一条实现判据：它**不走收牌特效** —— 那套按 `pile` 的下标亮牌，
  //   而被叠放的牌**不在 `pile` 里**（在 `stacked`）。
  //   所以它也不中断 afterPlay 那条链。任何「收 stacked 里的牌」的
  //   新效果都会撞上同一件事〕

  // 「现在算几点」写成一行（3 / 3,7）。播报用
  function valsText(vals : number[]) : string {
    let text = ''
    for (let i = 0; i < vals.length; i++) {
      text = text + (i == 0 ? '' : ',') + vals[i]
    }
    return text == '' ? '无点数' : text + ' 点'
  }

  // 庄家挑哪张。
  //
  //   **凝水** —— 挑自己**带着在场效果**的那张（保住效果是它的主业）；
  //     一张都没有就挑自己最深那张（最可能被连带扫到的）。
  //   **净水** —— 挑**你**身上在场效果最多的那张；你一条都没有就不挑
  //     （留着也没用，但代价已经付了）。
  //
  // 两条都只看「在场效果挂在谁名下」，不猜点数 —— 跟源码里别的
  // 庄家启发式一个口径：读得到的信息才用
  function foePilePick(which : number, step : number) : number {
    // ---- 抬水：**算得准**，所以它不猜 ----
    //
    // 它试遍每一张：加上 step 之后撞得上谁、那一段有多长，挑最长的。
    // 这跟玩家能做的判断一模一样（整堆是明的），所以这儿没有
    // 「庄家作弊」的问题 —— 信息双方对称。
    //
    // 撞不上任何东西就**不挑**：抬水的封堵那一侧要算「对手下一手打什么」，
    // 那超出了这套启发式的能力（见 ai.js 里那条「读得到的信息才用」）
    if (which == SK_RAISE) {
      let pick = -1
      let most = 0
      for (let i = 0; i < pile.value.length; i++) {
        const was = pileValsAt(i)
        if (was.length == 0) {
          continue
        }
        // 试着抬一下，看撞得上谁 —— 不改真数据，只算
        const probe = raiseVals(was, step)
        let far = -1
        for (let k = 0; k < pile.value.length; k++) {
          if (k == i || guardedAgainst(k, true) || matchLocked(k, true)) {
            continue
          }
          if (!anyEquals(probe, pileValsAt(k), 0)) {
            continue
          }
          const d = k > i ? k - i : i - k
          if (d > far) {
            far = d
          }
        }
        if (far >= 0 && far + 1 > most) {
          most = far + 1
          pick = i
        }
      }
      return pick
    }
    let best = -1
    let bestCount = 0
    for (let i = 0; i < pile.value.length; i++) {
      let n = 0
      for (let k = 0; k < held.value.length; k++) {
        // 凝水找自己的效果，净水找你的
        const want = which == SK_CALM
        if (held.value[k].source == pile.value[i] && held.value[k].byFoe == want) {
          n = n + 1
        }
      }
      if (n > bestCount) {
        bestCount = n
        best = i
      }
    }
    if (best >= 0) {
      return best
    }
    if (which == SK_CLEAN) {
      // 你身上一条效果都没有：不挑
      return -1
    }
    // 凝水兜底：自己最深那张（下标最小的那张庄家牌）
    for (let i = 0; i < pile.value.length; i++) {
      if (pileByFoe.value[i]) {
        return i
      }
    }
    return -1
  }

  // 效果牌已经离场的，清掉。每次收完牌调一次
  function expireHeld() {
    const next : HeldEffect[] = []
    for (let i = 0; i < held.value.length; i++) {
      if (inPile(held.value[i].source)) {
        next.push(held.value[i])
      }
    }
    held.value = next
  }

  // ---------- 「场上效果」栏 ----------
  //
  // 挂在牌上的效果**常驻摆出来**，挂到失效为止。
  //
  // ---- 为什么非摆不可 ----
  //
  // 从前 held 只在逻辑里读、一次都没渲染过，于是这几件的状态
  // 只在触发那一瞬间往战况框里写一句话，之后就被下一条战况冲掉了。
  //
  // 对照水、窄口那几件这还只是「不方便」。可抹点数那三件
  //（压邻、封色、分水）**改的是每一张落堆牌算几点** ——
  // 玩家不知道场上挂着封色，就根本算不出自己这张打下去值几点。
  // 那不是「要记」，那是信息没给。
  //
  // ---- 写什么 ----
  //
  // 锚点在前、名字在后（跟技能栏一个规矩）。但这儿的锚点写的是**后果**，
  // 不是覆盖面 —— 牌桌上你要的答案是「我这张会怎样」，
  // 而不是「这个技能管哪几格」。
  type FieldChip = {
    // held 里的下标。点一下要按它查原条目
    at : number
    byFoe : boolean
    // 后果（♠没点数、奇数→0点…）
    anchor : string
    name : string
  }

  const fieldChips = computed<FieldChip[]>(() : FieldChip[] => {
    const out : FieldChip[] = []
    // ---- 【结冰】**只摆一条**，张数写在锚点里 ----
    //
    // 它是全表唯一会一次挂上好几条 held 的（结凌给**全场**贴），
    // 一张一条会把这一栏刷爆（堆常有四五张）。
    //
    // 而且不刷爆也没必要：**冰在牌上直接标着**（那个「冰」角标），
    // 所以这一栏对它的用处只剩「现在场上冻着几张」—— 一条就够
    let frostShown = false
    for (let i = 0; i < held.value.length; i++) {
      const one = held.value[i]
      if (one.skill == SK_FROST) {
        if (frostShown) {
          continue
        }
        frostShown = true
      }
      out.push({
        at: i,
        byFoe: one.byFoe,
        anchor: fieldAnchor(one),
        name: DRAW_SKILLS[one.skill].name
      } as FieldChip)
    }
    return out
  })

  // 堆上现在冻着几张（场上效果栏那一条的锚点用）
  function frostCount() : number {
    let n = 0
    for (let i = 0; i < pile.value.length; i++) {
      if (frostAt(i)) {
        n = n + 1
      }
    }
    return n
  }

  // 这条效果**现在对牌桌做什么**，一句短话。
  //
  // 〔压邻 / 封色 / 分水那三支 2026-10-16 清掉（技能 10-14 删的）。
  //   封色那一支留下一条写法上的判据：**它读的是那张牌「现在」的花色**
  //   （而不是牌面），所以得先查它在堆里第几张 —— 任何「读堆上牌的花色」
  //   的地方都该走 `pileSuitAt` 而不是 `card.suit`。
  //   现在全表只剩 `pileRed` 还在用那条，而改花色的机制本身也没了〕
  function fieldAnchor(one : HeldEffect) : string {
    if (one.skill == SK_LANTERN) {
      return '手牌明置'
    }
    if (one.skill == SK_FREEZE) {
      return '锁1张'
    }
    // 结冰：锚点报**现在冻着几张**（这一条是汇总的，见 fieldChips）。
    // 写「收不走」而不是「结冰」—— 这一栏要的是后果，不是机制名
    if (one.skill == SK_FROST) {
      return frostCount() + '张收不走'
    }
    // 别的（窄口、满篓……）没有「一句话后果」可写，就留空 ——
    // 标签上只剩技能名，点一下看全文
    return ''
  }

  // chipAt 的号段：0+ 是你的技能栏，100+ 是庄家的，200+ 是场上效果。
  // 三栏共用一个 chipAt，所以点了新的会自动把旧的收起来
  const FIELD_CHIP_BASE : number = 200

  // 点「场上效果」栏的一格：说明框改播它的全文 + **挂在哪张牌上、堆里第几张**。
  //
  // 后面那半句是重点 —— 挂牌效果的解除条件就是「那张牌被钓走」，
  // 所以「它埋得多深」是玩家唯一需要的破解信息
  function showField(index : number) {
    const at = FIELD_CHIP_BASE + index
    if (chipAt.value == at) {
      closeChip()
      return
    }
    if (index >= held.value.length) {
      return
    }
    const one = held.value[index]
    chipAt.value = at
    const spot = pileIndexOf(one.source)
    const where = spot >= 0
      ? '挂在 ' + cardName(one.source) + '（堆里第 ' + (spot + 1) + ' 张）'
      : '那张牌已经不在堆上了'
    chipHead.value = (one.byFoe ? '庄家 · ' : '') + DRAW_SKILLS[one.skill].name
      + ' 〔场上〕 · ' + where
    chipBody.value = DRAW_SKILLS[one.skill].desc + '钓走那张牌，效果就解除。'
  }

  // byFoe 那一方打出的某个效果还挂着吗。
  // 比如 heldOn(SK_LANTERN, false) = 「你的照水还亮着」
  function heldOn(skill : number, byFoe : boolean) : boolean {
    for (let i = 0; i < held.value.length; i++) {
      if (held.value[i].skill == skill && held.value[i].byFoe == byFoe) {
        return true
      }
    }
    return false
  }

  // 这张手牌被冻住了吗（打不出去）
  function isFrozen(card : PlainCard) : boolean {
    for (let i = 0; i < held.value.length; i++) {
      if (held.value[i].skill == SK_FREEZE && held.value[i].target == card) {
        return true
      }
    }
    return false
  }

  // 堆上第 index 张**存着**的那几个点数 —— **不走任何在场效果**。
  // 数组还没对齐的那一瞬间（刚 concat 完）退回牌面那一套。
  //
  // ---- 收牌时重建那几条数组**必须用这个**，不能用 pileValsAt ----
  //
  // 后者带着「带燃烧的牌无点数」那一支，而重建会把它的结果
  // **写死进 pileVals** —— 于是火被收掉之后那几张牌还是无点数，不还原。
  // 在场效果的定义是「它在场时才算」，写死就破了那条。
  //
  // 判据很好记：**这一行会不会写回 pileVals？** 会，就用 rawVals。
  // 游戏代码里有八处（六处 keepVals / keep2Vals 重建，加退潮和见底各一处写回）
  function rawVals(index : number) : number[] {
    if (index < pileVals.value.length) {
      return pileVals.value[index]
    }
    return index < pile.value.length ? cardVals(pile.value[index]) : ([] as number[])
  }

  // 堆上第 index 张**现在算哪几个点数**。匹配判定走这个。
  //
  // ---- 这儿曾经有一支「带燃烧的牌无点数」，**定稿时撤掉了** ----
  //
  // 它有效（野火 +0.50 → +3.28），但它跟【燃烧】定稿第 2 条
  //（燃烧不改变牌的其他状态）冲突，而那一条是这一族的**对位解**：
  // 带火的牌保留点数，所以对手能在火烧过来之前把它钓走。
  // 七倍缺口改由**自动蔓延**补（见 spreadFire）。
  //
  // 所以它现在跟 rawVals 完全一样 —— 两个函数留着是**有意的**：
  // 全表将来要是再有「在场期间改堆上点数」的效果，
  // 那八处写回 pileVals 的地方必须读 rawVals，不然在场效果会被写死。
  // 那个坑是焦壳踩出来的，拆开的两个名字就是它留下的护栏
  function pileValsAt(index : number) : number[] {
    return rawVals(index)
  }

  // 这张牌**印着**的那几个点数：牌面那个 + 点数卡贴上来的
  function cardVals(card : PlainCard) : number[] {
    const out : number[] = []
    // 无点数牌（商店买的、【抹点】抹的）一个点数都没有 —— 跟顺色那张一样不在点数轴上。
    // 零点牌照常走下面：它的点数就是 0（valueOfRank 认不出 '0'，回 0）
    if (card.rank == BLANK_RANK) {
      return out
    }
    out.push(card.value)
    for (let i = 0; i < card.extra.length; i++) {
      // 贴重了就不重复算（界面上也只写一个）
      if (!hasValue(out, card.extra[i])) {
        out.push(card.extra[i])
      }
    }
    return out
  }

  function hasValue(list : number[], v : number) : boolean {
    for (let i = 0; i < list.length; i++) {
      if (list[i] == v) {
        return true
      }
    }
    return false
  }

  // mine 里有没有哪个数，加上 gap 之后等于 theirs 里的某个数。
  // gap = 0 是「点数相等」，gap = 1 是磁钩那条（对得上大 1 的）。
  // **任一边是空的就一定返回 false** —— 那正是顺色落堆后该有的样子。
  //
  // ---- 0 点和 0 点**不算相等** ----
  //
  // 这是一条规则，不是实现细节：0 点的意思是「这张见底了」，
  // 而两张都见了底的牌不该还能互相钓。不设这条的话，一次见底压下来
  // 之后堆上可能躺着一排 0 点牌，而它们两两通吃 —— 那不是见底该有的后果。
  //
  // 只禁 0 对 0。磁钩那条「0 对 1」照旧成立 —— 那是两个不同的点数，
  // 跟「都见底了」是两回事
  function anyEquals(mine : number[], theirs : number[], gap : number) : boolean {
    for (let a = 0; a < mine.length; a++) {
      if (gap == 0 && mine[a] == 0) {
        continue
      }
      for (let b = 0; b < theirs.length; b++) {
        if (theirs[b] == mine[a] + gap) {
          return true
        }
      }
    }
    return false
  }

  // ================= 规则：点数减不到负数，最小是 0 =================
  //
  // **这是一条全局规则，不属于任何一件技能。** 凡是「把堆上的点数往下减」
  // 的效果（【见底】整堆 −1、【退潮】底下几张 −牌面点数，以后再加的也一样）
  // 都走这儿，所以减法的语义只有一份：
  //
  //   每个点数各自减，**减到 0 就停住**，不出现负数；
  //   减重了的不重复塞（一张 [2,3] 减 5 得 [0]，不是 [0,0]）——
  //     界面上那个「现在算几点」只写一个 0 才读得顺；
  //   **空列表原样返回** —— 没有点数的牌（顺色、洪水、封色那几件留下的）
  //     压根不在点数这条轴上，减它没有意义。
  //
  // 把它提成一个函数而不是在每件技能里各写一遍，是因为这条规则
  // **决定了一串别的判定**（0 对 0 不算相等、撒网把 0 当偶数、
  // 见底收走没有非零点数的牌），那些判定都假定「0 是个实打实的点数」。
  // 哪天有人在某一件技能里把它写成「减成负数」或者「减到 0 就删掉」，
  // 那一串判定会一起错，而且错得很难查
  function dropVals(was : number[], by : number) : number[] {
    if (was.length == 0) {
      return was
    }
    const now : number[] = []
    for (let k = 0; k < was.length; k++) {
      let v = was[k] - by
      if (v < 0) {
        v = 0
      }
      if (!hasValue(now, v)) {
        now.push(v)
      }
    }
    return now
  }

  // 往上加点数（【抬水】走这条）。dropVals 的镜像，差两处：
  //
  //   **不设上限** —— 「点数往上不设限」是条全局规则（规则弹窗「点数」那节），
  //     所以 7 加 8 就是 15，而整副牌没有 15 点的牌。那不是 bug，
  //     那正是抬水「封堵」那一侧的全部内容。
  //   **空列表照旧原样返回** —— 无点数的牌不在点数轴上，加它没有意义。
  //     这一条跟 dropVals 一字不差（规则：无点数不受增减点数影响）
  function raiseVals(was : number[], by : number) : number[] {
    if (was.length == 0) {
      return was
    }
    const now : number[] = []
    for (let k = 0; k < was.length; k++) {
      const v = was[k] + by
      if (!hasValue(now, v)) {
        now.push(v)
      }
    }
    return now
  }

  // 这张牌还有没有**非零**的点数。
  //
  // 「点数为 0 的牌」说的就是这个：它可能带着好几个点数（贴过点数卡），
  // 只要还剩一个非零的，它就还钓得上人、也还被人钓得上 —— 那不算见底。
  // 全是 0 才算（最常见的情形是只剩一个 0）
  function anyLive(vals : number[]) : boolean {
    for (let k = 0; k < vals.length; k++) {
      if (vals[k] != 0) {
        return true
      }
    }
    return false
  }

  // 堆上第 index 张牌面上写什么。
  //
  // 写的是**现在算哪几个点数**：顺色落堆就一个都没有（写个「—」），
  // 见底能把牌压到 0，点数卡贴过的写成「3/7」。
  // 牌面那个死数字不足以说明判定会怎么走
  function pileFace(index : number) : string {
    const vals = pileValsAt(index)
    if (vals.length == 0) {
      return '—'
    }
    let text = ''
    for (let i = 0; i < vals.length; i++) {
      text = text + (i > 0 ? '/' : '') + faceOfValue(vals[i])
    }
    return text
  }

  // 点数跟牌面对不上了吗。对不上就描色 —— 提醒你别照牌面算。
  //
  // 贴过点数卡的牌**一直**算「对不上」，那是对的：
  // 它牌面写着 3，可判定上它也是个 7，那件事得一直看得见
  function pileShifted(index : number) : boolean {
    if (index >= pile.value.length) {
      return false
    }
    const vals = pileValsAt(index)
    // 无点数牌本来就没点数 —— 「没点数」正是它的牌面，不算对不上
    if (vals.length == 0 && pile.value[index].rank == BLANK_RANK) {
      return false
    }
    if (vals.length != 1) {
      return true
    }
    return vals[0] != pile.value[index].value
  }

  // 牌面那个点数字符串算几点。A–K 查表，熔合出来的 '17' 这种直接读数，
  // 零点 / 无点数是 0（见 draw-save 的 valueOfRankText）
  function valueOfRank(rank : string) : number {
    return valueOfRankText(rank)
  }

  // 原先这儿有个本地的 faceOfValue（点数值写成 J/Q/K）。
  // 点数卡那套要在商店里也写同样的字，所以它搬到 draw-save 去了 ——
  // 这儿改成 import。两处各写一份迟早写出两套规矩

  // 手牌上那个点数卡角标：贴了 7 和 10 就写「·7·10」。没贴过是空串
  function pipTag(card : PlainCard) : string {
    let out = ''
    for (let i = 0; i < card.extra.length; i++) {
      out = out + '·' + faceOfValue(card.extra[i])
    }
    return out
  }

  // 牌名。贴过点数卡的在后面带上那几个点数：♠3·7
  function cardName(card : PlainCard) : string {
    let out = card.suit + rankFace(card.rank)
    for (let i = 0; i < card.extra.length; i++) {
      out = out + '·' + faceOfValue(card.extra[i])
    }
    return out
  }

  function withoutCard(list : PlainCard[], index : number) : PlainCard[] {
    const left : PlainCard[] = []
    for (let i = 0; i < list.length; i++) {
      if (i != index) {
        left.push(list[i])
      }
    }
    return left
  }

  function withoutFlag(list : boolean[], index : number) : boolean[] {
    const left : boolean[] = []
    for (let i = 0; i < list.length; i++) {
      if (i != index) {
        left.push(list[i])
      }
    }
    return left
  }

  // 从某一方手里拿走一张（连同它的「被看过 / 被翻开」标记）
  function takeFromHand(byFoe : boolean, index : number) : PlainCard {
    if (byFoe) {
      const card = foeHand.value[index]
      foeHand.value = withoutCard(foeHand.value, index)
      foeShown.value = withoutFlag(foeShown.value, index)
      return card
    }
    const card = hand.value[index]
    hand.value = withoutCard(hand.value, index)
    handSeen.value = withoutFlag(handSeen.value, index)
    return card
  }

  // 从牌库顶摸一张进对应的手牌。牌库空了返回 null
  function drawFor(byFoe : boolean) : PlainCard | null {
    if (deck.value.length == 0) {
      return null
    }
    const rest = deck.value.slice(0)
    const card = rest.pop()!
    deck.value = rest
    if (byFoe) {
      foeHand.value = foeHand.value.concat([card])
      foeShown.value = foeShown.value.concat([false])
    } else {
      hand.value = hand.value.concat([card])
      handSeen.value = handSeen.value.concat([false])
    }
    return card
  }

  // 新进场的牌带几层火。
  //
  // 【沸水】删了（在场时落堆的牌都带 1 层火），所以现在**恒为 0** ——
  // 新落的牌一律不带火，要等蔓延烧过来（下一手）。
  //
  // ---- 函数留着，而且这不是手松了 ----
  //
  // 它是「牌进场」那四条路的**单一入口**（正常打出、洪水翻上来、
  // 掏手 / 掏库扔上去）—— 写在调用处就一定会漏。
  // 而「新牌带不带火」是这一族最可能再次被设计的那个旋钮：
  // 留着它，下一件要动这个的技能只改一处；删了就得重新把四条路找一遍。
  //
  // **但要当心沸水的教训**：「落堆就带火」买到的只是「提前一手」，
  // 而蔓延下一手就覆盖到了 —— 实测可证的零。
  // 所以下一件动这儿的技能不能只是「让更多牌落堆带火」
  function burnOnLand() : number {
    return 0
  }

  // `spreadOn()`（场上有没有【燎原】牌）**删了** —— 蔓延并进关键词之后
  // 没有任何调用点。场上效果栏是遍历 held 通用显示的，不走这个函数。
  //
  // 删而不是留：**留着没人读的东西会被当成在生效的设定** ——
  // 这一季在【涉水】的旋钮上栽过（定稿改了、默认值没翻，
  // 整张 all 表拿旧档的数定了新档的价）

  // ---------- 【燃烧】自动蔓延：**关键词自带**（定稿 2026-10-13）----------
  //
  // 原先这是【燎原】那一件技能的效果（要它那张牌在场）。并进关键词的理由
  // 是量出来的：**在场效果的强度上限由「它那张牌活多久」决定**，
  // 而堆的换手是 3.3 回合 —— 燎原 X = **−1.24**、同族的焦壳协同只有 +0.08。
  // 想要一个稳定生效的全局规则，就得放进关键词。
  //
  // 它治的是野火那个七倍缺口：**贴火 2.11 张/次，收成只有 0.30** ——
  // 火的留存 ≈ 牌在堆上的留存，烧上去的火等不到下一次收就被人钓走了。
  // 蔓延不保住**那几张**，而是**让火自己长回来**。
  // 配上野火的连锁（压短间隔），留存率 32% → **74%**，野火 +0.51 → **+2.56**。
  //
  // 燎原那个槽位因此空出来了，待重新设计
  //
  // 调用点在 endPlay（每打完一张牌一次，连竿加打的那张也算，见那儿那段注释）。
  //
  // ---- 它**只点火，不收牌** ----
  //
  // 下面那两个条件都是 `next[…] == 0` —— 碰到已经带火的格子什么也不做，
  // 不会「再加一层」把它引爆。**只有【野火】收牌。**
  //
  // 不这么写的话相邻的两处火会互相引爆：火铺开之后每一格都挨着另一格的火，
  // 于是每回合整片自己烧掉 —— 既算不清，又把「野火来收」整个绕过去了。
  //
  // ---- 读旧数组、写新数组，所以**不会级联** ----
  //
  // 要是边读边写，第 0 格的火点着第 1 格、接着循环走到第 1 格又去点第 2 格
  // —— 一个回合就烧穿整堆了。
  // 所以判「这一格原本着没着」用 pileBurnAt（旧值），点火写进 next。
  //
  // ---- 扩散是线性的，因为堆是一维的 ----
  //
  // 一个火源每打一张牌覆盖面 +2（左右各一格）。多个火源会合并。
  // 堆常常只有三五张，所以两三回合铺满；堆养厚了就慢 ——
  // 「限幅」是一维这件事本身给的，不是额外加的规则。
  //
  // 蔓延**不记谁点的**（pileBurn 只存层数），所以对手的燎原也会帮你铺火
  function spreadFire() {
    // **不再判【燎原】在不在场** —— 蔓延是关键词自带的（见上面那段）
    const size = pile.value.length
    if (size == 0) {
      return
    }
    const next = pileBurn.value.slice(0)
    let lit = 0
    // 冰火相消吃掉的格数（播报用）
    let melted = 0
    for (let i = 0; i < size; i++) {
      // 读的是**旧值**，所以这一轮刚点着的不会接着往下传
      if (pileBurnAt(i) == 0) {
        continue
      }
      // ---- 【结冰】挡一次蔓延，而且两个一起消失 ----
      //
      // 爬到带冰的格子：冰化了、火也没爬过去（见 TERMS 结冰那条）。
      // 所以一片冰能钉住火线一回合，代价是那一格的冰没了。
      //
      // **这儿必须判，不然冰只挡野火不挡燎原** —— 那种「只对一半火源有效」
      // 的规则玩家记不住，而且是静默的（看不出是设计还是 bug）
      if (i > 0 && next[i - 1] == 0) {
        if (iceMeltsFire(i - 1)) {
          melted = melted + 1
        } else {
          next[i - 1] = 1
          lit = lit + 1
        }
      }
      if (i < size - 1 && next[i + 1] == 0) {
        if (iceMeltsFire(i + 1)) {
          melted = melted + 1
        } else {
          next[i + 1] = 1
          lit = lit + 1
        }
      }
    }
    // 相消也要落盘（冰在 iceMeltsFire 里已经清了，但火那边的 next
    // 没变过 —— 所以 lit == 0 而 melted > 0 时直接 return 是对的，
    // 别忘了那几格的冰确实化掉了，播报要说一句）
    if (lit == 0 && melted == 0) {
      return
    }
    pileBurn.value = next
    // 不冠技能名了 —— 蔓延是【燃烧】关键词自带的，不属于任何一件技能。
    // 原先这儿写「燎原：」，而那会让玩家以为是对手带了什么
    let note = ' 蔓延：'
    if (lit > 0) {
      note = note + '火又烧着了 ' + lit + ' 张'
    }
    if (melted > 0) {
      note = note + (lit > 0 ? '，' : '') + melted + ' 张结冰挡住了火（两个都化了）'
    }
    message.value = message.value + note + '。'
  }

  function pushPile(card : PlainCard, byFoe : boolean, guard : number, vals : number[]) {
    pile.value = pile.value.concat([card])
    pileByFoe.value = pileByFoe.value.concat([byFoe])
    pileGuard.value = pileGuard.value.concat([guard])
    pileVals.value = pileVals.value.concat([vals])
    // 落堆时花色就是牌面那个；【染水】之后才会跟它不一样
    pileSuit.value = pileSuit.value.concat([card.suit])
    pileBurn.value = pileBurn.value.concat([burnOnLand()])
    frostOnLand(card, byFoe, pile.value.length - 1)
    // 【引火】预约的那层火在这儿兑现。**排在 frostOnLand 后面** ——
    // 见 burnHandOnLand 那段：冰先贴、火后到，两个才相消得对
    burnHandOnLand(card, pile.value.length - 1)
  }

  // 插到**堆底**（下标 0）。【沉底】走这条。
  //
  // 六条并行数组一起挪，少一条就错位 ——
  // 所以这儿和 pushPile 是一对，改一个必须改另一个
  function unshiftPile(card : PlainCard, byFoe : boolean, guard : number, vals : number[]) {
    pile.value = ([card] as PlainCard[]).concat(pile.value)
    pileByFoe.value = ([byFoe] as boolean[]).concat(pileByFoe.value)
    pileGuard.value = ([guard] as number[]).concat(pileGuard.value)
    pileVals.value = ([vals] as number[][]).concat(pileVals.value)
    pileSuit.value = ([card.suit] as string[]).concat(pileSuit.value)
    pileBurn.value = ([burnOnLand()] as number[]).concat(pileBurn.value)
    frostOnLand(card, byFoe, 0)
    burnHandOnLand(card, 0)
  }

  // ---------- 落堆那一下的结冰：**钥匙在这儿变成障碍** ----------
  //
  // 来路只有一条，而它汇到这儿（所以 pushPile / unshiftPile 各只加一行）：
  // **手里带着冰**（自带的那三件、或者被藏凌贴过的）—— 从手冰表摘掉，
  // 在堆上贴回去。那是「穿过去的那张牌落堆又成了新的冰」那一步。
  //
  // 走 addFrostAt，所以**冰火相消和不可叠加都自动守着**。
  //
  // 这儿**不管豁免**：豁免在 playFor 就读完了（iceBlindNow），
  // 而那时它还在手里 —— 顺序反了的话钥匙就失效了
  //
  // 〔原先还有第二条来路 `frostFallOn()`（场上有【霜降】→ 落堆的牌一律贴冰）。
  //   霜降 10-15 删了，那个函数 10-16 跟着清掉 —— 现在这个函数只剩一条路，
  //   **可它还是该留着**：它是「落堆 → 贴冰」唯一的汇合点，
  //   再加来路（比如一件新的驻场贴冰技能）就改这一个地方〕
  function frostOnLand(card : PlainCard, byFoe : boolean, at : number) {
    const hand = frostOnHand(card)
    if (hand) {
      dropFrostHand(card)
      addFrostAt(at, byFoe)
    }
  }

  // ---------- 贴一层火：**这一族唯一的入口** ----------
  //
  // 三道闸照野火那边的 free 过滤：
  //   已经着了 → 空操作（「加上标签」对已有标签的牌本来就是空操作）；
  //   带【保护】→ **点不着**（堆上有一张就让「全堆带火」永远不成立 ——
  //     一张牌锁死整条线，这一族最漂亮的现成对位解）；
  //   带【结冰】→ 相消，两个一起消失。
  //
  // 返回真 = 这一格**新着了**。野火不走这儿（它自己过滤完再 doWildPick），
  // 新来的那几件一律走这儿 —— 三道闸写两遍必有一遍写漏
  function lightAt(index : number) : boolean {
    if (index < 0 || index >= pile.value.length) {
      return false
    }
    if (pileBurnAt(index) > 0 || wardAt(index)) {
      return false
    }
    if (iceMeltsFire(index)) {
      return false
    }
    const next = pileBurn.value.slice(0)
    next[index] = 1
    pileBurn.value = next
    return true
  }

  // 落堆那一下把手里预约的火兑现（照 frostOnLand 的位置调）。
  //
  // **冰先贴、火后到**：pushPile 里 frostOnLand 排在这个函数前面，
  // 所以一张同时带冰带火的牌落下时，冰先贴上、火再来相消 ——
  // 两个一起消失，跟【结冰】词条那句一致。反过来排就成了
  // 「火贴不上、冰还留着」
  function burnHandOnLand(card : PlainCard, at : number) {
    if (!burnOnHand(card)) {
      return
    }
    dropBurnHand(card)
    lightAt(at)
  }

  // 【传火】的连锁：牌库里找一张**同点数**的拿到手。
  //
  // 同点数就是同一件技能（技能按点数槽分配），所以这就是
  // 【获取下一张】那个词条的语义 —— 走 pullFromDeck，所以**取完洗牌库**，
  // 那是词条写明的代价（而且它会毁掉你自己攒的情报）
  function nextSameRank(byFoe : boolean, card : PlainCard) : boolean {
    for (let i = deck.value.length - 1; i >= 0; i--) {
      if (deck.value[i].rank == card.rank) {
        return pullFromDeck(byFoe, deck.value[i])
      }
    }
    return false
  }

  // 堆上第 index 张带着几层火。读不出来算 0（跟 pileSuitAt 同一个兜底理由）
  function pileBurnAt(index : number) : number {
    if (index < pileBurn.value.length) {
      return pileBurn.value[index]
    }
    return 0
  }

  // 堆上第 index 张**现在**是什么花色。读不出来就退回牌面
  // （只会在数组还没对齐的那一瞬间发生，比如刚 concat 完）
  function pileSuitAt(index : number) : string {
    if (index < pileSuit.value.length) {
      return pileSuit.value[index]
    }
    return index < pile.value.length ? pile.value[index].suit : ''
  }

  // 堆上第 index 张现在是红的吗。
  //
  // 〔原注释写「染水改过花色就按改后的算」—— 染水早改成了【一色】
  //   （数花色但不改花色）。**现在没有任何效果会改堆上牌的花色**：
  //   `pileSuit` 的写入点只剩 concat 和收牌后重建。这一层留着是因为
  //   「花色可以被改」是个合理的设计空间，而不是因为现在有谁在用它〕
  function pileRed(index : number) : boolean {
    return isRedSuit(pileSuitAt(index))
  }

  // 这张的花色被【染水】改过吗。改过的在界面上描一下 ——
  // 不然「牌面是 ♠、按 ♥ 算」这件事玩家无从知道，而顺色的匹配全看它
  function pileRecolored(index : number) : boolean {
    if (index >= pile.value.length) {
      return false
    }
    return pileSuitAt(index) != pile.value[index].suit
  }

  // 带「优先」那几件的播报。它们**在 playFor 里就结算了**，
  // 可那会儿 message 还会被调用处整个覆盖掉 —— 所以话先存这儿，
  // 等 afterPlay 开头再贴上去
  let firstNote : string = ''

  // 【连竿】的两个标记。
  //
  // againPending：刚打的那张触发了连竿，还没兑现。只在逻辑里读，
  //               所以是个普通变量。
  // againUsed   ：这个回合已经加打过一次了 —— 加打的那张不再给加打，
  //               所以一回合最多两张（见 passTurn 上面那段）。
  //               **它是 ref**，因为回合标题要读它（turnText 那个 computed）
  let againPending : boolean = false
  const againUsed = ref<boolean>(false)

  // againWaiting：**正在问你「要不要加打」**。
  //
  // 它是 ref 而 againPending 不是 —— 模板要读它（那颗「收手」钮）。
  //
  // **canPlay 故意不排除它**：别的 pending 都是「别的操作没做完，
  // 不能出牌」，而连竿恰恰相反 —— 这会儿就是要你出牌，收手才是另一条路。
  //
  // 为什么要这颗钮：`desc` 写的是「打出后**可**再打 1 张」，可实现一直是
  // 强制。量出来 D=+3.31（后手 −4.09 / 先手 +2.53）—— **撞破了基线优势
  // 3.03，意思是后手带它比不带更差**，而玩家默认是后手。
  // 机制：最优的那张刚打完，加打的大概率钓不到 → 落堆 → 给对手多一个钩点；
  // 而「等下回合手牌补满、堆也变了再打」对后手格外值钱（它的优势本来就是
  // 「我后打，堆上有对手刚放的牌」），强制加打拆的是后手自己的优势
  const againWaiting = ref<boolean>(false)

  // 【一色】（原【染水】）：堆上**它的花色严格最多** → 整堆连它收走。
  //
  // 含它自己数；**打平不算**（2026-10-14 从「最多的之一」收紧，见 suitLeads）；
  // 堆上至少还得有 1 张别的牌 —— 不然空堆上打它就是稳拿 1 分。
  // 不是最多就什么也不做。
  //
  // ---- 2026-10-12 改的，原先是「把整堆染成它的花色」----
  //
  // 原版单带一分不加（实测 −0.7），配顺色也没协同（+0.02）。中间试过两版：
  // 「别的牌全同色才收、否则染」太弱，「最多就收、否则染」也是。
  // 染色那一支最后整个删了 —— 染完的单色堆对双方一样好用，留着反倒是送分。
  //
  // 排在量水同一个位置（afterPlay 最前面）：它收整堆，排后面的话
  // 前面那些技能改过的堆就白改了。开演收牌特效了返回 true
  function suitifyFor(byFoe : boolean, skills : number[]) : boolean {
    if (!hasTrigger(skills, SK_SUITIFY) || lastPlayed == null) {
      return false
    }
    const card = lastPlayed!
    const who = byFoe ? ' 庄家一色：' : ' 一色：'
    if (pileIndexOf(card) < 0) {
      return false
    }
    // 它自己已经进场了，所以堆上只有 1 张就是「只有它自己」
    if (pile.value.length <= 1) {
      message.value = message.value + who + '场上只有它自己，收不了。'
      return false
    }
    if (!suitLeads(card, false, byFoe)) {
      message.value = message.value + who + '堆上 ' + card.suit + ' 不是最多的（打平不算），没收成。'
      return false
    }
    const all : number[] = []
    for (let i = 0; i < pile.value.length; i++) {
      all.push(i)
    }
    message.value = message.value + who + '堆上 ' + card.suit + ' 最多，整堆 '
      + all.length + ' 张收走。'
    return startSweep(byFoe, all, skills, TAIL_HEAD)
  }

  // 堆上它的花色是不是**严格**最多的那门（打平**不算** —— 别的门必须都比它少）。
  // 花色按牌堆上记的算，两色在场时同色的两门算一门（走 sameSuit）。
  // extra = 它还没落堆（庄家估算用），把它自己补算一张
  //
  // ---- 「打平也算」→「严格最多」〔2026-10-14〕----
  //
  // 原先是 `n > mine`（打平放行）。换成 `n >= mine` 的理由：
  //
  // **一色的分跟覆盖面成正比、而且零饱和** —— 模拟器量出每张恒定
  // ≈1.08 分，从 4 张一路线性到 16 张（候潮渔翁那个 16 张槽 X=+17.00、
  // 胜率 96.9%）。它不饱和是因为**收成跟堆的状态无关**：条件满足就整堆走，
  // 堆是 1 张还是 5 张都只算一次成功。别的清场件（洪水 / 吃水 / 撒网）
  // 的收成取决于堆有多厚，清空之后下一次自动变小，**自带饱和**。
  //
  // 而「打平也算」在 3.1 张的薄堆上几乎总是满足 ——
  // 三张牌四门花色，平局太常见。严格最多把条件重新挂回堆的形状。
  //
  // 改完实测（20000 局）：4 张 **+2.81** / 8 张 **+5.56** / 16 张 **+10.71**，
  // **三档保留率都是 63%** —— 条件的宽严是个乘性因子，跟槽大小无关，
  // 它等比压低整条线而保留斜率。而「斜率」是这一类技能有意保留的卖点
  //（见设计文档『技能必须通用』里那条「依赖大槽是允许的」）
  function suitLeads(card : PlainCard, extra : boolean, byFoe : boolean) : boolean {
    let mine = extra ? 1 : 0
    for (let i = 0; i < pile.value.length; i++) {
      if (sameSuit(pileSuitAt(i), card.suit, byFoe)) {
        mine = mine + 1
      }
    }
    for (let k = 0; k < SUITS.length; k++) {
      const s = SUITS[k]
      if (sameSuit(s, card.suit, byFoe)) {
        continue
      }
      let n = 0
      for (let i = 0; i < pile.value.length; i++) {
        if (sameSuit(pileSuitAt(i), s, byFoe)) {
          n = n + 1
        }
      }
      // **>= 不是 >** —— 打平就不算，见上面那段
      if (n >= mine) {
        return false
      }
    }
    return true
  }

  // 打出这张**算哪几个点数**。
  //
  // 顺色是拿整个点数换一次按花色钓 —— 所以带顺色的牌落堆时一个点数都没有：
  // 它钓不上任何人（只走花色那条线），也没人按点数钓得上它。
  // 这份代价是照排竿的【收色】抄的，不加的话「多一条钓牌通道」就是白给。
  //
  // **点数卡贴的那几个点数一起作废** —— 顺色换掉的是「这张牌的点数」
  // 这件事本身，不是「牌面那个数」。贴了三个点数的牌打顺色，三个一起没
  // byFoe 是**打出这张的那一方** —— 加它是为了【归十】：
  // 那件常驻特殊技只把**自己的** Q K 算成 10，所以这个函数必须知道
  // 「现在算的是谁打的牌」。
  //
  // 从前它不带侧 —— 因为它读的全是「这张牌身上的东西」（牌面、点数卡、
  // 这张触发的技能）。归十是第一件**从角色来、改自己手牌点数**的效果，
  // 所以侧这一层第一次有了必要
  function valuesOf(card : PlainCard, byFoe : boolean, skills : number[]) : number[] {
    // ---- 【封竿】：被封的那个点数，你打出来算 **0 点** ----
    //
    // 判在最前面：别的点数技改不回来。0 点钓不到任何牌（0 对 0 不算相等，见 anyEquals），
    // 可它还在点数这条轴上 —— 落堆后见底收得走它，撒网按偶数算它
    //（跟【死水】废掉的牌同一个待遇）。按花色的那些（顺色之类）照样能用。
    // 只管玩家（封竿是庄家的特殊技）。J 不会被封（封的点数取自庄家的点数槽，没有 J）
    if (!byFoe && sealedRank.value != '' && card.rank == sealedRank.value) {
      return [0]
    }
    // ---- 【死水】废掉的牌：算 **0 点** ----
    //
    // 判在最前面，盖掉下面所有分支（包括齐顶那种「改成某个数」的）——
    // 「废了」就是废了，不该还受别的技能摆布。
    //
    // 为什么是 0 点而不是无点数：0 点还在点数这条轴上，所以见底压得动它、
    // 撒网按奇偶收得走它（0 算偶数）。无点数就彻底出局了，
    // 而那反过来会让这张牌**更安全**（谁也碰不着）—— 废牌不该附赠保护。
    //
    // 技能不触发那一半在 skillsOf 里。两边都要，缺一边就不是废牌
    if (isDead(card)) {
      return [0]
    }
    // ---- 「收一片的代价是这张不钓」—— 全表的收牌类技能都靠这一条挡 ----
    //
    // 顺色拿点数换一次按花色钓、收色拿点数换一次按花色的清扫 ——
    // 两件都是「这张牌的点数整个不算了」。
    //
    // 这条是**硬性的**，而理由是防「一张牌收两次」：收牌类技能在
    // afterPlay 里已经收过了，要是它自己还留着点数，resolveMatch
    // 会让它再匹配一次。
    //
    // 〔2026-10-16 从这一族清掉了**六个死分支** ——
    //   `SK_FLOOD`（洪水，10-15 删）以及压底族里那四件
    //  （`SK_VOID` 压邻 / `SK_DUMP` 掏手 / `SK_SPILL` 掏库 /
    //   `SK_HUEVOID` 封色，10-14 删），还有 `SK_DREDGE`（抄底，10-14 删）。
    //
    //   压底族留下一条判据：**【分水】当年不在这一族**，因为它是全族唯一
    //   保留自己点数的 —— 而那正是它敢封那么大面积的前提（它能被钓走）。
    //   「封得越宽，就越该让自己可被反制」这条对新技能仍然适用。
    //
    //   抄底留下另一条：它的无点数是**兜底**不是代价 —— 棋盘上没叠放时
    //   它什么也收不到，那就至少是一张钓不走的安全饵。
    //  「单买是废的」那种技能需要一道兜底，而无点数是最便宜的一道。〕
    //
    // ---- 【野火】**不在这一族**（2026-10-14 最终）----
    //
    // 代价条款在它身上改过四次（无条件无点数 → 条件性 → 置 0 →
    // 不改点数 → 无点数），而最后的答案是「**这个问题不存在**」：
    //
    // 【燃烧】拿到收割权之后（燃尽：全堆带火 → 整堆归出牌方），
    // 野火**不收牌**了 —— 它只点一张火。所以「收一片的代价是这张不钓」
    // 压根不适用，它**保留点数、照常匹配**。
    //
    // 双吃也不用挡：燃尽扫走整堆时它自己也在里面、被收走了，
    // 于是 resolveMatch 找不到它（顺序：落堆 → 场上效果 → 卡牌效果 →
    // 燃烧 → 匹配）。那道闸是**顺序给的，不是代价给的**
    if (hasTrigger(skills, SK_SUITED) || hasTrigger(skills, SK_HUE)
      // ---- 【净滩】（常驻技）：**堆空着时**你打出的牌无点数〔2026-10-16〕 ----
      //
      // 它是这一族里唯一一个**条件性**的，而且唯一一个
      // **走 hasSpecial 不走 hasTrigger**（常驻技不占槽、不挑牌）。
      //
      // ---- 为什么这个条件下「无点数」是纯收益 ----
      //
      // 上面那几件付的是代价：拿这张牌的点数换一次按花色的清扫。
      // 而**空堆上本来就钓不到任何东西** —— 所以这儿不存在「换」，
      // 无点数是白给的。它救的是「空堆白打」的后半：
      // 这一手钓不到（救不了），但**不用给对手留一个钩点**。
      //
      // ---- 读的是「落堆前堆空不空」，而这一点要紧 ----
      //
      // 调用点在 `playFor → landVals → valuesOf`，那时这张牌**还没进堆** ——
      // 所以 `pile.value.length == 0` 问的正是「我这一手是不是打在空堆上」。
      // 落堆之后 `pileVals` 把结果存住了（持久化），后面堆不空了也不影响它。
      //
      // 判在这儿而不是落堆后：无点数是**这张牌的属性**，要在它进堆那一刻定下来
      || (hasSpecial(byFoe, SP_BEACH) && pile.value.length == 0)
      // ---- 【寒流】的无点数〔2026-10-16 补上，欠了两周〕----
      //
      // **它在这一族里的身份跟别人都不一样**：上面那几件的无点数是
      //「收一片的代价」（这张不钓，换一次按花色 / 翻牌的清扫），
      // 而寒流**不收片** —— 它的无点数是**延命手段**。
      //
      // 驻场效果的强度上限由「它那张牌活多久」决定（堆的换手 3.3 回合，
      // 四个点坐实：燎原 −1.24 / 焦壳 +0.08 / 寒色 +1.91 / 霜降 +2.05）。
      // 无点数让它退出点数轴（只有 J / 顺色 / 收色 带得走），
      // 配上落堆底（见 playFor 的 iceSink）一起把那个天花板捅破：
      // **+1.12 的交互，而两句单独量都接近零**（−0.35 / +0.41）——
      // 它们本身不产出任何东西，产出的是「让驻场那句多生效几回合」。
      //
      // ⚠ **只给寒流，不给霜降。** 同样两句加在霜降上是 −2.86 ——
      // 延长一个**对称**效果的寿命等于延长你自己付的税。霜降因此删了
      || hasTrigger(skills, SK_COLDHUE)
      // ---- 【满篓】【窄口】也加这两句〔2026-10-16〕 ----
      //
      // 跟寒流**同一个身份**：无点数在这儿不是「收一片的代价」，是**延命**。
      // 而这两件正是「挂牌型吃 1/7 折扣」那条判据的两个数据点：
      //
      //   窄口 槽技能 0.67 对 江口闸官常驻 **5.35**
      //   满篓 槽技能 0.47 对 背篓渔夫常驻 **4.52**
      //
      // ⚠ 适用条件跟寒流一样 —— **只对私有效果有效**。
      // 这两件都私有（满篓 = 你的手牌上限、窄口 = 对方少补牌而你受益），
      // 所以在范围内；霜降那种「落堆的牌都贴冰、双方同被拦」的不在。
      //
      // ---- 实测：**两句必须一起加，单独「落堆底」是负的** ----
      //
      //   |            | 满篓      | 窄口     |
      //   |------------|-----------|----------|
      //   | 现状       | 0.47      | 0.67     |
      //   | 只加无点数 | 0.56      | 0.95     |
      //   | 只加落堆底 | **−0.09** | **0.21** ← 负 |
      //   | **两句都加** | **1.22** | **1.72** ← 定稿 |
      //
      // **交互 +1.22 / +1.24，而寒流是 +1.12** —— 三件独立实现、三个
      // 几乎相同的数。所以这是个**成套的模块**（值 ≈ +1.2），拆开用亏。
      //
      // 落堆底那一半在 `playFor` 的 `heldSink`（照 `iceSink` 的位置）
      || hasTrigger(skills, SK_CREEL) || hasTrigger(skills, SK_NARROW)) {
      return [] as number[]
    }
    // ---- 【伏流】**不在**上面那一族，而那是量出来的 ----
    //
    // 它最初也给了「无点数」当代价（顺子是它唯一的钓牌方式，回报是
    // 谁也按点数钓不走它）。**那条代价它撑不起** ——
    // `vs flow flow` 20000 局扫了四格：
    //
    //   无点数 + 收那几张   +1.84
    //   无点数 + 收整段     +2.45
    //   有点数 + 收那几张   +2.72
    //   有点数 + 收整段     **+3.41**  ← 定的是这一档
    //
    // 只有两样都给才落进 3~5 的目标档。所以它现在是**双线**技能：
    // 凑成顺子走顺子那条线，凑不成就退回普通点数匹配。
    //
    // **它不会因此变成「谁都接得上」的超级靶子** —— 通配只在
    // straightFor 那一条路径上成立（单向），所以在对手眼里它就是一张
    // 点数普通的牌。合流那个坑（匹配双向 → 靶子变大 → −1.00）不适用
    // 无点数牌**谁也给不了它点数**：齐顶、归深、退潮、见底都是在「它的点数」上改，
    // 而它压根没有那一项。只有花色槽触发得到它（点数槽不收它），
    // 所以撞上这几件只会是花色槽 —— 技能照常发动，它自己照旧没点数
    if (card.rank == BLANK_RANK) {
      return [] as number[]
    }
    // ---- 退潮和见底：**它们自己也归 0** ----
    //
    // 两件都在自己造的那阵退潮里：退潮减掉自己的点数就是 0，
    // 见底压的是整堆、自己当然也在整堆里。
    // 于是两件都钓不到任何牌（0 点互不匹配，见 anyEquals）——
    // 那正是它们该有的样子：**这一手不是用来钓的，是用来施工的**。
    //
    // 见底还因此**连自己一起收走**（它收「点数为 0 的牌」，而它自己就是），
    // 退潮不收牌所以留在堆上。
    //
    // ---- 0 点和「无点数」是两样东西，区别就在这儿 ----
    //
    //   **0 点**在点数这条轴上，值是 0，所以它参与点数运算 ——
    //     撒网按奇偶收它（0 算偶数）、见底按「点数为 0」收它。
    //   **无点数**（返回空列表那一族）压根不在这条轴上 ——
    //     减点数的一概跳过它（dropVals 对空列表原样返回），
    //     所以它**连「被压到底」都做不到**，只能靠 J / 顺色 / 收色 带走。
    //
    // **盖掉点数卡贴的那几个** —— 跟齐顶一样是「改成那个数」，
    // 不是「多一个候选」。贴过三个点数的牌打见底，三个一起归 0
    //
    // 〔`SK_EBB`（退潮）那一支 2026-10-16 去掉了 —— 技能 10-14 就删了〕
    if (hasTrigger(skills, SK_LOWTIDE)) {
      return [0]
    }
    // ---- 齐顶：这张算堆上**同颜色**牌里最大的那个点数 ----
    //
    // 覆盖掉牌面和点数卡 —— 它不是「多一个候选」，是「改成那个数」，
    // 所以落下去必钩中那张（收「那张 → 堆顶」）。
    //
    // 原先是「全堆最大」，模拟器里两种槽都排第一（4 张槽 +4.36、花色槽 +12.89）。
    // 限成同颜色（红 / 黑）之后是 +3.55 / +9.19，回到目标档位。
    // 颜色按 pileSuitAt（染水改过的算改后的）；点数按 pileValsAt（现在算几点）。
    // 堆上没有同颜色的牌：按它自己的点数算，跟普通牌一样去匹配
    if (hasTrigger(skills, SK_PEAK)) {
      const red = isRedSuit(card.suit)
      let top = 0
      let found = false
      for (let i = 0; i < pile.value.length; i++) {
        if (isRedSuit(pileSuitAt(i)) != red) {
          continue
        }
        const vals = pileValsAt(i)
        if (vals.length == 0) {
          // 无点数 = 最大。齐顶抄到的就是「无点数」
          return [] as number[]
        }
        for (let k = 0; k < vals.length; k++) {
          if (vals[k] > top) {
            top = vals[k]
            found = true
          }
        }
      }
      return found ? [top] : cardVals(card)
    }
    // ---- 【归十】：**自己的** Q K 算 10 点 ----
    //
    // 真实 21 点里 10 / J / Q / K 都算 10 —— 这是那套规则搬过来的唯一一条
    // 点数规定，而这个玩法就长在 blackjack 那个目录里。
    //
    // 它**覆盖**牌面（不是追加一个候选，跟归深正好反着），
    // 所以它走在 cardVals 之前：Q 的 12 和 K 的 13 整个换成 10，
    // 点数卡贴的那几个照旧（cardVals 会接着加）。
    //
    // J 不在里头 —— J 没有点数轴（它只通吃），把它算成 10 等于
    // 把通吃换成普通匹配，那是削不是加。
    //
    // ---- 它真正的载荷不是「帮吃水」，是把一个点数槽撑成花色槽那么大 ----
    //
    // 你的 10、Q、K 全算 10，于是一个「10」槽触发在**12 张**你的牌上
    // 而不是 4 张 —— 跟一个花色槽（12 张）一样宽。
    // 所以它只能是**常驻特殊技**（不占槽）；做成点数技能会炸。
    //
    // ---- 它是真双刃，这是它立得住的理由 ----
    //
    //   K 本来是全牌组**最难被钓走**的（K 没有上家，K+1 不存在）——
    //     算成 10 之后对手一张 10 就钓得走；
    //   你自己的 Q 和 K 互相钓得上了（都是 10），白捡一个对子；
    //   **它跟【深海钓手】那张角色互相拆台** —— 深海钓手的卖点就是「K 没有上家」
    const tens = hasSpecial(byFoe, SP_TENS)
      && (card.rank == 'Q' || card.rank == 'K')
    const out = tens ? tenVals(card) : cardVals(card)
    // 归深：**追加** 11 这个候选（不覆盖原来的）。
    //
    // 11 是 J 的数，而 J 打出就通吃走了、从不落堆 —— 所以堆里天生
    // 没有 11 点的牌。这一条等于给带归深的牌开了一个私有钓点：
    // 原来的点数照样能钓，同时两张归深牌互相必钩
    if (hasTrigger(skills, SK_DEEP) && !hasValue(out, 11)) {
      out.push(11)
    }
    // ---- 【软点】：**追加** 1 这个候选 ----
    //
    // 归深的镜像（那件加 11，这件加 1）—— 1 和 11 在 21 点里本来就是
    // A 的软硬一对，所以两件该是一组。
    //
    // 追加而不是覆盖：原来的点数照旧能匹配，只是多一条路。
    // 于是它干两件事：
    //   多一个钓点（A 是堆上最常见的点数之一）；
    //   **给【吃水】腾预算** —— 一张 K 配软点，预算从 8 跳到 20
    //（吃水的预算取 mine 里**最小**那个，见 draftReach）
    if (hasTrigger(skills, SK_SOFT) && !hasValue(out, 1)) {
      out.push(1)
    }
    // 〔【合流】那一支 2026-10-16 清掉（技能 10-14 删的，X −1.14）。
    //   它跟上面两件一个模式（归深追加 11、软点追加 1），只是追加的数
    //   不是写死的，而是这一手吃掉那张的点数。
    //
    //   ---- 它留下两条判据 ----
    //
    //   **一、「追加」而不是「相加」。** 7 吃掉 9 之后它同时算 7 和 9，
    //     不是 16 —— 相加的话 7+9 过了 13，整副牌没人够得着它，
    //     **那本身就是一道自带的闸**；追加没有那道闸，它只会多一条路。
    //     做「改点数」类技能时这个区别决定强度量级。
    //
    //   **二、它的死因：「多一个匹配点」漏算了匹配是双向的。**
    //     多一条路钓别人，同时也多一条路被别人钓 ——
    //     而这个玩法里「被钓走」的损失大于「钓到」的收益
    //    （收走的是一整段，从匹配那张到堆顶）。
    //     **这条是全表最容易犯的误算**，加任何「多一个点数」的技能都要过。〕
    return out
  }

  // Q / K 算 10 点（【归十】走这条）。点数卡贴的那几个照旧算 ——
  // 归十换掉的是**牌面那个数**，不是「这张牌算哪几个点数」这件事本身
  function tenVals(card : PlainCard) : number[] {
    const out : number[] = [10]
    for (let i = 0; i < card.extra.length; i++) {
      if (!hasValue(out, card.extra[i])) {
        out.push(card.extra[i])
      }
    }
    return out
  }

  // ---------- 「落堆算几点」这一层 ----------
  //
  // `valuesOf` 回答的是「**这张牌自己**算几点」—— 只看它身上的技能。
  // 而 `landVals` 回答「它**落到堆上**算几点」—— 场上挂着的效果能改这个。
  //
  // **两个问题概念上不同**，所以分两层（`catchStart` 用的是 `valuesOf`）。
  // 这一层现在是空的（里头那三件 10-14 删了），但分层本身要留 ——
  // 以后再有「落堆专属」的效果就加在这儿。
  //
  // 规矩没变：**凡是「牌落到堆上」的路都得走它**，不许直接用 `valuesOf`
  // 落堆 —— 漏一处，将来加在这一层的效果就对那条路失效。
  function landVals(card : PlainCard, byFoe : boolean, skills : number[],
    sink : boolean) : number[] {
    return valuesOf(card, byFoe, skills)
  }

  // 〔---------- landVals 这一层 2026-10-16 清空了 ----------
  //
  //   它原先在 valuesOf 之上再让场上挂着的三件改一遍：
  //   **压邻**（抹掉紧挨着它右边落下的那张）、**封色**（跟它同花色的没点数）、
  //   **分水**（奇偶跟它不同的置 0）。**三件 10-14 全删了**，
  //   于是这一层整个空了，连 topCarriesVoid / suitSealed / parityBlocked
  //   三个读取端一起清掉（约 60 行）。
  //
  //   **函数本身留着**，两个理由：
  //     `pushPile` / `unshiftPile` 那几条落堆路都在调它，而
  //       **「落堆算几点」和「判定算几点」是两个概念上不同的问题** ——
  //       `catchStart` 用的是 `valuesOf`。这个区分本身是对的，
  //       以后再有「落堆专属」的效果就加在这儿；
  //     `sink` 这个参数留着是因为调用方都在传，而且落堆位置将来可能又要紧。
  //   模拟器那边 2026-10-14 就是这个状态（`landVals` 直接 return valuesOf），
  //   所以这一下顺带把两边对齐了。
  //
  //   ---- 那三件留下一条还在管事的判据 ----
  //
  //   **「无点数」不受「增减点数」影响，但受「变成 X」影响**
  //  （置 0 和置无点数都算）。所以这一层当年**不能**在 out 为空时提前
  //   return —— 一张顺色牌撞上场上的分水，按规则该从「无点数」变成
  //  「0 点」，而那个差别是实打实的（0 点被见底 / 撒网收得走，无点数收不走）。
  //
  //   这条写进了规则弹窗（『点数的全局规则』那一节），而且**现在仍然有效** ——
  //   哪天再做「变成 X」类的效果，它得在这一层、而且不许提前 return。
  //
  //   另外那条优先级（分水 > 封色 > 压邻，后面的盖前面的）也在规则弹窗里。
  //   三件都没了，所以那一句现在是**空规则** —— 列进待清的文案清单。〕

  // ---------- 【寒流】：它在场时，**你**打出的牌都自带结冰 ----------
  //
  // 三个条件都要，而且每一个都有理由：
  //
  //   **同一方** —— desc 写的是「**你**打出的」。held 的 byFoe 记着
  //     「这效果是谁打出的」，所以拿它跟当前出牌的一方比。
  //     不比的话对手也白得钥匙，这件技能就反过来帮他了。
  //   **它还在堆上** —— 在场效果的通例（pileIndexOf >= 0）
  //
  // ---- 颜色限制 2026-10-16 去掉了（【寒色】→【寒流】那次改造的第三处）----
  //
  // 原先它还比一次颜色（「同颜色牌才自带冰」），理由是「一门花色只占
  // 手牌四分之一，而持续效果配那个触发率在场期间可能一次都不触发；
  // 颜色是一半，看得见」。那条推理没错，但**它属于上一个版本**：
  //
  // 那会儿这件技能叫【寒色】，强度 +1.91 —— **卡在驻场件 ~+2 的天花板上**。
  // 2026-10-14 那轮改造用「无点数 + 落堆底」把天花板捅破了（+1.12 的交互，
  // 原理是延长它自己的在场时间），于是它**不再需要靠「减半刻度」来凑档位** ——
  // 定稿的 desc 因此是「你打出的牌都自带【结冰】」，不带颜色。
  //
  // ⚠ **这三处（无点数 / 落堆底 / 去颜色）是一套，缺一个就不是同一件技能。**
  // 模拟器 10-14 就定稿了（`ICE_VOID` / `ICE_SINK` / 不看颜色的 `coldHueOn`），
  // 而游戏侧漏了整整两周 —— 期间 desc 已经改成新版，于是**玩家花 90 买到的
  // 是一件旧寒色**（约 +1.9 档），而结冰族所有的数都建在模拟器那个版本上。
  // 那是这个项目里「说明和实现不符」最久的一次，refs.js 查不出它
  //（它比的是 key，而这里 key 没变、语义变了）
  function coldHueOn(card : PlainCard, byFoe : boolean) : boolean {
    for (let i = 0; i < held.value.length; i++) {
      if (held.value[i].skill != SK_COLDHUE || held.value[i].byFoe != byFoe) {
        continue
      }
      if (pileIndexOf(held.value[i].source) >= 0) {
        return true
      }
    }
    return false
  }

  // 〔`frostFallOn`（场上有【霜降】牌）2026-10-16 删了 —— 霜降 10-15 删的。
  //   它跟【沸水】的 `boilOn` 一个形状、一个理由（落堆那一刻读它），
  //   而那两个形状一起证明了同一件事：**驻场障碍不读归属就是对称的，
  //   而对称的障碍拦自己拦得一样狠**。
  //   上面那个 `coldHueOn` 是这个形状读了归属的版本 —— 照它写〕


  // 这张牌在堆里第几个，-1 表示不在了
  function pileIndexOf(card : PlainCard) : number {
    for (let i = 0; i < pile.value.length; i++) {
      if (pile.value[i] == card) {
        return i
      }
    }
    return -1
  }

  // 打出一张手牌：先落堆，撞上了就开始收牌特效。返回要收走几张（0 = 没钓到）。
  // 钓到时牌不是马上拿掉的 —— 特效放完才拿掉、才记分，然后由 finishCatch 接着结算技能、交回合
  // 出一张牌：**只落堆，不判匹配**。
  //
  // 顺序是「先结算这张牌的技能，再拿它去匹配」（见 afterPlay → resolveMatch）：
  // 牌先落到堆上（沉底的落堆底），技能在它落着的时候结算 ——
  // 量水、收色、撒网、见底可能连它一起收走，那它就不再匹配了
  function playFor(byFoe : boolean, index : number) {
    // 牌打出去了，「要不要加打」那个问题就有答案了 —— 收旗。
    // 放在这儿而不是玩家点牌那个 handler 里：出牌的路不止一条
    //（你点、庄家打、技能逼着打），这儿是共同的那一条
    againWaiting.value = false
    const card = takeFromHand(byFoe, index)
    const skills = skillsOf(byFoe, card)
    // 数一下这一方打到第几张了 —— 【稳钩】要「前 N 张」，
    // 而两个数加起来是终局那两手的计数器（见 TAIL_PLAYS）。
    // 所以「技能逼着打」「对流插的那张」也都算一手，那是对的
    if (byFoe) {
      foePlayed = foePlayed + 1
    } else {
      myPlayed = myPlayed + 1
    }
    // ---- 带「优先」的两件在**钓牌判定之前**结算 ----
    //
    // 顺序：先染水（定花色），再沉底（定落点）。两件都改钓牌判定的输入，
    // 排在判定之后就什么也改不了（详见 draw-skills 文件头的「优先」那段）。
    //
    // 沉底在这儿只是**读出来**，真正落堆在下面 —— 因为落堆的位置
    // 还要分「钓到了 / 没钓到」两条路走
    firstNote = ''
    // ---- 结冰那一族：**自带冰的先进手冰表，豁免再从表里读** ----
    //
    // 两步分开写是有意的：
    //   `selfFrost` 那几件（结凌 / 藏凌 / 寒流）的「自带【结冰】」=
    //     **打出时它在手里就带着** → 塞进 frostHand；
    //   豁免**只认一件事**：这张牌手里带不带冰（`frostOnHand`）。
    //
    // 于是三件技能的豁免走同一条、不用各自特判，而【藏凌】贴给别的手牌的冰
    // 走的也是这一条 —— 那几张牌下几手打出去时同样豁免。
    //
    // 【寒流】在场时给**你打出的每一张**加的「自带」也在这儿兜住（见下一支）。
    //
    // **每次出牌都重设** iceBlindNow：没钓中的那一手不进 finishCatch，
    // 只靠这儿重设才不会把豁免漏到下一手
    if (selfFrost(skills)) {
      addFrostHand(card)
    }
    // 【寒流】：它在场时，**你打出的牌都**自带冰。
    //
    // 〔2026-10-16 去掉了「同花色」那个限制 —— 它属于上一个版本（寒色）。
    //   理由见 coldHueOn 那段：延命两句把驻场天花板捅破之后，
    //   这件技能不再需要靠「减半刻度」凑档位〕
    //
    // 判在这儿（落堆前）而不是 landVals 里：自带冰的意思是「打出时就带着」，
    // 而豁免读的正是那个状态 —— 放到落堆之后就只剩障碍、没有钥匙了
    if (coldHueOn(card, byFoe)) {
      addFrostHand(card)
    }
    iceBlindNow = frostOnHand(card)
    // ---- 【推牌】：摘掉这张身上的所有层，记下来等这一手结算完再兑现 ----
    //
    // **摘在这儿、兑现在 endPlay**，两头都是硬性的：
    //
    //   摘要早 —— 这张牌马上要离开手牌，而 surgeHand 存的是对象引用；
    //     不在这儿摘，它就会在表里一直挂着（那张牌再也回不到手里了）。
    //   兑现要晚 —— 规则是「**这一手结算完之后**才推」，而推牌会改
    //     堆的形状和牌库张数，排在匹配前面会污染这一手的判定
    //    （照已删【合流】那条判据：改判定输入或堆形的都必须在判定前，
    //     而这件**反过来** —— 它是故意排在判定后的，所以不能往前挪）。
    //
    // 中间存一个数而不是在 endPlay 里再查表，理由跟 mergeCard 那条一样：
    // 那会儿牌已经不在手里了，查不到
    surgePending = dropSurgeHand(card)
    // 【伏流】那个重入闸 —— 它是「这一手之内」的（见它的声明处）
    flowPicked = false
    // 「往堆底落」有**四条**来路，名字各不相同，而且性质分两类：
    //
    //   **强制**
    //     【寒流】    —— 自带，整局（2026-10-16 补上，见下）
    //     〔点数槽的【沉底】原先也在这儿 —— 技能 10-15 删了，
    //       `SK_SINK` 现在恒为 −1，所以这一支永不成立。导出还留着〕
    //     闯关庄家的【偏流】—— 它打出的每一张都落堆底，整关不变
    //   **可选**
    //     角色的【逆流】 —— 每回合你自己选（开关见 sinkOn / wantSink）
    //
    // 四条搭在 sink 这同一个变量上而不是各写一条落堆路径 ——
    // 「这张落哪头」在 playFor 里牵着四处（判定方向、护饵、收牌区间、
    // 下标偏移），再开一条就是四处各一个分支，必漏一个。
    //
    // ---- 【寒流】这一支为什么是强制的 ----
    //
    // 它跟【沉底】看着一样（都是强制落堆底），但**身份完全相反**：
    // 沉底的落堆底是**效果**（收「堆底 → 匹配那张」那一段），
    // 而寒流的落堆底是**延命**（堆底是最难被收走的那一头，因为匹配收的是
    // 「那一张到堆顶」）。配上无点数（见 valuesOf）一起把驻场件
    // ~+2 的天花板捅破 —— 两句的交互值 +1.12，而单独量都接近零。
    //
    // **所以它不该做成可选** —— 沉底当年从「强制」改成「可以」值 0.79 分
    //（空钩沉底是全表最危险的下饵），可那条推理对寒流不成立：
    // 它无点数，谁也按点数钓不走它，落堆底根本没有「变成靶子」的风险。
    //
    // ---- 【满篓】【窄口】2026-10-16 挂上来，成了第五、六条来路 ----
    //
    // **跟寒流同一个身份**（延命，不是效果），所以也是**强制**的。
    // 配上无点数（见 valuesOf 那一支）一起捅破挂牌型那 1/7 的折扣 ——
    // 实测交互 **+1.22 / +1.24**，而**单独加落堆底是负的**
    //（满篓 −0.55、窄口 −0.47：那张牌远离堆顶、放弃了这一手的匹配邻接，
    //  可它还是会被按点数钓走）。所以两句是个**成套的模块**，拆开用亏。
    //
    // 播报里**不提技能名**，只说发生了什么（「打到了堆底」）——
    // 六条来路共用这一句，写死任一个名字在另五条上就是错的
    const sink = hasTrigger(skills, SK_COLDHUE)
      || hasTrigger(skills, SK_CREEL) || hasTrigger(skills, SK_NARROW)
      || hasTrigger(skills, SK_SINK) || wantSink(byFoe, card, skills)
      || (byFoe && hasFoeSpecial('drift'))
    if (sink) {
      firstNote = firstNote + (byFoe ? ' 庄家那张打到了堆底。' : ' 这张打到了堆底。')
    }
    // 【封竿】挡住的那一下**要说出来**。
    //
    // 不说的话它就是「这张莫名其妙钓不到」—— 而封的那个点数
    // 商店预告里没给（只说了有一个点数被封），所以你本来是要试出来的。
    // 试出来之后得知道自己试出来了，不然就只是觉得规则坏了。
    //
    // 判在 catchStart 外面而不是里面：那个函数庄家挑牌时一回合要跑十几次，
    // 在里面写话会把 message 刷成一片
    if (!byFoe && sealedRank.value != '' && card.rank == sealedRank.value) {
      firstNote = firstNote + ' 封竿：' + sealedRank.value + ' 被封着，这张算 0 点。'
    }
    pendingSkills = skills
    lastPlayed = card
    // 匹配那一步要用的：这张带的技能、落没落堆底（见 resolveMatch）
    matchSkills = skills
    matchSink = sink
    // ---- 进场 ----
    // 落堆的那一刻先受场上效果牌的影响（压邻、封色、分水……都在 landVals 里），
    // 然后才发动它自己的效果
    const worth = landVals(card, byFoe, skills, sink)
    // ---- 【凝水】/【净水】：这张**不落堆，直接出场** ----
    //
    // 全表第一个「牌离场」的代价。别的技能的代价是无点数或置 0
    //（牌照旧落堆，只是钓不动），这一对是牌压根不进堆：
    //
    //   谁也收不走它 → 这一分**双方都拿不到**；
    //   牌库跟着薄一张 → 回合少一点。
    //
    // 买的是**精确**：堆上任意一张、立刻生效。全表别的技能都只碰得到
    // 「自己这张」或者「符合某条件的那些」，这一对是第一次让你**点**一张。
    //
    // ---------- 【叠放】那三件：这张**不进堆,叠到别的牌上** ----------
    //
    // 它们的代价不是「无点数」也不是「置 0」，是**这张牌不占堆上的位置** ——
    // 它垫在别人下面或者盖在别人上面，所以：
    //
    //   它自己**不参与匹配**（当前牌只有 pile[i] 那一张）；
    //   收走那一叠的时候它跟着走 → **它那一分归收走的人**。
    //
    // 所以这是**押注**：你赌自己是那个收走这一叠的人。
    // 押错了就是亲手给对手加分 —— 全表第一件「对手的选择决定我的收益」。
    //
    // 不进堆就没有匹配可言（resolveMatch 开头的 pileIndexOf 返回 -1
    // 直接 return，所以不用另加闸）。接下来是挑牌：
    // 玩家弹提示条等点，庄家当场自己挑
    const stacking = hasTrigger(skills, SK_CALM) || hasTrigger(skills, SK_CLEAN)
      || hasTrigger(skills, SK_RAISE)
    if (stacking) {
      // 三件撞在同一张牌上的时候按这个顺序取一件 —— 不叠加。
      // 一张牌只叠得到一个地方，而三件各要一次挑牌
      const which = hasTrigger(skills, SK_CALM) ? SK_CALM
        : (hasTrigger(skills, SK_CLEAN) ? SK_CLEAN : SK_RAISE)
      // 抬水要加几点：**牌面点数**（card.value），不读 valuesOf ——
      // 它叠上去之后不是当前牌，没有「它算几点」这回事；
      // 而牌面那个数写在牌上、谁都数得出来（跟退潮一个口径）
      const step = card.value
      // 堆是空的：没地方叠 —— 那张牌等于白放了
      if (pile.value.length == 0) {
        message.value = message.value + (byFoe ? ' 庄家' : ' ')
          + DRAW_SKILLS[which].name + '：场上没牌可叠，这张白放了。'
        afterPlay(byFoe)
        return
      }
      if (byFoe) {
        const at = foePilePick(which, step)
        if (at >= 0) {
          // 开演收牌特效了就别调 afterPlay（只有抬水会）
          if (!doPilePick(which, at, true, step, card)) {
            afterPlay(true)
          }
        } else {
          message.value = message.value + ' 庄家'
            + DRAW_SKILLS[which].name + '：没挑，这张白放了。'
          afterPlay(true)
        }
      } else {
        // 等你点堆上一张。提示条和「不挑」按钮见 pilePickText
        pilePick.value = which
        pickStep.value = step
        pickCard.value = card
      }
      return
    }
    // ---------- 【结凌】：给**全场**贴结冰 ----------
    //
    // **贴在落堆之前**，所以这一下的「全场」**不含它自己** ——
    // 它自己那张冰是「自带」来的（playFor 开头进了手冰表，落堆时由
    // frostOnLand 贴上），两条路分开走，不会贴两次（addFrostAt 不可叠加）。
    //
    // 为什么是全场而不是堆顶几张：它收的是「匹配那张 → 堆顶」，
    // 所以**堆顶那几张正是它自己要收走的** —— 范围只给堆顶的话，
    // 它钓中时把刚铺的冰全带走了，铺设效果归零（初稿就是这么废的）。
    // 全场之后堆底那部分它收不到，于是留了下来（期望铺成 3 张左右）。
    //
    // 相消和不可叠加都在 addFrostAt 里，这儿不重复判
    if (hasTrigger(skills, SK_FROST) && pile.value.length > 0) {
      let iced = 0
      let put = 0
      for (let i = 0; i < pile.value.length; i++) {
        if (pileBurnAt(i) > 0) {
          // 带火的那几格：冰火相消，火灭、冰也没贴上
          put = put + 1
        }
        if (addFrostAt(i, byFoe)) {
          iced = iced + 1
        }
      }
      firstNote = firstNote + (byFoe ? ' 庄家结凌：' : ' 结凌：')
        + '冻住 ' + iced + ' 张'
        + (put > 0 ? '，' + put + ' 张的火跟冰一起化了' : '')
        + '。它自带结冰，所以这一手收牌不受影响。'
    }
    if (sink) {
      unshiftPile(card, byFoe, GUARD_NONE, worth)
    } else {
      pushPile(card, byFoe, GUARD_NONE, worth)
    }
    // ---- 进场之后：「优先」效果最先发动 ----
    // 【燎原】原先在这儿自带 1 层火，点在它落下的那一格
    //（普通打法堆顶、沉底堆底 —— 「火从哪头烧起」是它的决策）。
    // 技能删了：蔓延并进【燃烧】关键词之后它是白牌。
    //
    // 现在的火种只有两个：**野火**（给剩下的牌和它自己点火）
    // 和**沸水**（在场时落堆的牌都带火，走 burnOnLand）
    // 〔【合流】那一支 2026-10-16 跟函数一起清掉。它排在这一段的**最后**、
    //   钓牌判定**之前**，而那个位置是硬性的 —— 新做「落堆之后再动一下」的
    //   技能照这条放：改判定输入（点数）或改堆形（格子数）的，都必须在判定前〕
  }

  // 技能都结算完了，拿这张牌去匹配，然后交回合。
  //
  // 这张要是已经被技能收走了（量水 / 收色 / 撒网 / 见底），就没得匹配，直接交回合。
  // 还在堆上的话：先把它从堆上拿下来，对**剩下的堆**判匹配，再放回去 ——
  // 普通的放回堆顶、沉底的放回堆底（技能阶段洪水之类可能往它上面又垫了牌，
  // 放回去之后那几张也在「匹配那张 → 堆顶」这一段里）。
  // 它身上的点数、花色照技能结算完的样子带回去（见底压过的就是压过的）
  function resolveMatch(byFoe : boolean) {
    const card = lastPlayed
    const at0 = card == null ? -1 : pileIndexOf(card!)
    if (at0 < 0) {
      endPlay(byFoe)
      return
    }
    const vals = pileValsAt(at0)
    // 火和花色也得**原样带回去**，不能只带点数 ——
    // 放回去走的是 pushPile / unshiftPile，那两个按「刚落下来」重算火（burnOnLand）
    // 和花色（牌面）。不带的话【燎原】自带的那层火在这一拿一放之间就丢了，
    // 堆上没有火源，回合末蔓延不出去，整件技能看着像没生效
    const burn = pileBurnAt(at0)
    const suit = pileSuitAt(at0)
    removePileAt(at0)
    // 〔这儿原先是 `withoutSkill(matchSkills, SK_MEASURE)` —— 量水在 afterPlay
    //   里就把牌收走了，匹配这一步再算一遍就是双花。量水 2026-10-16 删了，
    //   现在没有技能需要摘。**再做「技能阶段就收牌」的技能，要把它从这儿摘掉**〕
    const skills = matchSkills
    const sink = matchSink
    // J 落在空堆上：没有可通吃的，就**只勾走它自己**（记 1 分）
    if (card!.rank == JACK && pile.value.length == 0) {
      pushPile(card!, byFoe, GUARD_NONE, vals)
      keepMarks(pile.value.length - 1, burn, suit)
      startCatch(byFoe, 0, 0)
      message.value = message.value + (byFoe ? ' 庄家钓走 1 张。' : ' 钓走 1 张！')
      return
    }
    const at = catchStart(card!, byFoe, skills, sink)
    if (at < 0) {
      // 没钓到：落下。【稳钩】的头几张在这时候护上
      const played = byFoe ? foePlayed : myPlayed
      const guard = played <= FIRM_GUARD && hasSpecial(byFoe, SP_FIRMHOOK)
        ? (byFoe ? GUARD_FOE : GUARD_ME) : GUARD_NONE
      if (sink) {
        unshiftPile(card!, byFoe, guard, vals)
        keepMarks(0, burn, suit)
      } else {
        pushPile(card!, byFoe, guard, vals)
        keepMarks(pile.value.length - 1, burn, suit)
      }
      if (!byFoe) {
        message.value = message.value + ' 落在堆上。'
      }
      endPlay(byFoe)
      return
    }
    // 钓到了。收走的那一段往哪边算，由沉底决定：
    //   普通 —— 这张落堆顶，收走「匹配那张 → 堆顶」；
    //   沉底 —— 这张落堆底，收走「堆底 → 匹配那张」（插在 0，原来的 at 往后挪一格）
    let caught = 0
    if (sink) {
      unshiftPile(card!, byFoe, GUARD_NONE, vals)
      keepMarks(0, burn, suit)
      startCatch(byFoe, 0, at + 1)
      caught = at + 2
    } else {
      pushPile(card!, byFoe, GUARD_NONE, vals)
      keepMarks(pile.value.length - 1, burn, suit)
      startCatch(byFoe, at, pile.value.length - 1)
      caught = pile.value.length - at
    }
    message.value = message.value + (byFoe ? ' 庄家钓走 ' + caught + ' 张。' : ' 钓走 ' + caught + ' 张！')
  }
  // resolveMatch 把打出那张放回堆上之后，把它拿下来之前的火和花色写回去
  //（理由见 resolveMatch 里 burn / suit 那两行）。点数已经由 vals 带回去了
  function keepMarks(at : number, burn : number, suit : string) {
    if (at < 0 || at >= pile.value.length) {
      return
    }
    const nextBurn = pileBurn.value.slice(0)
    nextBurn[at] = burn
    pileBurn.value = nextBurn
    const nextSuit = pileSuit.value.slice(0)
    nextSuit[at] = suit
    pileSuit.value = nextSuit
  }


  // 按下标从堆上拿掉一张（六条并行数组一起删，见 pushPile）
  function removePileAt(at : number) {
    const keepCards : PlainCard[] = []
    const keepByFoe : boolean[] = []
    const keepGuard : number[] = []
    const keepVals : number[][] = []
    const keepSuit : string[] = []
    const keepBurn : number[] = []
    for (let i = 0; i < pile.value.length; i++) {
      if (i == at) {
        continue
      }
      keepCards.push(pile.value[i])
      keepByFoe.push(pileByFoe.value[i])
      keepGuard.push(pileGuard.value[i])
      // **rawVals 不是 pileValsAt** —— 见 rawVals 那段：重建会把在场效果写死
      keepVals.push(rawVals(i))
      keepSuit.push(pileSuitAt(i))
      keepBurn.push(pileBurnAt(i))
    }
    pile.value = keepCards
    pileByFoe.value = keepByFoe
    pileGuard.value = keepGuard
    pileVals.value = keepVals
    pileSuit.value = keepSuit
    pileBurn.value = keepBurn
  }

  // ---------- 【走水】/【过闸】：堆底那张离场，算庄家的分 ----------
  //
  // 两条特殊技共用这一下，因为它们**只有触发条件不同**：
  //
  //   走水 —— 堆超过 LEAK_DEEP 张，每回合末一次（罚你养厚堆）；
  //   过闸 —— 你每次钓到牌之后一次（罚你频繁小钓）。
  //
  // 写两遍必有一遍忘记推 goneRanks，而那个错是**静默的**
  //（分加了、牌没了，可双方的记牌从此都偏一张）。
  //
  // **守铁律**：牌是真的离场的，所以「积分 = 收走的张数」照旧成立 ——
  // 照【抄底】那条先例（掀走 N 张给 N 分）。
  //
  // **走 takeAt**，所以保护挡得住：带盾的那一格取走垫着的那张盾、
  // 宿主留下。于是「把凝水垫在堆底那张下面」就是对这两条的解法 ——
  // 那不是特例，是 takeAt 这个唯一入口自带的
  function dropBottomToFoe(label : string) {
    if (pile.value.length == 0) {
      return
    }
    // **先问再取** —— takeAt 会把盾消耗掉（照 finishCatch 那条）
    // 结冰也挡走水 / 过闸（冰对双方生效）—— 而豁免那时已经清掉了，
    // 所以这儿问 blockedAt 拿到的是「有没有被挡住」的完整答案
    const warded = blockedAt(0)
    const gone = goneRanks.value.slice(0)
    const got = takeAt(0, gone)
    goneRanks.value = gone
    // takeAt 只管叠放那一层：没保护的时候宿主还在堆上，得自己摘掉
    if (!warded) {
      removePileAt(0)
    }
    expireHeld()
    expireStacked()
    foeScore.value = foeScore.value + got
    flashFoe.value = true
    // 这两条可能紧跟在一次收牌后面（过闸就在 finishCatch 里），
    // 那时 flashTimer 已经排着一个了 —— 不清掉就丢了那个 id
    if (flashTimer >= 0) {
      clearTimeout(flashTimer)
    }
    flashTimer = setTimeout(flashOff, SCORE_FLASH_MS)
    message.value = message.value + ' ' + label + '：堆底那张'
      + (warded ? '底下垫着的代替它' : '') + '离场，庄家 +' + got + '。'
  }

  // 〔`withoutSkill`（滤掉一个技能）跟量水一起删了 —— 它只有那一个调用点。
  //   再要「让某一步看不见某个技能」，照抄三行就行：建数组、跳过它、返回〕

  // 收牌特效：亮起 [from, to] 这一段（两端都含），放完由 finishCatch 真拿掉
  function startCatch(byFoe : boolean, from : number, to : number) {
    catching.value = true
    catchFrom.value = from
    catchTo.value = to
    catchByFoe.value = byFoe
    flyOn.value = false
    catchTimer = setTimeout(catchFly, CATCH_SHOW_MS)
  }

  function catchFly() {
    flyOn.value = true
    catchTimer = setTimeout(finishCatch, CATCH_FLY_MS)
  }

  function flashOff() {
    flashTimer = -1
    flashMe.value = false
    flashFoe.value = false
  }

  // 特效放完：真正把那段牌拿掉、记分、积分跳一下，然后结算技能、交回合。
  //
  // 拿掉的是 [catchFrom, catchTo] 这一段（两端都含）。
  // 普通打法它是「匹配那张 → 堆顶」，沉底是「堆底 → 匹配那张」——
  // 所以不能再用 slice(0, at) 那一招了，得按区间剔
  function finishCatch() {
    catchTimer = -1
    const from = catchFrom.value
    const to = catchTo.value
    const gone = goneRanks.value.slice(0)
    const keepCards : PlainCard[] = []
    const keepByFoe : boolean[] = []
    const keepGuard : number[] = []
    const keepVals : number[][] = []
    const keepSuit : string[] = []
    const keepBurn : number[] = []
    let caught = 0
    for (let i = 0; i < pile.value.length; i++) {
      if (i >= from && i <= to) {
        // 叠放走 takeAt：带保护就取走垫着那张盾（宿主留下），
        // 没保护就连底下压着的一起收。**先问再取** —— takeAt 会消耗掉盾
        const warded = blockedAt(i)
        caught = caught + takeAt(i, gone)
        if (!warded) {
          continue
        }
        // 保护扛住了：宿主留在堆上，那一叠少一层
      }
      keepCards.push(pile.value[i])
      keepByFoe.push(pileByFoe.value[i])
      keepGuard.push(pileGuard.value[i])
      // **rawVals 不是 pileValsAt** —— 见 rawVals 那段：重建会把在场效果写死
      keepVals.push(rawVals(i))
      keepSuit.push(pileSuitAt(i))
      keepBurn.push(pileBurnAt(i))
    }
    goneRanks.value = gone
    pile.value = keepCards
    pileByFoe.value = keepByFoe
    pileGuard.value = keepGuard
    pileVals.value = keepVals
    pileSuit.value = keepSuit
    pileBurn.value = keepBurn
    const byFoe = catchByFoe.value
    // ---- 【深钩】：钓到了就**额外再收堆底 DEEP_EXTRA 张** ----
    //
    // 在上面那一段收完之后才收，所以数的是**剩下的堆**：
    // 刚才那一钩已经把牌拿走了，堆底可能已经空了 —— 那就少收或者收不着。
    // 这也是它跟沉底的分工：沉底改的是「从哪头收」，深钩是「顺手多捞一把」。
    //
    // **它仍然可能偏强**：一局钓 9 次就是多收 9 张，而一件技能的目标
    // 是一局 3~5 分。等模拟器量过（`md-sim` 已经搬完，这一件还没量）
    if (hasSpecial(byFoe, SP_DEEPHOOK) && pile.value.length > 0) {
      let extra = DEEP_EXTRA
      if (extra > pile.value.length) {
        extra = pile.value.length
      }
      // ---- 深钩也走 takeAt，所以它**挡得住保护** ----
      //
      // 原先这儿是一串 slice(extra)，前提是「堆底那 extra 张一定走」。
      // 叠放之后那个前提不成立了：带保护的那张会留下。
      // 所以改成跟上面主循环一样按格处理，留下的重建回去
      const gone2 = goneRanks.value.slice(0)
      const keep2 : PlainCard[] = []
      const keep2By : boolean[] = []
      const keep2Guard : number[] = []
      const keep2Vals : number[][] = []
      const keep2Suit : string[] = []
      const keep2Burn : number[] = []
      let got = 0
      for (let i = 0; i < pile.value.length; i++) {
        if (i < extra) {
          const warded = blockedAt(i)
          got = got + takeAt(i, gone2)
          if (!warded) {
            continue
          }
        }
        keep2.push(pile.value[i])
        keep2By.push(pileByFoe.value[i])
        keep2Guard.push(pileGuard.value[i])
        // **rawVals 不是 pileValsAt** —— 同上
        keep2Vals.push(rawVals(i))
        keep2Suit.push(pileSuitAt(i))
        keep2Burn.push(pileBurnAt(i))
      }
      goneRanks.value = gone2
      pile.value = keep2
      pileByFoe.value = keep2By
      pileGuard.value = keep2Guard
      pileVals.value = keep2Vals
      pileSuit.value = keep2Suit
      pileBurn.value = keep2Burn
      caught = caught + got
      message.value = message.value + ' 深钩：顺手捞走堆底 ' + got + ' 张。'
    }
    // ---- 【结凌】的豁免到这儿**就结束** ----
    //
    // 这一手的收牌（主循环 + 深钩）都走完了，所以立刻清掉 ——
    // 底下几行还有【守滩】【再钩】【过闸】，而**过闸是庄家的规矩**
    //（dropBottomToFoe → takeAt）。不清的话它会蹭上我这一手的豁免，
    // 无视我自己铺的冰去拿分。passTurn 里的【走水】同理
    iceBlindNow = false
    // 刚收走的那几张里要是有谁的效果牌，那个效果到此为止 ——
    // 「挂在牌上」的意思就是牌没了效果也没了。
    // **摆在深钩之后**：它也可能收走效果牌
    expireHeld()
    // 宿主离场了的叠放跟着清 —— 不然底下那几张永远留在 stacked 里成孤儿。
    // takeAt 已经把该收的那几张摘掉了，这一步兜的是「宿主被别的路拿走」
    expireStacked()
    if (byFoe) {
      foeScore.value = foeScore.value + caught
      flashFoe.value = true
    } else {
      myScore.value = myScore.value + caught
      flashMe.value = true
    }
    flashTimer = setTimeout(flashOff, SCORE_FLASH_MS)
    catching.value = false
    flyOn.value = false
    catchFrom.value = -1
    catchTo.value = -1
    // ---------- 庄家钓到之后那两条特殊技 ----------
    //
    // 两条都**只在钓到时**发动，所以落在 finishCatch 而不是 afterPlay ——
    // afterPlay 钓到没钓到都走，挂那儿就成了「每回合都发动」。
    //
    // 【守滩】：往堆上垫一张自己的手牌。它是涡心祭司（第 10 关）那一关的轴 ——
    // 它染水、它见底，而这条逼它不停给自己堆料。
    if (byFoe && hasFoeSpecial('guard')) {
      guardPushFor()
    }
    // 【再钩】：钓到了就能再打一张。
    //
    // **直接搭在连竿那套上**（againPending / againUsed）而不是另开一条：
    // 「这个回合再打一张」在 passTurn 的最前面已经实现了，连「加打的那张
    // 不再给加打」那道闸（againUsed）都现成 —— 而再钩的上限正好也是
    // 一回合两张。另写一条就是两套交接逻辑，必有一套漏掉护饵过期
    if (byFoe && hasFoeSpecial('again') && !againUsed.value && foeHand.value.length > 0) {
      againPending = true
    }
    // ---------- 【过闸】：**你**钓到之后，堆底那张离场算庄家的分 ----------
    //
    // 落在这儿而不是 afterPlay，理由跟上面两条一样：afterPlay 钓到没钓到
    // 都走，挂那儿就成了「每回合收一张税」。
    //
    // 它挂的是**你钓到牌**这个事件 —— 守滩和再钩挂的是「庄家钓到牌」，
    // 所以这是个新挂点。收 2 张交 1 张、收 6 张也交 1 张，于是它逼你
    // 从「频繁小钓」转成「攒一段大的」
    if (!byFoe && hasFoeSpecial('toll')) {
      dropBottomToFoe('过闸')
    }
    // 技能在匹配之前就结算完了（见 afterPlay → resolveMatch），所以这儿直接交回合
    endPlay(byFoe)
  }

  // 【守滩】垫牌：从庄家手里挑一张最不容易被你钓走的，垫到堆上。
  //
  // **它不算「打出」**：不触发技能、不判钓牌、不记进 foePlayed。
  // 那是对的 —— 特殊技说的是「垫一张」，而「打出一张」是一整套流程
  //（见 playFor）。走那一套的话它能连环钓牌，那比写在表上的效果强得多。
  //
  // 挑的标准是 baitRisk（庄家挑饵用的那个口径）—— 它既然是在给自己堆料，
  // 就该垫一张你最难端走的，不然这条特殊技等于白送你分
  function guardPushFor() {
    if (foeHand.value.length == 0) {
      return
    }
    let at = -1
    let risk = 99
    for (let i = 0; i < foeHand.value.length; i++) {
      const card = foeHand.value[i]
      // J 留着通吃，冻住的垫不出去
      if (card.rank == JACK || isFrozen(card)) {
        continue
      }
      const r = baitRisk(card)
      if (r < risk) {
        risk = r
        at = i
      }
    }
    // 手里只剩 J 或者全冻着：这一下就不垫（总比把 J 垫出去好）
    if (at < 0) {
      return
    }
    const card = takeFromHand(true, at)
    // 点数照它自己算（valuesOf 传空技能列表 = 没有技能改它）——
    // 垫上来的是一张普通牌，不是淤滩那种死牌
    pushPile(card, true, GUARD_NONE, valuesOf(card, true, [] as number[]))
    message.value = message.value + ' 守滩：庄家往堆上垫了 ' + cardName(card) + '。'
  }

  // ---------- 打出之后的技能 ----------
  //
  // 窥视、搅水立刻结算；观潮要看人：你打出的停下来等你选，庄家打出的自己判断。
  // 都结算完才交回合

  function afterPlay(byFoe : boolean) {
    const skills = pendingSkills
    pendingSkills = []
    // ---- 带「优先」那几件的播报摆在最前面 ----
    //
    // 效果本身**早就结算完了**（在 playFor 里，钓牌判定之前 ——
    // 那就是「优先」这个关键字的意思）。这儿只是补上那句话：
    // 结算那会儿 message 还会被调用处整个覆盖，所以话存在 firstNote 里。
    //
    // 摆在最前面是对的 —— 它确实是第一个发生的事，
    // 下面那一串（见底、洪水、顺色的战果…）都是在它之后
    if (firstNote != '') {
      message.value = message.value + firstNote
      firstNote = ''
    }
    // 连竿只在这儿**记个账**，兑现在 passTurn 的最前面 ——
    // 它要等这一手所有效果都结算完（跟「优先」正好两头）。
    // 加打的那张不再给加打，所以 againUsed 已经立起来就不记。
    //
    // ⚠ **这一支恒为 false**〔2026-10-16 查明〕：连竿 2026-10-14 删了，
    //   `SK_AGAIN` 是 −1。于是 `againPending` **只剩庄家那一个来源**
    //  （finishCatch 里的【再钩】，那儿带着 `byFoe &&`）——
    //   **玩家侧那整套界面因此不可达**：那颗「收手」钮、`onAgainSkip`、
    //   回合标题里的「连竿加打」，一个玩家都看不到。
    //
    //   没删是因为它是「玩家侧加打」唯一的落点，再做这类技能直接接回来。
    //   但别把它当活的读 —— 删它或者接回来之前，这一支和 `againWaiting`
    //   那一块都要看成同一笔。
    if (hasTrigger(skills, SK_AGAIN) && !againUsed.value) {
      againPending = true
    }
    // 【一色】它的花色严格最多就整堆收走。排在所有技能最前面，演完从 afterPlayHead 接着走
    if (suitifyFor(byFoe, skills)) {
      return
    }
    // 〔【量水】那一支 2026-10-16 跟函数一起清掉。它排在**所有技能的最前面**，
    //   理由是「收整堆的排后面，前面那些技能改过的堆就白改了」——
    //   一色（上面那一支）现在是这个位置唯一的住户，新做整堆类照它放〕
    afterPlayHead(byFoe, skills)
  }

  // ---------- 〔删了〕measureFor（量水） ----------
  //
  // **2026-10-16 清掉，约 50 行。** 技能 10-14 删的。
  //
  // 效果是「这张的点数正好等于**堆上张数（含它自己）** → 整堆连它一起收走」。
  // 死因：**它是一条自己算不出来的线**。玩家得随时心算堆上几张、
  // 还得记着「含它自己」，而算对了也只是偶尔撞上 —— 花在心算上的
  // 注意力远大于它值的分。「要玩家数场上的东西」这个形状整族都这样。
  //
  // 留下的三条判据写在 `catchStart` 里那个墓碑上（整堆类排遍历之前 /
  // 护着的牌是网里的洞 / 落堆前要 +1）。另外两条在这儿：
  //
  // **一、`startSweep(..., TAIL_HEAD)` 那个续走参数。** 收牌特效是异步的，
  //   演完要从 `afterPlayHead` 接着跑剩下的技能 —— 整堆类在技能链最前面，
  //   所以**必须**把续走点交给 startSweep，不然后面的技能全丢。
  //   一色（`suitifyFor`）是现在唯一还这么写的。
  //
  // **二、它在匹配那一步要把自己摘掉。** 它在 afterPlay 里结算完了，
  //   匹配那一步再算一遍就是双花 —— 任何「在技能阶段就把牌收走」的技能
  //   都得从 `matchSkills` 里滤掉自己（见 resolveMatch 里 `const skills =`
  //   那一行上面的注释；那个滤函数也跟着删了）

  // afterPlay 的前半段：从窥视到见底。一色演完特效从这儿接着走
  function afterPlayHead(byFoe : boolean, skills : number[]) {
    if (hasTrigger(skills, SK_PEEK)) {
      peekFor(byFoe)
    }
    // 〔【抄底】那一支 2026-10-16 清掉（技能 10-14 删的）。
    //
    //   它留下一条**排序**判据，而那条对任何「拆保护」的新效果都成立：
    //   **拆保护的要排在收牌的前面。** 保护在 `takeAt` 里才兑现
    //  （盾代替宿主被收走），所以先拆再收 → 这一手后面的收牌当场吃到好处
    //  （同一张牌再带个撒网 / 见底，原本有盾的宿主现在裸着）。
    //   排在后面的话盾早被那几件消耗完了，拆了个空。〕
    // ---- 挂效果的那几件都要求：那张牌**还在堆上** ----
    //
    // 打出去就钓到牌的话，它自己也在被收走的那一段里（从 at 到堆顶，
    // 包括刚打的这张），于是效果压根挂不上。
    //
    // 这不是个漏洞，是条有意思的张力：**挂效果得用一张钓不到牌的**。
    // 于是你用它的时候是「故意不钓」，而那张牌埋得多深，
    // 决定了对手要花多大力气才破得掉
    //
    // 照水：对方全部手牌明置，挂在刚打出那张牌上。不用等人选
    if (hasTrigger(skills, SK_LANTERN) && lastPlayed != null && inPile(lastPlayed!)) {
      addHeld({
        source: lastPlayed!,
        skill: SK_LANTERN,
        target: null,
        byFoe: byFoe
      } as HeldEffect)
      message.value = message.value + (byFoe ? ' 庄家照水：你的手牌它全看得见了。' : ' 照水：庄家的手牌全明着了。')
    }
    // 〔---- 抹点数那一族的三件在场效果 2026-10-16 清掉 ----
    //
    //   压邻 / 封色 / 分水，三件都是 10-14 删的（压底族）。它们挂在刚打出
    //   那张上、本身不动任何牌，只改**后面落下来的牌算几点** ——
    //   读取端在 `landVals`，那一层这一轮也空了。
    //
    //   留一条判据：**压邻、封色自己没有点数所以几乎钓不走**（只有 J /
    //   顺色 / 收色碰得到）—— 赖得住是它们的卖点；**而分水有点数，
    //   对手钓得走它，那是它敢封一半牌面的代价**。
    //  「封得越宽，就越该让自己可被反制」这条对新技能仍然适用。〕
    // 【沸水】原先在这儿挂在场效果（落堆的牌都带火）。技能删了 ——
    // 蔓延并进【燃烧】关键词之后它成了「提前一手」，实测可证的零。
    //
    // 〔---- 【霜降】那一支 2026-10-16 清掉 ----
    //
    //   技能 10-15 删的，而它是**「驻场 + 对称 + 只铺不收」这个形状的判废**：
    //   「落堆的牌都贴冰」不分敌我，铺的人同样被拦。
    //
    //   留下的一条判据直接写进了下面那一支的注释里：
    //   **钥匙是私有的，障碍是对称的** —— 持续造障碍的技能必须读归属，
    //   不然就是替对手一起付钱。
    //
    //   另一条：驻场技能的强度上限是「它那张牌活多久」，而堆的周转是
    //   3.3 回合 —— 所以「它自己有点数、对手钓得走」既是代价也是**天花板**。
    //   想让驻场技能更强，办法是延命（无点数 / 落堆底），不是加面积；
    //   而延命那两句在霜降身上量出来是 **−2.86** —— 延命也有反效果，
    //   因为活得久的对称障碍拦自己拦得更久。〕
    // ---- 【寒流】：持续造钥匙，**只给自己** ----
    //
    // 挂效果的形状跟霜降一样，但它读的是**归属**
    //（见 coldHueOn：只给打出它的那一方）—— 所以它是这一族唯一
    // 不对双方生效的，而那正是它活下来、霜降被删的原因：
    // **钥匙是私有的，障碍是对称的。**
    //
    // 〔名字 2026-10-16 才在这儿改对：它 10-14 就从【寒色】改名成【寒流】
    //   并重做了（+无点数 +落堆底 −颜色限制），可游戏侧漏了两周 ——
    //   期间技能表叫寒流、desc 写着新效果，而这行播报还在说「寒色」。
    //   `key` 故意保留 `'coldhue'`（老存档），所以 SK_COLDHUE 这个名字
    //   是对的，别顺手改成 SK_COLDFLOW〕
    if (hasTrigger(skills, SK_COLDHUE) && lastPlayed != null && inPile(lastPlayed!)) {
      addHeld({
        source: lastPlayed!,
        skill: SK_COLDHUE,
        target: null,
        byFoe: byFoe
      } as HeldEffect)
      message.value = message.value + (byFoe ? ' 庄家寒流：' : ' 寒流：')
        + '从现在起' + (byFoe ? '它' : '你') + '打出的牌都自带结冰。'
    }
    // ---- 【藏凌】：把手里剩下的牌都变成钥匙 ----
    //
    // 它**不铺障碍**，所以不碰堆 —— 贴的是手冰表（见 frostHand 那段）。
    // 那几张牌下几手打出去时都能穿过堆上的冰，而落堆后又成了新的障碍。
    //
    // 排在这儿（afterPlay）而不是 playFor：它贴的是「打出这张之后
    // 手里剩下的」，所以得等那张牌已经离手
    // ---- 【传火】：自带火 + 给**堆上同颜色**的牌点火 ----
    //
    // 排在结冰那几件**前面**，理由跟量水 / 一色一样：它改的是
    // **燃尽的判定输入**（pileBurn），而燃尽在匹配之前判（见 burnStep）。
    // 排到后面就赶不上这一手的燃尽，而差一拍就是对手的一个回合。
    //
    // ==========================================================
    // ---- 2026-10-16 重做：【获取下一张】→ **堆上同颜色点火** ----
    // ==========================================================
    //
    // 原形状（自带火 + 连锁）是 **X 4.86，全表唯一超档的件**（上沿 4.5）。
    // 而它的定价反而吻合（建议 127 ≈ 现价 125），所以那不是定价问题。
    //
    // 六格矩阵扫完（`CHAIN_HUE` × `CHAIN_NEXT`，`vs chain chain -n 20000`）：
    //
    //   |            | 无条件连锁 | 没燃尽才连锁 | 不连锁 |
    //   |------------|-----------|------------|-------|
    //   | 只自带火   | **4.86** 超档 | 2.00     | 1.81  |
    //   | + 同花色   | 5.55      | —          | 2.84  |
    //   | **+ 同颜色** | 6.07    | 3.98       | **3.93** ← 定稿 |
    //
    // 分项：自带火 1.81 / 连锁 **+3.05**（超档的来源）/ 同颜色点火 **+2.12**。
    //
    // ---- 为什么是「换掉连锁」而不是「削连锁」----
    //
    // 连锁是强度的大头，削它就是**洪水那条老路**（限幅削的正是强度来源，
    // 两轮都被数据否决，最后只能删）。所以换形状，而换来的这个
    // **跟【引火】成对称的一对**：
    //
    //   引火 → 贴**手牌**同颜色 → 那些牌打出去才落堆生效（延迟）
    //   传火 → 贴**堆上**同颜色 → **立刻**可能触发燃尽
    //
    // 两件的 desc 现在只差「你手里 / 堆上」四个字，玩家学一次会两件。
    //
    // ---- 一个反直觉的点，别照直觉改回去 ----
    //
    // 堆只有 2.3 张厚，所以「同颜色」平均只点着 **0.7 张** —— 看着少得可怜，
    // 可它值 **+2.12**。因为**堆薄同时让燃尽更容易达成**：堆上只有 2 张时，
    // 点着同色那 1 张 + 它自己 = 全堆带火 → 立刻燃尽收整堆。
    // 实测燃尽率 **71%（只自带火）~91%（加同色点火）**。
    //
    // > 「条件撞局面常量」这条死因**要分机制看符号** —— 量水死在堆薄
    // > （它要「点数 = 堆的张数」），点火类不吃那条，堆薄反而帮它。
    //
    // 〔也试过「**没燃尽才连锁**」那一档（反接自强化那个正循环，设计上漂亮）：
    //   实测把连锁砍掉 94%（+3.05 → +0.19），基本等于关闭 ——
    //   因为燃尽率本来就 71~91%，补偿只在那 9~29% 里触发。
    //   **负反馈的触发条件要先看它的基础发生率。** 判废〕
    if (hasTrigger(skills, SK_CHAIN) && lastPlayed != null) {
      const at0 = pileIndexOf(lastPlayed!)
      const lit = inPile(lastPlayed!) && lightAt(at0)
      // 同颜色那一段。花色取 `pileSuitAt`（染过色的算染后的）——
      // 「堆上跟它同颜色」说的是**场上现在的颜色**，不是牌面印的
      let spread = 0
      if (at0 >= 0) {
        const red0 = pileRed(at0)
        for (let i = 0; i < pile.value.length; i++) {
          // `lightAt` 自己带三道闸（已着火 / 带保护 / 冰相消），
          // 所以这儿只管「选哪几格」，点不点得着由它判
          if (i != at0 && pileRed(i) == red0 && lightAt(i)) {
            spread = spread + 1
          }
        }
      }
      message.value = message.value + (byFoe ? ' 庄家传火：' : ' 传火：')
        + (lit ? '它自带燃烧' : '它没点着')
        + (spread > 0 ? '，又点着堆上同颜色的 ' + spread + ' 张。'
          : '，堆上没有同颜色的牌可点。')
    }
    // ---- 【引火】：自带火 + 给手里**同颜色**的牌预约火 ----
    //
    // 限幅按颜色是量出来的，不是美感：「最多 N 张」那一档的幅度悬崖
    // 就在可调范围里（2→3 从 +4.85 跳到 +7.11），而且 desc 答不上
    // 「哪 N 张」—— 火在手里什么也不做、落堆才生效，让玩家挑是个假决策。
    //
    // 形状照【藏凌】（下面那一段），所以两件撞在一张牌上时
    // 手里那几张会同时带冰带火 —— 落堆时相消，自洽，不用特判
    if (hasTrigger(skills, SK_KINDLE) && lastPlayed != null) {
      const lit = inPile(lastPlayed!) && lightAt(pileIndexOf(lastPlayed!))
      const mine = byFoe ? foeHand.value : hand.value
      let fired = 0
      for (let i = 0; i < mine.length; i++) {
        if (isRedSuit(mine[i].suit) == isRedSuit(lastPlayed!.suit)
          && !burnOnHand(mine[i])) {
          addBurnHand(mine[i])
          fired = fired + 1
        }
      }
      message.value = message.value + (byFoe ? ' 庄家引火：' : ' 引火：')
        + (lit ? '它自带燃烧；' : '它没点着；')
        + (fired > 0
          ? '手里 ' + fired + ' 张同色的带上了燃烧 —— 那几张落堆就是火。'
          : '手里没有同色的牌。')
    }
    // ---------- 【薪潮】：自带【燃烧】+ 选对方 1 张手牌贴【推牌】 ----------
    //
    // ---- 自带燃烧那一半排在这儿（跟引火同一段），而它是这件技能的主要收益 ----
    //
    // 它给了一条**兜底**：打在空堆或 1 张的堆上，火瞬间烧满（「堆 1 张就触发」），
    // **当场燃尽收走 1~2 张** —— 于是「空堆白打一手」变成「稳收 1~2 张」。
    // 实测通道就是这个：钓到次数 7.8 → **8.6**，而每次收反而略降（2.82 → 2.78）。
    //
    // 〔前一版把火贴在**对手手里**，X 只有 +1.72 —— 火在手里什么也不做、
    //   落堆那一下站在**他的**回合，于是堆薄时他当场燃尽。
    //   同一条规则，换个站位就从自伤变成收益（判据一）〕
    //
    // ---- 贴标签那一半是**盲选**，所以走冻结那条路、不走引潮那条 ----
    //
    // 引潮那一族（引潮 / 死水 / 摘钩 / 压舱 / 对换）用的是 `takeSkill`，
    // 而 `foeOpen` 认它 → **会把对方手牌全翻开**。薪潮不能走那条。
    //
    // 盲选用 `fuelPending`（照 `freezePending`）：挑的是**位置**，不翻牌。
    // 而这不是为了省事 —— 实测盲选 **+3.50** 对看着挑 **+3.52**，
    // 差 0.02 且诊断逐位相同，**「翻开手牌」在这件技能上值 0**。
    // 理由见 draw-skills 那条墓碑（「迟早都会兑现的标签，挑哪张只改时机」）。
    if (hasTrigger(skills, SK_FUEL) && lastPlayed != null) {
      const lit = inPile(lastPlayed!) && lightAt(pileIndexOf(lastPlayed!))
      message.value = message.value + (byFoe ? ' 庄家薪潮：' : ' 薪潮：')
        + (lit ? '它自带燃烧。' : '它没点着。')
      const theirs = byFoe ? hand.value : foeHand.value
      if (fuelPool(byFoe).length > 0) {
        if (!byFoe) {
          // 停下来等你点一张（**不翻开**）—— 照冻结
          fuelLeft.value = FUEL_TAG < fuelPool(false).length
            ? FUEL_TAG : fuelPool(false).length
          fuelPending.value = true
          return
        }
        // 庄家那一侧：照 `foeFreezePick` 那条先例 ——
        // **它看得见的里头挑，看不见就随机**。盲选在它身上自然成立
        for (let n = 0; n < FUEL_TAG; n++) {
          const at = foeFuelPick()
          if (at < 0) {
            break
          }
          doFuel(true, at)
        }
      } else if (theirs.length == 0) {
        message.value = message.value + '（他手里没牌可贴。）'
      }
    }
    if (hasTrigger(skills, SK_HIDE)) {
      const mine = byFoe ? foeHand.value : hand.value
      let iced = 0
      for (let i = 0; i < mine.length; i++) {
        if (!frostOnHand(mine[i])) {
          addFrostHand(mine[i])
          iced = iced + 1
        }
      }
      message.value = message.value + (byFoe ? ' 庄家藏凌：' : ' 藏凌：')
        + (iced > 0
          ? '手里 ' + iced + ' 张带上了结冰 —— 打出去那几手不受结冰影响。'
          : '手里没牌可贴。')
    }
    // 【燎原】原先在这儿挂住在场效果。技能删了 ——
    // 蔓延现在是【燃烧】关键词自带的，不需要任何技能在场（见 spreadFire）
    // 〔【掏手】【掏库】那两支 2026-10-16 去掉 —— 技能 10-14 删的，
    //   实现（dumpFor / spillFor）这一轮一起清了，判据留在那块墓碑里〕
    // 窄口：对方每回合只补到 3 张，挂在刚打出那张上（照照水，不用等人选）
    if (hasTrigger(skills, SK_NARROW) && lastPlayed != null && inPile(lastPlayed!)) {
      addHeld({
        source: lastPlayed!,
        skill: SK_NARROW,
        target: null,
        byFoe: byFoe
      } as HeldEffect)
      message.value = message.value + (byFoe
        ? ' 庄家窄口：你每回合只补到 ' + (HAND_SIZE - 1) + ' 张了。'
        : ' 窄口：庄家每回合只补到 ' + (HAND_SIZE - 1) + ' 张了。')
    }
    // 满篓：自己每回合补到 5 张。跟窄口一对，一个削他一个补自己
    if (hasTrigger(skills, SK_CREEL) && lastPlayed != null && inPile(lastPlayed!)) {
      addHeld({
        source: lastPlayed!,
        skill: SK_CREEL,
        target: null,
        byFoe: byFoe
      } as HeldEffect)
      message.value = message.value + (byFoe
        ? ' 庄家满篓：它每回合补到 ' + (HAND_SIZE + 1) + ' 张了。'
        : ' 满篓：你每回合补到 ' + (HAND_SIZE + 1) + ' 张了。')
    }
    // ---------- 〔删了〕组合技【干塘】：退潮 × 见底 ----------
    //
    // **2026-10-16 清掉。它从 10-14 起就已经不会触发了** ——
    // 那天【退潮】被删（压底族六件之一），于是 `SK_EBB` 变成 −1，
    // 而 `hasTrigger(skills, -1)` 永不匹配。
    //
    // ---- 它是怎么躲过两周的 ----
    //
    // **组合技没有 key、不在任何表里** —— 它只存在于一个条件式里
    //（`hasTrigger(SK_EBB) && hasTrigger(SK_LOWTIDE)`）。所以「删技能
    // 要过的清单」一条都盖不住它：没名字可比、没表可对、没 desc 可扫。
    //
    // 代价是实打实的：词表和设计文档里四处还在拿「见底 / 退潮 / 干塘」
    // 举例（玩家点开【无点数】会看到一件商店里没有的技能），
    // 而修那四处的人**把「退潮」换成了「干塘」** —— 用一个死的替换
    // 另一个死的，因为没人知道干塘也死了。
    //
    // 这个盲区后来补成了 `tools/md-sim/refs.js` 的**第 8 项**
    //（专扫 `hasTrigger(A) && hasTrigger(B)` 这个模式，两边都得活着）。
    //
    // ---- 它留下的那条设计判据，仍然成立 ----
    //
    // **组合技合的该是两样不同的东西**：干塘的范围取见底的（整堆）、
    // 幅度取退潮的（牌面点数），于是比两件各自都强，但不是翻倍 ——
    // 而「要有爆点、不能翻倍」是组合技那条规矩。
    // 哪天做第二件组合技，照这条来。
    //
    // 另外那个前提**没有随它死**：「一张牌同时触发两件技能」照旧存在
    //（角色卡的槽会交叠，镜湖占卜师 ♥ + '3 4' 在 ♥3 / ♥4 上双触发）。
    // 词表里那条现在叫【双触发】—— 原先叫「组合技」，而那个名字
    // 在唯一的实例死掉之后就名不副实了。
    //
    // 见底收牌要演收牌特效（跟钓牌一样：亮起 → 飘走 → 积分跳）。
    // 开演了就先停在这儿，演完由 finishSweep 从 afterPlayTail 接着走
    if (hasTrigger(skills, SK_LOWTIDE)) {
      // 见底：整堆点数往下压 1，压到 0 的收走
      if (lowTideFor(byFoe, skills)) {
        return
      }
    }
    afterPlayTail(byFoe, skills, TAIL_EBB)
  }

  // afterPlay 的后半段。from 是从哪一段接着走（TAIL_*）。
  //
  // 拆出来是因为见底收牌要演特效 —— 特效是定时器驱动的，
  // 演完（finishSweep）得从这儿接着结算剩下的技能。
  // 不演（没收到牌）的时候 afterPlay 直接调它，跟拆开之前一个顺序
  function afterPlayTail(byFoe : boolean, skills : number[], from : number) {
    // 〔**这一段 2026-10-16 清空了两条死分支**：【退潮】（技能 10-14 删）
    //   和【洪水】（10-15 删）。两条的 `hasTrigger` 都恒为 false。
    //
    //   `TAIL_EBB` 这个段号**留着** —— 它是 `afterPlayTail` 的入口段号
    //   （`afterPlay` 传的就是它），不是退潮专用的。名字里的 EBB 是历史，
    //   改名要动六个 TAIL_* 的全套顺序，而那套顺序「共用一个段号必出错」
    //   的坑踩过一次（伏流跟野火共用 TAIL_WILD，撒网一收牌伏流就没了）。
    //
    //   退潮留下一条还管事的判据，记在这儿免得丢：**「减点数」那一族里
    //   谁先跑有意义** —— 见底会收走 0 点的牌、堆跟着短一截，所以
    //   「堆顶 N 张」是哪几张取决于先跑谁。将来再加减点数的技能，
    //   要让「收牌的」排在「只改形状的」前面。
    //
    //   而「减点数」那一族现在**只剩见底一件**（退潮删了、干塘跟着死），
    //   所以这条判据暂时没有用武之地。〕
    // 收色：堆上同花色的一起收走（含它自己）。散着收，演收牌特效 ——
    // 开演了就停在这儿，演完从撒网那一段接着走
    if (from <= TAIL_EBB && hasTrigger(skills, SK_HUE) && lastPlayed != null) {
      if (hueFor(byFoe, lastPlayed!, skills)) {
        return
      }
    }
    // 撒网：堆上同奇偶的一起收走。同上，演完从下一段接着走
    if (from <= TAIL_CAST && hasTrigger(skills, SK_CAST) && lastPlayed != null) {
      if (castFor(byFoe, lastPlayed!, skills)) {
        return
      }
    }
    // 伏流：它当通配凑最长的顺子，凑成就收走那几张。
    //
    // **排在收色、撒网后面，野火前面** —— 跟那两件同组（都是「换一条
    // 判定线」的收牌技能），而排在野火前面照的是野火那条注释的同一个理由：
    // 收牌的先收完，点火的最后来
    if (from <= TAIL_FLOW && hasTrigger(skills, SK_FLOW)) {
      if (straightFor(byFoe, skills)) {
        return
      }
    }
    // 涉水：顺子的步长放宽到 2。**自己一段** —— 每件散收技能都得有
    //（理由见 TAIL_* 常量那段：共用段号会静默地重复执行或被跳过）
    if (from <= TAIL_WADE && hasTrigger(skills, SK_WADE)) {
      if (wadeFor(byFoe, skills)) {
        return
      }
    }
    // 漫流：先推 1 层牌，再判顺子。**自己一段**（TAIL_BRIM）——
    // 每件散收技能都得有，理由见 TAIL_* 那段。
    //
    // 排在伏流、涉水**后面**：三件都收牌，而一张牌同时带两件时
    //（花色槽一件、点数槽一件）先跑的那件可能把堆收空。
    // 漫流排最后是因为它**自己会把堆垫厚** —— 即使前面那件收走了一片，
    // 它推上来的 2 张照样能凑
    if (from <= TAIL_BRIM && hasTrigger(skills, SK_BRIM)) {
      if (brimFor(byFoe, skills)) {
        return
      }
    }
    // 野火：给堆上所有牌点火，已经着了的收走。
    //
    // **排在收色、撒网后面**：它们先把该收的收掉，野火再给剩下的点火。
    // 反过来的话野火刚点着的那几张会被收色当场收走 ——
    // 而野火的卖点恰恰是「这一轮标记、下一轮收」，当场被端走就没了
    if (from <= TAIL_WILD && hasTrigger(skills, SK_WILD)) {
      if (wildfireFor(byFoe, skills)) {
        return
      }
    }
    // ---- 动对方手牌那几件：排在冻结**前面** ----
    //
    // 停人的技能一个回合只停一次（下面每一件玩家侧都 return），所以
    // 同一张牌触发两件停人技能时，**只走前面那件**，后面那件作废。
    // 排序照「贵的赢」—— 跟择饵赢过观潮是同一条规矩：
    //
    //   对换 160 > 摘钩 150 = 死水 150 > 压舱 80 > 冻结 70 > 换水 60
    //   > 择饵 100 > 同号 100 > 观潮 60
    //
    //（择饵和换水那两档是原有顺序，没动 —— 它们之间的闸见各自那段注释）
    //
    // 这几件跟冻结的要紧区别：**它们让你看得见**。一发动就把对方全部手牌
    // 翻开给你挑（见 foeOpen 里认 takeSkill 那一条），所以它们是精准打击，
    // 冻结是一次下注。
    //
    // 死水排在摘钩**后面**（同价 150，但摘钩是原有的，不动它的位置）
    if (hasTrigger(skills, SK_DEAD)) {
      // 挑得动的那几张（排掉 J 和已经废过的，见 deadPool）
      if (deadPool(byFoe).length > 0) {
        if (!byFoe) {
          takeSkill.value = SK_DEAD
          // 挑几张：DEAD_COUNT，但别超过挑得动的数量
          const room = deadPool(false).length
          deadLeft.value = room < DEAD_COUNT ? room : DEAD_COUNT
          return
        }
        // 庄家自己挑：一张一张来，每挑一次重新算池子
        //（上一张废掉之后它就不在池子里了，不然两张会挑中同一个）
        for (let n = 0; n < DEAD_COUNT; n++) {
          const at = foeDeadPick()
          if (at < 0) {
            break
          }
          doDead(true, at)
        }
      }
    }
    if (hasTrigger(skills, SK_SWAPCARD) || hasTrigger(skills, SK_UNHOOK)
      || hasTrigger(skills, SK_PRESS)) {
      const which = hasTrigger(skills, SK_SWAPCARD) ? SK_SWAPCARD
        : (hasTrigger(skills, SK_UNHOOK) ? SK_UNHOOK : SK_PRESS)
      const theirs = byFoe ? hand.value : foeHand.value
      if (theirs.length > 0) {
        if (!byFoe) {
          takeSkill.value = which
          return
        }
        // 庄家自己挑：它看得见你全部手牌（这三件本来就是「看对方手牌」），
        // 所以挑的是实打实最值钱的那张（见 foeTakePick）
        doTakeFrom(true, which, foeTakePick())
      }
    }
    // ---- 【引潮】：翻开对方手牌，挑 1 张贴 SURGE_LAYERS 层【推牌】 ----
    //
    // 排在这儿是**按价插的**（上面那张表：对换 160 > 摘钩/死水 150 >
    // 压舱 80 > **引潮 75** > 冻结 70 > 换水 60）。
    //
    // 它跟上面那几件同族（都「翻开对方手牌让你挑」），但**它不立刻生效** ——
    // 贴的是个标签，等对方打出那张牌才兑现。所以它是全表唯一一件
    // **把代价交给对手去选时机**的：他能躲的只是「别拿它当饵」，
    // 可那张牌他终究要打（实测回避只削掉 26%，而且收敛）。
    //
    // 只挑 1 张（不是 2 张）—— 同样推 4 张/次，**集中比分散强 33%**，
    // 见 draw-skills 里 SURGE_LAYERS 那段
    if (hasTrigger(skills, SK_SURGE)) {
      if (surgePool(byFoe).length > 0) {
        if (!byFoe) {
          takeSkill.value = SK_SURGE
          return
        }
        doSurge(true, foeSurgePick())
      }
    }
    // 冻结：锁对方一张手牌。你用的时候要挑位置，所以会停下来等
    if (hasTrigger(skills, SK_FREEZE) && lastPlayed != null && inPile(lastPlayed!)) {
      const theirs = byFoe ? hand.value : foeHand.value
      if (theirs.length > 0) {
        if (!byFoe) {
          freezePending.value = true
          return
        }
        // 庄家挑：它看得见的里头挑点数最大的，看不见就随机
        doFreeze(true, foeFreezePick())
      }
    }
    // 换水：挑一张自己的手牌塞回牌库洗掉。
    //
    // 排在观潮**前面**：两件都可能停下来等你选，而一个回合里只停一次说得清。
    // 手里没牌了就跳过 —— 没得挑
    if (hasTrigger(skills, SK_SWAP)) {
      const mine = byFoe ? foeHand.value : hand.value
      if (mine.length > 0) {
        if (!byFoe) {
          swapPending.value = true
          return
        }
        // 庄家自己挑：扔掉最没用的那张（见 foeSwapPick）
        const at = foeSwapPick()
        if (at >= 0) {
          const card = takeFromHand(true, at)
          shuffleBack(card)
          message.value = message.value + ' 庄家换水，塞回一张重洗。'
        }
      }
    }
    // 择饵：摊开牌库顶**五张**，挑一张留顶，其余沉底。
    //
    // 排在观潮**前面**，而且两件都停人 —— 一个回合只停一次（见换水那段），
    // 所以同一张牌上两件都触发的时候，走的是择饵、观潮那次作废。
    // 这是有意的取舍：择饵看得多、挑得准、还贵（100 对 60），
    // 那它就该是赢的那一件。两件撞在同一个点数上本身就是一次失算
    if (hasTrigger(skills, SK_PICK) && deck.value.length > 1) {
      const tops = topCards(PICK_LOOK)
      if (!byFoe) {
        pickTops.value = tops
        pickPending.value = true
        return
      }
      // 庄家自己挑（见 foePickDeck）
      doPickDeck(true, foePickDeck(tops))
    }
    // 〔【同花】那一支 2026-10-16 清掉（技能 10-14 删的）。
    //   它原先排在这儿、**不停人** —— 没什么可挑的。
    //   那条排序判据还在用：**停人的技能要排在不停人的后面**，
    //   不然后面那几件会被 `return` 截住、这一手白发动〕
    // 分饵：看牌库顶 6 张，给自己和对手各 1 张。**停人**（玩家点两下）。
    //
    // 排在择饵**后面**：两件都停人，而「一个回合只停一次」——
    // 所以同一张牌上两件都触发时走的是择饵，这一次作废。
    // 那是照择饵赢过观潮的同一条规矩（**贵的赢**）：择饵 100 > 分饵 85。
    //
    // ⚠ 它必须排在**所有停人技能之后**吗？不 —— 它跟择饵、同号是同一组
    //（都是「看牌库」那一类），而动对方手牌那几件在更后面、各自 return。
    // 关键只有一条：**停人的技能之间的先后 = 谁赢**，而那按价排
    if (hasTrigger(skills, SK_GIFT) && deck.value.length > 0) {
      const tops = topCards(GIFT_LOOK)
      if (tops.length > 0) {
        if (!byFoe) {
          giftTops.value = tops
          giftPicks.value = [] as number[]
          giftPending.value = true
          return
        }
        doGift(true, tops, foeGiftPick(tops))
      }
    }
    // 同号：牌库里同点数的那几张（最多 3 张）摊开让你挑。停人，
    // 排在择饵后面 —— 两件同价（100），但择饵是原有的，不改它的位置。
    // 牌库里一张同点数的都没有就跳过
    if (hasTrigger(skills, SK_TWIN) && lastPlayed != null) {
      const pool = twinPool(lastPlayed!)
      if (pool.length > 0) {
        if (!byFoe) {
          twinCards.value = pool
          twinPending.value = true
          return
        }
        doTwin(true, pool[foeTwinPick(pool)])
      }
    }
    // 观潮：看牌库顶**两张**，可以把它俩一起沉到底。
    //
    // ---- 回合末补牌把这件技能的朝向翻了过来 ----
    //
    // 从前是「每回合开始摸一张」，所以你打完之后，牌库顶那张是
    // **对方**马上要摸的 —— 观潮是在偷看对手的下一张。
    //
    // 改成回合末补牌（见 passTurn）之后，补的是**刚打完那一方**，
    // 也就是你自己。于是顶上那两张变成了**你自己**要补的牌：
    // 看着不顺手就沉掉，换两张未知的上来。
    //
    // 技能从「偷看对手」变成了「挑自己的牌」。这是上一轮改回合制带来的
    // 连带后果，说明和庄家的判断都跟着改了
    //
    // 带 `!hasTrigger(SK_PICK)` 这个闸是为了**让庄家和你受同一条规矩**：
    // 你那边两件都触发时只走择饵（停人的那一刻就 return 了），
    // 庄家不停人、不加闸就会两件都吃，同一套配装它比你强 —— 那不行
    if (hasTrigger(skills, SK_TIDE) && !hasTrigger(skills, SK_PICK)
      && deck.value.length > 1) {
      const tops = tideTops()
      if (!byFoe) {
        tideCards.value = tops
        const marks : boolean[] = []
        for (let i = 0; i < tops.length; i++) {
          marks.push(false)
        }
        tideMarks.value = marks
        tidePending.value = true
        return
      }
      // 庄家看的是它自己要补的两张，**一张一张判**：用不上的沉，用得上的留。
      // 「用得上」= J（通吃），或者钓得着堆上的某张。
      // 跟你受同一条规矩 —— 你也是每张单独选（见 onTideCard）
      const marks : boolean[] = []
      let sunk = 0
      for (let i = 0; i < tops.length; i++) {
        let useful = tops[i].rank == JACK
        for (let k = 0; k < pile.value.length && !useful; k++) {
          if (pile.value[k].rank == tops[i].rank) {
            useful = true
          }
        }
        marks.push(!useful)
        if (!useful) {
          sunk = sunk + 1
        }
      }
      if (sunk > 0) {
        sinkMarked(marks)
        message.value = message.value + ' 庄家观潮，把牌库顶 '
          + sunk + ' 张沉了下去。'
      }
    }
    // ---- 【燃烧】那一步：蔓延 + 燃尽判定，**排在匹配之前** ----
    //
    // 结算顺序：落堆 → 场上效果 → 卡牌效果（上面那一整串）→
    // **燃烧（这儿）** → 匹配。
    //
    // 它在这儿而不在 endPlay 里（蔓延原先在那儿），是因为排在匹配前面
    // 「一张牌收两次」那道闸就是免费的 —— 燃尽扫走整堆时刚打那张
    // 也在里面，被收走了，匹配自然碰不到它。
    //
    // 开演扫牌特效了就别走匹配，演完由 finishSweep 认 TAIL_BURN 接过去
    if (burnStep(byFoe, skills)) {
      return
    }
    // 技能都结算完了，轮到这张牌去匹配（见 resolveMatch）
    resolveMatch(byFoe)
  }

  // 牌库顶往下数 n 张（不够就有几张算几张）。
  // 牌库是数组末尾当顶，所以倒着取 —— 第 0 个是最顶上那张。
  // 观潮（2 张）和择饵（5 张）共用它
  function topCards(n : number) : PlainCard[] {
    const out : PlainCard[] = []
    for (let i = 0; i < n; i++) {
      const at = deck.value.length - 1 - i
      if (at < 0) {
        break
      }
      out.push(deck.value[at])
    }
    return out
  }

  function tideTops() : PlainCard[] {
    return topCards(TIDE_LOOK)
  }

  function tideNames(list : PlainCard[]) : string {
    let text = ''
    for (let i = 0; i < list.length; i++) {
      text = text + (i > 0 ? '、' : '') + cardName(list[i])
    }
    return text
  }

  // 把顶上 n 张一起沉到底。**顺序原样搬**，不打乱 ——
  // 你看过它俩了，沉下去之后还是那个先后，这一层信息不该白送掉
  function sinkTops(n : number) {
    const rest = deck.value.slice(0)
    const moved : PlainCard[] = []
    for (let i = 0; i < n && rest.length > 0; i++) {
      moved.push(rest.pop()!)
    }
    // moved 是从顶往下取的（先取最顶上那张），倒回去才是原来的先后
    const bottom : PlainCard[] = []
    for (let i = moved.length - 1; i >= 0; i--) {
      bottom.push(moved[i])
    }
    deck.value = bottom.concat(rest)
  }

  // 观潮：牌库顶那几张里，标了「沉」的沉到库底，没标的留在顶上。
  // marks 跟 topCards 对齐（第 0 个是最顶上那张）。
  //
  // 两头都**保持原来的先后**（理由同 sinkTops：你看过它们了，这层信息不该白送掉）：
  // 留下的还是那个先后摞在顶上，沉下去的照 sinkTops 那个次序垫在最底下
  function sinkMarked(marks : boolean[]) {
    const n = marks.length
    const rest = deck.value.slice(0)
    const taken : PlainCard[] = []
    for (let i = 0; i < n && rest.length > 0; i++) {
      // 从顶往下取：taken[0] 是最顶上那张，跟 marks[0] 对得上
      taken.push(rest.pop()!)
    }
    const bottom : PlainCard[] = []
    for (let i = taken.length - 1; i >= 0; i--) {
      if (marks[i]) {
        bottom.push(taken[i])
      }
    }
    // 留下的放回顶上：数组末尾是顶，所以从下往上推回去（最顶上那张最后推）
    let top = bottom.concat(rest)
    for (let i = taken.length - 1; i >= 0; i--) {
      if (!marks[i]) {
        top = top.concat([taken[i]])
      }
    }
    deck.value = top
  }

  // 点一张：标「沉」/ 取消
  function onTideCard(index : number) {
    if (!tidePending.value || index < 0 || index >= tideMarks.value.length) {
      return
    }
    const next = tideMarks.value.slice(0)
    next[index] = !next[index]
    tideMarks.value = next
  }

  // 按确定：标了的沉下去，然后接着走匹配
  function onTideDone() {
    if (!tidePending.value) {
      return
    }
    tidePending.value = false
    const marks = tideMarks.value.slice(0)
    const cards = tideCards.value.slice(0)
    tideCards.value = [] as PlainCard[]
    tideMarks.value = [] as boolean[]
    const sunk : PlainCard[] = []
    for (let i = 0; i < marks.length && i < cards.length; i++) {
      if (marks[i]) {
        sunk.push(cards[i])
      }
    }
    if (sunk.length > 0) {
      sinkMarked(marks)
      message.value = '你把 ' + tideNames(sunk) + ' 沉到了牌库底。'
    }
    resolveMatch(false)
  }

  // 择饵落地：顶上那 n 张里留第 keep 张，其余沉到底。
  //
  // 做法是「全沉下去，再把挑中那张单独放回顶上」—— 比在数组中间挪位置好写，
  // 也更难错。沉下去那几张**保持原来的先后**（见 sinkTops 那段的理由）
  function doPickDeck(byFoe : boolean, keep : number) {
    const tops = topCards(PICK_LOOK)
    if (tops.length == 0) {
      return
    }
    const at = keep < 0 || keep >= tops.length ? 0 : keep
    const card = tops[at]
    sinkTops(tops.length)
    // 整个换一份而不是 push：牌库别处（sinkTops、洗回去）都是换引用，
    // 一处 push 一处换引用迟早在响应式上踩一脚
    deck.value = deck.value.concat([card])
    const note = byFoe
      ? ' 庄家择饵，给自己挑了一张（' + tops.length + ' 张里挑 1）。'
      : ' 择饵：' + cardName(card) + ' 留在牌库顶，其余 ' + (tops.length - 1) + ' 张沉底。'
    message.value = message.value + note
  }

  // 你挑中了第 index 张
  function onPickDeck(index : number) {
    if (!pickPending.value) {
      return
    }
    pickPending.value = false
    pickTops.value = [] as PlainCard[]
    doPickDeck(false, index)
    resolveMatch(false)
  }

  // ---------- 【分饵】点牌：**第一下给自己、第二下给对方** ----------
  //
  // 两下点完才结算，所以这一件停人一次、点两下。
  // 点**已选中的那张**取消它（照观潮「点一张标记沉，再点取消」那条交互）——
  // 不给取消的话点错第一张就只能认了，而这件技能的全部内容就是那两次选择。
  //
  // 牌库只剩 1 张时 `tops` 只有 1 张，那就点一下结算（第二张传 −1）——
  // 那一手拿的是奇数张、会翻一次牌库奇偶，但那时候牌库马上就空了，
  // 影响不到终局结构（见 doGift 那段）
  function onGiftCard(index : number) {
    if (!giftPending.value || index < 0 || index >= giftTops.value.length) {
      return
    }
    const picks : number[] = []
    for (let i = 0; i < giftPicks.value.length; i++) {
      picks.push(giftPicks.value[i])
    }
    // 点已选中的那张 = 取消
    const at = picks.indexOf(index)
    if (at >= 0) {
      picks.splice(at, 1)
      giftPicks.value = picks
      return
    }
    if (picks.length >= 2) {
      return
    }
    picks.push(index)
    // 还能再挑一张就等着（牌库只给了 1 张的话直接结算）
    if (picks.length < 2 && giftTops.value.length > 1) {
      giftPicks.value = picks
      return
    }
    const tops = giftTops.value
    giftPending.value = false
    giftTops.value = [] as PlainCard[]
    giftPicks.value = [] as number[]
    if (picks.length < 2) {
      picks.push(-1)
    }
    doGift(false, tops, picks)
    resolveMatch(false)
  }

  // 庄家从那几张里挑哪一张。
  //
  // 它挑的是**自己回合末要补的牌**，所以标准跟观潮那边一致：
  //   J 最好（通吃，什么都钓得上）；
  //   其次是钓得着堆上某张的（当场就能收）；
  //   都没有就挑点数最大的（压在堆上最难被钓走）。
  //
  // **不偷看你的手牌** —— 庄家的记牌本事只及于「牌库里还剩什么」
  // （见 outsideCount），你手里那几张它跟你一样不知道
  function foePickDeck(tops : PlainCard[]) : number {
    let best = 0
    let bestScore = -1
    for (let i = 0; i < tops.length; i++) {
      let score = tops[i].rank == JACK ? 100 : tops[i].value
      if (tops[i].rank != JACK) {
        for (let k = 0; k < pile.value.length; k++) {
          if (pile.value[k].rank == tops[i].rank) {
            score = score + 50
            break
          }
        }
      }
      if (score > bestScore) {
        bestScore = score
        best = i
      }
    }
    return best
  }

  // ---------- 【分饵】：看牌库顶 6 张，给自己和对手各 1 张 ----------
  //
  // 挑法照【择饵】的 `foePickDeck`（同点数在堆上 = 能钓到 → 加分，J 最高），
  // 只是**对手那张取最低分** —— 塞给他最没用的。
  //
  // ---- 玩家挑**两张**：第一张给自己、第二张给对方（庄家自动挑）----
  //
  // 「一个回合只停一次」那条规矩照旧 —— 停的是一次，
  // 只是这一次里要点两下（见 `giftPicks`）。
  //
  // 庄家侧两张都按最优自动挑（照 `pickWildAt` 那条「按最优实现是有意的」：
  // 按笨启发式实现量出来是「AI 挑得多好」、不是技能的上限）。
  // 模拟器那边两边都按最优，X=2.93 就是那个口径的数 —— 而玩家手挑
  // **不会超过那个上限**（他最多挑得跟程序一样好），所以数不用重量。
  function giftScore(card : PlainCard, forFoe : boolean) : number {
    if (card.rank == JACK) {
      return 100
    }
    let score = card.value
    // 能匹配堆上某张 = 这一手就能钓到，所以对持有者值钱得多
    for (let k = 0; k < pile.value.length; k++) {
      if (pile.value[k].rank == card.rank) {
        score = score + 50
        break
      }
    }
    return score
  }

  // 庄家自己挑那两张：给自己取分最高、给对方取剩下里分最低。
  // 返回 [给自己的下标, 给对方的下标]，后者可能是 −1（只看到 1 张）
  function foeGiftPick(tops : PlainCard[]) : number[] {
    let mineAt = 0
    for (let i = 1; i < tops.length; i++) {
      if (giftScore(tops[i], false) > giftScore(tops[mineAt], false)) {
        mineAt = i
      }
    }
    let foeAt = -1
    for (let i = 0; i < tops.length; i++) {
      if (i == mineAt) {
        continue
      }
      if (foeAt < 0 || giftScore(tops[i], true) < giftScore(tops[foeAt], true)) {
        foeAt = i
      }
    }
    return [mineAt, foeAt]
  }

  // `picks` = [给自己的下标, 给对方的下标]。第二个传 −1 就只给自己一张
  //（牌库只剩 1 张时会这样，而那也意味着**这一手拿了奇数张** ——
  //  牌库奇偶会翻一次，不过那时候牌库马上就空了，影响不到终局结构）
  function doGift(byFoe : boolean, tops : PlainCard[], picks : number[]) {
    if (tops.length == 0) {
      return
    }
    const mineAt = picks.length > 0 && picks[0] >= 0 && picks[0] < tops.length
      ? picks[0] : 0
    const foeAt = picks.length > 1 && picks[1] >= 0 && picks[1] < tops.length
      && picks[1] != mineAt ? picks[1] : -1
    // 先把看过的全部沉底，再把挑中的两张拿出来给人 ——
    // 顺序照 doPickDeck（sinkTops 之后再动那张牌），不然下标会错
    sinkTops(tops.length)
    const mineCard = tops[mineAt]
    // 从牌库里摘掉那两张（它们刚被沉到底，所以按引用找）
    const rest : PlainCard[] = []
    for (let i = 0; i < deck.value.length; i++) {
      const c = deck.value[i]
      if (c == mineCard || (foeAt >= 0 && c == tops[foeAt])) {
        continue
      }
      rest.push(c)
    }
    deck.value = rest
    // 进手牌。**手牌上限不限**（4 张只是下限，回合末补到 4），
    // 所以这一张是净增 —— 那也是这件技能的全部分值来源
    if (byFoe) {
      foeHand.value = foeHand.value.concat([mineCard])
      foeShown.value = foeShown.value.concat([false])
      if (foeAt >= 0) {
        hand.value = hand.value.concat([tops[foeAt]])
        handSeen.value = handSeen.value.concat([false])
      }
    } else {
      hand.value = hand.value.concat([mineCard])
      handSeen.value = handSeen.value.concat([false])
      if (foeAt >= 0) {
        foeHand.value = foeHand.value.concat([tops[foeAt]])
        foeShown.value = foeShown.value.concat([false])
      }
    }
    const who = byFoe ? ' 庄家分饵：' : ' 分饵：'
    message.value = message.value + who + '看了 ' + tops.length + ' 张，'
      + (byFoe ? '给自己留 1 张、塞给你 1 张' : '留下 ' + cardName(mineCard)
        + '、塞给庄家 1 张')
      + '，其余沉底。'
  }

  // 冻结：把对方第 index 张手牌锁住，效果挂在刚打出那张牌上。
  //
  // 记的是**牌的对象引用**而不是下标 —— 对方手里的牌会打出、会补，
  // 下标一直在变，锁下标就锁错人了
  function doFreeze(byFoe : boolean, index : number) {
    const theirs = byFoe ? hand.value : foeHand.value
    if (index < 0 || index >= theirs.length || lastPlayed == null) {
      return
    }
    addHeld({
      source: lastPlayed!,
      skill: SK_FREEZE,
      target: theirs[index],
      byFoe: byFoe
    } as HeldEffect)
    message.value = message.value + (byFoe
      ? ' 庄家冻结：你第 ' + (index + 1) + ' 张手牌打不出去了。'
      : ' 冻结：庄家第 ' + (index + 1) + ' 张手牌打不出去了。')
  }

  // ---------- 【薪潮】贴标签那一半 ----------
  //
  // 池子**只排 J**（J 不触发任何技能，贴了也不会兑现，等于白贴一张）。
  // **不排已经带标签的** —— 推牌可叠加、不设上限，重复贴正是它的用法
  //（照 `surgePool`；别照 `deadPool` 排掉已废的那个样子）
  function fuelPool(byFoe : boolean) : number[] {
    const theirs = byFoe ? hand.value : foeHand.value
    const out : number[] = []
    for (let i = 0; i < theirs.length; i++) {
      if (theirs[i].rank == JACK) {
        continue
      }
      out.push(i)
    }
    return out
  }

  // 给对方第 index 张手牌贴 1 层【推牌】。byFoe = 发动方
  function doFuel(byFoe : boolean, index : number) {
    const theirs = byFoe ? hand.value : foeHand.value
    if (index < 0 || index >= theirs.length) {
      return
    }
    const card = theirs[index]
    // J 挡在这儿 —— 界面那边也拦了，可庄家走 foeFuelPick，两条路都得过这道闸
    if (card.rank == JACK) {
      return
    }
    addSurgeHand(card)
    // **报位置不报牌面** —— 盲选的全部内容就是「你不知道贴的是什么」，
    // 播报里说出牌名等于把它变成看着挑（照冻结那两句的写法）
    message.value = message.value + (byFoe
      ? ' 庄家薪潮：你第 ' + (index + 1) + ' 张手牌带上了推牌。'
      : ' 薪潮：庄家第 ' + (index + 1) + ' 张手牌带上了推牌。')
  }

  // 庄家盲选哪一张。**照 `foeFreezePick` 那条先例：它看得见的里头挑，
  // 看不见就随机** —— 而多数局面它看不见你的手牌，所以等于随机，
  // 跟玩家盲选对称。
  //
  // 看得见时挑**点数最大的**：那张他最可能尽快打出来（照 foeFreezePick）
  function foeFuelPick() : number {
    const pool = fuelPool(true)
    if (pool.length == 0) {
      return -1
    }
    let best = -1
    let bestVal = -1
    for (let i = 0; i < pool.length; i++) {
      const at = pool[i]
      if (!foeKnows(at)) {
        continue
      }
      if (hand.value[at].value > bestVal) {
        bestVal = hand.value[at].value
        best = at
      }
    }
    if (best >= 0) {
      return best
    }
    // 一张都看不见 —— 随机挑一个位置
    return pool[Math.floor(Math.random() * pool.length)]
  }

  // 你盲选了庄家第 index 张（-1 表示放过）
  function onFuel(index : number) {
    if (!fuelPending.value) {
      return
    }
    if (index < 0) {
      // 放过：贴一张也是贴，没必要逼他挑满（照死水那条）
      fuelPending.value = false
      fuelLeft.value = 0
      message.value = message.value + ' 你放过了。'
      resolveMatch(false)
      return
    }
    doFuel(false, index)
    fuelLeft.value = fuelLeft.value - 1
    // 还要挑，而且还有挑得动的
    if (fuelLeft.value > 0 && fuelPool(false).length > 0) {
      return
    }
    fuelPending.value = false
    fuelLeft.value = 0
    resolveMatch(false)
  }

  // 你挑中了庄家第 index 张（-1 表示不冻）
  function onFreeze(index : number) {
    if (!freezePending.value) {
      return
    }
    freezePending.value = false
    if (index >= 0) {
      doFreeze(false, index)
    } else {
      message.value = '你没冻。'
    }
    resolveMatch(false)
  }

  // 点庄家手牌那一排：按现在在等哪件技能分路。
  //
  // 一个入口而不是在模板里写两个 @click —— 同一排牌同时只会在等一件事，
  // 分路放在这儿，模板那边就只有一个 onFoeCard
  function onFoeCard(index : number) {
    if (takeSkill.value >= 0) {
      // 【死水】挑不动的那几张（J、已经废过的）点了不该有反应 ——
      // 不拦的话 doDead 里那道闸会静静地吃掉这一下，而 deadLeft 已经减了，
      // 于是你白丢一张名额。界面上它们也没有 card-pickable
      //
      // 【引潮】同一个道理（它挑不了 J）—— 两件都走 canPickFoe
      if ((takeSkill.value == SK_DEAD || takeSkill.value == SK_SURGE)
        && !canPickFoe(index)) {
        return
      }
      onTakeFrom(index)
      return
    }
    if (freezePending.value) {
      onFreeze(index)
      return
    }
    // 【薪潮】盲选（照冻结那条路，不翻开）
    if (fuelPending.value) {
      onFuel(index)
    }
  }

  // 庄家手牌第 index 张现在点得动吗（模板那排的高亮和 onFoeCard 都读它）。
  //
  // 冻结挑的是**位置**（那几张多半盖着），所以它不挑牌 —— 一律点得动。
  // 死水看得见、而且有两条排除（J、已经废过的），所以要单独判
  function canPickFoe(index : number) : boolean {
    if (freezePending.value) {
      return true
    }
    // 【薪潮】也是盲选，但它**有一条排除**：J 贴了不会兑现（J 不触发技能）。
    //
    // 于是「盲选」在它身上有个边界：牌是盖着的，可**点不动的那张等于
    // 告诉你它是 J** —— 那是漏出来的一点信息。
    // 留着是对的：另一条路（让你白贴一张 J）更坏，而冻结那边压根没有排除，
    // 所以这一点信息是薪潮独有的代价
    if (fuelPending.value) {
      if (index < 0 || index >= foeHand.value.length) {
        return false
      }
      return foeHand.value[index].rank != JACK
    }
    if (takeSkill.value < 0) {
      return false
    }
    // 【引潮】跟死水一样**看得见、而且有排除**（J 挑不了），所以也要单独判。
    // 它比死水少一条：**已经带标签的照旧能挑**（叠加不设上限）
    if (takeSkill.value == SK_SURGE) {
      if (index < 0 || index >= foeHand.value.length) {
        return false
      }
      return foeHand.value[index].rank != JACK
    }
    if (takeSkill.value != SK_DEAD) {
      return true
    }
    if (index < 0 || index >= foeHand.value.length) {
      return false
    }
    const card = foeHand.value[index]
    return card.rank != JACK && !isDead(card)
  }

  // ---------- 压舱 / 摘钩 / 对换：你点了庄家第 index 张（-1 = 不要） ----------
  //
  // 点的动作借庄家手牌那一排（跟冻结同一个入口，见模板里 onFoeCard）。
  // 对换还要再挑一张自己的，所以它不在这儿交回合 —— 交回合在 onGiveBack
  function onTakeFrom(index : number) {
    const which = takeSkill.value
    if (which < 0) {
      return
    }
    // ---- 【死水】要挑 DEAD_COUNT 张，所以它自己管状态 ----
    //
    // 别的三件挑一张就走，死水挑够之前**不清 takeSkill、不交回合** ——
    // 那一排手牌保持可点，提示语里报还剩几张（见 takeText）
    if (which == SK_DEAD) {
      if (index < 0) {
        // 放过：剩下几张不挑了。废一张也是废，没必要逼他挑满
        takeSkill.value = -1
        deadLeft.value = 0
        message.value = message.value + ' 你放过了。'
        resolveMatch(false)
        return
      }
      doDead(false, index)
      deadLeft.value = deadLeft.value - 1
      // 还要挑，而且还有挑得动的（没废过、不是 J）
      if (deadLeft.value > 0 && deadPool(false).length > 0) {
        return
      }
      takeSkill.value = -1
      deadLeft.value = 0
      resolveMatch(false)
      return
    }
    // ---- 【引潮】只挑一张，所以走最简那条（挑完就清、就交匹配）----
    //
    // 它**不复用下面 doTakeFrom 那条路**：那三件（压舱 / 摘钩 / 对换）
    // 当场把牌拿走或换掉，而引潮只贴个标签、牌还在他手里。
    // 硬塞进 doTakeFrom 就得在那个函数里加一个「什么都不搬」的分支
    if (which == SK_SURGE) {
      takeSkill.value = -1
      if (index < 0) {
        // 放过：不贴了。留这条路是照死水那条先例（没必要逼他挑）
        message.value = message.value + ' 你放过了。'
      } else {
        doSurge(false, index)
      }
      resolveMatch(false)
      return
    }
    takeSkill.value = -1
    if (index < 0) {
      message.value = '你放过了。'
      resolveMatch(false)
      return
    }
    doTakeFrom(false, which, index)
    // 对换：doTakeFrom 把 giveBack 立起来了，等你再挑一张还它
    if (giveBack.value >= 0) {
      return
    }
    resolveMatch(false)
  }

  // 对换第二步：你点了自己第 index 张还给庄家（-1 = 不还，那就是白拿一张）。
  //
  // 「不还」这条路留着是有理由的：手里只剩一张好牌的时候，
  // 白拿一张反而亏 —— 但多一张手牌总比少一张强，所以不还是正解。
  // 真要堵的话得禁掉这个按钮，而那样就不是「两边都由你挑」了
  function onGiveBack(index : number) {
    if (giveBack.value < 0) {
      return
    }
    giveBack.value = -1
    if (index < 0) {
      message.value = message.value + ' 你没还牌（白拿一张）。'
    } else {
      doGiveBack(false, index)
    }
    resolveMatch(false)
  }

  // 同号：你从那几张同点数的里点了第 index 张（-1 = 不要）
  function onTwin(index : number) {
    if (!twinPending.value) {
      return
    }
    twinPending.value = false
    const pool = twinCards.value
    twinCards.value = [] as PlainCard[]
    if (index >= 0 && index < pool.length) {
      doTwin(false, pool[index])
    } else {
      message.value = message.value + ' 同号：你一张都没要。'
    }
    resolveMatch(false)
  }

  // 庄家冻你哪张：**看得见的里头挑点数最大的，一张都看不见就随机**。
  //
  // 「看得见」= 它窥视过的、或者它的照水正亮着。所以这件技能在它手里
  // 也是「有情报就精准、没情报就下注」—— 跟你用它时一个样
  function foeFreezePick() : number {
    const canSee = heldOn(SK_LANTERN, true)
    let best = -1
    let bestValue = -1
    for (let i = 0; i < hand.value.length; i++) {
      if (isFrozen(hand.value[i])) {
        continue
      }
      const seen = canSee || (i < handSeen.value.length && handSeen.value[i])
      if (!seen) {
        continue
      }
      if (hand.value[i].value > bestValue) {
        best = i
        bestValue = hand.value[i].value
      }
    }
    if (best >= 0) {
      return best
    }
    // 一张都看不见：在没被冻的里头随机挑
    const free : number[] = []
    for (let i = 0; i < hand.value.length; i++) {
      if (!isFrozen(hand.value[i])) {
        free.push(i)
      }
    }
    return free.length == 0 ? -1 : free[Math.floor(Math.random() * free.length)]
  }

  // 见底：它自己算 0 点（见 valuesOf），整堆点数往下压 LOW_TIDE_STEP，
  // **收走点数为 0 的牌**。
  //
  // 幅度原先是「场上黑牌张数」，改成了死数 1 ——
  // 为什么改、代价是什么，写在 draw-skills 见底那条的注释里
  //（设计理由归表，实现归这儿；两处都写就会有一处先过期）。
  //
  // 「减到 0 为止」不在这儿解释 —— 那是条全局规则，见 dropVals。
  //
  // ---- 它**连自己一起收走** ----
  //
  // 它自己是 0 点，而且它就在「场上所有牌」里头，所以压完它还是 0、
  // 于是被自己收走。那是这条规则直写下来的后果，不是漏洞：
  //
  //   好处是它**保底 +1 分**，而且不会在堆上留下一张饵
  //     （普通的空钩牌会留在堆上给对手当钩点）；
  //   代价是它放弃了这一手的钓牌（0 点谁也钓不上）。
  //
  // 这儿**没有加**收色 / 撒网那条「只有它自己就什么都不收」的闸 ——
  // 那两件的代价是「失去点数」而收成是「按花色/奇偶扫一片」，自收一张
  // 等于零风险白赚；见底不一样：它的 0 点是写在效果里的，自收那一张
  // 就是它的收成下限。要不要加闸等模拟器量过再说。
  //
  // 收牌特效照钓牌那套演（亮起 → 飘走 → 积分跳），只是收的是散在堆里的
  // 0 点牌、不是连续段 —— 所以走 startSweep / catchSet，见 dropPile 下面那几个
  const LOW_TIDE_STEP : number = 1

  // 开演收牌特效了返回 true（afterPlay 停下，演完由 finishSweep 接着走）
  function lowTideFor(byFoe : boolean, skills : number[]) : boolean {
    const n = LOW_TIDE_STEP
    if (pile.value.length == 0) {
      message.value = message.value + ' 见底：场上没有牌，水位没动。'
      return false
    }
    const taken = dropPile(n)
    message.value = message.value + (byFoe ? ' 庄家见底：' : ' 见底：')
      + '整堆 −' + n
      + (taken.length > 0 ? '，收走见底的 ' + taken.length + ' 张。' : '，没有牌被压到底。')
    return startSweep(byFoe, taken, skills, TAIL_EBB)
  }

  // 整堆各减 step（dropVals：减到 0 为止、去重、空列表原样返回），**当场写回**，
  // 返回减完之后一个非零点数都不剩的那几张的下标 —— 见底要收的就是它们。
  //
  // 那几张**先不拿掉**：留在堆上显示成 0 点，演完收牌特效再拿（见 finishSweep）。
  // 没有点数的牌（顺色那张）原样留着，也不会被收：它不在点数这条轴上。
  // 还剩一个非零点数就不算归零（anyLive）：贴过点数卡的牌因此更难被收走
  function dropPile(step : number) : number[] {
    const vals : number[][] = []
    const taken : number[] = []
    for (let i = 0; i < pile.value.length; i++) {
      // **rawVals 不是 pileValsAt**：这一行**写**回 pileVals，
      // 从带在场效果的那个读会把效果写死（带火 → 空点数永久化）
      const now = dropVals(rawVals(i), step)
      vals.push(now)
      if (now.length > 0 && !anyLive(now)) {
        taken.push(i)
      }
    }
    pileVals.value = vals
    return taken
  }

  // 散着收：那几张亮起 → 飘走 → 拿掉、记分、积分跳一下，跟钓牌（startCatch）同一套。
  // 没有要收的就返回 false，调用方接着往下走
  function startSweep(byFoe : boolean, taken : number[], skills : number[], next : number) : boolean {
    if (taken.length == 0) {
      return false
    }
    sweepSkills = skills
    sweepNext = next
    catching.value = true
    catchSet.value = taken
    catchByFoe.value = byFoe
    flyOn.value = false
    catchTimer = setTimeout(sweepFly, CATCH_SHOW_MS)
    return true
  }

  function sweepFly() {
    flyOn.value = true
    catchTimer = setTimeout(finishSweep, CATCH_FLY_MS)
  }

  function finishSweep() {
    catchTimer = -1
    const set = catchSet.value
    // 要移除牌，所以**六条并行数组一起重建** —— 漏一条就错位
    //（pile / pileByFoe / pileGuard / pileVals / pileSuit / pileBurn，见 pushPile）
    const keepCards : PlainCard[] = []
    const keepByFoe : boolean[] = []
    const keepGuard : number[] = []
    const keepVals : number[][] = []
    const keepSuit : string[] = []
    const keepBurn : number[] = []
    const gone = goneRanks.value.slice(0)
    let taken = 0
    let saved = 0
    for (let i = 0; i < pile.value.length; i++) {
      if (set.indexOf(i) >= 0) {
        // 叠放走 takeAt（四条收牌路共用）：
        //   带保护 → 取走垫着那张盾代替宿主，**宿主留下**；
        //   没保护 → 宿主 + 底下压着的全收（那几分归收走的人 ——
        //     那正是叠放「押注」的兑现处）。
        // **先问再取** —— takeAt 会把盾消耗掉
        const warded = blockedAt(i)
        taken = taken + takeAt(i, gone)
        if (!warded) {
          continue
        }
        saved = saved + 1
        keepCards.push(pile.value[i])
        keepByFoe.push(pileByFoe.value[i])
        keepGuard.push(pileGuard.value[i])
        // **rawVals 不是 pileValsAt** —— 见 rawVals 那段：重建会把在场效果写死
      keepVals.push(rawVals(i))
        keepSuit.push(pileSuitAt(i))
        // **火原样留着** —— 这一支是「别的技能收走它、保护让它留下」
        //（收色、撒网、见底都会走到），跟燃烧没关系。
        //
        // 【野火】走不到这儿：保护挡的是**点火那一刻**
        //（见 wildfireFor —— 带保护的牌点不上火，所以它永远不带火，
        // 也就永远不会出现在野火的收走名单里）
        keepBurn.push(pileBurnAt(i))
        continue
      }
      keepCards.push(pile.value[i])
      keepByFoe.push(pileByFoe.value[i])
      keepGuard.push(pileGuard.value[i])
      // **rawVals 不是 pileValsAt** —— 见 rawVals 那段：重建会把在场效果写死
      keepVals.push(rawVals(i))
      keepSuit.push(pileSuitAt(i))
      keepBurn.push(pileBurnAt(i))
    }
    pile.value = keepCards
    pileByFoe.value = keepByFoe
    pileGuard.value = keepGuard
    pileVals.value = keepVals
    pileSuit.value = keepSuit
    goneRanks.value = gone
    // 收走的那几张里可能有谁的效果牌
    expireHeld()
    expireStacked()
    const byFoe = catchByFoe.value
    if (byFoe) {
      foeScore.value = foeScore.value + taken
      flashFoe.value = true
    } else {
      myScore.value = myScore.value + taken
      flashMe.value = true
    }
    flashTimer = setTimeout(flashOff, SCORE_FLASH_MS)
    catching.value = false
    flyOn.value = false
    catchSet.value = [] as number[]
    const skills = sweepSkills
    sweepSkills = []
    if (sweepNext == TAIL_HEAD) {
      afterPlayHead(byFoe, skills)
    } else if (sweepNext == TAIL_BURN) {
      // 【燃尽】扫完 → **直接走匹配**，不回 afterPlayTail。
      // 回去的话尾段后半那几件（死水、摘钩、对换、压舱…）会重跑 ——
      // 它们没有 `from <=` 守卫（见 TAIL_BURN 那段）。
      //
      // 而匹配这时候基本是空走：燃尽扫走了整堆，刚打那张也在里面，
      // 所以 resolveMatch 里 pileIndexOf 找不着它、直接 endPlay
      resolveMatch(byFoe)
    } else {
      afterPlayTail(byFoe, skills, sweepNext)
    }
  }

  // ---------- 〔删了〕ebbTideFor（干塘）和 ebbFor（退潮） ----------
  //
  // **2026-10-16 清掉，约 150 行。** 两个函数都**没有调用点了**：
  //
  //   `ebbFor`      —— 【退潮】2026-10-14 删（压底族六件之一）
  //   `ebbTideFor`  —— 组合技【干塘】= 退潮 × 见底，**退潮一死它就跟着死**
  //                    （条件 `hasTrigger(SK_EBB) && hasTrigger(SK_LOWTIDE)`
  //                     恒为 false）
  //
  // 干塘躲了两周没人发现，因为**组合技没有 key、不在任何表里** ——
  // 详见 afterPlay 里那块墓碑，以及 `tools/md-sim/refs.js` 第 8 项
  //（那一项是专为这个坑加的）。
  //
  // ---- 两条判据留着，它们比代码值钱 ----
  //
  // **一、「减点数」那一族里谁先跑有意义。** 收牌的那件（见底）会把堆
  //   缩短一截，所以「堆顶 N 张」是哪几张取决于先跑谁。将来再加减点数的
  //   技能，让「收牌的」排在「只改形状的」前面。
  //
  // **二、范围写成「堆顶 N 张」比「它自己底下那几张」好**，退潮改过这一下，
  //   换来三样：不再依赖它自己在哪（沉底 / 被收走都不影响）、动的是最近
  //   落下的牌（下一手要撞的地方）、**效果随堆的厚度自动缩放**（不用另写限幅）。
  //   这条对任何「影响堆上一段」的新技能都适用。
  //
  // 〔`EBB_COUNT`（退潮退几张）同一天也从 `draw-skills.uts` 删了，
  //   跟 `DUMP_COUNT` / `SPILL_COUNT` 一批。那两条判据搬去了那边的墓碑〕


  // ---------- 〔删了〕floodFor（洪水） ----------
  //
  // **2026-10-16 清掉，约 85 行。** 技能 10-15 删的 —— 全表**唯一一件
  // 因为「太强而且削不下来」被删的**（X +4.73~5.25，限幅削的正是它的强度来源）。
  //
  // 效果是「从牌库一张张往堆上翻，直到翻出的那张跟堆上撞上点数；
  // 撞上那一下从撞中那张收到堆顶」。
  //
  // ---- 留下四条实现判据，每条都还有适用对象 ----
  //
  // **一、「从牌库硬塞到堆上」的牌不算打出。** 所以传空的 skills ——
  //   磁钩、钩顶、顺色一个都不生效，也不会误触对方的。
  //   可**场上挂着的抹点数照样管它**（它抹的是「落到堆上的牌」，
  //   不问这张是怎么上来的）。这两半要一起记，少一半就错一边。
  //   现在还有「硬塞牌」动作的只剩【囤饵】（开局塞牌库），
  //   再做这类动作照这条走。
  //
  // **二、判撞在落堆之前。** `catchStart` 遍历的是 `pile`，这张还没进去 ——
  //   所以不会跟自己比。任何「落堆 + 判定」合成一步的东西都得这个次序。
  //
  // **三、按格处理、留下的重建回去 —— 不能 `slice`。** 原先这儿是
  //   `slice(0, hitAt)`，前提是「hitAt 往上那一段一定全走」；叠放（保护）
  //   进来之后那个前提就不成立了，带保护的那张会留下。
  //   **凡是「收走一整段」的代码都要按格走 `takeAt` + `blockedAt`**，
  //   现在的载体是 `finishCatch` 里深钩那段和收色 / 撒网那两条。
  //
  // **四、「翻几张不定」的收牌不走飞牌特效。** 飞牌演的是「从第几张到堆顶」
  //   这种连续段，而边翻边判的长度当场才知道 —— 直接结算 + 播报。
  //   见底、收色、撒网现在都是这个路子。
  //
  // 〔还留下一条**设计**判据，写在 draw-skills 那块墓碑里：
  //   「不确定性是一种强度，而且是最难定价的那种」—— 定价只能按最坏情况
  //   走，而最坏情况随规则变〕

  // ---------- 收色 / 撒网：散着收一批，不走收牌特效 ----------
  //
  // 收走的牌不连续（散在堆里），而飞牌特效演的是「从第几张到堆顶」
  // 这种连续段 —— 所以这两件跟见底、洪水一样：直接结算 + 播报。
  //
  // 两件共用这一个：pick 回答「堆上第 i 张要不要收」。
  // 收走的算发动方的分（积分永远等于张数，铁律没破）
  // 收色 / 撒网要收的那几张的下标。拿掉、记分、积分跳都在收牌特效演完之后
  //（startSweep → finishSweep），跟见底一套
  function harvestIndices(wanted : boolean[]) : number[] {
    const out : number[] = []
    for (let i = 0; i < pile.value.length && i < wanted.length; i++) {
      if (wanted[i]) {
        out.push(i)
      }
    }
    return out
  }

  // 收色：堆上所有同花色的牌一起收走，连它自己。
  //
  // 比的是 pileSuitAt（**现在**算什么花色），不是牌面 ——
  // 染水能把整堆染成一个花色，那两件凑一起就是整堆通收。
  //
  // 跟顺色的区别：顺色收「最深那张 → 堆顶」一整段连续的牌，
  // 收色只收同花色那几张，中间的不动
  // 开演收牌特效了返回 true（afterPlayTail 停下，演完从撒网那一段接着走）
  function hueFor(byFoe : boolean, card : PlainCard, skills : number[]) : boolean {
    const wanted : boolean[] = []
    let hits = 0
    for (let i = 0; i < pile.value.length; i++) {
      const hit = sameSuit(pileSuitAt(i), card.suit, byFoe)
      if (hit) {
        hits = hits + 1
      }
      wanted.push(hit)
    }
    // ---- 只有它自己的时候**什么也不收** ----
    //
    // 这张牌落堆之后自己也是同花色的，所以不加这道闸，收色就永远
    // 至少收走它自己 = 稳赚 1 分、零风险 —— 那它「失去点数」那份代价
    // 就不存在了。
    //
    // 收不着的时候它留在堆上，而且**没有点数**（见 valuesOf）：
    // 钓不上任何人、也没人按点数钓得上它。那才是代价该有的样子
    if (hits <= 1) {
      message.value = message.value + (byFoe ? ' 庄家收色：' : ' 收色：')
        + '堆上没有别的 ' + card.suit + '，白打一张（它没有点数，就那么躺着）。'
      return false
    }
    const taken = harvestIndices(wanted)
    message.value = message.value + (byFoe ? ' 庄家收色：' : ' 收色：')
      + '堆上 ' + card.suit + ' 的牌收走 ' + taken.length + ' 张。'
    return startSweep(byFoe, taken, skills, TAIL_CAST)
  }

  // 撒网：从它自己起**往左连续**比奇偶，同奇偶就收，遇到不同的就停。
  //
  // ---- 它原先是「堆上所有同奇偶的一起收」（散收）----
  //
  // 改成连续段有三个理由：
  //
  //   **散收把牌堆打成筛子**，而「收一段连续的牌」是这个玩法的
  //     核心形状（基础钓牌、J 通吃、洪水都是收一段）。撒网从此和它们同构。
  //   **幅度回到档内**。散收是堆的一半（奇偶面太大了，那也是它当初
  //     卖 160 还不给升级的原因）；连续段的期望长度只有两张上下 ——
  //     但碰上一长串同奇偶就一路收完，于是它从「稳定收半堆」变成**条件爆发**。
  //   **它成了 0 点牌的出口**。0 算偶数，所以见底压出来的那一片 0 点牌
  //     是一个连续的偶数段 —— 打一张偶数撒网，一网收完。
  //     「见底铺设 → 撒网引爆」那条构筑路线就是这么接起来的。
  //
  // ---- 起点：它在堆上的位置 ----
  //
  // 撒网**不失去点数**（要靠自己的点数定奇偶），所以它可能先钓到一段 ——
  // 那时它已经跟那段一起被收走了，堆上找不到它。那种情况从**堆顶**起算：
  // 它钓完之后堆顶就是剩下的最上面那张，规则仍然是「从一头往左连续扫」。
  //
  // 沉底打出的牌落在下标 0，左边一张都没有 —— 那时只收它自己，
  // 也就是下面 hits <= 1 那条，白撒一网。两件插在同一张牌上是真冲突
  //（跟【退潮】一样），插槽时得避开。
  //
  // 自己的奇偶按**牌面点数**算（card.value），不看点数卡贴的那几个 ——
  // 一张牌只有一种奇偶，这事得一眼看得出来。
  // 堆上那些按**现在**的点数算：任一个点数同奇偶就算中（所以贴过点数卡的
  // 牌可能奇偶双属性，那是点数卡本来就有的后果），
  // 一个点数都没有的（顺色、洪水留下的）**直接断链** —— 它们不在点数
  // 这条轴上，既然比不出奇偶，连续段就到这儿为止
  // 开演收牌特效了返回 true（afterPlayTail 停下，演完从下一段接着走）
  function castFor(byFoe : boolean, card : PlainCard, skills : number[]) : boolean {
    const odd = card.value % 2 == 1
    const size = pile.value.length
    const wanted : boolean[] = []
    for (let i = 0; i < size; i++) {
      wanted.push(false)
    }
    const at = pileIndexOf(card)
    const from = at >= 0 ? at : size - 1
    let hits = 0
    for (let i = from; i >= 0; i--) {
      const vals = pileValsAt(i)
      let same = false
      for (let k = 0; k < vals.length; k++) {
        if ((vals[k] % 2 == 1) == odd) {
          same = true
          break
        }
      }
      if (!same) {
        break
      }
      wanted[i] = true
      hits = hits + 1
    }
    // 只有它自己就不收 —— 理由同收色（不然就是稳赚 1 分、零风险）。
    // 连续段这一改之后这条会**经常**触发（堆顶那张奇偶不对就断了），
    // 那是有意的：撒网从此要看堆的形状，不再是无脑收半堆
    if (hits <= 1) {
      message.value = message.value + (byFoe ? ' 庄家撒网：' : ' 撒网：')
        + '左边第一张就不是' + (odd ? '奇' : '偶') + '数，这一网只网住自己。'
      return false
    }
    const taken = harvestIndices(wanted)
    message.value = message.value + (byFoe ? ' 庄家撒网：' : ' 撒网：')
      + '往左连着收了 ' + taken.length + ' 张' + (odd ? '奇' : '偶') + '数。'
    return startSweep(byFoe, taken, skills, TAIL_FLOW)
  }

  // ---------- 【伏流】：它当通配，凑最长的顺子 ----------
  //
  // 第四条匹配线（点数 / 花色 / 累加不超 21 / **顺子**）。
  // 设计论证在 draw-skills 那条，这儿只记实现上的四个决定。
  //
  // ---- 一、它**只在这条路径上**当任意点数 ----
  //
  // 绝不能把「当任意点数」写进 cardVals / valuesOf。那两层是**双向**的
  //（你怎么钓别人、别人怎么钓你），而双向的话对手也能把它当通配接上 ——
  // 它就成了一张谁都接得上的超级靶子。那个坑是量过的：合流因为
  //「匹配是双向的」从预期的正分掉到 −1.00 / −0.83。
  //
  // 它在 valuesOf 里是**无点数**那一族（跟顺色、收色、洪水、野火一起），
  // 所以别人压根按点数钓不到它。无点数 + 单向，两条合起来才是完整设计
  //
  // ---- 二、枚举「区间」，而不是从它自己往外长 ----
  //
  // 顺子 = 一段连续的点数 [a, b]，其中**恰好一个点数由它填**（通配），
  // 其余每个点数都得有堆上的牌顶上。于是算法是：
  //   枚举 a、b（b − a + 1 ≥ STRAIGHT_MIN）
  //   → 数区间里有几个点数在堆上找不到牌
  //   → 正好缺 1 个就成立（那个缺口就是它当的点数）
  //
  // 从它自己往两边长那种写法**漏情形** —— 它填的可能是中间的缺口
  //（堆上 5、7，它当 6），不只是接在外侧
  //
  // ---- 三、点数范围要**读堆**，不能写死 1..13 ----
  //
  // 全局规则「点数往上**不设限**」是真的：抬水能把一张牌抬到 14、20。
  // 所以上界取堆上最大点数 + 1，下界取 0（见底能把牌压到 0，
  // 而 0 跟 1 算差 1，所以 `0-A-2` 是合法顺子）
  //
  // ---- 四、同一个点数有好几张时取**最深**那张 ----
  //
  // 顺子每个点数只要一张。取下标最小的 —— 跟 catchStart「从 i = 0 往上找」
  // 一个口径（这个玩法里深的那张总是更值钱）
  // ---- 五、用**数组**不用 Map ----
  //
  // 下标就是点数、值是堆上那一格（−1 = 堆上没有这个点数）。
  // 点数范围天然有界（0 到堆上最大那个），所以数组够用；
  // 而这个文件里一处 Map 都没有 —— 照着来，省一个 UTS 的不确定性
  //
  // skipAt 传它自己那一格（它是通配、不占点数格）；AI 预估时堆里还没有它，
  // 传 −1。无点数的牌（不在点数轴上）和护着的牌（钓不走）一概跳过。
  //
  // ---- skipAt **不是**冗余的，哪怕伏流本来就无点数 ----
  //
  // 看着像冗余：它在 valuesOf 里是无点数那一族，所以 pileValsAt 该是空的。
  // 可这儿读的是 **pileVals**（落堆那一刻 `landVals` 算出来的），而 landVals
  // 末尾有一支 `parityBlocked` → **return [0]**。
  //
  // 于是场上挂着【分水】、而伏流的奇偶跟它不同时，伏流落堆时是 `[0]`
  // 不是空的 —— 没有 skipAt 它就会**自己占掉 0 这一格**，然后
  // 「堆上缺哪个点数」算错一格。那种错很难看出来（只在有分水时发生）
  function deepestByVal(skipAt : number, byFoe : boolean) : number[] {
    // 先求堆上最大点数 —— 数组开多大得先知道
    let top = 0
    for (let i = 0; i < pile.value.length; i++) {
      // 带【通配】的牌**不进这张表** —— 它能当任意点数，钉在牌面那个
      // 点数上反而是错的。它在凑链时变成一个「任意填一格」的额度，
      // 而那个额度**要带着位置**（见 wildAts / pickWildStraight）
      if (i == skipAt || guardedAgainst(i, byFoe) || matchLocked(i, byFoe)
        || isWildAt(i)) {
        continue
      }
      const vals = pileValsAt(i)
      for (let k = 0; k < vals.length; k++) {
        if (vals[k] > top) {
          top = vals[k]
        }
      }
    }
    // 长度 top + 2：下标 0..top+1，**最后那格留给「它接在最大那张外侧」**
    const deepest : number[] = []
    for (let v = 0; v <= top + 1; v++) {
      deepest.push(-1)
    }
    for (let i = 0; i < pile.value.length; i++) {
      // 带【通配】的牌**不进这张表** —— 它能当任意点数，钉在牌面那个
      // 点数上反而是错的。它在凑链时变成一个「任意填一格」的额度，
      // 而那个额度**要带着位置**（见 wildAts / pickWildStraight）
      if (i == skipAt || guardedAgainst(i, byFoe) || matchLocked(i, byFoe)
        || isWildAt(i)) {
        continue
      }
      const vals = pileValsAt(i)
      for (let k = 0; k < vals.length; k++) {
        const v = vals[k]
        // 取**最深**那张（下标最小）—— 跟 catchStart「从 i = 0 往上找」
        // 一个口径。顺子每个点数只要一张，而深的那张更值钱
        if (v >= 0 && v < deepest.length && deepest[v] < 0) {
          deepest[v] = i
        }
      }
    }
    return deepest
  }

  // 在 deepest 上挑一条顺子。返回 [from, to]，from < 0 = 凑不出来。
  //
  // ---- 两条判据，顺序定死：**先数量，数量相同取最深** ----
  //
  // 「数量」是顺子的张数（区间长度）。「最深」是顺子里最深那张的位置
  //（下标最小）—— 而那在收整段的口径下正好等于「段更长」，
  // 所以两条判据同向，不会互相拉扯。
  //
  // 次判据**非有不可**：同样长的顺子常常有好几条（堆上 5 6 7 8 的时候，
  // 它当 4 或者当 9 都凑得出四张），而「先找到的赢」会默默地
  // 总是选点数小的那条 —— 那是个任意的选择，而且它系统性地偏向堆的一头
  // `bestStraight`（恰好缺一个、由打出那张当通配填）和 `bestGapped`
  //（步长 2、不含自己）两个函数**删了** —— 合成了下面那个 bestChainAt。
  //
  // 合并的理由不是去重：两件新效果各需要**两种填格手段的组合**
  //（伏流 = 堆上的通配 + 严格连续；涉水 = 自带通配 + 差 2），
  // 而那在两个各自写死判据的专用函数里表达不出来。

  // ---------- 【涉水】：顺子的**步长**放宽到 2 ----------
  //
  // 「相邻差 1 或 2」的等价表述是**区间里不能有两个连续的空位** ——
  // 差 2 = 跳过一个空位，差 3 = 跳过两个。所以它跟伏流**共用区间枚举**，
  // 只换判据（伏流：恰好缺一个、由通配填；涉水：不能连续缺两个）。
  //
  // 另外两处不同：
  //   它**不是通配**，所以它自己那一格要算在链里（deepest 不跳过它）；
  //   两端**必须有牌** —— 不然 `[a,b]` 两头悬空，区间就不是链。
  //
  // 判据照伏流那条：**先比数量，数量相同取最深**。
  // 「数量」这儿是**区间里有牌的点数个数**（不是区间长度 —— 区间里有空位）
  // 涉水挑顺子：相邻差 1 或 2 都算（= 区间里不能有两个连续的空位），至少 STRAIGHT_MIN 张。
  // **这张牌一定参与**（它当通配，是链上的一员）——
  // 〔原先这儿写「可以不参与：堆上任何地方凑出来都算」。那条 2026-10-12
  //   就撤了（见 wadeFor 里那段：唯一一个双收的口子），而这行注释漏改到
  //   2026-10-16。**注释自相矛盾比没注释更坏** —— 我照着它推过一轮设计〕
  // 先比张数，张数一样取最深那条
  // ---------- 堆上带【通配】的那几格（深的在前） ----------
  //
  // 顺序**必须**跟 markChain 那边一致 —— 两处按同一个顺序把通配分配给
  // 空位，所以「判出来用了哪几张」和「收走哪几张」才对得上。
  // 不一致的话会收错牌，而那种 bug 是静默的
  function wildAtsOf(skipAt : number, byFoe : boolean) : number[] {
    const out : number[] = []
    for (let i = 0; i < pile.value.length; i++) {
      if (i == skipAt || guardedAgainst(i, byFoe) || matchLocked(i, byFoe)) {
        continue
      }
      if (isWildAt(i)) {
        out.push(i)
      }
    }
    return out
  }

  // ---------- 挑一条顺子：三种东西能填空位 ----------
  //
  // 这一个函数替掉了原来的 bestStraight / bestGapped 两个 ——
  // 两件新效果各需要**两种填格手段的组合**，分成两个专用函数写不下：
  //
  //   伏流 = 堆上的通配（wildRoom 张）+ 严格连续（step 1），不自带通配
  //   涉水 = 自带通配（一次）+ 差 2 也算（step 2）
  //
  // 填空位的优先级是定死的：**先用堆上的通配，再用自带的那一次**。
  // 那个顺序要紧 —— 堆上的通配用掉会被收走（它是链上的牌），
  // 而自带的那个本来就要跟着走，所以先花掉"已经在场上"的那几张更划算。
  //
  // 判据照原来两个函数那条：**先比张数，张数相同取最深**。
  // 次判据非有不可 —— 同样长的顺子常有好几条，而「先找到的赢」
  // 会默默地总选点数小的那条（系统性偏向堆的一头）
  function bestChainAt(deepest : number[], wildRoom : number,
    selfWild : boolean, step : number) : number[] {
    let bestFrom = -1
    let bestTo = -1
    let bestCount = 0
    let bestLo = -1
    const top = deepest.length - 1
    for (let a = 0; a <= top; a++) {
      for (let b = a + STRAIGHT_MIN - 1; b <= top; b++) {
        // 同一张 A 不能在一条顺子里当两次（1 和 14 都在区间里，见 withHighAce）
        if (a <= 1 && b >= HIGH_ACE) {
          continue
        }
        let count = 0
        let lo = -1
        let gap = 0
        let room = wildRoom
        let selfLeft = selfWild ? 1 : 0
        let broken = false
        for (let v = a; v <= b; v++) {
          if (deepest[v] >= 0) {
            gap = 0
            count = count + 1
            if (lo < 0 || deepest[v] < lo) {
              lo = deepest[v]
            }
            continue
          }
          if (room > 0) {
            // 堆上的通配填这一格：**算链上的一张**，而且它的位置
            // 在 markChain 那边会被标上（它不在 deepest 里，所以要单独标）
            room = room - 1
            count = count + 1
            gap = 0
            continue
          }
          if (selfLeft > 0) {
            selfLeft = 0
            count = count + 1
            gap = 0
            continue
          }
          // 真空位。step=1 一个都不许；step=2 最多一个连着
          gap = gap + 1
          if (gap >= step) {
            broken = true
            break
          }
        }
        if (broken || count < STRAIGHT_MIN) {
          continue
        }
        if (count > bestCount || (count == bestCount && lo >= 0 && lo < bestLo)) {
          bestFrom = a
          bestTo = b
          bestCount = count
          bestLo = lo
        }
      }
    }
    return [bestFrom, bestTo]
  }

  // ---------- 把这条链上的牌标进 wanted ----------
  //
  // 它**重走一遍** bestChainAt 的分配逻辑（同一个优先级、同一个顺序），
  // 而不是让那个函数把结果传回来 —— UTS 里返回复合结构要先声明类型，
  // 而重走一遍只有十几行、还顺带保证了两处口径一致。
  //
  // ---- 带通配那几格**必须标上**，这一条在模拟器里踩过坑 ----
  //
  // 带通配的牌不进 deepest（它能当任意点数），所以**只按 deepest 标**
  // 会漏掉它们 —— 它们算进了链长、却收不走。
  // 那个缺陷量过：伏流 +4.02 掉到 +2.65，而且「贴得越多越差」
  //（+2.65 / +1.40 / +0.58），因为每贴一张就从表里拿掉一个真点数。
  //
  // > **「某张牌不按它的点数参与判定」和「它照样要被收走」是两件事。**
  function markChain(wanted : boolean[], deepest : number[],
    span : number[], wildAts : number[], selfWild : boolean) {
    let used = 0
    let selfLeft = selfWild ? 1 : 0
    for (let v = span[0]; v <= span[1]; v++) {
      if (deepest[v] >= 0) {
        wanted[deepest[v]] = true
        continue
      }
      if (used < wildAts.length) {
        wanted[wildAts[used]] = true
        used = used + 1
        continue
      }
      if (selfLeft > 0) {
        selfLeft = 0
      }
    }
  }


  // 【涉水】打出后堆上有顺子就收走**组成顺子的那几张**（每个点数取最深那张）。
  // 这张牌可以不参与：没参与就留在堆上，接着照常去匹配。夹在中间的牌不收
  function wadeFor(byFoe : boolean, skills : number[]) : boolean {
    const who = byFoe ? ' 庄家涉水：' : ' 涉水：'
    const at0 = lastPlayed == null ? -1 : pileIndexOf(lastPlayed!)
    if (at0 < 0) {
      return false
    }
    // skipAt = at0：**它自己当通配**，所以不占点数表那一格
    const deepest = withHighAce(deepestByVal(at0, byFoe))
    const wildAts = wildAtsOf(at0, byFoe)
    const span = bestChainAt(deepest, wildAts.length, true, 2)
    if (span[0] < 0) {
      message.value = message.value + who
        + '凑不出顺子（相邻差 1 或 2，至少 ' + STRAIGHT_MIN + ' 张）。'
      return false
    }
    const wanted : boolean[] = []
    for (let i = 0; i < pile.value.length; i++) {
      // 它自己**一定跟着走** —— 它当通配，是链上的一员。
      //（原先那条「这张可以不参与」撤了：那是全表唯一一个双收的口子，
      //  量过值 +1 分，而靠违反「收一片的代价是这张不钓」撑起来的分不留）
      wanted.push(i == at0)
    }
    markChain(wanted, deepest, span, wildAts, true)
    const taken = harvestIndices(wanted)
    message.value = message.value + who + '堆上凑成 ' + valueFace(span[0]) + '–'
      + valueFace(span[1]) + ' 的顺子，收走 ' + taken.length + ' 张。'
    return startSweep(byFoe, taken, skills, TAIL_WILD)
  }


  // ---------- 【漫流】：**【推牌】1 层；【顺子匹配】**〔2026-10-16〕 ----------
  //
  // 两个现成关键词的组合，一个新机制都不引入。
  //
  // ---- 顺序是这件技能的全部内容：**先推，再判** ----
  //
  // 推上来的牌**参与这一次判定**（那正是「先推再判」的意思）。
  // 实测「推上来的不算收成」那一档反而**更弱**（2.10 < 不推的 2.49）——
  // 留在堆上等于给对手多放两个钩点。所以它们凑成顺子时跟着被收走。
  //
  // ---- 走 `surgeFor` 而不是自己翻牌 ----
  //
  // 【推牌】那个词条自带「翻出来的牌跟堆上点数重复的，**变成 0 点**」，
  // 而那条**值 −1.18**（置 0 的牌是 0 点、不能参与顺子）。
  // 自己写一遍翻牌就会漏掉它 —— 而我第一轮量的就是漏掉它的那一档（4.18，废）。
  //
  // 它也顺带拿到「牌库不足 2 张就不推」那道闸（偶数 → 不翻牌库奇偶）。
  //
  // 实测 X **3.00** / D +0.035 / 凑成率 **69.2%**（不推是 52.1%）
  function brimFor(byFoe : boolean, skills : number[]) : boolean {
    const who = byFoe ? ' 庄家漫流：' : ' 漫流：'
    // 先推牌。`surgeFor` 自己播报推了几张、几张撞上点数置 0
    surgeFor(byFoe, BRIM_LAYERS)
    // 推完才取下标 —— 推牌走 pushPile（落堆顶），所以打出那张的下标没动，
    // 但取在推之前的话 deepest 表就看不见新落的那几格
    const at0 = lastPlayed == null ? -1 : pileIndexOf(lastPlayed!)
    if (at0 < 0) {
      return false
    }
    // skipAt = at0 + selfWild = true：**它自己当通配**（【顺子匹配】的
    // 关键词规则，这一族三件都有）。step = 1 —— 差 2 那一档是涉水的
    const deepest = withHighAce(deepestByVal(at0, byFoe))
    const wildAts = wildAtsOf(at0, byFoe)
    const span = bestChainAt(deepest, wildAts.length, true, 1)
    if (span[0] < 0) {
      message.value = message.value + who
        + '推完还是凑不出顺子（要连着 ' + STRAIGHT_MIN + ' 个点数）。'
      return false
    }
    const wanted : boolean[] = []
    for (let i = 0; i < pile.value.length; i++) {
      // 它自己一定跟着走（它是通配格，必然在链上）—— 照 wadeFor 那一行
      wanted.push(i == at0)
    }
    markChain(wanted, deepest, span, wildAts, true)
    const taken = harvestIndices(wanted)
    message.value = message.value + who + '凑成 '
      + valueFace(span[0]) + '–' + valueFace(span[1]) + ' 的顺子，收走 '
      + taken.length + ' 张。'
    // 演完从**野火那一段**接着走（漫流自己是 TAIL_BRIM，下一段是 TAIL_WILD）
    return startSweep(byFoe, taken, skills, TAIL_WILD)
  }

  // 【伏流】它当任意点数去凑顺子（它是那唯一的空位），凑成就收走**它自己 + 组成顺子的那几张**
  //（每个点数取最深那张）。夹在中间的牌不收。凑不成就按普通点数匹配
  // 伏流贴哪一格：**试一遍，挑凑出最长顺子的那个**。
  //
  // 按最优实现是有意的（照野火那条）：这件技能跟涉水的唯一分别就是
  //「标签贴哪 + 标签会攒」，按启发式实现量出来是「AI 挑得多好」、
  // 不是技能的上限。
  //
  // 暴力试 —— 堆常年 3 张，最多试 3 次，不值得优化。
  // **庄家和玩家用同一个函数**：玩家按最优挑、庄家乱点的话对局不公平，
  // 而那种不公平是静默的（界面上看不出来）
  // at0 = 打出那张在堆上的位置。**两个用处，少一个都是错的**〔2026-10-16〕：
  //
  //   跳过它自己那一格 —— 它已经自带通配（关键词规则），
  //     再贴一张标签上去是**白费一张**；
  //   判据要跟 straightFor 一致（`skipAt=at0` + `selfWild=true`）——
  //     不一致的话庄家是在**旧规则下挑格子**，挑出来的那一格在新判据下不是最优。
  //
  // 这一条是「同一件技能的两处口径必须同源」那类坑：挑格子和结算用的
  // 不是同一套判据时，错不会报出来，只表现为「这件技能的 AI 有点笨」
  function pickWildAt(byFoe : boolean, at0 : number) : number {
    let bestAt = -1
    let bestCount = -1
    for (let i = 0; i < pile.value.length; i++) {
      if (i == at0 || isWildAt(i)) {
        continue
      }
      const save = wildCards.value
      wildCards.value = save.concat([pile.value[i]])
      const deepest = withHighAce(deepestByVal(at0, byFoe))
      const span = bestChainAt(deepest, wildAtsOf(at0, byFoe).length, true, 1)
      wildCards.value = save
      // 「长度」用区间长度近似（真正的张数要重走一遍 markChain）——
      // 挑格子这一步够用，而且三个候选里排序不会因此变
      const len = span[0] < 0 ? 0 : span[1] - span[0] + 1
      if (len > bestCount) {
        bestCount = len
        bestAt = i
      }
    }
    return bestAt
  }

  function straightFor(byFoe : boolean, skills : number[]) : boolean {
    const who = byFoe ? ' 庄家伏流：' : ' 伏流：'
    const at0 = lastPlayed == null ? -1 : pileIndexOf(lastPlayed!)
    if (at0 < 0) {
      return false
    }
    // ---- 先贴标签，再判顺子。顺序是硬的 ----
    //
    // 标签改变点数表（带通配的牌不进表、变成填格额度），所以贴完才判。
    // 反过来的话这一手的标签白贴，只对**下一手**有用。
    //
    // 玩家侧要**暂停挑牌**，而暂停点跟凝水那三件不一样：
    // 那三件在落堆**之前**丢弃牌、挑完直接 afterPlay；
    // 伏流**已经落堆了**，挑完还得判顺子、走燃烧那一步、再匹配。
    // 所以它记下技能表，挑完从 TAIL_WADE（伏流之后那一段）接着走
    // `flowPicked` 是**重入闸**，不是可选的优化：
    // 挑完之后 onPilePick 会**重新调一次 straightFor**（贴完要当场判顺子），
    // 而这个分支只看 `!byFoe` 的话会**再暂停一次 → 死循环**。
    // `pilePick` 那时已经清了，所以不能靠它判
    if (!byFoe && !flowPicked && pile.value.length > 0) {
      pilePick.value = SK_FLOW
      pickStep.value = 0
      pickCard.value = lastPlayed
      pickSkills = skills
      return true
    }
    if (byFoe) {
      const at = pickWildAt(true, at0)
      if (at >= 0) {
        addWild(pile.value[at])
        message.value = message.value + who + '给第 ' + (at + 1) + ' 张贴上【通配】。'
      }
    }
    // ---- skipAt = at0：**它自己当通配** ----
    //
    // 〔2026-10-16 改回来的。原先是 −1（「它不当通配了，那一档归涉水」），
    //   而这一次改的**不是伏流，是【顺子匹配】这个关键词本身** ——
    //   自带通配进了规则，所以涉水和伏流都从关键词拿到它，
    //   涉水 desc 里那半句「它带【通配】」跟着删了（规则不在各件里重复写）。
    //
    //   实测（`vs flow flow -n 20000`）：**1.81 → 3.85**，凑成率 40.3% → 62.6%。
    //   而伏流现价 105 对应 X=3.81 —— **这个价本来就是按自带通配定的**，
    //   是 desc 和旋钮默认值在某一刻分叉了，不是它超价。详见实测数据台账〕
    const deepest = withHighAce(deepestByVal(at0, byFoe))
    const wildAts = wildAtsOf(at0, byFoe)
    const span = bestChainAt(deepest, wildAts.length, true, 1)
    if (span[0] < 0) {
      message.value = message.value + who
        + '凑不出顺子（要连着 ' + STRAIGHT_MIN + ' 个点数）。'
      return false
    }
    const wanted : boolean[] = []
    for (let i = 0; i < pile.value.length; i++) {
      // 它自己**一定跟着走** —— 它当通配，是链上的一员（照 wadeFor 那一行）。
      //
      // 〔2026-10-16 从 `push(false)` + 事后查 `if (!wanted[at0]) return false`
      //   改成这样。自带通配之后那个检查**恒真**（它就是那个通配格，
      //   必然在链上），所以留着是死代码。
      //
      //   而它原先防的那件事没变、只是换了防法：**不含它就双收**
      //  （顺子收别处那几张、它还在堆上、普通匹配照常走）——
      //   现在靠「它必然在链上」从根上堵掉，不靠事后检查。
      //   那是「收一片的代价是这张不钓」那三种写法里的第二种
      //  （收的那一段含自己），跟吃水同一种〕
      wanted.push(i == at0)
    }
    markChain(wanted, deepest, span, wildAts, true)
    const taken = harvestIndices(wanted)
    message.value = message.value + who + '凑成 '
      + valueFace(span[0]) + '–' + valueFace(span[1]) + ' 的顺子，收走 '
      + taken.length + ' 张。'
    return startSweep(byFoe, taken, skills, TAIL_WADE)
  }


  // ---------- 【野火】：给堆上所有牌点火，已经着了的收走 ----------
  //
  // 一个动作、两种后果，取决于目标的状态：**没火的点上，有火的烧穿**。
  // 所以它是全表第一件**跨回合**的收割 —— 这次标记、下次收。
  //
  // ---- 它自己没有点数，那是「收一片」的通用代价 ----
  //
  // valuesOf 里它在「返回空列表」那一族（跟顺色、收色一起）。
  // 不这么写就会**一张牌收两次**：野火先收掉上一轮标记的那几张，
  // 然后它自己还要去 resolveMatch 匹配一次 —— 那是禁止的。
  //
  // ---- 挡住「双收」有**三种**写法，全表的收牌类技能各占一种 ----
  //
  //   **自己没点数** —— 顺色 / 收色 / 撒网 / 野火（就是这一条）；
  //   **收的那一段含自己** —— 吃水（于是 resolveMatch 里 at0 < 0 直接 return）；
  //   **自己是 0 点而且被自己收走** —— 见底。
  //
  // 〔已删的洪水走第一种、量水走第二种 —— 两种写法都还有活着的住户〕
  //
  // **「收一片的代价是这张不钓」是条通用定价规则**，不是各自的特例。
  // 新做收牌类技能先挑这三种里的一种，别发明第四种。
  //
  // 顺带它第一次打出不再是纯空手：它落堆、被自己点上火、留在堆上
  //（没点数所以谁也钓不走它），下一次野火至少收得回它自己。
  //
  // ---- 三类牌跳过去，各有理由 ----
  //
  //   **【保护】（凝水）** —— 挡掉**点火那一刻**，所以带保护的牌压根
  //     不会着火，也就永远不会被野火收走。
  //     这是用户定的规则，而且它让凝水成了一道防火墙。
  //
  //     ⚠ 原文这儿写着「**代价是保护被消耗**」—— **那是错的**〔2026-10-16 查明〕。
  //     `lightAt` 那一行是 `if (pileBurnAt(index) > 0 || wardAt(index)) return false`
  //     —— **只是不点，不碰保护层**。消耗只发生在 `takeAt`（被收走时
  //     `pullStacked` 拉走一层）。
  //
  //     > 这个区别决定了凝水的全部价值：**挡点火不消耗 → 挡无限次**，
  //     > 而【燃尽】要求全堆带火 —— 所以**一张带保护的牌只要在堆上，
  //     > 对手就永远燃不尽**。那是一张凝水锁死整个燃烧族。
  //     > 量它要用不对称口径：`node sim.js vs calm chain -n 20000`。
  //   **护饵 / 硬壳护着的** —— 已经着了也不收。收走也算拿走，
  //     而那两样挡的就是「对方拿走这张」。但火**留着**（下一回合护失效了就收得走）。
  //   **没有点数的牌照样着火** —— 燃烧不碰点数属性。
  //     这顺带给顺色、封色留下的那些死牌开了一条出路：钓不走，但烧得掉。
  //
  // 收走的那几张走收牌特效（照收色、撒网），演完从 TAIL_REST 接着走
  function wildfireFor(byFoe : boolean, skills : number[]) : boolean {
    const who = byFoe ? ' 庄家野火：' : ' 野火：'
    // ---------- 定稿（2026-10-14）：**选择 1 张牌带上【燃烧】** ----------
    //
    // X = +3.85 / 价 105。连锁、无点数、收火那三样**全删了** ——
    // 【燃烧】拿到收割权之后（燃尽：全堆带火 → 整堆归出牌方），
    // 野火只需要点一张火。
    //
    // 点得着的那几格：没烧着、没保护、没冰。
    //
    // **这儿不消耗保护** —— 保护的代价是「垫着的牌代替宿主**被收走**」，
    // 而这一下挡的是点火，不是收牌。点不着就是点不着，盾不掉。
    //（老版野火会掀盾，因为那时它收牌。）
    const free : number[] = []
    for (let i = 0; i < pile.value.length; i++) {
      if (pileBurnAt(i) == 0 && !wardAt(i) && !frostAt(i)) {
        free.push(i)
      }
    }
    if (free.length == 0) {
      message.value = message.value + who + '场上没有点得着的牌。'
      return false
    }
    if (byFoe) {
      doWildPick(true, pickBurnAt(free))
      return false
    }
    // 等你点堆上一张。提示条和「不挑」按钮见 pilePickText。
    //
    // **暂停点在这儿是有讲究的**：野火跟凝水那三件不一样 ——
    // 那三件在落堆**之前**丢弃牌，挑完直接走 afterPlay；
    // 野火**已经落堆了**，挑完还得走燃烧那一步（蔓延 + 燃尽）和匹配。
    // 所以它得记下技能表，挑完从 TAIL_REST（野火之后那一段）接着走
    pilePick.value = SK_WILD
    pickStep.value = 0
    pickCard.value = lastPlayed
    pickSkills = skills
    return true
  }

  // 真正点那一下。两侧共用 —— 庄家不点屏幕，它走 pickBurnAt 选下标
  function doWildPick(byFoe : boolean, at : number) {
    if (at < 0 || at >= pile.value.length) {
      return
    }
    const next = pileBurn.value.slice(0)
    next[at] = 1
    pileBurn.value = next
    message.value = message.value + (byFoe ? ' 庄家野火：' : ' 野火：')
      + '给第 ' + (at + 1) + ' 张贴上【燃烧】。'
  }

  // 「选 1 张」挑哪一格：只剩一张点得着的就点它（**能一手燃尽就燃尽**），
  // 否则点**最长那段连续没烧着**的中间。
  //
  // ---- 为什么中间是最优 ----
  //
  // 火有两条前沿，而蔓延在**同一手之内**结算：点中间一次盖 3 格、
  // 点堆顶只盖 2 格。所以 3 张的堆上选中间**当场燃尽收 3 张**，
  // 而「自带燃烧」（只点自己落下那一格）烧不尽。
  // 实测那个差额是 **+1.54 分** —— 是这件技能的全部卖点。
  //
  // **庄家必须用同一个函数**：玩家按最优选、庄家乱点的话对局不公平，
  // 而那种不公平是静默的（界面上看不出来）
  function pickBurnAt(free : number[]) : number {
    if (free.length <= 1) {
      return free[0]
    }
    let bestFrom = 0
    let bestLen = 0
    let from = 0
    for (let k = 1; k <= free.length; k++) {
      if (k == free.length || free[k] != free[k - 1] + 1) {
        if (k - from > bestLen) {
          bestLen = k - from
          bestFrom = from
        }
        from = k
      }
    }
    return free[bestFrom + ((bestLen - 1) >> 1)]
  }

  // 旧效果（烧整堆 + 收走带火的）那一整段**删了** —— 收割权归关键词之后
  // 它就是「一张牌收两次」：野火收走带火的，然后 burnStep 的燃尽
  // 又把整堆收一次。
  //
  // 跟着没了的还有**保护被掀盾**那一支：它的代价是「垫着的牌代替宿主
  // **被收走**」，而现在野火只点火、不收牌，所以保护只是**挡掉点火**、
  // 盾留着。那让凝水从「被野火吃掉一层」变成「**一张牌锁死整条线**」
  //（堆上有一张带保护的就永远烧不尽）。
  // ---------- 压舱 / 摘钩 / 对换：动对方一张手牌 ----------
  //
  // 三件的交互一模一样（点对方手牌那一排），区别只在挑完之后干什么。
  // 所以共用 takeSkill 这一个状态，这儿按技能分三路。
  //
  // 对换要挑两次（先拿他的，再给自己的），第二步落在 doGiveBack
  function doTakeFrom(byFoe : boolean, skill : number, index : number) {
    const theirs = byFoe ? hand.value : foeHand.value
    if (index < 0 || index >= theirs.length) {
      return
    }
    const victimIsFoe = !byFoe
    const name = cardName(theirs[index])
    if (skill == SK_PRESS) {
      const card = takeFromHand(victimIsFoe, index)
      shuffleBack(card)
      message.value = message.value + (byFoe
        ? ' 庄家压舱：你的一张手牌被塞回牌库洗掉了。'
        : ' 压舱：庄家的 ' + name + ' 塞回牌库洗掉了。')
      return
    }
    if (skill == SK_UNHOOK) {
      const card = takeFromHand(victimIsFoe, index)
      // 摘钩拿过来的牌进自己手里。**手牌可能因此超过上限** ——
      // 那没关系，回合末 refill 只负责「补到」上限，不负责弃牌
      if (byFoe) {
        foeHand.value = foeHand.value.concat([card])
        foeShown.value = foeShown.value.concat([false])
      } else {
        hand.value = hand.value.concat([card])
        // 这张是从庄家手里拿的，它当然知道自己有过什么 —— 标成「它看得见」
        handSeen.value = handSeen.value.concat([true])
      }
      message.value = message.value + (byFoe
        ? ' 庄家摘钩：你的一张手牌被它拿走了。'
        : ' 摘钩：庄家的 ' + name + ' 到你手上了。')
      return
    }
    // 对换：先把他那张拿过来，再挑一张自己的还给他。
    // 你那边要停下来挑，庄家自己挑（见 foeGivePick）
    const card = takeFromHand(victimIsFoe, index)
    if (byFoe) {
      foeHand.value = foeHand.value.concat([card])
      foeShown.value = foeShown.value.concat([false])
    } else {
      hand.value = hand.value.concat([card])
      handSeen.value = handSeen.value.concat([true])
    }
    message.value = message.value + (byFoe
      ? ' 庄家对换：拿走你一张，正在还一张回来。'
      : ' 对换：' + name + ' 到你手上了，挑一张还给庄家。')
    if (byFoe) {
      doGiveBack(true, foeGivePick())
      return
    }
    // 记个账：现在等你挑自己的那张
    giveBack.value = 1
  }

  // 对换第二步：把自己第 index 张还给对方
  function doGiveBack(byFoe : boolean, index : number) {
    const mine = byFoe ? foeHand.value : hand.value
    if (index < 0 || index >= mine.length) {
      return
    }
    const card = takeFromHand(byFoe, index)
    if (byFoe) {
      hand.value = hand.value.concat([card])
      // 庄家还过来的牌，它自己当然知道是什么
      handSeen.value = handSeen.value.concat([true])
    } else {
      foeHand.value = foeHand.value.concat([card])
      foeShown.value = foeShown.value.concat([true])
    }
    message.value = message.value + (byFoe
      ? ' 它还给你一张。'
      : ' 你把 ' + cardName(card) + ' 还给了庄家。')
  }

  // 庄家对换时还哪张：扔最没用的那张，尺子照【换水】（见 foeSwapPick）
  function foeGivePick() : number {
    return foeSwapPick()
  }

  // 庄家从你手里挑哪张（压舱、摘钩、对换都用它）。
  //
  // 这三件技能本身就「看对方全部手牌」，所以它**看得见你所有的牌** ——
  // 不像冻结那样要猜位置。挑的尺子：
  //   J 最金贵（通吃）；
  //   其次是现在就钓得着堆上某张的（拿走它等于拆掉你这一手）；
  //   都不是就挑点数最大的（大牌当饵安全，留给你最吃亏）
  // ---------- 【死水】：废对方几张手牌 ----------
  //
  // 挑得动的那几张的下标。两条排除：
  //
  //   **J 不能挑** —— J 的通吃认 rank、不看点数，所以废牌还得显式禁通吃；
  //     而一旦能禁，看得见手牌的一方就会专挑 J（它占全部钓牌的 22%，
  //     一次通吃收整堆，废一张约值 5 分）—— 单这一下就超标。
  //     理由全文在 draw-skills 死水那条。
  //   **已经废过的不再挑** —— 不然「挑两张」可能两张都点在同一张上，
  //     而庄家那条（foeDeadPick）更会这样：它每次都挑最值钱的那张
  function deadPool(byFoe : boolean) : number[] {
    const theirs = byFoe ? hand.value : foeHand.value
    const out : number[] = []
    for (let i = 0; i < theirs.length; i++) {
      if (theirs[i].rank == JACK || isDead(theirs[i])) {
        continue
      }
      out.push(i)
    }
    return out
  }

  // 废掉对方第 index 张手牌。byFoe = 发动方
  function doDead(byFoe : boolean, index : number) {
    const theirs = byFoe ? hand.value : foeHand.value
    if (index < 0 || index >= theirs.length) {
      return
    }
    const card = theirs[index]
    // J 和已经废过的都挡在这儿 —— 界面那边也拦了（card-pickable），
    // 可庄家走的是 foeDeadPick，两条路都得过这道闸
    if (card.rank == JACK || isDead(card)) {
      return
    }
    // **换引用而不是 push** —— deadCards 是 ref，照 addHeld 那条理由
    deadCards.value = deadCards.value.concat([card])
    message.value = message.value + (byFoe
      ? ' 庄家死水：你的 ' + cardName(card) + ' 废了（0 点、不触发技能）。'
      : ' 死水：庄家的 ' + cardName(card) + ' 废了（0 点、不触发技能）。')
  }

  // 庄家挑哪几张废。尺子跟 foeTakePick 同一套（**J 除外** —— 它挑不了 J）：
  // 现在就钓得着的最金贵，其次点数大的。
  //
  // 「钓得着」用**你的**装备判（canCatch(card, false)）—— 它废的是你的牌，
  // 所以要按你的本事算那张值多少
  function foeDeadPick() : number {
    const pool = deadPool(true)
    let best = -1
    let bestScore = -1
    for (let i = 0; i < pool.length; i++) {
      const at = pool[i]
      const card = hand.value[at]
      let score = card.value
      if (canCatch(card, false)) {
        score = score + 50
      }
      // 落在你槽上的牌多加一档 —— 废掉它顺带掐了一件技能，
      // 那正是「技能不触发」那半的价值所在（见 draw-skills 死水那条的账）
      if (skillsOf(false, card).length > 0) {
        score = score + 30
      }
      if (score > bestScore) {
        bestScore = score
        best = at
      }
    }
    return best
  }

  // ---------- 【引潮】挑得动的那几张（byFoe = 发动方，挑对面） ----------
  //
  // **只排掉 J**，比 deadPool 少一条：
  //
  //   J 不能挑 —— 它不触发任何技能（见 triggersOf 开头那道闸），
  //     贴了标签也不会兑现，等于白挑一张。
  //   **已经带了标签的照旧能挑** —— 那正是叠加的用法（不设上限），
  //     而这是它跟 deadPool（排掉已废的）、addFrostHand（不可叠加）
  //     的分野。别照那两个的样子加排除条件
  function surgePool(byFoe : boolean) : number[] {
    const theirs = byFoe ? hand.value : foeHand.value
    const out : number[] = []
    for (let i = 0; i < theirs.length; i++) {
      if (theirs[i].rank == JACK) {
        continue
      }
      out.push(i)
    }
    return out
  }

  // 给对方第 index 张手牌贴 SURGE_LAYERS 层【推牌】。byFoe = 发动方
  function doSurge(byFoe : boolean, index : number) {
    const theirs = byFoe ? hand.value : foeHand.value
    if (index < 0 || index >= theirs.length) {
      return
    }
    const card = theirs[index]
    // J 挡在这儿 —— 界面那边也拦了（card-pickable），可庄家走的是
    // foeSurgePick，两条路都得过这道闸（照 doDead 那条先例）
    if (card.rank == JACK) {
      return
    }
    for (let n = 0; n < SURGE_LAYERS; n++) {
      addSurgeHand(card)
    }
    const now = surgeLayers(card)
    message.value = message.value + (byFoe ? ' 庄家引潮：' : ' 引潮：')
      + cardName(card) + ' 贴上 ' + SURGE_LAYERS + ' 层推牌'
      // 叠上去了就把总层数报出来 —— 不报的话玩家不知道这张现在会推几张
      //（角标上有，但播报里也要有：那一行是他回看发生了什么的地方）
      + (now > SURGE_LAYERS ? '，现在一共 ' + now + ' 层' : '')
      + '（打出后涌 ' + (now * SURGE_PUSH) + ' 张）。'
  }

  // 庄家给你哪张贴标签：**他马上会打的那张**。
  //
  // 这把尺子跟 foeDeadPick **故意不一样** —— 死水要废掉「最值钱的」，
  // 而引潮要的是「**最快兑现的**」：贴在一张他留着当底牌的牌上，
  // 这一局可能根本等不到它打出来。
  //
  // 所以钓得着的最优先（他这一手就会打它），其次点数大的
  //（小点数常被留着当饵）。照模拟器 `ai.js` 的 surgePick
  function foeSurgePick() : number {
    const pool = surgePool(true)
    let best = -1
    let bestScore = -1
    for (let i = 0; i < pool.length; i++) {
      const at = pool[i]
      const card = hand.value[at]
      let score = card.value
      // 用**你的**装备判「这张在你手里钓不钓得着」—— 它贴的是你的牌，
      // 而「你会不会马上打它」要按你的本事算（照 foeDeadPick 那条）
      if (canCatch(card, false)) {
        score = score + 50
      }
      if (score > bestScore) {
        bestScore = score
        best = at
      }
    }
    return best
  }

  function foeTakePick() : number {
    let best = -1
    let bestScore = -1
    for (let i = 0; i < hand.value.length; i++) {
      const card = hand.value[i]
      let score = card.rank == JACK ? 100 : card.value
      // 用你的装备判「这张在你手里钓不钓得着」—— 它拆的是你的牌
      if (card.rank != JACK && canCatch(card, false)) {
        score = score + 50
      }
      if (score > bestScore) {
        bestScore = score
        best = i
      }
    }
    return best
  }

  // ---------- 同号 / 同花：从共用牌库里捞一张 ----------
  //
  // 这两件治的是这个玩法最大的运气来源：手里四张跟堆上一个都对不上。
  //
  // 牌库是**双方共用**的（摸打不像钓鱼、排竿那样各有一副），
  // 所以从里头捞走一张，同时也是「对手摸不到它了」

  // 同号：牌库里跟它同点数的那几张（最多 3 张）。摊开让人挑
  function twinPool(card : PlainCard) : PlainCard[] {
    const out : PlainCard[] = []
    for (let i = deck.value.length - 1; i >= 0; i--) {
      if (deck.value[i].rank == card.rank) {
        out.push(deck.value[i])
      }
    }
    return out
  }

  // 把这张牌从牌库里抽出来，放进 byFoe 那一方的手上
  function pullFromDeck(byFoe : boolean, card : PlainCard) : boolean {
    // 手写循环找位置，**不用 indexOf** —— 这一路比的是对象身份，
    // 而 UTS 在各平台上 indexOf 怎么比对象并不一致（inPile 也是手写的，
    // 同一个理由）。牌库最多五十来张，一趟循环的代价可以忽略
    let at = -1
    for (let i = 0; i < deck.value.length; i++) {
      if (deck.value[i] == card) {
        at = i
        break
      }
    }
    if (at < 0) {
      return false
    }
    const rest : PlainCard[] = []
    for (let i = 0; i < deck.value.length; i++) {
      if (i != at) {
        rest.push(deck.value[i])
      }
    }
    // ---- 搜过牌库就**洗一遍**（【获取下一张】词条写明的）----
    //
    // 洗这一下是**有意的限制**，不是整洁癖：不洗的话「从顶往下第一张」
    // 是确定的，于是观潮 / 择饵 / 活水 一看牌库顶就能把整条连锁**排好**
    //（野火一局要取好几张）—— 那不是给信息类技能开兑现口子，
    // 那是把随机性整段删掉。洗了之后它退回「一张随机的符合牌」。
    //
    // 副作用要记住：**它会毁掉你自己攒的情报**。刚用观潮看完牌库顶
    // 再打一张野火，那两张就白看了 —— 于是「信息类 + 检索类」变成
    // 一个要排顺序的组合，而不是无脑叠加。
    //
    // 这个函数**同号也走**，所以同号也跟着洗了。那是对的方向：
    // 检索类三件口径一致了（同花本来就洗回牌库），而「搜过牌库就洗」
    // 是通行规矩 —— 原先同号是悄悄抽走、顺序不动
    // 内联 Fisher-Yates —— 照同花那儿的写法（这一页没有共用的洗牌函数）
    for (let i = rest.length - 1; i > 0; i--) {
      const k = Math.floor(Math.random() * (i + 1))
      const tmp = rest[i]
      rest[i] = rest[k]
      rest[k] = tmp
    }
    deck.value = rest
    if (byFoe) {
      foeHand.value = foeHand.value.concat([card])
      foeShown.value = foeShown.value.concat([false])
    } else {
      hand.value = hand.value.concat([card])
      handSeen.value = handSeen.value.concat([false])
    }
    return true
  }

  // ---------- 【野火】连锁的燃料池：**能再触发野火的牌** ----------
  //
  // 不是「同点数」—— 那只是真条件的一个特例（见 wildfireFor 那段）。
  // 直接问 triggersOf，池子就自动跟着槽走，不用去拼槽上的标签。
  //
  // 两条闸是白送的，因为 skillsOf 本来就带：
  //   **J 不进池** —— 它对 J 直接返回空（J 只有通吃）；
  //   **死水废掉的不进池** —— 它那一路先判废牌。
  // 两条都对：那种牌打出去不触发野火，取回来就断链。
  //
  // 牌库从后往前扫（末尾是牌库顶），所以 out[0] 是最靠顶的那张 ——
  // 跟同花那条「翻牌库顶拿第一张」一个口径。
  // 取完还要洗（见 pullFromDeck），所以「第一张」只在取的那一瞬成立
  function fuelPool(byFoe : boolean) : PlainCard[] {
    const out : PlainCard[] = []
    for (let i = deck.value.length - 1; i >= 0; i--) {
      if (hasTrigger(skillsOf(byFoe, deck.value[i]), SK_WILD)) {
        out.push(deck.value[i])
      }
    }
    return out
  }

  function doTwin(byFoe : boolean, card : PlainCard) {
    const got = pullFromDeck(byFoe, card)
    if (!got) {
      return
    }
    message.value = message.value + (byFoe
      ? ' 庄家同号：从牌库捞了一张同点数的。'
      : ' 同号：' + cardName(card) + ' 到你手上了。')
  }

  // 庄家同号挑哪张：挑**能触发它自己技能**的那个花色，
  // 没有就随便第一张 —— 它挑的理由跟你一样，不然同一套配装它比你蠢
  function foeTwinPick(pool : PlainCard[]) : number {
    for (let i = 0; i < pool.length; i++) {
      if (skillsOf(true, pool[i]).length > 0) {
        return i
      }
    }
    return 0
  }

  // ---------- 〔删了〕suitFindFor（同花） ----------
  //
  // **2026-10-16 清掉，约 48 行。** 技能 10-14 删的（X −0.32）。
  //
  // ---- 它留下两条判据，都还在管事 ----
  //
  // **一、从牌库搜完要「洗回去」，不能「沉底」。** 沉底的话玩家数得出
  //   那几张什么时候回来 —— 而这件技能卖的是「拿到一张同花色的」，
  //   **不该附赠一份牌库情报**。那条现在由词表的【获取下一张】撑着
  //  （它的定义里就写着「拿到后把牌库洗一遍」），而【换水】塞回牌库
  //   要真洗也是同一条理由。
  //
  // **二、「随你挑」和「翻到第一张」是两个强度档，池子大小决定用哪个。**
  //   同号的池子只有 3 张（同点数的另外三张）所以随你挑；
  //   同花的池子有 12 张，随你挑就太强了，所以只能翻到第一张。
  //   做「从牌库检索」类技能时先数池子。

  // 换水：你挑中了第 index 张（-1 表示不换）。
  //
  // 挑的动作借手牌那一排（见 onPlay 开头那道岔），所以这儿只管收尾
  function onSwap(index : number) {
    if (!swapPending.value) {
      return
    }
    swapPending.value = false
    if (index >= 0 && index < hand.value.length) {
      const card = takeFromHand(false, index)
      shuffleBack(card)
      message.value = '你把 ' + cardName(card) + ' 塞回牌库重洗了，回合末会补新的。'
    } else {
      message.value = '你没换牌。'
    }
    resolveMatch(false)
  }

  // 把一张牌塞回牌库并**真洗进去**。
  //
  // 不是插在底下 —— 插底的话你数得出它什么时候回来，那就不叫「换掉」了。
  // 整副重洗而不是只洗一部分：洗一半的话剩下那半的顺序还是知道的，
  // 而观潮刚看过的那两张正好在那一半里
  function shuffleBack(card : PlainCard) {
    const next = deck.value.concat([card])
    for (let i = next.length - 1; i > 0; i--) {
      const k = Math.floor(Math.random() * (i + 1))
      const one = next[i]
      next[i] = next[k]
      next[k] = one
    }
    deck.value = next
  }

  // 庄家换水挑哪张：**先扔钓不着任何东西的，同类里扔点数最小的**。
  //
  // 「钓得着」跟它选牌出牌时用的是同一把尺子（canCatch），所以它不会
  // 把手里唯一能钓的那张扔掉。全都钓得着就扔点数最小的 ——
  // 小牌将来被别人钓走的面更宽
  function foeSwapPick() : number {
    let best = -1
    let bestScore = 0
    for (let i = 0; i < foeHand.value.length; i++) {
      const card = foeHand.value[i]
      // 钓得着的记 100 分（留着），钓不着的记 0 —— 分低的先扔。
      // 贴过点数卡的多记 20：它多一条出路，是副牌里的好东西，
      // 洗回牌库就不知道什么时候再摸到了
      const useful = card.rank == JACK || canCatch(card, true)
      const score = (useful ? 100 : 0) + card.extra.length * 20 + card.value
      if (best < 0 || score < bestScore) {
        best = i
        bestScore = score
      }
    }
    return best
  }

  // 窥视：翻开对方一张还没被看过的手牌
  function peekFor(byFoe : boolean) {
    const flags = byFoe ? handSeen.value.slice(0) : foeShown.value.slice(0)
    const hidden : number[] = []
    for (let i = 0; i < flags.length; i++) {
      if (!flags[i]) {
        hidden.push(i)
      }
    }
    if (hidden.length == 0) {
      return
    }
    const pick = hidden[Math.floor(Math.random() * hidden.length)]
    flags[pick] = true
    if (byFoe) {
      handSeen.value = flags
      message.value = message.value + ' 庄家窥视了你一张牌。'
    } else {
      foeShown.value = flags
      message.value = message.value + ' 窥视：翻开了庄家一张牌。'
    }
  }

  // ---------- 〔删了〕dumpFor（掏手）和 spillFor（掏库） ----------
  //
  // **2026-10-16 清掉，约 65 行。** 两件技能 2026-10-14 就删了
  //（压底族六件之一，X **−1.13 / −1.72**，掏库是当时全表最弱的），
  // 而实现一直留着 —— `hasTrigger(skills, -1)` 永不匹配，所以是死代码。
  //
  // 连带撤掉 `DUMP_COUNT` / `SPILL_COUNT` 两个 import，常量本身也从
  // `draw-skills.uts` 删了（**顺序是硬的：先删函数、再撤 import** ——
  // 反过来会直接编译不过，这一轮差点就那么干了）。
  //
  // ---- 它们留下三条判据，都还在管事 ----
  //
  // **一、往堆上倒垃圾要用「置 0」，不能用「无点数」。**
  //   0 点**还在点数这条轴上**，所以【见底】收得走它（收「点数为 0 的牌」）、
  //   【撒网】按奇偶收得走（0 算偶数）。无点数那几条全跳过它 ——
  //   **全抹成无点数的话堆只会单向变厚、再没人清得动。**
  //   留一条扫得走的路，「压底」这一族才不是单纯的死锁。
  //
  // **二、硬塞到堆上的牌不算打出** —— 所以它身上的技能一个都不触发
  //（`landVals` 传空技能表），可**场上挂着的抹点数照样管它**。
  //   这条是【搅水】（更早删的）留下的，掏手和洪水都照它走过。
  //   下次再做「把牌弄到堆上」的效果，照这条。
  //
  // **三、看不见的牌只能随机掏。** 对方手牌你本来就看不见（除非窥视 /
  //   照水翻过），所以指定不了 —— 跟【冻结】那条「你挑的是位置不是牌面」
  //   同一个道理。而掏手连位置都不让挑，它是一记闷棍。
  //
  // 〔掏库还留下一条**已经过期**的推理，记一下免得被捡回来：
  //   它「烧牌库」所以会改奇偶，而那在剩堆归属那一版里是双刃
  //  （领先时催命、落后时自杀）。**现在那条不成立了** ——
  //   终局换成「牌库空 + 各打 1 手」之后，烧牌库是在**缩短这一局**，
  //   而那正是洪水被删的理由（偷时间）。同一个动作，三版规则三种性质。〕

  function clearTimers() {
    if (foeTimer >= 0) {
      clearTimeout(foeTimer)
      foeTimer = -1
    }
    if (catchTimer >= 0) {
      clearTimeout(catchTimer)
      catchTimer = -1
    }
    if (flashTimer >= 0) {
      clearTimeout(flashTimer)
      flashTimer = -1
    }
    if (shopTimer >= 0) {
      clearTimeout(shopTimer)
      shopTimer = -1
    }
    if (heartTimer >= 0) {
      clearTimeout(heartTimer)
      heartTimer = -1
    }
    // 切牌动画那两段。**清掉之后要把 phase 归零**（别的计时器不用，
    // 因为它们不锁交互）—— 停在 phase 1/2 上的话 canPlay 会一直是 false，
    // 整局点不动牌
    if (cutTimer >= 0) {
      clearTimeout(cutTimer)
      cutTimer = -1
      cutPhase.value = 0
      cutFly.value = null
    }
  }

  // 把这一方的手牌补足到 handLimit。牌库空了就补多少算多少
  function refill(byFoe : boolean) {
    // ---- 「什么时候补」有两条规则会拦它 ----
    //
    // 【涨落】（角色，自己带）和【枯水】（庄家规矩，削玩家）是同一条机制
    // 的两头：**只有一张牌都打不出的时候才补**。
    //
    // 「一张牌都打不出」在这个玩法里约等于「手牌打空了」——
    // 摸打里任何牌都打得出去，唯一打不出的是被冻住的牌。
    // 所以这一条把手牌从「恒 4 张」变成周期性枯竭（见 draw-skills 涨落那条）。
    //
    // 用 playableCount 而不是 length：手牌剩 1 张但那张被冻住，
    // 那也是「一张牌都打不出」—— 该补。那条正好跟 checkOver 同一个口径
    const held = hasSpecial(byFoe, SP_CYCLE) || (!byFoe && hasFoeSpecial('dryup'))
    if (held && playableCount(byFoe) > 0) {
      return
    }
    const before = byFoe ? foeHand.value.length : hand.value.length
    let now = before
    const want = handLimit(byFoe)
    // ---------- 【挑潮】：庄家补牌时从库顶两张挑一张 ----------
    //
    // 它是玩家【观潮】的庄家版，可**落点不一样**：观潮是「打出覆盖面里的
    // 牌时触发一次」，挑潮是「每次补牌都挑」—— 所以它藏在 refill 里，
    // 而不是在技能触发那条路上。
    //
    // 另一张沉到库底，不是丢掉：牌是双方共用的那一副（见 baitFor 那段），
    // 丢掉会让「外面还剩几张」那块面板和庄家自己的记牌一起算错。
    //
    // 排在 while 之前、而且**只挑一次**：它挑的是「这一回合补的第一张」。
    // 每张都挑的话，手牌被削狠了的那个回合（补三张）它就能从六张里
    // 挑三张，那比写在表上的效果强太多
    if (byFoe && now < want && hasFoeSpecial('pick') && deck.value.length >= FOE_PICK_TOPS) {
      pickTopFor()
      now = now + 1
    }
    while (now < want) {
      if (drawFor(byFoe) == null) {
        break
      }
      now = now + 1
    }
    // 你新补上来的那几张描个绿边，指向头一张新牌。
    // 下一回合开始时它还在，所以你是**看着**它做决定的 ——
    // 这正是改成回合末补牌换来的东西
    if (!byFoe && now > before) {
      newIndex.value = before
    }
  }

  // 【挑潮】真正挑那一下：库顶 FOE_PICK_TOPS 张里挑一张进手，
  // 剩下的沉到**库底**。
  //
  // 挑的标准是「这张现在打出去能钓几张」—— 跟 foePickCard 判断手牌
  // 同一个口径（catchStart 问「能不能钓」，返回 -1 就是不能）。
  // 不另写一套估值：两处要是口径不同，庄家就会挑一张它自己
  // 下一回合不会打的牌。
  //
  // 算的是「**现在**的堆」，而这张是下一回合才打的 —— 那是故意的近似。
  // 要算准就得预演你那一回合，而庄家不该知道你手里有什么
  function pickTopFor() {
    // **库顶是数组末尾**（见 drawFor 的 pop）—— 所以「库顶 N 张」
    // 是末尾 N 个，而「沉到库底」是挪到下标 0 那一头。
    // 这两头搞反过一次，表现是庄家一直在从库底挑牌
    const size = deck.value.length
    const n = FOE_PICK_TOPS < size ? FOE_PICK_TOPS : size
    let bestAt = size - 1
    let bestScore = -1
    for (let i = 0; i < n; i++) {
      const at = size - 1 - i
      const card = deck.value[at]
      const skills = skillsOf(true, card)
      const sink = hasTrigger(skills, SK_SINK) || hasFoeSpecial('drift')
      const start = catchStart(card, true, skills, sink)
      let score = 0
      if (start >= 0) {
        score = sink ? start + 2 : pile.value.length - start + 1
      }
      // J 没钓到也值钱（下一回合堆厚了就通吃），所以给它一个底分。
      // 不给的话「空堆上的 J」和「一张废牌」同分，庄家会把 J 让出去
      if (card.rank == JACK && score == 0) {
        score = 1
      }
      if (score > bestScore) {
        bestScore = score
        bestAt = at
      }
    }
    // 重排牌库：挑中那张进手，**另外那几张挪到库底**（下标 0 那一头），
    // 剩下的原样留着。
    //
    // 「没挑的沉底」而不是丢掉，是为了让「外面还剩几张」那块面板
    // 和庄家自己的记牌（outsideCount）都还算得对 ——
    // 这一副牌是双方共用的，凭空少几张两边的账就都不对了
    const taken = deck.value[bestAt]
    const sunk : PlainCard[] = []
    const keep : PlainCard[] = []
    for (let i = 0; i < size; i++) {
      if (i == bestAt) {
        continue
      }
      if (i >= size - n) {
        sunk.push(deck.value[i])
      } else {
        keep.push(deck.value[i])
      }
    }
    deck.value = sunk.concat(keep)
    foeHand.value = foeHand.value.concat([taken])
    foeShown.value = foeShown.value.concat([false])
  }

  // 这一方这回合补到几张。
  //
  // 底数 HAND_SIZE，被挂在牌上的两件技能一上一下地改：
  //   **满篓**（自己打的）—— 自己 +1；
  //   **窄口**（对方打的）—— 自己 −1。
  //
  // 两件都在场就互相抵掉，正好是底数 —— 那是对的，一个补一个削。
  // 最少留 1 张：补到 0 张等于这一方彻底不能动了，那不是「削选择面」
  // 而是把人出局，哪件技能都不该做到这个程度
  function handLimit(byFoe : boolean) : number {
    let want = HAND_SIZE
    // 挂效果记的 byFoe 是**发动方**，所以「我的满篓」= heldOn(CREEL, 我)
    if (heldOn(SK_CREEL, byFoe)) {
      want = want + 1
    }
    // 窄口是对方发动来削我的
    if (heldOn(SK_NARROW, !byFoe)) {
      want = want - 1
    }
    // ---- 角色那件常驻的，跟挂牌版叠加 ----
    //
    // 同名但是两件东西：挂牌版要「那张牌还在堆上」，角色版一直生效。
    // 【满篓】手牌上限 5 张（+1）、【窄口】对方 3 张（−1）
    if (hasSpecial(byFoe, SP_CREEL)) {
      want = want + 1
    }
    if (hasSpecial(!byFoe, SP_NARROW)) {
      want = want - 1
    }
    // ---- 闯关庄家那两条（添手 / 掐口），跟上面两件同构 ----
    //
    // 它们就是满篓和窄口的庄家版，所以**走同一个加减**而不是另开一条路：
    // 「手牌上限」这件事在整个玩法里只该有一个算的地方，
    // 不然四条规则两两组合的时候一定有一组算错。
    //
    // 添手还管起手张数（见 newGame 的发牌），那一处单独判
    if (byFoe && hasFoeSpecial('hand')) {
      want = want + 1
    }
    // 掐口削的是**玩家**，所以条件是 !byFoe（跟窄口一个写法）
    if (!byFoe && hasFoeSpecial('pinch')) {
      want = want - 1
    }
    // ---- 【涨落】把底数整个换掉，所以放在最后 ----
    //
    // 它不是「±1」那一类，而是「这一方补牌补到几张」这件事本身改了
    //（6 张而不是 4 张）。上面那几件照旧叠加在它身上 ——
    // 带涨落又挂着满篓就是峰值 7 张。
    //
    // **什么时候补**不在这儿，在 refill：涨落要「一张牌都打不出才补」
    if (hasSpecial(byFoe, SP_CYCLE)) {
      want = want + (CYCLE_REFILL - HAND_SIZE)
    }
    return want < 1 ? 1 : want
  }

  // 一方的回合结束：对方之前护着的饵到这里失效（护饵只挡这一回合）
  function expireGuards(finishedByFoe : boolean) {
    const drop = finishedByFoe ? GUARD_ME : GUARD_FOE
    const next = pileGuard.value.slice(0)
    for (let i = 0; i < next.length; i++) {
      if (next[i] == drop) {
        next[i] = GUARD_NONE
      }
    }
    pileGuard.value = next
  }

  // ---------- 结算 ----------

  // 这一方还有牌打得出去吗（被冻住的不算）
  function playableCount(byFoe : boolean) : number {
    const list = byFoe ? foeHand.value : hand.value
    let n = 0
    for (let i = 0; i < list.length; i++) {
      if (!isFrozen(list[i])) {
        n = n + 1
      }
    }
    return n
  }

  // 一局结束。两条出口，各管一件事：
  //
  //   **牌库空了，而且从那一刻起双方又打了 TAIL_PLAYS 手** —— 正常收摊；
  //   **牌库空了，而且两边都打不出牌** —— 提前收摊（死锁，理由在下面）。
  //
  // 手里剩的和堆上剩的都**不算分**（见 TAIL_PLAYS 那段：剩堆不算分和
  // 终局只给 2 手是成套的）。所以这个函数不再给任何人加分，只报账。
  //
  // ---- 第二条出口判的是「打得出牌吗」，不是「手里有牌吗」 ----
  //
  // 原先这儿写的是「牌库和两边手牌都空了」。那条漏了一个**死锁**：
  //
  //   牌库空了 → 补不了牌
  //   你手里 0 张 → 打不出
  //   庄家手里剩 1 张，而那张**被你冻住了** → 它也打不出
  //
  // 于是双方轮流跳过，无穷无尽。而【冻结】的解除条件是「效果牌被钓走」——
  // 可谁都打不出牌，那张效果牌就永远不会被钓走。这不是理论上的：
  // 模拟器跑 29 件技能时第一局就撞上了（牌库 0、你 0 张、庄家 1 张被冻、
  // 堆上 3 张、分 32:16，双方交替跳过了 400 个回合）。
  //
  // 改成数「打得出几张」之后，手牌空和全被冻在这件事上等价 ——
  // 两边都动不了就收摊。
  //
  // 这条出口**在终局那条之前判**：牌库空、TAIL 还没用完、可双方都被冻住了，
  // 那也得收摊（等不到那两手了）
  function checkOver() : boolean {
    if (deck.value.length > 0) {
      return false
    }
    // 牌库刚空：记下这一刻的手数。TAIL_PLAYS 从这儿往后数
    const justEmptied = tailFrom < 0
    if (justEmptied) {
      tailFrom = myPlayed + foePlayed
    }
    const dead = playableCount(false) == 0 && playableCount(true) == 0
    if (!dead) {
      // 终局那两手还没打够
      if (myPlayed + foePlayed - tailFrom < TAIL_PLAYS) {
        // ---- 牌库空了，**弹一下告诉玩家** ----
        //
        // 走 toast 而不是 message：message 那一行是战况，下一手就被
        //「庄家打出 ♥7」盖掉了，而「只剩两手」是玩家要据此改打法的事
        //（手里攒的牌再不打就不算分了）。顶栏那块「牌库 N」只是个数字，
        // 从 1 变 0 不够显眼
        if (justEmptied) {
          uni.showToast({
            title: '牌库空了 · 双方各再打 1 手就收摊',
            icon: 'none',
            duration: 2500
          })
        }
        return false
      }
      // ---- 打够了，可双方出牌数不等：少打的那一方再补一手 ----
      //
      // 一局里双方该打一样多的牌。平常自然成立（交替出牌），
      // 歪掉的来路是**牌不经「打出」就离场**那一类：
      // 洪水（从牌库翻上堆）、填塘、守滩（从手上垫到堆上）、冻结（卡在手里）。
      // 开局那道奇偶闸管不了它们 —— 它们是局内发生的。
      //
      // 实测这条能把奇数牌库那 1.21 分的摆动补回 43%（−0.90 → −0.38）。
      // 补不回全部是因为「终局那几手的结构」也歪了，那个由开局的闸管
      //（见 trimDeck）。两条各管一头，都要。
      //
      // **少打的那一方正好就是下一个该出牌的** —— 交替出牌自然保证，
      // 不用在这儿调轮次。只有「跳过回合」会错位，而那种局面下
      // playableCount 会返回 0，照旧收摊，不会卡住。
      //
      // ---- 只补一手，**必须限幅** ----
      //
      // 奇数牌库下差额正好是 1，补一手就齐了。可差额**能大于 1**：
      // 庄家规矩【再钩】（钓到牌可以再打一张）让它一个回合打两张，
      // 而那时轮次和「谁少打」会错开 —— 不限幅的话这儿会一路放行，
      // 把「各打 1 手」变成「把手牌全打完」，终局那个阶段就又长回去了。
      //
      // 所以终局最多 TAIL_PLAYS + 1 手。补不齐就算了：差额 2 以上是
      // 技能造成的，那笔账该记在那件技能头上（见设计文档），
      // 不该让结束条件去兜
      if (myPlayed != foePlayed
        && myPlayed + foePlayed - tailFrom < TAIL_PLAYS + 1
        && playableCount(myPlayed > foePlayed) > 0) {
        return false
      }
    }
    over.value = true
    const held = hand.value.length + foeHand.value.length
    // 手里和堆上剩的都不算分，所以**要把张数报出来** ——
    // 静默吞掉的话玩家会以为自己少拿了分（而那几张本来就不该进账）
    const restNote = held + pile.value.length == 0 ? ''
      : '手里 ' + held + ' 张、堆上 ' + pile.value.length + ' 张都不算分。'
    message.value = (dead
      ? '双方都打不出牌了。'
      : '牌库空了，双方各打完最后一手 —— 收摊。') + restNote
    settle()
    return true
  }

  // ---------- 〔删了〕leftoverFor：终局剩堆归「没打最后一手」的一方 ----------
  //
  // 2026-10-14 加的，2026-10-15 删的。**留这块墓碑是为了防止它被捡回来** ——
  // 它看着是个好主意，而且它解决的那个问题是真的。
  //
  // 它治的病：旧规则「剩堆不算分」让最后一手成了全局最值钱的位置
  //（后手优势 +3.03、胜率 58%，其中 96% 出在最后 8 手）。把剩堆判给
  // 没打最后一手的那一方，基线立刻平到 −0.08 —— **因为最后一手收走的
  // 和剩堆剩下的是同一块牌，两者负相关，所以它是个自动对冲。**
  //
  // 它带来的病，也是真的：**剩堆有了收款人，「让牌卡在堆上」就开始偏向
  // 那个人**。而偶数牌组下剩堆每一局都归先手，于是「让堆变厚」整整一族
  // 全飘了（死水 D +2.87 / 寒流 +1.37 / 霜降 +1.37 / 藏凌 +1.10 /
  // 净水 +1.35 / 逆流船夫 +8.42 / 深海钓手 +5.95）。
  //
  // **换掉它的是 TAIL_PLAYS**（见那段）：不去配平最后一手的价值，而是
  // 把产生那个价值的阶段删掉。那样剩堆就不需要收款人 —— 上面那一族的 D
  // 实测全塌到 ±0.12。
  //
  // 要再捡回它的话，先读 TAIL_PLAYS 那段里的四档数：**两条规则并用会
  // 过补到 −2.23**，它们是互斥的两条路，不是能叠的两件补丁。

  // 结算照排竿：
  //   赢了 —— 推进到下一关、发金币（过关奖励 + 胜分奖励，胜分有上限）、掷一次技能；
  //   平局 —— 存档不动，重打这一关；
  //   输了 —— 本轮马上作废（技能、金币全清），只留最远纪录。
  //     当场就写进存档，退出页面也逃不掉
  function settle() {
    const data = loadDrawSave()
    const id = level.value.id
    // 终局模式**一个字都不写存档**：不推关号、不发金币、输了也不清你的家当。
    //
    // 这是它整个设计的落点。正常模式里一局的分量很重（输一次十二关白打），
    // 所以你会保守地打；终局不记账，于是你敢拿那套摇出来的配装去试
    // 任何疯招 —— 它卖的就是这个
    if (finalMode) {
      outcome.value = OUT_FINAL
      rewardText.value = myScore.value == foeScore.value
        ? '平局 · 这一局不记账'
        : (myScore.value > foeScore.value ? '赢了 · 这一局不记账' : '输了 · 这一局不记账')
      return
    }
    // ---------- 平局**算过关**（2026-10-15 改）----------
    //
    // 原先是「重打这一关，不扣生命」。改了两个理由：
    //
    //   **治不了根**：平局率 6.4%，而它由「双方总分和是偶数」决定 ——
    //     52 张全有归属，26:26 很容易撞上。想靠改牌数凑奇数来消掉它
    //     又行不通，因为商店能买卡、牌组大小本来就在变。
    //   **重打是唯一的痛点**：一轮 12 关大概要重打 0.8 次，而重打的那一关
    //     题目没变（庄家配装不重摇，见 draw-save 的 settleWin 那段）——
    //     所以它不是一次新的挑战，只是把同一关再打一遍。
    //
    // 而金币**自然就少** —— 它是「过关奖励 + 胜分 + 利息」，
    // 而胜分 = 分差，平局时正好是 0。所以不用加任何特殊规则：
    // 平局落在「分差 0」那一档，拿得到过关奖励和利息，拿不到胜分。
    //
    // 下面那段发奖励的代码**一个字都不用改** —— margin 自己会算成 0。
    // 所以这儿不 return，直接往下走
    if (myScore.value < foeScore.value) {
      // 扣 1 点生命。还有剩就退回上一个商店（金币、技能、货架都是那时候的样子），
      // 第 1 关前面没有商店就重打第 1 关；扣光了整轮作废（见 draw-save 的 settleLoss）
      const before = data.lives
      const max = maxLivesOf(difficultyOf(drawSaveSlot()))
      const alive = settleLoss(data)
      saveDraw(data)
      save.value = data
      if (alive) {
        outcome.value = OUT_RETRY
        rewardText.value = '生命 −1，还剩 ' + data.lives + ' 点'
          + (data.inShop ? ' · 回到上一个商店' : ' · 重打这一关')
        loseHeart(before, max, data.inShop)
        return
      }
      loseHeart(before, max, false)
      outcome.value = OUT_LOSE
      rewardText.value = '生命用完，止步第 ' + id + ' 关，技能和金币清空 · 最远 ' + data.best + '/' + DRAW_RUN_LENGTH
      return
    }
    const margin = Math.min(myScore.value - foeScore.value, MARGIN_BONUS_CAP)
    // 利息按**打这一关之前手头剩的钱**算（见 draw-levels 的 interestOf）。
    //
    // 在加过关奖励**之前**算是关键：不然那笔奖励自己也生息，
    // 「攒着」和「花光」的差别就被摊薄了。利息要奖励的是
    // 「上个商店我忍住没买」，而不是「我刚赢了一关」
    const interest = interestOf(data.gold)
    const gain = level.value.reward + margin + interest
    settleWin(data, id, gain)
    saveDraw(data)
    save.value = data
    // 平局单独说一句 —— 不然玩家看到「获得 N 金币（胜分 +0）」会以为算错了。
    // 它确实过关了，只是没有胜分那一笔
    rewardText.value = (myScore.value == foeScore.value ? '平局算过关 · ' : '')
      + '获得 ' + gain + ' 金币（胜分 +' + margin
      + (interest > 0 ? '，利息 +' + interest : '') + '）'
    outcome.value = id >= DRAW_RUN_LENGTH ? OUT_CLEAR : OUT_WIN
    if (outcome.value == OUT_WIN) {
      shopTimer = setTimeout(goShop, SHOP_DELAY_MS)
    }
  }

  // 一方打完这回合，交给另一方。
  //
  // **补牌在这儿** —— 回合结束时把刚打完那一方的手牌补足到 HAND_SIZE。
  //
  // 从前是「回合开始摸一张、打一张」。改到回合末有两个好处：
  //   · 你做决定的那一刻手牌张数是**定的**（满 4 张），不是「刚摸到的
  //     这张算不算进去」；
  //   · 补上来的牌你**下一回合开始就看得见**，而不是摸一张立刻就得打它。
  //     于是「留哪张、打哪张」有了一整个回合的思考时间。
  //
  // 摆在 checkOver 之前：补完才算得准「牌库和两边手牌是不是都空了」
  // 一方打完这一手，交给另一方 —— 但【连竿】可能让它再打一张。
  //
  // ---- 连竿在这儿截住交接 ----
  //
  // 它排在**最后**（跟「优先」正好两头）：这一手的所有效果都结算完了，
  // 才问「要不要再来一张」。
  //
  // 三条闸：
  //   · **加打的那张不再给加打**（againUsed）—— 不然覆盖面一宽就能
  //     一口气打完整手牌，而「每回合一个决定」是这个玩法的节奏基础。
  //     封住之后它恒定是「一回合两张」，跟覆盖面无关。
  //   · 手里没牌了就不给（没得打）。
  //   · **补牌和护饵过期都压到真交接那一刻**：加打那张是同一个回合里的，
  //     中间补牌的话手牌数就不对了，护饵也会提前失效
  // 一张牌打完了（技能结算完、匹配完、收牌特效也演完了），再交回合。
  //
  // 【燎原】在这儿蔓延：**每打一张牌蔓延一次**。连竿加打的那一张也算一张 ——
  // 所以它比「每回合一次」快，连竿 × 燎原一回合能烧两格。
  // 「没牌可打、跳过回合」那几条路直接调 passTurn，不经过这儿，不蔓延
  function endPlay(byFoe : boolean) {
    // 【燃烧】那一步**不在这儿了**（2026-10-14）—— 它挪到了匹配**之前**
    // （afterPlayTail 的末尾，见 burnStep）。
    //
    // 挪的理由是那个结算顺序：落堆 → 场上效果 → 卡牌效果 → 燃烧 → 匹配。
    // 排在匹配前面，「一张牌收两次」那道闸就是免费的 ——
    // 燃尽扫走整堆时刚打那张也在里面，被收走了，匹配自然碰不到它
    //
    // 〔`fillPond(byFoe)` 2026-10-16 去掉 —— 填塘重做成【净滩】，
    //   新版判在**打出那一刻**（valuesOf 里读「堆空不空」），
    //   不再需要「一张牌打完之后」这个位置〕
    //
    // 【推牌】在这儿兑现 —— **这是推牌唯一的挂点**（见 surgeFor 那段）
    if (surgePending > 0) {
      surgeFor(byFoe, surgePending)
      surgePending = 0
    }
    // ---- 【逆涌】（常驻技）：对方打出 J 之后，推牌 2 层 ----
    //
    // **持有者是 `!byFoe`，触发者是 `byFoe`** —— 效果是「**对方**打出 J」，
    // 而推完轮到持有者出牌。认反了符号就反了（厚堆对**下一个出牌的人**有利，
    // 那是这一族最要紧的那条判据，见 surgeFor 上面那段）。
    //
    // 跟推牌共用这个挂点、共用 surgeFor，所以「每层 2 张、推不满一层就停、
    // 撞上置 0」三条自动一致 —— 不用在这儿重复任何一条。
    //
    // 判 J 用 `lastPlayed`：这会儿牌早离手了（可能还被收走了），
    // 所以不能查手牌，而 `lastPlayed` 是这一手打出那张的唯一记录
    if (lastPlayed != null && lastPlayed!.rank == JACK
      && hasSpecial(!byFoe, SP_JSURGE)) {
      surgeFor(byFoe, JSURGE_LAYERS)
    }
    passTurn(byFoe)
  }

  // ---------- 【推牌】兑现：每层从牌库推 2 张到堆上 ----------
  //
  // **挂点只有一个，而且必须是这儿**（endPlay，`passTurn` 之前）：
  //
  //   在这儿 = 这一手**全部结算完**了。endPlay 的注释写着
  //     「技能结算完、匹配完、收牌特效也演完了」，而「没牌可打、跳过回合」
  //     那几条路**直接调 passTurn、不经过这儿** —— 所以一张打出的牌
  //     恰好触发一次，不会多也不会漏。
  //   `passTurn` **之前** = 推牌改牌库张数，而 passTurn 里的 `refill`
  //     和 `checkOver` 都要读它（牌库空就收摊，见 TAIL_PLAYS）。
  //     排到后面的话这一局的长短会算错一手。
  //
  // 〔`fillPond`（填塘）原先就在这个位置 —— 同一类动作、同一个挂点〕
  //
  // ---- 「不算打出」那两半要一起记 ----
  //
  // 从牌库硬塞上堆的牌**不算打出**，所以传空的 skills：它自己的技能
  // 一个都不触发（磁钩、顺色、寒流…），也不会误触对方的。
  // **可场上挂着的效果照样管它** —— 走 landVals，所以净滩那一类
  // 「落堆时改点数」的照旧生效。少记一半就错一边。
  //
  // ---- 撞上堆里的点数：**那张置 0，留在堆上**〔2026-10-16 实测定的〕----
  //
  // 四种处理里只有「置 0」和「洗回再翻」保得住**恰好 2 张/层**，
  // 而「恰好偶数张」是奇偶那道闸的全部依据（撞上就停会让张数变成不定）。
  // 两档都量过（口径 `all`、江口闸官 A 槽、20000 局、受害方躲 2 档）：
  //
  //   洗回再翻  X **+2.42**
  //   **置 0**  X **+2.19**   ← 定稿
  //
  // 低 0.23 分（约 2 个标准误）却选了它，三个理由：
  //
  //   **零新规则** —— 「置 0」是词表里定死的词，而且跟现有三条线自动咬合
  //     （见底收走「点数为 0」的牌、撒网把 0 当偶数、磁钩的 0+1 钩得到 A）。
  //     洗回那档要给玩家多讲一句「翻上来又塞回去」。
  //   **不碰牌库顺序** —— 洗回就是洗牌，而洗牌会冲掉观潮 / 择饵 / 活水
  //     刚看到的牌序。那一项**反噬下饵的人**（对手踩了我的标签、顺手清掉
  //     我攒的情报），玩家还算不出来；**而模拟器量不到它**
  //     （那套 AI 不经营牌序）—— 所以 +2.42 里有一部分是虚的。
  //   **界面干净** —— 恰好 2 张牌出现，其中一张标着 0。不用演「翻进又翻出」。
  //
  // 置 0 的牌只贡献**堆深**、不贡献**钩点**（0 点不匹配任何东西，见 anyEquals），
  // 那就是那 0.23 分的去处。
  //
  // ---- 不走飞牌特效 ----
  //
  // 它不收牌，所以压根没有收牌特效的事；而推上来的牌直接落堆 + 播报，
  // 照见底 / 收色 / 撒网那条路（翻几张不定的一律这么处理）
  function surgeFor(byFoe : boolean, layers : number) {
    let pushed = 0
    let zeroed = 0
    for (let n = 0; n < layers; n++) {
      // **按层停，不是按总数停** —— 每层固定 2 张，所以推任意整数层
      // 都保持偶数。牌库剩 2 张时 3 层的牌仍能推 1 层。
      // 这道闸是「够不够一层」，差一张都不能推（推 1 张就翻了奇偶）
      if (deck.value.length < SURGE_PUSH) {
        break
      }
      for (let k = 0; k < SURGE_PUSH; k++) {
        const rest = deck.value.slice(0)
        const card = rest.pop()!
        deck.value = rest
        // 先判撞，再落堆 —— catchStart 遍历的是 pile，这张还没进去，
        // 所以不会跟自己比（照已删 floodFor 那条判据）
        const hit = catchStart(card, byFoe, [] as number[], false) >= 0
        if (hit) {
          zeroed = zeroed + 1
        }
        // 撞上就按 0 点落堆。**不是 landVals** —— 置 0 在这条路上是终态，
        // 场上挂着的改点数效果也盖不回来（照 valuesOf 里【死水】那条先例：
        // 「废了就是废了，不该还受别的技能摆布」）
        pushPile(card, byFoe, GUARD_NONE,
          hit ? ([0] as number[]) : landVals(card, byFoe, [] as number[], false))
        pushed = pushed + 1
      }
    }
    if (pushed == 0) {
      message.value = message.value + (byFoe ? ' 庄家推牌：' : ' 推牌：')
        + '牌库不够了，没有牌涌上来。'
      return
    }
    message.value = message.value + (byFoe ? ' 庄家推牌：' : ' 推牌：')
      + '从牌库涌上 ' + pushed + ' 张'
      + (zeroed > 0 ? '，其中 ' + zeroed + ' 张撞了点数、变成 0 点' : '')
      + '。'
  }

  // ---------- 【燃烧】那一步：蔓延 → 全堆带火就扫整堆（燃尽） ----------
  //
  // 排在**匹配之前**，调用点在 afterPlayTail 的末尾。
  //
  // ---- 三个口径 ----
  //
  //   **堆 1 张就触发** —— 所以野火点在空堆上落下的那张时会当场收走它。
  //     那是这一族的兜底（照抄底那条「无点数是兜底不是代价」）。
  //   **堆空不触发** —— 空堆「全带火」是真空真，得显式挡掉。
  //   **归当前出牌方**，不记谁点的火 —— 所以你点的火可能被对手收走，
  //     而那正是「什么时候点」成为决策的原因。不记归属也省掉一条并行数组。
  //
  // ---- 判定**一手只跑一次**，匹配之后不复查 ----
  //
  // 于是匹配收掉几张之后剩下的正好全带火也不触发，要等下一手。
  // 连带一个真陷阱：**匹配之后留下一个全带火的堆 = 把下一次燃尽送给对手**
  //（他出牌那张不带火落下 → 蔓延点着它 → 全堆带火 → 他燃尽）。
  //
  // ---- 带【保护】的牌点不着，所以它是最强的对位解 ----
  //
  // 堆上只要有一张带保护的牌，「全堆带火」就永远不成立 ——
  // **一张牌锁死整条线**。那一条不用在这儿写：spreadFire 和 wildfireFor
  // 都跳过带保护的格子，于是这儿的循环自然判不出全带火。
  //
  // 返回 **true = 开演收牌特效了**，调用处就别再走匹配 ——
  // 演完由 finishSweep 认 TAIL_BURN 直接接到 resolveMatch
  function burnStep(byFoe : boolean, skills : number[]) : boolean {
    spreadFire()
    const size = pile.value.length
    if (size == 0) {
      return false
    }
    for (let i = 0; i < size; i++) {
      if (pileBurnAt(i) == 0) {
        return false
      }
    }
    const all : number[] = []
    for (let i = 0; i < size; i++) {
      all.push(i)
    }
    message.value = message.value + (byFoe ? ' 庄家燃尽：' : ' 燃尽：')
      + '场上全烧着了，整堆 ' + size + ' 张收走。'
    return startSweep(byFoe, all, skills, TAIL_BURN)
  }

  // ---------- 〔删了〕fillPond（填塘）：堆被清空时从牌库补一张 0 点牌 ----------
  //
  // **2026-10-16 重做成【净滩】**（见 valuesOf 里那一支）。
  //
  // ---- 死因不是强度，是它搬牌 ----
  //
  // X 和新版一样 ≈0，可它 **D = +0.80**（后手 −0.80 / 先手 +0.80，
  // 完美反对称）。病根是这一行：
  //
  //     deck.value = deck.value.slice(0, deck.value.length - 1)
  //
  // **那张牌不经任何人的手就离场了** → 牌库的奇偶翻一次 →
  // 终局那几手的结构跟着歪（偶数时终局是「先手打、后手打」，
  // 奇数时变成「后手打、先手打、后手打」）。
  // 开局那道剔牌闸管不了它（它是局内发生的），而结束条件里
  // 「双方出牌数要相等」只补出牌数、补不了结构。
  //
  // ---- 它留下两条判据 ----
  //
  // **一、「空堆白打」有两半，而补牌只救得了一半。**
  //   这一手钓不到（救不了，堆是空的）＋ 这一手给对手留了钩点（救得了）。
  //   填塘绕了一大圈（补一张牌让堆不空）才做到后者，而【净滩】
  //   直接让那张牌不成为钩点 —— **同一个意图，少动一样东西**。
  //
  // **二、「判在 endPlay 而不是各条收牌路里」是对的，值得记。**
  //   清空堆有七八条来路（J 通吃 / 顺色 / 一色 / 见底 / 撒网 / 收色 / 吃水…），
  //   在每条后面各判一次**必漏一条**，而漏掉的表现是
  //   「这一关它有时候不触发」—— 最难查的那种。
  //   `endPlay` 是「一张牌打完了」的唯一出口，堆的状态在那儿已经定了。
  //   **新版不需要这个位置**（它判在打出那一刻、落堆之前），
  //   但下次再做「读堆的状态」的效果时，这条仍然适用。

  // 连竿：**收手**。
  //
  // againPending 已经在 passTurn 里清掉、againUsed 已经立起来了，所以
  // 再调一次 passTurn 会直接走后半段（过期护饵、走水、补牌、交回合）——
  // 不用把那一段抄一遍，也就不会漏掉其中某一步
  function onAgainSkip() {
    if (!againWaiting.value) {
      return
    }
    againWaiting.value = false
    message.value = '连竿：你收手了。'
    passTurn(false)
  }

  // 这一方手里还有**值得打**的牌吗（加打之前问一次）。
  // 照模拟器 rules.js 的 wantAgain，两边必须同一套判据 —— 不然量出来的
  // 分值跟玩家实际体验到的是两件不同的技能。
  //
  // J 总是值得（通吃）；别的看能不能钓到、或者能不能靠技能收一片。
  // 一张都不值得就收手：加打那张钓不到就得落堆，等于给对手多一个钩点。
  //
  // **只给庄家用。** 玩家那边是一颗按钮（againWaiting）—— 替玩家判断
  // 「这张值不值得」就把取舍从他手里拿走了，而那正是这件技能的内容
  function wantAgain(byFoe : boolean) : boolean {
    const mine = byFoe ? foeHand.value : hand.value
    for (let i = 0; i < mine.length; i++) {
      const card = mine[i]
      if (isFrozen(card)) {
        continue
      }
      if (card.rank == JACK) {
        return true
      }
      const skills = skillsOf(byFoe, card)
      if (catchStart(card, byFoe, skills, false) >= 0) {
        return true
      }
      if (harvestCount(card, skills, byFoe) > 0) {
        return true
      }
    }
    return false
  }

  function passTurn(byFoe : boolean) {
    if (againPending && !againUsed.value) {
      againPending = false
      againUsed.value = true
      const mine = byFoe ? foeHand.value : hand.value
      if (mine.length > 0) {
        if (byFoe) {
          // 庄家自己判。不值得就**收手**，往下走真交接 ——
          // 「可」对双方一个口径，不然这件技能在庄家手里还是强制的
          if (wantAgain(true)) {
            message.value = message.value + ' 庄家连竿，再来一张。'
            foeTimer = setTimeout(foeTurn, FOE_DELAY_MS)
            return
          }
          message.value = message.value + ' 庄家连竿，但它收手了。'
        } else {
          // 你自己决定：点手牌就是加打，点「收手」走 onAgainSkip。
          // **不在这儿 return 掉交接**也不行 —— 回合还没结束，
          // 得等你做完那个决定（跟观潮 / 换水那几块 pending 一个结构）
          message.value = message.value + ' 连竿：可以再打一张，也可以收手。'
          againWaiting.value = true
          return
        }
      } else {
        message.value = message.value + (byFoe ? ' 庄家连竿，但它没牌了。' : ' 连竿：可你手里没牌了。')
      }
    }
    againWaiting.value = false
    againPending = false
    againUsed.value = false
    expireGuards(byFoe)
    // 【燎原】原先在这儿蔓延（每回合末一次）。改成了**每打一张牌蔓延一次**，
    // 挪到 endPlay —— 这儿还会被「没牌可打、跳过回合」那几条路调到，那不算打牌
    // ---------- 【走水】：堆养过 LEAK_DEEP 张就从底下漏 ----------
    //
    // 摆在「回合末」：连竿那条路在上面 return 了，
    // 所以加打的那一张**不额外漏一次**（一个回合漏一格，那是它的速度）。
    //
    // **双方回合末都算** —— 它罚的是「堆厚了」这个状态，不是谁造成的。
    // 而它**自限**：漏一张就回到阈值上，所以它实际是把堆钉在 LEAK_DEEP 张，
    // 不是无底洞。不用再写一条限幅
    if (hasFoeSpecial('leak') && pile.value.length > LEAK_DEEP) {
      dropBottomToFoe('走水')
    }
    refill(byFoe)
    if (checkOver()) {
      return
    }
    if (byFoe) {
      startMyTurn()
    } else {
      startFoeTurn()
    }
  }

  // 回合开始**不摸牌** —— 牌是上一回合结束时补好的（见 passTurn 的 refill）
  function startMyTurn() {
    myTurn.value = true
    if (hand.value.length == 0) {
      // 牌库空了、手里也没牌：这回合什么也做不了
      message.value = '你没牌可打，跳过这回合。'
      passTurn(false)
      return
    }
    // 手里有牌、可全被冻住了：**当场补牌**，补到能打的就接着打（跟庄家那边 foeTurn 里那条是一对）。
    //
    // 补牌原本只在回合末（passTurn → refill）。全冻住的话这个回合打不出牌、结束不了，
    // 就永远走不到那一步 —— 碰上【枯水】（打不出牌时才补）整局卡死：
    // 剩一张冻着的牌，它在等「打不出牌」，而那正是现在。
    // refill 只数能打的牌（见 playableCount），所以枯水下这儿也补得上。
    // 牌库空了补不上，才跳过这回合（双方都动不了由 checkOver 收摊）
    if (playableCount(false) == 0) {
      const before = hand.value.length
      refill(false)
      if (playableCount(false) == 0) {
        message.value = '你的牌全被冻住了，也补不到牌，跳过这回合。'
        passTurn(false)
        return
      }
      message.value = '你的牌全被冻住了，补了 ' + (hand.value.length - before) + ' 张。'
    }
    // ---- 只在**有新消息**的时候动 message ----
    //
    // 原先这儿恒写一句「你的回合，打出一张。」。战况和回合提示合成一条之后
    // 那句话就跟 turnText 撞了（状态行会显示「你的回合 · 打出一张
    // 你的回合，打出一张。」）。
    //
    // 现在只有牌库空了才说一句 —— 那是局面变了、值得提一嘴；
    // 平常就让 message 留着上一条战况（庄家刚打了什么、钓走几张），
    // 「现在该你」那半归 turnText 说。两半各说一件事，不重复
    //
    // ---- 这句话 2026-10-15 改了：终局不再是「打完手牌」 ----
    //
    // 原先是「牌库空了，手里这 N 张打完就收摊」。现在牌库空后只剩
    // TAIL_PLAYS 手（见那段），手里剩的不算分 —— 所以要报的是
    // **还剩几手**，而且得说清那几张作废了，不然玩家还按老规则攒牌
    if (deck.value.length == 0) {
      const left = TAIL_PLAYS - (myPlayed + foePlayed - tailFrom)
      message.value = (left >= 2
        ? '牌库空了 —— 双方各再打 1 手就收摊。'
        : (left == 1
          ? '牌库空了 —— 你打完这一手就收摊。'
          : '补最后一手 —— 双方要打一样多的牌。'))
        + '手里剩 ' + hand.value.length + ' 张，收摊时不算分。'
    }
  }

  function onPlay(index : number) {
    // 换水等着你挑的时候，点手牌是「挑这张塞回去」，不是「打出去」
    if (swapPending.value) {
      onSwap(index)
      return
    }
    // 对换的第二步同理：点手牌是「挑这张还给庄家」
    if (giveBack.value >= 0) {
      onGiveBack(index)
      return
    }
    if (!canPlay.value || index >= hand.value.length) {
      return
    }
    // 被冻住的打不出去
    if (isFrozen(hand.value[index])) {
      uni.showToast({ title: '这张被冻住了，打不出去', icon: 'none' })
      return
    }
    const card = hand.value[index]
    newIndex.value = -1
    playFor(false, index)
    message.value = '你打出 ' + cardName(card) + '。'
    // 先结算技能，最后匹配（见 resolveMatch）
    afterPlay(false)
  }

  function startFoeTurn() {
    myTurn.value = false
    foeTimer = setTimeout(foeTurn, FOE_DELAY_MS)
  }

  // 庄家一回合：打一张。摸牌不在这儿 —— 跟你一样，
  // 它的牌是上一回合结束时补好的（见 passTurn 的 refill）
  function foeTurn() {
    foeTimer = -1
    if (foeHand.value.length == 0) {
      message.value = '庄家没牌可打，跳过。'
      passTurn(true)
      return
    }
    let index = foePickCard()
    // **手里有牌也可能打不出** —— 全被【冻结】锁着的时候 foePickCard
    // 返回 -1（见 randomFree）。不拦这一下的话 foeHand.value[-1] 是
    // undefined，接着 playFor 取不到牌、cardName(undefined) 当场崩。
    //
    // 这一条跟 checkOver 那条是一对：那边管「双方都动不了就收摊」，
    // 这儿管「这一方动不了就过」。两边都空着的局面由 checkOver 结掉。
    //
    // 过之前先补牌（跟 startMyTurn 那条是一对）：补到能打的就照常出
    let note = ''
    if (index < 0) {
      const before = foeHand.value.length
      refill(true)
      index = foePickCard()
      if (index < 0) {
        message.value = '庄家手里的牌全被冻住了，也补不到牌，跳过。'
        passTurn(true)
        return
      }
      note = '庄家的牌全被冻住了，补了 ' + (foeHand.value.length - before) + ' 张。'
    }
    const card = foeHand.value[index]
    playFor(true, index)
    message.value = note + '庄家打出 ' + cardName(card) + '。'
    afterPlay(true)
  }

  // ---------- 剩牌面板 ----------

  const showLeft = ref<boolean>(false)

  // 弹层里的卡片挡住遮罩的点击 —— 点卡片本身不该关掉它
  function noop() {}

  type LeftRow = {
    rank : string
    total : number
    left : number
    // 这个点数在你技能的覆盖面上吗
    mine : boolean
    bar : string
  }

  // 每个点数一行：这一轮共几张 / 外面还剩几张 / 一条方块条。
  //
  // 「外面」= 牌库 + 庄家手牌，也就是 outsideCount 那个数 ——
  // 跟庄家记的账完全一样（理由见模板里那段）。
  //
  // 顺带把**你技能覆盖的点数**描亮：覆盖面值不值钱，这一眼就看出来了。
  // 技能落在 A、2 上而那两个点数外面都空了，那就是该买洗点的信号
  const outsideRows = computed<LeftRow[]>(() : LeftRow[] => {
    const out : LeftRow[] = []
    const lo = loadoutOf(false)
    for (let i = 0; i < RANKS.length; i++) {
      const rank = RANKS[i]
      const total = totalOfRank(rank)
      const left = outsideCount(rank)
      // 方块条：一格一张。四张的牌组一行就四格，改造过的可能更多，
      // 所以**封到 8 格**，再多就只看数字
      let bar = ''
      const show = left > 8 ? 8 : left
      for (let b = 0; b < show; b++) {
        bar = bar + '▪'
      }
      if (left > 8) {
        bar = bar + '…'
      }
      out.push({
        rank: rank,
        total: total,
        left: left < 0 ? 0 : left,
        // J 不能被指定，所以它永远不算「你管着的」
        mine: rank != JACK && rankCoveredBy(lo, rank),
        bar: bar
      } as LeftRow)
    }
    return out
  })

  // 这个点数落在 lo 的点数槽上吗（归谁不管，只问有没有人管）
  function rankCoveredBy(lo : DrawLoadout, rank : string) : boolean {
    for (let r = 0; r < SKILL_RANKS.length && r < lo.rankOwner.length; r++) {
      if (SKILL_RANKS[r] == rank) {
        return lo.rankOwner[r] >= 0
      }
    }
    return false
  }

  // 把这张当饵有多危险：**它所有点数**外面各还剩几张，加起来。
  //
  // 加起来而不是只看牌面那个，是因为点数卡：一张 ♠3·7 被 3 钓得走、
  // 也被 7 钓得走，当饵就比普通的 ♠3 危险得多。
  // 不贴点数卡的牌只有一个点数，所以这个值跟从前完全一样
  function baitRisk(card : PlainCard) : number {
    const vals = cardVals(card)
    let risk = 0
    for (let i = 0; i < vals.length; i++) {
      // 0 点谁也按点数钓不走它（anyEquals 跳过 0），所以零点牌这一项不算风险。
      // 无点数牌 cardVals 是空的，自然是 0 —— 两种都是最安全的饵
      if (vals[i] == 0) {
        continue
      }
      // 熔合出来的大点数（'17'）牌组里本来没有，总张数查不到是 0，
      // 减掉看得见的那几张会成负数 —— 风险最少是 0，不能倒贴
      const out = outsideCount(faceOfValue(vals[i]))
      risk = risk + (out > 0 ? out : 0)
    }
    return risk
  }

  // 这个点数除了庄家自己手里、堆上、已被钓走的，外面还剩几张 —— 你手里有它的可能就这么大。
  //
  // 数的是**牌面那个点数**：点数卡贴上来的不算在内，因为一张 ♠3·7
  // 不是一张 7 —— 它只是「也钓得上 7」。两件事分开才说得清，
  // 「当饵危不危险」那条走 baitRisk
  function outsideCount(rank : string) : number {
    let seen = 0
    for (let i = 0; i < foeHand.value.length; i++) {
      if (foeHand.value[i].rank == rank) {
        seen = seen + 1
      }
    }
    for (let i = 0; i < pile.value.length; i++) {
      if (pile.value[i].rank == rank) {
        seen = seen + 1
      }
    }
    for (let i = 0; i < goneRanks.value.length; i++) {
      if (goneRanks.value[i] == rank) {
        seen = seen + 1
      }
    }
    // 总张数读这一轮的牌组构成，**不写死 4** ——
    // 改造过的牌组某个点数可能有六张，也可能一张不剩。
    // 这儿一错，庄家的记牌（它拿「外面剩得最少」的点数当饵）就全盘错，
    // 而那是第 3 关起的核心难度
    return totalOfRank(rank) - seen
  }

  // 这一轮每个点数一共有几张。跟 RANKS 下标对齐，开局算一次
  let rankTotal : number[] = []

  function buildRankTotals(cards : PlainCard[]) {
    const list : number[] = []
    for (let i = 0; i < RANKS.length; i++) {
      list.push(0)
    }
    for (let i = 0; i < cards.length; i++) {
      for (let r = 0; r < RANKS.length; r++) {
        if (RANKS[r] == cards[i].rank) {
          list[r] = list[r] + 1
          break
        }
      }
    }
    rankTotal = list
  }

  function totalOfRank(rank : string) : number {
    for (let r = 0; r < RANKS.length; r++) {
      if (RANKS[r] == rank) {
        return r < rankTotal.length ? rankTotal[r] : 0
      }
    }
    return 0
  }

  // 这张牌打出去，收色 / 撒网能扫走几张（含它自己）。两件都没带就是 0。
  //
  // 口径跟 hueFor / castFor 一字不差 —— 两处算法要是走偏，
  // 庄家就会按一个数挑牌、按另一个数收牌。
  //
  // byFoe 是为了【两色】才加的参数（照 sameSuit 的要求）。调用点只有
  // foePickCard 一个、恒传 true，可**写死 true 就正是上面那条走偏**：
  // 哪天玩家侧要预览收成，这个函数会按庄家的眼睛算花色
  function harvestCount(card : PlainCard, skills : number[], byFoe : boolean) : number {
    const hue = hasTrigger(skills, SK_HUE)
    const cast = hasTrigger(skills, SK_CAST)
    // ---- 【伏流】也要在这儿估，否则庄家永远不会主动打它 ----
    //
    // 这个函数是庄家挑牌时唯一能看见「不走点数判定的收牌技能」的地方
    //（注释在 foePickCard 那边：不单独估一次，AI 就会把一张能扫掉半个堆的
    // 牌当普通饵打出去）。伏流是第四条匹配线，`catchStart` 对它一概返回 −1，
    // 所以漏在这儿的后果不是「庄家打得笨一点」，是**这件技能在庄家手里
    // 整件作废** —— 而那会让模拟器量出来的两侧严重失衡
    if (hasTrigger(skills, SK_FLOW)) {
      return straightCount(card, byFoe)
    }
    // 涉水同理 —— 它也是第四条匹配线上的，catchStart 看不见它
    if (hasTrigger(skills, SK_WADE)) {
      return wadeCount(card, byFoe)
    }
    // 一色：它的花色最多 → 整堆 + 它自己（估在落堆之前，堆里还没有它）
    if (hasTrigger(skills, SK_SUITIFY) && pile.value.length > 0 && suitLeads(card, true, byFoe)) {
      return pile.value.length + 1
    }
    if (!hue && !cast) {
      return 0
    }
    const size = pile.value.length
    const odd = card.value % 2 == 1
    // ---- 两件的形状不一样了，所以不能再混在一个循环里 ----
    //
    // 收色是**散收**（整堆所有同花色），撒网改成了**连续段**
    // （从一头往左连着收同奇偶）。原先两件都是散收，一个循环就够。
    //
    // 一张牌可能同时触发两件（带花色槽的角色，比如镜湖占卜师的 ♥3 ——
    // 花色槽一件、点数槽一件），所以标记叠加，最后数一遍
    const marked : boolean[] = []
    for (let i = 0; i < size; i++) {
      marked.push(false)
    }
    if (hue) {
      for (let i = 0; i < size; i++) {
        if (sameSuit(pileSuitAt(i), card.suit, byFoe)) {
          marked[i] = true
        }
      }
    }
    if (cast) {
      // 这儿估的是**打出之前**，所以这张牌还没落堆 —— 它将来落在堆顶，
      // 于是连续段从现在的堆顶往左数。castFor 那边起点是它自己的位置，
      // 两处算的是同一件事（它落堆之后就在堆顶）
      for (let i = size - 1; i >= 0; i--) {
        const vals = pileValsAt(i)
        let same = false
        for (let k = 0; k < vals.length; k++) {
          if ((vals[k] % 2 == 1) == odd) {
            same = true
            break
          }
        }
        if (!same) {
          break
        }
        marked[i] = true
      }
    }
    let n = 0
    for (let i = 0; i < size; i++) {
      if (marked[i]) {
        n = n + 1
      }
    }
    // 收色连它自己一起收（它落堆之后也是同花色的），所以 +1。
    // 撒网那张的奇偶跟自己当然一样，落堆后也在收走的范围里
    return n > 0 ? n + 1 : 0
  }

  // ---------- 【伏流】能凑出几张（庄家挑牌的预估） ----------
  //
  // 跟 straightFor 算的是同一件事，差别只有一处：**这儿是落堆之前估的**，
  // 所以堆里还没有它自己 —— 不用跳过 at0，整堆都是候选。
  //
  // **跟 straightFor 走同一个函数**（deepestByVal / bestChainAt），
  // 所以两处的判定口径不会飘 —— 那是硬要求，不是整洁癖：
  // AI 估出来的收成跟实际发生的不一致时，它会据此打错牌，
  // 而那种 bug 是静默的（这一季在野火的门槛和发动条件上各栽过一次）。
  //
  // ---- 这儿**没有**模拟「贴标签」那一步，所以它是个下限 ----
  //
  // 伏流实际会先贴一张通配再判，而贴哪张要试一遍（pickWildAt）。
  // 在挑牌阶段把那一层也模拟一遍的代价是「堆上每格 × 每张手牌」，
  // 而挑牌一回合要跑十几次。所以这儿按**不贴标签**估 ——
  // 于是庄家会**低估**伏流，那跟源码里逆流那个已知缺口同一性质
  //（挑牌阶段不知道「这张沉底能钓到」）。
  //
  // 它只影响庄家打得多好，不影响规则
  function straightCount(card : PlainCard, byFoe : boolean) : number {
    // ---- 这儿的 skipAt 是 −1，而 selfWild 是 true —— 两个参数**不同源** ----
    //
    // 看着矛盾，其实对：这是**落堆之前**估的，它还不在堆上，
    // 所以没有「自己那一格」要跳过（skipAt 无对象），
    // 但它打出去之后会自带通配，所以 selfWild 要给它留那一格。
    //
    // 〔selfWild 2026-10-16 从 false 改成 true，跟 straightFor 同步 ——
    //   漏了这儿的后果不是「AI 打得笨一点」，是**整件技能在庄家手里作废**
    //  （catchStart 对第四条匹配线一概返回 −1，见那段注释）〕
    const deepest = withHighAce(deepestByVal(-1, byFoe))
    const span = bestChainAt(deepest, wildAtsOf(-1, byFoe).length, true, 1)
    if (span[0] < 0) {
      return 0
    }
    let n = 1
    for (let v = span[0]; v <= span[1]; v++) {
      if (deepest[v] >= 0) {
        n = n + 1
      }
    }
    return n
  }


  // 【涉水】能凑出几张（庄家挑牌的预估）。
  //
  // 庄家估算涉水能收几张。
  //
  // **跟 wadeFor 走同一个 bestChainAt**（自带通配 + 步长 2），
  // 所以两处口径不会飘 —— 那是硬要求：AI 估的跟实际发生的不一致时
  // 它会据此打错牌，而那种 bug 是静默的。
  //
  // 两处差别只有一个：这儿是**落堆之前**估的，堆里还没有它自己，
  // 所以 skipAt 传 −1（wadeFor 那边传 at0 —— 它自己当通配、不占点数格）。
  // 结果上等价：两边都是「它不按自己的点数参与」。
  //
  // `n` 从 1 起算 —— 它自己当通配，是链上的一员，一定跟着走
  function wadeCount(card : PlainCard, byFoe : boolean) : number {
    const deepest = withHighAce(deepestByVal(-1, byFoe))
    const span = bestChainAt(deepest, wildAtsOf(-1, byFoe).length, true, 2)
    if (span[0] < 0) {
      return 0
    }
    let n = 1
    for (let v = span[0]; v <= span[1]; v++) {
      if (deepest[v] >= 0) {
        n = n + 1
      }
    }
    return n
  }

  // ---- 顺子里 A 可以接在 K 后面（Q-K-A） ----
  //
  // 点数轴本来是 0、1(A)、2 … 10、12(Q)、13(K)（11 是个洞：J 从不留在堆上）。
  // 在 K 后面再接一格「14 = A」，指向同一张 A —— 于是 12-13-14 就是 Q-K-A。
  // 一条顺子里 A 只当一次（1 和 14 不会同时在区间里，见 bestStraight / bestGapped），
  // 所以不会有 K-A-2 那种绕一圈的
  const HIGH_ACE : number = 14

  function withHighAce(deepest : number[]) : number[] {
    const out : number[] = []
    for (let v = 0; v <= HIGH_ACE; v++) {
      out.push(v < deepest.length ? deepest[v] : -1)
    }
    out[HIGH_ACE] = deepest.length > 1 ? deepest[1] : -1
    return out
  }

  // 顺子提示里报的牌面：1 和 14 都是 A
  function valueFace(v : number) : string {
    if (v == 1 || v == HIGH_ACE) {
      return 'A'
    }
    if (v == 11) {
      return 'J'
    }
    if (v == 12) {
      return 'Q'
    }
    if (v == 13) {
      return 'K'
    }
    return '' + v
  }


  // 庄家要打的那张。能钓就挑钓得最多的（J、磁钩、钩顶都算在里面；J 堆上有牌就用，不攒着）。
  // 钓不到时：会记牌的挑外面剩得最少的点数当饵，不拿 J 当饵；
  // 挑饵时触发护饵 / 窥视 / 搅水 / 观潮的牌，只要不比最安全的那张差 1 张以上就优先。
  // 不会记牌的（浅滩前两关）钓不到就随手打
  function foePickCard() : number {
    // 新手关：完全随机，钓得到也不挑
    if (level.value.random) {
      return randomFree()
    }
    let best = -1
    let bestCaught = 0
    for (let i = 0; i < foeHand.value.length; i++) {
      const card = foeHand.value[i]
      // 被你冻住的，它也打不出去
      if (isFrozen(card)) {
        continue
      }
      const skills = skillsOf(true, card)
      const sink = hasTrigger(skills, SK_SINK)
      const at = catchStart(card, true, skills, sink)
      let caught = 0
      if (at >= 0) {
        // 收几张：普通是「匹配那张到堆顶」+ 自己，
        // 沉底是「堆底到匹配那张」+ 自己（方向反的，见 playFor）
        caught = sink ? at + 2 : pile.value.length - at + 1
      }
      // ---- 收色、撒网的收成得单独估 ----
      //
      // 它们不走点数判定（收色连点数都没有，见 valuesOf），所以上面那个
      // catchStart 对它们一概返回 -1 —— 不单独估一次，庄家就会把一张
      // 能扫掉半个堆的牌当普通饵打出去。
      //
      // 估的是**实际收成**（照 hueFor / castFor 的口径），不是近似值：
      // 两件都是遍历堆、数命中几张，算一遍不比猜便宜
      const harvest = harvestCount(card, skills, true)
      if (harvest > caught) {
        caught = harvest
      }
      if (caught > bestCaught) {
        bestCaught = caught
        best = i
      }
    }
    if (best >= 0) {
      return best
    }
    if (!level.value.smart) {
      return randomFree()
    }
    let fewest = 99
    for (let i = 0; i < foeHand.value.length; i++) {
      if (foeHand.value[i].rank != JACK && !isFrozen(foeHand.value[i])) {
        fewest = Math.min(fewest, baitRisk(foeHand.value[i]))
      }
    }
    let pick = -1
    let pickScore = 99.0
    for (let i = 0; i < foeHand.value.length; i++) {
      const card = foeHand.value[i]
      if (card.rank == JACK || isFrozen(card)) {
        continue
      }
      let score = baitRisk(card) * 1.0
      const skills = skillsOf(true, card)
      // 想当饵顺手发动的那几件。挂效果的几件（冻结、见底、窄口、满篓）
      // 也算 —— 它们正好要求「这张别钓到牌」，跟当饵是一回事
      //
      //〔窥视、照水 2026-10-16 删了，这儿跟着去掉两项。
      //  它们的常量留着（= −1，hasTrigger 永不匹配），所以留在这儿
      //  **行为上也是对的**，去掉只是别让死分支占着这条判断链 ——
      //  模拟器 `ai.js` 那份副本同一天同步了〕
      const wants = hasTrigger(skills, SK_TIDE)
        || hasTrigger(skills, SK_FREEZE)
        || hasTrigger(skills, SK_LOWTIDE) || hasTrigger(skills, SK_SWAP)
        || hasTrigger(skills, SK_PICK)
        // 挂在牌上的两件（窄口、满篓）得让这张留在堆上 ——
        // 所以「被钓走」对它们是真损失，不像下面那几件钓不钓到都发动
        || hasTrigger(skills, SK_NARROW) || hasTrigger(skills, SK_CREEL)
        // 动对方手牌、从牌库检索这几件，钓不钓到都照样发动 ——
        // 所以拿它们当饵是白赚一次效果
        || hasTrigger(skills, SK_PRESS) || hasTrigger(skills, SK_UNHOOK)
        || hasTrigger(skills, SK_SWAPCARD) || hasTrigger(skills, SK_TWIN)
        // 凝水 / 净水 / 抬水**压根不落堆**（叠到别的牌上去了），所以也
        // 谈不上钓 —— 它们换的是一次精确操作。拿它们当「饵」是唯一的用法，
        // 而且比别的饵更安全：牌出场了，对手连收都收不着
        || hasTrigger(skills, SK_CALM) || hasTrigger(skills, SK_CLEAN)
        || hasTrigger(skills, SK_RAISE)
        // 〔2026-10-16 从这个列表清掉了**九个死分支**：同花 / 连竿 /
        //   压邻 / 封色 / 分水 / 掏手 / 掏库 / 退潮 / 抄底 ——
        //   九件技能全在 10-14 ~ 10-15 删了。
        //
        //   它们留下一条还管事的判据：**「钓不钓到都照样发动」的技能，
        //   拿来当饵是白赚一次效果** —— 所以 AI 该优先拿它们下饵。
        //   那条现在由上面活着的几件撑着（压舱 / 摘钩 / 对换 / 同号
        //   动对方手牌和牌库，凝水那三件不落堆）〕
      if (wants && score <= fewest + 1) {
        score = score - 1.5
      }
      // 〔这儿原先还有一支「无点数的牌当饵格外安全」的 −1.0 折扣，
      //   列的是压邻 / 封色 / 掏手 / 掏库 / 退潮 / 抄底 —— **六件全删了**，
      //   所以整支清掉（2026-10-16）。
      //
      //   那条判据本身没错，而且现在有新的载体：**【寒流】无点数**
      //  （10-16 才在游戏侧补上）。要是哪天发现庄家不会拿寒流下饵，
      //   把它加回这儿就是 —— 它正是「落堆之后没人按点数钓得上它」那一类。
      //
      //   顺带：那段注释里「见底 / **干塘** / 撒网收得走 0 点牌」——
      //   干塘也死了（退潮一删它就跟着死），现在只剩见底和撒网。〕
      // 〔【抄底】那一支 2026-10-16 跟它的实现一起清掉。它是全表唯一一件
      //   「收益当场数得出来」的技能（掀几张就是几分，没有匹配、没有运气），
      //   所以庄家只需要一条判断：现在叠着几张。
      //
      //   留下的那条判据是**这个打分函数的通用写法**：一件技能的收益要是
      //   能从当前局面直接算出来，就在这儿按那个量加减分，别去估概率。
      //   权重取「几张起它该压过风险项」倒推（抄底当年取 0.8，
      //   正好是三张起压过下面沉底那条 +0.5×堆长）〕
      // **沉底空钩是最危险的下饵**：那张躺在堆底，
      // 谁匹配到它就通吃整堆。所以当饵的时候要躲开它
      if (hasTrigger(skills, SK_SINK)) {
        score = score + pile.value.length * 0.5
      }
      if (score < pickScore) {
        pickScore = score
        pick = i
      }
    }
    return pick >= 0 ? pick : randomFree()
  }

  // 没被冻住的里头随机挑一张。一张都没有就返回 -1（这回合它打不出牌）
  function randomFree() : number {
    const free : number[] = []
    for (let i = 0; i < foeHand.value.length; i++) {
      if (!isFrozen(foeHand.value[i])) {
        free.push(i)
      }
    }
    return free.length == 0 ? -1 : free[Math.floor(Math.random() * free.length)]
  }

  function newGame() {
    clearTimers()
    catching.value = false
    catchFrom.value = -1
    catchTo.value = -1
    flyOn.value = false
    catchSet.value = [] as number[]
    sweepSkills = []
    sweepNext = TAIL_EBB
    matchSkills = []
    matchSink = false
    flashMe.value = false
    flashFoe.value = false
    tidePending.value = false
    tideCards.value = [] as PlainCard[]
    tideMarks.value = [] as boolean[]
    swapPending.value = false
    freezePending.value = false
    // 【薪潮】的盲选待选位，开局清（照 freezePending）
    fuelPending.value = false
    fuelLeft.value = 0
    pilePick.value = -1
    pickStep.value = 0
    pickPending.value = false
    pickTops.value = [] as PlainCard[]
    // 分饵那三个一起清 —— 漏了的话重开一局时面板还挂着，
    // 而 canPlay 被 giftPending 挡住 → **整局动不了**（那是最坏的一类漏）
    giftPending.value = false
    giftTops.value = [] as PlainCard[]
    giftPicks.value = [] as number[]
    takeSkill.value = -1
    giveBack.value = -1
    twinPending.value = false
    twinCards.value = [] as PlainCard[]
    showLeft.value = false
    chipAt.value = -1
    pendingSkills = []
    held.value = [] as HeldEffect[]
    stacked.value = [] as Stacked[]
    lastPlayed = null
    firstNote = ''
    // 结冰那一族：豁免（playFor 每手也重设）和手冰表，开局都清
    iceBlindNow = false
    frostHand = [] as PlainCard[]
    // 【引火】预约的手牌火跟手冰表一起清（同一个理由：它按牌对象认身份，
    // 而新一局是新一副牌）
    burnHand = [] as PlainCard[]
    // 【推牌】的手牌标签和这一手待兑现的层数，开局都清。
    // surgePending 其实每手在 playFor 开头无条件重写，这儿清是为了
    // 「新一局不带着上一局的任何残留」那条（照 burnHand / frostHand）
    surgeHand = [] as PlainCard[]
    surgePending = 0
    againPending = false
    againUsed.value = false
    againWaiting.value = false
    // 角色和「打过几张」每局归零 —— 【稳钩】数的是「这一局前 N 张」
    myRole.value = -1
    foeRole.value = -1
    foeAt.value = 0
    sealedRank.value = ''
    myPlayed = 0
    foePlayed = 0
    // 牌库还没空过（见 TAIL_PLAYS）。**不重置的话第二局开局就直接收摊** ——
    // 上一局结束时它停在一个正数上，而 checkOver 读的是「现在的手数减它」
    tailFrom = -1
    // 沉底那个开关也归零。它保持状态是**一局之内**的事 ——
    // 跨局留着的话，你上一局开着它，这一局头一张牌就莫名其妙落到了堆底
    sinkOn.value = false
    // 【死水】废掉的那几张：一局一清。
    //
    // **这条非清不可** —— 它存的是牌对象的引用，而牌组是同一副、
    // 对象也是同一批（buildPlainDeck 每局重建，但【死水】是「本局」效果，
    // 跨局留着就成了「永久废牌」）。
    // 顺带把挑牌那两个状态也归零，免得上一局停在挑牌中途退出
    deadCards.value = [] as PlainCard[]
    // 【通配】贴过的那几张、以及伏流那个重入闸
    wildCards.value = [] as PlainCard[]
    flowPicked = false
    deadLeft.value = 0
    takeSkill.value = -1
    const data = loadDrawSave()
    save.value = data
    if (finalMode) {
      // 终局：**不读存档的关卡，也不读你平时的装备** ——
      // 这一局跟你攒了多少钱、打到第几关一点关系都没有。
      //
      // 两条路：
      //   带了 role 参数 —— 走**角色卡那套**（关卡页选的角色 + 嵌好的技能，
      //     见 kitFromRole）。庄家也摇一个角色，所以双方同一个结构，
      //     那一局比的是「这两套插法怎么互相咬」。
      //   没带 —— 老的随机满配（关卡页那颗「开启挑战」直接开打的入口）
      if (finalRole >= 0) {
        const mine = kitFromRole(finalRole, finalSlots)
        myLevels.value = mine.levels
        myLoadout.value = mine.loadout
        // **角色得记下来** —— 那件常驻特殊技能靠它现查（见 specialLevel）。
        // 漏了这一步的话配装是对的，可满篓、深钩那些一个都不生效
        myRole.value = mine.role
        // 庄家按难度摇：困难只摇覆盖面最大的角色、简单只嵌一半的槽
        const foe = rollRoleKit(finalDiff)
        foeLevels.value = foe.levels
        foeLoadout.value = foe.loadout
        level.value = finalLevel()
        foeRole.value = foe.role
      } else {
        // 不选角色就开打：**双方各摇一张角色卡**。
        //
        // 原先这条路走 rollFullKit（摇一套填满点数槽的配装，形状靠等级变化）。
        // 等级没了之后那个函数立不住，换成跟庄家同一条路 ——
        // 而且摇角色比摇等级的差别大得多：槽数、槽上印什么、带哪件常驻技
        // 全跟着变
        const mine = rollRoleKit(finalDiff)
        myLevels.value = mine.levels
        myLoadout.value = mine.loadout
        myRole.value = mine.role
        const foe = rollRoleKit(finalDiff)
        foeLevels.value = foe.levels
        foeLoadout.value = foe.loadout
        level.value = finalLevel()
        foeRole.value = foe.role
      }
    } else {
      // ---- 没选角色就别开局 ----
      //
      // 闯关的前提是**先有一张角色卡**（它给那几个印死标签的槽，
      // 而买技能必须嵌进槽）。没角色的话这一局能打，可商店里
      // 一件技能都买不动 —— 整轮就是个空壳，而且看不出原因。
      //
      // 正常路径走不到这儿（关卡页的 go 会先弹角色选择）。
      // 这是兜底，挡的是「结算框上就地重开」那类绕过关卡页的入口：
      // 宁可退回去选，也不要开一局注定废掉的。
      //
      // 摆在读关卡**之前** —— 后面那一串（摇庄家、落盘）都不该发生
      if (!hasRole(data)) {
        over.value = true
        outcome.value = OUT_NOROLE
        rewardText.value = '回关卡页选一张角色卡，再开这一关'
        message.value = '新一轮要先选角色 —— 它给你那几个槽，技能才有地方嵌。'
        return
      }
      if (ensureLives(data, maxLivesOf(difficultyOf(drawSaveSlot())))) {
        saveDraw(data)
      }
      // 打的永远是本轮现在这一关。整轮打通了（runLevel 超过 12）的档不该进到这里，
      // 关卡页会先让它重开一轮；万一进来了就从第 1 关打
      // 庄家怎么出牌、过关给多少，按这个存档选的难度来（见 levelForDiff）
      const base = levelForDiff(drawLevelById(data.runLevel > DRAW_RUN_LENGTH ? 1 : data.runLevel),
        difficultyOf(drawSaveSlot()))
      // ---- 庄家：角色由关号定死，标签读存档里摇定的那一份 ----
      //
      // 关卡表已经不配庄家了（那两个字段删了）—— 现在查 DRAW_FOE_ROLES。
      // 技能名单印在卡上（可学、商店会预告），标签是摇的（学不到头）。
      //
      // ensureFoeKit 是兜底：万一哪条路漏了摇就按关号补一次**并落盘** ——
      // 不落盘的话这一关每次进来都是新的一套，预告就成了假的
      if (ensureFoeKit(data)) {
        saveDraw(data)
      }
      const foeKit = foeKitOf(data, base.id)
      level.value = base
      foeLevels.value = foeKit.levels
      foeLoadout.value = foeKit.loadout
      // 存**关号**，不是 foeKit.role —— 那个字段在这条路上装的是关号 - 1，
      // 拿去查 DRAW_ROLES 会读到一张完全无关的玩家角色卡（见 foeAt 那段）
      // 这一关抽到的庄家卡号（按章节洗过的，见 draw-save 的 foeNumOf）
      foeAt.value = foeNumOf(data, base.id)
      // 【封竿】封的那个点数：从存档里摇定的那份标签上取（见 foeSealRank）。
      // 要在 foeAt 设好之后 —— 没带这件的关号一律返回空串
      sealedRank.value = foeSealRank(data, base.id)
      // ---- 玩家：角色 + 每个槽嵌了什么 ----
      //
      // 存档里只存这两样，装备现算（kitFromRole）。
      // **myRole 一定要设** —— 那件常驻特殊技靠它现查（见 specialLevel）。
      // 从前闯关这条路把它留在 -1，所以五件已实现的特殊技一个都不生效
      const mine = kitFromRole(data.role, data.slotSkills)
      myLevels.value = mine.levels
      myLoadout.value = mine.loadout
      myRole.value = mine.role
    }
    deck.value = buildPlainDeck()
    // ---- 【囤饵】：开局往牌库塞牌，**在算 rankTotal 之前** ----
    //
    // 顺序要紧：rankTotal 是「这一轮每个点数几张」，庄家的记牌
    //（outsideCount）全靠它。塞完再算，双方的账才对得上 ——
    // 先算的话庄家会一直以为 7 只有四张，而牌桌上有七张
    baitFor(false)
    baitFor(true)
    // ---- 凑成「发完牌之后牌库是偶数」，**在囤饵之后、算 rankTotal 之前** ----
    //
    // 两头都是硬性的，理由见 trimDeck 那段。最多剔 1 张。
    //
    // **返回值（剔了几张）现在没人读** —— 开局那句话不再报它（见下面那段：
    // 剔 1 张玩家无能为力，报它只是制造一个「我的牌被动过」的疑问）。
    // 调用本身当然不能删，它改的是 deck
    trimDeck()
    buildRankTotals(deck.value)
    // ---- 切牌定庄：翻牌库顶那张，红 = 庄家先手、黑 = 你先手 ----
    //
    // **排在 buildRankTotals 之后**：切出来那张进先手的手牌、仍在这一局里，
    // 所以它得算进 rankTotal（庄家的记牌靠那个底数）。
    //
    // 为什么按红黑不按点数奇偶：奇数点有 A/3/5/7/9/J/K 七个、偶数只有
    // 2/4/6/8/10/Q 六个 —— **28:24，偏 54%**。而这个机制的全部价值就在公平。
    //
    // 牌本身在下面发牌那段给先手（进手牌、而且**对手看得见**），
    // 所以这儿先从牌库拿掉。牌库空了（理论上走不到）就照旧庄家先手
    let cutCard : PlainCard | null = null
    if (deck.value.length > 0) {
      const rest = deck.value.slice(0)
      // 先接成 const 再赋给那个可空的变量 —— 下面读花色读的是 one，
      // 不靠「赋值之后它就非空了」那种收窄
      const one = rest.pop()!
      deck.value = rest
      cutCard = one
      firstByFoe = isRedSuit(one.suit)
    } else {
      firstByFoe = true
    }
    hand.value = []
    handSeen.value = []
    foeHand.value = []
    foeShown.value = []
    pile.value = []
    pileByFoe.value = []
    pileGuard.value = []
    pileVals.value = []
    pileSuit.value = []
    pileBurn.value = []
    goneRanks.value = []
    newIndex.value = -1
    myScore.value = 0
    foeScore.value = 0
    over.value = false
    rewardText.value = ''
    heartMax.value = 0
    heartBroken.value = false
    outcome.value = OUT_NONE
    // 开局双方各发满手牌，庄家先发、轮流来；**先手由切牌定**（见上面那段）。
    // 之后每个回合结束各自补足回这个数（见 passTurn）。
    //
    // **发几张走 handLimit，不写死 HAND_SIZE** —— 添手（庄家 +1）和
    // 掐口（玩家 −1）都该从起手就算上。写死的话这两条要等到第二回合
    // 补牌时才生效，而「起手就比对方少一张」正是掐口要你感觉到的东西
    const foeDeal = handLimit(true)
    const myDeal = handLimit(false)
    const deal = foeDeal > myDeal ? foeDeal : myDeal
    // ---- 切出来那张先给先手，**而且对手看得见** ----
    //
    // 它是公开翻出来的，所以标成「对方知道这张」—— 那是先手为「定庄」
    // 付的小代价（对「先手略优」的一点微调）。
    //
    // 两条路照摘钩 / 对换那两处的写法（手牌 concat + 标记 concat）：
    //   庄家先手 → foeShown 标 true，于是它那张在你眼里是明的（见 foeOpen）；
    //   你先手   → handSeen 标 true，于是你那张挂着「被看」角标（见 foeKnows）。
    // UI 两头都是现成的，不用加东西
    if (cutCard != null) {
      if (firstByFoe) {
        foeHand.value = foeHand.value.concat([cutCard!])
        foeShown.value = foeShown.value.concat([true])
      } else {
        hand.value = hand.value.concat([cutCard!])
        handSeen.value = handSeen.value.concat([true])
      }
    }
    // 发到各自的上限。**先手已经有切出来那张了**，所以判一下长度别发超 ——
    // 「庄家先发、交替」那个次序照旧（添手 / 掐口走 handLimit，起手就算上）
    for (let i = 0; i < deal; i++) {
      if (i < foeDeal && foeHand.value.length < foeDeal) {
        drawFor(true)
      }
      if (i < myDeal && hand.value.length < myDeal) {
        drawFor(false)
      }
    }
    // ---------- 【淤滩】：开局堆上就压着三张死牌 ----------
    //
    // 从牌库顶垫 3 张，**点数一律算 0**（见 pushPile 的 vals 参数）——
    // 而 0 点牌互相也不匹配（设计文档『点数的全局规则』），所以这三张是真正的死牌：
    // 普通钓牌一张都碰不到，只有 J 通吃、量水、见底那几条能端走。
    //
    // 为什么挂庄家名下（pushPile 传 true）：你钓这三张要走「钓对方的牌」
    // 那条路，于是稳钩之类的护饵规则对它们成立 —— 它们是庄家下的饵。
    //
    // 垫完**不重算 rankTotal**：那三张是从库里摸出来的，
    // 「这一轮每个点数几张」没变，只是位置从库里挪到了堆上。
    // 庄家的记牌（outsideCount）照旧对得上
    if (hasFoeSpecial('silt')) {
      for (let i = 0; i < SILT_COUNT && deck.value.length > 0; i++) {
        // **库顶是数组末尾**（见 drawFor 的 pop），所以摸一张是 pop 不是 shift。
        // 这一条踩过：按 deck[0] 取的话垫上来的是库底三张，
        // 而庄家的记牌和「外面还剩」那块面板算的是另一回事
        const rest = deck.value.slice(0)
        const one = rest.pop()!
        deck.value = rest
        // vals 传 [0]：这三张**点数一律算 0**。
        // 每张要给一份新数组 —— 五条并行数组各存自己那一份，
        // 共用同一个引用的话，谁改了点数（见底、点数卡）就全跟着变
        pushPile(one, true, GUARD_NONE, [0] as number[])
      }
    }
    // ---- 开局那句话：**只说别处看不到的** ----
    //
    // 2026-10-15 砍过一轮。原先它是六段：关号 + 关名 + 随机 + 对手名 +
    // 剔了几张 + 切牌 + 补几张。砍掉四段，依据是「这条信息在界面上
    // 有没有第二个出处」：
    //
    //   **关号 / 关名** —— 顶栏的 `levelTitle` 就是它；
    //   **对手名**     —— 庄家那一行第一个标签就是它（`ap-foe-role`）；
    //   **补足几张**   —— 手牌摆在那儿，数得出来；而且规则面板里有；
    //   **剔了几张**   —— 最多 1 张（凑牌库的奇偶），而玩家对此无能为力，
    //                     报它只是制造一个「我的牌被动过」的疑问。
    //
    //   **切牌 / 谁先手** —— **交给动画**（见 cutFly 那段）：那张牌会停在
    //                     屏幕中间、底下一行「黑 → 你先手」，比塞进这行字里
    //                     醒目得多。而且这行 message 第一手打完就被战况覆盖了，
    //                     本来也留不住。
    //
    // 于是只剩一段：**这一关庄家是不是随机出牌**。它不是技能，所以庄家那行
    // 标签里没有它，别处也看不到 —— 这是唯一一条非得用文字说的。
    // 不是随机关的话这行就是空的，状态行只剩 turnText（「你的回合 · 打出一张」），
    // 那是对的：没有新消息就不要占一行
    message.value = finalMode
      ? '终局 · 双方随机满配，一局定胜负。'
      : (level.value.random ? '这一关庄家随机出牌。' : '')
    // ---- 切牌有动画的话，**等它演完再开第一个回合** ----
    //
    // 不等的话：庄家先手时 startFoeTurn 排的是 FOE_DELAY_MS(600ms) 的表，
    // 而动画要 700+420ms —— 庄家会在那张牌还飞在半空时就打出第一张，
    // 两个动画叠在一起谁也看不清。
    //
    // 而且这一下不能用「把 FOE_DELAY 调长」来糊 —— 你先手时同样要等，
    // 不然你能在牌飞着的时候点手牌出牌
    if (cutCard != null) {
      startCutFly(cutCard!, firstByFoe)
    } else {
      beginFirstTurn()
    }
  }

  // ---------- 切牌动画：停在中间给人看清，再飞到该去的那一边 ----------
  //
  // 纯视觉（见 cutFly 那段的声明）：牌早就发进手牌了，这儿盖的是一张副本。
  // 所以**它失败了也只是没动画，对局照常**；而反过来，
  // 动画期间要锁住出牌（见 canPlay 读 cutPhase），不然你能抢在它落地前出牌
  function startCutFly(card : PlainCard, toFoe : boolean) {
    cutFly.value = card
    cutToFoe.value = toFoe
    cutPhase.value = 1
    cutTimer = setTimeout(() => {
      // 第二段：加上飞走那个 class，CSS transition 自己走完
      cutPhase.value = 2
      cutTimer = setTimeout(() => {
        cutPhase.value = 0
        cutFly.value = null
        cutTimer = -1
        beginFirstTurn()
      }, CUT_FLY_MS)
    }, CUT_HOLD_MS)
  }

  // 第一个回合。先手由切牌定（原先这段写死 startFoeTurn）。
  // startMyTurn 只在牌库空 / 手牌全冻时动 message，所以不会盖掉开局那句
  function beginFirstTurn() {
    if (firstByFoe) {
      startFoeTurn()
    } else {
      startMyTurn()
    }
  }

  // 终局模式的「关卡」：把摇出来的那套庄家配装塞进一个临时的关卡对象。
  //
  // 对局逻辑一路都在读 level.value.loadout / .levels（见 loadoutOf、chipsOf），
  // 给它造一个长得正常的关卡，比在那十几处各加一个 if 干净得多。
  // id 给 0 —— 真关卡从 1 起，0 一眼就看得出不是正经关卡
  // 原先这儿有个 withFoeKit（把庄家配装塞进关卡对象）。DrawLevel 没有
  // levels / loadout 了，庄家配装改放 foeLevels / foeLoadout，它跟着删

  // 终局的「关卡」：只管名字和打法。庄家配装在 foeLevels / foeLoadout 里
  function finalLevel() : DrawLevel {
    // 打法按难度来，规矩照闯关那套（见 draw-levels 的 levelForDiff）：
    //   简单 —— 随手出牌（钓得到也不挑）
    //   普通 / 困难 —— 记牌
    //
    // 终局没有关号，所以简单这一档是整局随机，不像闯关那样只前四关随机。
    // 困难跟普通在**打法**上一样 —— 它的狠处在配装（见 rollRoleKit）
    const easy = finalDiff == DIFF_EASY
    return {
      id: 0,
      chapter: '终局',
      name: easy ? '对决 · 简单' : (finalDiff == DIFF_HARD ? '对决 · 困难' : '对决'),
      smart: !easy,
      random: easy,
      reward: 0
    } as DrawLevel
  }

  // 进过商店了没。回到这一页时据此直接开下一关
  // （存档里的 runLevel 已经推进过了，重新开局就会读到）
  let shopped : boolean = false

  // 自动跳和手点都走这儿，只跳一次
  function goShop() {
    if (shopTimer >= 0) {
      clearTimeout(shopTimer)
      shopTimer = -1
    }
    if (shopped) {
      return
    }
    shopped = true
    uni.navigateTo({ url: '/pages/examples/blackjack/draw-skills' })
  }

  // 退出：能退就退，退不了直接跳回关卡页。
  //
  // 栈里只剩这一页时 navigateBack 是空操作，按了没反应 —— H5 热重载
  // 把栈冲掉、或者直接从地址栏开这一页都会这样。兜一道，
  // 按钮就永远是有反应的（排竿那边同一个毛病同一个解法）。
  //
  // 打到一半退出不算输：这一局压根没写存档，下次进来重新发牌、
  // 还是这一关。换句话说退出重进能换一副牌 —— 这跟排竿有意不锁
  // 发牌顺序是一个道理，那条路本来用系统返回键也走得通
  function goBack() {
    if (getCurrentPages().length > 1) {
      uni.navigateBack({})
      return
    }
    uni.redirectTo({ url: '/pages/examples/blackjack/draw-levels' })
  }

  onLoad((options : OnLoadOptions) => {
    const mode = options['mode']
    finalMode = mode != null && ('' + mode) == 'final'
    // role=角色下标 & slots=技能,技能,…（关卡页那套「选角色卡 + 嵌技能」传过来的）。
    // 老的终局入口不带这两个参数，那就照旧随机满配
    finalRole = -1
    finalSlots = []
    const role = options['role']
    if (finalMode && role != null && ('' + role) != '') {
      const ri = parseInt('' + role)
      finalRole = isNaN(ri) ? -1 : ri
    }
    const slots = options['slots']
    if (finalMode && slots != null && ('' + slots) != '') {
      const parts = ('' + slots).split(',')
      for (let i = 0; i < parts.length; i++) {
        const v = parseInt(parts[i])
        finalSlots.push(isNaN(v) ? -1 : v)
      }
    }
    // 难度。老的终局入口（那颗直接开打的按钮）不带它，那就按普通
    finalDiff = DIFF_NORMAL
    const diff = options['diff']
    if (finalMode && diff != null && ('' + diff) != '') {
      const d = parseInt('' + diff)
      if (!isNaN(d) && d >= DIFF_EASY && d <= DIFF_HARD) {
        finalDiff = d
      }
    }
    newGame()
  })

  // 从商店回来：赢了那一关进的商店，回来就直接开下一关（newGame 会读新存档，
  // 技能、牌组都是商店改过的）。
  // 其余情况只在还没开打（结算框开着）时刷新技能栏，对局进行中不动。
  // 终局模式用的是摇出来的那套，不能让存档里的盖掉
  onShow(() => {
    if (shopped && over.value && (outcome.value == OUT_WIN || outcome.value == OUT_RETRY)) {
      shopped = false
      // 商店的「开始下一关」已经清过 inShop；按系统返回键回来的没清，这儿兜一道
      const data = loadDrawSave()
      if (data.inShop) {
        data.inShop = false
        saveDraw(data)
      }
      newGame()
      return
    }
    if (over.value && !finalMode) {
      // 从商店回来：装备可能变了（买了技能嵌进槽），重算一遍。
      // 结算框还开着，所以只刷装备、不重开一局
      const data = loadDrawSave()
      const mine = kitFromRole(data.role, data.slotSkills)
      myLevels.value = mine.levels
      myLoadout.value = mine.loadout
      myRole.value = mine.role
    }
  })

  onUnload(() => {
    clearTimers()
  })
</script>

<style>
  .page {
    flex: 1;
    padding: 12px;
    background-color: #0b5d3b;
  }

  /* 记分时数字会放大 1.5 倍（.score-flash），view 默认 overflow: hidden
     会把超出格子的那截裁掉，所以这两层都放开 */
  .level-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 4px 6px 4px;
  }

  .level-text {
    color: #e8b23a;
    font-size: 14px;
    font-weight: bold;
  }

  .lives-text {
    color: #ff9e80;
    font-size: 13px;
    font-weight: bold;
  }

  /* 拍平成一行：每格「标签 数字」并排，整条栏只有一行高 */
  .score-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 12px;
    border-radius: 10px;
    background-color: #0e3a28;
    overflow: visible;
  }

  .score-cell {
    flex-direction: row;
    align-items: center;
    overflow: visible;
  }

  .score-label {
    color: #9fd9bd;
    font-size: 12px;
    margin-right: 6px;
  }

  .score-num {
    color: #e8b23a;
    font-size: 18px;
    font-weight: bold;
    transition-property: transform, color;
    transition-duration: 200ms;
  }

  .score-num-dim {
    color: #ffffff;
  }

  /* 牌库那一格点得动，得有个「这儿能点」的提示 */
  .score-hint {
    color: #e8b23a;
    font-size: 9px;
    margin-top: 1px;
  }

  /* ---------- 剩牌面板 ---------- */

  .left-box {
    width: 300px;
    padding: 14px;
    border-radius: 12px;
    background-color: #0e6b45;
  }

  .left-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .left-title {
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
  }

  .left-sub {
    color: #9fd9bd;
    font-size: 11px;
  }

  .left-note {
    color: #9fd9bd;
    font-size: 10px;
    line-height: 14px;
    margin-top: 4px;
  }

  .left-body {
    height: 300px;
    margin-top: 6px;
  }

  .left-row {
    flex-direction: row;
    align-items: center;
    height: 22px;
  }

  .left-rank {
    width: 26px;
    color: #cfe8d8;
    font-size: 12px;
    font-weight: bold;
  }

  /* 你技能覆盖的点数描亮 —— 覆盖面值不值钱，这一眼就看出来了 */
  .left-rank-mine {
    color: #e8b23a;
  }

  .left-num {
    width: 20px;
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    text-align: right;
  }

  .left-of {
    width: 30px;
    color: #7fbfa3;
    font-size: 10px;
    margin-left: 2px;
  }

  .left-bar {
    flex: 1;
    color: #9fd9bd;
    font-size: 12px;
    margin-left: 4px;
  }

  /* 外面一张不剩了：这个点数彻底死了，打出去钓不着、也没人钓得走 */
  .left-bar-none {
    color: #e06c75;
  }

  .left-legend {
    color: #7fbfa3;
    font-size: 10px;
    margin-top: 4px;
  }

  .left-close {
    color: #e8b23a;
    font-size: 13px;
    font-weight: bold;
    text-align: center;
    margin-top: 10px;
  }

  /* 记分那一下：数字放大、变亮，再缩回去。
     过渡写在 .score-num 上，放大和缩回两个方向都有动画 */
  .score-flash {
    color: #fff3c4;
    transform: scale(1.5);
  }

  /* 这儿原先有 .area-title（三个区块的标题：庄家手牌 N 张 / 牌堆 N 张 /
     你的手牌 N 张）。三个标题全去掉了 —— 牌就摆在那儿，张数在顶栏，
     标题只是把同一件事再说一遍。样式跟着删 */

  .foe-area {
    margin-top: 10px;
  }

  .foe-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    min-height: 48px;
  }

  .pile-area {
    flex: 1;
    margin-top: 10px;
  }

  .board {
    flex: 1;
    min-height: 68px;
    margin-top: 4px;
  }

  .board-row {
    flex-direction: row;
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .dim-tip {
    color: #8fc7ab;
    font-size: 11px;
  }

  /* 牌面照 relay.uvue 那套：46x64 白底 */
  .card {
    width: 46px;
    height: 64px;
    background-color: #ffffff;
    border-radius: 5px;
    margin-right: 6px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-style: solid;
    border-color: #ffffff;
  }

  .card-in-pile {
    margin-bottom: 6px;
  }

  /* 牌上那行效果名（照水、封色、冻结…）。
     压在牌底部、底色压暗一档 —— 它不该抢点数和花色的注意力，
     但得看得出「这张牌带着东西」。
     46px 宽塞得下两个字，两件效果（「照水·冻结」）会挤 ——
     那种情况很少，而且挤着也比看不见好 */
  .card-effect {
    position: absolute;
    bottom: 1px;
    left: 0;
    right: 0;
    text-align: center;
    color: #9ad7ff;
    background-color: rgba(16, 48, 70, 0.92);
    font-size: 9px;
    line-height: 12px;
  }

  .card-back {
    background-color: #123f6b;
    border-color: #0b2a48;
  }

  /* 谁下的饵：你打的描绿边，庄家打的描橙边 */
  .card-from-me {
    border-color: #7ce0a3;
  }

  .card-from-foe {
    border-color: #ff9e80;
  }

  /* 被护饵护着：描蓝边，压过谁下的饵 —— 「现在钓不到」比「谁下的」要紧 */
  .card-guarded {
    border-color: #7cc4ff;
    background-color: #eef7ff;
  }

  /* 带【保护】的牌：绿边 + 绿底。
     跟护饵那个蓝分开 —— 两样都是「不好钓」，可性质不同：
     护饵是「当不了匹配的起点」（扫到段里照样走），
     保护是「扛一次被拿走」。颜色不同才看得出该怎么对付它。

     **排在 .card-caught 前面** —— 同权重后来居上，
     不然被收走那一段的金边会被这条盖掉（这个坑踩过两次，
     见 .card-shifted / .card-red 那两处注释） */
  .card-warded {
    border-color: #4fd18b;
    background-color: #eafff3;
  }

  /* 【燃烧】：这张着了火，下一次野火把它收走。
     橙红一套 —— 跟护（蓝）、保护（绿）分得开。
     **排在 .card-warded 后面**：带保护的牌点不上火，所以两条不会同时在，
     可万一将来规则改了，火盖过保护是对的（它是更晚发生的那件事） */
  .card-burning {
    border-color: #ff8a3d;
    background-color: #fff0e6;
  }

  /* 【通配】：这张凑顺子时算任意点数。
     紫一套 —— 跟火（橙红）、护（蓝）、保护（绿）都分得开。
     **排在 .card-burning 后面**：两个标签可以同时在（燃烧不改点数、
     通配也不改点数，互不冲突），而通配是「这张牌算几点」那一类，
     跟卡面上的点数描色同源，所以让它盖在火色上面 */
  .card-wild {
    border-color: #a46bff;
    background-color: #f3ecff;
  }

  /* 【浊水】藏住的那几格：压暗 + 虚边。
     摆在 .card-burning 后面是有意的 —— 藏住的牌不该还亮着火的颜色
     （烧标已经被 v-if 关掉了，背景色也得跟着让位） */
  .card-murked {
    border-color: #9aa3ad;
    border-style: dashed;
    background-color: #e9edf1;
  }

  .card-burn-tag {
    position: absolute;
    top: 1px;
    right: 3px;
    color: #e0561f;
    font-size: 9px;
    font-weight: bold;
  }

  /* 【结冰】的角标。**跟「烧」占同一个位置**（右上）——
     **堆上**的冰和火互斥（相消），所以那两个永远不会同时出现。

     注意这条只对堆成立：**手牌上两个可以同时挂着**（引火贴火、
     藏凌贴冰，而相消是落堆那一下才判的），所以手牌的火角标
     另摆一行 —— 见 `.hand-burn-tag` */
  .card-frost-tag {
    position: absolute;
    top: 1px;
    right: 3px;
    color: #2f8fd0;
    font-size: 9px;
    font-weight: bold;
  }

  /* 【引火】预约在**手牌**上的火。
     跟「冰」错开一行（冰在 top:1，这个在 top:11）—— 手牌上两个可以
     同时挂着，重叠就看不出来有几个。而「同时挂着」本身是有用的信息：
     它表示这张落下去的时候冰火相消，两个都没 */
  .hand-burn-tag {
    position: absolute;
    top: 11px;
    right: 3px;
    color: #e0561f;
    font-size: 9px;
    font-weight: bold;
  }

  /* 【推牌】贴在**手牌**上的层数，而角标上报的是**它会涌几张**
     （层数 × 2）—— 玩家要的是那个后果，不是层数本身。

     摆在右边第三行（冰 top:1、火 top:11、这个 top:21）：三个在手牌上
     都可能同时挂着，重叠就数不出来有几个。而**它跟冰火不一样的地方
     正好要靠位置表达** —— 冰火落堆会相消，推牌跟那两个毫无关系。

     颜色取青（#1f8a7a）：跟冰的蓝、火的橙都分得开，而它不是那一族 */
  .hand-surge-tag {
    position: absolute;
    top: 21px;
    right: 3px;
    color: #1f8a7a;
    font-size: 9px;
    font-weight: bold;
  }

  /* ---- 叠放那两个角标摆在**左边一竖排** ----

     牌只有 46×64，而四个角标里已经占了两个：
       `.card-burn-tag`（烧）在右上；
       `.card-effect`（在场效果名）**占满整条下沿**（left:0 right:0）。
     所以下沿不能用 —— 摆那儿会被效果名那条深色底盖掉。
     左边一竖排是剩下唯一不撞的位置，而且「垫在下面」那个意思
     靠两个角标上下排也读得出来 */

  /* 盾：绿色，跟 .card-warded 那条绿边同色。左上（烧在右上） */
  .card-ward-tag {
    position: absolute;
    top: 1px;
    left: 3px;
    color: #2f9e68;
    font-size: 9px;
    font-weight: bold;
  }

  /* 底下压着几张（收走这一叠多值几分）：金色 —— 跟 .card-caught
     那个金底同色，因为它说的就是「收走它能拿多少」。
     摆在盾底下一行（top 12px），两个一起出现时上下排 */
  .card-stack-tag {
    position: absolute;
    top: 12px;
    left: 3px;
    color: #c8912a;
    font-size: 9px;
    font-weight: bold;
  }

  /* 被收走的那一段：金底金边、往上抬。必须排在上面几条描边后面，
     同权重后来居上，边框色才盖得住 */
  .card-caught {
    background-color: #fff3c4;
    border-color: #ffd54f;
    transform: translateY(-8px);
    transition-property: transform, opacity, background-color;
    transition-duration: 160ms;
  }

  /* 亮完之后往上飘、淡出。排在 .card-caught 后面才盖得住它的位移 */
  .card-flying {
    opacity: 0;
    transform: translateY(-40px);
    transition-duration: 200ms;
  }

  .card-small {
    width: 34px;
    height: 48px;
    margin-right: 4px;
    margin-bottom: 4px;
  }

  .card-back-art {
    border-width: 1px;
    border-style: solid;
    border-color: #3d7fc1;
    border-radius: 3px;
    align-items: center;
    justify-content: center;
    background-color: #17497a;
  }

  .card-back-art-small {
    width: 24px;
    height: 36px;
  }

  .card-back-gem {
    background-color: #3d7fc1;
    transform: rotate(45deg);
  }

  .card-back-gem-small {
    width: 11px;
    height: 11px;
  }

  .card-rank {
    color: #1a1a1a;
    font-size: 18px;
    font-weight: bold;
  }

  /* 庄家那排小牌：点数跟着小一号。必须排在 .card-rank 后面 */
  .card-rank-small {
    font-size: 14px;
  }

  .card-suit {
    color: #1a1a1a;
    font-size: 12px;
  }

  .card-red {
    color: #d33b3b;
  }

  /* 堆上这张现在算的点数跟牌面对不上了（顺色没点数、见底压过）。
     **必须排在 .card-red 后面** —— 两个类同权重，后来居上，
     不然红牌改过之后还是红的，一眼看不出它的点数已经不是牌面那个了 */
  .card-shifted {
    color: #7b1fa2;
  }

  /* 被冻住的牌：压暗 + 冷色边。它还在手里，只是打不出去 */
  .card-frozen {
    opacity: 0.5;
    border-color: #6fc3ff;
  }

  .card-frozen-tag {
    color: #6fc3ff;
    font-size: 9px;
    font-weight: bold;
  }

  /* 冻结等你挑的时候，庄家那排描一圈提示色。
     死水也用它，但只描**挑得动**的那几张（见 canPickFoe）——
     J 和已经废了的不描，那就是「这张点不动」的全部提示 */
  .card-pickable {
    border-color: #e8b23a;
    border-width: 2px;
  }

  /* 【死水】废掉的牌：压暗 + 一个「废」字角标。
     压暗是因为它还在手里、还得打出去（废牌打出去就清掉了），
     所以它不能看着像不存在，只能看着像没用 */
  .card-dead {
    opacity: 0.45;
  }

  .card-dead-tag {
    color: #8a8a8a;
    font-size: 9px;
    font-weight: bold;
  }

  /* 这张会触发的技能名，压在花色下面 */
  .card-skill {
    color: #1565c0;
    font-size: 9px;
  }

  /* 这儿原先有 .card-tally（【记谱】印在手牌右上角的「外面还剩几张」）。
     记谱删了，样式跟着删 —— 手牌的右上角因此空出来了 */

  /* 【活水】：牌库顶那两张，压在手牌正上方 */
  .live-text {
    color: #9ad7ff;
    font-size: 11px;
    margin-top: 6px;
    padding-left: 2px;
  }

  /* 【逆流】的开关 */
  .sink-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding-left: 2px;
  }

  .sink-btn {
    color: #9ad7ff;
    background-color: #103046;
    font-size: 11px;
    border-radius: 8px;
    padding: 2px 10px;
    margin-right: 8px;
  }

  /* 开着的时候反过来：蓝底深字 —— 这个状态要**一眼看得出**，
     不然你会忘了自己开着它，然后把牌打到堆底 */
  .sink-btn-on {
    color: #06243a;
    background-color: #9ad7ff;
    font-weight: bold;
  }

  .sink-note {
    color: #8fc7ab;
    font-size: 10px;
    flex: 1;
  }

  /* 点数卡贴上来的那几个点数。金的 —— 跟技能角标（蓝）分得开，
     而且它说的是「这张牌本身多了一条出路」，不是「会触发什么」 */
  .card-pip {
    color: #a9780b;
    font-size: 9px;
    font-weight: bold;
  }

  .card-seen {
    color: #d35400;
    font-size: 9px;
  }

  /* 这儿原先有 .message-box / .message-text（播报那一块，绿底白字、
     常驻占一行）。播报现在接在状态行里（见 .turn-msg）—— 它和
     「现在该谁」说的是同一件事的两头，分两块就要扫两眼 */

  .tide-box {
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    background-color: #123f6b;
  }

  .tide-text {
    color: #ffffff;
    font-size: 13px;
  }

  /* 择饵那块。沿用观潮那块的底色（都是「停下来等你选」的提示条），
     但底下多一排牌 —— 它要你点牌面，不是点钮 */
  .pick-deck {
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    background-color: #123f6b;
  }

  .pick-deck-row {
    flex-direction: row;
    margin-top: 6px;
  }

  .pick-deck-card {
    width: 42px;
    height: 38px;
    margin-right: 6px;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
    border-width: 2px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .pick-deck-text {
    color: #1a1a1a;
    font-size: 14px;
    font-weight: bold;
  }

  /* 分饵选中那张的角标：「给自己」/「给庄家」。
     两张的区别只靠**点的先后**，所以必须把它写在牌上 ——
     不写的话玩家点完两张就分不清哪张是给谁的了（而那正是这件技能的决策） */
  .gift-tag {
    color: #0b2b3d;
    font-size: 10px;
    font-weight: bold;
    margin-top: 2px;
  }

  /* 观潮标了「沉」的那张：压暗、换成冷色框，角上挂个「沉」字。
     要排在 .pick-deck-card 后面 —— 同权重后来居上 */
  .tide-card-sunk {
    /* 角标伸出卡外一点，view 默认 overflow: hidden 会把它裁掉 */
    overflow: visible;
    background-color: #9aa9b5;
    border-color: #5fb3ff;
  }

  .tide-card-mark {
    position: absolute;
    top: -8px;
    right: -8px;
    padding: 0 4px;
    border-radius: 6px;
    background-color: #5fb3ff;
    color: #0b2540;
    font-size: 11px;
    font-weight: bold;
  }

  .tide-actions {
    flex-direction: row;
    margin-top: 6px;
  }

  .tide-btn {
    height: 32px;
    padding: 0 14px;
    border-radius: 16px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: #e8b23a;
  }

  .tide-btn-plain {
    background-color: #0e3a28;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .tide-btn-text {
    color: #3b2a00;
    font-size: 13px;
    font-weight: bold;
  }

  .tide-btn-text-plain {
    color: #e8b23a;
  }

  /* 状态行：粗体那半是「现在该干什么」，后面接刚发生的事。
     原先是两块（message-box 在上、turn-bar 在下），合成一条 */
  .turn-bar {
    flex-direction: row;
    /* App 端不支持 baseline（只认 center / flex-start / flex-end / stretch） */
    align-items: flex-end;
    flex-wrap: wrap;
    margin-top: 8px;
    margin-bottom: 2px;
  }

  .turn-label {
    color: #e8b23a;
    font-size: 13px;
    font-weight: bold;
    margin-right: 6px;
  }

  .turn-msg {
    color: #cfeade;
    font-size: 11px;
    flex: 1;
  }

  /* 技能行：双方共用这一套 —— 左边一个「你 / 庄」，后面横着一排标签。
     从前你那侧是 skill-row + skill-chip（金色圆角、名字和覆盖面分两段），
     庄家那侧是 rule-row + rule-tag（橙字小标签），两套长得完全不一样。
     合成一套之后，两边的信息一眼就能对着看 —— 而「谁的」靠颜色分
     （你的金、庄家的橙，见 rule-tag-foe） */
  .rule-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 4px;
  }

  .rule-side {
    color: #9fd9bd;
    font-size: 11px;
    margin-right: 6px;
  }

  .rule-none {
    color: #5f8f79;
    font-size: 11px;
  }

  /* 特殊技（角色带的常驻）：描一个跟点数技能不同的色 ——
     它不是「打出某张牌才响」那一类，一直在生效 */
  .rule-tag-role {
    color: #9ad7ff;
    background-color: #103046;
  }

  /* ---------- 技能说明条 ---------- */
  /* 点技能标签才出现。左边一条竖线是**谁的**：你的金、庄家的橙 ——
     跟标签本身一个色系，所以点了哪个一眼对得上。
     整块点得动（= 收起），不用去找关闭按钮 */
  .chip-desc {
    margin-top: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    background-color: #0e3a28;
    border-left-width: 3px;
    border-left-style: solid;
    border-left-color: #e8b23a;
  }

  .chip-desc-foe {
    border-left-color: #ff9e80;
  }

  /* 头一行：谁的 · 管什么 · 叫什么 · 几级。比正文亮一档 */
  .chip-desc-head {
    color: #ffe9a8;
    font-size: 12px;
    font-weight: bold;
    line-height: 17px;
  }

  /* 正文：效果本身。行高给足 —— 那几件长的（洪水、见底）要换两三行 */
  .chip-desc-body {
    color: #ffffff;
    font-size: 12px;
    line-height: 18px;
    margin-top: 3px;
  }

  .rule-tag {
    color: #ff9e80;
    background-color: #0e3a28;
    font-size: 11px;
    border-radius: 8px;
    padding: 2px 8px;
    margin-right: 4px;
    margin-bottom: 2px;
  }

  /* 庄家挂的描成红的。
     同一件效果在你手里和在它手里是两回事（照水在你手里是情报、
     在它手里是威慑），所以**谁挂的**必须一眼分得出来。

     **必须排在 .rule-tag-on 前面** —— 两个类同权重，后来居上。
     摆在后面的话，点中一个庄家的效果，选中那层高亮会被它盖掉
     （跟 .card-shifted 和 .card-red 那次是同一个坑） */
  .rule-tag-foe {
    color: #ffd7d9;
    background-color: #5c2328;
  }

  .rule-tag-on {
    color: #3b2a00;
    background-color: #ff9e80;
  }

  /* ---------- 场上效果栏 ---------- */

  /* **高度写死**（照技能栏那条惯例）—— 挂上 / 解除的时候这一行
     要是忽高忽低，底下整块牌桌会上下跳 */
  .field-bar {
    flex-direction: row;
    align-items: center;
    height: 28px;
    margin-top: 6px;
  }

  /* 横向滚 —— 挂到四五条的时候（照水 + 封色 + 分水 + 冻结…）
     换行会把高度顶开 */
  .field-scroll {
    flex: 1;
    height: 28px;
  }

  /* 这儿原先有一串只给旧布局用的类，一起删了：
   *
   *   .field-label / .field-none —— 「场上效果 · 无」那一行废话。
   *     一件都没有的时候现在整行不占位（模板那边 v-if 掉了）。
   *   .skill-row / .skill-label / .skill-chip 那一整套（金色圆角 chip、
   *     名字和覆盖面分两段）—— 你那侧现在跟庄家那侧共用
   *     rule-row + rule-tag，两边长得一样才对着看得出来。
   *   .role-text / .role-text-foe —— 常驻技能那两行小字，
   *     现在是技能行里的**第一个标签**（rule-tag-role）。
   *
   * .area-title 留着没删：三个区块的标题（庄家手牌 N 张 / 牌堆 N 张 /
   * 你的手牌 N 张）都去掉了，但结算框那边还在用它 */

  .hand-area {
    margin-top: 8px;
    margin-bottom: 12px;
  }

  .hand-scroll {
    margin-top: 4px;
    height: 72px;
  }

  .hand-row {
    flex-direction: row;
    align-items: center;
    height: 72px;
  }

  /* 这回合刚摸到的那张：描绿边。排在 .card-hint 前面 ——
     刚摸到又正好能钓的，金边更要紧 */
  .card-new {
    border-color: #7ce0a3;
  }

  /* 这张打出去能钓到东西：描金边提示 */
  .card-hint {
    border-color: #e8b23a;
    background-color: #fffbe8;
  }

  /* 退出。描边不填色 —— 它是条退路，不该比手牌显眼 */
  .quit-btn {
    height: 38px;
    border-radius: 19px;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .quit-text {
    color: #e8b23a;
    font-size: 14px;
    font-weight: bold;
  }

  .mask {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
  }

  /* ---------- 开局切牌那一层 ---------- */

  /* 比 .mask 淡得多（0.3 对 0.6）：这一下**不是弹窗**，底下的牌桌
     还要看得见（你刚发到的四张手牌就在下面）。暗底只是为了让
     中间那张牌成为焦点 —— 开局时堆是空的，所以挡不住什么 */
  .cut-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.3);
  }

  /* 切出来那张：比桌上的牌大一倍多（46×64 → 96×134）。
     放大是因为它要被「读」—— 规则按红黑定先后手，花色的颜色
     得一眼看清，而 46px 宽的花色只有 12px 高。

     transition 的时长要跟 CUT_FLY_MS 对上（420ms）。**两个数分在
     两处是没办法的事**（CSS 里读不到 UTS 常量），所以那边的注释
     指回这儿 */
  .cut-card {
    width: 96px;
    height: 134px;
    margin-right: 0;
    border-color: #ffd54f;
    transition-property: transform, opacity;
    transition-duration: 420ms;
  }

  .cut-rank {
    font-size: 40px;
  }

  .cut-suit {
    font-size: 26px;
  }

  /* 飞向庄家（屏幕上方那排手牌）/ 飞向你（下方那排）。
     位移给得比实际距离短一点、同时淡出 —— 淡出之后它在哪已经
     不要紧了，而「一路飞到位」在不同屏高上会错位 */
  .cut-card-to-foe {
    opacity: 0;
    transform: translateY(-200px);
  }

  .cut-card-to-me {
    opacity: 0;
    transform: translateY(200px);
  }

  /* 「黑 → 你先手」那行字。摆在牌下面，跟牌一起淡掉 */
  .cut-note {
    margin-top: 14px;
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
    transition-property: opacity;
    transition-duration: 420ms;
  }

  .cut-note-gone {
    opacity: 0;
  }

  .result-box {
    width: 260px;
    padding: 20px;
    border-radius: 14px;
    align-items: center;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .result-title {
    color: #e8b23a;
    font-size: 26px;
    font-weight: bold;
  }

  .result-sub {
    color: #ffffff;
    font-size: 14px;
    margin-top: 6px;
  }

  .hearts {
    flex-direction: row;
    justify-content: center;
    margin-top: 10px;
    overflow: visible;
  }

  .heart {
    color: #ff5c5c;
    font-size: 26px;
    margin: 0 5px;
    transition-property: transform, opacity, color;
    transition-duration: 600ms;
  }

  /* 本来就没了的那几颗 */
  .heart-empty {
    color: #4a5a52;
  }

  /* 刚失去的那一颗：放大、变灰、淡掉 */
  .heart-lost {
    color: #4a5a52;
    opacity: 0.25;
    transform: scale(1.8);
  }

  .result-reward {
    color: #fff3c4;
    font-size: 13px;
    margin-top: 8px;
    text-align: center;
  }

  .result-skill {
    color: #7ce0a3;
    font-size: 13px;
    font-weight: bold;
    margin-top: 6px;
    text-align: center;
  }

  .result-btn {
    width: 180px;
    height: 42px;
    border-radius: 21px;
    margin-top: 14px;
    align-items: center;
    justify-content: center;
    background-color: #e8b23a;
  }

  .result-btn-plain {
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .result-btn-text {
    color: #3b2a00;
    font-size: 16px;
    font-weight: bold;
  }

  .result-btn-text-plain {
    color: #e8b23a;
  }

  .result-link {
    color: #e8b23a;
    font-size: 12px;
    margin-top: 12px;
  }
</style>
