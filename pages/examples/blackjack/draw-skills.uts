// ---- 【稳钩】删了（2026-10-13），**特殊技能表因此是满的** ----
//
// 原先这儿写着「它暂时没有角色带，留在表里当素材，哪天加新角色就是
// 现成的一件」。删掉它的理由在表里那块墓碑上 —— 要点是**删的是
// 「护饵」那一类效果**（「这张牌对方下一回合匹配不到」），不是这一件。
//
// 所以现在：**每一件特殊技都有角色带**，加新角色就得配新特殊技，
// 不能再从表里捡。那是好事 —— 「留着当素材」的条目每轮重读都要花
// 一次注意力去确认它还算不算数。

// 【囤饵】往牌库塞哪个点数：这个角色**第一个数字槽**上的第一个标签。
//
// 跳过花色槽 —— 「插入 4 张 ♥」没有意义，得指定具体是哪一张牌。
// 一个数字槽都没有的角色返回空串，那就塞不了（现在没有这种角色，
// 但将来真配了一个全花色槽的，这儿不会崩）
export function baitRankOf(role : number) : string {
  if (role < 0 || role >= DRAW_ROLES.length) {
    return ''
  }
  const slots = DRAW_ROLES[role].slots
  for (let i = 0; i < slots.length; i++) {
    const labels = slotLabels(slots[i])
    for (let j = 0; j < labels.length; j++) {
      if (!isSuitSlot(labels[j])) {
        return labels[j]
      }
    }
  }
  return ''
}

// 一个槽上印着哪几样（空格分隔）
export function slotLabels(slot : string) : string[] {
  const out : string[] = []
  const parts = slot.split(' ')
  for (let i = 0; i < parts.length; i++) {
    if (parts[i] != '') {
      out.push(parts[i])
    }
  }
  return out
}

// 一个槽盖住多少张牌：花色 12 张（J 只有通吃，不触发技能，所以不算）、点数 4 张
export function slotCover(slot : string) : number {
  const labels = slotLabels(slot)
  let n = 0
  for (let i = 0; i < labels.length; i++) {
    n = n + (isSuitSlot(labels[i]) ? 12 : 4)
  }
  return n
}

// 槽上印的是花色吗（不是就是数字）
export function isSuitSlot(label : string) : boolean {
  return SUITS.indexOf(label) >= 0
}

// 这个角色一共盖住多少张牌。选角色时显示它 ——
// 「覆盖面」是这八个角色唯一可比的那个数（槽数和槽的大小都不一样，
// 唯一能横着比的就是它）
export function roleCover(role : number) : number {
  if (role < 0 || role >= DRAW_ROLES.length) {
    return 0
  }
  const slots = DRAW_ROLES[role].slots
  let n = 0
  for (let i = 0; i < slots.length; i++) {
    n = n + slotCover(slots[i])
  }
  return n
}

// 这个角色有几个槽
export function roleSlotCount(role : number) : number {
  return role < 0 || role >= DRAW_ROLES.length ? 0 : DRAW_ROLES[role].slots.length
}

// ---------- 角色配装 → 现有的 loadout ----------
//
// **这是整套实体卡结构能零成本接进来的关键**：
//
//   「槽上印着 7，插了磁钩」 === 「rankOwner[7 那一格] = 磁钩」
//
// 两种结构表达的是同一件事，区别只在**谁决定哪一格** ——
// 摇位置那一版是随机的，角色卡这一版是印死的 + 你自己插。
//
// 所以对局页一个字都不用改：它照旧读 loadout.rankOwner 和 levels。
//
// slotSkills 跟角色的 slots 一一对应，-1 = 这个槽空着。
// 等级一律 0（**一卡一槽**，不占第二格）—— 点数技能的升级只扩覆盖面、
// 不改效果（设计文档『角色与槽』），而覆盖面现在是槽的属性，所以 0 级完全够用
export function kitFromRole(role : number, slotSkills : number[]) : DrawKit {
  if (role < 0 || role >= DRAW_ROLES.length) {
    return kitFromSlots([] as KitSlot[], -1)
  }
  const slots = DRAW_ROLES[role].slots
  const out : KitSlot[] = []
  for (let i = 0; i < slots.length && i < slotSkills.length; i++) {
    // **一个槽可能印着好几样**（'2 3'、'5 6 7'），那就每一样都落一格 ——
    // 嵌进这个槽的那件技能因此同时管那几个点数
    out.push({ skill: slotSkills[i], labels: slotLabels(slots[i]) } as KitSlot)
  }
  // 真正翻成 loadout 的活儿在 kitFromSlots 里，**跟庄家角色卡共用那一段** ——
  // 两边到了「哪件技能占哪几个标签」这一层就长得一样了
  return kitFromSlots(out, role)
}

// 给庄家摇一套：挑一个角色，再给每个槽插一件技能。
// **跟玩家同一个结构**（同样的槽、同样一卡一槽），所以终局那一局
// 比的是「这两套插法怎么互相咬」，而不是谁的数值大。
//
// ---- 难度在这儿管两件事 ----
//
//   **摇哪个角色**：困难只在覆盖面最大的那几个里摇（21 张那档），
//     别的难度全表随机。角色的覆盖面差着 12 ~ 21 张，
//     那是这套结构里现成的强弱轴，不用另造一个。
//
//     ---- 这把尺子有一个已知的反例：【夜钓客】 ----
//
//     它 12 张，全表最小，所以**困难档永远摇不到它** ——
//     可它带的【两色】是个放大器，配三件花色技能并不弱。
//     「覆盖面 = 强度」对另外八个角色成立，夜钓客是第一个不成立的。
//
//     没改成显式的强度字段，两条理由：一个反例不够重构；
//     而真要定那九个数得先有模拟器数据，而模拟器的配装层还没搬过来
//     （见 tools/md-sim/README 第 7 条）。记在这儿，等数据。
//   **嵌满几个槽**：简单只嵌一半（向上取整），其余空着 ——
//     空槽意味着那个点数打出来什么也不会发生，于是它少一截威胁面。
//
// 打法那条（记不记牌）不在这儿，在 levelForDiff ——
// 那是关卡的属性，跟配装分开。
//
// **diff 这儿写的是裸数字（0 简单 / 1 普通 / 2 困难）**：
// DIFF_* 那三个常量定在 draw-levels，而那边已经 import 了这边
//（关卡表要用 DRAW_SKILLS），反过来 import 就成环了。
// 跟 FULL_KIT_SKILLS 抄 MAX_OWNED_SKILLS 是同一种妥协
export function rollRoleKit(diff : number) : DrawKit {
  // 困难：只从覆盖面最大的那几个角色里摇
  let pool : number[] = []
  if (diff == 2) {
    let best = 0
    for (let i = 0; i < DRAW_ROLES.length; i++) {
      const c = roleCover(i)
      if (c > best) {
        best = c
      }
    }
    for (let i = 0; i < DRAW_ROLES.length; i++) {
      if (roleCover(i) >= best) {
        pool.push(i)
      }
    }
  }
  if (pool.length == 0) {
    for (let i = 0; i < DRAW_ROLES.length; i++) {
      pool.push(i)
    }
  }
  const role = pool[Math.floor(Math.random() * pool.length)]
  const count = roleSlotCount(role)
  // 简单：只嵌一半的槽（向上取整，至少一个）
  let fill = count
  if (diff == 0) {
    fill = Math.ceil(count / 2)
    if (fill < 1) {
      fill = 1
    }
  }
  const used : boolean[] = []
  for (let i = 0; i < DRAW_SKILLS.length; i++) {
    used.push(false)
  }
  const picks : number[] = []
  for (let i = 0; i < count; i++) {
    picks.push(i < fill ? rollSkill(used) : -1)
  }
  return kitFromRole(role, picks)
}

// 庄家摇到的那个角色（对局页要显示它的名字和那件常驻技能）。
// rollRoleKit 把角色摇在里头了，所以这儿单独再摇一次会对不上 ——
// 真正要用的时候改成返回一个带 role 的结构，现在终局只显示配装，先不动

export function roleIndexOf(key : string) : number {
  for (let i = 0; i < DRAW_ROLES.length; i++) {
    if (DRAW_ROLES[i].key == key) {
      return i
    }
  }
  return -1
}

// 角色解锁：跨轮的，和 best 同一层（输了不清）。
// 门槛是「最远打到第几关」，0 表示开局就有。
//
// **这是个按下标对齐 DRAW_ROLES 的平行数组** —— 加角色必须同时在这儿
// 加一格，不然那个新角色永远锁着（roleUnlocked 越界返回 false）。
// 下标顺序〔2026-10-23 重排：删【深海钓手】之后后面全体前移一格〕：
//   0 背篓渔夫  1 江口闸官  2 逆流船夫  3 镜湖占卜师  4 鱼塘老板
//   5 夜钓客    6 赌船荷官  7 填河工    8 开河工     9 串钩手   10 桃汛客
//
// 〔2026-10-20 那一版的顺序留个底，因为下面好几段注释按它写的：
//   0 背篓渔夫 1 江口闸官 2 逆流船夫 3 镜湖占卜师 **4 深海钓手** 5 鱼塘老板
//   6 夜钓客 7 赌船荷官 8 填河工 9 开河工 10 串钩手 11 桃汛客〕
//
// ⚠ **下标变了不影响存档** —— 存的是 `DRAW_ROLES[].key` 不是下标
//（`draw-save.uts` 的「md10 把这条规矩同样用在角色上」那段），
//   而 `roleIndexOf('deepline')` 现在返回 −1，正好等于「这一轮还没选角色」
//
// 〔2026-10-16 两处改动，都是删角色的连带〕
//
//   **少了两格** —— 潮汐观测员（原下标 1）、候潮渔翁（原下标 8）删了。
//   **多了一格** —— 填河工原先**根本没有格**（删听浪那次漏补），
//     于是它一直被 roleUnlocked 的越界闸挡着，谁也解不开。
//     平行数组这个毛病连着犯了两次，所以现在有了 refs.js 的长度检查。
//
// 门槛现在是 2/1/1/7（开局两个、第 6 关一个、第 9 关一个、通关七个）。
// 〔2026-10-20 更新：通关那一档从 4 涨到 7 —— 开河工、串钩手、桃汛客
//   陆续进来。七个挤在最高档偏多了，**下一次加角色前先重排这一档**〕
// 〔2026-10-23 更新：第 9 关那一档从 2 掉到 1 —— 删【深海钓手】的连带，
//   那一档现在只剩镜湖占卜师一个。**一档只有一个角色等于没得选**，
//   跟上面「删潮汐观测员之后开局只剩一个」是同一个毛病，
//   区别只在这一档不是开局档所以没那么要命。下次加角色优先补这一格〕
//
// **江口闸官从 6 提到 0** —— 不是手松，是删潮汐观测员的连带：
// 它原先和背篓渔夫同在 0 档，删了之后开局只剩一个角色，选角界面就没有选择了。
// 补谁进来有讲究，补的是**对照组**：背篓渔夫两个连号槽（泛用、组合少、每槽强），
// 江口闸官四个小槽（专精、组合多、单件少响）—— 正好是上面「专精 vs 泛用」
// 那条尺子的两端。开局就让玩家在这两种构筑之间选一次，比给两个同形状的好。
//
// 通关那一档是**进阶角色**：各自要求你懂一套构筑
//（改牌库、花色路线、21 点那条线、堆的清场节奏），所以挤在最高档是对的，不是凑数。
//
// **赌船荷官排在通关那一档**是有意的：归十把一个点数槽撑成花色槽那么宽，
// 而「哪个槽该插什么」要先懂槽这回事才玩得动。
// 开局就给的话新手只会看见「一个 10 槽」，看不见它背后那 12 张牌
// ⚠ **加角色必须同时加这一格** —— 它是平行数组，而 `roleUnlocked` 对
// 越界返回 false，所以漏加的后果是**那个角色永远锁着、而且不报错**。
//
// 末尾那个 99 是【开河工】（2026-10-16 加）：它按文档自己的分档属于
// 「通关那一档」—— 那一档的定义里就写着「堆的清场节奏」，
// 而逆涌正是那条线（填河工也在这一档，两张是一对）
//
// 〔2026-10-20 加第 11 格：【串钩手】，也是 99。理由跟赌船荷官同一条 ——
//   它要你先懂「槽」这回事（它的卖点正是把三个槽并成一个）。
//   而且闯关实测它**普通档只值 +2.1 点**（窄口 +9.0）：
//   收益 = 多触发的件次，槽空着就是零。早期给它等于给一张白卡〕
//
// 〔2026-10-20 加第 12 格：【桃汛客】，也是 99。两条理由 ——
//   它的满配总值 23.69 是现行最高（区间 13.17~23.37，压在上沿），
//   而且它要你先懂花色槽和重叠格（跟赌船荷官、串钩手同一条）〕
//
// 〔2026-10-23 去掉第 5 格（原下标 4 =【深海钓手】，门槛 9）——
//   角色删了，平行数组跟着删，后面十个全体前移一格。
//   长度从 12 掉到 11，`refs.js` 的长度检查会盯住它跟 DRAW_ROLES 对齐〕
export const ROLE_UNLOCK : number[] = [0, 0, 6, 9, 99, 99, 99, 99, 99, 99, 99]
// 通关一次才解锁的那两个，门槛写成这个数（关卡总共 12 关，所以 99 等于「得通关」）
export const ROLE_UNLOCK_CLEAR : number = 99

// 这个角色解锁了吗。best 是最远纪录，cleared 是通关过没有
export function roleUnlocked(index : number, best : number, cleared : boolean) : boolean {
  // 两个长度都要查 —— ROLE_UNLOCK 是平行数组，漏加一格的话
  // 这儿读到的是 undefined，而拿它跟 best 比大小在 UTS 里不会报错，
  // 只会让那个角色的门槛变成一个说不清的值。锁着比那个好
  if (index < 0 || index >= DRAW_ROLES.length || index >= ROLE_UNLOCK.length) {
    return false
  }
  const need = ROLE_UNLOCK[index]
  if (need == ROLE_UNLOCK_CLEAR) {
    return cleared
  }
  return best >= need
}

// 这儿原先有个 luckySlots（角色的幸运数字在点数槽里是第几格），
// 给「摇位置时优先落在幸运格」那套用的。
//
// 实体卡那一版把它整个替掉了：**槽上印着数字**，所以不存在「优先落在哪儿」——
// 技能就插在那个数字上。幸运数字这个概念因此没了，lucky 字段也改成了 slots。
//
// 闯关也换过去了，所以 rollLuckyCell / fillRank / rollPlace / rollExpand
// 那一整套「摇位置」连同 lucky 参数全删了 —— 两边现在都走 kitFromRole /
// kitFromSlots，位置一律是槽上印的。
//
// ROLE_UNLOCK 上面那几行因此是**现在唯一还在用的旧字段**：
// 选角色是闯关的第一步（见 draw-levels.uvue 的 go），得有门槛才有递进

function filled(count : number, value : number) : number[] {
  const list : number[] = []
  for (let i = 0; i < count; i++) {
    list.push(value)
  }
  return list
}

export function emptyLoadout() : DrawLoadout {
  return {
    rankOwner: filled(SKILL_RANKS.length, -1),
    suitOwner: filled(SUIT_COUNT, -1)
  }
}

export function cloneLoadout(lo : DrawLoadout) : DrawLoadout {
  return {
    rankOwner: lo.rankOwner.slice(0),
    suitOwner: lo.suitOwner.slice(0)
  }
}

// ================= 墓碑：旧模型（等级 + 摇位置 + 槽容量）=================
//
// 这儿原先是一整套「技能自带覆盖面，而覆盖面是摇出来的」：
//
//   rankSizeOf   —— 一个技能占几格 = 等级 + 1
//   fillRank     —— 把它补到该占的格数，位置随机
//   rollPlace    —— 新拿到的技能摇个位置
//   rollLuckyCell—— 优先摇角色的幸运格
//   hasRankRoom  —— 槽里还塞得下吗
//   canUpgrade   —— 升级要「等级没满 + 槽里有空格」
//   rollExpand   —— 升级时多摇几格
//   washSkill    —— 【洗点】把位置重摇一遍
//   rollKitFor   —— 庄家按「覆盖面预算」摇配装
//   levelText / investedOf 的等级部分
//
// **整套删掉**，因为角色卡把它的前提抽走了：
//
//   槽上**印死标签**，技能插进去就管那个标签 —— 技能本身不带覆盖面。
//
// 于是「占几格」没有意义（一槽一技能）、「摇位置」没有意义（位置是印的）、
// 「升级」没有东西可升（覆盖面由槽定、而特殊技不可升级）。
// 跟着删的还有商店那三件道具（砺钩、洗点、加权）和名额上限 ——
// **槽数本身就是上限**。
//
// 这一下把「攒钱把磁钩升满」那道算术题换成了「这件技能配哪个数字」
// 那道组合题。一轮之内没有数值成长，只有结构选择。
//
// 现在只剩一条路：kitFromRole（玩家，槽和标签都印死、你选插什么）
// 和 kitFromFoeRole（庄家，名单印死、标签摇）。

function countOf(owner : number[], skill : number) : number {
  let n = 0
  for (let i = 0; i < owner.length; i++) {
    if (owner[i] == skill) {
      n = n + 1
    }
  }
  return n
}

function usedOf(owner : number[]) : number {
  let n = 0
  for (let i = 0; i < owner.length; i++) {
    if (owner[i] >= 0) {
      n = n + 1
    }
  }
  return n
}

export function rankUsed(lo : DrawLoadout) : number {
  return usedOf(lo.rankOwner)
}

// 这个技能装上了吗。
//
// 从前这儿是 slotOf（回答「装在花色槽还是点数槽」）。花色槽砍掉之后
// 只剩一个槽，所以问题退化成「装了没有」—— 一个 boolean 就够，
// SLOT_* 那三个常量和 slotName、canPlaceIn、rollSlotFor 跟着全删
export function isEquipped(lo : DrawLoadout, skill : number) : boolean {
  return countOf(lo.rankOwner, skill) > 0 || countOf(lo.suitOwner, skill) > 0
}

function clearSkill(owner : number[], skill : number) {
  for (let i = 0; i < owner.length; i++) {
    if (owner[i] == skill) {
      owner[i] = -1
    }
  }
}

// 从一排格子里随机挑一个空的。全满了返回 -1。
//
// 玩家侧**没人用它了**（槽上的标签是印死的）。只剩庄家：
// 它的技能名单印死、而标签是摇的（见 rollFoeSlots）
function rollFreeCell(owner : number[]) : number {
  const pool : number[] = []
  for (let i = 0; i < owner.length; i++) {
    if (owner[i] < 0) {
      pool.push(i)
    }
  }
  return pool.length == 0 ? -1 : pool[Math.floor(Math.random() * pool.length)]
}

// ---------- 墓碑：幸运数字 ----------
//
// 原先这儿有个 rollLuckyCell：角色带两个固定的幸运数字，摇格子时优先落那儿。
//
// 它是「摇位置」那套的补丁 —— 给纯随机的位置加一个确定的锚，
// 好让牌组改造有明确目标。角色卡把槽上的标签**直接印死**之后，
// 整个槽就是锚了，不需要额外一层「幸运格」。
//
// 实体卡那次倒推（设计文档『技能』那一章）连锁消掉的东西里，这是一件

// ---------- 墓碑：三代「技能装在哪儿」 ----------
//
// 这个问题被回答过三次，每一次都把上一次的一整套实现消掉：
//
// 一代「买之前就定好进哪个槽」—— rollSlotFor（上货时摇花色槽还是
//   点数槽）、slotName、canPlaceIn、placeInSlot、suitRoomFor、fillSuit。
//   **花色槽砍掉**那次全没了：只剩一个点数槽，不存在「进哪个槽」。
//
// 二代「玩家在商店里手动摆」—— assignSuit、assignRank（点格子放进去
//   或撤下来）、normalizeLoadout（升降级之后整理覆盖面）。
//   改成**摇位置**那次全没了：位置在拿到和升级的那一刻摇定，
//   不存在「摆」，也不存在「对不齐的中间状态」要整理。
//
// 三代「摇位置」—— hasRankRoom、fillRank、rollPlace、rollLuckyCell、
//   rollExpand、washSkill。**角色卡**那次全没了：槽上印死标签，
//   所以没有位置可摇，连「幸运格」那个锚（rollLuckyCell）都不需要了 ——
//   整个槽就是锚。
//
// 四代就是现在：kitFromSlots 按角色卡的槽把技能摊进 loadout，一步到位。
// 留着这块墓碑是因为这条路走了三回，而每一回的毛病都在下一代的
// 设计里有回声（见设计文档『组合技』和『技能』那一章）

export function rankSlotIndex(rank : string) : number {
  for (let i = 0; i < SKILL_RANKS.length; i++) {
    if (SKILL_RANKS[i] == rank) {
      return i
    }
  }
  return -1
}

// 打出这张牌会触发哪几个技能。
//
// ---- 这儿**最多两个**：花色槽一个 + 点数槽一个 ----
//
// 原先这段注释写着「花色槽砍掉之后最多只有一个」，连带宣布
// 设计文档那节「重叠格组合技」整节作废。**那是过时的** ——
// 它写在「花色槽刚砍掉」那个时期，而**角色卡后来又把花色槽印回来了**
//（见 DRAW_ROLES：有两张卡印着 ♥ / ♣）。
//
// 所以重叠格还在：带花色槽的角色，它那门花色和它的点数槽有交集，
// 交集上的那张牌同时触发两件技能 —— 词表里的【双触发】。
//
// 〔原先这儿举的例子是「组合技【干塘】（退潮 × 见底，见 ebbTideFor）
//   就是靠这个触发的 —— 它已经实现并且在跑」。**三句全过期了**：
//   退潮 2026-10-14 删，干塘跟着死，`ebbTideFor` 10-16 清掉。
//
//   连带一件要分清的事：**「两件技能撞在一张牌上」和「它们合成第三种
//   效果」是两回事。** 前者（重叠格 / 双触发）还在，而且是配装的一条
//   构筑线；后者**现在零实例**，词条因此改名成【双触发】、换了定义。
//   再想做「合成第三种效果」要先想清楚它**没有 key、不在任何表里** ——
//   删掉任一组成件它就静默死掉，`refs.js` 第 8 项是专为这个坑加的〕
//
// 技能联动现在有两条路（原先写三条，【连竿】那条 2026-10-14 删了）：
//   **重叠格** —— 一张牌触发两件（只有带花色槽的角色有）；
//   **角色的常驻技能 × 点数技能** —— 角色整轮固定，所以你会围着它
//     构筑点数技能，而不是祈祷两件技能撞在同一张牌上。
//     **这是现在主要的那条** —— 重叠格要靠角色正好带花色槽
export function triggersOf(lo : DrawLoadout, suit : string, rank : string) : number[] {
  const list : number[] = []
  // **J 只有通吃**：它不触发任何技能，花色槽也不收它。
  // 点数槽本来就不收 J（SKILL_RANKS 里没有），这儿把花色槽那条路也堵上
  if (rank == 'J') {
    return list
  }
  // 花色槽先 —— 角色卡上印花色的那几格（见 DRAW_ROLES）
  const s = SUITS.indexOf(suit)
  if (s >= 0 && lo.suitOwner[s] >= 0) {
    list.push(lo.suitOwner[s])
  }
  const r = rankSlotIndex(rank)
  // 同一个技能插了花色槽又插了点数槽的话只算一次
  if (r >= 0 && lo.rankOwner[r] >= 0 && list.indexOf(lo.rankOwner[r]) < 0) {
    list.push(lo.rankOwner[r])
  }
  return list
}

// 【串钩】：这张牌命中了某个**被占**的点数槽 → 其余点数槽那几件也响。
// 就地往 `out` 里追加（`triggersOf` 刚返回的那个数组）。
//
// ---- 为什么它不写在 `triggersOf` 里 ----
//
// `triggersOf` 只拿得到配装，而「这一侧带没带串钩」要问角色 ——
// 那是 `hasSpecial(byFoe, …)`，只有 ap-fishing 的 `skillsOf` 知道。
// 拆成两个函数还有个好处：`triggersOf` 的签名不用动，
// 模拟器那边的手写副本因此只要跟着加一个同名函数就行。
//
// ---- 追加顺序 ----
//
// 按 rankOwner 的下标（= SKILL_RANKS 的顺序），**确定性的**。
// 技能的执行次序读的就是这个数组，所以它不能随手变
export function addRankLink(lo : DrawLoadout, rank : string, out : number[]) : number[] {
  // J 只有通吃，照 triggersOf 开头那道闸
  if (rank == 'J') {
    return out
  }
  const r = rankSlotIndex(rank)
  // **这道闸就是词条里「其他点数槽的**点数牌**」那半句** ——
  // 漏了它就成了「任何点数牌触发所有技能」，那时候槽这个概念不存在了
  if (r < 0 || lo.rankOwner[r] < 0) {
    return out
  }
  for (let i = 0; i < lo.rankOwner.length; i++) {
    const o = lo.rankOwner[i]
    if (o >= 0 && out.indexOf(o) < 0) {
      out.push(o)
    }
  }
  return out
}

// 【红钩】：打出的是红桃 → **所有**槽上那几件也响。
// 跟 addRankLink 一样就地往 `out` 里追加，一样不写进 `triggersOf`
//（那个函数拿不到「这一侧带没带」，理由见 addRankLink 上面那段）。
//
// ---- 它跟 addRankLink 的三处差别 ----
//
//   认 `suit` 不认 `rank` —— 所以被【死水】置 0 的 ♥ 照旧万用（有意的）。
//   **不要求先命中某个槽** —— 串钩那道闸是「得先是点数槽的牌」，
//     而这儿「是 ♥」本身就是钥匙，♥ 这个条件就是闸。
//   追加的是**所有**槽（点数 + 花色），不只点数槽。
//
// ---- 追加顺序 ----
//
// `rankOwner` 下标序（= SKILL_RANKS 顺序）在前、`suitOwner` 在后，
// **确定性的**。技能的执行次序读的就是这个数组，所以它不能随手变
export function addHeartWild(lo : DrawLoadout, suit : string, rank : string, out : number[]) : number[] {
  // J 只有通吃，照 triggersOf 开头那道闸。
  // **漏了这一行覆盖面就从 12 张变 13 张**，而那个数是错的
  if (rank == 'J') {
    return out
  }
  if (suit != '♥') {
    return out
  }
  for (let i = 0; i < lo.rankOwner.length; i++) {
    const o = lo.rankOwner[i]
    // `>= 0` 守着空槽 —— 空槽发不出技能（收益 = 多触发的件次）
    if (o >= 0 && out.indexOf(o) < 0) {
      out.push(o)
    }
  }
  for (let i = 0; i < lo.suitOwner.length; i++) {
    const o = lo.suitOwner[i]
    if (o >= 0 && out.indexOf(o) < 0) {
      out.push(o)
    }
  }
  return out
}

export function hasTrigger(list : number[], skill : number) : boolean {
  return list.indexOf(skill) >= 0
}

// 这个技能现在管着什么，写成「♥ 5 7」这样（花色排前面）
export function coverageText(lo : DrawLoadout, skill : number) : string {
  let text = ''
  for (let s = 0; s < lo.suitOwner.length; s++) {
    if (lo.suitOwner[s] == skill) {
      text = text + (text == '' ? '' : ' ') + SUITS[s]
    }
  }
  for (let r = 0; r < lo.rankOwner.length; r++) {
    if (lo.rankOwner[r] == skill) {
      text = text + (text == '' ? '' : ' ') + SKILL_RANKS[r]
    }
  }
  return text
}

// 覆盖面，但**只报个数、不报是哪几个**。
//
// 商店预告下一关庄家时走这条（见 draw-skills.uvue 的 foePreview）。
//
// 为什么藏着：预告要解决的是「买的时候不知道下一关什么题」，
// 可**全公开就把牌桌上的推理删掉了** —— 点数是钓牌判定那条轴，
// 知道了具体哪几个点数，你就能用弃饵和推点数把它那几个点数从
// 牌组里抽干，一关一关做成作业。
//
// 花色槽在的时候这儿是「花色公开、点数藏着」（花色安全，因为你改不了
// 牌的花色）。现在没花色槽了，所以只剩个数
export function coverageHint(lo : DrawLoadout, skill : number) : string {
  let ranks = 0
  for (let r = 0; r < lo.rankOwner.length; r++) {
    if (lo.rankOwner[r] == skill) {
      ranks = ranks + 1
    }
  }
  // `'' +` 打头照 cards.uts 的 faceOf 那条惯例（拼串别用 .toString()）
  return ranks > 0 ? '' + ranks + ' 个点数（不公开）' : '未装'
}

// ---------- 终局模式：随机摇一套满配 ----------
//
// 点数槽的容量**用满**（6 格），技能和等级随机摇。
//
// 摇的不是「强到什么程度」—— 容量满了就是满了。
// 摇的是**形状**：一个 2 级技能吃掉半个点数槽，和三个初始技能分着占，
// 打起来完全是两回事。
//
// 这就是终局模式的全部内容：双方都顶配、一局定胜负，所以那一局的题目
// 是「这两套配装怎么互相咬」，而不是「我攒够钱了没有」
export type DrawKit = {
  levels : number[]
  loadout : DrawLoadout
  // 哪个角色（DRAW_ROLES 的下标），-1 = 没角色。
  //
  // 闯关模式和老的终局满配都没有角色，所以是 -1；
  // 实体卡那一版（kitFromRole / rollRoleKit）会填上它 ——
  // 对局页要靠它显示「对面是谁、带着什么常驻技能」
  role : number
}

// 从还没用过的技能里随机挑一个。挑不出来返回 -1。
// 挑中的当场标记用掉 —— 同一个技能不该在点数槽里占两段互不相连的格子。
//
// 原先有个 kindWant 参数（只挑 KIND_ANY 的，给花色格用）。
// 花色槽砍掉之后没这回事了
function rollSkill(used : boolean[]) : number {
  const pool : number[] = []
  for (let i = 0; i < DRAW_SKILLS.length; i++) {
    if (!used[i]) {
      pool.push(i)
    }
  }
  if (pool.length == 0) {
    return -1
  }
  const k = pool[Math.floor(Math.random() * pool.length)]
  used[k] = true
  return k
}

// 从 0..total-1 里随机挑 want 个下标。Fisher-Yates 只洗前 want 个 ——
// 挑出来的顺序也是乱的，所以技能占的那几个点数不会总是连着
// **导出了**（2026-10-14）—— 实战模式要「48 件技能里随机取 8 件不重复」，
// 而这儿就是现成的部分 Fisher-Yates。再写第二份洗牌，两份以后必然分叉
export function rollSpots(total : number, want : number) : number[] {
  const all : number[] = []
  for (let i = 0; i < total; i++) {
    all.push(i)
  }
  const out : number[] = []
  for (let i = 0; i < want && i < total; i++) {
    const at = i + Math.floor(Math.random() * (all.length - i))
    const one = all[at]
    all[at] = all[i]
    all[i] = one
    out.push(one)
  }
  return out
}

// 原先这儿有个 FULL_KIT_SKILLS = 4（终局一套最多摇几个技能，
// 跟 MAX_OWNED_SKILLS 对齐的一份手抄常量）。
//
// 角色卡之后**槽数本身就是上限** —— 一卡一槽，角色有几个槽就带几件技能。
// 那个「名额」概念连带 MAX_OWNED_SKILLS 一起没了，所以这儿也不用抄了

// 这儿原先有个 kitFromLevels：终局「自定义技能」用的 —— 带哪几个、
// 几级由你定，位置照旧是摇的。
//
// 它被**角色卡那套**（kitFromRole）替掉了，理由是**约束才有题**：
// 自定义那边是在一张全表上自由勾选 + 调等级，于是只有一个最优解
//（对着静态表算半天）；角色卡那边是「几个印死的槽，哪件技能配哪个数字」,
// 那是一道组合题 —— 磁钩插在连号的槽上，它的 +1 能钓到自己的下一个槽；
// 插在散号上那条链就断了。
//
// 顺带一句：它调的 rollPlace 已经多了个 lucky 参数，留着也编译不过

// ---------- 覆盖面的尺子 ----------
//
// 一个点数标签 = 4 张牌，一个花色标签 = 13 张。
// 「这套配装盖住多少张」是双方唯一可比的那个数（见 roleCover / foeCoverOf）
export const RANK_CELL_COVER : number = 4
export const SUIT_CELL_COVER : number = 13

// 满配能覆盖多少张：6 个点数格 = 24 张。
// **只是旧模型留下的参照**（那时候庄家按张数发预算摇配装）——
// 角色卡那套的覆盖面是卡上印多少就多少。
//
// 现有的玩家角色覆盖 **12～20 张**（按 roleCover 现算，别在这儿写死个数 ——
// 这行注释原先写的「8 个角色 16~21 张」过期过一次）。
//
// ---- 一处**还没定**的不一致 ----
//
// 一个花色标签在这儿算 12 张（slotCover，因为 J 不触发技能），
// 而庄家那边的 SUIT_CELL_COVER 算 **13**。于是两侧的「盖 N 张」
// 不能直接横着比 —— 庄家末关的「盖 21」比玩家最强的「盖 20」实际还高一点。
// 动覆盖面曲线之前先把这两个数对齐（见《摸打钓鱼-庄家角色设计.md》第四节）
export const FULL_COVER : number = RANK_CAPACITY * RANK_CELL_COVER

// ---------- 墓碑：rollKitFor（庄家按「覆盖面预算」摇配装）----------
//
// 它拿一个张数预算，一件件往点数槽里塞技能，每件摇一个等级（= 占几格），
// 于是同一个预算能长出不同形状。
//
// **删掉的理由不是它不好用，是它让庄家没有性格。** 连「带什么技能」
// 都是摇的，所以第 9 关这一次摇到顺色 + 见底、下一次摇到窥视 + 换水 ——
// 玩家学不到任何东西，那一关只是一个强度数字。
//
// 换成**庄家角色卡**（见 draw-levels 的 DRAW_FOE_ROLES）：
// 技能名单印死（可学、商店会预告），而**标签是摇的**（学不到头）。
// 跟玩家角色正好反过来 —— 那边槽和标签印死、你选插什么技能。
//
// 它顺带也依赖「等级 = 占几格」，而等级整件事已经没了

// ---------- 一个槽：插了哪件技能，它占哪几个标签 ----------
//
// 这是 kitFromRole（玩家）和庄家角色卡共用的中间形式。
// 两边的差别只在**这张表是怎么来的**：
//
//   玩家 —— 标签印在卡上，skill 由你挑
//   庄家 —— skill 印在卡上，标签是摇的
//
// 到了这一层它们长得一样，所以下面那个 kitFromSlots 两边共用
export type KitSlot = {
  skill : number
  // 点数（'A'…'10'、'Q'、'K'）或花色（'♠♥♦♣'）
  labels : string[]
}

// 把一串槽翻成 loadout。role 只是原样带进 DrawKit（对局页要显示角色名）
export function kitFromSlots(slots : KitSlot[], role : number) : DrawKit {
  const levels = filled(DRAW_SKILLS.length, -1)
  const lo = emptyLoadout()
  for (let i = 0; i < slots.length; i++) {
    const k = slots[i].skill
    if (k < 0 || k >= DRAW_SKILLS.length) {
      continue
    }
    const labels = slots[i].labels
    for (let j = 0; j < labels.length; j++) {
      if (isSuitSlot(labels[j])) {
        const s = SUITS.indexOf(labels[j])
        if (s >= 0) {
          lo.suitOwner[s] = k
        }
      } else {
        const at = SKILL_RANKS.indexOf(labels[j])
        if (at >= 0) {
          lo.rankOwner[at] = k
        }
      }
    }
    // 没有等级了，装上就是 0（见上面 DrawSkill 那段）
    levels[k] = 0
  }
  return { levels: levels, loadout: lo, role: role } as DrawKit
}

// 摇 count 个标签：suit 为真摇花色，否则摇点数。**不跟 taken 里的重复**。
//
// 庄家角色卡用它 —— 卡上写的是「这个槽要几个点数标签」，
// 具体哪几个每一轮重摇（见 draw-levels 的 rollFoeKitFor）。
//
// 用 rollSpots 挑下标（部分 Fisher-Yates），所以摇出来的那几个
// **不连号** —— 不然磁钩那条 +1 链老是自己接上自己
export function rollLabels(count : number, suit : boolean, taken : string[]) : string[] {
  const pool : string[] = []
  const all = suit ? SUITS : SKILL_RANKS
  for (let i = 0; i < all.length; i++) {
    if (taken.indexOf(all[i]) < 0) {
      pool.push(all[i])
    }
  }
  const picked = rollSpots(pool.length, count)
  const out : string[] = []
  for (let i = 0; i < picked.length; i++) {
    out.push(pool[picked[i]])
  }
  return out
}

// ---------- 墓碑：rollFullKit（老的「随机满配」）----------
//
// 它摇一套填满点数槽的配装：一个个往里塞技能，每件先摇等级、
// 再按剩下几格压一压，于是形状自己长出来（6 / 3+3 / 3+1+1+1 / 1×6）。
//
// **等级没了之后它就立不住了** —— 它的全部形状变化来自「等级 = 占几格」，
// 而槽上印死标签之后一槽就是一槽。
//
// 替代品是现成的 **rollRoleKit()**：摇一个角色 + 每个槽摇一件技能。
// 那个形状变化更好 —— 它摇的是「哪张角色卡」（槽数、槽上印什么、
// 带哪件常驻特殊技），比摇等级能摇出的差别大得多。
//
// 所以终局「不选角色就开打」现在走 rollRoleKit，跟庄家同一条路

// 装着的技能下标，按技能表顺序
export function equippedSkills(lo : DrawLoadout) : number[] {
  const list : number[] = []
  for (let k = 0; k < DRAW_SKILLS.length; k++) {
    if (isEquipped(lo, k)) {
      list.push(k)
    }
  }
  return list
}

// ---------- 墓碑：canUpgrade / investedOf ----------
//
// canUpgrade 回答「还升得动吗」（等级没到顶 + 槽里有空格）。
// investedOf 算「这个技能到这一级值多少」（解锁价 + 每级 UPGRADE_PRICE）。
//
// **升级整件事没了**，所以两个都没了：槽上印死标签 → 覆盖面不由等级定；
// 特殊技不可升级 → 另一条升级线也不存在。商店那三件相关道具
//（砺钩、洗点、加权）一起删了。

// 卖出拿回解锁价的一半。
//
// 从前是 `investedOf / 2`（解锁价 + 升级投入，升过级的卖得更贵）。
// 没有等级之后它退化成一个常数 —— 一件技能值多少只看它自己是哪一件。
//
// 卖出在新结构里仍然有用，而且用途变**单一**了：腾出那个槽。
// 从前它有三个用途（腾名额、换钱、腾格子给升级），现在就一个
export function sellPriceOf(skill : number) : number {
  return Math.floor(DRAW_SKILLS[skill].unlock / 2)
}

// 把一个技能从所有槽里撤下来（卖掉时用）
export function removeSkill(lo : DrawLoadout, skill : number) : DrawLoadout {
  const next = cloneLoadout(lo)
  clearSkill(next.rankOwner, skill)
  clearSkill(next.suitOwner, skill)
  return next
}

// 原先这儿有个 levelText（「未解锁 / 固定 / 初始 / 升 N 级」）。
// 等级没了，它只剩「有」和「没有」两种状态 —— 那在界面上
// 用「嵌着什么 / 空着」表达就够了，不需要一个专门的文案函数

