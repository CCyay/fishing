    // 跟窥视现在标「被看」是同一个路子。所以它在你手里是实打实的情报，
    // 在庄家手里是威慑
    key: 'lantern', name: '照水', unlock: 60,
    first: false,
    desc: '在场时，对方手牌全部明着'
  },
  {
    // 冻结：锁对方一张手牌，它打不出去。
    //
    // 现有技能里没有一个碰**对方的选择面** —— 护饵、磁钩、钩顶改的是
