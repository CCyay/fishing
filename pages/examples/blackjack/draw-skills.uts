// 摸打钓鱼的技能。设计稿见根目录《摸打钓鱼-技能与关卡设计.md》。
//
// 一条铁律：**没有技能直接改积分**。积分永远等于收走的张数，
// 技能只改「怎么钓、钓不钓得到、对方拿什么来钓」。
//
// 两个槽，按「覆盖面」装技能：
//   花色槽最多覆盖 2 个花色 —— 2 个初始技能各管一个花色，或 1 个升过级的颜色技（一个颜色就是 2 个花色）；
//   点数槽最多覆盖 6 个点数 —— 初始技能管 1 个、升 1 级管 3 个、升 2 级管 6 个。J 不能指定。
// 同一个技能只能装进一个槽；槽里每个花色、每个点数只归一个技能。
//
// 强度是模拟校准过的（每局分差，扣掉后手本来就有的 +2.9）：
//   护饵、磁钩、观潮 满装约 +4 ~ +7，属于「升满了明显好用」；
//   钩顶、搅水 只指定 1 个点数就有 +4 ~ +5，所以只能放点数槽、不能升级。
//
// 后来添的那几件（换水起）没过那套模拟，价钱是照同类件抄的 ——
// 哪天手感不对，先怀疑这几个的定价。
//
// 【连竿】当初模拟下来「没有效果」被拿掉过，现在又加回来了 ——
// 因为它的定位变了：那会儿它只是「多打一张」，现在它是**把两件技能
// 凑进同一个回合**的钥匙（染水→顺色、沉底→同点数通收）。
// 那个价值在「技能之间没有联动」的版本里根本不存在，所以当年测不出来

// 角色卡的槽上可以印花色（见 DRAW_ROLES），所以这儿要认 ♠♥♦♣
import { SUITS } from '@/pages/examples/blackjack/cards.uts'

// 四个花色。单独一个常量是为了让 emptyLoadout 不用 import SUITS.length ——
// 那条 import 只为了一个长度值，而这个数永远是 4
export const SUIT_COUNT : number = 4

// 原先这儿有个 UPGRADE_PRICE（升一级 100，同时是【砺钩】的标价）。
// 升级整件事没了，它跟着删

// ---------- 关键字「优先」 ----------
//
// 带**优先**的技能，它的效果在**钓牌判定之前**就结算。
//
// 为什么需要这么一条关键字：一张牌最多触发两个技能（花色槽一个、
// 点数槽一个，见 triggersOf），而「谁先谁后」从前是 afterPlay 里
// 写死的那个顺序 —— 全都排在钓牌判定**之后**。
//
// 可有些效果改的正是**钓牌判定的输入**：
//
//   【染水】把整堆的花色换掉 → 顺色拿什么去匹配，变了
//   【沉底】把这张打到堆底   → 从哪儿往哪儿收，变了
//
// 规则（现行）：**一张牌上有多个效果时，先执行带「优先」的那个**，其余照常。
// 现在所有技能都先于匹配结算（见 ap-fishing 的 afterPlay → resolveMatch），
// 优先管的是同一张牌上那几个效果之间的先后。调用点在 playFor 里，
// 落堆之前、afterPlay 里那一串之前。
//
// 玩家侧它是一个**看得见的标签**：技能卡和图鉴上描一个「优先」，
// 意思是「这件先算」。同一张牌上两件都带优先的，按表里的先后来
//（染水在沉底前面 —— 先定花色，再定落点）
export const KEYWORD_FIRST : string = '优先'

export type DrawSkill = {
  key : string
  name : string
  // 一句话效果，技能页和对局里的「技能」说明框都用它
  desc : string
  // 买它多少钱。卖出拿回一半（见 sellPriceOf）
  unlock : number
  // 带「优先」关键字吗（效果在钓牌判定之前结算，见上面那段）
  first : boolean

  // ---- 这儿原先还有 kind / maxLevel / upgrade 三个字段，全删了 ----
  //
  // kind（KIND_ANY 两个槽都行 / KIND_RANK 只能放点数槽）—— 花色槽砍掉之后
  // 只剩一个槽，没什么可分的。
  //
  // maxLevel + upgrade（最高等级、每级多少钱）—— **技能没有等级了**。
  // 角色卡的槽上印死标签，一槽一技能，覆盖面由槽决定；而特殊技不可升级。
  // 两条升级线都没了，于是商店那三件相关道具（砺钩、洗点、加权）
  // 和这两个字段一起删
}


// ---------- 技能的身份是 key，不是编号 ----------
//
// 每件技能用一个字符串 key 认身份（'hook'、'tide'…）。SK_* 那一串常量
// 还在用（代码里比技能用它），但**不再手写数字** —— 它们在表定义完之后
// 由 key 查出来（见本文件末尾 `SK_HOOK = skillIndexOf('hook')` 那一段）。
//
// 为什么要改：从前是手写的 `SK_GUARD = 0`、`SK_HOOK = 1`…
// 而**存档里存的就是这些数字**。于是：
//
//   · 删一件技能 → 后面全部前移 → 老档读出来整个错位
//     （你的磁钩会变成别人家的观潮）；
//   · 新技能只能**追加在表尾**，表的顺序从此不能按设计分组整理；
//   · 三十来个常量全靠手工维护，删一件得把后面的数字全改一遍。
//
// 换成 key 之后：**存档存 key**（见 draw-save 的 keysToText / textToKeys），
// 内存里照旧按下标索引（那样快，triggersOf 的返回值也不用变），
// 但下标是从表的顺序算出来的，没人手工维护。于是删增技能谁也不影响谁 ——
// 老档里读到一个已经删掉的 key，就当没有这件技能。
//
// 这一套是照钓鱼那边的贴纸抄的（stickers.uts 文件头有同样一段话）。
//
// 规矩只剩一条：**key 不要改**。改 key 等于换了一件技能，老档对不上。
// 显示名（name）随便改，它跟存档无关

// 【掏手】从对手手里掏几张、【掏库】从牌组掏几张。
//
// **定值，不随等级涨** —— 升级只扩覆盖面、不改效果强度（设计文档第三节）。
// 2 这个数是按手牌 4 张定的：掏一半。掏 1 张太轻（它下回合就补回来了），
// 掏 3 张等于直接废掉对手一个回合，那不是取舍是处刑
export const DUMP_COUNT : number = 2
export const SPILL_COUNT : number = 2

// 【退潮】往底下退几张。
//
// **固定 2，不跟点数挂钩。** 它已经有一个变量了（退多少 = 它的牌面点数），
// 再让「退几张」也跟着场面变就没人算得清了 ——【见底】那个
// 「N = 场上黑牌张数」正是因为算不清才被改成死数的。
//
// 为什么是 2 而不是 3：一局里堆常常只有三四张，退 3 张就等于退整堆，
// 那就糊进【见底】的地盘了。退潮的性格是**小范围、可累积**
//（连着退两手就是两段形状），而「底下两张」在界面上也一眼看得全
export const EBB_COUNT : number = 2

export const DRAW_SKILLS : DrawSkill[] = [
  {
    key: 'hook', name: '磁钩', unlock: 60,
    first: false,
    desc: '还能钓点数比它大 1 的牌（如 Q 钓 K，钓不了 J）'
  },
  {
    // 看的是**你自己回合末要补的**那两张 —— 回合末补牌（见 ap-fishing 的
    // passTurn）把这件技能的朝向翻了过来：从前每回合开始摸一张，
    // 你打完之后顶上那张是对方要摸的，观潮是偷看对手；
    // 现在补的是刚打完那一方，于是它变成了「挑自己的牌」
    key: 'tide', name: '观潮', unlock: 60,
    first: false,
    desc: '打出后查看牌库顶 2 张，可选择把它们放到牌库底'
  },
  {
    key: 'peek', name: '窥视', unlock: 40,
    first: false,
    desc: '打出后翻开对方 1 张手牌，直到那张被打出'
  },
  {
    // 换水：挑一张自己的手牌塞回牌库洗掉。
    //
    // 它治的是这个玩法最难受的那个局面：**手里四张跟堆上任何东西都对不上**。
    // 现有六个技能里一个都管不着这件事 —— 护饵、磁钩、钩顶改的是「钓得到
    // 钓不到」，观潮、窥视、搅水改的是「谁看得见什么」，
    // 没有一个能换掉手里那张废牌。
    //
    // 跟回合末补牌（见 ap-fishing 的 passTurn）咬得正好：放回一张，
    // 回合末就补一张新的回来。所以它的净效果是**拿一张不要的换一张未知的**。
    //
    // 塞回去是**真洗进牌库**，不是插在底下 —— 插底的话你数得出它
    // 什么时候回来，那就不叫「换掉」了。
    //
    // 等级只扩覆盖面（管几个花色 / 几个点数），效果本身一直是「换一张」——
    // 跟护饵、磁钩、观潮同一个规矩。价钱也照那三件走
    key: 'swap', name: '换水', unlock: 60,
    first: false,
    desc: '打出后，选 1 张自己的手牌洗回牌库'
  },
  {
    // 顺色：**第二条钓牌通道**。
    //
    // 摸打到这件之前只认点数（加 J 通吃），花色除了当槽位的标签之外
    // 一点用都没有。这一件让花色进钓牌判定 —— 而且跟点数那条完全并列：
    // 判定是从堆底往上找第一个命中的（见 ap-fishing 的 catchStart），
    // 所以同花色那张在多深，就从多深收起，中间的牌一并归你。
    //
    // ---- 代价：它自己失去点数 ----
    //
    // 带顺色的牌落堆时**没有点数**：钓不上任何人（只走花色这条线），
    // 也没人按点数钓得上它。
    //
    // 不加这一条，它就是白给的第二条通道 —— 两条路都走得通的牌，
    // 强到没有取舍可言。加上之后它成了一笔交换：
    // 拿「这张牌的点数」换「一次按花色的深钩」。
    //
    // 这份代价是照排竿的【收色】抄的，连「花色还在、只是点数没了」
    // 这个形状都一样
    key: 'suited', name: '顺色', unlock: 80,
    first: false,
    desc: '改按花色钓牌：从堆里最深的同花色牌起，连同上面的牌一起收走。这张没有点数'
  },
  // ---- 下面三件的效果「挂在打出的那张牌上」 ----
  //
  // 解除条件不是「过 N 个回合」，而是**那张效果牌被钓走**（谁钓的都算）。
  // 这个形状比计时器好：对手有办法破它（去钓那张牌），
  // 而你得掂量把效果挂在多深的位置 —— 挂得浅，它一钩就破；
  // 挂得深，它要连带收走一大段才碰得到。
  //
  // 实现见 ap-fishing 的 HeldEffect
  {
    // 照水：对方全部手牌明置。
    //
    // 跟【窥视】的区别是**范围和时限**：窥视翻一张、翻到那张打出去为止；
    // 照水翻全部、亮到效果牌被钓走为止，期间对方新补的牌也一样明着。
    //
    // 有个不对称得知道：**庄家用它对你没有实际作用**（你自己的手牌
    // 一直看得见），它只能表达成「庄家知道你全部手牌」——
    // 跟窥视现在标「被看」是同一个路子。所以它在你手里是实打实的情报，
    // 在庄家手里是威慑
    key: 'lantern', name: '照水', unlock: 80,
    first: false,
    desc: '打出后，对方手牌全部明示，直到这张被钓走'
  },
  {
    // 冻结：锁对方一张手牌，它打不出去。
    //
    // 现有技能里没有一个碰**对方的选择面** —— 护饵、磁钩、钩顶改的是
    // 「钓得到钓不到」，观潮、窥视、搅水改的是「谁看得见什么」。
    // 这一件是第一个。
    //
    // ---- 你是**瞎挑**的，这正是它好玩的地方 ----
    //
    // 对方手牌盖着（除非被窥视或照水翻开过），所以你指定的是**位置**，
    // 不是牌面 —— 点第几张，不知道那是什么。
    // 于是它跟窥视、照水天然成连招：先翻开，再冻住那张好的。
    // 没有情报的时候，冻结是一次下注；有情报的时候，它是一记精准打击
    key: 'freeze', name: '冻结', unlock: 70,
    first: false,
    desc: '打出后选对方 1 张手牌，它不能打出，直到这张被钓走'
  },
  {
    // 见底：它自己算 0 点；整个牌堆的点数**往下压 1，减到 0 为止**。
    //
    // ---- 改了两处，一处比一处大 ----
    //
    // **一、幅度从「场上黑色牌的张数」变成死数 1。**
    //
    // 那一版的想法是「可操纵的量」：想压得狠就先往堆上垫黑牌。
    // 可它有两个毛病：
    //
    //   **幅度算不清**。N 随堆的颜色构成每回合都变，厚堆里常常是 5 以上，
    //     一压就是「点数 ≤ 5 的全没」。一局触发 2~7 次，每次收成从 0 张
    //     跳到七八张 —— 那不是取舍，是开奖。
    //   **染水 + 见底成了一个必杀**（染黑 → N 拉满 → 整堆端走）。
    //     两件技能凑成翻倍，而设计文档第九节自己立过规矩：
    //     组合要有爆点，不能翻倍。
    //
    // **二、它自己也算 0 点，于是连自己一起收走。**
    // 它收的是「点数为 0 的牌」，而它自己就是 —— 所以它**保底 +1 分**，
    // 而且不会在堆上留下一张饵（普通的空钩牌会留给对手当钩点）。
    // 代价是它放弃了这一手的钓牌（0 点谁也钓不上）。
    //
    // ---- 它现在的位置：清小牌 + 挪格局 ----
    //
    // 它做两件事：
    //   **收走**堆上所有「点数为 0」的牌 —— 自己、A（1−1=0）、
    //     以及别人之前造出来的那些 0 点垃圾（掏手/掏库扔的、退潮退到底的）；
    //   **挪格局** —— 剩下的牌各降一格（原本 5 点的变 4 点），
    //     于是你手里那张 4 突然够得着原来那张 5。
    //
    // 第二件是它跟别的清场技能的区别：别的清完就完了，
    // 它清完还把剩下的牌重排了一遍。
    //
    // 幅度写在 ap-fishing 的 LOW_TIDE_STEP，「减到 0 为止」是条
    // 全局规则（见那边的 dropVals）—— 两处都不在这儿重复。
    //
    // ---- 「只放点数槽、不给升级」那条还成立 ----
    //
    // 它是清场型的，威力集中在一下；覆盖面一旦能扩（更多牌带上它），
    // 就等于「更多牌能触发清场」—— 那比效果本身强得多，而且没法调。
    //（「升级」这个词本身已经作废 —— 等级整套删了，现在换成「别插大槽」。）
    //
    // **标价 150 没动**。幅度从「黑牌张数」掉到 1，它弱了不少、该降 ——
    // 可降到多少得先用模拟器量（见设计文档 12.7：模拟器还没搬到新模型上）。
    // 凭感觉改标价只是把一个没量过的数换成另一个没量过的数
    key: 'lowtide', name: '见底', unlock: 150,
    first: false,
    desc: '此牌点数变成 0；场上所有牌点数 −1，收走点数为 0 的牌（含它自己）'
  },
  {
    // 洪水：它自己没点数，但打出之后从**牌库**一张张往堆上翻，
    // 直到翻出的那张跟堆上撞上点数 —— 撞上那一下连中间的全收走，算你的分。
    //
    // ---- 它是全表唯一一个「你按下去不知道会发生多少」的技能 ----
    //
    // 翻几张不由你定：堆上牌多就容易撞（翻一两张就收），堆空就得一直翻
    //（翻到两张自己撞上为止）。所以同一张洪水牌，在厚堆上是小收，
    // 在空堆上是一次爆发 —— 而「现在堆多厚」是你排牌时就看得见的。
    //
    // ---- 三份代价，都是实打实的 ----
    //
    //   · **它自己没点数**：这张牌钓不上任何人，也没人按点数钓得上它
    //     （跟顺色一个待遇）。你花的是一整张牌的点数。
    //   · **翻出来的牌不触发技能**：那些牌是从牌库硬翻上去的，不算打出。
    //     所以它不会替你连锁引爆别的技能，也不会误触对方的。
    //   · **翻空了就是白打**：牌库见底还没撞上，那些牌全留在堆上 ——
    //     等于你亲手给对手堆了一摞钩点。而且牌库是双方共用的有限资源，
    //     翻掉的那些谁也摸不到了，这一局会提前收场。
    //
    // 收牌不走飞牌特效（那套演的是一段连续的牌，而这儿是边翻边判、
    // 翻几张不定）—— 直接结算 + 播报，跟见底一个路子
    key: 'flood', name: '洪水', unlock: 130,
    first: false,
    desc: '这张没有点数。打出后从牌库逐张翻牌到堆上，直到点数对上，收走那一段'
  },
  {
    // 择饵：看牌库顶五张，挑一张留在最上面，其余沉到底。
    //
    // 跟【观潮】是同一条轴上的两档，但形状不一样：
    //
    //   观潮 —— 看 2 张，**一起沉或一起不沉**。它问的是「这两张要不要」。
    //   择饵 —— 看 5 张，**挑一张留顶**。它问的是「这五张里哪张最好」。
    //
    // 后者强得多：看得多（5 对 2），而且是精确挑选而不是整批取舍。
    // 所以价钱也拉开（100 对 60）—— 观潮成了它的便宜版，
    // 而不是被它取代。
    //
    // 回合末补牌之后这件技能的朝向跟观潮一样是**对着自己的**：
    // 顶上那几张是你回合末要补的（见 ap-fishing 的 passTurn），
    // 所以它是「从五张里给自己挑一张」，不是偷看对手
    key: 'pick', name: '择饵', unlock: 100,
    first: false,
    desc: '打出后查看牌库顶 5 张，选 1 张放在最上面，其余放到牌库底'
  },
  {
    // 染水〔**优先**〕：打出后把**场上所有牌的花色**改成跟这张一样。
    //
    // 它带「优先」关键字 —— 效果在钓牌判定之前结算（见文件头那段）。
    // 不这么排的话同一张牌上的顺色看见的还是染色前的堆，组合当场失效。
    //
    // ---- 它自己一分不加 ----
    //
    // 这是全表唯一一个**纯粹的铺垫技**。花色在这套规则里不参与钓牌判定
    //（钓牌看点数，见 catchStart），所以把整堆染成一个花色，
    // 当场什么也不会发生。它的全部价值在**顺色**身上：
    //
    //   【顺色】匹配堆里第一张同花色的，连中间的一起收走。
    //          整堆同花色之后，顺色命中的必然是**最深那张** ——
    //          也就是**整堆通收**。那是 J 级别的一下。
    //
    // ---- 原先还有第二条用法，跟【见底】配，那条没了 ----
    //
    // 见底原来压的 N = 场上黑牌张数，于是染黑 → N 拉满 → 整堆端走，
    // 染红 → N 归零 → 把对方的见底拆掉。那一版里「你打的是红的还是黑的」
    // 是一个真决策（进攻 / 防守两种用法由手牌颜色选）。
    //
    // 见底改成死数 −1 之后那条整个失效了（理由见见底那段）。
    // 代价很明确：**这件技能少了一半深度** —— 它从「两种用法」
    // 退回「一种用法」，红黑也不再有区别。
    //
    // 没给它补新东西：见底那条改动是为了把一个开奖式的幅度按下去，
    // 而「为了救一件铺垫技再给另一件加料」会把两件都搞糊。
    // 它现在是一件单纯的顺色放大器，这样也立得住 ——
    // 只是它的标价（110）和升级规则是按两种用法定的，得重估。
    //
    // 而花色槽装它的话，覆盖面本身就决定了你只能染那一两个花色 ——
    // 「装在哪」和「它能干什么」第一次直接挂上了钩。
    //
    // ---- 它是**双刃**的 ----
    //
    // 整堆同花色对**双方的顺色**一样好用。所以染完那一堆是个诱饵：
    // 你得在对手摸到同花色的牌之前把它用掉。终局模式里双方都是满配，
    // 对面有顺色的概率不低。
    //
    // ---- 为什么给升级 ----
    //
    // 清场型的那四件（钩顶、搅水、见底、洪水）都不给升级，理由是
    // 「覆盖面能扩 = 更多牌能触发清场」。染水看着像清场的帮手，
    // 但它**自己清不了场**，而且价值完全是条件性的（得同时有顺色）。
    // 一件条件性的铺垫技需要**频率**才有意义 —— 只管一个点数的话，
    // 等你那张顺色上手时堆早就不是单色了。
    //
    //（这段的「升级」已经作废 —— 等级整套删了，覆盖面现在由
    //  角色卡槽上印的标签定。留着是因为「条件性的技能需要频率」
    //  那条判断换成槽之后照样成立：它该插在大槽上。）
    //
    // 110 块：比择饵（100）贵一点，比顺色（120）便宜一点。
    // 它单买是废的，所以定价偏低；可它跟顺色凑一起是全表最凶的一组。
    // **见底那条用法砍掉之后这个价偏贵了**，跟见底的 150 一起等模拟器
    key: 'suitify', name: '染水', unlock: 110,
    first: true,
    desc: '打出后，场上所有牌的花色变成与这张相同'
  },
  {
    // 沉底〔**优先**〕：这张**打到堆底**，而不是堆顶。
    //
    // 它带「优先」关键字，而且是**必须带** —— 它改的是「从哪儿往哪儿收」，
    // 那是钓牌判定的输入。排在判定之后就什么也改不了了。
    //
    // ---- 它把收牌的方向整个翻过来 ----
    //
    // 基础规则是「打出的牌落在堆顶，对上堆里某张，收走**那张到堆顶**的整段」。
    // 所以普通打法永远收的是**上半截**，堆底那几张老饵一直沉在那儿碰不着。
    //
    // 沉底落在堆底（下标 0），于是那一段变成「**堆底到匹配那张**」——
    // 它是唯一能吃到堆底那几张的打法。而且匹配点越高收得越多，
    // 所以搜索方向也跟着反过来：从堆顶往下找，命中最高那张（见 catchStart）。
    //
    // ---- 代价是**没匹配上就成了全堆的引信** ----
    //
    // 这张牌留在堆底。基础规则下，对手匹配到堆底那张就通吃整堆 ——
    // 所以沉底空钩一次，等于给对手递了一个全收的靶子。
    // 「它埋得多深」从前是防御属性（护饵那条），这儿反过来成了风险。
    //
    // ---- 它是组合技 ----
    //
    // 主线是跟【连竿】配：沉底埋一张，连竿再打一张同点数的 ——
    // 第二张落堆顶、匹配到堆底那张，**整堆通收**。两张牌一个回合完成，
    // 对手插不进手。那是全表最狠的一组，而它要两件技能同时在手、
    // 还得手里真有一对同点数的牌。
    //
    // 单独带它也不废（能吃堆底），所以它不像【染水】那样完全依赖组合
    key: 'sink', name: '沉底', unlock: 120,
    first: true,
    desc: '这张放到堆底。对上时收走从堆底到对上的那一段；没对上则留在堆底'
  },
  {
    // 连竿：打出之后**再打一张**。
    //
    // ---- 它是「组合技」的通用钥匙 ----
    //
    // 这套的槽位结构把联动锁死了：一张牌最多触发两个技能
    //（花色槽一个、点数槽一个，见 triggersOf），所以两件技能要配合，
    // 从前只能祈祷它们落在同一张牌上 —— 那是很小的概率。
    //
    // 连竿换了条路：**两张牌、一个回合**。于是
    //   染水染色 → 顺色通收
    //   沉底埋牌 → 同点数的那张通收
    // 这些从前要「同一张牌」的组合，现在只要「同一个回合」就行。
    // 而且对手插不进手 —— 铺垫和收网之间没有它的回合。
    //
    // ---- 加打的那张**不再给加打** ----
    //
    // 不封这一条的话，覆盖面一宽就能一口气把整手牌打完，
    // 而「每回合做一个决定」是这个玩法的节奏基础。封住之后
    // 它恒定是「一回合两张」，跟覆盖面无关 —— 升级只影响
    // 「多久能用上一次」，不影响那一次有多强。
    //
    // ---- 它是双刃的 ----
    //
    // 一回合打两张，没钓到的话你给对手堆了**两个**靶子，
    // 而且手牌和牌库都消耗得更快（局更短、分差更小）。
    // 领先的时候这是催命，落后的时候这是机会 —— 跟【弃饵】那条节奏轴同向。
    //
    // 100 块：它自己不收牌、不加分，买的是一个回合里的第二次机会
    key: 'again', name: '连竿', unlock: 100,
    first: false,
    desc: '打出后可再打 1 张（再打的那张不触发连竿）'
  },
  // ================= 第二批：十一件（照钓鱼的贴纸、排竿的道具移植） =================
  //
  // 挑选和改写的记录在根目录《摸打钓鱼-技能与关卡设计.md》第十一节。
  // 移植时有一条硬约束反复起作用：**钓鱼和排竿是「各有自己的牌库」，
  // 摸打是双方共用一个牌库 + 一个共用牌堆**。所以那边「从庄家牌库顶取两张」
  // 这类贴纸整条路走不通，能过来的都改写成了「动共用牌库」或「动对方手牌」。
  //
  // ---- 点数通道两件 ----
  {
    // 归深：这张牌还算 11 点。
    //
    // 11 是牌堆里**天然的空缺** —— J 打出就通吃走了（见 catchStart），
    // 从不落堆，所以没有任何一张牌天生停在 11 这个点数上。
    // 于是两张归深牌互相必钩：它不是「多一条通道」，是**一个只有自己人
    // 进得去的私有钓点**。
    //
    // 跟磁钩的区别在这儿：磁钩拓宽的是「我能对上谁」（+1），
    // 归深拓宽的是「谁能对上我」—— 它把带这件技能的牌全接到同一个深度。
    // 所以它越升越强不是因为效果变大，而是因为**同伙变多**。
    //
    // 照钓鱼的【归深】抄，连「11 是 J 的数而 J 从不落堆」这个理由都一样
    key: 'deep', name: '归深', unlock: 90,
    first: false,
    desc: '这张同时算 11 点'
  },
  {
    // 齐顶：这张算堆上**最大**的那个点数。
    //
    // 落下去必钩中那张最大的，所以它的收成完全由**堆的形状**决定：
    // 最大那张埋得越深，这一钩收得越多。
    //
    // ---- 空堆上算 0 点，那是它的闸 ----
    //
    // 0 点当不了钓点（见 anyEquals 里「0 对 0 不算相等」那条），
    // 所以空堆上打齐顶就是白打一张。于是它逼出一个时机判断：
    // 堆薄的时候留着，堆厚了再放 —— 跟【洪水】正好反着来
    //（洪水是堆空时爆发、堆厚时小收）。
    //
    // 只放点数槽、不给升级：它是「必钩」级的效果，覆盖面一扩
    // 就等于每回合都能必钩，那比效果本身强得多（跟钩顶、见底同一个道理）
    key: 'peak', name: '齐顶', unlock: 150,
    first: false,
    desc: '这张算作堆上同颜色牌里最大的点数，必定钓中；堆上没有同颜色的牌时，按自己的点数算'
  },
  // ---- 收割两件 ----
  {
    // 收色：堆上所有同花色的牌一起收走，连它自己。
    //
    // ---- 跟【顺色】的区别得写清楚，不然玩家分不出 ----
    //
    //   顺色 —— 按花色找**最深**那张，收「那张 → 堆顶」一整段连续的牌。
    //           中间不同花色的也一并归你。
    //   收色 —— 只收**同花色那几张**，散在哪儿都收，中间的不动。
    //
    // 所以厚堆上顺色收得多，而花色散得开的时候收色收得多。两件形状不同，
    // 同一个花色上都装着也不冲突。
    //
    // 代价照顺色：**这张不走点数通道**（valuesOf 返回空），所以它不会
    // 先钓到一段再散收。你花的是一整张牌的点数，换一次按花色的清扫
    key: 'hue', name: '收色', unlock: 150,
    first: false,
    desc: '打出后收走堆上所有同花色的牌（包括这张）。这张没有点数'
  },
  {
    // 撒网：从它自己起**往左连续**比奇偶，同奇偶就收，遇到不同的就停。
    //
    // 奇偶按**牌面点数**算，不看点数卡贴的那几个 —— 一张牌只有一种奇偶，
    // 这件事得一眼看得出来，不能让点数卡把它搅成「既是奇又是偶」。
    // 堆上那些按**现在**的点数算（见底压过的按压后的，**0 算偶数**）。
    //
    // ---- 它原先是「堆上所有同奇偶的一起收」（散收）----
    //
    // 改成连续段，三个理由：
    //
    //   **散收把牌堆打成筛子**，而「收一段连续的牌」是这个玩法的核心形状
    //     （基础钓牌、J 通吃、洪水都是收一段）。撒网从此和它们同构。
    //   **幅度回到档内**。散收是堆的一半 —— 奇偶面本来就太大了，
    //     那也是它当初卖 160 还不给升级的原因。连续段的期望长度只有
    //     两张上下，但碰上一长串同奇偶就一路收完：它从「稳定收半堆」
    //     变成**条件爆发**，而条件是堆的形状 —— 那是双方打出来的，有互动。
    //   **它成了 0 点牌的出口**。0 算偶数，所以【见底】压出来的那一片
    //     0 点牌是一个连续的偶数段，一张偶数撒网就能一网收完。
    //     「见底铺设 → 撒网引爆」这条构筑路线就是这么接起来的。
    //
    // ---- 它和收色是一对，轴不一样 ----
    //
    // 收色按花色切（四分之一的牌）、**散收**；撒网按奇偶切（一半的牌）、
    // **连续段**。两件形状从此不同，所以不用担心「奇偶面太大」——
    // 面大但要求连续，而花色面小所以散收也不过分。
    //
    // 奇还是偶由**你打的那张**定死，不像钓鱼的原版那样让你选。
    // 那条改动是有意的（用户定的）：少一次静态选择，
    // 多一次「手里哪张的奇偶对」的盘算。
    //
    // 它**不失去点数**（要靠自己的点数定奇偶），所以可能先钓到一段、
    // 再撒一网。那种情况下它已经跟那段一起被收走了，连续段改从**堆顶**起算
    //（见 ap-fishing 的 castFor）。
    //
    // **标价 160 没动**，但这一改之后它更该重估 —— 等模拟器量
    key: 'cast', name: '撒网', unlock: 160,
    first: false,
    desc: '打出后从它自己往左连着收：同奇偶就收，遇到奇偶不同的就停（0 算偶数）'
  },
  // ---- 动对方手牌三件 ----
  //
  // 这三件都「看对方全部手牌再挑一张」，强度递增：压舱只是把牌挪走，
  // 摘钩把它挪到自己手上（双重收益），对换还能顺手塞给他一张废牌。
  // 所以只有最弱的那件（压舱）给升级
  {
    key: 'press', name: '压舱', unlock: 80,
    first: false,
    desc: '打出后查看对方手牌，选 1 张洗回牌库'
  },
  {
    // 摘钩：挑对方一张手牌，拿到**自己手上**。
    //
    // 零和对抗里它是双重收益：他少一张好牌，你多一张。而且你是
    // **看着挑**的 —— 不像搅水那样随机。所以不给升级，价钱也顶到清场件那一档
    key: 'unhook', name: '摘钩', unlock: 150,
    first: false,
    desc: '打出后查看对方手牌，选 1 张拿到自己手上'
  },
  {
    // 对换：跟对方换一张，两边给哪张都你挑。
    //
    // 比摘钩多一层：你不只拿走他的钩，还能把自己手里最没用的那张塞给他。
    // 手牌数两边都不变，所以它不改节奏 —— 改的是**双方手牌的质量差**
    key: 'swapcard', name: '对换', unlock: 160,
    first: false,
    desc: '打出后查看对方手牌，用自己 1 张换对方 1 张（都由你选）'
  },
  // ---- 挂在牌上的两件 ----
  //
  // 解除条件照【照水】【冻结】：**那张效果牌被钓走**（谁钓的都算）。
  // 所以它们都要求「这张没钓到牌」—— 挂效果得用一张钓不到的，
  // 而埋得多深决定对手要花多大力气才破得掉
  {
    // 窄口：对方每回合只补到 3 张。
    //
    // 手牌 4 张是这个玩法做决定的全部素材（见 HAND_SIZE 那段），
    // 砍掉一张等于把他的选择面削掉四分之一 —— 而且是**持续**的，
    // 直到他舍得花一次钓牌去把这张挖走。
    //
    // 照钓鱼的【窄口】抄，那边是「只补到 4 张」（它手牌上限 5）
    key: 'narrow', name: '窄口', unlock: 90,
    first: false,
    desc: '打出后，对方每回合只补到 3 张手牌，直到这张被钓走'
  },
  {
    // 满篓：自己的手牌上限 +1。
    //
    // 跟窄口是一对，一个削他一个补自己。多一张手牌 = 多一个选择，
    // 而「打哪张」是这个玩法唯一的决定 —— 所以它比看着弱
    key: 'creel', name: '满篓', unlock: 90,
    first: false,
    desc: '打出后，你每回合补到 5 张手牌，直到这张被钓走'
  },
  // ---- 从牌库检索两件 ----
  //
  // 它们治的是这个玩法最大的运气来源：**手里四张跟堆上一个都对不上**。
  // 换水是「拿一张不要的换一张未知的」，这两件是「换一张**指定**的」。
  //
  // 两件的挑法不一样，因为池子大小差四倍 ——
  //   同号的池子只有 3 张（同点数的另外三张），所以随你挑；
  //   同花的池子有 12 张，随你挑就太强了，所以只能**翻到第一张**
  {
    key: 'twin', name: '同号', unlock: 100,
    first: false,
    desc: '打出后从牌库选 1 张同点数的牌拿到手上'
  },
  {
    // 同花：翻牌库顶，拿第一张同花色的，翻过的其余**洗回牌库**。
    //
    // 洗回去而不是沉底：沉底你就数得出那几张什么时候回来，
