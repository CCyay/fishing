    // 没有情报的时候，冻结是一次下注；有情报的时候，它是一记精准打击
    // 40：新口径 X=+0.76、D=+0.40。原先 55
    // 40 → 35〔2026-10-15 重定价〕：X=+0.56
    key: 'freeze', name: '冻结', unlock: 35,
    first: false,
