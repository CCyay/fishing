    //
    // **跟顺色同价**（两件 X 差 0.04，小于标准误）—— 见顺色那条的说明
    key: 'cast', name: '撒网', unlock: 65,
    first: false,
    desc: '从它往堆底方向连着收同奇偶的牌，遇到奇偶不同的就停'
  },
  // ---- 动对方手牌三件 ----
  //
  // 这三件都「看对方全部手牌再挑一张」，强度递增：压舱只是把牌挪走，
