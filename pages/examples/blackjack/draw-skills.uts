// 摸打钓鱼的技能。设计稿见根目录《摸打钓鱼-技能与关卡设计.md》。
//
// 一条铁律：**没有技能直接改积分**。积分永远等于收走的张数，
// 技能只改「怎么钓、钓不钓得到、对方拿什么来钓」。
//
// 两个槽，按「覆盖面」装技能：
//   花色槽最多覆盖 2 个花色 —— 2 个初始技能各管一个花色，或 1 个升过级的颜色技（一个颜色就是 2 个花色）；
//   点数槽最多覆盖 6 个点数 —— 初始技能管 1 个、升 1 级管 3 个、升 2 级管 6 个。J 不能指定。
// 同一个技能只能装进一个槽；槽里每个花色、每个点数只归一个技能。
//
// 强度是模拟校准过的（每局分差，扣掉后手本来就有的 +2.9）：
//   护饵、磁钩、观潮 满装约 +4 ~ +7，属于「升满了明显好用」；
//   钩顶、搅水 只指定 1 个点数就有 +4 ~ +5，所以只能放点数槽、不能升级。
//
// 后来添的那几件（换水起）没过那套模拟，价钱是照同类件抄的 ——
// 哪天手感不对，先怀疑这几个的定价。
//
// 【连竿】当初模拟下来「没有效果」被拿掉过，现在又加回来了 ——
// 因为它的定位变了：那会儿它只是「多打一张」，现在它是**把两件技能
// 凑进同一个回合**的钥匙（染水→顺色、沉底→同点数通收）。
// 那个价值在「技能之间没有联动」的版本里根本不存在，所以当年测不出来

import { SUITS } from '@/pages/examples/blackjack/cards.uts'

// 升一级多少钱。只有一个价 —— 不按技能、不按等级分。
//
// 升级走商店的【砺钩】道具，所以这个数同时是那件道具的标价
//（draw-levels 的 FIX_ITEMS 直接引它，免得两处各写一个 100）。
//
// 定在这个文件而不是 draw-levels：那边已经 import 了这边
//（关卡表要用 DRAW_SKILLS 配庄家的技能），反过来再 import 就成环了。
// 升级价跟技能绑在一起，放这儿也更说得通
export const UPGRADE_PRICE : number = 100

// ---------- 关键字「优先」 ----------
//
// 带**优先**的技能，它的效果在**钓牌判定之前**就结算。
//
// 为什么需要这么一条关键字：一张牌最多触发两个技能（花色槽一个、
// 点数槽一个，见 triggersOf），而「谁先谁后」从前是 afterPlay 里
// 写死的那个顺序 —— 全都排在钓牌判定**之后**。
//
// 可有些效果改的正是**钓牌判定的输入**：
//
//   【染水】把整堆的花色换掉 → 顺色拿什么去匹配，变了
//   【沉底】把这张打到堆底   → 从哪儿往哪儿收，变了
//
// 这两件要是排在判定之后，同一张牌上的组合当场就失效了。所以它们
// 带「优先」，调用点在 playFor 里（catchStart 之前），不在 afterPlay 里。
//
// 玩家侧它是一个**看得见的标签**：技能卡和图鉴上描一个「优先」，
// 意思是「这件先算」。同一张牌上两件都带优先的，按表里的先后来
//（染水在沉底前面 —— 先定花色，再定落点）
export const KEYWORD_FIRST : string = '优先'

export type DrawSkill = {
  key : string
  name : string
  // 一句话效果，技能页和对局里的「技能」说明框都用它
  desc : string
  // 能放哪个槽：KIND_ANY 两个都行，KIND_RANK 只能放点数槽
  kind : number
  // 最高等级。0 表示不能升级
  maxLevel : number
  // 解锁价
  unlock : number
  // 升到第 1、2 级各要多少钱
  upgrade : number[]
  // 带「优先」关键字吗（效果在钓牌判定之前结算，见上面那段）
  first : boolean
}

export const KIND_ANY : number = 0
export const KIND_RANK : number = 2

export const SK_GUARD : number = 0
export const SK_HOOK : number = 1
export const SK_TIDE : number = 2
export const SK_PEEK : number = 3
export const SK_TOP : number = 4
export const SK_STIR : number = 5
// 新技能一律**追加在表尾**，不许插在中间。
//
// 存档里 levels 和 loadout（suitOwner / rankOwner）存的都是**技能下标**
//（见 draw-save 的 textToFixed）。插在中间的话老档读出来整个错位：
// 你的护饵会变成别人家的磁钩。追加就安全 —— 老档里没有的那几格读成 -1
export const SK_SWAP : number = 6
export const SK_SUITED : number = 7
export const SK_LANTERN : number = 8
export const SK_FREEZE : number = 9
export const SK_LOWTIDE : number = 10
export const SK_FLOOD : number = 11
export const SK_PICK : number = 12
export const SK_SUITIFY : number = 13
export const SK_SINK : number = 14
export const SK_AGAIN : number = 15
// 第二批十一件（照钓鱼的贴纸、排竿的道具移植，见表里那段分隔注释）。
// 照旧**追加在表尾**，下标就是存档里的技能编号
export const SK_DEEP : number = 16
export const SK_PEAK : number = 17
export const SK_HUE : number = 18
export const SK_CAST : number = 19
export const SK_PRESS : number = 20
export const SK_UNHOOK : number = 21
export const SK_SWAPCARD : number = 22
export const SK_NARROW : number = 23
export const SK_CREEL : number = 24
export const SK_TWIN : number = 25
export const SK_SUITFIND : number = 26

