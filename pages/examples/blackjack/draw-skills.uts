export const SK_SUITIFY : number = skillIndexOf('suitify')
// ---- 下面有几个导出是**已删技能**，留着是因为「机制」比「技能」活得久 ----
//
// 表项都从 DRAW_SKILLS 删了，所以常量都是 **−1**，而 `triggersOf`
// 用 `>= 0` 守着空槽 —— `hasTrigger(skills, -1)` 永不匹配（它是
// `list.indexOf(skill) >= 0`，而 skills 里装的全是真下标），
// 所以这些技能**买不到也不触发**。
//
// 现在是这七个：`SK_SINK` / `SK_AGAIN`（下面那两段讲机制还有住户的）、
// `SK_DRAFT`（吃水，2026-10-25 删）、以及 **2026-10-26 这一清四件**：
// `SK_CREEL`（**槽技能满篓** —— ⚠ 常驻技满篓没删，走 `SP_CREEL` 那条）、
// `SK_TWIN`（同号）、`SK_SOFT`（软点）、`SK_DEEP`（归深）。
//
// ⚠ **这四件的 `.uvue` 实现有意留着没清**，照两步走那条（见下面那段
//   「顺序反过来直接编译不过」）：表项删了技能就已经失效了，
//   清实现 + 删导出是**另一轮**的事。四处实现分别在
//   `valuesOf`（归深追加 11 / 软点追加 1）、`refill` + `heldOn` 那条
//   （满篓的手牌上限）、`twinPending` 那条（同号从牌库检索）。
//
// ⚠ **还有一个静默陷阱**：`rankOwner` / `suitOwner` 用 **−1 当「这个槽空着」**
//   （`owner[i] = -1`），而死技能的常量也是 −1。所以**千万别把一个死常量
//   喂给 `coverageText`** —— 它那句 `lo.rankOwner[r] == skill` 会把每一个
//   空槽都算成「这件技能管着」。现在没有这样的调用点（传进去的值都来自
//   owner 数组本身，有主时才 ≥ 0），但加新调用点时要想到这一条。
//
// `SK_SINK` / `SK_AGAIN` 没跟着删，是因为各自的**机制**还有别的住户：
//
//   `SK_SINK`（沉底，10-15 删）—— sink 那条路（`wantSink` / `sinkOn` /
//     `catchStart` 的 sink 参数）被【逆流】（角色常驻技）、【偏流】（庄家规矩）、
//     【寒流】（技能，自带落堆底）三件在用。
//   `SK_AGAIN`（连竿，10-14 删）—— `againPending` 那套被庄家规矩【再钩】在用。
//
// **要动它们，得先把机制和技能拆开**：给机制起自己的名字
//（比如 `SINK_PARAM` / `AGAIN_GATE`），别再拿一个死技能的下标当参数名。
// 那是独立一笔，不属于「清死代码」那一轮。
//
// ---- 这张清单之前长得多，2026-10-16 清掉了十一个 ----
//
//   洪水 flood / 同花 suitfind / 量水 measure / 合流 merge / 抄底 dredge
//   + 压底族六件：压邻 void / 掏手 dump / 掏库 spill / 分水 odd /
//     封色 huevoid / 退潮 ebb
//
// 两步走的第二步：10-14 / 10-15 先把表项删掉（技能当场失效、基线验过），
// 10-16 清掉 `ap-fishing.uvue` 里全部实现（约 600 行），导出才跟着删。
// **顺序反过来直接编译不过** —— 这一季在 `DUMP_COUNT` 上栽过一次。
//
// 删除理由见《摸打钓鱼-技能与关卡设计.md》『被删掉的技能：总表』，
// 以及 `DEAD_SKILLS`（上面那张表，机器可读）。
//
// ⚠ **老存档买过这些的等于白花了钱** —— 没有退款逻辑。待定
export const SK_SINK : number = skillIndexOf('sink')
