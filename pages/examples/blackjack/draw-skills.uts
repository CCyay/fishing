    // 池子里多了一个 25、少了一个 45
    key: 'clean', name: '净水', unlock: 50,
    first: false,
    desc: '把它盖在堆上 1 张牌上面代替那张，从那一格判一次匹配；被盖住的牌不再生效。也可以直接打出'
  },
