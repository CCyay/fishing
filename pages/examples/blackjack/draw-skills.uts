    // 要坐实那条得用 `vs frost wild`（沸水删了，所以只剩野火那一件火源）
    // 55 → 50〔2026-10-15 重定价〕：X=+1.19
    key: 'frost', name: '结凌', unlock: 50,
    first: true,
    desc: '自带【结冰】；堆上所有牌贴上【结冰】'
