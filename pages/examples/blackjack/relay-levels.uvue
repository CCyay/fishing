<template>
  <view class="page">
    <view class="hero">
      <text class="hero-title">排竿</text>
      <text class="hero-sub">提前排好五张的出竿顺序，双方交替自动打完</text>
    </view>

    <!-- 在哪个档上打得写出来。head 那三格已经满了，所以另起一行 ——
         排竿现在有自己的三个存档槽，不说清楚会以为进度丢了 -->
    <view class="slot-line">
      <text class="slot-tip">存档</text>
      <text id="rv-slot" class="slot-name">{{ slotLabel }}</text>
    </view>

    <view class="head">
      <view class="head-item">
        <text class="head-label">最远战绩</text>
        <text id="rv-best" class="head-value">{{ bestText }}</text>
      </view>
      <view class="head-item">
        <text class="head-label">本轮进度</text>
        <text id="rv-run" class="head-value">{{ runText }}</text>
      </view>
      <view class="head-item">
        <text class="head-label">金币</text>
        <text id="rv-coins" class="head-value head-coin">{{ save.runCoins }}</text>
      </view>
    </view>

    <view class="rule">
      <text class="rule-text"
        >一轮挑战连打 {{ RELAY_COUNT }} 关。赢一关拿金币，进商店买道具、给道具进阶，
        再进下一关。庄家的规矩**摇到就固定**，往后每关只在上头再添一条，
        所以照着它配的装一路都管用。打平这一关不作数，家当留着重打一遍；
        输一局这一轮就结束 —— 金币、道具全清，从第一关重来。</text
      >
    </view>

    <!-- 有正打着的一轮时，把家当摊开说一句 -->
    <view v-if="alive" class="carry">
      <text class="carry-text">{{ carryText }}</text>
    </view>

    <view class="menu">
      <view
        v-if="alive"
        id="rv-go"
        class="menu-btn menu-btn-primary"
        @click="resume">
        <text class="menu-btn-text menu-btn-text-dark">{{ resumeText }}</text>
      </view>
      <view
        v-else
        id="rv-start"
        class="menu-btn menu-btn-primary"
        @click="startFresh">
        <text class="menu-btn-text menu-btn-text-dark">开始挑战</text>
      </view>
      <view v-if="alive" id="rv-restart" class="menu-btn menu-btn-warn" @click="askRestart">
        <text class="menu-btn-text menu-btn-text-warn">重新开始</text>
      </view>
      <view id="rv-items" class="menu-btn" @click="openItems">
        <text class="menu-btn-text">道具信息</text>
      </view>
      <!-- 摆在「重新开始」下面而不是上面：切档和推倒重来都是破坏性的，
           但「重新开始」得紧跟着「继续」—— 那是同一个决定的两个分支 -->
      <view id="rv-saves" class="menu-btn" @click="chooseSave">
        <text class="menu-btn-text">选择存档</text>
      </view>
      <view id="rv-back" class="menu-btn" @click="goBack">
        <text class="menu-btn-text">返回</text>
      </view>
    </view>

    <!-- 道具图鉴：永续的和限制的分开列，末了再列庄家那排规矩。
         贴纸那一页取消了 —— 排竿这边整套换成了道具 -->
    <view v-if="showItems" class="layer" @click="closeAll">
      <view class="panel" @click.stop="noop">
        <view class="panel-head">
          <text class="panel-title">道具信息</text>
          <text class="panel-sub"
            >道具 {{ ITEMS.length }} 件 · 庄家规矩 {{ RULES.length }} 条（翻到底）</text
          >
        </view>
        <scroll-view class="panel-body">
          <view v-for="(grp, gi) in itemGroups" :key="'ig-' + gi">
            <text class="group">{{ grp.title }}</text>
            <view
              v-for="(it, ii) in grp.items"
              :key="'it-' + gi + '-' + ii"
              :id="'rv-it-' + it.key"
              class="entry">
              <view class="entry-top">
                <text class="entry-name entry-name-plain">{{ it.name }}</text>
                <text class="entry-tag">{{ it.basePrice }} 金币起</text>
                <!-- 手头有这件就把当前等级标出来，没有就不占位 -->
                <text
                  v-if="alive && tierOf(it.key) >= 0"
                  class="entry-own"
                  :style="'color: ' + tierColor(tierOf(it.key))"
                  >{{ tierName(tierOf(it.key)) }}</text
                >
              </view>
              <text class="entry-desc">{{ itemDesc(it) }}</text>
            </view>
          </view>

          <!-- 庄家那排。它不买道具，挂的是「规矩」—— 一条条改的是这一关的
               玩法本身。摆在这儿是因为买道具的全部依据就是它：
               知道这一关会被改成什么样，才谈得上照着配。
               按 since 排，你才看得出这条路上什么时候会冒出什么。
               一轮之内摇到就固定，往后每关只多一条 —— 所以这张表
               读起来是「这一轮还可能再添哪几条」 -->
          <text class="group">{{ ruleGroupTitle }}</text>
          <view
            v-for="(r, ri) in dealerRules"
            :key="'dr-' + ri"
            :id="'rv-dr-' + r.key"
            class="entry">
            <view class="entry-top">
              <text class="entry-name entry-name-plain">{{ r.name }}</text>
              <text class="entry-tag">{{ ruleTag(r) }}</text>
              <!-- 这一关正挂着这条，就在右边点出来 —— 面板是从选关页开的，
                   「我马上要面对的是哪几条」比通读整张表有用得多 -->
              <text v-if="ruleOn(r.key)" class="entry-own">{{ runLabel }}</text>
            </view>
            <text class="entry-desc">{{ ruleDesc(r) }}</text>
          </view>
        </scroll-view>
        <text class="panel-close" @click.stop="closeAll">收起来</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  // 排竿的入口页：看战绩、接着打、或者推倒重来，顺便查道具。
  //
  // 这里不列关卡 —— 十关是一条连着打的路，打到哪一关由这一轮的进度说了算，
  // 输一局就从头来。「挑关卡」这件事本身不存在，列出来只会让人以为能挑
  import {
    SaveData,
    emptySave,
    loadRelaySave,
    saveRelay,
    relaySaveSlot,
    cloneSave,
    resetRun,
    runAlive,
    itemTierOf,
    setCurrentRelayLevel
  } from '@/pages/examples/blackjack/save.uts'
  import {
    RELAY_COUNT
  } from '@/pages/examples/blackjack/relay-levels.uts'
  import {
    RelayItem,
    RELAY_ITEMS,
    KIND_LASTING,
    descOf as itemDescAt,
    tierName,
    tierColor,
    DealerRule,
    DEALER_RULES,
    REACH_WIDE_SINCE,
    ruleRolls,
    ruleKeyOf
  } from '@/pages/examples/blackjack/relay-items.uts'

  // 图鉴里的一段：永续一段、限制一段
  type ItemGroup = {
    title : string
    items : RelayItem[]
  }

  const save = ref<SaveData>(emptySave())
  // 当前在第几个排竿槽上。跟道具格（runSlots）是两件事，别看混
  const slotIndex = ref<number>(1)
  // 模板里要读 RELAY_ITEMS.length，得有个本地名字接一下
  const ITEMS = RELAY_ITEMS
  const RULES = DEALER_RULES
  const itemGroups = ref<ItemGroup[]>(buildGroups())
  const dealerRules = ref<DealerRule[]>(sortedRules())

  // 按类分两段。显式分一遍而不是指望表本身就是排好的 ——
  // 那张表将来增删挪动都可能，指望它的顺序等于把这页的显示押在别处的排版上
  function buildGroups() : ItemGroup[] {
    const lasting : RelayItem[] = []
    const limited : RelayItem[] = []
    for (let i = 0; i < RELAY_ITEMS.length; i++) {
      if (RELAY_ITEMS[i].kind == KIND_LASTING) {
        lasting.push(RELAY_ITEMS[i])
      } else {
        limited.push(RELAY_ITEMS[i])
      }
    }
    const list : ItemGroup[] = []
    list.push({ title: '永续 · 装上就一直管用', items: lasting } as ItemGroup)
    list.push({ title: '限制 · 排竿时用，每局几次', items: limited } as ItemGroup)
    return list
  }

  // 庄家那排规矩，按「第几关起摇得到」排开。
  //
  // 表本身是按主题写的，不保证按 since 有序（长手就从第 5 关挪到了第 7 关，
  // 位置没跟着动）。这儿显式排一遍 —— 这一段的用处正是让人看出
  // 「这条路往后会冒出什么」，乱序摆等于把那条时间线打散了。
  // 每轮挑一个还没用过的最小 since。严格小于，所以同一关起的几条
  // 保持表里的先后 —— 稳定排序，读表的人对得上原表
  function sortedRules() : DealerRule[] {
    const out : DealerRule[] = []
    const used : boolean[] = []
    for (let i = 0; i < DEALER_RULES.length; i++) {
      used.push(false)
    }
    for (let n = 0; n < DEALER_RULES.length; n++) {
      let best = -1
      for (let i = 0; i < DEALER_RULES.length; i++) {
        if (used[i]) {
          continue
        }
        if (best < 0 || DEALER_RULES[i].since < DEALER_RULES[best].since) {
          best = i
        }
      }
      if (best < 0) {
        break
      }
      used[best] = true
      out.push(DEALER_RULES[best])
    }
    return out
  }

  const ruleGroupTitle = '庄家 · 它挂的规矩（摇到哪几条看关号）'

  // 中间那行：从第几关起摇得到，带不带随机参数。
  // 门槛要写出来 —— 玩家得看得出「这条现在还轮不到我操心」。
  //
  // 参数写「摇到时定」而不是「每关重摇」：规矩一摇到就连参数一起固定，
  // 一路跟到这一轮结束（见 relay-items 的 rollDealerRules）
  function ruleTag(rule : DealerRule) : string {
    const head = '第 ' + rule.since + ' 关起'
    return ruleRolls(rule.key) ? head + ' · 参数摇到时定，之后不变' : head
  }

  // 长手那条的参数自己还有一道门槛（±2 比 ±1 凶一倍），
  // 图鉴里不写的话，看到「±1」的人会以为它就这么大
  function ruleDesc(rule : DealerRule) : string {
    if (rule.key == 'reach') {
      return rule.desc + '；±2 那一版第 ' + REACH_WIDE_SINCE + ' 关起才摇得到'
    }
    return rule.desc
  }

  // 这一轮眼下那一关挂着的，标出来。
  // runRules 存的始终是 runLevel 那一关的规矩 —— 在商店里就是下一关的，
  // 所以标签跟着 runLevel 写关号，不写「这一关」
  function ruleOn(key : string) : boolean {
    if (!alive.value) {
      return false
    }
    const list = save.value.runRules
    for (let i = 0; i < list.length; i++) {
      if (ruleKeyOf(list[i]) == key) {
        return true
      }
    }
    return false
  }

  // 图鉴里一律按普通档的说明展示 —— 那是你买到手时的样子。
  // 手头已经升过的，等级另外标在右边
  function itemDesc(item : RelayItem) : string {
    return itemDescAt(item, 0)
  }

  function tierOf(key : string) : number {
    return itemTierOf(save.value, key)
  }

  const showItems = ref<boolean>(false)

  const alive = computed<boolean>(() : boolean => {
    return runAlive(save.value) && save.value.runLevel <= RELAY_COUNT
  })

  const slotLabel = computed<string>(() : string => {
    return save.value.label == '' ? '存档 ' + slotIndex.value : save.value.label
  })

  const bestText = computed<string>(() : string => {
    return save.value.relayBest <= 0 ? '未通关' : save.value.relayBest + '/' + RELAY_COUNT
  })

  const runText = computed<string>(() : string => {
    if (!runAlive(save.value)) {
      return '未开始'
    }
    const lv = save.value.runLevel
    return lv > RELAY_COUNT ? '已通关' : '第 ' + lv + ' 关'
  })

  // 图鉴里给「眼下这一关挂着」的规矩打的标。写关号不写「这一关」——
  // 在商店里的时候 runRules 说的是下一关，写死「这一关」就是错的
  const runLabel = computed<string>(() : string => {
    return '第 ' + save.value.runLevel + ' 关'
  })

  const resumeText = computed<string>(() : string => {
    if (save.value.runShop) {
      return '回商店（下一关 ' + save.value.runLevel + '）'
    }
    return '继续第 ' + save.value.runLevel + ' 关'
  })

  // 这一轮手头攒了些什么，一句话交代。
  // 同名道具只会有一件，所以数的是「有几件」，不是「几张」
  const carryText = computed<string>(() : string => {
    const data = save.value
    let owned = 0
    for (let i = 0; i < data.runTiers.length; i++) {
      if (data.runTiers[i] > 0) {
        owned = owned + 1
      }
    }
    return '道具 ' + owned + ' 件 · 道具栏 ' + data.runSlots + ' 格 · 金币 '
      + data.runCoins
  })

  // 接着上次那儿打。中途退出去的进度都存着。
  //
  // 上次停在商店就回商店 —— 在店里退出去的人多半是东西还没买完，
  // 直接推上牌桌等于把那一关的准备时间吞了
  function resume() {
    if (save.value.runShop) {
      uni.navigateTo({
        url: '/pages/examples/blackjack/relay-shop'
      })
      return
    }
    setCurrentRelayLevel(save.value.runLevel)
    uni.navigateTo({
      url: '/pages/examples/blackjack/relay'
    })
  }

  function startFresh() {
    const data = save.value
    resetRun(data)
    saveRelay(data)
    save.value = cloneSave(data)
    setCurrentRelayLevel(data.runLevel)
    uni.navigateTo({
      url: '/pages/examples/blackjack/relay'
    })
  }

  // 推倒重来：跟打输了一个下场，问一句再动手
  function askRestart() {
    uni.showModal({
      title: '重新开始？',
      content: '这一轮的金币和道具全清，从第一关重打。',
      confirmText: '重来',
      cancelText: '再想想',
      success: (res) => {
        if (res.confirm) {
          startFresh()
        }
      }
    })
  }

  function openItems() {
    showItems.value = true
  }

  function closeAll() {
    showItems.value = false
  }

  // 面板里面点着不关，交给外面那层遮罩关
  function noop() {}

  // 存档页两个游戏共用，所以得告诉它现在选的是排竿的档。
  // 回来时 onShow 会重读，切了槽自动就刷新了
  function chooseSave() {
    uni.navigateTo({
      url: '/pages/examples/blackjack/saves?scope=relay'
    })
  }

  function goBack() {
    uni.navigateBack()
  }

  // 读档和读槽号要一起做 —— 摘要那行要报槽号，漏一处就永远显示「存档 1」
  function reload() {
    slotIndex.value = relaySaveSlot()
    save.value = loadRelaySave()
  }

  onShow(() => {
    reload()
    closeAll()
  })

  reload()
</script>

<style>
  .page {
    flex: 1;
    padding: 12px;
    background-color: #0b5d3b;
  }

  .hero {
    align-items: center;
    margin-bottom: 10px;
  }

  .hero-title {
    color: #e8b23a;
    font-size: 30px;
    font-weight: bold;
  }

  .hero-sub {
    color: #9fd9bd;
    font-size: 11px;
    margin-top: 2px;
  }

  /* 「存档 排竿 2」那一行，居中摆在统计条上头 */
  .slot-line {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-bottom: 6px;
  }

  .slot-tip {
    color: #9fd9bd;
    font-size: 11px;
    margin-right: 6px;
  }

  .slot-name {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
  }

  .head {
    flex-direction: row;
    justify-content: space-between;
    background-color: #084730;
    border-radius: 8px;
    padding: 8px 12px;
  }

  .head-item {
    flex: 1;
    align-items: center;
  }

  .head-label {
    color: #9fd9bd;
    font-size: 11px;
  }

  .head-value {
    color: #ffffff;
    font-size: 17px;
    font-weight: bold;
  }

  .head-coin {
    color: #ffd54f;
  }

  .rule {
    background-color: #084730;
    border-radius: 8px;
    padding: 8px 10px;
    margin-top: 8px;
  }

  .rule-text {
    color: #cfeade;
    font-size: 11px;
    line-height: 16px;
  }

  .carry {
    margin-top: 8px;
    padding: 0 2px;
  }

  .carry-text {
    color: #9fd9bd;
    font-size: 11px;
  }

  /* 按钮竖排，占满剩下的地方 */
  .menu {
    flex: 1;
    justify-content: center;
  }

  .menu-btn {
    height: 46px;
    border-radius: 23px;
    margin-top: 10px;
    align-items: center;
    justify-content: center;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .menu-btn-primary {
    background-color: #e8b23a;
  }

  .menu-btn-warn {
    border-color: #ff9e80;
  }

  .menu-btn-text {
    color: #e8b23a;
    font-size: 16px;
    font-weight: bold;
  }

  .menu-btn-text-dark {
    color: #3b2a00;
  }

  .menu-btn-text-warn {
    color: #ff9e80;
  }

  /* 图鉴面板 */
  .layer {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(3, 20, 13, 0.82);
    align-items: center;
    justify-content: center;
    padding: 18px;
  }

  .panel {
    width: 100%;
    max-height: 80%;
    background-color: #0e6b45;
    border-radius: 12px;
    padding: 14px;
    border-width: 2px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .panel-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
  }

  .panel-title {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
  }

  .panel-sub {
    color: #9fd9bd;
    font-size: 11px;
  }

  .panel-body {
    max-height: 400px;
    margin-top: 8px;
  }

  .group {
    color: #e8b23a;
    font-size: 11px;
    font-weight: bold;
    margin-top: 6px;
    margin-bottom: 2px;
  }

  .entry {
    background-color: #12764e;
    border-radius: 8px;
    padding: 6px 9px;
    margin-bottom: 5px;
  }

  .entry-top {
    flex-direction: row;
    align-items: center;
  }

  .entry-name {
    font-size: 14px;
    font-weight: bold;
    margin-right: 6px;
  }

  .entry-name-plain {
    color: #ffffff;
  }

  /* 稀有度和上限，占中间那段 */
  .entry-tag {
    flex: 1;
    color: #9fd9bd;
    font-size: 10px;
  }

  /* 这一轮攒了几张。没在挑战中就不显示 */
  .entry-own {
    color: #ffd54f;
    font-size: 12px;
    font-weight: bold;
  }

  .entry-desc {
    color: #cfeade;
    font-size: 10px;
    line-height: 14px;
    margin-top: 2px;
  }

  .panel-close {
    color: #e8b23a;
    font-size: 13px;
    font-weight: bold;
    text-align: center;
    margin-top: 10px;
  }
</style>
