<template>
  <view class="page">
    <view class="hero">
      <text class="hero-title">排竿</text>
      <text class="hero-sub">提前排好五张的出竿顺序，双方交替自动打完</text>
    </view>

    <view class="head">
      <view class="head-item">
        <text class="head-label">最远战绩</text>
        <text id="rv-best" class="head-value">{{ bestText }}</text>
      </view>
      <view class="head-item">
        <text class="head-label">本轮进度</text>
        <text id="rv-run" class="head-value">{{ runText }}</text>
      </view>
      <view class="head-item">
        <text class="head-label">金币</text>
        <text id="rv-coins" class="head-value head-coin">{{ save.runCoins }}</text>
      </view>
    </view>

    <view class="rule">
      <text class="rule-text"
        >一轮挑战连打 {{ RELAY_COUNT }} 关。赢一关拿金币，进商店买贴纸、道具、贴纸位，
        再进下一关。输一局这一轮就结束 —— 金币、贴纸、道具全清，从第一关重来。</text
      >
    </view>

    <!-- 有正打着的一轮时，把家当摊开说一句 -->
    <view v-if="alive" class="carry">
      <text class="carry-text">{{ carryText }}</text>
    </view>

    <view class="menu">
      <view
        v-if="alive"
        id="rv-go"
        class="menu-btn menu-btn-primary"
        @click="resume">
        <text class="menu-btn-text menu-btn-text-dark">{{ resumeText }}</text>
      </view>
      <view
        v-else
        id="rv-start"
        class="menu-btn menu-btn-primary"
        @click="startFresh">
        <text class="menu-btn-text menu-btn-text-dark">开始挑战</text>
      </view>
      <view v-if="alive" id="rv-restart" class="menu-btn menu-btn-warn" @click="askRestart">
        <text class="menu-btn-text menu-btn-text-warn">重新开始</text>
      </view>
      <view id="rv-stickers" class="menu-btn" @click="openStickers">
        <text class="menu-btn-text">贴纸信息</text>
      </view>
      <view id="rv-items" class="menu-btn" @click="openItems">
        <text class="menu-btn-text">道具信息</text>
      </view>
      <view id="rv-back" class="menu-btn" @click="goBack">
        <text class="menu-btn-text">返回</text>
      </view>
    </view>

    <!-- 贴纸图鉴：这个模式认得的那些，带上这一轮攒了几张 -->
    <view v-if="showStickers" class="layer" @click="closeAll">
      <view class="panel" @click.stop="noop">
        <view class="panel-head">
          <text class="panel-title">贴纸信息</text>
          <text class="panel-sub">{{ poolKeys.length }} 种能用</text>
        </view>
        <!-- 按稀有度分段，低的在前。同一档的挨在一起才看得出
             「这一档有哪些可选」，混着排只能一条条找 -->
        <scroll-view class="panel-body">
          <view v-for="(grp, gi) in poolGroups" :key="'gp-' + gi">
            <text class="group" :style="'color: ' + rarityColor(grp.rarity)"
              >{{ rarityName(grp.rarity) }} · {{ grp.keys.length }} 种 · 最多攒
              {{ rarityOwn(grp.rarity) }} 张</text
            >
            <view
              v-for="(key, si) in grp.keys"
              :key="'sk-' + gi + '-' + si"
              :id="'rv-sk-' + key"
              class="entry">
              <view class="entry-top">
                <text class="entry-name" :style="'color: ' + colorOf(key)">{{ nameOf(key) }}</text>
                <!-- 中间这段撑开，把持有数顶到右边 -->
                <text class="entry-tag"> </text>
                <text v-if="alive" class="entry-own">{{ ownedOf(key) }}</text>
              </view>
              <text class="entry-desc">{{ descOf(key) }}</text>
            </view>
          </view>
        </scroll-view>
        <text class="panel-close" @click.stop="closeAll">收起来</text>
      </view>
    </view>

    <!-- 道具图鉴：常驻的和一次性的分开列 -->
    <view v-if="showItems" class="layer" @click="closeAll">
      <view class="panel" @click.stop="noop">
        <view class="panel-head">
          <text class="panel-title">道具信息</text>
          <text class="panel-sub">商店里买</text>
        </view>
        <scroll-view class="panel-body">
          <text class="group">常驻 · 买了这一轮一直管用</text>
          <view v-for="(it, ii) in RELAY_ITEMS" :key="'it-' + ii" class="entry">
            <view class="entry-top">
              <text class="entry-name entry-name-plain">{{ it.name }}</text>
              <text class="entry-tag">{{ it.price }} 金币</text>
              <text v-if="alive && ownItem(it.key)" class="entry-own">已有</text>
            </view>
            <text class="entry-desc">{{ it.desc }}</text>
          </view>
          <text class="group">消耗 · 局内用掉就没</text>
          <view v-for="(kt, ki) in KIT_ITEMS" :key="'kt-' + ki" class="entry">
            <view class="entry-top">
              <text class="entry-name entry-name-plain">{{ kt.name }}</text>
              <text class="entry-tag">{{ kt.price }} 金币</text>
              <text v-if="alive" class="entry-own">{{ kitHave(kt.key) }}</text>
            </view>
            <text class="entry-desc">{{ kt.desc }}</text>
          </view>
        </scroll-view>
        <text class="panel-close" @click.stop="closeAll">收起来</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  // 排竿的入口页：看战绩、接着打、或者推倒重来，顺便查贴纸和道具。
  //
  // 这里不列关卡 —— 十关是一条连着打的路，打到哪一关由这一轮的进度说了算，
  // 输一局就从头来。「挑关卡」这件事本身不存在，列出来只会让人以为能挑
  import {
    RARITIES,
    stickerAt,
    rarityAt
  } from '@/pages/examples/blackjack/stickers.uts'
  import {
    SaveData,
    emptySave,
    loadCurrentSave,
    saveCurrent,
    cloneSave,
    resetRun,
    runAlive,
    runOwnedOf,
    kitCountOf,
    setCurrentRelayLevel
  } from '@/pages/examples/blackjack/save.uts'
  import {
    RELAY_COUNT,
    RELAY_ITEMS,
    KIT_ITEMS,
    hasItem,
    relayStickerPool
  } from '@/pages/examples/blackjack/relay-levels.uts'

  // 一档贴纸：稀有度 + 这一档有哪些
  type PoolGroup = {
    rarity : number
    keys : string[]
  }

  const save = ref<SaveData>(emptySave())
  const poolKeys = ref<string[]>(relayStickerPool())
  const poolGroups = ref<PoolGroup[]>(buildGroups())

  // 按稀有度分组，低的在前。
  //
  // 显式分一遍而不是指望 STICKERS 表本来就是排好的 —— 那张表将来
  // 增删挪动都可能，指望它的顺序等于把这页的显示押在别处的排版上
  function buildGroups() : PoolGroup[] {
    const raw = relayStickerPool()
    const list : PoolGroup[] = []
    for (let r = 0; r < RARITIES.length; r++) {
      const keys : string[] = []
      for (let i = 0; i < raw.length; i++) {
        if (stickerAt(raw[i]).rarity == r) {
          keys.push(raw[i])
        }
      }
      if (keys.length > 0) {
        list.push({ rarity: r, keys: keys } as PoolGroup)
      }
    }
    return list
  }

  function rarityName(rarity : number) : string {
    return rarityAt(rarity).name
  }

  function rarityColor(rarity : number) : string {
    return rarityAt(rarity).color
  }

  function rarityOwn(rarity : number) : number {
    return rarityAt(rarity).own
  }
  const showStickers = ref<boolean>(false)
  const showItems = ref<boolean>(false)

  const alive = computed<boolean>(() : boolean => {
    return runAlive(save.value) && save.value.runLevel <= RELAY_COUNT
  })

  const bestText = computed<string>(() : string => {
    return save.value.relayBest <= 0 ? '未通关' : save.value.relayBest + '/' + RELAY_COUNT
  })

  const runText = computed<string>(() : string => {
    if (!runAlive(save.value)) {
      return '未开始'
    }
    const lv = save.value.runLevel
    return lv > RELAY_COUNT ? '已通关' : '第 ' + lv + ' 关'
  })

  const resumeText = computed<string>(() : string => {
    if (save.value.runShop) {
      return '回商店（下一关 ' + save.value.runLevel + '）'
    }
    return '继续第 ' + save.value.runLevel + ' 关'
  })

  // 这一轮手头攒了些什么，一句话交代
  const carryText = computed<string>(() : string => {
    const data = save.value
    let owned = 0
    for (let i = 0; i < data.runOwned.length; i++) {
      owned = owned + data.runOwned[i]
    }
    let kits = 0
    for (let i = 0; i < data.runKits.length; i++) {
      kits = kits + data.runKits[i]
    }
    return '贴纸 ' + owned + ' 张 · 贴纸位 ' + data.runSlots + ' 个 · 道具 '
      + data.runItems.length + ' 件 · 消耗品 ' + kits + ' 个'
  })

  function nameOf(key : string) : string {
    return stickerAt(key).name
  }

  function descOf(key : string) : string {
    return stickerAt(key).desc
  }

  function colorOf(key : string) : string {
    return rarityAt(stickerAt(key).rarity).color
  }

  function ownedOf(key : string) : number {
    return runOwnedOf(save.value, key)
  }

  function ownItem(key : string) : boolean {
    return hasItem(save.value.runItems, key)
  }

  function kitHave(key : string) : number {
    return kitCountOf(save.value, key)
  }

  // 接着上次那儿打。中途退出去的进度都存着。
  //
  // 上次停在商店就回商店 —— 在店里退出去的人多半是东西还没买完，
  // 直接推上牌桌等于把那一关的准备时间吞了
  function resume() {
    if (save.value.runShop) {
      uni.navigateTo({
        url: '/pages/examples/blackjack/relay-shop'
      })
      return
    }
    setCurrentRelayLevel(save.value.runLevel)
    uni.navigateTo({
      url: '/pages/examples/blackjack/relay'
    })
  }

  function startFresh() {
    const data = save.value
    resetRun(data)
    saveCurrent(data)
    save.value = cloneSave(data)
    setCurrentRelayLevel(data.runLevel)
    uni.navigateTo({
      url: '/pages/examples/blackjack/relay'
    })
  }

  // 推倒重来：跟打输了一个下场，问一句再动手
  function askRestart() {
    uni.showModal({
      title: '重新开始？',
      content: '这一轮的金币、贴纸、道具全清，从第一关重打。',
      confirmText: '重来',
      cancelText: '再想想',
      success: (res) => {
        if (res.confirm) {
          startFresh()
        }
      }
    })
  }

  function openStickers() {
    showItems.value = false
    showStickers.value = true
  }

  function openItems() {
    showStickers.value = false
    showItems.value = true
  }

  function closeAll() {
    showStickers.value = false
    showItems.value = false
  }

  // 面板里面点着不关，交给外面那层遮罩关
  function noop() {}

  function goBack() {
    uni.navigateBack()
  }

  onShow(() => {
    save.value = loadCurrentSave()
    closeAll()
  })

  save.value = loadCurrentSave()
</script>

<style>
  .page {
    flex: 1;
    padding: 12px;
    background-color: #0b5d3b;
  }

  .hero {
    align-items: center;
    margin-bottom: 10px;
  }

  .hero-title {
    color: #e8b23a;
    font-size: 30px;
    font-weight: bold;
  }

  .hero-sub {
    color: #9fd9bd;
    font-size: 11px;
    margin-top: 2px;
  }

  .head {
    flex-direction: row;
    justify-content: space-between;
    background-color: #084730;
    border-radius: 8px;
    padding: 8px 12px;
  }

  .head-item {
    flex: 1;
    align-items: center;
  }

  .head-label {
    color: #9fd9bd;
    font-size: 11px;
  }

  .head-value {
    color: #ffffff;
    font-size: 17px;
    font-weight: bold;
  }

  .head-coin {
    color: #ffd54f;
  }

  .rule {
    background-color: #084730;
    border-radius: 8px;
    padding: 8px 10px;
    margin-top: 8px;
  }

  .rule-text {
    color: #cfeade;
    font-size: 11px;
    line-height: 16px;
  }

  .carry {
    margin-top: 8px;
    padding: 0 2px;
  }

  .carry-text {
    color: #9fd9bd;
    font-size: 11px;
  }

  /* 按钮竖排，占满剩下的地方 */
  .menu {
    flex: 1;
    justify-content: center;
  }

  .menu-btn {
    height: 46px;
    border-radius: 23px;
    margin-top: 10px;
    align-items: center;
    justify-content: center;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .menu-btn-primary {
    background-color: #e8b23a;
  }

  .menu-btn-warn {
    border-color: #ff9e80;
  }

  .menu-btn-text {
    color: #e8b23a;
    font-size: 16px;
    font-weight: bold;
  }

  .menu-btn-text-dark {
    color: #3b2a00;
  }

  .menu-btn-text-warn {
    color: #ff9e80;
  }

  /* 图鉴面板 */
  .layer {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(3, 20, 13, 0.82);
    align-items: center;
    justify-content: center;
    padding: 18px;
  }

  .panel {
    width: 100%;
    max-height: 80%;
    background-color: #0e6b45;
    border-radius: 12px;
    padding: 14px;
    border-width: 2px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .panel-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
  }

  .panel-title {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
  }

  .panel-sub {
    color: #9fd9bd;
    font-size: 11px;
  }

  .panel-body {
    max-height: 400px;
    margin-top: 8px;
  }

  .group {
    color: #e8b23a;
    font-size: 11px;
    font-weight: bold;
    margin-top: 6px;
    margin-bottom: 2px;
  }

  .entry {
    background-color: #12764e;
    border-radius: 8px;
    padding: 6px 9px;
    margin-bottom: 5px;
  }

  .entry-top {
    flex-direction: row;
    align-items: center;
  }

  .entry-name {
    font-size: 14px;
    font-weight: bold;
    margin-right: 6px;
  }

  .entry-name-plain {
    color: #ffffff;
  }

  /* 稀有度和上限，占中间那段 */
  .entry-tag {
    flex: 1;
    color: #9fd9bd;
    font-size: 10px;
  }

  /* 这一轮攒了几张。没在挑战中就不显示 */
  .entry-own {
    color: #ffd54f;
    font-size: 12px;
    font-weight: bold;
  }

  .entry-desc {
    color: #cfeade;
    font-size: 10px;
    line-height: 14px;
    margin-top: 2px;
  }

  .panel-close {
    color: #e8b23a;
    font-size: 13px;
    font-weight: bold;
    text-align: center;
    margin-top: 10px;
  }
</style>
