<template>
  <view class="page">
    <view class="head">
      <view class="head-item">
        <text class="head-label">兑换券</text>
        <text id="bj-levels-tickets" class="head-value">{{ ticketCount }}</text>
      </view>
      <view class="head-item">
        <text class="head-label">已通关</text>
        <text id="bj-levels-cleared" class="head-value"
          >{{ save.cleared.length }}/{{ LEVEL_COUNT }}</text
        >
      </view>
      <view class="head-item">
        <text class="head-label">牌组贴纸</text>
        <text id="bj-levels-deck" class="head-value">{{ stuckCount }}</text>
      </view>
    </view>

    <view class="legend">
      <text class="legend-text">通关给同档券，重打给退换券 · 前三档教机制，传说六关才是六条流派</text>
    </view>

    <!-- 一档一行。各档关卡数不一样（4/5/6/6），行长跟着变 ——
         同一行的解锁条件一样，所以「现在能打哪些」看一行就够 -->
    <scroll-view class="fields">
      <view v-for="(row, ti) in tiers" :key="'t-' + ti" class="field">
        <view class="field-head">
          <text class="field-name" :style="'color: ' + rarityAt(ti).color"
            >{{ TIER_NAMES[ti] }}</text
          >
          <text class="field-tag">{{ tierNote(ti) }}</text>
          <text class="field-done">{{ doneOf(ti) }}/{{ row.length }}</text>
        </view>
        <view class="grid">
          <view
            v-for="level in row"
            :key="level.index"
            class="cell"
            :id="'bj-level-' + level.index"
            @click="enterLevel(level)">
            <view
              class="cell-inner"
              :class="{
                'cell-locked': !playable(level) && !cleared(level),
                'cell-cleared': cleared(level)
              }">
              <text class="cell-name" :style="'color: ' + tierColor(level)">{{ level.short }}</text>
              <!-- 传说关才有流派，写在名字下面；前三档这一格留给状态 -->
              <text v-if="level.spot >= 0" class="cell-tag">{{ FIELD_TAGS[level.spot] }}</text>
              <text class="cell-state" :class="{ 'cell-state-lock': !playable(level) }">{{
                stateOf(level)
              }}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view id="bj-levels-back" class="back-btn" @click="goBack">
      <text class="back-text">返回</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { countStuck } from '@/pages/examples/blackjack/cards.uts'
  import { rarityAt } from '@/pages/examples/blackjack/stickers.uts'
  import {
    SaveData,
    loadCurrentSave,
    emptySave,
    setCurrentLevel,
    sumOf
  } from '@/pages/examples/blackjack/save.uts'
  import {
    Level,
    LEVEL_COUNT,
    TIER_COUNT,
    FIELD_TAGS,
    TIER_NAMES,
    levelsOfTier,
    isPlayable,
    isCleared,
    tierGate,
    gateLeft
  } from '@/pages/examples/blackjack/levels.uts'

  const save = ref<SaveData>(emptySave())
  // 四个难度档，一档一行。行长不齐是有意的：
  // 入门 4、进阶 5、困难 6、传说 6，越往下内容越厚
  const tiers = ref<Level[][]>(buildTiers())

  function buildTiers() : Level[][] {
    const list : Level[][] = []
    for (let i = 0; i < TIER_COUNT; i++) {
      list.push(levelsOfTier(i))
    }
    return list
  }

  const stuckCount = computed<number>(() : number => {
    return countStuck(save.value.stuck)
  })

  const ticketCount = computed<number>(() : number => {
    return sumOf(save.value.tickets)
  })

  // 入门那一档随时能打，往上每档要求总通关数够门槛
  function playable(level : Level) : boolean {
    return isPlayable(level.index, save.value.cleared)
  }

  function cleared(level : Level) : boolean {
    return isCleared(level.index, save.value.cleared)
  }

  // 这一档通了几关
  function doneOf(tier : number) : number {
    const list = tiers.value[tier]
    let done = 0
    for (let i = 0; i < list.length; i++) {
      if (cleared(list[i])) {
        done = done + 1
      }
    }
    return done
  }

  // 行头写这一档怎么开。同一行的条件都一样，写一次就够
  function tierNote(tier : number) : string {
    const gate = tierGate(tier)
    return gate > 0 ? '需先通 ' + gate + ' 关' : '随时可打'
  }

  // 关名用档次的颜色写，跟贴纸稀有度一致 —— 这一关放的就是那一档的贴纸。
  // 难度、奖励、回合都按档次定死，统一写在列表上方那行，格子里不重复
  function tierColor(level : Level) : string {
    return rarityAt(level.tier).color
  }

  function stateOf(level : Level) : string {
    if (cleared(level)) {
      return '已通关'
    }
    if (playable(level)) {
      return '可挑战'
    }
    // 锁上只有一种原因：总通关数不够。格子只有六分之一屏宽，
    // 这里能塞下的就三四个字
    return '差 ' + gateLeft(level.index, save.value.cleared) + ' 关'
  }

  function enterLevel(level : Level) {
    if (!playable(level)) {
      const left = gateLeft(level.index, save.value.cleared)
      uni.showToast({
        icon: 'none',
        title: '这一档要先通关 ' + tierGate(level.tier) + ' 关，还差 ' + left + ' 关'
      })
      return
    }
    setCurrentLevel(level.index)
    uni.navigateTo({
      url: '/pages/examples/blackjack/fishing'
    })
  }

  function goBack() {
    uni.navigateBack()
  }

  onShow(() => {
    save.value = loadCurrentSave()
  })

  save.value = loadCurrentSave()
</script>

<style>
  .page {
    flex: 1;
    padding: 12px;
    background-color: #0b5d3b;
  }

  .head {
    flex-direction: row;
    justify-content: space-between;
    background-color: #084730;
    border-radius: 8px;
    padding: 8px 12px;
  }

  .head-item {
    flex: 1;
    align-items: center;
  }

  .head-label {
    color: #9fd9bd;
    font-size: 11px;
  }

  .head-value {
    color: #ffffff;
    font-size: 17px;
    font-weight: bold;
  }

  /* 四关的档次、奖励、回合都按位次定死，统一说一次 */
  .legend {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 6px;
    padding: 0 2px;
  }

  .legend-text {
    color: #9fd9bd;
    font-size: 9px;
  }

  /* 四个档次竖着排，整页能滚 */
  .fields {
    flex: 1;
    margin-top: 4px;
  }

  .field {
    margin-bottom: 6px;
  }

  .field-head {
    flex-direction: row;
    align-items: center;
    padding: 0 4px;
  }

  .field-name {
    color: #e8b23a;
    font-size: 14px;
    font-weight: bold;
    margin-right: 6px;
  }

  /* 这一档怎么开。同一行的条件都一样，写一次就够 */
  .field-tag {
    flex: 1;
    color: #9fd9bd;
    font-size: 10px;
  }

  .field-done {
    color: #cfeade;
    font-size: 11px;
  }

  /* 一档一行，从上到下就是入门、进阶、困难、传说。
     各档关卡数不一样，所以格子宽度按最长的那一档（6 关）定死 ——
     按行内数量均分的话入门那四格会胖一圈，四行就参差不齐了 */
  .grid {
    flex-direction: row;
    margin-top: 2px;
  }

  .cell {
    width: 16.66%;
    padding: 2px;
    height: 56px;
  }

  .cell-inner {
    flex: 1;
    background-color: #0e6b45;
    border-radius: 8px;
    padding: 6px 3px;
    border-width: 1px;
    border-style: solid;
    border-color: #0e6b45;
    justify-content: center;
  }

  .cell-cleared {
    border-color: #e8b23a;
  }

  .cell-locked {
    background-color: #084730;
    opacity: 0.6;
  }

  /* 格子里写关卡短名，档次靠颜色和行头表达 */
  .cell-name {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
    text-align: center;
  }

  /* 传说关才有的流派标 —— 那一档六关就是六条路，
     光看「浅滩」不知道它教什么 */
  .cell-tag {
    color: #e8b23a;
    font-size: 9px;
    text-align: center;
  }

  /* 六列之后格子只有六分之一屏宽，这行得压到 9px 才不挤 */
  .cell-state {
    color: #8fc7ab;
    font-size: 9px;
    text-align: center;
  }

  .cell-state-lock {
    color: #ff8a80;
  }

  .back-btn {
    height: 42px;
    border-radius: 21px;
    margin-top: 6px;
    align-items: center;
    justify-content: center;
    background-color: #084730;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .back-text {
    color: #e8b23a;
    font-size: 15px;
    font-weight: bold;
  }
</style>
