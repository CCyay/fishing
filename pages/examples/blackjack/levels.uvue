<template>
  <view class="page">
    <view class="head">
      <view class="head-item">
        <text class="head-label">兑换券</text>
        <text id="bj-levels-tickets" class="head-value">{{ ticketCount }}</text>
      </view>
      <view class="head-item">
        <text class="head-label">已通关</text>
        <text id="bj-levels-cleared" class="head-value"
          >{{ save.cleared.length }}/{{ LEVEL_COUNT }}</text
        >
      </view>
      <view class="head-item">
        <text class="head-label">牌组贴纸</text>
        <text id="bj-levels-deck" class="head-value">{{ stuckCount }}</text>
      </view>
    </view>

    <!-- 四关的档次、奖励、回合都是按位次定死的，统一在这儿说一次，
         省得每个格子里重复一遍 -->
    <view class="legend">
      <text class="legend-text">每场四关</text>
      <text
        v-for="rarity in rarities"
        :key="'lg-' + rarity.id"
        class="legend-tier"
        :style="'color: ' + rarity.color"
        >{{ rarity.name }}</text
      >
      <text class="legend-text"
        >· 通关给同档券，重打给退换券 · 史诗关要先通 6 关、传说关 12 关（跨钓场算）</text
      >
    </view>

    <!-- 六个钓场各一行，一行四关。普通关随时能打，往后每关要求同场上一关先通 -->
    <scroll-view class="fields">
      <view v-for="(field, fi) in fields" :key="'f-' + fi" class="field">
        <view class="field-head">
          <text class="field-name">{{ FIELD_NAMES[fi] }}</text>
          <text class="field-tag">{{ FIELD_TAGS[fi] }}</text>
          <text class="field-done">{{ doneOf(fi) }}/{{ FIELD_TIERS }}</text>
        </view>
        <view class="grid">
          <view
            v-for="level in field"
            :key="level.index"
            class="cell"
            :id="'bj-level-' + level.index"
            @click="enterLevel(level)">
            <view
              class="cell-inner"
              :class="{
                'cell-locked': !playable(level) && !cleared(level),
                'cell-cleared': cleared(level)
              }">
              <text class="cell-name" :style="'color: ' + tierColor(level)">{{
                tailName(level)
              }}</text>
              <text class="cell-state" :class="{ 'cell-state-lock': !playable(level) }">{{
                stateOf(level)
              }}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view id="bj-levels-back" class="back-btn" @click="goBack">
      <text class="back-text">返回</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import { countStuck } from '@/pages/examples/blackjack/cards.uts'
  import { Rarity, RARITIES, rarityAt } from '@/pages/examples/blackjack/stickers.uts'
  import {
    SaveData,
    loadCurrentSave,
    emptySave,
    setCurrentLevel,
    sumOf
  } from '@/pages/examples/blackjack/save.uts'
  import {
    Level,
    LEVEL_COUNT,
    FIELD_TIERS,
    FIELD_NAMES,
    FIELD_TAGS,
    levelsOfField,
    fieldCount,
    isPlayable,
    isCleared,
    tierGate,
    gateLeft
  } from '@/pages/examples/blackjack/levels.uts'

  const save = ref<SaveData>(emptySave())
  const rarities = ref<Rarity[]>(RARITIES)
  // 六个钓场，每个钓场四关。列表按钓场分行，一眼看得出有几条路可走
  const fields = ref<Level[][]>(buildFields())

  function buildFields() : Level[][] {
    const list : Level[][] = []
    for (let i = 0; i < fieldCount(); i++) {
      list.push(levelsOfField(i))
    }
    return list
  }

  const stuckCount = computed<number>(() : number => {
    return countStuck(save.value.stuck)
  })

  const ticketCount = computed<number>(() : number => {
    return sumOf(save.value.tickets)
  })

  // 普通关随时能打，往后每关要求同一个钓场的上一关先通
  function playable(level : Level) : boolean {
    return isPlayable(level.index, save.value.cleared)
  }

  function cleared(level : Level) : boolean {
    return isCleared(level.index, save.value.cleared)
  }

  // 这个钓场通了几关
  function doneOf(field : number) : number {
    const list = fields.value[field]
    let done = 0
    for (let i = 0; i < list.length; i++) {
      if (cleared(list[i])) {
        done = done + 1
      }
    }
    return done
  }

  // 关卡名是「钓场 · 关名」，钓场那半截已经写在行头上了，格子里只留后半截
  function tailName(level : Level) : string {
    const parts = level.name.split(' · ')
    return parts.length > 1 ? parts[1] : level.name
  }


  // 关名用档次的颜色写，跟贴纸稀有度一致 —— 这一关放的就是那一档的贴纸。
  // 难度、奖励、回合都按位次定死，统一写在列表上方那行，格子里不重复
  function tierColor(level : Level) : string {
    return rarityAt(level.tier).color
  }

  function stateOf(level : Level) : string {
    if (cleared(level)) {
      return '已通关'
    }
    if (playable(level)) {
      return '可挑战'
    }
    // 卡在门槛上就写还差几关，卡在前一关就写「先过上一关」——
    // 两种锁法原因不同，混成一句「未解锁」等于没说
    const left = gateLeft(level.index, save.value.cleared)
    if (left > 0 && isCleared(level.index - 1, save.value.cleared)) {
      return '还差 ' + left + ' 关'
    }
    return '未解锁'
  }

  function enterLevel(level : Level) {
    if (!playable(level)) {
      const left = gateLeft(level.index, save.value.cleared)
      const gated = left > 0 && isCleared(level.index - 1, save.value.cleared)
      uni.showToast({
        icon: 'none',
        title: gated
          ? '这一关要先通关 ' + tierGate(level.tier) + ' 关，还差 ' + left + ' 关。去别的钓场看看'
          : '先通关本钓场的上一关'
      })
      return
    }
    setCurrentLevel(level.index)
    uni.navigateTo({
      url: '/pages/examples/blackjack/fishing'
    })
  }

  function goBack() {
    uni.navigateBack()
  }

  onShow(() => {
    save.value = loadCurrentSave()
  })

  save.value = loadCurrentSave()
</script>

<style>
  .page {
    flex: 1;
    padding: 12px;
    background-color: #0b5d3b;
  }

  .head {
    flex-direction: row;
    justify-content: space-between;
    background-color: #084730;
    border-radius: 8px;
    padding: 8px 12px;
  }

  .head-item {
    flex: 1;
    align-items: center;
  }

  .head-label {
    color: #9fd9bd;
    font-size: 11px;
  }

  .head-value {
    color: #ffffff;
    font-size: 17px;
    font-weight: bold;
  }

  /* 四关的档次、奖励、回合都按位次定死，统一说一次 */
  .legend {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 6px;
    padding: 0 2px;
  }

  .legend-text {
    color: #9fd9bd;
    font-size: 9px;
  }

  .legend-tier {
    font-size: 9px;
    font-weight: bold;
    margin-left: 4px;
    margin-right: 4px;
  }

  /* 六个钓场竖着排，整页能滚 */
  .fields {
    flex: 1;
    margin-top: 4px;
  }

  .field {
    margin-bottom: 6px;
  }

  .field-head {
    flex-direction: row;
    align-items: center;
    padding: 0 4px;
  }

  .field-name {
    color: #e8b23a;
    font-size: 14px;
    font-weight: bold;
    margin-right: 6px;
  }

  /* 这个钓场教哪条路，一眼看得出该往哪走 */
  .field-tag {
    flex: 1;
    color: #9fd9bd;
    font-size: 10px;
  }

  .field-done {
    color: #cfeade;
    font-size: 11px;
  }

  /* 一个钓场四关，横着排成一行 —— 六个钓场刚好一屏，
     从左到右就是普通、稀有、史诗、传说 */
  .grid {
    flex-direction: row;
    margin-top: 2px;
  }

  .cell {
    width: 25%;
    padding: 2px;
    height: 52px;
  }

  .cell-inner {
    flex: 1;
    background-color: #0e6b45;
    border-radius: 8px;
    padding: 6px 8px;
    border-width: 1px;
    border-style: solid;
    border-color: #0e6b45;
    justify-content: center;
  }

  .cell-cleared {
    border-color: #e8b23a;
  }

  .cell-locked {
    background-color: #084730;
    opacity: 0.6;
  }

  /* 档次用贴纸稀有度的颜色，一眼看出这关放的是哪一档的贴纸 */
  .cell-diff {
    font-size: 10px;
    font-weight: bold;
  }

  .cell-name {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
  }

  /* 四列之后格子只有四分之一屏宽，这两行得压到 9px 才不挤 */
  .cell-goal {
    color: #cfeade;
    font-size: 9px;
  }

  .cell-state {
    color: #8fc7ab;
    font-size: 9px;
  }

  .cell-state-lock {
    color: #ff8a80;
  }

  .back-btn {
    height: 42px;
    border-radius: 21px;
    margin-top: 6px;
    align-items: center;
    justify-content: center;
    background-color: #084730;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .back-text {
    color: #e8b23a;
    font-size: 15px;
    font-weight: bold;
  }
</style>
