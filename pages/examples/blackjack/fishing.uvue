<template>
  <view class="page">
    <!-- 顶部信息栏 -->
    <view class="topbar">
      <view class="topbar-item">
        <text class="topbar-label">关卡</text>
        <text id="bj-level-name" class="topbar-value">{{ level.index }} · {{ level.name }}</text>
      </view>
      <view class="topbar-item">
        <text class="topbar-label">你的回合</text>
        <text id="bj-turn" class="topbar-value">{{ playerTurns }}</text>
      </view>
      <view class="topbar-item">
        <text class="topbar-label">共</text>
        <text id="bj-turns-total" class="topbar-value">{{ level.turns }}</text>
      </view>
    </view>

    <!-- 庄家手牌：跟你的手牌一样大，平时扣着。结算时亮出来；
         将来「借刀」「洞察」那类贴纸接回来，也从这里放行 -->
    <view class="hand-area">
      <view class="hand-head">
        <text class="hand-title">庄家手牌 {{ dealerHand.length }}/{{ handLimit(true) }}</text>
        <text class="hand-tip">回合 {{ dealerTurns }}/{{ level.turns }}</text>
      </view>
      <!-- 手牌可以多于 5 张（对换、同号那几张会往手上塞），所以横着能滑 -->
      <scroll-view class="hand hand-top" direction="horizontal">
        <view class="hand-row hand-row-top">
          <view
            v-for="(card, index) in dealerHand"
            :key="'dh-' + index"
            :id="'bj-dealer-hand-' + index"
            class="card card-hand"
            :class="{
              'card-back': !revealTheirs,
              'card-stickered': revealTheirs && card.stickerKey != S_NONE,
              'card-pickable': pickKind == 'theirs'
            }"
            @click="pickFromTheirs(index)">
            <view v-if="!revealTheirs" class="card-back-art">
              <view class="card-back-gem"></view>
            </view>
            <text
              v-if="revealTheirs"
              class="card-rank"
              :class="{
                'card-red': isRed(card),
                'card-rank-multi': rankCount(card) > 1,
                'card-rank-many': rankCount(card) > 3
              }"
              >{{ rankText(card) }}</text
            >
            <text v-if="revealTheirs" class="card-suit" :class="{ 'card-red': isRed(card) }">{{
              card.suit
            }}</text>
            <text
              v-if="revealTheirs && card.stickerKey != S_NONE"
              class="card-sticker"
              @click.stop="showSticker(card)"
              >{{ stickerName(card) }}</text
            >
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 公共牌堆：这局的主角。左边是堆底，越往左钓起来越值钱 -->
    <view class="pile-area">
      <view class="pile-head">
        <text class="pile-title">牌堆 {{ pile.length }} 张</text>
        <!-- 比分就贴在牌堆上：钓中的那一拍，收牌方的数字会亮起来放大，
             一眼看出这一摞要去谁那边 -->
        <view class="pile-score">
          <text class="pile-score-label">庄</text>
          <text
            id="bj-dealer-points"
            class="pile-score-num"
            :class="{ 'pile-score-catch': catchMarks.length > 0 && catchBy }"
            >{{ dealerPoints.length }}</text
          >
          <text class="pile-score-label">：你</text>
          <text
            id="bj-player-points"
            class="pile-score-num"
            :class="{ 'pile-score-catch': catchMarks.length > 0 && !catchBy }"
            >{{ playerPoints.length }}</text
          >
        </view>
      </view>
      <scroll-view id="bj-pile" class="board" :class="{ 'board-drop': dragReady }">
        <view class="board-row pile-cards">
          <text v-if="pile.length == 0" class="played-tip">空堆，下一张随便打</text>
          <view
            v-for="(card, index) in pile"
            :key="'pl-' + index"
            :id="'bj-pile-' + index"
            class="card card-in-pile"
            :class="{
              'card-stickered': !card.faceDown && card.stickerKey != S_NONE,
              'card-from-dealer': !card.faceDown && pileFromDealer[index],
              'card-from-player': !card.faceDown && !pileFromDealer[index],
              'card-back': card.faceDown,
              'card-caught': index < catchMarks.length && catchMarks[index],
              'card-pickable': pickKind == 'pile' || pickKind == 'slot'
            }"
            @click="tapPile(index)">
            <!-- 沉在堆底的暗牌：数字花色贴纸一概不露，跟庄家手牌一个背面 -->
            <view v-if="card.faceDown" class="card-back-art">
              <view class="card-back-gem"></view>
            </view>
            <text v-if="!card.faceDown" class="card-rank" :class="{ 'card-red': isRed(card) }">{{
              rankText(card)
            }}</text>
            <text v-if="!card.faceDown" class="card-suit" :class="{ 'card-red': isRed(card) }">{{
              card.suit
            }}</text>
            <!-- 整张牌点一下就看得到，这行小字不用再单独接一次点击 -->
            <text v-if="!card.faceDown && card.stickerKey != S_NONE" class="card-sticker">{{
              stickerName(card)
            }}</text>
          </view>
          <!-- 埋钩挑位置时，堆顶后面多一个「压堆顶」的落点 -->
          <view
            v-if="pickKind == 'slot'"
            id="bj-pile-top"
            class="card card-slot card-in-pile"
            @click="pickFromPile(pile.length)">
            <text class="card-slot-mark">压顶</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 提示 -->
    <view class="message-box" :class="'message-' + resultKind">
      <text id="bj-message" class="message-text">{{ message }}</text>
    </view>

    <!-- 手牌 / 选点数 / 结算 -->
    <!-- 摊牌给你挑的时候要加高：摊开的那排和手牌得同时看得见 -->
    <view
      class="hand-area hand-area-mine"
      :class="{ 'hand-area-tall': pickKind == 'top' || pickKind == 'deck' }">
      <view v-if="phase != 'over'" class="hand-head">
        <text class="hand-title">你的手牌 {{ playerHand.length }}/{{ handLimit(false) }}</text>
        <!-- 已经拖够远了，这会儿松手就出牌 -->
        <text v-if="dragReady" class="hand-tip hand-tip-drop">松手就打出</text>
        <!-- 选中一张之后给一个按钮，不想拖的可以按这儿打。
             没有「收起」——再点一次那张牌就收了，一个动作够了 -->
        <view v-else-if="selectedHand >= 0 && phase == 'player'" class="hand-acts">
          <text id="bj-play-now" class="peek-btn peek-btn-hit" @click="playSelected">打出</text>
        </view>
        <text v-else class="hand-tip">{{ handTip }}</text>
      </view>

      <!-- 空堆上打 J 是纯亏，拦一下 -->
      <view v-if="phase == 'confirm'" id="bj-confirm" class="value-box">
        <view class="board-row">
          <text class="peek-label">堆是空的，真要打？</text>
          <text id="bj-confirm-yes" class="peek-btn peek-btn-hit" @click="confirmHaul(true)"
            >照打</text
          >
          <text id="bj-confirm-no" class="peek-btn" @click="confirmHaul(false)">再等等</text>
        </view>
      </view>

      <!-- 摊开给你挑的牌：窥探和探牌看的是牌库顶，同号是从牌库里挑。
           摊开这排的时候手牌照样留在下面 —— 留不留得看手上现在是什么牌 -->
      <scroll-view
        v-if="pickKind == 'top' || pickKind == 'deck'"
        id="bj-spread"
        class="spread-box"
        direction="horizontal">
        <view class="board-row">
          <view
            v-for="(card, index) in pickCards"
            :key="'sp-' + index"
            :id="'bj-spread-' + index"
            class="card card-hand card-pickable"
            :class="{ 'card-stickered': card.stickerKey != S_NONE }"
            @click="pickFromSpread(index)">
            <text
              class="card-rank"
              :class="{
                'card-red': isRed(card),
                'card-rank-multi': rankCount(card) > 1,
                'card-rank-many': rankCount(card) > 3
              }"
              >{{ rankText(card) }}</text
            >
            <text class="card-suit" :class="{ 'card-red': isRed(card) }">{{ card.suit }}</text>
            <text v-if="card.stickerKey != S_NONE" class="card-sticker">{{
              stickerName(card)
            }}</text>
          </view>
          <text v-if="pickKind == 'top'" id="bj-keep-top" class="peek-btn" @click="keepTop"
            >留着</text
          >
        </view>
      </scroll-view>

      <scroll-view
        v-if="phase != 'over' && phase != 'confirm'"
        id="bj-hand"
        class="hand"
        direction="horizontal">
        <view class="hand-row">
          <view
            v-for="(card, index) in playerHand"
            :key="'h-' + index"
            :id="'bj-hand-' + index"
            class="card card-hand"
            :class="{
              'card-stickered': card.stickerKey != S_NONE,
              'card-ready': phase == 'player' && worthPlaying(card),
              'card-pickable': pickKind == 'hand',
              'card-picked': index == selectedHand && phase == 'player',
              'card-dragging': index == dragIndex && dragging
            }"
            :style="dragStyleOf(index)"
            @touchstart="dragStart(index, $event)"
            @touchmove="dragMove"
            @touchend="dragEnd"
            @touchcancel="dragEnd">
            <text
              class="card-rank"
              :class="{
                'card-red': isRed(card),
                'card-rank-multi': rankCount(card) > 1,
                'card-rank-many': rankCount(card) > 3
              }"
              >{{ rankText(card) }}</text
            >
            <text class="card-suit" :class="{ 'card-red': isRed(card) }">{{ card.suit }}</text>
            <!-- 这行贴纸名不再单独接点击：整张牌点一下就摊开效果，
                 不用再瞄准这十来个像素高的小字 -->
            <text v-if="card.stickerKey != S_NONE" class="card-sticker">{{
              stickerName(card)
            }}</text>
          </view>
          <!-- 换饵 / 换钩压到一半可以收手，剩下的不压了 -->
          <text
            v-if="pickKind == 'hand' && pickStoppable"
            id="bj-pick-stop"
            class="peek-btn peek-btn-stop"
            @click="stopPick"
            >不压了</text
          >
        </view>
      </scroll-view>

      <view v-if="phase == 'over'" class="over-box">
        <text id="bj-result" class="over-text">{{ resultText }}</text>
        <view class="over-actions">
          <!-- 输了就地再来一局，不用绕回关卡页。输不扣东西，随便重打 -->
          <view v-if="resultKind == 'lose'" id="bj-retry" class="btn btn-primary" @click="retry">
            <text class="btn-text">重来</text>
          </view>
          <view
            id="bj-back"
            class="btn"
            :class="{ 'btn-primary': resultKind != 'lose', 'btn-ghost': resultKind == 'lose' }"
            @click="goBack">
            <text class="btn-text" :class="{ 'btn-text-ghost': resultKind == 'lose' }"
              >返回关卡</text
            >
          </view>
        </view>
      </view>
    </view>

    <!-- 底部状态与入口。
         阶段文字和废牌张数都撤了 —— 轮到谁出牌，手牌区的提示和牌本身
         已经说得很清楚；废牌是散局才有的账，对着打的时候用不上 -->
    <view class="toolbar">
      <text id="bj-play-mode" class="toolbar-link" @click="togglePlayMode">{{ playModeText }}</text>
      <text id="bj-hand-stickers" class="toolbar-link" @click="showHandStickers">贴纸</text>
      <text id="bj-rules" class="toolbar-link" @click="showRules">规则</text>
      <text id="bj-quit" class="toolbar-link" @click="goBack">退出</text>
    </view>

    <!-- 对面头一次亮这种贴纸：停下来，把牌放大摆在正中间，
         效果写在牌下面，点一下才继续。
         稀有度越高闪得越凶 —— 稀有起步闪边，史诗往上再加一圈放射炫光 -->
    <view
      v-if="flashOn && flashWait"
      id="bj-flash-show"
      class="show-layer"
      :class="{ 'show-layer-in': flashIn }"
      @click="tapFlash">
      <view v-if="flashRarity >= 2" class="show-rays">
        <view
          v-for="(deg, ri) in RAY_ANGLES"
          :key="'ray-' + ri"
          class="ray"
          :class="{ 'ray-on': flashPulse, 'ray-legend': flashRarity == 3 }"
          :style="'transform: rotate(' + deg + 'deg);'"></view>
      </view>
      <view class="show-card" :class="{ 'show-card-in': flashIn }" :style="flashCardStyle()">
        <text class="show-rank" :class="{ 'card-red': flashRed }">{{ flashRank }}</text>
        <text class="show-suit" :class="{ 'card-red': flashRed }">{{ flashSuit }}</text>
        <text class="show-sticker" :style="'color: ' + flashColor">{{ flashName }}</text>
      </view>
      <text class="show-desc">{{ flashDesc }}</text>
      <text class="show-by">{{ flashBy }}</text>
      <text class="show-go">点一下继续</text>
    </view>

    <!-- 见过的贴纸就不拦了，只在上方闪一条横幅，自己淡出。
         传说那一档会把整个画面压暗，等于给它一个独占的镜头 -->
    <view
      v-if="flashOn && !flashWait && flashRarity == 3"
      class="flash-dim"
      :class="{ 'flash-dim-in': flashIn }"
      @click="tapFlash"></view>
    <view v-if="flashOn && !flashWait" id="bj-flash" class="flash-wrap" @click="tapFlash">
      <view
        class="flash"
        :class="{
          'flash-r1': flashRarity == 1,
          'flash-r2': flashRarity == 2,
          'flash-r3': flashRarity == 3,
          'flash-in': flashIn
        }"
        :style="'border-color: ' + flashColor">
        <text class="flash-by">{{ flashBy }}</text>
        <text
          id="bj-flash-name"
          class="flash-name"
          :class="{ 'flash-name-big': flashRarity >= 2 }"
          :style="'color: ' + flashColor"
          >{{ flashName }}</text
        >
        <text class="flash-desc">{{ flashDesc }}</text>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    Card,
    HAND_SIZE,
    RANK_COUNT,
    SUIT_COUNT,
    buildDeck,
    cloneCard,
    isRedSuit,
    worthOf,
    faceOf,
    playOptions,
    pileIndexExcept,
    pileIndexOf,
    valuesOf,
    shareValue,
    hasValue,
    pileSuitOf,
    isDeadCard,
    takeCount,
    NO_VALUE
  } from '@/pages/examples/blackjack/cards.uts'
  import {
    stickerAt,
    rarityAt,
    achievementAt,
    isBlankSticker,
    isFetchable,
    isPlayEffect,
    dropsAtBottom,
    S_NONE,
    S_HAUL,
    S_NARROW,
    S_PROBE3,
    S_PEAK,
    S_DEEP,
    S_RISE,
    S_PROP,
    S_SURGE,
    S_DRAIN,
    S_GLEAN,
    S_DRY,
    S_AKIN,
    S_SMEAR,
    S_GRIT,
    S_SPY,
    S_FEED,
    S_PRESS,
    S_UNHOOK,
    S_LEAD,
    S_SHUT,
    S_TROLL,
    S_VOLLEY,
    S_SIEVE,
    S_AGAIN,
    S_CALM,
    S_EVENS,
    S_DRAG,
    S_LURE,
    S_GATE,
    S_HUE,
    S_CAST,
    S_SPLIT,
    S_DYE,
    S_MASK,
    S_STIR,
    S_MURKY,
    S_STREAK,
    S_BLEND,
    S_UNIFY,
    S_MIRROR,
    S_SAND,
    S_VEIL,
    S_WASH,
    S_DIG,
    S_GATHER,
    S_DREDGE,
    S_GIVE,
    S_REEL,
    S_STRIP,
    S_PEEK,
    S_SCAN,
    S_SINK1,
    S_SINK2,
    S_PICKED,
    S_PROBE1,
    S_PROBE2,
    S_SAME,
    S_EMPTY,
    ACH_TWIN_PAIR,
    ACH_EXACT_GOAL,
    ACH_DEALER_BUST,
    ACH_BEHIND,
    ACH_STAND_BROKEN,
    ACH_FORESEE,
    ACH_COMEBACK,
    ACH_FLOW,
    BEHIND_GAP,
    FLOW_DRAWS,
    BIG_TAKE,
    RICH_SCORE,
    CHOKE_SCORE,
    DEEP_PILE
  } from '@/pages/examples/blackjack/stickers.uts'
  import {
    SaveData,
    emptySave,
    loadCurrentSave,
    saveCurrent,
    currentLevel,
    unlockShop,
    addTickets,
    addRandomTickets,
    addRefundTickets,
    markCleared,
    markAchieved
  } from '@/pages/examples/blackjack/save.uts'
  import { Level, levelAt, dealerStuck } from '@/pages/examples/blackjack/levels.uts'

  const DEALER_DELAY : number = 700
  // 同一次挑战里最多平局重开几次，超了就算这关没过
  const MAX_PUSH : number = 2
  // 注意别在 setup() 里重置它 —— 洗牌重开走的就是 setup
  let pushCount = 0

  const save = ref<SaveData>(emptySave())
  const level = ref<Level>(levelAt(1))

  const playerDeck = ref<Card[]>([] as Card[])
  const playerCursor = ref<number>(0)
  const dealerDeck = ref<Card[]>([] as Card[])
  const dealerCursor = ref<number>(0)

  const playerHand = ref<Card[]>([] as Card[])
  const dealerHand = ref<Card[]>([] as Card[])

  // 公共牌堆，下标 0 是堆底。撞上谁就从谁那里往上一起钓走，
  // 前面的留在堆里继续压着。每张牌的 pileValue 在落堆那一刻就锁死了
  const pile = ref<Card[]>([] as Card[])
  // 跟 pile 同步维护：这一张是谁打下来的。只用来染个边框色，不参与规则
  const pileFromDealer = ref<boolean[]>([] as boolean[])

  // 积分库。分数就是张数，不看点数
  const playerPoints = ref<Card[]>([] as Card[])
  const dealerPoints = ref<Card[]>([] as Card[])
  // 散局时没人钓走的牌，谁都不算分。
  // 不再单独开个面板给人翻 —— 算牌要用的是「这个数还剩几张没露面」，
  // unseenOf 那条路已经把废牌算进去了，摆一摞牌出来反而是噪声
  const waste = ref<Card[]>([] as Card[])

  // 庄家手牌摊开没有。现在只有结算时才亮，
  // 等「借刀」「洞察」那类能看对手手牌的贴纸接回新规则，就由它们来掀
  const dealerHandOpen = ref<boolean>(false)

  // 回合各自算：你打一张是你的一个回合，庄家打一张是它的
  const playerTurns = ref<number>(0)
  const dealerTurns = ref<number>(0)

  // dealer：庄家行动中；player：轮到你出牌；
  // value：你打出的牌能算成好几个数、且落法之间有差别，等你挑一个；
  // confirm：空堆上打 J，问一句；catch：钓中的那一段正亮着，等动画走完；over：结束
  const phase = ref<string>('dealer')
  const message = ref<string>('')
  const resultKind = ref<string>('idle')
  const resultText = ref<string>('')

  // 正等你确认要不要打的那张手牌（只剩空堆打 J 这一种情形）
  let pendingIndex = -1

  // 选中待打的那张手牌，-1 表示还没选。
  //
  // 下标是给模板画选中框用的，selectedRef 记的是那张牌本身：
  // 手牌一动（补牌、贴纸把牌挑走）下标就指到别的牌上去了，
  // 真打之前拿牌对象对一次，对不上就当没选过 —— 宁可白点一下，
  // 也不能让「打出」打的不是你看着的那张
  const selectedHand = ref<number>(-1)
  let selectedRef : Card | null = null

  // ---------- 出牌方式 ----------
  //
  // 两种，底部那一格随时切，选了什么记在本地，下次进来还是它。
  //
  // 拖动：点牌只用来看效果，出牌得往牌堆那边拖。出牌是收不回来的，
  //   那就让它需要一个明确的动作，而不是跟「看一眼」共用同一下点击。
  // 点击：点一张就打出去。手快的人嫌拖麻烦，这条留给他们 ——
  //   要看效果还有牌堆那边和底下的「贴纸」可以查
  const MODE_DRAG : number = 0
  const MODE_TAP : number = 1
  const KEY_PLAY_MODE : string = 'bj-play-mode'
  const playMode = ref<number>(MODE_DRAG)

  // 牌堆在手牌正上方，所以不必算准落点，往上拖够远就算送到了
  const dragIndex = ref<number>(-1)
  // 拖过这么远就算要出牌。比半张牌高一点，轻轻蹭一下不会误出
  const DRAG_OUT : number = -52
  // 位移没超过这个数就还算点击，不算拖
  const DRAG_SLOP : number = 8
  // 牌跟手最多抬这么高。再高就顶出手牌区被裁了，
  // 拖过头的反馈交给上面那条「松手打出」
  const DRAG_LIFT : number = 22
  // 标死成 number：不标的话 uts 照着 0 推成 Int，
  // 再拿 screenX 赋进来就类型对不上
  let dragFromX : number = 0
  let dragFromY : number = 0
  const dragDX = ref<number>(0)
  const dragDY = ref<number>(0)
  const dragging = ref<boolean>(false)
  // 已经拖够远了，松手就出牌
  const dragReady = ref<boolean>(false)
  // 这一下判成了横滑手牌列表，让位给 scroll-view，松手也不当点击
  let dragGave = false

  let dealerTimer = -1

  // 钓中之后、真正收走之前的那一拍。
  // catchMarks 逐张标出这次要带走哪些（空数组表示没在钓），catchBy 是归谁。
  // 用标记数组而不是「从第几张起」，是因为收色和撒网收的是散在堆里的牌，
  // 不是连着的一段 —— 两种收割共用同一套动画
  const CATCH_DELAY : number = 560
  const catchMarks = ref<boolean[]>([] as boolean[])
  const catchBy = ref<boolean>(false)
  let catchTimer = -1
  // 只给成就用：撞在堆里第几张、撞之前堆有多厚。散收的传 -1
  let catchAt = -1
  let catchDeep = 0

  // ---------- 选牌 ----------
  //
  // 有一批贴纸要你从某处挑牌。统一走这套：pickKind 说明从哪挑、
  // pickLeft 还差几张、pickKey 是哪张贴纸要的。
  // 庄家打出这些牌时不进选牌阶段 —— 它按 autoPick 自己挑完就走，
  // 不然轮到它出牌时会停在那等人点
  const PICK_NONE : string = ''
  const PICK_PILE : string = 'pile'
  const PICK_SLOT : string = 'slot'
  const PICK_HAND : string = 'hand'
  const PICK_THEIRS : string = 'theirs'
  const PICK_DECK : string = 'deck'
  const PICK_TOP : string = 'top'

  const pickKind = ref<string>(PICK_NONE)
  const pickCards = ref<Card[]>([] as Card[])
  // 这一次挑牌允不允许中途收手。pickKey 不是 ref，模板读不到，所以单开一个
  const pickStoppable = ref<boolean>(false)
  let pickLeft = 0
  let pickKey = ''
  // 发起的那张贴纸牌自己，用来定位「它左边」
  let pickOwner : Card | null = null
  // 对换分两步：先挑自己的，再挑他的。这是已经挑好的自己那张
  let pickHeld = -1
  // 这次摊开的是谁的牌库顶。窥探、探牌看自己的，探底看庄家的 ——
  // 摊开的界面和「压到牌库底」的操作是同一套，只有牌库换了一边
  let pickOfDealer = false

  // 正在结算的这一手。出牌流程是「落堆 → 发动效果 → 判撞」，
  // 而效果可能停下来等你挑牌，所以这一手的账得先存着，等效果跑完再接力判撞
  let playCardRef : Card | null = null
  let playBy = false
  let playDeep = 0

  // 蒙牌欠下的张数：接下来这么多张牌不论谁打，一律背面落堆
  let maskLeft = 0
  // 浑水欠下的张数：轮到这一方时，得背面连打这么多张，而且不触发钓牌
  let playerForced = 0
  let dealerForced = 0
  // 闭口欠下的张数：轮到这一方时，得连打这么多张，一律按 0 点正面落堆顶。
  // 跟浑水的区别全在「落在哪、看不看得见」：浑水沉堆底谁也捞不着，
  // 闭口摆在堆顶，那几张是喂给下一个钩得上的人的
  let playerChoke = 0
  let dealerChoke = 0
  // 连竿给的额外出牌数：这一回合还能多打几张
  let playerExtra = 0
  let dealerExtra = 0

  // ---------- 从牌库连着往外打 ----------
  //
  // 试钓、连投、滤水都是「翻牌库顶，一张张打出去」，只是停手的条件不同。
  // 翻出来的牌照常发动自己的贴纸，所以这事写不成一个 for 循环 ——
  // 中间那张要是个得挑牌的贴纸，流程会停在选牌阶段等人点。
  //
  // 改成记一笔欠账：出牌流程不管走哪条路，最后都会回到 endTurn，
  // 在那儿看一眼还欠不欠，欠就接着翻下一张。
  const RUN_NONE : string = ''
  // 连投：数够张数就停
  const RUN_COUNT : string = 'count'
  // 试钓：撞上一张就停
  const RUN_HIT : string = 'hit'
  // 滤水：打出一张点数不是 0 的就停
  const RUN_VALUE : string = 'value'
  let runMode = RUN_NONE
  let runBy = false
  // 还能翻几张。连投是要翻的张数，另外两张是兜底上限 ——
  // 不设上限的话，一串试钓能把半个牌库倒空
  let runLeft = 0
  const RUN_CAP : number = 6
  // 两张之间隔一拍，不然一串牌瞬间翻完，谁都没看清发生了什么
  const RUN_DELAY : number = 640
  let runTimer = -1
  // 刚打出去那一张钩没钩上、落堆算哪几个数。连出和续钩要靠它决定接下来怎么走
  let lastHit = false
  let lastValues : number[] = [] as number[]

  // ---------- 贴纸横幅 ----------
  //
  // 带贴纸的牌一落堆就把它的名字和效果亮出来。稀有度越高亮得越久、越大，
  // 传说还把背景压暗，等于给它一个独占的画面。
  //
  // 这不只是好看：一串连出以前是每 640ms 翻一张，翻过去了才反应过来
  // 那张贴的是什么。现在横幅亮多久，下一张就往后推多久 —— 节奏由牌本身定，
  // 普通牌照样快，撞上传说就停一下让人看清
  const flashOn = ref<boolean>(false)
  // 入场态：先渲染成小而透明的，下一拍再切过来，transition 才有得过渡
  const flashIn = ref<boolean>(false)
  const flashName = ref<string>('')
  const flashDesc = ref<string>('')
  const flashBy = ref<string>('')
  const flashRarity = ref<number>(0)
  const flashColor = ref<string>('#ffffff')
  // 暂停态要把牌本身放大摆在中间，牌面这几样得单独拿出来
  const flashRank = ref<string>('')
  const flashSuit = ref<string>('')
  const flashRed = ref<boolean>(false)
  // 闪边和炫光靠它来回翻。uvue 在 Android 上没有 @keyframes，
  // 循环动画只能自己拿定时器翻开关，靠 transition 把两头接起来
  const flashPulse = ref<boolean>(false)
  let pulseTimer = -1
  const PULSE_STEP : number = 520
  // 放射炫光的角度。12 条，每条以自己中心转，转完就是一圈星芒
  const RAY_ANGLES : number[] = [0, 30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330]
  let flashTimer = -1
  let flashOutTimer = -1
  // 这一拍横幅要占掉多少时间，下一手出牌的延迟得算上它
  let flashHold = 0

  // 横幅正等你点，后面那一手挂着不走。
  //
  // 庄家每种贴纸头一次打出来都停在这儿 —— 对面的牌组你没见过，
  // 一张没见过的贴纸一闪而过等于没给你看。见过一次之后就不再拦，
  // 同一种贴纸打第二次还停，那是添堵
  const flashWait = ref<boolean>(false)
  let flashPaused = false
  // 这一局里庄家已经亮过哪几种贴纸。每局重来 ——
  // 换了关卡对面就是另一套牌组，上一局见过不算数
  let seenFromDealer : string[] = [] as string[]
  // 挂起时记下该往哪走
  const GO_NONE : number = 0
  const GO_DEALER : number = 1
  const GO_RUN : number = 2
  let pendingGo = GO_NONE

  // 各稀有度亮多久。普通的只是一闪而过，传说值得让人停下来看完
  const FLASH_HOLD : number[] = [420, 640, 880, 1200]
  // 淡出走完要这么久，跟 .flash 的 transition-duration 对上
  const FLASH_OUT : number = 180


  // 本局一度落后过多少分，用来判「逆风翻盘」
  let maxBehind = 0
  // 你上一次钓到牌是在自己的第几个回合，用来判「连下两城」
  let lastTakeTurn = -1
  // 最后一个回合有没有钓到牌，用来判「一锤定音」
  let tookOnLastTurn = false

  // ---------- 初始化 ----------

  // 开一局。平局重来时也走这里，牌会重新洗过
  function setup() {
    const data = loadCurrentSave()
    save.value = data
    level.value = levelAt(currentLevel())

    playerDeck.value = buildDeck(data.stuck)
    playerCursor.value = 0
    dealerDeck.value = buildDeck(dealerStuck(level.value))
    dealerCursor.value = 0

    playerHand.value = [] as Card[]
    dealerHand.value = [] as Card[]
    tidyPlayerHand()
    tidyDealerHand()

    pile.value = [] as Card[]
    pileFromDealer.value = [] as boolean[]
    playerPoints.value = [] as Card[]
    dealerPoints.value = [] as Card[]
    waste.value = [] as Card[]
    dealerHandOpen.value = false

    playerTurns.value = 0
    dealerTurns.value = 0
    pendingIndex = -1
    catchMarks.value = [] as boolean[]
    catchAt = -1
    catchDeep = 0
    playCardRef = null
    playBy = false
    playDeep = 0
    if (catchTimer != -1) {
      clearTimeout(catchTimer)
      catchTimer = -1
    }
    maskLeft = 0
    playerForced = 0
    dealerForced = 0
    playerChoke = 0
    dealerChoke = 0
    playerExtra = 0
    dealerExtra = 0
    runMode = RUN_NONE
    runBy = false
    runLeft = 0
    if (runTimer != -1) {
      clearTimeout(runTimer)
      runTimer = -1
    }
    lastHit = false
    lastValues = [] as number[]
    // 上一局最后那张牌的横幅不能跟到新一局的开场
    if (flashTimer != -1) {
      clearTimeout(flashTimer)
      flashTimer = -1
    }
    if (flashOutTimer != -1) {
      clearTimeout(flashOutTimer)
      flashOutTimer = -1
    }
    stopPulse()
    flashOn.value = false
    flashIn.value = false
    flashWait.value = false
    flashHold = 0
    flashPaused = false
    pendingGo = GO_NONE
    // 换了关卡对面就是另一套牌组，上一局见过的不算数
    seenFromDealer = [] as string[]
    // 平潮是模块级开关，开着不关会跟到下一局去
    refreshField()
    pickKind.value = PICK_NONE
    pickCards.value = [] as Card[]
    pickStoppable.value = false
    pickLeft = 0
    pickKey = ''
    pickOwner = null
    pickHeld = -1
    maxBehind = 0
    lastTakeTurn = -1
    tookOnLastTurn = false

    resultKind.value = 'idle'
    resultText.value = ''
    message.value = '打出的牌跟堆里某张数字相同，就从那张往上一起钓走。每人 '
      + level.value.turns + ' 个回合，钓得多的赢。'

    phase.value = 'dealer'
    scheduleDealer()
  }

  // ---------- 摸牌 ----------

  // 这一方这一次该补到几张。平时补满 HAND_SIZE，
  // 窄口在堆里时庄家只补到 4 张 —— 它掐的是对手的选择面，不是自己的
  function handLimit(ofDealer : boolean) : number {
    // 窄口掐的是打出它那一方的对手 —— 庄家自己打出来，少补的就该是你
    if (pileHasStickerBy(S_NARROW, !ofDealer)) {
      return HAND_SIZE - 1
    }
    return HAND_SIZE
  }

  // 补手牌：少于该补的张数就从牌库补上来，多了不管。
  //
  // 只补不弃是有意的 —— 手牌能超过 5 张。对换、同号这些会往手上塞牌的贴纸
  // 因此不再「塞一张挤掉一张」，塞进来的实打实多一张；
  // 窄口那种压手牌上限的也只是让对手补得少，不会当场抢牌
  function tidyPlayerHand() {
    const cap = handLimit(false)
    const hand : Card[] = []
    for (let i = 0; i < playerHand.value.length; i++) {
      hand.push(playerHand.value[i])
    }
    while (hand.length < cap && playerCursor.value < playerDeck.value.length) {
      hand.push(cloneCard(playerDeck.value[playerCursor.value]))
      playerCursor.value = playerCursor.value + 1
    }
    playerHand.value = hand
  }

  function tidyDealerHand() {
    const cap = handLimit(true)
    const hand : Card[] = []
    for (let i = 0; i < dealerHand.value.length; i++) {
      hand.push(dealerHand.value[i])
    }
    while (hand.length < cap && dealerCursor.value < dealerDeck.value.length) {
      hand.push(cloneCard(dealerDeck.value[dealerCursor.value]))
      dealerCursor.value = dealerCursor.value + 1
    }
    dealerHand.value = hand
  }

  // 额外摸牌：从自己牌库顶抓 n 张直接进手里，不管手上已经有几张。
  //
  // 这是控制流派的引擎 —— 补牌只补到上限、多了不弃，所以把一方的手牌顶过
  // 上限之后，他回合结束就不补牌了，牌池冻在你看过的那几张里。
  // leaded 为真表示灌铅：抓上来的牌点数写死 0，贴纸一并清掉 ——
  // 不清贴纸的话，幸运、福星还能从 0 派生出 13/1/2，铅就白灌了
  function drawExtra(ofDealer : boolean, n : number, leaded : boolean) : number {
    let done = 0
    for (let i = 0; i < n; i++) {
      const deck = ofDealer ? dealerDeck.value : playerDeck.value
      const cursor = ofDealer ? dealerCursor.value : playerCursor.value
      if (cursor >= deck.length) {
        break
      }
      const one = cloneCard(deck[cursor])
      if (leaded) {
        one.forced = 0
        one.stickerKey = S_NONE
      }
      if (ofDealer) {
        dealerCursor.value = cursor + 1
        dealerHand.value = pushCard(dealerHand.value, one)
      } else {
        playerCursor.value = cursor + 1
        playerHand.value = pushCard(playerHand.value, one)
      }
      done = done + 1
    }
    return done
  }

  function removeAt(list : Card[], index : number) : Card[] {
    const next : Card[] = []
    for (let i = 0; i < list.length; i++) {
      if (i != index) {
        next.push(list[i])
      }
    }
    return next
  }

  function pushCards(target : Card[], cards : Card[]) : Card[] {
    const next : Card[] = []
    for (let i = 0; i < target.length; i++) {
      next.push(target[i])
    }
    for (let i = 0; i < cards.length; i++) {
      next.push(cards[i])
    }
    return next
  }

  function pushCard(target : Card[], card : Card) : Card[] {
    const one : Card[] = [card]
    return pushCards(target, one)
  }

  // 插到最前面 —— 落堆底的贴纸走这条
  function unshiftCard(target : Card[], card : Card) : Card[] {
    const next : Card[] = [card]
    for (let i = 0; i < target.length; i++) {
      next.push(target[i])
    }
    return next
  }

  // pileFromDealer 得跟 pile 一一对应，所以它也要有对应的两种插法
  function pushOwner(list : boolean[], byDealer : boolean) : boolean[] {
    const next : boolean[] = []
    for (let i = 0; i < list.length; i++) {
      next.push(list[i])
    }
    next.push(byDealer)
    return next
  }

  function unshiftOwner(list : boolean[], byDealer : boolean) : boolean[] {
    const next : boolean[] = [byDealer]
    for (let i = 0; i < list.length; i++) {
      next.push(list[i])
    }
    return next
  }

  // ---------- 出牌 ----------
  //
  // 轮到自己就出一张，没有别的选择 —— 要决定的是出哪张、按几点落。
  // 撞上堆里某张就从那张往上一起钓走，前面的留着；撞不上就压在堆顶。
  //
  // 于是每一手都在权衡三件事：现在钓得到几张、把牌留在堆里会不会被对方
  // 顺手捞走一大片、以及自己手上还有没有牌能在下一轮钓得更深。

  // 手牌被点了 —— 点击只管看，不出牌。
  //
  // 点一下选中，把这张算几点、贴纸干什么摊到提示栏上；
  // 再点一下取消。出牌走的是往上拖，或者选中后按「打出」。
  // 以前是点牌面出牌、点牌面上那行小字看效果，两个落点差十来个像素，
  // 想看一眼效果结果把牌打出去了
  function tapHand(index : number) {
    if (phase.value == 'pick') {
      pickFromHand(index)
      return
    }
    if (phase.value != 'player') {
      return
    }
    if (index >= playerHand.value.length) {
      return
    }
    // 点击出牌：点一下就出去了，中间不停
    if (playMode.value == MODE_TAP) {
      clearSelected()
      playCard(index)
      return
    }
    // 点的就是已经选中的那张 —— 收起来
    if (index == selectedHand.value) {
      clearSelected()
      return
    }
    selectedHand.value = index
    selectedRef = playerHand.value[index]
    message.value = handCardText(playerHand.value[index])
  }

  // 按住一张手牌。这里还分不清是点还是拖，先把起点记下来
  function dragStart(index : number, e : TouchEvent) {
    if (e.touches.length == 0) {
      return
    }
    // 已经伸手去动牌了，那就是看完了 —— 横幅收起来，挂着的那一手放行。
    // 大牌盖住的是上半屏，手牌够得着，不该逼人先点一下横幅再出牌
    if (flashPaused) {
      hideFlash()
      resumeAfterFlash()
    }
    dragIndex.value = index
    // 用 screen 坐标：只拿来算相对位移，各端口径一致
    dragFromX = e.touches[0].screenX
    dragFromY = e.touches[0].screenY
    dragDX.value = 0
    dragDY.value = 0
    dragging.value = false
    dragReady.value = false
    dragGave = false
  }

  function dragMove(e : TouchEvent) {
    if (dragIndex.value < 0 || dragGave || e.touches.length == 0) {
      return
    }
    const dx = e.touches[0].screenX - dragFromX
    const dy = e.touches[0].screenY - dragFromY
    if (!dragging.value) {
      // 手指总会抖一下，抖过阈值才算数
      if (Math.abs(dx) + Math.abs(dy) <= DRAG_SLOP) {
        return
      }
      // 横向占优：这一下是在滑手牌列表，不是在拽牌。
      // 让位给 scroll-view，这一轮也不再当点击处理
      if (Math.abs(dx) > Math.abs(dy)) {
        dragGave = true
        return
      }
      dragging.value = true
    }
    dragDX.value = dx
    dragDY.value = dy
    dragReady.value = dy <= DRAG_OUT && canDropNow()
  }

  function dragEnd() {
    const index = dragIndex.value
    const moved = dragging.value
    const ready = dragReady.value
    const gave = dragGave
    dragIndex.value = -1
    dragging.value = false
    dragReady.value = false
    dragGave = false
    dragDX.value = 0
    dragDY.value = 0
    if (index < 0 || gave) {
      return
    }
    // 几乎没动，那就是点了一下
    if (!moved) {
      tapHand(index)
      return
    }
    if (ready) {
      dropToPile(index)
    }
  }

  // 现在是不是能往堆里扔牌。挑牌阶段手牌是拿来挑的，不是拿来打的
  function canDropNow() : boolean {
    return phase.value == 'player'
  }

  // 拖到位松手了，这张就打出去
  function dropToPile(index : number) {
    if (!canDropNow() || index >= playerHand.value.length) {
      return
    }
    clearSelected()
    playCard(index)
  }

  // 拖动中的那张跟着手指走。抬升封了顶，不然牌会被手牌区裁掉
  function dragStyleOf(index : number) : string {
    if (index != dragIndex.value || !dragging.value) {
      return ''
    }
    let lift = dragDY.value
    if (lift < -DRAG_LIFT) {
      lift = -DRAG_LIFT
    }
    if (lift > 0) {
      lift = 0
    }
    return 'transform: translate(' + dragDX.value + 'px, ' + lift + 'px);'
  }

  // 选中的这张算几点、贴纸写着什么，一句话说完
  function handCardText(card : Card) : string {
    const face = card.suit + rankText(card)
    if (card.stickerKey == S_NONE) {
      return face + '：没贴纸，落堆就按牌面这个数当钓点。往上拖到牌堆就打出。'
    }
    const sticker = stickerAt(card.stickerKey)
    return face + ' 【' + sticker.name + '】' + sticker.desc + '（往上拖到牌堆打出）'
  }

  function playSelected() {
    const index = selectedHand.value
    if (index < 0 || index >= playerHand.value.length || selectedRef == null) {
      clearSelected()
      return
    }
    // 下标还在，但那个位置上已经换成别的牌了 —— 不打，重选
    if (playerHand.value[index] != (selectedRef as Card)) {
      clearSelected()
      message.value = '手牌动过了，重新点一张。'
      return
    }
    clearSelected()
    playCard(index)
  }

  function clearSelected() {
    selectedHand.value = -1
    selectedRef = null
  }

  function playCard(index : number) {
    if (phase.value != 'player') {
      return
    }
    if (index >= playerHand.value.length) {
      return
    }
    const card = playerHand.value[index]

    // 空堆上的 J 只能收到它自己，一张王牌就这么没了。
    // 这是这一版唯一会让你白亏的操作，值得拦一下
    if (card.stickerKey == S_HAUL && pile.value.length == 0) {
      pendingIndex = index
      phase.value = 'confirm'
      message.value = '堆是空的，' + cardText(card) + ' 的【通吃】只收得到它自己，等于白扔一张王牌。'
      return
    }

    // 牌落堆不坍缩成一个数，所以没什么可挑的 —— 它能算成的几个数
    // 同时都是钓点，判撞时自动钩最靠堆底的那张，那本来就是最赚的
    commitPlay(false, index)
  }

  // 从牌库顶抓一张直接打出去。连出的三张贴纸都靠它。
  //
  // 抓上来的牌先挂到手牌末尾，再当成手牌打掉 —— 绕这一下是为了复用
  // commitPlay 的整套流程：贴纸照发动、撞上照收、动画照走。
  // 手牌这会儿会短一瞬间多出一张，下一次 tidy 就归位了
  function playFromDeck(byDealer : boolean) : boolean {
    const deck = byDealer ? dealerDeck.value : playerDeck.value
    const cursor = byDealer ? dealerCursor.value : playerCursor.value
    if (cursor >= deck.length) {
      return false
    }
    const one = cloneCard(deck[cursor])
    if (byDealer) {
      dealerCursor.value = cursor + 1
      dealerHand.value = pushCard(dealerHand.value, one)
    } else {
      playerCursor.value = cursor + 1
      playerHand.value = pushCard(playerHand.value, one)
    }
    const hand = byDealer ? dealerHand.value : playerHand.value
    commitPlay(byDealer, hand.length - 1)
    return true
  }

  // 记一笔连出的欠账。真正翻牌在 endTurn 那头，这里只把条件写下来
  function startRun(byDealer : boolean, key : string) {
    runBy = byDealer
    if (key == S_VOLLEY) {
      runMode = RUN_COUNT
      runLeft = 3
    } else if (key == S_TROLL) {
      runMode = RUN_HIT
      runLeft = RUN_CAP
    } else {
      runMode = RUN_VALUE
      runLeft = RUN_CAP
    }
    lastHit = false
    lastValues = [] as number[]
  }

  // 连出还欠着牌吗？欠就接着翻下一张，这一手先不算完。
  // 三种停手条件都在这儿判：数够了、撞上了、翻出有点数的了。
  //
  // 翻牌隔一拍再翻，一张张看得清；这期间 phase 挂在 run 上，
  // 你点手牌不会插队进来 —— playCard 只认 player
  function keepRunning(byDealer : boolean) : boolean {
    if (runMode == RUN_NONE || runBy != byDealer || phase.value == 'over') {
      return false
    }
    if (runMode == RUN_HIT && lastHit) {
      runMode = RUN_NONE
      return false
    }
    // 滤水：翻出一张真有点数的就收手。全是 0 的、没点数的都接着翻
    if (runMode == RUN_VALUE && hasLiveValue(lastValues)) {
      runMode = RUN_NONE
      return false
    }
    if (runLeft <= 0) {
      runMode = RUN_NONE
      return false
    }
    const deck = byDealer ? dealerDeck.value : playerDeck.value
    const cursor = byDealer ? dealerCursor.value : playerCursor.value
    if (cursor >= deck.length) {
      runMode = RUN_NONE
      message.value = message.value + ' 牌库空了，连着打到此为止。'
      return false
    }
    runLeft = runLeft - 1
    phase.value = 'run'
    scheduleRun()
    return true
  }

  // 隔一拍之后翻的那一张。走的是 runBy 记下来的那一方
  function runNext() {
    runTimer = -1
    playFromDeck(runBy)
  }

  // 下一手什么时候来。
  //
  // 基础节奏之外再加上这一拍横幅要占的时间 —— 刚翻出一张传说，
  // 就多等它亮完；翻出一张没贴纸的，还是原来的速度。
  // flashHold 用掉就清，它只管紧接着的那一手
  function nextDelay(base : number) : number {
    const wait = base + flashHold
    flashHold = 0
    return wait
  }

  // 横幅正等着你点的时候，下一手先记在 pendingGo 上挂着，
  // 等 resumeAfterFlash 放行。不挂的话定时器照走，
  // 你还在看说明，对面已经又打了两张
  function scheduleDealer() {
    if (flashPaused) {
      pendingGo = GO_DEALER
      return
    }
    dealerTimer = setTimeout(dealerTurn, nextDelay(DEALER_DELAY))
  }

  function scheduleRun() {
    if (flashPaused) {
      pendingGo = GO_RUN
      return
    }
    runTimer = setTimeout(runNext, nextDelay(RUN_DELAY))
  }

  // 空堆打 J 的确认：照打就认了，再等等就把牌放回手上
  function confirmHaul(use : boolean) {
    if (phase.value != 'confirm') {
      return
    }
    const index = pendingIndex
    pendingIndex = -1
    phase.value = 'player'
    if (!use || index < 0 || index >= playerHand.value.length) {
      message.value = 'J 先留着，等堆压厚了再通吃。'
      return
    }
    commitPlay(false, index)
  }

  // 一张牌落下去。钩上就连着后面的一起钓走，钩不上就压在堆顶。
  //
  // 牌落堆不坍缩成一个数：它能算成的那几个数一起带进堆里，之后每一个都是钓点。
  //
  // 钓中了不当场收走 —— 牌先落到堆顶，把要带走的那一段整体点亮，停一拍再收。
  // 这一拍是给你看的：钩在哪张、带走哪几张，正是这个玩法全部的信息量，
  // 一闪而过的话，你只看得到分数变了，看不出为什么变这么多
  function commitPlay(byDealer : boolean, index : number) {
    const hand = byDealer ? dealerHand.value : playerHand.value
    if (index >= hand.length) {
      return
    }
    // 牌一落堆，后面的贴纸就可能往你手上塞牌、从你手上抽牌，
    // 选中的下标撑不过这一段。统一在这儿清掉，不留给各个贴纸分头处理
    clearSelected()
    // 这一手要不要为横幅让路，从头算。上一手的余额不能带过来 ——
    // 背面牌那条路根本不弹横幅，带过来就是白等一拍
    flashHold = 0
    const card = hand[index]
    if (byDealer) {
      dealerHand.value = removeAt(hand, index)
    } else {
      playerHand.value = removeAt(hand, index)
    }

    // 背面落堆：蒙牌欠着的那几张，或者浑水逼着这一方打的那几张。
    // 背面牌数字花色都不算数，所以它既不发动效果、也不参与撞牌，直接压进堆里
    const forced = byDealer ? dealerForced : playerForced
    if (maskLeft > 0 || forced > 0) {
      if (maskLeft > 0) {
        maskLeft = maskLeft - 1
      }
      if (forced > 0) {
        if (byDealer) {
          dealerForced = forced - 1
        } else {
          playerForced = forced - 1
        }
      }
      // 背面牌一律沉到堆底。钓牌是从撞中的位置往上收，所以沉在底下的
      // 基本不会被普通钓牌带走 —— 它们攒在那儿等人来翻
      card.faceDown = true
      card.pileValue = NO_VALUE
      card.pileValues = [] as number[]
      pile.value = unshiftCard(pile.value, card)
      pileFromDealer.value = unshiftOwner(pileFromDealer.value, byDealer)
      refreshField()
      lastHit = false
      lastValues = [] as number[]
      message.value = (byDealer ? '庄家' : '你') + '盖了一张牌沉到堆底，堆里现在 '
        + pile.value.length + ' 张。'
      endTurn(byDealer)
      return
    }

    // 闭口欠着的那几张：正面落堆顶，但点数一律按 0 算。
    // 他看得见自己打了什么，也知道这一手白打 —— 那几张就摆在堆顶等人来收
    const choke = byDealer ? dealerChoke : playerChoke
    const choked = choke > 0
    if (choked) {
      if (byDealer) {
        dealerChoke = choke - 1
      } else {
        playerChoke = choke - 1
      }
    }

    // 空位类落堆时没有点数 —— 钩不上任何东西，也没人钩得上它
    const blank = isBlankSticker(card.stickerKey)
    const deep = pile.value.length
    if (blank) {
      card.pileValue = NO_VALUE
      card.pileValues = [] as number[]
    } else if (choked) {
      card.pileValues = [0]
      card.pileValue = 0
    } else {
      // 能算成的几个数一起带进堆里，不挑一个锁死。
      // 齐顶是例外 —— 它算堆上最大的那个数，而且要在自己落堆之前先量一遍
      card.pileValues = card.stickerKey == S_PEAK ? [peakValue()] : playOptions(card)
      card.pileValue = card.pileValues.length > 0 ? 0 : NO_VALUE
    }

    // 牌先摆进堆里。默认压堆顶，标了落堆底的插到最左边。
    // 闭口逼出来的那几张一律压堆顶 —— 摆在那儿才是给人收的
    const bottom = !choked && dropsAtBottom(card.stickerKey)
    if (bottom) {
      pile.value = unshiftCard(pile.value, card)
      pileFromDealer.value = unshiftOwner(pileFromDealer.value, byDealer)
    } else {
      pile.value = pushCard(pile.value, card)
      pileFromDealer.value = pushOwner(pileFromDealer.value, byDealer)
    }
    // 平潮可能刚落堆、也可能正压着这一张，先把刀落完
    refreshField()
    // 这一手落堆算哪几个数、钩没钩上，连出和续钩都照着它走。
    // 取落堆后的实际候选 —— 被平潮压出 0 的，对续钩来说就是实打实的 0 点
    lastValues = valuesOf(card)
    lastHit = false

    const who = byDealer ? '庄家' : '你'
    const how = sameValues(lastValues, playOptions(card)) && card.stickerKey != S_PEAK
      ? '' : '（算 ' + listText(lastValues) + '）'
    message.value = who + '打出 ' + cardText(card) + how + '。'

    // 贴纸牌一落堆先把效果亮出来。放在效果真正发动之前 ——
    // 先看清是什么，再看它做了什么
    flashSticker(card, who, byDealer)

    // 空位类：落堆就发动它自己的效果，不参与撞牌。
    // playCardRef 空着正是「这一手不判撞」的标记，挑牌那条路靠它分流
    if (blank) {
      playCardRef = null
      playBy = byDealer
      fireBlank(byDealer, card, who)
      return
    }

    // 这一手的账先记下来 —— 效果可能要你挑牌，挑完才轮到判撞
    playCardRef = card
    playBy = byDealer
    playDeep = deep

    // 通吃不看数字，直接端走整堆
    if (card.stickerKey == S_HAUL) {
      resolveHit(true)
      return
    }

    // 立即类先发动效果，再判撞 —— 效果可能改了堆的结构，
    // 撞哪张、能带走哪几张都得按改完的算
    if (isPlayEffect(card.stickerKey)) {
      firePlay(byDealer, card, who)
      return
    }

    resolveHit(false)
  }

  // 效果跑完了，这才判这一手钩没钩上。
  //
  // 钩的是「候选有交集」的第一张，从堆底数起 —— 一张牌攥着好几个数，
  // 哪个数钩得最深就算哪个，不用挑也挑不错。
  // 判撞要排掉自己：牌这会儿已经在堆里了，不排就跟自己钩上了
  function resolveHit(haul : boolean) {
    if (playCardRef == null) {
      return
    }
    const one = playCardRef as Card
    const byDealer = playBy
    const deep = playDeep
    playCardRef = null

    // 效果跑完堆可能已经变了样，判撞前把场上规则对齐
    refreshField()
    const values = valuesOf(one)
    const at = haul ? 0 : pileIndexExcept(pile.value, values, one)
    const who = byDealer ? '庄家' : '你'
    lastHit = haul || at >= 0

    if (!haul && at < 0) {
      message.value = message.value + '没钩上，堆里现在 ' + pile.value.length + ' 张。'
      endTurn(byDealer)
      return
    }

    // 钓中了。带走撞中那张、自己这张、以及夹在中间的全部。
    // 通吃是特例：它从堆底一路端到自己这儿
    const selfAt = indexInPile(one)
    const marks = markRun(at, selfAt < 0 ? pile.value.length - 1 : selfAt)
    const gain = countMarks(marks)
    const left = pile.value.length - gain
    if (haul) {
      message.value = deep == 0
        ? who + '把 ' + cardText(one) + ' 打在空堆上，【通吃】只收到它自己，白费一张。'
        : who + '打出 ' + cardText(one) + '，【通吃】把整堆 ' + deep + ' 张连同自己一起收走（'
          + gain + ' 分）。'
    } else {
      message.value = message.value + '钩上堆里第 ' + (at + 1) + ' 张（算 '
        + listText(sharedValues(values, valuesOf(pile.value[at]))) + '），钓走 ' + gain + ' 张。'
        + (left > 0 ? '堆里还压着 ' + left + ' 张。' : '堆空了。')
    }

    startCatch(byDealer, marks, at, deep)
  }

  // 大数从哪儿算起：11 及以上是大数，10 及以下是小数。
  //
  // 挑 11 是因为 J 从不落堆（打出就通吃走了），11 是牌堆里天然的空缺 ——
  // 普通牌组里根本没有 11，要够到它得靠暗桩、归深或者坠子往上推。
  // 闸门、深水、归深这几张都拿它当分界线
  const BIG_LINE : number = 10

  // ---------- 收牌 ----------

  // 标出这一手要带走哪些牌：撞中的那张、打出的这张、以及夹在它们中间的全部。
  //
  // 平时牌压在堆顶，这一段就是「撞中位置一路到堆顶」；
  // 但埋钩会把自己埋到中间，那时范围就在它那儿截止，右边的不跟着走。
  //
  // 闸门、深水和假饵会再改写这个范围：
  //   闸门 —— 从钩中那张往自己这边数，遇到 11 以上的牌就停（小数钩不过大数墙）；
  //   深水 —— 钩中的是 10 以内的小数时，整段作废，只带走钩中那张和自己；
  //   假饵 —— 钩中的位置在它左边时，整段不归对方，只带走假饵自己。
  function markRun(at : number, selfAt : number) : boolean[] {
    const marks : boolean[] = []
    for (let i = 0; i < pile.value.length; i++) {
      marks.push(false)
    }
    if (at < 0 || at >= pile.value.length || selfAt < 0 || selfAt >= pile.value.length) {
      return marks
    }

    const from = at < selfAt ? at : selfAt
    const to = at < selfAt ? selfAt : at

    // 假饵挡刀：这一段里有假饵、而且撞点在它左边，就只带走假饵这一张
    for (let i = from; i <= to; i++) {
      const card = pile.value[i]
      if (card.stickerKey == S_LURE && !card.faceDown && at < i) {
        marks[i] = true
        return marks
      }
    }

    // 钩中那张按它最大的那个数当线。一张牌攥着好几个数，
    // 拿最大的划线对收牌方最有利 —— 闸门是道坎，不是罚则
    const line = maxValue(valuesOf(pile.value[at]))

    // 深水：拿 10 以内的小数钩进来，只带走钩中那张和自己，中间一张也收不走。
    // 它把小数的收益压到最低 —— 想连锅端，手上得有 11 以上的数
    if (line <= BIG_LINE && pileHasSticker(S_DEEP)) {
      marks[at] = true
      marks[selfAt] = true
      return marks
    }

    const gated = pileHasSticker(S_GATE)
    const step = at <= selfAt ? 1 : -1
    let i = at
    while (i >= 0 && i < pile.value.length) {
      // 闸门：钩中的数往右走，遇到比它大的牌就到此为止。
      //
      // 但 11 以上的大数不算坎。于是拿大数钩进来一路畅通 —— 没有哪个小数
      // 比它大，这个条件永远不成立；拿小数钩进来则处处受阻，路上随便一张
      // 稍大的小牌就是坎。对手手上于是只有 J、Q、K 和被坠子调上去的牌还有收益。
      // 多候选的牌拿它最大的那个数比，闸门是道坎不是罚则
      if (gated && i != at) {
        const worth = maxValue(valuesOf(pile.value[i]))
        if (worth > line && worth <= BIG_LINE) {
          break
        }
      }
      marks[i] = true
      if (i == selfAt) {
        break
      }
      i = i + step
    }
    return marks
  }

  // 堆里现在最大的那个点数。没点数的牌不算，空堆返回 0。
  // 齐顶就照着这个数落堆 —— 堆上有多大它就有多大
  function peakValue() : number {
    let best = 0
    for (let i = 0; i < pile.value.length; i++) {
      const worth = maxValue(valuesOf(pile.value[i]))
      if (worth != NO_VALUE && worth > best) {
        best = worth
      }
    }
    return best
  }

  // 这张牌现在算哪几个数。
  //
  // 多数牌问 cards.uts 的 valuesOf 就够了，齐顶是例外：它的点数要看牌堆，
  // 而 cards.uts 看不见牌堆。所以在这儿包一层 —— 还在手上的齐顶牌按当前堆顶算，
  // 落了堆的照常走 valuesOf（那时点数已经在落堆那一刻定死写进 pileValues 了）
  function cardValues(card : Card) : number[] {
    if (card.pileValue < 0 && !card.faceDown && card.stickerKey == S_PEAK) {
      const top = peakValue()
      return [top]
    }
    return valuesOf(card)
  }

  // 一组候选里最小的那个能当钓点的数。全是 0 或者没有点数就返回 0
  function minLiveValue(values : number[]) : number {
    let best = 0
    for (let i = 0; i < values.length; i++) {
      if (values[i] > 0 && (best == 0 || values[i] < best)) {
        best = values[i]
      }
    }
    return best
  }

  // 一组候选里最大的那个数。没有点数的牌返回 NO_VALUE
  function maxValue(values : number[]) : number {
    if (values.length == 0) {
      return NO_VALUE
    }
    let best = values[0]
    for (let i = 1; i < values.length; i++) {
      if (values[i] > best) {
        best = values[i]
      }
    }
    return best
  }

  // 这张牌现在在堆里排第几，-1 表示不在堆里
  function indexInPile(card : Card) : number {
    for (let i = 0; i < pile.value.length; i++) {
      if (pile.value[i] == card) {
        return i
      }
    }
    return -1
  }

  function countMarks(marks : boolean[]) : number {
    let total = 0
    for (let i = 0; i < marks.length; i++) {
      if (marks[i]) {
        total = total + 1
      }
    }
    return total
  }

  // 点亮要带走的那些牌，停一拍再收。
  // at 只用来判成就（撞在堆底才算连锅端），散收的效果传 -1。
  // keepsJunk 为真时背面牌也算分 —— 只有【起网】是这样，它收的就是背面牌
  function startCatch(byDealer : boolean, marks : boolean[], at : number, deep : number) {
    catchMarks.value = marks
    catchBy.value = byDealer
    catchAt = at
    catchDeep = deep
    phase.value = 'catch'
    catchTimer = setTimeout(finishCatch, CATCH_DELAY)
  }

  // 点亮那一拍过去了，把点亮的牌真正收进积分库
  function finishCatch() {
    catchTimer = -1
    const marks = catchMarks.value
    if (marks.length == 0) {
      return
    }
    const byDealer = catchBy.value
    catchMarks.value = [] as boolean[]

    const kept : Card[] = []
    const keptOwners : boolean[] = []
    const taken : Card[] = []
    for (let i = 0; i < pile.value.length; i++) {
      if (i < marks.length && marks[i]) {
        taken.push(pile.value[i])
      } else {
        kept.push(pile.value[i])
        keptOwners.push(pileFromDealer.value[i])
      }
    }

    if (byDealer) {
      dealerPoints.value = pushCards(dealerPoints.value, taken)
    } else {
      playerPoints.value = pushCards(playerPoints.value, taken)
      noteTake(taken.length, catchAt, catchDeep)
    }
    pile.value = kept
    pileFromDealer.value = keptOwners
    // 收走的那一摞里可能就有平潮、窄口这类立规矩的牌，收完立刻按新场面算
    refreshField()

    endTurn(byDealer)
  }

  // ---------- 贴纸效果 ----------
  //
  // 本版接了「不用挑牌」的那一批：落堆就自己跑完，不需要停下来等谁选。
  // 要挑位置、挑手牌、挑堆里某张的（埋钩、收线、祛除、窥探、换饵……）
  // 得先有对应的选牌界面，留到下一轮。

  // 堆里还有没有这种贴纸在起作用。背面牌整个不算数
  function pileHasSticker(key : string) : boolean {
    for (let i = 0; i < pile.value.length; i++) {
      const card = pile.value[i]
      if (card.stickerKey == key && !card.faceDown) {
        return true
      }
    }
    return false
  }

  // 堆里有没有这一方打下去的这种贴纸。
  // 立规矩的贴纸多数对双方一视同仁（统色、闸门、平潮），窄口不是 ——
  // 它掐的是对手，所以得认得出这张是谁喂的
  function pileHasStickerBy(key : string, byDealer : boolean) : boolean {
    for (let i = 0; i < pile.value.length; i++) {
      const card = pile.value[i]
      if (card.stickerKey == key && !card.faceDown
        && i < pileFromDealer.value.length && pileFromDealer.value[i] == byDealer) {
        return true
      }
    }
    return false
  }

  // 平潮：堆里有它的时候，堆上每张牌候选里的奇数一律压成 0。
  //
  // 压的是候选里的每一个数，不是整张牌：能算 13/1/2 的幸运 A 挨完这一刀
  // 剩 0/2 —— 两个奇数都成了 0，去重之后跟原来的偶数并排站着。
  // 它还活着，只是面窄了，那个 0 还能喂续钩。
  //
  // 这一刀是永久的 —— 数字直接写死在牌上，平潮之后被谁钓走了，
  // 挨过刀的那几张也变不回原来的数。所以它不是个「开关」，
  // 而是每次堆变动时再补一遍刀：平潮还在就压新来的，不在了就谁也不动。
  //
  // 改的是牌上的字段，但 pile 得换一个新数组才推得动视图；
  // 数组里装的还是原来那几个对象 —— 判撞、收割、埋钩全靠引用相等认牌，
  // 这里要是 clone 一份，那几处就全找不着自己了
  function refreshField() {
    if (!pileHasSticker(S_CALM)) {
      return
    }
    const next : Card[] = []
    let changed = false
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      next.push(one)
      if (one.faceDown || one.pileValue == NO_VALUE) {
        continue
      }
      const values = one.pileValues
      const calmed : number[] = []
      let cut = false
      for (let k = 0; k < values.length; k++) {
        const worth = values[k] > 0 && values[k] % 2 != 0 ? 0 : values[k]
        if (worth != values[k]) {
          cut = true
        }
        // 压完可能撞出重复的 0，顺手去掉
        if (!hasValue(calmed, worth)) {
          calmed.push(worth)
        }
      }
      if (cut) {
        one.pileValues = calmed
        changed = true
      }
    }
    if (changed) {
      pile.value = next
    }
  }

  // 两张牌在当前规则下算不算同花色。
  // 统色一开全场同色，混色一开红黑各并成一种，都没有就看本来的花色
  function sameSuit(a : string, b : string) : boolean {
    if (a == '' || b == '') {
      return false
    }
    if (pileHasSticker(S_UNIFY)) {
      return true
    }
    if (pileHasSticker(S_BLEND)) {
      return isRedSuit(a) == isRedSuit(b)
    }
    return a == b
  }

  // 空位类落堆之后发动。持续类的（照水、闸门、混色、统色）落下去就算数了，
  // 不用在这做什么 —— 判定的时候去堆里查它在不在
  function fireBlank(byDealer : boolean, card : Card, who : string) {
    const key = card.stickerKey
    const name = stickerName(card)
    const head = who + '打出 ' + cardText(card) + '，【' + name + '】'

    // 空位类里也有要你挑牌的（探底）。挑牌走的是跟立即类同一套流程，
    // 区别只在挑完之后：空位牌不判撞，直接把这一手走完
    if (needsPick(key)) {
      if (byDealer) {
        message.value = head + autoPick(card) + ' '
        endTurn(byDealer)
      } else {
        startPick(card, head)
      }
      return
    }

    if (key == S_HUE) {
      fireHarvest(byDealer, card, head, true)
      return
    }
    if (key == S_CAST) {
      fireHarvest(byDealer, card, head, false)
      return
    }
    if (key == S_SPLIT) {
      fireSplit(byDealer, card, head)
      return
    }
    if (key == S_DIG) {
      fireDig(byDealer, card, head)
      return
    }
    if (key == S_GATHER) {
      fireGather(byDealer, card, head)
      return
    }
    if (key == S_EVENS) {
      fireEvens(byDealer, card, head)
      return
    }
    if (key == S_GLEAN) {
      fireGlean(byDealer, card, head)
      return
    }
    // 连出的三张：这里只记下欠账，真正翻牌交给 endTurn
    if (key == S_TROLL || key == S_VOLLEY || key == S_SIEVE) {
      startRun(byDealer, key)
      message.value = head + (key == S_VOLLEY
        ? '生效，从牌库顶连着打 3 张。'
        : (key == S_TROLL
          ? '生效，从牌库顶一张张往下打，撞上为止。'
          : '生效，从牌库顶一张张往下打，打出有点数的为止。'))
      endTurn(byDealer)
      return
    }
    // 落堆就立规矩的那几张：本身不做事，堆里有它就一直生效
    if (key == S_NARROW) {
      message.value = head + '生效，' + (byDealer ? '你' : '庄家')
        + '往后每回合只补到 ' + handLimit(!byDealer) + ' 张手牌。'
      endTurn(byDealer)
      return
    }
    if (key == S_AGAIN) {
      message.value = head + '生效，往后谁打出的牌落堆算 0 点，谁就能接着再打一张。'
      endTurn(byDealer)
      return
    }
    if (key == S_RISE) {
      const n = raiseAll(1)
      message.value = n == 0
        ? head + '生效，但堆上没有能涨的牌。'
        : head + '让堆上 ' + n + ' 张牌的点数各涨了 1 点。'
      endTurn(byDealer)
      return
    }
    if (key == S_DRY) {
      const n = dryAll()
      message.value = n == 0
        ? head + '生效，但堆上已经没有带点数的牌了。'
        : head + '把堆上 ' + n + ' 张牌的点数全压成了 0，堆里再没有钓点。'
      endTurn(byDealer)
      return
    }
    if (key == S_PROP || key == S_SURGE) {
      const step = key == S_PROP ? 2 : 10
      const n = raiseLeft(card, key == S_PROP ? 2 : 1, step)
      message.value = n == 0
        ? head + '生效，但它左边没有能抬的牌。'
        : head + '把左边 ' + n + ' 张的点数各抬高了 ' + step + ' 点。'
      endTurn(byDealer)
      return
    }
    if (key == S_SHUT) {
      // 闭口：逼对手连打 3 张，一律按 0 点摆在堆顶。
      // 跟浑水的分别就在这 —— 浑水沉堆底谁也捞不着，闭口是把他的牌端到你面前
      if (byDealer) {
        playerChoke = 3
      } else {
        dealerChoke = 3
      }
      message.value = head + '生效，对手下一个回合要连打 3 张，'
        + '一律按 0 点摆在堆顶 —— 他打了等于没打，堆却厚了三层。'
      endTurn(byDealer)
      return
    }
    if (key == S_CALM) {
      message.value = head + '生效，堆上的奇数点牌就此压成 0，往后落堆的也照压。'
      endTurn(byDealer)
      return
    }
    if (key == S_DYE || key == S_SMEAR) {
      const dyed = dyeLeft(card, key == S_DYE ? 2 : 1)
      message.value = dyed == 0
        ? head + '发动了，但它左边没有牌。'
        : head + '把左边 ' + dyed + ' 张染成了 ' + card.suit + '，那几张同时变成空位。'
      endTurn(byDealer)
      return
    }
    if (key == S_MASK) {
      maskLeft = 3
      message.value = head + '生效，接下来 3 张牌一律背面落堆。'
      endTurn(byDealer)
      return
    }
    if (key == S_STIR) {
      const n = sinkFromDeck(!byDealer, 2)
      message.value = head + '从对手牌库顶抽了 ' + n + ' 张背面压进堆里。'
      endTurn(byDealer)
      return
    }
    if (key == S_MURKY) {
      if (byDealer) {
        playerForced = 3
      } else {
        dealerForced = 3
      }
      message.value = head + '生效，对手下一个回合要背面连打 3 张。'
      endTurn(byDealer)
      return
    }
    if (key == S_STREAK) {
      // 连竿不结束回合，直接把出牌权还回去
      if (byDealer) {
        dealerExtra = dealerExtra + 2
        message.value = head + '生效，庄家这一回合还能再打 2 张。'
        tidyDealerHand()
        scheduleDealer()
      } else {
        playerExtra = playerExtra + 2
        message.value = head + '生效，你这一回合还能再打 2 张。'
        tidyPlayerHand()
        phase.value = 'player'
      }
      return
    }

    // 剩下的都是持续类：照水、闸门、混色、统色
    message.value = head + '留在堆里持续生效。'
    endTurn(byDealer)
  }

  // 收色 / 撒网：把堆里符合条件的牌一次收走。
  // byHue 为真按花色收，否则按奇偶收 —— 收的都是散在堆里的牌，所以走标记数组
  function fireHarvest(byDealer : boolean, card : Card, head : string, byHue : boolean) {
    const marks : boolean[] = []
    // 撒网按自己的花色定不了奇偶，用堆里奇数多还是偶数多来决定收哪一类
    const wantOdd = byHue ? false : countParity(true) >= countParity(false)
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      if (one == card) {
        // 发动的这张自己也跟着走
        marks.push(true)
        continue
      }
      if (byHue) {
        marks.push(sameSuit(pileSuitOf(one), card.suit))
      } else {
        // 没点数的牌谈不上奇偶；0 是偶数。
        // 一张牌攥着好几个数，只要有一个数对上这次收的奇偶就收得走
        marks.push(hasParity(valuesOf(one), wantOdd))
      }
    }

    const gain = countMarks(marks)
    message.value = byHue
      ? head + '收走堆里所有 ' + card.suit + '，一共 ' + gain + ' 张。'
      : head + '收走堆里所有' + (wantOdd ? '奇数' : '偶数') + '牌，一共 ' + gain + ' 张。'
    startCatch(byDealer, marks, -1, pile.value.length - 1)
  }

  // 分水：红黑各数一遍，哪边多收哪边。
  //
  // 跟撒网同构，只是把奇偶换成了颜色 —— 撒网数的是点数，分水数的是花色，
  // 所以它收得走没点数的死牌（染色变的空位、提系压的 0 点），撒网收不走
  function fireSplit(byDealer : boolean, card : Card, head : string) {
    let red = 0
    let black = 0
    for (let i = 0; i < pile.value.length; i++) {
      const suit = pileSuitOf(pile.value[i])
      if (suit == '') {
        continue
      }
      if (isRedSuit(suit)) {
        red = red + 1
      } else {
        black = black + 1
      }
    }
    const wantRed = red >= black

    const marks : boolean[] = []
    let gain = 0
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      if (one == card) {
        // 发动的这张自己也跟着走
        marks.push(true)
        continue
      }
      const suit = pileSuitOf(one)
      // 背面牌没有花色，分不到红黑里去
      const hit = suit != '' && isRedSuit(suit) == wantRed
      marks.push(hit)
      if (hit) {
        gain = gain + 1
      }
    }

    message.value = head + '收走堆里所有' + (wantRed ? '红' : '黑') + '色牌，一共 '
      + gain + ' 张。'
    startCatch(byDealer, marks, -1, pile.value.length - 1)
  }

  // 拾偶：从堆底往右连着收偶数点的牌，遇到第一张不是偶数的就停。
  // 从堆底数是有讲究的 —— 堆底那张是压得最久的，平时只有撞中它才带得走，
  // 拾偶给了一条不靠撞数字的路
  function fireEvens(byDealer : boolean, card : Card, head : string) {
    const marks : boolean[] = []
    for (let i = 0; i < pile.value.length; i++) {
      marks.push(false)
    }

    let gain = 0
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      // 扫到自己就到头了 —— 它压在堆顶，左边那段才是要收的
      if (one == card) {
        break
      }
      // 0 是偶数，照收 —— 平潮和提系压出来的那摞死牌，正好靠它清。
      // 一张牌有一个偶数候选就算偶数；空位牌、背面牌压根没有数字，谈不上奇偶，断在那儿
      if (!hasParity(valuesOf(one), false)) {
        break
      }
      marks[i] = true
      gain = gain + 1
    }

    // 它自己跟着一起走
    const selfAt = indexInPile(card)
    if (selfAt >= 0) {
      marks[selfAt] = true
    }

    message.value = gain == 0
      ? head + '发动了，但堆底那张不是偶数，只收到它自己。'
      : head + '从堆底连着收走 ' + gain + ' 张偶数牌。'
    startCatch(byDealer, marks, -1, pile.value.length - 1)
  }

  // 拾零：把堆里所有算 0 点的牌一次收走。
  //
  // 0 点牌钩不上也没人钩得上，平时就那么烂在堆里 —— 提系压的、遮眼压的、
  // 平潮压的、贴了卸力和空钩的，全是这一张的粮食。
  // 认的是「候选里有 0」，所以空钩那种还留着原点数的牌也算数
  function fireGlean(byDealer : boolean, card : Card, head : string) {
    const marks : boolean[] = []
    let gain = 0
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      if (one == card) {
        // 发动的这张自己也跟着走
        marks.push(true)
        continue
      }
      const hit = hasValue(valuesOf(one), 0)
      marks.push(hit)
      if (hit) {
        gain = gain + 1
      }
    }

    message.value = gain == 0
      ? head + '发动了，但堆里没有算 0 点的牌，只收到它自己。'
      : head + '把堆里 ' + gain + ' 张 0 点牌一并收走。'
    startCatch(byDealer, marks, -1, pile.value.length - 1)
  }

  // 拖网：从堆底往右连着收点数在它自己 +0 到 +6 顺位内的牌。
  // 它不是空位类 —— 自己有点数、照常落堆，收完这一段之后还要照常判撞
  function fireDrag(byDealer : boolean, card : Card, head : string, base : number) {
    const marks : boolean[] = []
    for (let i = 0; i < pile.value.length; i++) {
      marks.push(false)
    }

    let gain = 0
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      if (one == card) {
        break
      }
      // 一张牌有一个候选落在范围里就算落在范围里
      if (!withinDragAny(base, valuesOf(one))) {
        break
      }
      marks[i] = true
      gain = gain + 1
    }

    if (gain == 0) {
      message.value = head + '发动了，但堆底那张不在 ' + base + ' 往上数 6 位的范围里。'
      resolveHit(false)
      return
    }

    const selfAt = indexInPile(card)
    if (selfAt >= 0) {
      marks[selfAt] = true
    }
    // 收割跟判撞是两条路，这一手走收割就不再判撞了
    playCardRef = null
    message.value = head + '从堆底连着拖走 ' + gain + ' 张。'
    startCatch(byDealer, marks, -1, pile.value.length - 1)
  }

  // 这个数在 base 往上数 6 位的范围里吗。顺位转圈，K 之后接 A ——
  // 跟游动、放线那几张的算法一致，大牌打出来不吃亏
  function withinDrag(base : number, value : number) : boolean {
    if (value == NO_VALUE || value <= 0) {
      return false
    }
    const span = RANK_COUNT
    const gap = ((value - base) % span + span) % span
    return gap <= 6
  }

  // 这张牌的候选里有没有一个落在范围内
  function withinDragAny(base : number, values : number[]) : boolean {
    for (let i = 0; i < values.length; i++) {
      if (withinDrag(base, values[i])) {
        return true
      }
    }
    return false
  }

  // 这张牌算不算这个奇偶。没有点数的牌谈不上奇偶，一律不算；
  // 0 是偶数。多候选的牌只要有一个数对上就算
  function hasParity(values : number[], wantOdd : boolean) : boolean {
    for (let i = 0; i < values.length; i++) {
      if (values[i] != NO_VALUE && (values[i] % 2 != 0) == wantOdd) {
        return true
      }
    }
    return false
  }

  // ---------- 放大系：把堆上的牌往大数区间推 ----------
  //
  // 三条规矩贯穿这一组：
  //   · 0 点牌和没有点数的牌一律不动 —— 死牌保持死着，不跟偶数流派抢地盘；
  //   · 改的是牌上的 pileValues，pile 得换个新数组才推得动视图，
  //     但数组里装的还是原来那几个对象（判撞、收割全靠引用相等认牌）；
  //   · 改别人点数的那几张是空位类，自己不判撞 —— 不然推完的结果
  //     可能正好撞上自己的点数，当场把刚推走的牌又钩回来，结果没法预判。

  function copyValues(values : number[]) : number[] {
    const out : number[] = []
    for (let i = 0; i < values.length; i++) {
      out.push(values[i])
    }
    return out
  }

  // 候选整体挪 n 位。0 和没点数的不动
  function shiftValues(values : number[], n : number) : number[] {
    const out : number[] = []
    for (let i = 0; i < values.length; i++) {
      out.push(values[i] > 0 ? values[i] + n : values[i])
    }
    return out
  }

  // 涨水：全堆一起涨。全体同增不会撞出重复 —— 原本各不相同的，加完还是各不相同
  function raiseAll(n : number) : number {
    const next : Card[] = []
    let done = 0
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      next.push(one)
      if (!hasLiveValue(valuesOf(one))) {
        continue
      }
      one.pileValues = shiftValues(one.pileValues, n)
      done = done + 1
    }
    pile.value = next
    return done
  }

  // 枯水：把堆上所有牌的点数一律压成 0。
  //
  // 归零这条路不会撞出重复 —— 0 不参与匹配，多少张 0 点牌摆在一起都合法。
  // 扫完之后堆上再没有钓点，但那一摞对谁都是现成的猎物：
  // 后面双方新打的牌之间照样能互钩，谁钩中谁就把这一摞一并收走。
  // 所以它是铺路牌，扫完得接着变现，不然是替别人铺的
  function dryAll() : number {
    const next : Card[] = []
    let done = 0
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      next.push(one)
      if (!hasLiveValue(valuesOf(one))) {
        continue
      }
      one.pileValues = [0]
      done = done + 1
    }
    pile.value = next
    return done
  }

  // 托底 / 涨潮：只抬它左边那几张。
  // 这种推法撞得出重复（[3][13] 推一下就成了两张 13），但推谁、推成几点
  // 都是打牌的人看着牌面自己定的，撞不撞得上心里有数 —— 可控的重复不算问题
  function raiseLeft(card : Card, count : number, n : number) : number {
    const at = indexInPile(card)
    if (at <= 0) {
      return 0
    }
    const next : Card[] = []
    let done = 0
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      next.push(one)
      if (i >= at || i < at - count || !hasLiveValue(valuesOf(one))) {
        continue
      }
      one.pileValues = shiftValues(one.pileValues, n)
      done = done + 1
    }
    pile.value = next
    return done
  }

  // 抽底 / 掏空：把左边那几张的点数抽干，自己加上其中最大的那个。
  //
  // 归零这条路天生安全：0 不参与匹配，所以自己再怎么涨也不可能钩中
  // 刚被自己抽干的牌。这也是这两张能当立即类的原因 —— 自己得有点数才吸得上
  function drainLeft(card : Card, count : number) : number {
    const at = indexInPile(card)
    if (at <= 0) {
      return 0
    }
    const next : Card[] = []
    let best = 0
    let done = 0
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      next.push(one)
      if (i >= at || i < at - count) {
        continue
      }
      const worth = maxValue(valuesOf(one))
      if (worth == NO_VALUE || worth <= 0) {
        continue
      }
      if (worth > best) {
        best = worth
      }
      one.pileValues = [0]
      done = done + 1
    }
    // 只加最大的那一份，不叠加 —— 抽两张也不会把自己推到三十几，
    // 这一组要的是对手没有钓点，不是自己的数字好看
    if (best > 0) {
      card.pileValues = shiftValues(card.pileValues, best)
    }
    pile.value = next
    return done
  }

  // 集花：连它自己在内，凑一组花色各不相同的牌收走。
  // 跟收色正好相反 —— 收色要的是一色到底，它要的是四色齐全，
  // 所以统色、混色那几张一开，这张反而收不动了
  function fireGather(byDealer : boolean, card : Card, head : string) {
    const marks : boolean[] = []
    const taken : string[] = []
    taken.push(card.suit)

    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      if (one == card) {
        marks.push(true)
        continue
      }
      const suit = pileSuitOf(one)
      // 背面牌没有花色，凑不进来
      if (suit == '') {
        marks.push(false)
        continue
      }
      let dup = false
      for (let k = 0; k < taken.length; k++) {
        if (sameSuit(suit, taken[k])) {
          dup = true
          break
        }
      }
      if (dup) {
        marks.push(false)
        continue
      }
      taken.push(suit)
      marks.push(true)
    }

    const gain = countMarks(marks)
    message.value = head + '凑齐了 ' + gain + ' 种花色，一并收走。'
    startCatch(byDealer, marks, -1, pile.value.length - 1)
  }

  // 起底：从最左侧的背面牌开始逐张翻开，翻到两张数字相同为止，
  // 那两张连同它们之间的牌一起收走。翻完都没配上就都留在堆里 ——
  // 翻开的照旧是翻开的，于是它们成了下一手的钓点，谁都用得上
  function fireDig(byDealer : boolean, card : Card, head : string) {
    const next : Card[] = []
    for (let i = 0; i < pile.value.length; i++) {
      next.push(pile.value[i])
    }

    // 已经翻开过哪些数字，以及它们在堆里的位置
    const seen : number[] = []
    const seenAt : number[] = []
    let from = -1
    let to = -1
    let flipped = 0

    for (let i = 0; i < next.length; i++) {
      if (!next[i].faceDown) {
        continue
      }
      const one = cloneCard(next[i])
      one.faceDown = false
      one.pileValue = worthOf(one)
      next[i] = one
      flipped = flipped + 1

      const worth = one.pileValue
      // 翻出来的数字跟前面翻开的比。0 和没点数的配不了对
      if (worth > 0) {
        for (let k = 0; k < seen.length; k++) {
          if (seen[k] == worth) {
            from = seenAt[k]
            to = i
            break
          }
        }
      }
      if (from >= 0) {
        break
      }
      seen.push(worth)
      seenAt.push(i)
    }

    pile.value = next

    if (from < 0) {
      message.value = flipped == 0
        ? head + '发动了，但堆底没有背面牌。'
        : head + '翻开了 ' + flipped + ' 张，一对都没配上，全留在堆里。'
      endTurn(byDealer)
      return
    }

    const marks : boolean[] = []
    for (let i = 0; i < pile.value.length; i++) {
      marks.push((i >= from && i <= to) || pile.value[i] == card)
    }
    const gain = countMarks(marks)
    message.value = head + '翻开 ' + flipped + ' 张，翻出一对 '
      + listText(valuesOf(pile.value[to])) + '，连中间的一起收走 ' + gain + ' 张。'
    startCatch(byDealer, marks, -1, pile.value.length - 1)
  }

  // 堆里有几张算奇数（或偶数）的牌。没点数的谈不上奇偶；0 算偶数。
  // 一张牌有奇有偶的话两边都数得上它 —— 撒网按这个挑收哪一类，宁可估多不估少
  function countParity(odd : boolean) : number {
    let total = 0
    for (let i = 0; i < pile.value.length; i++) {
      if (hasParity(valuesOf(pile.value[i]), odd)) {
        total = total + 1
      }
    }
    return total
  }

  // 染色：把这张牌左边 n 张染成它的花色。返回真染到了几张
  function dyeLeft(card : Card, n : number) : number {
    const at = indexInPile(card)
    if (at <= 0) {
      return 0
    }
    const next : Card[] = []
    let done = 0
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      next.push(one)
      if (i >= at || i < at - n) {
        continue
      }
      // 染色的同时把这张变成空位：没有点数，当不了钓点也没人钩得上，
      // 但花色还在 —— 染完那几张就只剩收色、集花够得着，而钥匙在你手里。
      // 光染色不掐点数的话，对手照样钩得走它们，白铺
      one.suit = card.suit
      one.pileValue = NO_VALUE
      one.pileValues = [] as number[]
      done = done + 1
    }
    pile.value = next
    return done
  }

  // 从谁的牌库顶抽 n 张，背面沉到堆底。返回真抽到了几张。
  // 背面牌一律加在最左侧 —— 钓牌从撞中的位置往上收，沉在底下的带不走，
  // 它们会一直攒着，等【起底】来翻
  function sinkFromDeck(fromDealer : boolean, n : number) : number {
    let done = 0
    for (let i = 0; i < n; i++) {
      const deck = fromDealer ? dealerDeck.value : playerDeck.value
      const cursor = fromDealer ? dealerCursor.value : playerCursor.value
      if (cursor >= deck.length) {
        break
      }
      const one = cloneCard(deck[cursor])
      one.faceDown = true
      one.pileValue = NO_VALUE
      if (fromDealer) {
        dealerCursor.value = cursor + 1
      } else {
        playerCursor.value = cursor + 1
      }
      pile.value = unshiftCard(pile.value, one)
      pileFromDealer.value = unshiftOwner(pileFromDealer.value, fromDealer)
      done = done + 1
    }
    return done
  }

  // 立即类落堆之后发动。要挑牌的走 startPick / autoPick，其余当场跑完
  function firePlay(byDealer : boolean, card : Card, who : string) {
    const key = card.stickerKey
    const name = stickerName(card)
    const head = who + '打出 ' + cardText(card) + '，【' + name + '】'

    if (needsPick(key)) {
      if (byDealer) {
        // 庄家自己挑，挑完接着判撞
        message.value = head + autoPick(card) + ' '
        resolveHit(false)
      } else {
        startPick(card, head)
      }
      return
    }

    // 拖网自己做收割，收完这一手就走完了，不再往下判撞
    if (key == S_DRAG) {
      // 拖网按它自己落堆后的点数划范围。多候选就取最小的那个当起点 ——
      // 范围往上数 6 位，从小的起算覆盖得最宽
      fireDrag(byDealer, card, head, minLiveValue(valuesOf(card)))
      return
    }

    if (key == S_SPY) {
      // 窥手：把他的手牌掀开，一直亮到这一回合结束
      if (!byDealer) {
        dealerHandOpen.value = true
      }
      message.value = head + (byDealer
        ? '看了你的手牌。'
        : '掀开庄家手牌 ' + dealerHand.value.length + ' 张，这一回合都看得见。')
    } else if (key == S_FEED) {
      // 喂食：双方各摸一张。手牌顶过上限的那一方，回合结束就不补牌了
      const mine = drawExtra(byDealer, 1, false)
      const yours = drawExtra(!byDealer, 1, false)
      message.value = head + '双方各摸一张（' + who + ' ' + mine + ' 张、对手 '
        + yours + ' 张）。手牌满了的那边，这回合结束不补牌。'
    } else if (key == S_LEAD) {
      // 灌铅：双方各摸两张，给对手的那两张灌死 —— 点数按 0 算，贴纸一并作废
      const mine = drawExtra(byDealer, 2, false)
      const yours = drawExtra(!byDealer, 2, true)
      message.value = head + '双方各摸两张（' + who + ' ' + mine + ' 张），'
        + '给对手的 ' + yours + ' 张灌了铅：点数算 0，贴纸也废了。'
    } else if (key == S_DRAIN) {
      const n = drainLeft(card, 1)
      message.value = n == 0
        ? head + '发动了，但它左边没有能抽的牌。'
        : head + '抽干了左边 ' + n + ' 张的点数，自己涨到了 '
          + listText(valuesOf(card)) + '。'
    } else if (key == S_EMPTY) {
      const got = fireEmpty(byDealer)
      message.value = got == ''
        ? head + '发动了，但牌库里没有空位牌了。'
        : head + '从牌库翻出 ' + got + ' 拿到手上，翻过的压回了牌库底。'
    } else if (key == S_SAND || key == S_GRIT) {
      const n = sinkFromDeck(byDealer, key == S_SAND ? 2 : 1)
      message.value = head + '从自己牌库顶抽了 ' + n + ' 张沉到堆底。'
    } else if (key == S_VEIL) {
      const n = veilLeft(card, 2)
      message.value = head + '把左边 ' + n + ' 张的点数压成了 0。'
    } else if (key == S_DREDGE) {
      const n = dredgeZeros(card)
      message.value = n == 0
        ? head + '发动了，但堆里没有点数 0 的牌。'
        : head + '把 ' + n + ' 张 0 点牌淘到了它右边。'
    } else if (key == S_WASH) {
      const n = washHand(byDealer, worthOf(card), 2)
      message.value = head + '把对手手里 ' + n + ' 张压到了他的牌库底。'
    }
    message.value = message.value + ' '
    resolveHit(false)
  }

  // ---------- 要挑牌的那一批 ----------

  function needsPick(key : string) : boolean {
    return key == S_GIVE
      || key == S_REEL
      || key == S_AKIN
      || key == S_STRIP
      || key == S_PEEK
      || key == S_SCAN
      || key == S_SINK1
      || key == S_SINK2
      || key == S_PICKED
      || key == S_PROBE1
      || key == S_PROBE2
      || key == S_PROBE3
      || key == S_PRESS
      || key == S_UNHOOK
      || key == S_SAME
  }

  // 这张贴纸要你从哪挑
  function pickKindOf(key : string) : string {
    if (key == S_GIVE) {
      return PICK_SLOT
    }
    if (key == S_REEL || key == S_STRIP || key == S_AKIN) {
      return PICK_PILE
    }
    if (key == S_SINK1 || key == S_SINK2 || key == S_PICKED) {
      return PICK_HAND
    }
    if (key == S_PROBE1 || key == S_PROBE2 || key == S_PRESS || key == S_UNHOOK) {
      return PICK_THEIRS
    }
    if (key == S_PEEK || key == S_SCAN || key == S_PROBE3) {
      return PICK_TOP
    }
    return PICK_DECK
  }

  // 要挑几张。换钩挑 3 张 —— 同是稀有档，探牌又是看牌库顶又是抽 2 张，
  // 换钩只换 2 张手牌明显吃亏，多给一张，再配上随时能收手
  function pickCountOf(key : string) : number {
    if (key == S_SINK2) {
      return 3
    }
    if (key == S_PROBE2 || key == S_SCAN || key == S_PROBE3) {
      return 2
    }
    return 1
  }

  // 挑到一半可以收手的：换饵、换钩压的是自己手牌，压多压少该由你定 ——
  // 手上正缺这张的时候，硬逼着压满反而是坑
  function canStopPick(key : string) : boolean {
    return key == S_SINK1 || key == S_SINK2
  }

  // 进选牌阶段，等你点
  function startPick(card : Card, head : string) {
    pickKey = card.stickerKey
    pickOwner = card
    pickLeft = pickCountOf(pickKey)
    pickHeld = -1
    pickKind.value = pickKindOf(pickKey)
    pickStoppable.value = canStopPick(pickKey)
    pickOfDealer = pickKey == S_PROBE3
    pickCards.value = [] as Card[]

    if (pickKind.value == PICK_TOP) {
      // 把牌库顶那几张摊出来给你看。探底摊的是庄家的牌库
      pickCards.value = topOfDeck(pickOfDealer, pickLeft)
      if (pickCards.value.length == 0) {
        message.value = head + '发动了，但'
          + (pickOfDealer ? '庄家的' : '') + '牌库已经空了。'
        finishPick()
        return
      }
    } else if (pickKind.value == PICK_DECK) {
      pickCards.value = deckChoices(false, pickKey, card)
      if (pickCards.value.length == 0) {
        message.value = head + '发动了，但牌库里没有挑得出的牌。'
        finishPick()
        return
      }
    } else if (pickKind.value == PICK_THEIRS && dealerHand.value.length == 0) {
      message.value = head + '发动了，但庄家手上没牌。'
      finishPick()
      return
    } else if (pickKind.value == PICK_HAND && playerHand.value.length == 0) {
      message.value = head + '发动了，但你手上没别的牌了。'
      finishPick()
      return
    } else if (pickKind.value == PICK_PILE && pile.value.length < 2) {
      message.value = head + '发动了，但堆里没有别的牌可挑。'
      finishPick()
      return
    }

    phase.value = 'pick'
    message.value = head + pickTip()
  }

  function pickTip() : string {
    if (pickKey == S_GIVE) {
      return '要插进哪一层？点牌堆里的牌，插到它左边；点最右边那个位置压堆顶。'
    }
    if (pickKey == S_REEL) {
      return '从牌堆挑一张，把它移到这张牌左边。'
    }
    if (pickKey == S_AKIN) {
      return '从牌堆挑一张跟它同花色的牌，这张牌就变成那个点数 —— 挑越靠左的收得越多。'
    }
    if (pickKey == S_STRIP) {
      return '从牌堆挑一张，去掉它的贴纸。'
    }
    if (pickKey == S_PEEK || pickKey == S_SCAN) {
      return '牌库顶翻开了，逐张决定留着还是压到牌库底。'
    }
    if (pickKey == S_PROBE3) {
      return '庄家的牌库顶翻开了，逐张决定留着还是压到他的牌库底。'
    }
    if (pickKey == S_SINK1 || pickKey == S_SINK2) {
      return '挑至多 ' + pickLeft + ' 张手牌压到牌库底，压够了点「不压了」。'
    }
    if (pickKey == S_PICKED) {
      return pickHeld < 0 ? '先挑一张自己的手牌给他。' : '再挑一张他的手牌拿过来。'
    }
    if (pickKey == S_PROBE1 || pickKey == S_PROBE2 || pickKey == S_PRESS) {
      return '挑 ' + pickLeft + ' 张庄家的手牌压到他的牌库底。'
    }
    if (pickKey == S_UNHOOK) {
      return '挑 1 张庄家的手牌，拿到你自己手上。'
    }
    return '从牌库里挑一张同数字的牌拿到手上。'
  }

  // 选牌结束。效果这才算跑完，接着判这一手撞没撞上
  function finishPick() {
    pickKind.value = PICK_NONE
    pickCards.value = [] as Card[]
    pickStoppable.value = false
    pickOfDealer = false
    pickLeft = 0
    pickKey = ''
    pickOwner = null
    pickHeld = -1
    message.value = message.value + ' '
    // 空位牌挑完就算走完了 —— 它没有点数，没有撞可判。
    // playCardRef 空着就是这个意思，是 commitPlay 在落堆时标下的
    if (playCardRef == null) {
      endTurn(playBy)
      return
    }
    resolveHit(false)
  }

  // 压够了就收手：剩下的不压了，手牌补满，效果算跑完
  function stopPick() {
    if (phase.value != 'pick' || !pickStoppable.value) {
      return
    }
    tidyPlayerHand()
    message.value = '不压了，手牌已经补满。'
    finishPick()
  }

  // 牌库顶的 n 张（不动游标，只是看）
  function topOfDeck(ofDealer : boolean, n : number) : Card[] {
    const deck = ofDealer ? dealerDeck.value : playerDeck.value
    const cursor = ofDealer ? dealerCursor.value : playerCursor.value
    const out : Card[] = []
    for (let i = 0; i < n && cursor + i < deck.length; i++) {
      out.push(deck[cursor + i])
    }
    return out
  }

  // 同号能从牌库里挑出哪些牌
  function deckChoices(ofDealer : boolean, key : string, card : Card) : Card[] {
    const deck = ofDealer ? dealerDeck.value : playerDeck.value
    const cursor = ofDealer ? dealerCursor.value : playerCursor.value
    const out : Card[] = []
    for (let i = cursor; i < deck.length; i++) {
      if (key == S_SAME && deck[i].rank == card.rank) {
        out.push(deck[i])
      }
    }
    return out
  }

  // 空手：从牌库顶一张张往下翻，翻到第一张空位牌就拿到手上，翻过的其他牌压到牌库底。
  //
  // 不给挑是有讲究的 —— 能挑的话，稀有档的一张牌就能稳定掏出平潮、闭口这些传说效果。
  // 翻到哪张算哪张，等于用「牌库顶排着什么」换了确定性；
  // 顺带把翻过的废牌沉下去，下一轮摸牌也干净些。
  // 返回拿到的那张牌名，空串表示牌库里一张空位牌都没有了
  function fireEmpty(ofDealer : boolean) : string {
    const deck = ofDealer ? dealerDeck.value : playerDeck.value
    const cursor = ofDealer ? dealerCursor.value : playerCursor.value
    let at = -1
    for (let i = cursor; i < deck.length; i++) {
      if (isFetchable(deck[i].stickerKey)) {
        at = i
        break
      }
    }
    if (at < 0) {
      return ''
    }

    const got = deck[at]
    const next : Card[] = []
    // 已经抽过的那一段原样留着，游标才不会错位
    for (let i = 0; i < cursor; i++) {
      next.push(deck[i])
    }
    // 翻到的那张右边的牌顶上来
    for (let i = at + 1; i < deck.length; i++) {
      next.push(deck[i])
    }
    // 翻过去的废牌压到底
    for (let i = cursor; i < at; i++) {
      next.push(deck[i])
    }

    if (ofDealer) {
      dealerDeck.value = next
      dealerHand.value = pushCard(dealerHand.value, cloneCard(got))
    } else {
      playerDeck.value = next
      playerHand.value = pushCard(playerHand.value, cloneCard(got))
    }
    return cardText(got)
  }

  // 淘沙：把堆里所有点数 0 的牌捞到这张牌右侧，也就是堆的最顶上。
  //
  // 0 点牌当不了钓点，压在堆底谁也带不走 —— 提系压出来的牌就卡在那。
  // 淘到最顶之后，之后随便哪一次钓牌都会把它们捎上（收割是从撞中的位置
  // 一路收到堆顶），死牌这才变得成分。
  // 放右边而不是左边：搁左边的话，下回要是正好撞中淘沙这张牌本身，
  // 收割从它往上走，左边那摞一张也带不走。
  // 只认点数 0，空位牌和背面牌是「没有点数」，不在此列
  function dredgeZeros(card : Card) : number {
    const zeros : Card[] = []
    const zeroOwners : boolean[] = []
    const rest : Card[] = []
    const restOwners : boolean[] = []
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      // 「算 0 点」认的是候选里有 0，而且没有别的活数 ——
      // 一张还能算成别的数的牌不算死牌，捞它没意义
      if (one != card && hasValue(valuesOf(one), 0) && !hasLiveValue(valuesOf(one))) {
        zeros.push(one)
        zeroOwners.push(pileFromDealer.value[i])
      } else {
        rest.push(one)
        restOwners.push(pileFromDealer.value[i])
      }
    }
    if (zeros.length == 0) {
      return 0
    }

    const next : Card[] = []
    const owners : boolean[] = []
    for (let i = 0; i < rest.length; i++) {
      next.push(rest[i])
      owners.push(restOwners[i])
      if (rest[i] == card) {
        for (let k = 0; k < zeros.length; k++) {
          next.push(zeros[k])
          owners.push(zeroOwners[k])
        }
      }
    }
    pile.value = next
    pileFromDealer.value = owners
    return zeros.length
  }

  // 遮眼：把这张牌左边 n 张的点数压成 0，位置和牌面都不动。
  //
  // 0 当不了钓点，所以这是在废掉对手现成的钓点；但花色还在，
  // 收色和集花照样收得走，淘沙也能把它们淘到顶上 —— 废掉的牌不是死透了
  function veilLeft(card : Card, n : number) : number {
    const at = indexInPile(card)
    if (at <= 0) {
      return 0
    }
    const next : Card[] = []
    let done = 0
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      // 候选整组压成 0 —— 能算成好几个数的，一个都不留
      if (i < at && i >= at - n && hasLiveValue(valuesOf(one))) {
        one.pileValues = [0]
        done = done + 1
      }
      next.push(one)
    }
    pile.value = next
    return done
  }

  // 洗手：对手手里顺位在 line ±span 以内的牌，全压到他的牌库底。
  // 压底而不是丢掉 —— 那几张还在他牌库里，只是轮到他再摸出来得等很久
  function washHand(byDealer : boolean, line : number, span : number) : number {
    const hand = byDealer ? playerHand.value : dealerHand.value
    const keep : Card[] = []
    const sunk : Card[] = []
    for (let i = 0; i < hand.length; i++) {
      if (withinRank(worthOf(hand[i]), line, span)) {
        // 进牌库的一律拿副本，跟压手牌那条路（sinkHandCard）保持一致
        sunk.push(cloneCard(hand[i]))
      } else {
        keep.push(hand[i])
      }
    }
    if (sunk.length == 0) {
      return 0
    }
    if (byDealer) {
      playerHand.value = keep
      playerDeck.value = pushCards(playerDeck.value, sunk)
      tidyPlayerHand()
    } else {
      dealerHand.value = keep
      dealerDeck.value = pushCards(dealerDeck.value, sunk)
      tidyDealerHand()
    }
    return sunk.length
  }

  // 两个点数的顺位差在 span 以内吗。顺位是转圈的，13 和 1 只差 1 位
  function withinRank(a : number, b : number, span : number) : boolean {
    let gap = a - b
    if (gap < 0) {
      gap = -gap
    }
    if (gap > 6) {
      gap = 13 - gap
    }
    return gap <= span
  }

  // ---------- 选牌：你点下去之后 ----------

  // 点了牌堆里第 index 张。
  //
  // 贴纸正等你挑牌的时候，这一下是「挑这张」；
  // 平时则是「看这张」—— 堆里的牌决定了下一手能钩到哪儿，
  // 它贴着什么、现在算几点，得随时查得到
  function tapPile(index : number) {
    if (phase.value == 'pick') {
      pickFromPile(index)
      return
    }
    if (index < 0 || index >= pile.value.length) {
      return
    }
    showPileCard(pile.value[index], index)
  }

  // 堆里这张牌的底细：算几点、谁打的、贴纸干什么
  function showPileCard(card : Card, index : number) {
    // 沉在底下的暗牌谁都不该看见，包括自己盖的那张
    if (card.faceDown) {
      toast('这是张盖着的牌，翻开之前谁也看不到')
      return
    }
    const from = index < pileFromDealer.value.length && pileFromDealer.value[index]
      ? '庄家打的' : '你打的'
    const values = valuesOf(card)
    const worth = values.length == 0 ? '没有点数，钩不上也钩不着' : '算 ' + listText(values) + ' 点'
    let body = from + '，' + worth + '。'
    if (card.stickerKey != S_NONE) {
      const sticker = stickerAt(card.stickerKey)
      body = body + '\n\n【' + sticker.name + '】' + sticker.desc
    }
    uni.showModal({
      title: cardText(card),
      content: body,
      showCancel: false,
      confirmText: '知道了'
    })
  }

  function pickFromPile(index : number) {
    if (phase.value != 'pick') {
      return
    }
    if (pickKind.value == PICK_SLOT) {
      movePickedInto(index)
      return
    }
    if (pickKind.value != PICK_PILE) {
      return
    }
    if (index < 0 || index >= pile.value.length) {
      return
    }
    // 不能挑发起的那张自己
    if (pile.value[index] == pickOwner) {
      return
    }

    if (pickKey == S_AKIN) {
      // 同源：只认同花色。改的是自己 —— 变成跟挑中那张一样的点数，
      // 紧接着的判撞就必然钩中它。堆里那张一个字都没动，
      // 所以不留重叠、也不会把堆的状态搅乱
      const one = pile.value[index]
      const owner = pickOwner
      if (owner == null) {
        finishPick()
        return
      }
      const card = owner as Card
      if (!sameSuit(pileSuitOf(one), card.suit)) {
        message.value = '【同源】只挑得动跟它同花色的牌，换一张。'
        return
      }
      card.pileValues = copyValues(one.pileValues)
      card.pileValue = card.pileValues.length > 0 ? 0 : NO_VALUE
      const next : Card[] = []
      for (let i = 0; i < pile.value.length; i++) {
        next.push(pile.value[i])
      }
      pile.value = next
      message.value = '【同源】跟着 ' + cardText(one) + ' 变成了 '
        + listText(valuesOf(card)) + '。'
    } else if (pickKey == S_REEL) {
      const name = cardText(pile.value[index])
      moveBeside(index)
      message.value = '【收线】把 ' + name + ' 移到了这张牌左边。'
    } else {
      const one = pile.value[index]
      const had = one.stickerKey != S_NONE
      if (had) {
        const next : Card[] = []
        for (let i = 0; i < pile.value.length; i++) {
          if (i == index) {
            const copy = cloneCard(one)
            copy.stickerKey = S_NONE
            // 撕掉贴纸之后数字回到牌面值
            copy.pileValue = worthOf(copy)
            next.push(copy)
          } else {
            next.push(pile.value[i])
          }
        }
        pile.value = next
      }
      message.value = had
        ? '【祛除】撕掉了 ' + cardText(one) + ' 的贴纸。'
        : '那张本来就没有贴纸。'
    }
    finishPick()
  }

  // 收线：把第 from 张抽出来，插到发起那张牌的左边
  function moveBeside(from : number) {
    const moving = pile.value[from]
    const rest : Card[] = []
    const restOwners : boolean[] = []
    for (let i = 0; i < pile.value.length; i++) {
      if (i != from) {
        rest.push(pile.value[i])
        restOwners.push(pileFromDealer.value[i])
      }
    }
    const next : Card[] = []
    const owners : boolean[] = []
    for (let i = 0; i < rest.length; i++) {
      if (rest[i] == pickOwner) {
        next.push(moving)
        owners.push(false)
      }
      next.push(rest[i])
      owners.push(restOwners[i])
    }
    pile.value = next
    pileFromDealer.value = owners
  }

  // 埋钩：把发起的那张牌抽出来，插到第 slot 张的左边。slot 等于堆长就是压堆顶
  function movePickedInto(slot : number) {
    const rest : Card[] = []
    const restOwners : boolean[] = []
    let self : Card | null = null
    for (let i = 0; i < pile.value.length; i++) {
      if (pile.value[i] == pickOwner) {
        self = pile.value[i]
      } else {
        rest.push(pile.value[i])
        restOwners.push(pileFromDealer.value[i])
      }
    }
    if (self == null) {
      finishPick()
      return
    }
    const one = self as Card
    const next : Card[] = []
    const owners : boolean[] = []
    let at = slot
    if (at > rest.length) {
      at = rest.length
    }
    for (let i = 0; i < rest.length; i++) {
      if (i == at) {
        next.push(one)
        owners.push(false)
      }
      next.push(rest[i])
      owners.push(restOwners[i])
    }
    if (at >= rest.length) {
      next.push(one)
      owners.push(false)
    }
    pile.value = next
    pileFromDealer.value = owners
    message.value = '【埋钩】把它埋在了第 ' + (at + 1) + ' 层。'
    finishPick()
  }

  // 点了自己第 index 张手牌
  function pickFromHand(index : number) {
    if (phase.value != 'pick' || pickKind.value != PICK_HAND) {
      return
    }
    if (index < 0 || index >= playerHand.value.length) {
      return
    }
    const one = playerHand.value[index]

    if (pickKey == S_PICKED) {
      // 对换第一步：记下要给出去的那张，换成挑他的
      pickHeld = index
      pickKind.value = PICK_THEIRS
      message.value = '【对换】留着 ' + cardText(one) + ' 给他，' + pickTip()
      return
    }

    // 换饵 / 换钩：压到牌库底
    sinkHandCard(false, index)
    pickLeft = pickLeft - 1
    if (pickLeft > 0 && playerHand.value.length > 0) {
      message.value = '压回去一张，还能再压 ' + pickLeft + ' 张，不压了就点「不压了」。'
      return
    }
    tidyPlayerHand()
    message.value = '手牌压回牌库底，已经补满。'
    finishPick()
  }

  // 点了庄家第 index 张手牌
  function pickFromTheirs(index : number) {
    if (phase.value != 'pick' || pickKind.value != PICK_THEIRS) {
      return
    }
    if (index < 0 || index >= dealerHand.value.length) {
      return
    }
    const one = dealerHand.value[index]

    if (pickKey == S_PICKED) {
      // 对换第二步：两张对调
      if (pickHeld < 0 || pickHeld >= playerHand.value.length) {
        finishPick()
        return
      }
      const mine = playerHand.value[pickHeld]
      const nextMine : Card[] = []
      for (let i = 0; i < playerHand.value.length; i++) {
        nextMine.push(i == pickHeld ? one : playerHand.value[i])
      }
      const nextTheirs : Card[] = []
      for (let i = 0; i < dealerHand.value.length; i++) {
        nextTheirs.push(i == index ? mine : dealerHand.value[i])
      }
      playerHand.value = nextMine
      dealerHand.value = nextTheirs
      message.value = '【对换】拿他的 ' + cardText(one) + ' 换走了你的 ' + cardText(mine) + '。'
      finishPick()
      return
    }

    if (pickKey == S_UNHOOK) {
      // 摘钩：把他这张直接摘到你手上。他少一张、你多一张，
      // 而且那多半正是他唯一钩得上的牌
      dealerHand.value = removeAt(dealerHand.value, index)
      playerHand.value = pushCard(playerHand.value, cloneCard(one))
      tidyDealerHand()
      message.value = '【摘钩】把庄家的 ' + cardText(one) + ' 摘到了你手上。'
      finishPick()
      return
    }

    // 摸底 / 掏底 / 压舱：压到他的牌库底
    sinkHandCard(true, index)
    pickLeft = pickLeft - 1
    if (pickLeft > 0 && dealerHand.value.length > 0) {
      message.value = '压下去一张，还要挑 ' + pickLeft + ' 张。'
      return
    }
    tidyDealerHand()
    message.value = '庄家的牌压到了牌库底，他重新补满了手牌。'
    finishPick()
  }

  // 点了摊开的候选牌（牌库顶 / 牌库里挑）
  function pickFromSpread(index : number) {
    if (phase.value != 'pick') {
      return
    }
    if (index < 0 || index >= pickCards.value.length) {
      return
    }
    if (pickKind.value == PICK_DECK) {
      takeFromDeck(index)
      return
    }
    if (pickKind.value != PICK_TOP) {
      return
    }
    // 窥探 / 探牌：点一张就是把它压到牌库底，不点就是留着
    sinkTopCard(index)
    const rest : Card[] = []
    for (let i = 0; i < pickCards.value.length; i++) {
      if (i != index) {
        rest.push(pickCards.value[i])
      }
    }
    pickCards.value = rest
    if (rest.length > 0) {
      message.value = '压到牌库底了。剩下的要压就接着点，不压就点「留着」。'
      return
    }
    finishTop()
  }

  // 窥探 / 探牌：不再压了，剩下的留在牌库顶
  function keepTop() {
    if (phase.value != 'pick' || pickKind.value != PICK_TOP) {
      return
    }
    finishTop()
  }

  function finishTop() {
    // 探牌看完还要抽牌，窥探不抽 —— 手牌本来就满，抽了也是多弃少补
    if (pickKey == S_SCAN) {
      tidyPlayerHand()
    }
    message.value = pickOfDealer ? '看完了庄家的牌库顶。' : '看完了牌库顶。'
    finishPick()
  }

  // 把摊开的第 index 张从牌库拿到手上
  function takeFromDeck(index : number) {
    const one = pickCards.value[index]
    const next : Card[] = []
    let taken = false
    for (let i = 0; i < playerDeck.value.length; i++) {
      if (!taken && playerDeck.value[i] == one && i >= playerCursor.value) {
        taken = true
        continue
      }
      next.push(playerDeck.value[i])
    }
    playerDeck.value = next
    playerHand.value = pushCard(playerHand.value, cloneCard(one))
    message.value = '把 ' + cardText(one) + ' 拿到了手上。'
    finishPick()
  }

  // 把某一方手里第 index 张压到他自己的牌库底
  function sinkHandCard(ofDealer : boolean, index : number) {
    const hand = ofDealer ? dealerHand.value : playerHand.value
    if (index >= hand.length) {
      return
    }
    const one = hand[index]
    if (ofDealer) {
      dealerHand.value = removeAt(hand, index)
      dealerDeck.value = pushCard(dealerDeck.value, cloneCard(one))
    } else {
      playerHand.value = removeAt(hand, index)
      playerDeck.value = pushCard(playerDeck.value, cloneCard(one))
    }
  }

  // 窥探 / 探牌：把牌库顶摊开的第 index 张压到牌库底
  function sinkTopCard(index : number) {
    const one = pickCards.value[index]
    const deck = pickOfDealer ? dealerDeck.value : playerDeck.value
    const cursor = pickOfDealer ? dealerCursor.value : playerCursor.value
    const next : Card[] = []
    let moved = false
    for (let i = 0; i < deck.length; i++) {
      if (!moved && deck[i] == one && i >= cursor) {
        moved = true
        continue
      }
      next.push(deck[i])
    }
    if (moved) {
      next.push(one)
    }
    if (pickOfDealer) {
      dealerDeck.value = next
    } else {
      playerDeck.value = next
    }
  }

  // ---------- 选牌：庄家自己挑 ----------
  //
  // 庄家不进选牌阶段，打出来就按下面的路子挑完。挑法都很直白 ——
  // 它看得到的信息跟你一样多，不作弊

  function autoPick(card : Card) : string {
    const key = card.stickerKey
    pickOwner = card

    if (key == S_GIVE) {
      // 埋钩：埋到最底下，钓到它的人才捞得最多 —— 它赌的是自己先钓到
      movePickedQuiet(0)
      return '把它埋到了堆底。'
    }
    if (key == S_REEL) {
      // 收线：把堆里最值钱的那个钓点抽到自己身边，让它变浅
      const at = deepestPoint(card)
      if (at < 0) {
        return '发动了，但堆里没有别的牌可挑。'
      }
      const name = cardText(pile.value[at])
      moveBeside(at)
      return '把 ' + name + ' 移到了它左边。'
    }
    if (key == S_AKIN) {
      // 同源：挑最靠堆底的那张同花色牌，变成它 —— 钩得越深收得越多
      let at = -1
      for (let i = 0; i < pile.value.length; i++) {
        const one = pile.value[i]
        if (one != card && hasLiveValue(valuesOf(one))
          && sameSuit(pileSuitOf(one), card.suit)) {
          at = i
          break
        }
      }
      if (at < 0) {
        return '发动了，但堆里没有同花色的牌。'
      }
      const one = pile.value[at]
      card.pileValues = copyValues(one.pileValues)
      card.pileValue = card.pileValues.length > 0 ? 0 : NO_VALUE
      return '跟着 ' + cardText(one) + ' 变成了 ' + listText(valuesOf(card)) + '。'
    }
    if (key == S_STRIP) {
      // 祛除：撕掉你打出的、带贴纸的那张
      const at = strippable(card)
      if (at < 0) {
        return '发动了，但堆里没有带贴纸的牌。'
      }
      const one = pile.value[at]
      const next : Card[] = []
      for (let i = 0; i < pile.value.length; i++) {
        if (i == at) {
          const copy = cloneCard(one)
          copy.stickerKey = S_NONE
          copy.pileValue = worthOf(copy)
          next.push(copy)
        } else {
          next.push(pile.value[i])
        }
      }
      pile.value = next
      return '撕掉了 ' + cardText(one) + ' 的贴纸。'
    }
    if (key == S_PEEK || key == S_SCAN) {
      // 看牌库顶：钓不到的就压回底下
      const n = key == S_SCAN ? 2 : 1
      const tops = topOfDeck(true, n)
      let sunk = 0
      for (let i = 0; i < tops.length; i++) {
        if (pileIndexOf(pile.value, cardValues(tops[i])) < 0) {
          sinkDealerTop(tops[i])
          sunk = sunk + 1
        }
      }
      return '看了牌库顶 ' + tops.length + ' 张，压回去 ' + sunk + ' 张。'
    }
    if (key == S_PROBE3) {
      // 探底：翻你的牌库顶，能钓到东西的一律压回底下去
      const tops = topOfDeck(false, pickCountOf(key))
      let sunk = 0
      for (let i = 0; i < tops.length; i++) {
        if (pileIndexOf(pile.value, cardValues(tops[i])) >= 0) {
          sinkPlayerTop(tops[i])
          sunk = sunk + 1
        }
      }
      return '看了你牌库顶 ' + tops.length + ' 张，压回去 ' + sunk + ' 张。'
    }
    if (key == S_SINK1 || key == S_SINK2) {
      const n = pickCountOf(key)
      let done = 0
      for (let i = 0; i < n; i++) {
        const at = worstInHand(dealerHand.value)
        if (at < 0) {
          break
        }
        sinkHandCard(true, at)
        done = done + 1
      }
      tidyDealerHand()
      return '把 ' + done + ' 张手牌压回了牌库底。'
    }
    if (key == S_PICKED) {
      const mine = worstInHand(dealerHand.value)
      const yours = bestInHand(playerHand.value)
      if (mine < 0 || yours < 0) {
        return '发动了，但没换成。'
      }
      const a = dealerHand.value[mine]
      const b = playerHand.value[yours]
      const nextTheirs : Card[] = []
      for (let i = 0; i < dealerHand.value.length; i++) {
        nextTheirs.push(i == mine ? b : dealerHand.value[i])
      }
      const nextMine : Card[] = []
      for (let i = 0; i < playerHand.value.length; i++) {
        nextMine.push(i == yours ? a : playerHand.value[i])
      }
      dealerHand.value = nextTheirs
      playerHand.value = nextMine
      return '拿走了你的 ' + cardText(b) + '，塞给你一张 ' + cardText(a) + '。'
    }
    if (key == S_PROBE1 || key == S_PROBE2 || key == S_PRESS) {
      const n = key == S_PROBE2 ? 2 : 1
      let done = 0
      for (let i = 0; i < n; i++) {
        const at = bestInHand(playerHand.value)
        if (at < 0) {
          break
        }
        sinkHandCard(false, at)
        done = done + 1
      }
      tidyPlayerHand()
      return '把你 ' + done + ' 张手牌压到了牌库底。'
    }
    if (key == S_UNHOOK) {
      // 摘钩：挑你手上最有用的那张摘走
      const at = bestInHand(playerHand.value)
      if (at < 0) {
        return '发动了，但你手上没牌。'
      }
      const yours = playerHand.value[at]
      playerHand.value = removeAt(playerHand.value, at)
      dealerHand.value = pushCard(dealerHand.value, cloneCard(yours))
      tidyPlayerHand()
      return '把你的 ' + cardText(yours) + ' 摘走了。'
    }
    // 同号：从自己牌库里挑第一张同数字的
    const choices = deckChoices(true, key, card)
    if (choices.length == 0) {
      return '发动了，但牌库里没有挑得出的牌。'
    }
    const one = choices[0]
    const next : Card[] = []
    let taken = false
    for (let i = 0; i < dealerDeck.value.length; i++) {
      if (!taken && dealerDeck.value[i] == one && i >= dealerCursor.value) {
        taken = true
        continue
      }
      next.push(dealerDeck.value[i])
    }
    dealerDeck.value = next
    dealerHand.value = pushCard(dealerHand.value, cloneCard(one))
    return '从牌库里抽走了一张牌。'
  }

  // 埋钩的庄家版：不出提示，直接插
  function movePickedQuiet(slot : number) {
    const rest : Card[] = []
    const restOwners : boolean[] = []
    let self : Card | null = null
    for (let i = 0; i < pile.value.length; i++) {
      if (pile.value[i] == pickOwner) {
        self = pile.value[i]
      } else {
        rest.push(pile.value[i])
        restOwners.push(pileFromDealer.value[i])
      }
    }
    if (self == null) {
      return
    }
    const one = self as Card
    const next : Card[] = []
    const owners : boolean[] = []
    for (let i = 0; i < rest.length; i++) {
      if (i == slot) {
        next.push(one)
        owners.push(true)
      }
      next.push(rest[i])
      owners.push(restOwners[i])
    }
    if (slot >= rest.length) {
      next.push(one)
      owners.push(true)
    }
    pile.value = next
    pileFromDealer.value = owners
  }

  // 堆里最值钱的那个钓点（撞上它能带走最多）
  function deepestPoint(skip : Card) : number {
    let best = -1
    let bestTake = 0
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      if (one == skip || isDeadCard(one)) {
        continue
      }
      const take = pile.value.length - i
      if (take > bestTake) {
        bestTake = take
        best = i
      }
    }
    return best
  }

  // 堆里哪张带着贴纸，优先撕对手打出的
  function strippable(skip : Card) : number {
    let fallback = -1
    for (let i = 0; i < pile.value.length; i++) {
      const one = pile.value[i]
      if (one == skip || one.stickerKey == S_NONE || one.faceDown) {
        continue
      }
      if (!pileFromDealer.value[i]) {
        return i
      }
      fallback = i
    }
    return fallback
  }

  // 庄家把牌库顶某张压到底
  function sinkDealerTop(one : Card) {
    const next : Card[] = []
    let moved = false
    for (let i = 0; i < dealerDeck.value.length; i++) {
      if (!moved && dealerDeck.value[i] == one && i >= dealerCursor.value) {
        moved = true
        continue
      }
      next.push(dealerDeck.value[i])
    }
    if (moved) {
      next.push(one)
    }
    dealerDeck.value = next
  }

  // 庄家把你牌库顶某张压到你的牌库底 —— 探底用
  function sinkPlayerTop(one : Card) {
    const next : Card[] = []
    let moved = false
    for (let i = 0; i < playerDeck.value.length; i++) {
      if (!moved && playerDeck.value[i] == one && i >= playerCursor.value) {
        moved = true
        continue
      }
      next.push(playerDeck.value[i])
    }
    if (moved) {
      next.push(one)
    }
    playerDeck.value = next
  }

  // 手里最没用的一张：钓不到东西、落下去还容易被接走的
  function worstInHand(hand : Card[]) : number {
    let worst = -1
    let worstScore = -1
    for (let i = 0; i < hand.length; i++) {
      const one = hand[i]
      if (one.stickerKey == S_HAUL) {
        continue
      }
      if (pileIndexOf(pile.value, cardValues(one)) >= 0) {
        continue
      }
      // 越是「对手还攥着一堆同号」的牌越该丢 —— 留着也接不上什么
      const score = unseenOf(cardValues(one))
      if (score > worstScore) {
        worstScore = score
        worst = i
      }
    }
    if (worst < 0 && hand.length > 0) {
      worst = 0
    }
    return worst
  }

  // 对手手里最值钱的一张：能钓到东西的优先，其次是 J
  function bestInHand(hand : Card[]) : number {
    for (let i = 0; i < hand.length; i++) {
      if (hand[i].stickerKey == S_HAUL) {
        return i
      }
    }
    for (let i = 0; i < hand.length; i++) {
      if (pileIndexOf(pile.value, cardValues(hand[i])) >= 0) {
        return i
      }
    }
    return hand.length > 0 ? 0 : -1
  }

  // 一手走完：补牌、记回合、交给下一位。
  // 连竿欠着的额外出牌先还完，还完了这一回合才算结束
  function endTurn(byDealer : boolean) {
    if (byDealer) {
      tidyDealerHand()
    } else {
      tidyPlayerHand()
    }

    // 试钓 / 连投 / 滤水还欠着牌：接着翻下一张，这一手不算完。
    // 放在最前面 —— 连出的那几张跟浑水的盖牌一样，都在同一个回合里
    if (keepRunning(byDealer)) {
      return
    }

    // 续钩：这一手落堆算 0 点，堆里又有续钩，出牌权原样还回来。
    //
    // 只认 0 点，不认空位。这两件事看着像，其实是两回事：
    // 0 点是提系压出来的、平潮压出来的，牌面上实打实写着个 0；
    // 空位类压根没有数字，NO_VALUE 不是 0。
    // 分清楚了，续钩也就触发不了它自己 —— 它自己就是张空位牌
    if (phase.value != 'over' && hasValue(lastValues, 0) && pileHasSticker(S_AGAIN)) {
      message.value = message.value + ' 【续钩】这张落堆算 0 点，'
        + (byDealer ? '庄家' : '你') + '接着再打一张。'
      if (byDealer) {
        scheduleDealer()
      } else {
        phase.value = 'player'
      }
      return
    }

    // 浑水、闭口欠着的牌还没打完 —— 那几张是同一个回合里连着打的，不各算一回合。
    // 两个计数的递减都在 commitPlay 里，这里只负责把出牌权留在同一方手上
    const forced = (byDealer ? dealerForced : playerForced)
      + (byDealer ? dealerChoke : playerChoke)
    if (forced > 0 && phase.value != 'over') {
      if (byDealer) {
        scheduleDealer()
      } else {
        phase.value = 'player'
      }
      return
    }

    const extra = byDealer ? dealerExtra : playerExtra
    if (extra > 0 && phase.value != 'over') {
      if (byDealer) {
        dealerExtra = extra - 1
        scheduleDealer()
      } else {
        playerExtra = extra - 1
        phase.value = 'player'
      }
      return
    }

    // 这一回合是真的完了。窥手掀开的手牌到此为止 ——
    // 照水那种持续明示不归这里管，它靠堆里有没有那张牌说话
    if (!byDealer) {
      dealerHandOpen.value = false
    }
    if (byDealer) {
      dealerTurns.value = dealerTurns.value + 1
    } else {
      playerTurns.value = playerTurns.value + 1
    }
    afterAction(byDealer)
  }

  // 你钓到牌了：记下来给成就用。
  // at 是撞在堆里第几张，deep 是撞之前堆有多大
  function noteTake(gained : number, at : number, deep : number) {
    if (gained >= BIG_TAKE) {
      gainAchievement(ACH_TWIN_PAIR)
    }
    // 撞在堆底，把整个堆连锅端了
    if (at == 0 && deep >= DEEP_PILE) {
      gainAchievement(ACH_FORESEE)
    }
    // playerTurns 这时还没 +1，所以当前回合号是 playerTurns + 1
    const nowTurn = playerTurns.value + 1
    if (lastTakeTurn >= 0 && nowTurn - lastTakeTurn == 1) {
      gainAchievement(ACH_STAND_BROKEN)
    }
    lastTakeTurn = nowTurn
    tookOnLastTurn = nowTurn >= level.value.turns
  }

  // 一次行动做完：记成就、看要不要结算、再看该谁动
  function afterAction(lastWasDealer : boolean) {
    checkAchievements()
    nextAction(lastWasDealer)
  }

  // ---------- 回合 ----------

  function nextAction(lastWasDealer : boolean) {
    if (phase.value == 'over') {
      return
    }
    const turns = level.value.turns
    if (playerTurns.value >= turns && dealerTurns.value >= turns) {
      settle()
      return
    }

    // 正常是你一手我一手；谁先打满自己的回合，就让另一方把剩下的打完
    let dealerGoes = !lastWasDealer
    if (dealerGoes && dealerTurns.value >= turns) {
      dealerGoes = false
    } else if (!dealerGoes && playerTurns.value >= turns) {
      dealerGoes = true
    }

    if (dealerGoes) {
      phase.value = 'dealer'
      scheduleDealer()
      return
    }
    // 轮到你。牌库和手牌都空了就只能干看着，这一回合算走过场
    if (playerHand.value.length == 0) {
      playerTurns.value = playerTurns.value + 1
      message.value = '你没牌可出，这一回合跳过。'
      afterAction(false)
      return
    }
    phase.value = 'player'
  }

  // ---------- 庄家 ----------

  function dealerTurn() {
    if (phase.value == 'over') {
      return
    }
    if (dealerHand.value.length == 0) {
      dealerTurns.value = dealerTurns.value + 1
      message.value = '庄家没牌可出，这一回合跳过。'
      afterAction(true)
      return
    }
    dealerPlay()
  }

  // 庄家的全部决策都在这。它要回答的只剩一个：这一手打哪张。
  // 牌落堆不坍缩，所以「按几点落」已经不用选了 —— 钩哪张由候选自动定。
  // 三档难度差在「肯不肯为了钓得更深忍一手」和「落下去的牌会不会送分」
  function dealerPlay() {
    const hand = dealerHand.value

    // 手上钓得最深的那一手
    let hitIndex = -1
    let hitTake = 0
    let haulIndex = -1
    for (let i = 0; i < hand.length; i++) {
      if (hand[i].stickerKey == S_HAUL) {
        haulIndex = i
        continue
      }
      // 空位牌落堆没有点数，钩不上任何东西
      if (isBlankSticker(hand[i].stickerKey)) {
        continue
      }
      const take = takeCount(pile.value, cardValues(hand[i]))
      if (take > hitTake) {
        hitTake = take
        hitIndex = i
      }
    }

    // 随机档：抓哪张打哪张，顺手能钓就钓。
    // 目前没有关卡挂这一档 —— 随机出牌的庄家不管玩家带什么牌组都赢得下来，
    // 等于让前几关跟构筑无关。留着是给调试和以后的教学关用
    if (level.value.ai == 1) {
      commitPlay(true, Math.floor(Math.random() * hand.length))
      return
    }

    // J 是一张随时能兑现的支票，越晚打越值钱 —— 但打完最后一个回合就作废了。
    // 堆压够厚、或者已经没有下一手可等，就兑现它
    if (haulIndex >= 0) {
      const haulLine = level.value.ai == 3 ? 5 : 4
      const lastCall = dealerTurns.value + 1 >= level.value.turns
      if (pile.value.length + 1 >= haulLine || (lastCall && pile.value.length > 0)) {
        commitPlay(true, haulIndex)
        return
      }
    }

    // 稳健档：钓得够深就钓，否则随手挑张钓不到的落下去
    if (level.value.ai == 2) {
      if (hitIndex >= 0 && hitTake >= 3) {
        commitPlay(true, hitIndex)
        return
      }
      for (let i = 0; i < hand.length; i++) {
        if (hand[i].stickerKey == S_HAUL || isBlankSticker(hand[i].stickerKey)) {
          continue
        }
        if (takeCount(pile.value, cardValues(hand[i])) == 0) {
          commitPlay(true, i)
          return
        }
      }
      if (hitIndex >= 0) {
        commitPlay(true, hitIndex)
        return
      }
      commitPlay(true, 0)
      return
    }

    // ---- 精算档：每种打法都算一笔账，挑分最高的 ----
    //
    //   分 = 这一手到手的牌 × 10 − 落完之后堆对我的威胁
    //
    // 威胁按「每个钓点能带走几张 × 这个数字还有几张可能在你手上」算，
    // 所以它现在会做这些事：
    //   · 一个数字出光了就放心落，哪怕那是张大牌；
    //   · 宁可钓浅的，也不把厚堆留在你面前；
    //   · 快收官了就不再留手，反正堆留着也是废牌。
    let bestScore = -99999
    let bestIndex = -1
    const lastCall = dealerTurns.value + 1 >= level.value.turns

    for (let i = 0; i < hand.length; i++) {
      const card = hand[i]
      if (card.stickerKey == S_HAUL) {
        continue
      }

      // 空位牌不参与钩牌，它的价值全在效果上
      if (isBlankSticker(card.stickerKey)) {
        const gain = stickerGain(card)
        // 收不到东西的空位牌先留着，别白填一层堆厚
        const score = gain > 0 ? gain * 10 - pileThreat() : -50
        if (score > bestScore) {
          bestScore = score
          bestIndex = i
        }
        continue
      }

      const take = takeCount(pile.value, cardValues(card))
      let score = take * 10 - threatAfter(card)
      // 立即类贴纸顺手能办点事，算一点加成
      score = score + stickerGain(card) * 8
      // 最后一手了，留着的牌一分不值，只认眼前能收多少
      if (lastCall) {
        score = take * 10
      }
      if (score > bestScore) {
        bestScore = score
        bestIndex = i
      }
    }

    // 兜底：手上只剩 J 或者算不出结果，随便落一张
    commitPlay(true, bestIndex >= 0 ? bestIndex : 0)
  }

  // 试着把这张牌落下去，算出落完之后的堆有多危险。
  // 真动牌堆再还原 —— 比另写一套模拟省事，也不会跟真正落堆的规则走岔
  function threatAfter(card : Card) : number {
    const backup : Card[] = []
    for (let i = 0; i < pile.value.length; i++) {
      backup.push(pile.value[i])
    }
    const copy = cloneCard(card)
    copy.pileValues = cardValues(card)
    copy.pileValue = copy.pileValues.length > 0 ? 0 : NO_VALUE
    pile.value = dropsAtBottom(card.stickerKey)
      ? unshiftCard(pile.value, copy)
      : pushCard(pile.value, copy)
    const threat = pileThreat()
    pile.value = backup
    return threat
  }

  // 这张贴纸现在打出去值几分。只估收割类 ——
  // 别的效果（看手牌、埋背面牌、改花色）好处太绕，让它按 0 算，
  // 于是庄家只在「这一手确实能收到东西」的时候才舍得用掉收割牌
  function stickerGain(card : Card) : number {
    const key = card.stickerKey
    if (key == S_HUE) {
      let total = 1
      for (let i = 0; i < pile.value.length; i++) {
        if (sameSuit(pileSuitOf(pile.value[i]), card.suit)) {
          total = total + 1
        }
      }
      return total
    }
    if (key == S_CAST) {
      const odd = countParity(true)
      const even = countParity(false)
      return 1 + (odd >= even ? odd : even)
    }
    if (key == S_SPLIT) {
      // 红黑哪边多就收哪边，数出来多少就是收多少
      let red = 0
      let black = 0
      for (let i = 0; i < pile.value.length; i++) {
        const suit = pileSuitOf(pile.value[i])
        if (suit == '') {
          continue
        }
        if (isRedSuit(suit)) {
          red = red + 1
        } else {
          black = black + 1
        }
      }
      return 1 + (red >= black ? red : black)
    }
    if (key == S_GATHER) {
      // 最多凑四色，堆里花色越全收得越多
      let kinds = 1
      const taken : string[] = [card.suit]
      for (let i = 0; i < pile.value.length; i++) {
        const suit = pileSuitOf(pile.value[i])
        if (suit == '') {
          continue
        }
        let dup = false
        for (let k = 0; k < taken.length; k++) {
          if (sameSuit(suit, taken[k])) {
            dup = true
            break
          }
        }
        if (!dup) {
          taken.push(suit)
          kinds = kinds + 1
        }
      }
      return kinds
    }
    if (key == S_DIG) {
      // 堆底攒着的背面牌越多，翻出一对的指望越大
      let down = 0
      for (let i = 0; i < pile.value.length; i++) {
        if (pile.value[i].faceDown) {
          down = down + 1
        }
      }
      return down >= 4 ? down - 2 : 0
    }
    if (key == S_EVENS) {
      // 从堆底数连着几张偶数，数出来多少就是收多少
      return 1 + runFromBottom(0)
    }
    // 连出的三张：收益看翻出来的是什么，估不准，给个够它愿意出手的定值。
    // 连投三次撞机会最实，试钓次之，滤水多半只是倒废牌
    if (key == S_TROLL || key == S_VOLLEY) {
      return 2
    }
    if (key == S_SIEVE) {
      return 1
    }
    // 立规矩的几张：好处不在这一手，给个定值让它肯打出去
    if (key == S_NARROW || key == S_AGAIN) {
      return 2
    }
    if (key == S_DEEP) {
      // 深水：堆上小数的钓点越多，压下去越赚 —— 那些钓点全废成两张的收益
      let small = 0
      for (let i = 0; i < pile.value.length; i++) {
        const worth = maxValue(valuesOf(pile.value[i]))
        if (worth != NO_VALUE && worth > 0 && worth <= BIG_LINE) {
          small = small + 1
        }
      }
      return small > 0 ? small : 1
    }
    // 放大系：把你的钓点往大数区间推，推走一个算一个。
    // 涨水是全堆一起涨，堆上有点数的牌越多越值
    if (key == S_RISE) {
      let live = 0
      for (let i = 0; i < pile.value.length; i++) {
        if (hasLiveValue(valuesOf(pile.value[i]))) {
          live = live + 1
        }
      }
      return live > 2 ? 2 : 1
    }
    if (key == S_PROP || key == S_SURGE) {
      return 2
    }
    // 枯水：堆上带点数的牌越多，扫掉的钓点越多。
    // 但扫完那一摞谁都收得走，自己未必接得住 —— 只算一半
    if (key == S_DRY) {
      let live = 0
      for (let i = 0; i < pile.value.length; i++) {
        if (hasLiveValue(valuesOf(pile.value[i]))) {
          live = live + 1
        }
      }
      return live / 2
    }
    if (key == S_DRAIN) {
      return 2
    }
    if (key == S_GLEAN) {
      // 拾零：堆上算 0 点的牌越多，收得越肥
      let zeros = 0
      for (let i = 0; i < pile.value.length; i++) {
        if (hasValue(valuesOf(pile.value[i]), 0)) {
          zeros = zeros + 1
        }
      }
      return 1 + zeros
    }
    // 闭口：逼你连打 3 张废牌，堆厚三层还都归它挑时候收
    if (key == S_SHUT) {
      return playerHand.value.length > 0 ? 3 : 0
    }
    if (key == S_CALM) {
      // 堆上奇数越多，一压越赚。对手的钓点少一个，这堆就安全一分
      const odd = countParity(true)
      return odd > 0 ? odd : 1
    }
    if (key == S_DRAG) {
      // 拖网按自己的点数量一遍，范围比拾偶宽，通常收得更狠
      return 1 + runFromBottom(worthOf(card))
    }
    return 0
  }

  // 从堆底往右连着有几张够得着。base 传 0 表示按「偶数」数（拾偶），
  // 传点数表示按「+0 到 +6 顺位」数（拖网）。庄家估值和真发动走的是同一套判断
  function runFromBottom(base : number) : number {
    let n = 0
    for (let i = 0; i < pile.value.length; i++) {
      const values = valuesOf(pile.value[i])
      const ok = base == 0 ? hasParity(values, false) : withinDragAny(base, values)
      if (!ok) {
        break
      }
      n = n + 1
    }
    return n
  }

  // ---------- 庄家的算计 ----------
  //
  // 下面这几个函数只看公开信息加上庄家自己的东西：牌堆、两家的积分库、废牌堆、
  // 它自己的手牌和牌库。你的手牌和你牌库的顺序它一概看不到，不作弊。

  // 这个数字还有几张可能落在你手上。
  // 每个数字一共 4 张，把公开见过的和庄家自己攥着的都扣掉，剩下的才是威胁。
  // 一个已经出光的数字落到堆上是绝对安全的 —— 旧版本固定按 4 张算，
  // 于是它从来不敢落大数，也看不出什么时候其实可以放心落
  function unseenCount(worth : number) : number {
    if (worth < 1 || worth > RANK_COUNT) {
      // 贴纸才凑得出来的数，对手多半接不上
      return 0
    }
    let seen = 0
    // 堆里的牌按它锁定的数字记 —— 牌面上写的就是这个数，
    // 它原来是几谁都看不见，庄家也一样。没点数的牌哪个数字都不占
    seen = seen + countPileValue(worth)
    seen = seen + countValue(playerPoints.value, worth)
    seen = seen + countValue(dealerPoints.value, worth)
    seen = seen + countValue(waste.value, worth)
    seen = seen + countValue(dealerHand.value, worth)
    for (let i = dealerCursor.value; i < dealerDeck.value.length; i++) {
      if (dealerDeck.value[i].value == worth) {
        seen = seen + 1
      }
    }
    const left = SUIT_COUNT - seen
    return left > 0 ? left : 0
  }

  // 堆里有几张牌算得上这个数。只认牌面上写着的候选，不认它原来是几 ——
  // 一张牌能算成好几个数，那它在好几个数上都算露过面
  function countPileValue(worth : number) : number {
    let total = 0
    for (let i = 0; i < pile.value.length; i++) {
      if (hasValue(valuesOf(pile.value[i]), worth)) {
        total = total + 1
      }
    }
    return total
  }

  // 这组候选里，对手最可能接上哪一个 —— 取各个数里剩得最多的那个。
  // 手上这张牌有好几个数可用时，危险按最容易被接的那个算
  function unseenOf(values : number[]) : number {
    let best = 0
    for (let i = 0; i < values.length; i++) {
      const left = unseenCount(values[i])
      if (left > best) {
        best = left
      }
    }
    return best
  }

  function countValue(list : Card[], worth : number) : number {
    let total = 0
    for (let i = 0; i < list.length; i++) {
      if (list[i].value == worth) {
        total = total + 1
      }
    }
    return total
  }

  // 现在这个堆摆在对手面前，他下一手大概能捞走多少。
  // 逐张算：钩上它能带走几张 × 他手上还可能有几张接得上的牌。
  // 这比「这个数字危不危险」精确得多 —— 危险的不是数字，是它压着多深的一摞。
  // 一张牌攥着好几个数就更危险：随便接上哪一个都能把它连同后面那摞带走
  function pileThreat() : number {
    let total = 0
    // 谁也钩不上的牌不是没有风险 —— 收割是从钩中的位置一路收到堆顶，
    // 所以它只要垫在别人钓点的右边，就会被连同那一段一起带走。
    // carried 记着左边出现过的最大威胁，从堆底往右推着算。
    // 没有这一段的话，庄家会以为大数牌和 0 点牌摆在堆里绝对安全 ——
    // 那正是它送分最多的时候
    let carried = 0
    for (let i = 0; i < pile.value.length; i++) {
      const values = valuesOf(pile.value[i])
      const take = pile.value.length - i
      if (hasLiveValue(values)) {
        const own = take * unseenOf(values)
        total = total + own
        if (own > carried) {
          carried = own
        }
      } else if (carried > 0) {
        // 自己没钓点，但会被左边那个钓点捎走。算半份 ——
        // 得等人先钩中左边那张，不是每一手都轮得到
        total = total + carried / 2
      }
    }
    return total
  }

  // ---------- 成就 ----------

  function checkAchievements() {
    if (playerPoints.value.length >= RICH_SCORE) {
      gainAchievement(ACH_EXACT_GOAL)
    }
    if (playerCursor.value >= FLOW_DRAWS) {
      gainAchievement(ACH_FLOW)
    }
    const gap = dealerPoints.value.length - playerPoints.value.length
    if (gap > maxBehind) {
      maxBehind = gap
    }
  }

  function gainAchievement(id : number) {
    const data = save.value
    if (!markAchieved(data, id)) {
      return
    }
    save.value = data
    saveCurrent(data)
    const ach = achievementAt(id)
    toast('达成【' + ach.name + '】，解锁贴纸【' + stickerAt(ach.sticker).name + '】')
  }

  // ---------- 结算 ----------

  // 双方都打满回合。残堆谁都不算，直接比积分库的张数
  function settle() {
    const left = pile.value.length
    if (left > 0) {
      waste.value = pushCards(waste.value, pile.value)
      pile.value = [] as Card[]
      pileFromDealer.value = [] as boolean[]
    }

    const p = playerPoints.value.length
    const d = dealerPoints.value.length
    const tail = left > 0 ? ' 堆里剩的 ' + left + ' 张谁都没钓走。' : ''

    if (p > d) {
      finish('win', '打满 ' + level.value.turns + ' 回合，你 ' + p + ' 分比庄家 ' + d + ' 分多。' + tail)
      return
    }
    if (p < d) {
      finish('lose', '打满 ' + level.value.turns + ' 回合，庄家 ' + d + ' 分比你 ' + p + ' 分多。' + tail)
      return
    }
    finish('push', '打满 ' + level.value.turns + ' 回合，双方都是 ' + p + ' 分。' + tail)
  }

  // 重打这一关给哪一档的退换券。
  // 在首次奖励的两档里随机挑一档：这一关给普通券 + 稀有券，退换券就在普通和稀有里出；
  // 给稀有 + 史诗的，就绝不会掉出普通的来。两档一样时自然就是定的
  function refundRarity() : number {
    const a = level.value.rewardRarity
    const b = level.value.randomCount > 0 ? level.value.randomRarity : a
    if (a == b) {
      return a
    }
    return Math.random() < 0.5 ? a : b
  }

  // 平局不分胜负，洗牌重开这一局。
  // 但重开是有限的：故意打平来换一手好牌，最多混两次
  function restartMatch(tip : string) {
    if (dealerTimer != -1) {
      clearTimeout(dealerTimer)
      dealerTimer = -1
    }
    const data = save.value
    data.push = data.push + 1
    save.value = data
    saveCurrent(data)

    pushCount = pushCount + 1
    if (pushCount > MAX_PUSH) {
      finish('lose', tip + ' 这一关已经平局 ' + MAX_PUSH + ' 次，算没过。')
      return
    }

    resultKind.value = 'push'
    message.value = tip + ' 平局，洗牌重来（' + pushCount + '/' + MAX_PUSH + '）。'
    phase.value = 'dealer'
    dealerTimer = setTimeout(setup, 1600)
  }

  function finish(kind : string, tip : string) {
    if (kind == 'push') {
      restartMatch(tip)
      return
    }
    if (dealerTimer != -1) {
      clearTimeout(dealerTimer)
      dealerTimer = -1
    }
    phase.value = 'over'
    resultKind.value = kind

    // 赢下来的方式本身也能解锁贴纸
    if (kind == 'win') {
      if (dealerPoints.value.length <= CHOKE_SCORE) {
        gainAchievement(ACH_DEALER_BUST)
      }
      if (maxBehind >= BEHIND_GAP) {
        gainAchievement(ACH_BEHIND)
      }
      if (tookOnLastTurn) {
        gainAchievement(ACH_COMEBACK)
      }
    }

    const data = save.value
    let extra = ''
    if (kind == 'win') {
      data.win = data.win + 1
      // 券和解锁只在首次通关时给。重打是为了刷成就和试牌组，不是刷券。
      // markCleared 记上就返回 true，已经记过的返回 false
      const firstClear = markCleared(data, level.value.index)
      if (firstClear) {
        const rarity = level.value.rewardRarity
        addTickets(data, rarity, level.value.rewardCount)
        extra = ' 获得 ' + level.value.rewardCount + ' 张' + rarityAt(rarity).name + '券'

        // 随机券跟自选券一起发。隐藏贴纸只有随机券抽得到
        const randomCount = level.value.randomCount
        if (randomCount > 0) {
          const randomRarity = level.value.randomRarity
          addRandomTickets(data, randomRarity, randomCount)
          extra = extra + '、' + randomCount + ' 张' + rarityAt(randomRarity).name + '随机券'
        }
        extra = extra + '。'

        const fresh = unlockShop(data, level.value.unlockStickers)
        if (fresh.length > 0) {
          let names = ''
          for (let i = 0; i < fresh.length; i++) {
            if (i > 0) {
              names = names + '、'
            }
            names = names + stickerAt(fresh[i]).name
          }
          extra = extra + ' 解锁【' + names + '】。'
        }
      } else {
        // 重打不再给正经券，给的是退换券：把手里用不上的贴纸回炉重抽。
        // 稀有度在这一关首次奖励的那两档里随机挑一档 ——
        // 想回炉传说贴纸，就得反复打最后那两关
        const n = level.value.refundCount
        const rarity = refundRarity()
        addRefundTickets(data, rarity, n)
        extra = ' 这关之前通过了，给 ' + n + ' 张'
          + rarityAt(rarity).name + '退换券。'
      }
    } else {
      // 输了什么都不扣，改完牌组可以再打这一关
      data.lose = data.lose + 1
      extra = ' 可以改完牌组再打这一关。'
    }

    save.value = data
    saveCurrent(data)

    resultText.value = tip + extra
    message.value = tip
  }

  // ---------- 展示 ----------

  function isRed(card : Card) : boolean {
    return isRedSuit(card.suit)
  }


  function stickerName(card : Card) : string {
    return stickerAt(card.stickerKey).name
  }

  function cardText(card : Card) : string {
    return card.suit + card.rank
  }

  // 牌面上写的数字，就是这张牌现在算哪几个数。
  //
  // 贴纸改过点数就直接写改完的 —— 与其在旁边挂个「算几」让人对着牌面换算，
  // 不如牌面本身就是答案。能算成好几个数的全写出来：牌落堆也不坍缩，
  // 那几个数在堆里同时都是钓点，少写一个都是误导
  function rankText(card : Card) : string {
    // 背面牌的数字翻开之前谁都不该看见
    if (card.faceDown) {
      return ''
    }
    const values = cardValues(card)
    // 没有点数的牌就是没数字，牌面上空着 —— 不写数也不挂标记，
    // 一眼就看得出它当不了钓点
    if (values.length == 0) {
      return ''
    }
    // 一律走 faceOf：11/12/13 写成 J/Q/K，1 写成 A。
    // 认的是「现在算几点」而不是这张牌原来是什么 ——
    // 被贴纸抬到 11 的牌也写 J，跟真正的 J 摆一起才看得出能互相钩
    let text = ''
    for (let i = 0; i < values.length; i++) {
      if (i > 0) {
        text = text + '/'
      }
      text = text + faceOf(values[i])
    }
    return text
  }

  // 牌面上要写几个数。写得下一个就用大字，数多了得缩字号
  function rankCount(card : Card) : number {
    if (card.faceDown) {
      return 1
    }
    return cardValues(card).length
  }

  // 这张牌打出去能拿走几张（含自己）。
  // 钩的是候选有交集的第一张，从堆底数起，所以这就是它的最好结果
  function bestTake(card : Card) : number {
    // 通吃不挑数字，堆有多厚拿多厚
    if (card.stickerKey == S_HAUL) {
      return pile.value.length + 1
    }
    // 空位类落堆没有点数，钩不上任何东西 —— 它值不值得打看的是效果，不是钓几张
    if (isBlankSticker(card.stickerKey)) {
      return 0
    }
    return takeCount(pile.value, cardValues(card))
  }

  // 这一手有没有赚头。少于两张就等于只把自己拿回来，
  // 空堆上的 J 正是这种情况 —— 别让它亮着绿边骗你打出去
  function worthPlaying(card : Card) : boolean {
    return bestTake(card) >= 2
  }

  // 这组候选里有没有真能当钓点的数。全是 0 的那种不算 ——
  // 提系压到底的、平潮压过的，牌面上写着个 0，钩不上也没人钩得上
  function hasLiveValue(values : number[]) : boolean {
    for (let i = 0; i < values.length; i++) {
      if (values[i] > 0) {
        return true
      }
    }
    return false
  }

  // 两组候选一模一样吗。只用来判断「这张牌落堆之后算的数变没变」，
  // 两边都是去重排好序的，逐位比就够
  function sameValues(a : number[], b : number[]) : boolean {
    if (a.length != b.length) {
      return false
    }
    for (let i = 0; i < a.length; i++) {
      if (a[i] != b[i]) {
        return false
      }
    }
    return true
  }

  // 两张牌是靠哪几个数钩上的。报给玩家看的，不参与规则
  function sharedValues(a : number[], b : number[]) : number[] {
    const out : number[] = []
    for (let i = 0; i < a.length; i++) {
      if (a[i] > 0 && hasValue(b, a[i])) {
        out.push(a[i])
      }
    }
    return out
  }

  // 提示里报点数也走 faceOf —— 牌面上写着 J，提示里说「算 11 点」就对不上了
  function listText(list : number[]) : string {
    let text = ''
    for (let i = 0; i < list.length; i++) {
      if (i > 0) {
        text = text + '、'
      }
      text = text + faceOf(list[i])
    }
    return text
  }

  // 打完了就亮牌，没什么好藏的；中途靠【照水】掀 —— 只要它还在堆里就一直亮着
  const showDealerHand = computed<boolean>(() : boolean => {
    return dealerHandOpen.value || phase.value == 'over' || pileHasSticker(S_MIRROR)
  })

  // 要你从他手里挑牌的时候也得亮 —— 摸底、掏底、对换都写明了「看庄家全部手牌」
  const revealTheirs = computed<boolean>(() : boolean => {
    return showDealerHand.value || pickKind.value == PICK_THEIRS
  })

  const handTip = computed<string>(() : string => {
    if (phase.value == 'player') {
      return playMode.value == MODE_TAP ? '点一张手牌打出' : '点牌看效果，往上拖打出'
    }
    if (phase.value == 'value') {
      return '挑一个点数落堆'
    }
    if (phase.value == 'confirm') {
      return '这张 J 现在打不划算'
    }
    if (phase.value == 'catch') {
      return '亮着的这几张正被收走'
    }
    if (phase.value == 'pick') {
      return '贴纸要你挑牌'
    }
    return '等庄家出牌…'
  })

  // 底部那一格写的是「现在是哪种出牌方式」，点一下换。
  // 写当前模式而不是写「切到哪」—— 状态比动作更要紧，
  // 想换的人点一下就知道另一头是什么
  const playModeText = computed<string>(() : string => {
    return playMode.value == MODE_TAP ? '点击出牌' : '拖动出牌'
  })

  function togglePlayMode() {
    playMode.value = playMode.value == MODE_TAP ? MODE_DRAG : MODE_TAP
    clearSelected()
    uni.setStorageSync(KEY_PLAY_MODE, '' + playMode.value)
    toast(
      playMode.value == MODE_TAP
        ? '点一张手牌就直接打出去了'
        : '点牌看效果，往上拖到牌堆才算打出'
    )
  }

  // 庄家这一局还没亮过这种贴纸。
  //
  // 只问见没见过，不问稀有度 —— 一张普通贴纸你没见过，
  // 照样看不懂它干了什么。见过一次就记下，之后同种不再拦
  function firstFromDealer(key : string) : boolean {
    for (let i = 0; i < seenFromDealer.length; i++) {
      if (seenFromDealer[i] == key) {
        return false
      }
    }
    seenFromDealer.push(key)
    return true
  }

  // 带贴纸的牌落堆，把这张贴纸的名字和效果亮出来，并返回要占多少时间。
  //
  // 谁打的也写上 —— 庄家出牌是自动走的，不写的话一张横幅弹出来
  // 根本分不清是自己刚打的还是对面打的
  function flashSticker(card : Card, who : string, byDealer : boolean) : number {
    // 通吃不算贴纸，是 J 自带的、贴纸矩阵都管不着的固定效果 ——
    // 双方每副牌里都有四张，谁都认得，不值得每次都拦一下画面
    if (card.stickerKey == S_NONE || card.stickerKey == S_HAUL) {
      return 0
    }
    const sticker = stickerAt(card.stickerKey)
    const hold = FLASH_HOLD[sticker.rarity]
    // 对面头一次亮这张：停下来，摆张大的等你看完
    const wait = byDealer && firstFromDealer(card.stickerKey)

    // 上一张还亮着就直接顶掉：连出时两张挨得近，排队等前一张淡出
    // 会让横幅跟牌对不上
    if (flashTimer != -1) {
      clearTimeout(flashTimer)
      flashTimer = -1
    }
    if (flashOutTimer != -1) {
      clearTimeout(flashOutTimer)
      flashOutTimer = -1
    }

    flashName.value = sticker.name
    flashDesc.value = sticker.desc
    flashBy.value = who + '打出 ' + cardText(card)
    flashRarity.value = sticker.rarity
    flashColor.value = rarityAt(sticker.rarity).color
    flashRank.value = rankText(card)
    flashSuit.value = card.suit
    flashRed.value = isRed(card)
    flashWait.value = wait
    flashOn.value = true
    flashIn.value = false
    // 先挂上初始态，隔一拍再切到位，transition 才跑得起来 ——
    // 一上来就是最终态的话没有过渡，横幅是「蹦」出来的
    setTimeout(flashStep, 16)

    if (wait) {
      // 等你点。不设自动关闭的定时器，后面那一手也先挂着 ——
      // 你没看完就往下走，跟没给你看是一回事
      flashPaused = true
      startPulse()
      flashHold = 0
      return 0
    }

    flashTimer = setTimeout(flashEnd, hold)
    flashHold = hold
    return hold
  }

  // 大牌的描边。闪边得走 :style 这条道 ——
  // inline 样式压过 class，写成 .show-card-pulse 那样的类根本盖不住它。
  // 普通档不闪：一张普通贴纸值不上这个排场
  function flashCardStyle() : string {
    const lit = flashRarity.value >= 1 && flashPulse.value
    return 'border-color: ' + (lit ? '#ffffff' : flashColor.value)
  }

  // 闪边和炫光：定时翻一个开关，两头靠 transition 接上，看起来就是在呼吸
  function startPulse() {
    stopPulse()
    flashPulse.value = false
    pulseTimer = setTimeout(pulseStep, 40)
  }

  function pulseStep() {
    flashPulse.value = !flashPulse.value
    pulseTimer = setTimeout(pulseStep, PULSE_STEP)
  }

  function stopPulse() {
    if (pulseTimer != -1) {
      clearTimeout(pulseTimer)
      pulseTimer = -1
    }
    flashPulse.value = false
  }

  // 下面这三个是 setTimeout 的回调。写成具名函数跟这一页其它定时器一致
  function flashStep() {
    flashIn.value = true
  }

  function flashEnd() {
    flashTimer = -1
    hideFlash()
  }

  function flashGone() {
    flashOutTimer = -1
    flashOn.value = false
    flashWait.value = false
  }

  function hideFlash() {
    if (!flashOn.value) {
      return
    }
    stopPulse()
    flashIn.value = false
    flashOutTimer = setTimeout(flashGone, FLASH_OUT)
  }

  // 点一下收起横幅。挂着的那一手到这儿才放行 ——
  // 暂停的意义就在于「你看完了再走」
  function tapFlash() {
    if (flashTimer != -1) {
      clearTimeout(flashTimer)
      flashTimer = -1
    }
    hideFlash()
    resumeAfterFlash()
  }

  // 玩家一动手（点牌、拖牌）就当他看完了，把挂着的那一手放出去
  function resumeAfterFlash() {
    if (!flashPaused) {
      return
    }
    flashPaused = false
    const go = pendingGo
    pendingGo = GO_NONE
    if (go == GO_DEALER) {
      scheduleDealer()
    } else if (go == GO_RUN) {
      scheduleRun()
    }
  }

  function toast(tip : string) {
    uni.showToast({
      icon: 'none',
      title: tip
    })
  }

  // 点牌面上那行贴纸名，单看这一张的效果。
  // 模板那边用的是 @click.stop：不拦住冒泡的话，想看一眼效果就把牌打出去了
  function showSticker(card : Card) {
    if (card.stickerKey == S_NONE) {
      return
    }
    const sticker = stickerAt(card.stickerKey)
    uni.showModal({
      title: '【' + sticker.name + '】',
      content: sticker.desc,
      showCancel: false,
      confirmText: '知道了'
    })
  }

  // 手上这几张贴纸牌都是干什么的，一次看全
  function showHandStickers() {
    let text = ''
    for (let i = 0; i < playerHand.value.length; i++) {
      const card = playerHand.value[i]
      if (card.stickerKey == S_NONE) {
        continue
      }
      const sticker = stickerAt(card.stickerKey)
      if (text != '') {
        text = text + '\n\n'
      }
      text = text + cardText(card) + '【' + sticker.name + '】\n' + sticker.desc
    }
    if (text == '') {
      text = '手上没有贴纸牌，全是普通牌。'
    }
    uni.showModal({
      title: '手牌贴纸',
      content: text,
      showCancel: false,
      confirmText: '知道了'
    })
  }

  function showRules() {
    uni.showModal({
      title: '规则',
      content: '· 双方牌组都是固定的 52 张，各自摸各自的，'
        + '每回合结束补到 ' + HAND_SIZE + ' 张，被塞多了也不用弃。\n'
        + '· 每张牌就是它自己的数：A 是 1，J 是 11，Q 是 12，K 是 13，十三个数各 4 张。\n'
        + '· 轮到自己时出一张牌，放到中间的公共牌堆上，没有别的选择。\n'
        + '· 打出的数字跟堆里某张相同，就把那张、自己这张、以及夹在它们之间的牌\n'
        + '  全部钓走；这一段之外的留在堆里。牌平时压在堆顶，所以通常就是\n'
        + '  「撞中那张一路收到顶」，但【埋钩】能把自己插到中间，那时范围就在它那儿截止。\n'
        + '· 所以撞哪张很要紧：撞堆底能连锅端，撞最上面那张只捞到两张。\n'
        + '· 积分算的是张数，不是点数 —— 钓走 7 张就是 7 分。\n'
        + '· 撞不上就把牌压在堆顶，等于给对方多铺一个能撞的数字。\n'
        + '· J 自带【通吃】：打出时不管撞不撞，整堆连同它自己全归你。\n'
        + '  双方的 J 都一样，撕不下来也换不掉。堆越厚它越值钱，\n'
        + '  打在空堆上只收到它自己，等于白扔一张。\n'
        + '· 能算成几个数只有点数类贴纸说了算（幸运 ±1、福星 ±2 之类）。\n'
        + '  几个落法钓得不一样深时会让你挑；结果都一样就自动落堆。\n'
        + '· 牌一旦落堆，它算几点就锁死了，后面谁来撞都看这个锁定的数。\n'
        + '· 每人各打 ' + level.value.turns + ' 个回合（回合分开算），打满就结算，钓得多的赢。\n'
        + '· 庄家先手，你是后手 —— 最后一张牌是你打的，收尾的机会在你手上。\n'
        + '· 散局时堆里剩的牌谁都不算分，所以压得太厚又钓不走就是白送。\n'
        + '\n'
        + '【贴纸通用规则】\n'
        + '· 顺位：十三个数首尾相接。K 往上一位是 A，A 往下一位是 K。\n'
        + '· 钓点：点数得在 1 以上才当得了钓点。\n'
        + '· 空位类贴纸：落堆时没有点数 —— 撞不上别人，也没人撞得上它，但花色照样算数，\n'
        + '  收色收得走。提系一路压到 0 的牌也是一样，当不了钓点但花色还在。\n'
        + '· 背面牌：数字和花色都不算数。新加进堆的背面牌一律沉到最左侧 ——\n'
        + '  钓牌是从撞中的位置往上收，所以沉在底下的基本带不走，会一直攒着。\n'
        + '  【起底】把它们翻回来配对，是唯一能让它们变成分的路。\n'
        + '· 落堆位置：默认压在堆顶；标「落堆底」的放到最左侧，只有撞中堆底才带得走。\n'
        + '· 一张牌只贴得下一张贴纸；J 焊死【通吃】，贴不了别的。\n'
        + '· 点牌面上的贴纸名可以看它的效果，底下的「贴纸」按钮能一次看全手牌。\n'
        + '· 平局洗牌重来；同一关最多平局 ' + MAX_PUSH + ' 次，再平就算没过。\n'
        + '· 通关奖励 ' + level.value.rewardCount + ' 张'
        + rarityAt(level.value.rewardRarity).name + '券；输了不扣东西，可以改牌组再打。\n'
        + '· 券只在首次通关时发，通过的关卡还能回来重打，用来刷成就和试牌组。',
      showCancel: false,
      confirmText: '知道了'
    })
  }

  // 就地再来一局。输了不扣任何东西，所以重打不需要任何代价。
  // pushCount 跟着清零 —— 它管的是「同一次挑战里平局重开几次」，
  // 手动重来就是新的一次挑战
  function retry() {
    pushCount = 0
    setup()
  }

  function goBack() {
    uni.navigateBack()
  }

  onUnmounted(() => {
    if (dealerTimer != -1) {
      clearTimeout(dealerTimer)
      dealerTimer = -1
    }
    if (catchTimer != -1) {
      clearTimeout(catchTimer)
      catchTimer = -1
    }
    if (runTimer != -1) {
      clearTimeout(runTimer)
      runTimer = -1
    }
    if (flashTimer != -1) {
      clearTimeout(flashTimer)
      flashTimer = -1
    }
    if (flashOutTimer != -1) {
      clearTimeout(flashOutTimer)
      flashOutTimer = -1
    }
    stopPulse()
  })

  // 出牌方式是跟着人走的偏好，不是这一局的状态 —— 从本地读回上次选的
  function loadPlayMode() {
    const raw = uni.getStorageSync(KEY_PLAY_MODE)
    if (raw != null && typeof raw == 'string' && (raw as string) == '' + MODE_TAP) {
      playMode.value = MODE_TAP
    }
  }

  loadPlayMode()
  setup()
</script>

<style>
  /* 整页固定一屏，纵向不滚动 */
  .page {
    flex: 1;
    padding: 8px 10px;
    background-color: #0b5d3b;
  }

  /* 顶部信息栏 */
  .topbar {
    flex-direction: row;
    justify-content: space-between;
    background-color: #084730;
    border-radius: 8px;
    padding: 6px 10px;
  }

  .topbar-item {
    flex: 1;
    align-items: center;
  }

  .topbar-label {
    color: #9fd9bd;
    font-size: 11px;
  }

  .topbar-value {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
  }

  /* 比分贴在牌堆标题行右端 */
  .pile-score {
    flex-direction: row;
    align-items: center;
  }

  .pile-score-label {
    color: #9fd9bd;
    font-size: 11px;
    margin-left: 2px;
    margin-right: 2px;
  }

  .pile-score-num {
    color: #e8b23a;
    font-size: 18px;
    font-weight: bold;
  }

  /* 钓中的那一拍，收牌方的分数亮起来放大 */
  .pile-score-catch {
    color: #ffd54f;
    transform: scale(1.3);
    transition-property: transform, color;
    transition-duration: 180ms;
  }

  /* 公共牌堆 */
  .pile-area {
    flex: 1;
    flex-direction: column;
    min-height: 96px;
    margin-top: 6px;
    background-color: #0e6b45;
    border-radius: 8px;
    padding: 6px 10px;
  }

  .pile-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .pile-title {
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
  }

  .board {
    flex: 1;
    min-height: 68px;
    margin-top: 4px;
  }

  /* 牌拖到位了，把堆这一片点亮当落点 —— 手指还压在牌上，
     光靠上面那行字不够，得让目标区自己应一声 */
  .board-drop {
    border-width: 1px;
    border-style: dashed;
    border-color: #e8b23a;
    border-radius: 6px;
  }

  .board-row {
    flex-direction: row;
    align-items: center;
  }

  /* 牌堆张数一多就换行；行数再涨就在牌堆区里纵向滚 */
  .pile-cards {
    flex-wrap: wrap;
    align-items: flex-start;
  }

  /* 换行之后行与行会贴在一起，得给每张牌垫一点行距。
     别写成 .pile-cards .card —— uvue 在 Android 上只认单个 class 选择器，
     后代选择器一律不生效 */
  .card-in-pile {
    margin-bottom: 6px;
  }

  .played-tip {
    color: #8fc7ab;
    font-size: 11px;
  }

  /* 牌面 */
  .card {
    width: 46px;
    height: 64px;
    background-color: #ffffff;
    border-radius: 5px;
    margin-right: 6px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-style: solid;
    border-color: #ffffff;
  }

  .card-hand {
    margin-right: 5px;
  }

  .card-stickered {
    border-color: #e8b23a;
  }

  /* 打出去能钓到牌的，描边亮一点 */
  .card-ready {
    border-color: #7ce0a3;
  }

  /* 堆里的牌按谁打的染边框。放在贴纸描边后面，压过它 ——
     堆里更要紧的是「这张是谁喂的」，贴纸名牌面上写着 */
  .card-from-dealer {
    border-color: #ff9e80;
  }

  .card-from-player {
    border-color: #7ce0a3;
  }

  /* 扣着的牌背。庄家手牌平时全是这个样子，沉到堆底的暗牌也是同一张脸。
     写在归属色后面压过它们 —— 背面牌连是谁盖的都不该看出来 */
  .card-back {
    background-color: #123f6b;
    border-color: #0b2a48;
  }

  /* 牌背纹样：深蓝底上套一圈细边，中间压一枚菱形。
     纯 view 拼出来的，不靠字体、不靠伪元素，各端画出来都一个样 */
  .card-back-art {
    width: 34px;
    height: 52px;
    border-width: 1px;
    border-style: solid;
    border-color: #3d7fc1;
    border-radius: 3px;
    align-items: center;
    justify-content: center;
    background-color: #17497a;
  }

  .card-back-gem {
    width: 16px;
    height: 16px;
    border-width: 2px;
    border-style: solid;
    border-color: #7fb2e5;
    background-color: #1b5691;
    transform: rotate(45deg);
  }

  /* 钓中的那一段：整体点亮抬起，停一拍再收走。
     放在归属色后面压过它们 —— 这一拍里「哪几张要走」比「谁喂的」重要得多 */
  .card-caught {
    background-color: #fff3c4;
    border-color: #ffd54f;
    transform: translateY(-8px);
    transition-property: transform, background-color, border-color;
    transition-duration: 180ms;
  }

  /* 贴纸正等你从这堆牌里挑一张。描边跟「能钓到」的绿边分开，
     免得两种「可以点」混在一起 */
  .card-pickable {
    border-color: #7cc4ff;
  }

  /* 选中的那张：抬起来、描金、压过上面所有描边。
     选中只是「我在看这张」，出牌得另外拖或者按按钮 */
  .card-picked {
    background-color: #fffbe8;
    border-color: #e8b23a;
    transform: translateY(-8px);
    transition-property: transform, background-color, border-color;
    transition-duration: 140ms;
  }

  /* 正被拖着的那张不要过渡 —— 跟手就得是实时的，
     加了 transition 牌会拖在手指后面晃 */
  .card-dragging {
    background-color: #fffbe8;
    border-color: #e8b23a;
    transition-duration: 0ms;
  }

  /* 埋钩挑位置时堆顶后面那个落点 */
  .card-slot {
    background-color: #0a4a32;
    border-color: #7cc4ff;
  }

  .card-slot-mark {
    color: #7cc4ff;
    font-size: 11px;
    font-weight: bold;
  }

  .card-rank {
    color: #1a1a1a;
    font-size: 17px;
    font-weight: bold;
  }

  /* 能算成好几个数的牌，几个数全写在牌面上。46px 宽塞不下大字，
     按个数分两档缩：多的缩一点，很多的再缩一点，缩完自动折行 */
  .card-rank-multi {
    font-size: 12px;
    text-align: center;
  }

  .card-rank-many {
    font-size: 9px;
    text-align: center;
  }

  .card-suit {
    color: #1a1a1a;
    font-size: 13px;
  }

  .card-red {
    color: #d93025;
  }

  /* 贴纸名要完整显示，牌面又只有 46px 宽，字号压到 10px 刚好放下两个字 */
  .card-sticker {
    color: #b8860b;
    font-size: 10px;
    font-weight: bold;
  }

  /* 提示信息 */
  .message-box {
    height: 40px;
    margin-top: 6px;
    border-radius: 6px;
    padding: 4px 10px;
    justify-content: center;
    background-color: #084730;
  }

  .message-win {
    background-color: #1f7a4d;
  }

  .message-lose {
    background-color: #8c2f2a;
  }

  .message-push {
    background-color: #6b5a1e;
  }

  .message-text {
    color: #ffffff;
    font-size: 12px;
    line-height: 16px;
  }

  /* 手牌区 */
  /* 庄家那一区：牌不会抬起也不会被拖，按牌高算就够 */
  .hand-area {
    height: 100px;
    margin-top: 6px;
  }

  /* 你这一区要多留一截给抬起和拖动 */
  .hand-area-mine {
    height: 124px;
  }

  /* 摊牌给你挑的时候，摊开的那排和手牌得同时在场，高度翻一倍。
     牌堆区是 flex: 1，多出来的这点从它那儿匀。
     排在 hand-area-mine 后面才压得住它 */
  .hand-area-tall {
    height: 202px;
  }

  /* 高度写死。这一行的右半边要在「提示文字」和「打出／收起按钮」之间换，
     按钮比文字高一截 —— 不定死的话选一张牌整块就被顶高，
     手牌跟着往下退，底边直接被 hand-area 切掉 */
  .hand-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 28px;
  }

  .hand-title {
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
  }

  .hand-tip {
    color: #9fd9bd;
    font-size: 11px;
  }

  /* 拖到位了才亮这一行，颜色跟落点的描边对上 */
  .hand-tip-drop {
    color: #e8b23a;
    font-weight: bold;
  }

  /* 选中一张之后，标题那行右边换成打出／取消两个按钮。
     按钮比 46px 宽的牌好点得多，出牌这一下不该靠瞄准 */
  .hand-acts {
    flex-direction: row;
    align-items: center;
  }

  /* 手牌横着一排。张数可能多于 5，所以外层是能滑的 scroll-view，
     牌本身摆在里面这一行上 */
  /* 比牌高出一截：选中的牌要抬起来、拖出去的牌要跟手往上走，
     贴着牌顶切的话这两下都会被容器裁掉半张脸。
     牌 64px + 抬升余量 24px + 上下各 2px */
  .hand {
    height: 92px;
    margin-top: 4px;
  }

  /* 庄家那排不抬不拖，按牌高就行，不占玩家那份余量 */
  .hand-top {
    height: 68px;
  }

  /* 高度得写死成跟 .hand 一样。
     不写的话这一行的高度由牌撑出来，正好 64px，
     flex-end 就没有「底」可贴 —— 牌照样顶着排，抬起来还是被裁 */
  .hand-row {
    flex-direction: row;
    align-items: flex-end;
    height: 92px;
  }

  /* 庄家那排同理，跟着 .hand-top 收回去 */
  .hand-row-top {
    height: 68px;
  }

  /* 点数候选条。贴了福星的 A 能凑出十来个数，得能横着滑 */
  .value-box {
    height: 44px;
    margin-top: 8px;
  }

  /* 摊开给你挑的那排：装的是整张牌，得比候选条高 */
  .spread-box {
    height: 72px;
    margin-top: 6px;
  }

  .peek-label {
    color: #9fd9bd;
    font-size: 11px;
    margin-right: 8px;
  }

  .peek-btn {
    color: #3b2a00;
    font-size: 12px;
    font-weight: bold;
    background-color: #cfd8d3;
    border-radius: 12px;
    padding: 5px 12px;
    margin-left: 8px;
  }

  /* 收手按钮跟手牌并排，牌有 64px 高，按钮自己居中就行 */
  .peek-btn-stop {
    align-self: center;
  }

  /* 能钓到牌的那几个数，标成金色 */
  .peek-btn-hit {
    background-color: #e8b23a;
  }

  .over-box {
    flex: 1;
    align-items: center;
    justify-content: center;
  }

  .over-text {
    color: #ffffff;
    font-size: 13px;
    text-align: center;
  }

  /* 结算后的两个按钮横着排 */
  .over-actions {
    flex-direction: row;
    align-items: center;
  }

  .btn {
    height: 40px;
    border-radius: 20px;
    margin-top: 6px;
    margin-left: 5px;
    margin-right: 5px;
    padding: 0 22px;
    align-items: center;
    justify-content: center;
  }

  .btn-primary {
    background-color: #e8b23a;
  }

  /* 次要按钮：输了的时候「重来」是主选项，「返回关卡」退成描边 */
  .btn-ghost {
    background-color: #084730;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .btn-text {
    color: #3b2a00;
    font-size: 15px;
    font-weight: bold;
  }

  .btn-text-ghost {
    color: #e8b23a;
  }

  /* 底部状态 */
  .toolbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
  }

  .toolbar-link {
    color: #e8b23a;
    font-size: 12px;
  }

  /* ---------- 头一次见的贴纸：放大摆中间，等你点 ---------- */

  .show-layer {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
    padding: 20px;
    transition-property: background-color;
    transition-duration: 200ms;
  }

  .show-layer-in {
    background-color: rgba(3, 20, 13, 0.82);
  }

  /* 放射炫光。12 条细长块叠在牌后面，每条以自己中心转一个角度，
     转完就是一圈星芒 —— uvue 画不了 radial-gradient，也没有伪元素，
     这是纯 view 拼得出来、各端又都一个样的办法 */
  .show-rays {
    position: absolute;
    width: 300px;
    height: 300px;
    align-items: center;
    justify-content: center;
  }

  .ray {
    position: absolute;
    width: 3px;
    height: 300px;
    background-color: rgba(255, 214, 138, 0.12);
    transition-property: background-color;
    transition-duration: 520ms;
  }

  .ray-on {
    background-color: rgba(255, 214, 138, 0.3);
  }

  /* 传说的光更粗更亮，隔着牌也看得出这张不一样 */
  .ray-legend {
    width: 5px;
    background-color: rgba(255, 196, 92, 0.22);
  }

  /* 放大的牌。牌面照抄手牌那一张，尺寸翻三倍 */
  .show-card {
    width: 146px;
    height: 202px;
    background-color: #ffffff;
    border-radius: 12px;
    border-width: 3px;
    border-style: solid;
    border-color: #ffffff;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.6) translateY(24px);
    transition-property: opacity, transform, border-color;
    transition-duration: 220ms;
  }

  .show-card-in {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .show-rank {
    color: #1a1a1a;
    font-size: 54px;
    font-weight: bold;
  }

  .show-suit {
    color: #1a1a1a;
    font-size: 30px;
  }

  .show-sticker {
    font-size: 19px;
    font-weight: bold;
    margin-top: 8px;
  }

  .show-desc {
    color: #ffffff;
    font-size: 13px;
    line-height: 19px;
    text-align: center;
    margin-top: 14px;
  }

  .show-by {
    color: #9fd9bd;
    font-size: 11px;
    margin-top: 8px;
  }

  .show-go {
    color: #e8b23a;
    font-size: 12px;
    font-weight: bold;
    margin-top: 12px;
  }

  /* ---------- 贴纸横幅 ---------- */

  /* 传说专属：整个画面压暗。别的档次不压 ——
     每张普通贴纸都黑一次屏，一局下来看得人眼晕 */
  .flash-dim {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 180ms;
  }

  .flash-dim-in {
    background-color: rgba(0, 0, 0, 0.52);
  }

  /* 横幅浮在画面上半部：牌堆看得见，底下的手牌和工具栏不挡。
     实在挡着了点一下就收 */
  .flash-wrap {
    position: fixed;
    left: 0;
    right: 0;
    top: 22%;
    align-items: center;
  }

  /* 入场态写在这儿（缩着、透明），加上 flash-in 才张开。
     v-if 一出来就是最终态的话没有过渡，横幅是「蹦」出来的 */
  .flash {
    width: 64%;
    background-color: #06301f;
    border-radius: 12px;
    border-width: 1px;
    border-style: solid;
    border-color: #ffffff;
    padding: 7px 12px;
    align-items: center;
    opacity: 0;
    transform: scale(0.9) translateY(6px);
    transition-property: opacity, transform;
    transition-duration: 180ms;
  }

  /* 越往上越大、边越厚、入场的动静越大。
     传说单独换个深金底，跟前面三档拉开 */
  .flash-r1 {
    width: 72%;
    border-width: 2px;
  }

  .flash-r2 {
    width: 82%;
    border-width: 3px;
    padding: 10px 14px;
    transform: scale(0.74) translateY(12px);
  }

  .flash-r3 {
    width: 90%;
    border-width: 4px;
    padding: 14px 16px;
    background-color: #1c1405;
    transform: scale(0.58) translateY(18px);
  }

  /* 必须排在所有 flash-rN 后面 —— 同级样式后写的压前面的，
     不然史诗和传说的入场态会把张开后的位置盖掉 */
  .flash-in {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  .flash-by {
    color: #9fd9bd;
    font-size: 10px;
  }

  .flash-name {
    font-size: 18px;
    font-weight: bold;
    margin-top: 2px;
  }

  .flash-name-big {
    font-size: 24px;
  }

  .flash-desc {
    color: #e3f3ea;
    font-size: 11px;
    line-height: 15px;
    text-align: center;
    margin-top: 3px;
  }
</style>
