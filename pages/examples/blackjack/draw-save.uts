// 摸打钓鱼的存档。三个槽，和钓鱼、排竿各走各的键。
//
// 玩法照排竿：一轮要从第 1 关连胜到第 12 关，输一次（平局也算）整轮作废，从头再来。
// 所以存档里分两层：
//   跨轮留着的：存档名、最远打到第几关（best）；
//   一轮之内的：角色、每个槽嵌了什么、当前关、金币、牌组、货架 —— 输了全清。
//
// **一轮开始先选一张角色卡**（见 draw-levels.uvue 的 go）：它给一件常驻
// 特殊技（整轮都在，不占槽）和几个印死标签的槽，槽是空的。
//
// 技能**在商店买**，跟卡牌混在同一栏上货（见 rollShelf），买下来必须
// 当场嵌进一个槽。所以不存在「拥有但没装上」的库，也不存在名额上限 ——
// **槽数本身就是上限**，槽满了照样买得动，只是会换掉里头那件。
//
// 不并进 save.uts 的 SaveData：那边已经 24 段、两个游戏共用一套序列化，
// 这个玩法的字段一个都不重叠，塞进去只会让每个函数再长一截。
// 格式照它的习惯：一行文本、'|' 分段、版号打头、存档名放最后（名字里可能有 '|'）

import { SUITS, RANKS, RANK_VALUES } from '@/pages/examples/blackjack/cards.uts'
import {
  SHOP_FIX_COUNT,
  SHOP_CARD_COUNT,
  SHELF_BONUS,
  CARD_BONUS,
  FLAT_REROLL,
  cardRerollCost,
  rollFixKeys,
  // 庄家角色：按关号查哪一张卡（技能名单印在卡上，标签这边摇）
  foeRoleAt,
  DIFF_EASY,
  DIFF_NORMAL,
  DIFF_HARD
  // 原先还引着 RANK_BONUS（加权加几格）和 foeSkillsOf（庄家带几个技能）。
  // 加权删了；技能数现在由角色卡的槽数定，不用算
} from '@/pages/examples/blackjack/draw-levels.uts'
import {
  DRAW_SKILLS,
  DRAW_ROLES,
  DrawKit,
  KitSlot,
  kitFromSlots,
  rollLabels,
  slotLabels,
  roleIndexOf,
  // 点数卡摇哪个点数要用它（A–10、Q、K，排掉 J）
  SKILL_RANKS,
  // 存档里技能和角色都存 key，这两个负责 key ↔ 下标
  //（见下面 ownerToText / textToOwner 那一段）
  skillIndexOf,
  skillKeyAt
  // 原先还引着一串旧模型的东西（rollPlace / rollKitFor / rankCapOf /
  // emptyLoadout / isEquipped / coverageText / SUIT_COUNT /
  // RANK_CAPACITY / DrawLoadout）。存档不再存 loadout 了 ——
  // 它从「角色 + 每槽嵌什么」derive 出来，所以这些全不需要
} from '@/pages/examples/blackjack/draw-skills.uts'

export const DRAW_SLOT_COUNT : number = 3
export const DRAW_SAVE_NAME : string = '摸打'
// 一轮一共几关。和 draw-levels.uts 的关卡表对上
export const DRAW_RUN_LENGTH : number = 12

// 原先这儿有 DROP_BASE / DROP_STEP（过关掉技能的概率，随连空关数往上走）。
// 技能改成商店买了，这两个常量跟 dropChance 一起删掉 —— 详见下面那段

// md3 起多存两段：「这一轮的牌组构成」（cards）和「商店这一批货」（shelf）。
// 两段都插在 label **前面** —— label 是最后一段，因为它可能自带 | 号，
// 读的时候要把剩下的全拼回去。
//
// md4 动了两处，都是为了那两件永久扩容道具（加栏、加权）：
//   · 第 4 段从 misses（过关掉技能那套留下的，恒为 0）换成 rankCap
//     —— 点数槽这一轮有几格。顺手把那个死字段清掉了。
//   · label 前面多插一段 **bonusShelf** —— 道具栏多了几格。
//
// md5 又补两段（还是插在 label 前面），给另外两件唯一道具：
//   · **bonusCard** —— 技能 / 卡牌那一栏多了几格（加架）。
//   · **flatReroll** —— 刷新价拍平了没有（平价），0 / 1。
//
// md10 把【加权】那件删了（槽数由角色卡定，加出来的格子印什么没有来源），
// 于是 rankCap 那一段也没了 —— 第 4 段现在装**角色 key**。
//
// 剩下三个数就是「买没买过那三件唯一道具」的全部记录：
// 加栏看 bonusShelf、加架看 bonusCard、平价看 flatReroll。
// **不另记一张「已买过」的清单** —— 同一件事
// 在存档里有两份记录，迟早对不上（见 takenOnceKeys）。
//
// 版号一跳，老档就当没有（下面那道 parts[0] != VERSION 的闸）。
// 这儿没做兼容读：md2 的第 8 段是 label，md3 的第 8 段是 cards，
// 两者都可能是任意字符串，分不出来 —— 那就别猜
//
// md6 只是在 label 前面插了一段 inShop（0 / 1）。md5 看版号就分得出来，
// 所以照读：inShop 当 false，label 从第 13 段起
//
// md7 在 label 前面插**三段庄家配装**（foeLevels / foeSuit / foeRank）。
// 庄家带什么从「关卡表里写死」改成了「摇的」，而摇出来的那一套
// **必须存住** —— 商店会预告下一关的庄家，每次看都重摇就是假情报，
// 退出再进还能一直刷到弱的。跟货架、牌组一个待遇（见 rollFoeKit）。
//
// md5 / md6 的老档都照读（版号分得出来），只是读不到庄家配装 ——
// 那就当空的，进对局时按关号补摇一次（见 ensureFoeKit）
//
// ---- md8：技能从存下标改成**存 key** ----
//
// 段数和顺序一个都没变，变的是第 5、6、7 段（以及庄家那三段）**里头写什么**：
//
//   md7 及以前   levels = "-1,2,-1,0,…"（按技能下标排的等级表）
//                suitOwner = "0,-1,-1,0"（技能下标）
//   md8          levels = "hook:2,tide:0"（只写拥有的，key:等级）
//                suitOwner = "hook,,,hook"（key，空格写空串）
//
// 为什么非改不可：存下标的话，**删一件技能就让老档整个错位** ——
// 删掉护饵（原来的 0 号）之后，老档里记着「0 号 2 级」，读出来变成磁钩 2 级。
// 存 key 就没这个问题，读到已删的 key 当它不存在（见 textToOwner）。
//
// md10 把这条规矩**同样用在角色上**（第 4 段存 `DRAW_ROLES[].key`）——
// 角色表以后也可能删卡，而角色是一整轮的方向，错位比技能错位更糟。
//
// md7 的老档**没法兼容读**：那三段都是数字串，而数字串在 md8 里是合法的
// key 吗？不是 —— 但 skillIndexOf('0') 返回 -1，于是整套装备读成空的，
// 等于白读。与其读出一个空壳让人以为存档坏了，不如认版号作废：
// 它只丢「这一轮打到哪、带什么」，best（最远纪录）那一层也在同一个档里，
// 所以老档整个当没有。这是这次改动唯一的实际代价
// md9：花色槽砍掉，suitOwner 那两段没了（见 loadDrawAt 里那段）。
// 不留老版号常量了 —— md9 一个都不兼容，留着没用
const VERSION : string = 'md10'
const KEY_PREFIX : string = 'md_save_'
const KEY_SLOT : string = 'md_slot'

export type DrawSave = {
  exists : boolean
  label : string
  // 跨轮：最远通过到第几关（0 = 一关没过）
  best : number
  // 本轮：现在要打第几关。DRAW_RUN_LENGTH + 1 表示整轮打通了
  runLevel : number
  gold : number
  // ---------- 本轮：角色 + 每个槽嵌了什么 ----------
  //
  // 这两样就是玩家的全部装备。`levels` 和 `loadout` 那两段**删掉了** ——
  // 它们能从这两样 derive 出来（kitFromRole 就在做这件事），
  // 存两份同一件事迟早对不上。
  //
  // role: DRAW_ROLES 下标，-1 = 这一轮还没选角色（开启挑战要先选）。
  // slotSkills: 跟角色的 slots 一一对应，-1 = 那个槽空着。
  //
  // **开局 slotSkills 全是 -1** —— 角色只给你一件常驻特殊技和几个空槽，
  // 技能靠商店买、买的时候挑进哪个槽
  role : number
  slotSkills : number[]
  // 本轮的**牌组构成**：每段一张牌，写成「花色 + 点数」（♠3、♥10）。
  //
  // 空数组 = 还没改造过，用标准的 52 张。商店里买的改造道具
  //（推点数、同化、定点）和买来的新牌都落在这儿。
  //
  // 存整副而不是存「改动列表」：开局直接照它发牌，不用再算一遍差异。
  // 排竿的 runDeck 也是这么存的。
  //
  // **双方共用这一副** —— 摸打不像排竿那样对半分，所以你改造的牌
  // 对方也摸得到。改造的收益来自「往自己技能的点数上靠」：
  // 那几个点数的牌变多，你的技能触发率跟着上去，而对方的技能
  // 摇在别的点数上，这笔改造对它没用
  cards : string[]
  // 本轮：商店这一批货。
  //
  // **存进档，不是存在页面里。** 理由是读档刷新漏洞：货架要是每次进店
  // 重摇，退出去再进来就能刷到想要的那张 —— 而商店是过一关进一次，
  // 那等于白送无限次重摇，花钱刷新那条路也就白设了。
  // 排竿那边同样把货架存进了档（runShelf）。
  //
  // 格式：第 0 段是「刷新过几次」，之后每段一件货
  //   i:push1:0   道具（key、卖掉没有）
  //   c:♠J:0      卡牌（牌面、卖掉没有）
  //   s:3:0       技能（技能下标、卖掉没有）
  // 牌面里不含逗号和冒号，所以这套分隔是安全的
  shelf : string[]
  // 本轮：道具栏比底数多几格。买过【加栏】就是 SHELF_BONUS，否则 0。
  //
  // 存「多出来的那几格」而不是存总数：底数（SHOP_FIX_COUNT）哪天要调，
  // 老档不会连着一块儿锁死在旧值上
  bonusShelf : number
  // 本轮：技能 / 卡牌那一栏比底数多几格。买过【加架】就是 CARD_BONUS
  bonusCard : number
  // 本轮：刷新价拍平了没有。买过【平价】就是 true ——
  // 之后每次换一批都是 FLAT_REROLL，不再翻倍
  flatReroll : boolean
  // 本轮：打赢一关、还没离开商店。从商店「退出」之后再开启挑战，
  // 先回商店而不是直接开下一关（商店里点「开始下一关」才清掉）
  inShop : boolean
  // 本轮：**当前这一关庄家那几个槽上摇出来的标签**。
  //
  // 庄家角色本身不用存 —— 它由关号定死（DRAW_FOE_ROLES 按关号下标），
  // 所以存档里只需要那一份**摇出来的标签**。
  //
  // 为什么标签要存：商店会预告下一关的庄家（见 draw-skills.uvue 的
  // foePreview），每次读都重摇就是假情报，而且退出再进能一直刷到
  // 好摇的位置。跟货架（shelf）一个理由。
  //
  // 什么时候摇：一轮开始摇第 1 关的，每过一关摇下一关的
  //（settleWin 里，正好在进商店之前，所以预告读得到）。
  // 平局重打同一关不重摇 —— 那一关的题目没变。
  //
  // 格式：一个槽一段，段内用空格分隔标签（跟角色卡的 slots 同一个写法）。
  // 比如鲸骸摇出来可能是 ['♦', '3 9']
  foeSlots : string[]
}

function listOf(count : number, value : number) : number[] {
  const list : number[] = []
  for (let i = 0; i < count; i++) {
    list.push(value)
  }
  return list
}

export function emptyDrawSave() : DrawSave {
  return {
    exists: false,
    label: '',
    best: 0,
    runLevel: 1,
    gold: 0,
    // -1 = 还没选角色。「开启挑战」会先弹角色选择（见 hasRole）
    role: -1,
    slotSkills: [] as number[],
    cards: [] as string[],
    shelf: [] as string[],
    bonusShelf: 0,
    bonusCard: 0,
    flatReroll: false,
    inShop: false,
    // 空的 = 还没摇过。进对局的时候按关号补摇（ensureFoeKit）
    foeSlots: [] as string[]
  }
}

// 新档：开局什么技能都没有
export function newDrawSave(label : string) : DrawSave {
  const data = emptyDrawSave()
  data.exists = true
  data.label = label
  // 第 1 关的庄家当场摇好 —— 第 1 关不带技能，所以摇出来是空的，
  // 可这条路得走一遍，不然 ensureFoeKit 每次都以为「还没摇过」
  rollFoeKit(data, 1)
  return data
}

// 输了 / 打通之后重开一轮：本轮的东西全清，最远纪录留着
export function resetDrawRun(data : DrawSave) {
  data.runLevel = 1
  data.gold = 0
  // **角色也清掉** —— 下一轮要重新选一张。
  // 那是这个玩法的开局决策，不该跨轮沿用上一轮那张
  data.role = -1
  data.slotSkills = [] as number[]
  // 牌组改造跟技能一个待遇：本轮的家当，输了一起清。
  // 不清的话它会跨轮累积，而这个玩法的整个结构是「输一次从头来」
  data.cards = [] as string[]
  // 货架也清空 —— 下次进店会摆新的一批
  data.shelf = [] as string[]
  // 三件唯一扩容道具买来的东西同理，都只「永久」到这一轮结束 ——
  // 跨轮留着的话它们会累成一条养成线，而这个玩法没有养成线
  data.bonusShelf = 0
  data.bonusCard = 0
  data.flatReroll = false
  data.inShop = false
  // 庄家那一套也重摇 —— 新一轮就是新的十二道题。
  // 不重摇的话上一轮第 12 关那套会跟到新一轮的第 1 关
  rollFoeKit(data, 1)
}

export function runCleared(data : DrawSave) : boolean {
  return data.runLevel > DRAW_RUN_LENGTH
}

// ---------- 庄家配装：摇一次，存住 ----------
//
// 角色由关号定死（DRAW_FOE_ROLES 按关号下标），技能名单印在角色卡上 ——
// **只有标签是摇的**（标签表见 draw-skills 的 rollLabels）。
//
// **摇完就存住**，这一条跟货架同一个理由：商店会预告下一关的庄家
//（见 draw-skills.uvue 的 foePreview），每次读都重摇的话
// 预告就是假情报，而且退出再进能一直刷到好摇的位置。
export function rollFoeKit(data : DrawSave, level : number) {
  const role = foeRoleAt(level)
  const slots : string[] = []
  const takenRanks : string[] = []
  const takenSuits : string[] = []
  for (let i = 0; i < role.slots.length; i++) {
    const one = role.slots[i]
    const taken = one.suit ? takenSuits : takenRanks
    const labels = rollLabels(one.count, one.suit, taken)
    let text = ''
    for (let j = 0; j < labels.length; j++) {
      taken.push(labels[j])
      text = text + (j == 0 ? '' : ' ') + labels[j]
    }
    slots.push(text)
  }
  data.foeSlots = slots
}

// 这一关庄家摇出来的那套配装。角色从关号查，标签从存档读 ——
// 所以**同一关每次读到的是同一套**（那正是「摇完存住」的全部意义）
export function foeKitOf(data : DrawSave, level : number) : DrawKit {
  const role = foeRoleAt(level)
  const slots : KitSlot[] = []
  for (let i = 0; i < role.slots.length && i < data.foeSlots.length; i++) {
    slots.push({
      skill: role.slots[i].skill,
      labels: slotLabels(data.foeSlots[i])
    } as KitSlot)
  }
  // role 传关号 - 1（DRAW_FOE_ROLES 的下标）。
  // **注意这跟玩家的 role 不是同一张表** —— 那边是 DRAW_ROLES
  return kitFromSlots(slots, level - 1)
}

// 【封竿】封住的那个点数（庄家特殊技，见 draw-levels 的 DRAW_FOE_SPECIALS）。
// 没带这件、或者它的槽上没有点数标签就返回空串。
//
// **它封的是庄家自己技能占着的那个点数** —— 不另摇一个数，理由有两条：
//
//   不另存 —— 再摇一个就得在存档里多存一段，而「摇完要存住」
//     那条规矩每多一个字段就多一个漏的机会（见 rollFoeKit 上面那段）；
//   更凶也更公道 —— 那个点数本来就是它的主场（技能嵌在那儿），
//     封掉之后你连「打那个点数去撞它」这条路都没了。
//     而且它跟商店预告是同一份信息：预告给了花色、点数只报个数，
//     所以你知道「有一个点数被封了」，不知道是哪个 —— 得试出来
export function foeSealRank(data : DrawSave, level : number) : string {
  const role = foeRoleAt(level)
  if (role.special != 'seal') {
    return ''
  }
  for (let i = 0; i < role.slots.length && i < data.foeSlots.length; i++) {
    if (role.slots[i].suit) {
      continue
    }
    const labels = slotLabels(data.foeSlots[i])
    if (labels.length > 0) {
      return labels[0]
    }
  }
  return ''
}

// 还没摇过就按当前关号补摇一次。
//
// 正常路径都摇过了（新档、输了重开、过关结算各一次），
// 这儿是兜底 —— 万一哪条路漏了，一局开不起来比庄家强一点难受得多。
//
// **浅滩那四关角色本来就没有槽**，所以「foeSlots 是空的」在那几关
// 是正常状态。拿角色的槽数去比，而不是比「空不空」——
// 不然前四关每次进对局都会白摇一遍
export function ensureFoeKit(data : DrawSave) : boolean {
  const want = foeRoleAt(data.runLevel).slots.length
  if (data.foeSlots.length == want) {
    return false
  }
  rollFoeKit(data, data.runLevel)
  return true
}

// 原先这儿有个 dropChance（过关掉技能的概率，随连空关数往上走）。
// 技能改成商店买了，这个函数和它依赖的 DROP_BASE / DROP_STEP 一起没用了。
//
// 它留下的那个 `misses` 字段（恒为 0）当时没删，说好「哪天版号因为别的事
// 要跳，顺手清掉」—— md4 为了加权那一格要跳版了，于是顺手清了。
// 加权后来也删了（md10），第 4 段现在装**角色 key**

function toInt(text : string, fallback : number) : number {
  const parsed = parseInt(text)
  if (isNaN(parsed)) {
    return fallback
  }
  return parsed
}

function readString(key : string) : string {
  const raw = uni.getStorageSync(key)
  if (raw == null) {
    return ''
  }
  if (typeof raw == 'string') {
    return raw as string
  }
  return ''
}

// 原先这儿有个 numsToText（数字表写成逗号串），技能的等级和槽位都靠它。
// 技能改成存 key 之后它没有调用方了，所以删掉 ——
// 留着只会让下一个人以为存档里还有数字表那回事

// 一串字符串，逗号分隔。牌组构成那一栏用它 —— 存的是「♠3」这种，
// 不用查任何表，原样存原样读
function listToText(list : string[]) : string {
  let text = ''
  for (let i = 0; i < list.length; i++) {
    text = text + (i == 0 ? '' : ',') + list[i]
  }
  return text
}

function textToList(text : string) : string[] {
  const out : string[] = []
  if (text == '') {
    return out
  }
  const parts = text.split(',')
  for (let i = 0; i < parts.length; i++) {
    if (parts[i] != '') {
      out.push(parts[i])
    }
  }
  return out
}

// 定长的数字表：读不够就补 fallback，多了截掉
function textToFixed(text : string, count : number, fallback : number) : number[] {
  const list = listOf(count, fallback)
  if (text == '') {
    return list
  }
  const parts = text.split(',')
  for (let i = 0; i < parts.length && i < count; i++) {
    list[i] = toInt(parts[i], fallback)
  }
  return list
}

// ---------- 技能存的是 key，不是下标 ----------
//
// 下面四个函数是那道闸门。为什么非得这样，见 draw-skills 文件头
// 「技能的身份是 key」那一段，一句话版：**存下标的话，删一件技能
// 就让老档整个错位**（你的磁钩会变成别人家的观潮）。
//
// 存 key 之后删增技能谁也不影响谁 —— 老档里读到一个已经删掉的 key，
// skillIndexOf 返回 -1，就当没有这件技能。

// 原先这儿有 levelsToText / textToLevels（等级表 ↔「key:等级」串）
// 和 emptySuitOwner。**等级没了、loadout 也不存了**，三个一起删 ——
// 现在只需要下面那一对：槽位表 ↔「key,key,,key」串。
//
// 「存 key 不存下标」那条规矩留着，而且现在角色也照它存
//（存下标的话表里删一张卡 / 一件技能就让老档整个错位）

// 槽位表（每格一个技能下标，-1 空着）→ 「key,key,,key」串。
// **空格写成空串**，所以格数得原样保留 —— 它是定长的，位置有意义
function ownerToText(owner : number[]) : string {
  let text = ''
  for (let i = 0; i < owner.length; i++) {
    text = text + (i == 0 ? '' : ',') + skillKeyAt(owner[i])
  }
  return text
}

function textToOwner(text : string, count : number) : number[] {
  const list = listOf(count, -1)
  if (text == '') {
    return list
  }
  const parts = text.split(',')
  for (let i = 0; i < parts.length && i < count; i++) {
    list[i] = parts[i] == '' ? -1 : skillIndexOf(parts[i])
  }
  return list
}

export function loadDrawAt(index : number) : DrawSave {
  const raw = readString(KEY_PREFIX + index)
  if (raw == '') {
    return emptyDrawSave()
  }
  const parts = raw.split('|')
  // 版号对不上（比如 md1 那版还有「通关列表」、没有本轮概念）就当没有这个档。
  //
  // ---- md9 起**不再兼容老档** ----
  //
  // 花色槽砍掉之后 suitOwner 那两段没了（玩家的和庄家的），
  // 于是**第 6 段往后全部左移两位** —— 段位整个错开，没法按版号补偿着读。
  //
  // 从前这儿有一串 md5/md6/md7/md8 的兼容分支（每一代 label 在第几段
  // 都不一样）。现在一律作废：老档读出来只能是一副错位的装备，
  // 而「读出一个空壳让人以为存档坏了」比「当没有这个档」更糟。
  //
  // 代价是清掉 best（最远纪录）。这是结构改动该付的 —— 砍掉一整个槽
  // 本来就不是能平滑迁移的事。
  //
  // **md10 又缩了三段**：玩家的 levels / loadout 换成了「角色 + 每槽嵌什么」
  // 两段（装备能从这两样 derive），庄家的两段换成一段「摇出来的标签」
  //（角色由关号定死，不用存）。十六段缩到十三段
  const labelAt = 13
  if (parts.length < labelAt + 1 || parts[0] != VERSION) {
    return emptyDrawSave()
  }
  // label 是最后一段，而它可能自带 | 号 —— 所以从 labelAt 起全拼回去
  let label = parts[labelAt]
  for (let i = labelAt + 1; i < parts.length; i++) {
    label = label + '|' + parts[i]
  }
  return {
    exists: true,
    label: label,
    best: toInt(parts[1], 0),
    runLevel: toInt(parts[2], 1),
    gold: toInt(parts[3], 0),
    // 角色用 key 存（跟技能一个道理 —— 存下标的话表里删一张卡就全错位）
    role: roleIndexOf(parts[4]),
    slotSkills: textToOwner(parts[5], roleSlotsOf(parts[4])),
    cards: textToList(parts[6]),
    shelf: textToList(parts[7]),
    bonusShelf: toInt(parts[8], 0),
    bonusCard: toInt(parts[9], 0),
    flatReroll: parts[10] == '1',
    inShop: parts[11] == '1',
    foeSlots: textToList(parts[12])
  }
}

// 这个角色 key 有几个槽。读档时要用它定 slotSkills 的长度 ——
// 存档里那一段只写了「每个槽嵌的技能 key」，槽数得从卡上查
function roleSlotsOf(key : string) : number {
  const at = roleIndexOf(key)
  return at < 0 ? 0 : DRAW_ROLES[at].slots.length
}

export function writeDrawAt(index : number, data : DrawSave) {
  const text = VERSION
    + '|' + data.best
    + '|' + data.runLevel
    + '|' + data.gold
    // 角色和每个槽嵌了什么，就是玩家的全部装备 ——
    // levels / loadout 那两段删了（能从这两样 derive，见 kitFromRole）
    + '|' + (data.role >= 0 && data.role < DRAW_ROLES.length
      ? DRAW_ROLES[data.role].key : '')
    + '|' + ownerToText(data.slotSkills)
    + '|' + listToText(data.cards)
    + '|' + listToText(data.shelf)
    + '|' + data.bonusShelf
    + '|' + data.bonusCard
    + '|' + (data.flatReroll ? '1' : '0')
    + '|' + (data.inShop ? '1' : '0')
    // 庄家只存摇出来的标签（角色由关号定死，不用存）。
    // 一个槽一段，段内空格分隔 —— listToText 用逗号分段，不冲突
    + '|' + listToText(data.foeSlots)
    + '|' + data.label
  uni.setStorageSync(KEY_PREFIX + index, text)
}

export function clearDrawAt(index : number) {
  uni.removeStorageSync(KEY_PREFIX + index)
  uni.removeStorageSync(KEY_GUIDE + index)
  uni.removeStorageSync(KEY_DIFF + index)
}

// ---------- 难度 ----------
//
// 每个存档记一个（见 draw-levels 的 levelForDiff）。单独一个键，不进存档那一串：
// 它是这个档的偏好，输了重开一轮还是这个难度；删档时一起清。
// 只在一轮开始前能换（关卡页管这条），不然就能先用简单刷钱、再换回去
const KEY_DIFF : string = 'md_diff_'

export function difficultyOf(index : number) : number {
  const v = toInt(readString(KEY_DIFF + index), DIFF_NORMAL)
  return v >= DIFF_EASY && v <= DIFF_HARD ? v : DIFF_NORMAL
}

export function setDifficulty(index : number, diff : number) {
  uni.setStorageSync(KEY_DIFF + index, '' + diff)
}

// 这一轮还没开打：在第 1 关、也没卡在商店里。只有这时候能换难度
export function runFresh(data : DrawSave) : boolean {
  return data.runLevel == 1 && !data.inShop
}

// ---------- 商店新手引导 ----------
//
// 每个存档第一次进商店走一遍引导（见 draw-skills 的 guideStep）。
// 单独一个键而不是塞进存档那一串：它跟「这一轮」无关，输了重开也不该再来一遍；
// 删档（clearDrawAt）时一起清，新档就会重新引导
const KEY_GUIDE : string = 'md_guide_'

export function shopGuided(index : number) : boolean {
  return readString(KEY_GUIDE + index) == '1'
}

export function setShopGuided(index : number) {
  uni.setStorageSync(KEY_GUIDE + index, '1')
}

export function drawSaveSlot() : number {
  const index = toInt(readString(KEY_SLOT), 1)
  if (index < 1 || index > DRAW_SLOT_COUNT) {
    return 1
  }
  return index
}

export function setDrawSaveSlot(index : number) {
  uni.setStorageSync(KEY_SLOT, '' + index)
}

// 当前存档；还没有就在当前槽建一个
export function loadDrawSave() : DrawSave {
  const index = drawSaveSlot()
  const data = loadDrawAt(index)
  if (data.exists) {
    return data
  }
  const fresh = newDrawSave(DRAW_SAVE_NAME + ' ' + index)
  writeDrawAt(index, fresh)
  return fresh
}

export function saveDraw(data : DrawSave) {
  writeDrawAt(drawSaveSlot(), data)
}

// ---------- 牌组构成 ----------
//
// 一张牌写成「花色 + 点数」：♠3、♥10、♦A。花色恒为一个字符，
// 所以第一个字符是花色、剩下的是点数 —— 解析不用分隔符。
//
// ---- 点数卡贴上来的额外点数写在后面，用 '+' 隔开 ----
//
//   ♠3        普通的黑桃 3
//   ♠3+7      它**同时**算 3 和 7：两边都钓得上，它也钓得上两边
//   ♠3+7+10   贴了两张点数卡
//
// 为什么用 '+' 而不是别的分隔符：牌组这一段在存档里是用 ',' 分段的
//（listToText / textToList），而货架那一段用的是 ':' ——
// 这两个字符都不能用。'+' 还顺带读得出意思：「3 加一个 7」。
//
// 点数写的是**数值**（1–13）而不是牌面字母，因为贴上来的那个点数
// 跟牌面没关系：♠3 贴个 12 就是「也算 Q」，但它仍然不是 Q
//（rank 还是 '3'，所以它不会变成 J 那样的通吃，也不触发点数技）
const PIP_MARK : string = '+'

export function cardText(suit : string, rank : string) : string {
  return suit + rank
}

export function suitOfText(text : string) : string {
  return text.length > 0 ? text.substring(0, 1) : ''
}

// 牌面那个点数（A、10、Q…）。**切掉 '+' 后面那一截** ——
// 贴过点数卡的牌，牌面点数还是原来那个
export function rankOfText(text : string) : string {
  if (text.length < 2) {
    return ''
  }
  const body = text.substring(1)
  const at = body.indexOf(PIP_MARK)
  return at < 0 ? body : body.substring(0, at)
}

// 点数卡贴上来的那几个点数（数值）。没贴过就是空的
export function pipsOfText(text : string) : number[] {
  const out : number[] = []
  const parts = text.split(PIP_MARK)
  // 第 0 段是「花色 + 牌面点数」，从第 1 段起才是贴上来的
  for (let i = 1; i < parts.length; i++) {
    const v = parseInt(parts[i])
    if (!isNaN(v)) {
      out.push(v)
    }
  }
  return out
}

// 给这张牌贴一个额外点数，返回新的牌面文本。
// **贴重了就原样返回** —— 同一个点数贴两次没有任何额外效果
export function addPip(text : string, value : number) : string {
  const has = pipsOfText(text)
  for (let i = 0; i < has.length; i++) {
    if (has[i] == value) {
      return text
    }
  }
  return text + PIP_MARK + value
}

// 界面上怎么写这张牌：♠3+7 写成「♠3·7」。
//
// 存档里用 '+'、界面上用 '·'，是因为 '+7' 看着像「加 7 点」
// （那是【推点数】那件道具干的事），而这儿是「**也**算 7 点」
export function cardLabel(text : string) : string {
  const pips = pipsOfText(text)
  if (pips.length == 0) {
    return text
  }
  let out = suitOfText(text) + rankOfText(text)
  for (let i = 0; i < pips.length; i++) {
    out = out + '·' + faceOfValue(pips[i])
  }
  return out
}

// 点数值写成牌面那套：11/12/13 写 J/Q/K
export function faceOfValue(v : number) : string {
  for (let i = 0; i < RANK_VALUES.length; i++) {
    if (RANK_VALUES[i] == v) {
      return RANKS[i]
    }
  }
  return '' + v
}

// 标准的 52 张，按花色排在一起
export function standardDeck() : string[] {
  const out : string[] = []
  for (let r = 0; r < RANKS.length; r++) {
    for (let s = 0; s < SUITS.length; s++) {
      out.push(cardText(SUITS[s], RANKS[r]))
    }
  }
  return out
}

// 这一轮该用哪副牌。没改造过就是标准 52 张
export function deckOf(data : DrawSave) : string[] {
  return data.cards.length > 0 ? data.cards.slice(0) : standardDeck()
}

// 把改造后的构成写回存档。**不洗牌** ——
// 洗是开局时的事（buildPlainDeck），存档里只记「这副牌有哪些张」
export function setDeck(data : DrawSave, cards : string[]) {
  data.cards = cards.slice(0)
}

// 这个点数在这副牌里一共有几张。
//
// **庄家的记牌靠它**：它钓不到牌时挑「外面剩得最少」的点数当饵
//（见 ap-fishing 的 outsideCount），而那个「剩」是拿总张数减掉看得见的。
// 改造一动，总张数就不再是恒定的 4 —— 不读这儿的话，
// 它会越改造越蠢，而「会记牌」正是第 3 关起的核心难度
export function countOfRank(data : DrawSave, rank : string) : number {
  const deck = deckOf(data)
  let n = 0
  for (let i = 0; i < deck.length; i++) {
    if (rankOfText(deck[i]) == rank) {
      n = n + 1
    }
  }
  return n
}

// ---------- 商店货架 ----------
//
// 一件货。四类：
//   'i' 道具   —— tag 是 key（push1、same、drop、sharpen、wash、pack2…）
//   'c' 卡牌   —— tag 是牌面（♠J）
//   's' 技能   —— tag 是技能下标（'3'）
//   'p' 点数卡 —— tag 是它给的点数值（'7'）
//
// 技能、卡牌、点数卡**混在同一栏**上货：三样是同一件事的三种形态 ——
// 都是「花钱添一样东西进这一轮」。道具那一栏管的是「改手头已有的」。
//
// 点数卡算在这一栏而不是道具栏，是因为它跟买牌是**同一条轴**的两头：
//   买牌   —— 牌组多一张，于是那个点数多一次撞上的机会（但牌组也变厚了）
//   点数卡 —— 牌组**不变厚**，但某一张牌多一个点数
// 后者更精准、也更贵。摆在一起才看得出这个取舍
export const GOODS_FIX : string = 'i'
export const GOODS_CARD : string = 'c'
export const GOODS_SKILL : string = 's'
export const GOODS_PIP : string = 'p'

export type ShelfGoods = {
  kind : string
  tag : string
  sold : boolean
}
// 这儿原先还有个 slot 字段：上货时就摇好「这件技能进花色槽还是点数槽」，
// 摆在格子上给你看。花色槽砍掉之后只剩一个槽，没什么可定的了 ——
// 字段、rollSlotFor、canPlaceIn、slotName 那一套一起删了

// 摇一批新货。keepFix 为真就留着原来那几件道具、只换下面那一栏 ——
// 刷新走这条：**道具买完就没了，刷新不补**，技能和卡牌才是「行情」。
export function rollShelf(data : DrawSave, keepFix : boolean) {
  const out : string[] = []
  // 第 0 段：刷新过几次。摇全新一批（进店那次）归零，刷新那次 +1
  out.push('' + (keepFix ? rerollTimes(data) + 1 : 0))
  if (keepFix) {
    // 原来那几件道具原样搬（连卖掉的标记一起 —— 卖了就是卖了）
    const old = shelfGoods(data)
    for (let i = 0; i < old.length; i++) {
      if (old[i].kind == GOODS_FIX) {
        out.push(GOODS_FIX + ':' + old[i].tag + ':' + (old[i].sold ? '1' : '0'))
      }
    }
  } else {
    // **按稀有度摇**，而不是均匀抽（见 draw-levels 的 rareWeight）：
    // 关号越大，稀有和史诗那几件越容易摆出来。
    //
    // 喂进去的 runLevel 是**下一关**的号：商店在打赢一关之后进，
    // 而 settleWin 已经把 runLevel 推过去了。那正好 —— 这批货是
    // 给下一关用的，按下一关的曲线上货才对得上。
    //
    // 买过的唯一道具排掉 —— 它们一轮只买得到一次
    //
    // 第 1 关之后那个商店（runLevel 已经推到 2）**必上【技能二选一】**：
    // 开局一个技能都没有，第一店至少得有条路拿到一个（第 1 关奖励也是
    // 照它的价定的，见 DRAW_LEVELS）。占掉一格，剩下的照常摇
    const skip = takenOnceKeys(data)
    let want = fixSlotsOf(data)
    if (data.runLevel == 2) {
      out.push(GOODS_FIX + ':pack2:0')
      skip.push('pack2')
      want = want - 1
    }
    const picked = rollFixKeys(data.runLevel, want, skip)
    for (let i = 0; i < picked.length; i++) {
      out.push(GOODS_FIX + ':' + picked[i] + ':0')
    }
  }
  // 技能、卡牌、点数卡混在一栏。**技能只上你还没有的** ——
  // 同名只有一个，摆一件你已经有的出来只是占格子。
  // 用 let：挑掉一个之后整个换成剩下那些（UTS 那边 length 是只读的，
  // 清不了数组，只能换引用）
  let freeSkills : number[] = []
  for (let k = 0; k < DRAW_SKILLS.length; k++) {
    if (!hasSkill(data, k)) {
      freeSkills.push(k)
    }
  }
  // 保底：每一批（进店和刷新都算）**至少一个技能** —— 随机挑一格定死上技能。
  // 技能全有了就没得保，那一格照常摇
  const slots = cardSlotsOf(data)
  const mustSkill = randomInt(slots)
  for (let i = 0; i < slots; i++) {
    // 大致的配比：技能 1/3、点数卡 1/4、剩下摆牌。
    // 技能摆完了（全有了）那一份自动匀给后两样
    if (freeSkills.length > 0 && (i == mustSkill || randomInt(3) == 0)) {
      const at = randomInt(freeSkills.length)
      out.push(GOODS_SKILL + ':' + freeSkills[at] + ':0')
      // 这一批里不重复上同一个技能
      const rest : number[] = []
      for (let k = 0; k < freeSkills.length; k++) {
        if (k != at) {
          rest.push(freeSkills[k])
        }
      }
      freeSkills = rest
      continue
    }
    if (randomInt(4) == 0) {
      out.push(GOODS_PIP + ':' + rollPipValue() + ':0')
      continue
    }
    const suit = SUITS[randomInt(SUITS.length)]
    const rank = RANKS[randomInt(RANKS.length)]
    out.push(GOODS_CARD + ':' + suit + rank + ':0')
  }
  data.shelf = out
}

// 点数卡给的是哪个点数。
//
// **J（11）不在池子里**，理由和点数槽不给指定 J 一样：J 是通吃，
// 而通吃焊在「J 这张牌」上，不是「11 点」上（见 catchStart）。
// 给一张 ♠3 贴个 11 点，它只会跟别的 11 点对上，不会变成通吃 ——
// 那就是一张标着「J」却不通吃的牌，解释起来全是坑。
//
// 所以池子是 A–10、Q、K，跟 SKILL_RANKS 同一套
export function rollPipValue() : number {
  const at = randomInt(SKILL_RANKS.length)
  return valueOfSkillRank(SKILL_RANKS[at])
}

function valueOfSkillRank(rank : string) : number {
  for (let i = 0; i < RANKS.length; i++) {
    if (RANKS[i] == rank) {
      return RANK_VALUES[i]
    }
  }
  return 1
}

// 原先这儿有个 pickSome（从 0..total-1 里均匀挑 want 个不重复的），
// 道具上货就是靠它。换成按稀有度加权的 rollFixKeys 之后它没用了 ——
// 卡牌那一栏不用它（牌是直接摇花色和点数，允许重复）

// 道具栏这一轮有几格：底数 + 买过加栏的那几格
export function fixSlotsOf(data : DrawSave) : number {
  return SHOP_FIX_COUNT + data.bonusShelf
}

// 技能 / 卡牌那一栏这一轮有几格：底数 + 买过加架的那几格
export function cardSlotsOf(data : DrawSave) : number {
  return SHOP_CARD_COUNT + data.bonusCard
}

// 这一关第 times 次刷新要多少钱。
//
// 买过【平价】就拍平成一个数，没买就走翻倍那条曲线。
// **页面别直接调 cardRerollCost** —— 那样平价就白买了
export function rerollPriceOf(data : DrawSave) : number {
  return data.flatReroll ? FLAT_REROLL : cardRerollCost(rerollTimes(data))
}

// 这一轮已经买过的唯一道具。
//
// 不另记一张清单 —— 那三件唯一道具买下来之后各自留了痕：
// 加栏顶了 bonusShelf、加架顶了 bonusCard、平价立了 flatReroll。
// 存档里有两份同一件事的记录，迟早对不上。
//
// 原先还有第四件【加权】（看 rankCap 有没有超过底数）。它跟角色卡结构
// 冲突、已经删了，这儿那一支跟着删
export function takenOnceKeys(data : DrawSave) : string[] {
  const out : string[] = []
  if (data.bonusShelf > 0) {
    out.push('shelf')
  }
  if (data.bonusCard > 0) {
    out.push('card')
  }
  if (data.flatReroll) {
    out.push('flat')
  }
  return out
}

// 买加栏：道具栏永久 +SHELF_BONUS 格。买过了就不动（它是唯一道具，
// 上货那儿已经排掉了，这道闸是防手快点两下）
export function growShelf(data : DrawSave) : boolean {
  if (data.bonusShelf > 0) {
    return false
  }
  data.bonusShelf = SHELF_BONUS
  return true
}

// 买加架：技能 / 卡牌那一栏永久 +CARD_BONUS 格。
//
// **这一批的货不动** —— 已经摆出来的四件就是四件。多出来那一格
// 从下一次上货开始算，而「下一次」既包括下一关，也包括这一关
// 花钱刷新（刷新会重摇整条下栏，见 rollShelf 的 keepFix 分支）。
// 所以它买完**当场就刷得出来**，只是要再花一次刷新钱
export function growCard(data : DrawSave) : boolean {
  if (data.bonusCard > 0) {
    return false
  }
  data.bonusCard = CARD_BONUS
  return true
}

// 买平价：刷新价从翻倍改成固定 FLAT_REROLL。
//
// **已经刷过的次数不清零** —— 清零的话「刷到第四次（160）再买平价」
// 就变成了一招免费回档。平价改的是价格曲线，不是你刷过几次这件事实
export function makeFlat(data : DrawSave) : boolean {
  if (data.flatReroll) {
    return false
  }
  data.flatReroll = true
  return true
}

// 原先这儿有个 benchedCount（「拥有但没装上」的技能有几个）。
// 买技能必须当场嵌槽之后**没有库了**，这个状态压根不存在

// ---- 原先这儿有 fillBench 和 growRank，一起删了 ----
//
// fillBench：格子一空出来，就让「拥有但没装上」的技能摇位置顶进去。
// growRank ：买【加权】把点数槽从 6 格抬到 7 格。
//
// 两个的前提都没了：
//
//   · **没有「拥有但没装上」这个状态了** —— 商店买技能必须当场嵌进一个槽
//     （见 embedSkill），所以不存在库存。
//   · **格数由角色卡印死** —— 加权那件货删了（新格子印什么没有来源）。
//
// 那条「槽里空出位置只该有一个后果」的规矩还在，只是现在简单得多：
// 空槽就是空槽，你下次买技能时挑它

export function rerollTimes(data : DrawSave) : number {
  return data.shelf.length == 0 ? 0 : toInt(data.shelf[0], 0)
}

// 货架上那几件。读不出来就是空的 —— 调用处据此判断要不要摇第一批
export function shelfGoods(data : DrawSave) : ShelfGoods[] {
  const out : ShelfGoods[] = []
  for (let i = 1; i < data.shelf.length; i++) {
    const seg = data.shelf[i].split(':')
    if (seg.length != 3) {
      continue
    }
    out.push({
      kind: seg[0],
      tag: seg[1],
      sold: seg[2] == '1'
    } as ShelfGoods)
  }
  return out
}

// 这儿原先有个 fillShelfSlots：老档的货架上技能还没定槽，进店时补定一个。
// 「定槽」这件事随花色槽一起没了（只剩一个槽），所以整个函数删掉 ——
// 调用方（draw-skills.uvue 的 onShow）那一下也要跟着去掉

// 把第 index 件（按 shelfGoods 的下标）标成卖掉
export function markSold(data : DrawSave, index : number) {
  const list = shelfGoods(data)
  if (index < 0 || index >= list.length) {
    return
  }
  const out : string[] = []
  out.push('' + rerollTimes(data))
  for (let i = 0; i < list.length; i++) {
    const one = list[i]
    const sold = i == index ? true : one.sold
    out.push(one.kind + ':' + one.tag + ':' + (sold ? '1' : '0'))
  }
  data.shelf = out
}

// 原先这儿有 saveFinalLevels / loadFinalLevels（一对 storage 读写，
// 把关卡页勾好的终局配装捎给对局页）。自定义配装整套取消了，这两个
// 跟着删 —— 没有调用方的导出函数留着只会让人以为还有那个功能。
//
// 取消的理由：技能掉什么不由你挑、位置摇定、升级要等货架上出砺钩，
// 一路都在说「适应摇出来的东西」，而自定义配装是「先想好再执行」

// ---------- 技能 ----------
//
// 原先这儿有 MAX_OWNED_SKILLS = 4（最多同时拥有几个技能）和 ownedSkillCount。
//
// **槽数本身就是上限了** —— 角色卡上有几个槽就带几件技能（2 到 4 个），
// 而且上限随角色变，那比一个全局常数有意思：选锁江（4 个窄槽）
// 还是沉钩（2 个宽槽），是「泛用 vs 专精」那道题。
//
// 「名额满了买不动」那条规矩也换了形状：槽满了照样买得动，
// 只是得**换掉**里头那件（见 embedSkill）—— 于是决策从
// 「要不要先卖一个」变成了「这件比槽里那件好吗」，直接得多

// 这件技能在槽里吗。
//
// 从前问的是「拥有吗」（data.levels[k] >= 0），那会儿「拥有」和「装上」
// 是两件事。现在只有一件 —— 在槽里就是有，不在就是没有
export function hasSkill(data : DrawSave, skill : number) : boolean {
  for (let i = 0; i < data.slotSkills.length; i++) {
    if (data.slotSkills[i] == skill) {
      return true
    }
  }
  return false
}

// 嵌了几件（空槽不算）。商店抬头报「槽 N/M」用它
export function filledSlots(data : DrawSave) : number {
  let n = 0
  for (let i = 0; i < data.slotSkills.length; i++) {
    if (data.slotSkills[i] >= 0) {
      n = n + 1
    }
  }
  return n
}

function randomInt(n : number) : number {
  return Math.floor(Math.random() * n)
}

// ---------- 买技能 = 把它嵌进一个槽 ----------
//
// 原先是 takeSkill(data, skill)：记个等级，然后**摇**一个位置。
// 塞不下就「留在库里躺着」—— 于是存在「拥有但没装上」这个状态。
//
// 角色卡之后两样都没了：槽上印死标签，所以**买的时候就得挑进哪个槽**，
// 而槽满了就只能换掉里头那件。没有库，也没有摇。
//
// 于是「买技能」从「花钱 + 听天由命」变成了「花钱 + 一个决策」——
// 磁钩嵌在连号的槽上，它的 +1 能钓到自己的下一个槽；嵌在散号上那条链就断了。
//
// at 是角色的第几个槽。换掉的那件**直接没了**（不回库 —— 没有库），
// 所以调用处要先问一句
export function embedSkill(data : DrawSave, skill : number, at : number) : string {
  if (at < 0 || at >= data.slotSkills.length) {
    return ''
  }
  const was = data.slotSkills[at]
  data.slotSkills[at] = skill
  const label = slotLabelAt(data, at)
  const name = DRAW_SKILLS[skill].name
  if (was >= 0 && was != skill) {
    return name + ' 嵌进 ' + label + ' 槽，换掉了 ' + DRAW_SKILLS[was].name
  }
  return name + ' 嵌进 ' + label + ' 槽，管 ' + label
}

// 把一个槽清空（卖技能走这条）。返回被取下来的那件，-1 = 本来就空着
export function clearSlotAt(data : DrawSave, at : number) : number {
  if (at < 0 || at >= data.slotSkills.length) {
    return -1
  }
  const was = data.slotSkills[at]
  data.slotSkills[at] = -1
  return was
}

// 这一轮的角色第 at 个槽上印着什么（'6 7'、'♥'…）。没选角色就是空串
export function slotLabelAt(data : DrawSave, at : number) : string {
  if (data.role < 0 || data.role >= DRAW_ROLES.length) {
    return ''
  }
  const slots = DRAW_ROLES[data.role].slots
  return at >= 0 && at < slots.length ? slots[at] : ''
}

// 选角色：开一轮之前挑一张卡。**槽全是空的** ——
// 技能靠商店买，买的时候挑进哪个槽（见 embedSkill）
export function pickRole(data : DrawSave, role : number) {
  if (role < 0 || role >= DRAW_ROLES.length) {
    return
  }
  data.role = role
  const slots : number[] = []
  for (let i = 0; i < DRAW_ROLES[role].slots.length; i++) {
    slots.push(-1)
  }
  data.slotSkills = slots
}

// 这一轮选过角色了吗。没选的话「开启挑战」要先弹角色选择
export function hasRole(data : DrawSave) : boolean {
  return data.role >= 0 && data.role < DRAW_ROLES.length
}

// 过了一关之后的结算：推进关卡、记最远、发金币。
//
// ---- 技能**不再靠过关掉** ----
//
// 从前这儿掷一次骰子决定掉不掉技能（概率随连空关数往上走）。整套取消了，
// 技能改成在商店买（跟卡牌混在同一栏上货）。
//
// 换掉的理由是**决策位置**：过关掉技能的时候你什么也决定不了 ——
// 掉什么、掉不掉，都是骰子说的。而买技能是在商店里跟别的东西抢钱：
// 这一百块买技能、买牌、还是买砺钩升手头那个？那是个真问题。
// 随机性没少（上什么货是摇的、位置是摇的），但它从「结算后通知你」
// 挪到了「摆在你面前让你挑」。
//
// 顺带把货架清空：一关一批货。商店是过关才进得去的，
// 所以「每关一批」就等于「每次进店一批」
export function settleWin(data : DrawSave, levelId : number, gold : number) {
  data.runLevel = levelId + 1
  data.best = Math.max(data.best, levelId)
  data.gold = data.gold + gold
  data.shelf = [] as string[]
  // 打完最后一关就通关了，没有下一个商店
  data.inShop = levelId < DRAW_RUN_LENGTH
  // **下一关的庄家在这儿摇定**。
  //
  // 位置很要紧：它排在进商店之前，所以商店那块预告读到的就是
  // 真正要打的那一套（见 draw-skills.uvue 的 foePreview）。
  // 摇在对局开始那一刻就晚了 —— 预告会变成一句空话。
  //
  // 平局不走这儿（settleWin 只在赢了才调），所以重打同一关
  // 面对的还是同一套 —— 那一关的题目没变，重摇就等于「平局刷题」
  if (data.inShop) {
    rollFoeKit(data, data.runLevel)
  }
}

