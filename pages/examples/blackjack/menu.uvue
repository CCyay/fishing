<template>
  <view class="page">
    <!-- 状态栏占位：原生导航栏去掉了，见 App.uvue 的 .bj-status-bar -->
    <view class="bj-status-bar"></view>
    <view class="hero">
      <text class="hero-title">魔法匹配</text>
    </view>

    <!-- 按钮下面一行小字报进度：不用点进去就知道打到哪儿了。
         魔法匹配的档在它自己的关卡页里切。
         〔2026-11-18 用户定「保留摸打钓鱼，去掉钓鱼游戏和排竿对局」：那两颗按钮撤了，
           两个游戏的页面（home / relay-levels）和存档代码都还在，只是这一页不再给入口〕 -->
    <view class="menu">
      <view id="bj-pick-action" class="menu-btn menu-btn-primary" @click="pickAction">
        <text class="menu-btn-text menu-btn-text-dark">魔法匹配</text>
        <text class="menu-btn-sub menu-btn-sub-dark">{{ drawText }}</text>
      </view>
    </view>

    <view class="footer">
      <text id="bj-menu-back" class="footer-link" @click="goExamples">返回示例列表</text>
    </view>
  </view>
</template>

<script setup lang="uts">
  import {
    DrawSave,
    emptyDrawSave,
    loadDrawAt,
    drawSaveSlot,
    DRAW_RUN_LENGTH
  } from '@/pages/examples/blackjack/draw-save.uts'

  // 只读不建：loadDrawAt 读不到就是空档 —— 这一页只是给人看一眼的路牌，
  // **看一眼不该产生存档**，建档留给真正进去的关卡页
  const draw = ref<DrawSave>(emptyDrawSave())
  const drawAt = ref<number>(1)

  const drawText = computed<string>(() : string => {
    const one = draw.value
    const head = one.label == '' ? '存档 ' + drawAt.value : one.label
    if (!one.exists) {
      return head + ' · 新游戏'
    }
    // 最远战绩跨轮留着，本轮进度输了就清
    const now = one.runLevel > DRAW_RUN_LENGTH ? '本轮通关' : '打到第 ' + one.runLevel + ' 关'
    return head + ' · 最远 ' + one.best + '/' + DRAW_RUN_LENGTH + ' · ' + now
  })

  function refresh() {
    drawAt.value = drawSaveSlot()
    draw.value = loadDrawAt(drawAt.value)
  }

  function pickAction() {
    uni.navigateTo({
      url: '/pages/examples/blackjack/draw-levels'
    })
  }

  // 这一页是启动页，栈底就是它，navigateBack 是空操作 ——
  // 所以回示例列表只能 navigateTo。代价是栈上多压一页，
  // 但这是出口不是入口，压一页就走了，不会越走越深
  function goExamples() {
    uni.navigateTo({
      url: '/pages/index/index'
    })
  }

  // 从游戏返回都要刷新 —— 那边可能换了槽、也可能打完了一关
  onShow(() => {
    refresh()
  })

  refresh()
</script>

<style>
  .page {
    flex: 1;
    padding: 16px;
    background-color: #0b5d3b;
  }

  .hero {
    align-items: center;
    margin-top: 40px;
  }

  .hero-title {
    color: #e8b23a;
    font-size: 44px;
    font-weight: bold;
  }

  /* 按钮竖排居中。样式照 home.uvue 那套主菜单按钮，
     只是高一些 —— 要装两行字 */
  .menu {
    flex: 1;
    justify-content: center;
  }

  .menu-btn {
    height: 62px;
    border-radius: 31px;
    margin-top: 14px;
    align-items: center;
    justify-content: center;
    background-color: #0e6b45;
    border-width: 1px;
    border-style: solid;
    border-color: #e8b23a;
  }

  .menu-btn-primary {
    background-color: #e8b23a;
  }

  .menu-btn-text {
    color: #e8b23a;
    font-size: 18px;
    font-weight: bold;
  }

  .menu-btn-text-dark {
    color: #3b2a00;
  }

  /* 按钮里那行进度小字。金底那颗要压深一点的颜色才看得清 */
  .menu-btn-sub {
    color: #9fd9bd;
    font-size: 12px;
    margin-top: 2px;
  }

  .menu-btn-sub-dark {
    color: #6b5210;
  }

  .footer {
    align-items: center;
    margin-bottom: 8px;
  }

  .footer-link {
    color: #e8b23a;
    font-size: 12px;
  }
</style>
